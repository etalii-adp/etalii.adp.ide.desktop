# Normalise text to LF in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts must stay LF everywhere, or bash fails on the carriage returns.
*.sh text eol=lf

# The templates of a new description are built into atd and atd-lsp: the same bytes on every platform.
crates/adp-atd-format/src/templates/*.atd text eol=lf

# Byte-compared files: the vendored specifications and fixtures, and the parity fixtures and goldens, are kept exactly as written.
vendor/** -text
parity/goldens/** -text
parity/fixtures/** -text
parity/cases/** -text
modules/editors/*/tests/examples/** -text
modules/designers/*/tests/examples/** -text
modules/diagrams/*/tests/fixtures/** -text
crates/adp-diagram/tests/fixtures/** -text
crates/adp-conformance/tests/round_trip/** -text
modules/diagrams/*/tests/fixtures/** -text

# The W3C cases read documents whose line endings and byte order mark are what they test.
parity/cases/w3c/**/*.ttl -text
parity/cases/w3c/**/*.nt -text

# The flow page is one output, the same bytes on every platform (etalii.adp spec 074, FR-010).
modules/diagrams/causal-loop-diagram/src/flow_page.html -text
