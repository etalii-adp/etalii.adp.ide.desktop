    skos:broader <descriptor/21020-5>, <thsys/70301>;
    skos:inScheme <../stw> ;
    skos:prefLabel "Linkage effect"@en, "Verkettungseffekt"@de ;
    skos:related <descriptor/12670-2>;
    skos:scopeNote "Bezeichnet, inwieweit sich wirtschaftliche Aktivitäten eines Sektors auf andere Sektoren auswirken, dabei wird zwischen Vorwärtsverknüpfungen, die die Effekte der Output-Verwendung aufzeigen, und Rückwärtsverknüpfungen, die die Effekte der Input-Beschaffung bezeichnen, unterschieden"@de, "Linkage effects indicate the extent to which economic activities in one sector affect other sectors, distinguishing between forward linkages (downstream), which show the effects of output use, and backward linkages (upstream), which denote the effects of input procurement"@en ;
    zbwext:altLabelNarrower "Backward Linkage"@de, "Backward linkages"@en, "Forward Linkage"@de, "Forward linkages"@en, "Rückwärtsverknüpfung"@de, "Vorwärtsverknüpfung"@de .

