atd 0.1

/// Ideas branching from one central topic, for thinking a subject through rather than specifying it.
///
/// A mind map is a tree of topics around one central topic. Its first-level branches go to the left and the right of
/// the centre; every deeper branch grows away from the centre. The diagram is stored in the Freeplane `.mm` format
/// (FreeMind-compatible), so Freeplane and FreeMind can open what ADP writes and ADP can open what they write, with
/// everything ADP does not understand preserved byte for byte.
///
/// This description is complete: what `mindmap.dis` left to `mindmap.md` (the `.mm` format, the two-sided layout,
/// sibling naming, the place of a new sibling, the drop target of the toolbox's tool) is stated here, in the binding
/// `freeplane` (mindmap.freeplane.atd), the capability `layout.twoSidedTree`, the function `siblingName` and the
/// operations; `mindmap.trace.json` says where each of those came from.
diagram freeplane/mindmap version "0.3.0" {
  label "Mind map"
  id: "net.etalii.adp.freeplane.mindmap"
  authors: [{ name: "Peter Vrenken", url: "https://github.com/vrenken" }]
  license: "Apache-2.0"
  homepage: "https://etalii.net/adp"
  icon: "mdi-family-tree"
  fileExtension: "mm"
  doc {
    tags: ["mind map", "mindmap", "freeplane", "freemind", "knowledge", "brainstorming"]
    seeAlso: [
      { title: "Freeplane", href: "https://www.freeplane.org/" },
      { title: "Freeplane example maps", href: "https://www.freeplane.org/wiki/index.php/Gallery" }
    ]
  }

  import "mindmap.notation.atd"
  import "mindmap.freeplane.atd"
  requires capability layout.twoSidedTree@^1

  /// One node type, nested to any depth. The tree is containment: every node but the central topic has exactly one
  /// parent node, and the order of a node's children is meaningful and stored.
  model {
    /// A topic in the map. The one node without a parent is the central topic.
    ///
    /// Stored as a Freeplane `<node>` element. Its `ID` is the element id (`ID_` plus a short id for nodes ADP
    /// creates). A node with no `ID` in the file is given one in memory on open and written on the next save, never on
    /// open. Two nodes the file gives one `ID` are both read; the first keeps the id and the later ones are reported
    /// by `mindmap.duplicate-id`.
    element Node {
      label "Node"
      icon: "mdi-card-plus-outline"
      /// The node's text.
      ///
      /// Stored in the `TEXT` attribute, or - for formatted text - as the HTML body of a `richcontent TYPE="NODE"`
      /// child, read as plain text with one line per paragraph. Any text is valid, the empty string included. Setting
      /// the text writes plain `TEXT` and drops the formatted body.
      attribute text: string default "" { label: "Text", order: 1 }
      /// Free-form notes on the node.
      ///
      /// Stored as the HTML body of a `richcontent TYPE="NOTE"` child, one `<p>` per line. Emptying the notes removes
      /// the `richcontent` element.
      attribute notes: text default "" { markup: plain, label: "Notes", order: 2 }
      /// What the node links to: a file or folder in the project, or a URL.
      ///
      /// Stored in the `LINK` attribute exactly as Freeplane defines it: a path relative to the map file (forward
      /// slashes), or an absolute URL. A file link is picked from the project's files, never typed, and never resolves
      /// outside the project. An empty `LINK=""` is a stored link with no target: the node offers Change link and
      /// Unlink, and draws no link glyph.
      attribute link: string { label: "Link", order: 3 }
      /// Whether the file says this branch starts collapsed.
      ///
      /// Freeplane's `FOLDED="true"`. It seeds each viewer's own collapsed state when the map opens
      /// (`persistence.view.initial`); collapsing and expanding afterwards is viewer state that is never written to
      /// the file and never lands on the undo history. The Collapsed row shows this flag, not the viewer's state.
      attribute folded: bool readonly default false {
        label: "Collapsed"
        group: "View"
        order: 4
        doc: { rationale: "Two people viewing one map fold independently." }
      }
      /// Freeplane's `POSITION` on a first-level node, when the file has one. Honoured by the layout; never written by
      /// ADP.
      attribute position: Side readonly { label: "Side", order: 5 }
      contains Node ordered
      labelAttribute: text
    }

    /// The line from a node to its parent.
    ///
    /// Not a stored relation: a branch is derived from containment, one per node that has a parent. It cannot be
    /// selected, created, reconnected or deleted on its own; re-parenting a node moves its branch.
    relation Branch from Node to Node {
      label "Branch"
      directed: true
      allowSelfLoops: false
      allowParallel: false
      derived: {
        from: (diagram.nodes.filter(n, n.parent != null))
        source: (item.parent)
        target: (item)
        doc: "One branch per node with a parent, from the parent to the node. Containment already rules out a cycle, so the relation states no `acyclic` of its own."
      }
    }

    /// Freeplane's `POSITION` attribute on a first-level node: which side of the central topic the branch is drawn
    /// on. Freeplane 1.11 wrote `left`/`right`; 1.12 writes `top_or_left`/`bottom_or_right`. Both vocabularies are
    /// read; ADP never writes the attribute.
    enum Side {
      right { label: "Right (Freeplane 1.11)" }
      left { label: "Left (Freeplane 1.11)" }
      bottom_or_right { label: "Right (Freeplane 1.12)" }
      top_or_left { label: "Left (Freeplane 1.12)" }
    }
  }

  // ---------------------------------------------------------------- Functions

  /// The name for a new node among siblings named `names` (mindmap.md §7.2, the standalone host's `SiblingNaming.cs`):
  /// the first rule that applies wins, and every rule ends in the same uniqueness pass, case ignored as Unicode lowers it.
  ///
  /// 1. Empty names are ignored and the rest trimmed.
  /// 2. Numbered siblings (a stem, spaces and at most fifteen digits: `Phase 1`, `Phase 3`) continue the stem most of
  ///    them share, from one past its highest number (`Phase 4`), with the spelling of the sibling that has it; a tie
  ///    goes to the stem with the higher number, then to the one met last.
  /// 3. Otherwise, when at least two siblings share a last word (`Measure pass`, `Arrange pass`), `New pass`; the word
  ///    most of them share, the first met on a tie.
  /// 4. Otherwise `Node`.
  /// 5. A name a sibling already has gets ` 2`, ` 3` and so on until it is free.
  fn siblingName(names: list<string>) -> string {
    let taken = names.map(n, n.trim()).filter(n, n != "")
    let numbered = taken.filter(n, n.matches("^.*\\S\\s+[0-9]{1,15}$"))
    var name = "Node"
    if numbered.size() > 0 {
      var bestCount = 0
      var bestHigh = -1
      var bestName = ""
      for key in numbered.map(n, lower(numberedStem(n))).distinct() limit 10000 {
        let group = numbered.filter(n, lower(numberedStem(n)) == key)
        var high = -1
        var holder = ""
        for n in group limit 10000 {
          if numberOf(n) > high {
            high = numberOf(n)
            holder = n
          }
        }
        if group.size() > bestCount || (group.size() == bestCount && high >= bestHigh) {
          bestCount = group.size()
          bestHigh = high
          bestName = numberedStem(holder) + " " + string(high + 1)
        }
      }
      name = bestName
    } else {
      let worded = taken.filter(n, n.matches("^\\S.* +[^ ]+$"))
      var bestCount = 1
      for word in worded.map(n, lastWord(n)) limit 10000 {
        let count = worded.filter(n, lower(lastWord(n)) == lower(word)).size()
        if count > bestCount {
          bestCount = count
          name = "New " + word
        }
      }
    }
    return unique(name, taken)
  }

  /// The stem of a numbered name: what comes before the spaces and the digits it ends in.
  fn numberedStem(name: string) -> string {
    var end = name.size()
    while end > 0 && name.charAt(end - 1).matches("^[0-9]$") limit 16 {
      end = end - 1
    }
    while end > 0 && name.charAt(end - 1).matches("^\\s$") limit 10000 {
      end = end - 1
    }
    return name.substring(0, end)
  }

  /// The number a numbered name ends in.
  fn numberOf(name: string) -> int {
    var start = name.size()
    while start > 0 && name.charAt(start - 1).matches("^[0-9]$") limit 16 {
      start = start - 1
    }
    return int(name.substring(start, name.size()))
  }

  /// The last word of a name, words being separated by spaces.
  fn lastWord(name: string) -> string {
    let trimmed = name.trim()
    return trimmed.substring(trimmed.lastIndexOf(" ") + 1, trimmed.size())
  }

  /// `name`, or `name` and the first number from 2 that no name of `taken` already is, case ignored.
  fn unique(name: string, taken: list<string>) -> string {
    if !taken.exists(t, lower(t) == lower(name)) {
      return name
    }
    for suffix in range(2, 10000) limit 10000 {
      let candidate = name + " " + string(suffix)
      if !taken.exists(t, lower(t) == lower(candidate)) {
        return candidate
      }
    }
    fail "No free name among " + string(taken.size()) + " siblings."
  }

  /// The corner glyphs of a node: • it has notes, ↗ it links somewhere (an empty link draws none), ⊕ its branch is
  /// collapsed for this viewer. The three are joined by single spaces before the ends are trimmed, so a node with notes
  /// and a collapsed branch but no link reads `•  ⊕`, two spaces apart, as the canvas has always drawn it.
  fn indicators(n: Node) -> string {
    return [n.notes != "" ? "•" : "", n.link != "" ? "↗" : "", n.view.collapsed && n.children.size() > 0 ? "⊕" : ""].join(" ").trim()
  }

  /// The name a finding calls the map by: the file it is attributed to (its `.adp` registration, else the `.mm`
  /// itself) without the registration's `.adp`.
  fn fileBase(file: string) -> string {
    return file.trim().lowerAscii().endsWith(".adp") ? file.trim().substring(0, file.trim().size() - 4) : file.trim()
  }

  // ---------------------------------------------------------------- Constraints

  /// A map that breaks a rule still opens. A file that is not a readable map has the one finding `mindmap.not-a-map`
  /// and no other. Only the central topic is judged for text: Freeplane itself keeps ordinary nodes without text, so an
  /// empty node elsewhere is style, not a problem. A map with more than one root node is not readable at all, so it
  /// needs no rule of its own.
  constraints {
    blockSaveOn: never
    order: ["mindmap.unnamed-root", "mindmap.duplicate-id"]

    builtin std.unparseable {
      code: "mindmap.not-a-map"
      severity: error
      message: ("'" + fileBase(diagram.file) + "' is not a readable mind map: " + detail.reason)
    }
    builtin std.duplicateId {
      enabled: false
      doc: "Reported by mindmap.duplicate-id, once per later holder in document order and naming both texts."
    }

    /// The central topic should have text.
    constraint unnamedCentralTopic for Node {
      label "Named central topic"
      when self.parent == null
      rule self.text.trim() != ""
      severity warning
      message ("The map '" + fileBase(diagram.file) + "' has an unnamed central topic.")
      code: "mindmap.unnamed-root"
      suppressible: false
    }

    /// Two nodes with one id would answer to each other's selections.
    ///
    /// Reported on each node after the first that the file gives an id, in document order. A node the file gives no id
    /// is not judged.
    constraint duplicateId for Node {
      label "One node per id"
      when self.id != ""
      rule diagram.elementById(self.id) == self
      severity error
      message ("Two nodes share the id '" + self.id + "' ('" + diagram.elementById(self.id).text + "' and '" + self.text + "').")
      code: "mindmap.duplicate-id"
      suppressible: false
    }

    constraint keepCentralTopic for Node {
      kind: delete
      rule self.parent != null
      message "The root node cannot be removed."
    }

    /// A drop that would make a node its own ancestor, or move the central topic, is refused; the drag preview does not
    /// offer such a node as a target.
    constraint reparentWithinTree {
      kind: containment
      when has(child.id)
      rule child.parent != null && parent != null && parent.id != child.id && !child.descendants().exists(d, d.id == parent.id)
      message "A node cannot be moved into its own branch, and the root node cannot be moved."
    }
  }

  // ---------------------------------------------------------------- Operations

  /// Adds a node as the last child, named after the pattern its new siblings follow, then edits its text in place.
  operation addChild "Add child" for Node {
    icon: "mdi-subdirectory-arrow-right"
    shortcut: "Insert"
    create Node { text: siblingName(self.children.map(c, c.text)) } in self as added
    select added
    editLabel added { label: text }
  }

  /// Adds a node right after this one under the same parent, named after the pattern of its siblings, then edits its
  /// text in place.
  operation addSibling "Add sibling" for Node {
    icon: "mdi-plus"
    shortcut: "Enter"
    enabled self.parent != null
    create Node { text: siblingName(self.parent.children.map(c, c.text)) } in self.parent after self as added
    select added
    editLabel added { label: text }
  }

  operation editNotes "Notes" for Node {
    icon: "mdi-note-text-outline"
    param notes: text { label: "Notes" }
    set self.notes = p.notes
  }

  /// Picks a file or folder of the project from a tree and stores it relative to the map file.
  operation link "Link to" for Node {
    icon: "mdi-link-variant"
    plugin: { name: "net.etalii.adp.ide.projectLinkPicker" }
  }

  operation unlink "Unlink" for Node {
    icon: "mdi-link-variant-off"
    enabled has(self.link)
    unset self.link
  }

  /// Collapses or expands the branch for this viewer only. View state: nothing is written and nothing lands on the undo
  /// history.
  operation toggleFold for Node {
    label (self.view.collapsed ? "Expand" : "Collapse")
    shortcut: "Space"
    enabled self.children.size() > 0
    view self { collapsed: !self.view.collapsed }
  }

  behavior {
    /// Deleting a node takes its branch with it. A leaf goes without asking; a node with anything beneath it asks
    /// first, naming how many nodes go with it. Both are undoable.
    deletion: {
      Node: {
        children: delete
        relations: delete
        confirm: {
          count: (self.descendants().size())
          threshold: 1
          title: "Delete branch?"
          message: ("Delete '" + self.text + "' and the " + string(count) + " nodes under it? You can undo this.")
          confirmLabel: "Delete"
          danger: true
        }
        doc: "Deleting a node takes its branch with it. A leaf goes without asking; a node with anything beneath it asks first, naming how many nodes go with it. Both are undoable."
      }
    }
    clipboard: { relations: internal, ids: regenerate }
  }

  // ---------------------------------------------------------------- Persistence

  /// Stored as a Freeplane `.mm` file, not as JSON: the XML the map was read from is the single source of truth, edits
  /// change it in place, and an unchanged map is written back byte for byte. The binding `freeplane`
  /// (mindmap.freeplane.atd) states how.
  persistence {
    format: fbl
    ids: {
      strategy: uuid-v4
      prefix: "ID_"
      encoding: base36
      stable: true
      doc: "A node ADP creates gets `ID_` and a ShortGuid (a version 4 GUID as 25 characters of base 36). Freeplane's own ids (`ID_` and digits) are kept as written. A node read without an `ID` is given one in memory and written on the next save."
    }
    view: {
      store: []
      viewer: [collapsed, viewport]
      initial: { collapsed: (self.folded) }
      doc: "Folding belongs to each viewer: FOLDED in the file seeds it once, and nothing a viewer folds is written."
    }
    typeMap: {
      Node: {
        as: "Node"
        hostAttributes: ["storedId"]
        doc: "A `<node>` is read as a Node. A later holder of an id the file gives twice is read under an ephemeral id; `storedId` keeps what the file writes, which findings name it by."
      }
    }
  }

  plugin net.etalii.adp.freeplane.mm {
    version: "^0.1.0"
    provides: [persistenceFormat]
    required: true
    doc: "Reads Freeplane `.mm` XML into nodes in mindmap.dis. This description states what it reads and writes as the binding `freeplane`; the plugin stays declared for the hosts that run the JSON files."
  }
  plugin net.etalii.adp.freeplane.mindmapLayout {
    version: "^0.1.0"
    provides: [layout]
    required: false
    fallback: { layout: mrtree }
    doc: "The two-sided mind map layout of mindmap.dis; this description requires it as the capability `layout.twoSidedTree`."
  }
  plugin net.etalii.adp.ide.projectLinkPicker {
    version: "^0.1.0"
    provides: [action, widget]
    required: false
    doc: "Lets the user pick a project file or folder from a tree and stores the choice as a path relative to the map file."
  }

  /// Today's wire ids, which the standalone client and backend share, mapped from this description's names. A tool is
  /// keyed by its id; an action by its entry's operation, else its kind; a property row by its form item's id, else its
  /// attribute.
  x-mindmap: {
    types: { Node: "node", Branch: "branch" }
    tools: { node: { id: "mindmap.toolbox.node", drop: "mindmap.add-child" } }
    actions: {
      addChild: "mindmap.add-child"
      addSibling: "mindmap.add-sibling"
      editLabel: "mindmap.rename"
      delete: "mindmap.delete"
      editNotes: "mindmap.edit-notes"
      link: "mindmap.link"
      unlink: "mindmap.unlink"
      toggleFold: "mindmap.toggle-fold"
    }
    properties: {
      text: "mindmap.text"
      notes: "mindmap.notes"
      link: "mindmap.link"
      folded: "mindmap.folded"
      identifier: "mindmap.identifier"
    }
  }
}
