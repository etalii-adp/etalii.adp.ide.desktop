      }
    }
  },
  "constraints": {
    "doc": "A Markdown file edited by hand that breaks a rule still opens and draws; each finding is reported on its node's line. Three built-ins are switched off because a declared rule reports the same breach once, in today's words: `std.containment` (a leaf with children), `std.multiplicity` (a wrapper without exactly one child, a composite without children) and `std.facets` (a Retry with no attempt). The reader adds `abm.no-behavior` (information) when the file has no Behavior heading or the section holds no list.",
    "blockSaveOn": "never",
    "order": [
      "abm.no-keyword",
      "abm.several-roots"
    ],
    "builtIn": {
      "std.containment": {
        "enabled": false,
        "doc": "Reported once per leaf by abm.leaf-with-children, with its count, rather than once per child."
      },
      "std.multiplicity": {
        "enabled": false,
        "doc": "Reported by abm.decorator-children (error) and abm.empty-composite (warning)."
      },
      "std.facets": {
        "enabled": false,
        "doc": "Reported by abm.no-attempts; the Attempts field refuses a value below 1 itself."
      }
    },
    "rules": [
      {
        "id": "noKeyword",
        "code": "abm.no-keyword",
        "label": "Item without a keyword",
        "scope": [
          "Do"
        ],
        "rule": "!self.implicit",
        "severity": "warning",
        "suppressible": false,
        "message": {
          "cel": "'\"' + shorten(self.label) + '\" has no keyword, so it is read as a Do. Start it with one, such as **Do:** or **Check:**.'"
        }
      },
      {
        "id": "severalRoots",
        "code": "abm.several-roots",
        "label": "More than one root",
        "scope": "diagram",
        "rule": "diagram.nodes.filter(n, n.parent == null).size() <= 1",
        "severity": "warning",
        "suppressible": false,
        "target": "diagram.nodes.filter(n, n.parent == null)[1]",
        "message": {
          "cel": "'The tree has ' + string(diagram.nodes.filter(n, n.parent == null).size()) + ' roots, and an agent starts at one. Put them under a Do in order or a Try in order to say how they relate.'"
        },
        "doc": "Reported on the second root."
      },
      {
        "id": "leafWithChildren",
        "code": "abm.leaf-with-children",
        "label": "Leaf with children",
        "scope": [
          "Leaf"
        ],
        "rule": "self.children.size() == 0",
        "severity": "error",
        "message": {
          "cel": "'\"' + keyword(self) + ': ' + self.label + '\" holds no children, but has ' + string(self.children.size()) + '. Make it a Do in order, or move them out.'"
        }
      },
      {
        "id": "decoratorChildren",
        "code": "abm.decorator-children",
        "label": "Wrapper without exactly one child",
        "scope": [
          "Decorator"
        ],
        "rule": "self.children.size() == 1",
        "severity": "error",
        "message": {
          "cel": "'\"' + keyword(self) + '\" wraps exactly one child, but has ' + string(self.children.size()) + '.' + (self.children.size() > 1 ? ' Put them under a Do in order first.' : ' Add the node it applies to beneath it.')"
        }
      },
      {
        "id": "emptyComposite",
        "code": "abm.empty-composite",
        "label": "Composite without children",
        "scope": [
          "Composite"
        ],
        "rule": "self.children.size() > 0",
        "severity": "warning",
        "suppressible": false,
        "message": {
          "cel": "'\"' + keyword(self) + ': ' + self.label + '\" has no children, so it has nothing to run.'"
        },
        "doc": "A warning, because it is the natural state while a tree is being written."
      },
      {
        "id": "noAttempts",
        "code": "abm.no-attempts",
        "label": "Retry without attempts",
        "scope": [
          "Retry"
        ],
        "rule": "self.attempts >= 1",
        "severity": "error",
        "message": "A Retry that allows no attempt never runs its child."
      }
    ]
  },
  "layout": {
    "algorithms": {
      "tree": {
        "algorithm": "tidyTree",
        "direction": "down",
        "spacing": {
          "node": 28,
          "layer": 56,
          "component": 56
        },
        "tidyTree": {
          "order": "children",
          "parentAlign": "firstLastCentre",
          "origin": "leftmostAtZero",
          "rows": {
            "stored": "y",
            "minGap": 16
          },
          "drag": {
            "carry": "subtree",
            "across": "reorder",
            "down": "row"
          },
          "doc": "Reingold-Tilford outline packing in document order, each parent centred over its first and last child, the roots packed 56 apart, the leftmost node at x = 0. Across, a node's x is always the computed one; down, all children of one parent share a row, drawn at the first height stored for any of them or 56 below the parent's bottom, never closer than 16. A drag carries the subtree, takes a sibling's place once dropped past its centre (the order is written to the Markdown), and stores the row's height for every node in the row and beneath it, as one undo step."
        },
        "doc": "Top-down: the root at the top, each node's children left to right in document order beneath it, each subtree packed as close as its outline allows."
      }
    },
    "default": "tree",
    "trigger": "always",
    "respect": "pinned",
    "animate": false,
    "doc": "The tree is laid out on every change. A drag pins a row's height in the .adp registration, under the place ids of the row and everything beneath it; across, the order decides."
  },
  "persistence": {
    "format": "fbl",
    "binding": "agent-behavior-modelling.fbl#abm",
    "ids": {
      "strategy": "derived",
      "expression": "self.parent == null ? string(self.positionIn(diagram.nodes.filter(n, n.parent == null)) + 1) : self.parent.id + '.' + string(self.positionIn(self.parent.children) + 1)",
      "doc": "A node's id is its place in the tree: 1, 1.2, 1.2.1 - its parent's place, a dot, and its position among its siblings counted from 1. Nothing is written into the Markdown to name it. A rename keeps the place; a reorder or a move changes it, and a drag renames the stored positions with it."
    },
    "view": {
      "store": [
        "pinned",
        "bounds"
      ]
    },
    "doc": "The tree is the first bullet list under the first Behavior heading of a Markdown file; everything else in the file is the author's and is kept byte for byte. The binding `agent-behavior-modelling.fbl#abm` names the persistence plugin `net.etalii.adp.etalii.abmMarkdown` as its reader. Positions the author dragged live in the .adp registration's layout block, never in the Markdown."
  },
  "plugins": {
    "net.etalii.adp.etalii.abmMarkdown": {
      "version": "^0.1.0",
      "provides": [
        "persistenceFormat"
      ],
      "required": true,
      "doc": "The FBL section 11 reader of the binding agent-behavior-modelling.fbl#abm, wrapping today's AbmParser and AbmWriter: reads the tree from a Markdown file's Behavior section, sets `implicit` on an item without a keyword, reports `abm.no-behavior` (information) on line 1 when the file has no Behavior heading or on the heading's line when the section holds no list, and plans every edit as line splices so every other byte survives.",
      "plans": [
        "add",
        "set",
        "remove",
        "move",
        "retype"
      ],
      "add": {
        "position": true
      },
      "move": {
        "position": true
      },
      "x-abm-plan": {
        "retype": {
          "keeps": [
            "label",
            "notes"
          ]
        },
        "doc": "A retype keeps the node's label and notes in the Markdown. Not yet a DISL key."
      }
    },
    "net.etalii.adp.etalii.abmArrange": {
      "version": "^0.1.0",
      "provides": [
        "action"
      ],
      "required": false,
      "doc": "Arrange diagram: removes the layout block from the .adp registration, leaving the Markdown untouched."
    }
  },
  "x-abm": {
    "doc": "Today's wire ids, which the standalone client (client/abmIds.ts) and backend share, mapped from this specification's names. An element's wire type is the prefix followed by its kind.",
    "typePrefix": "etalii/agent-behavior-modelling+",
    "types": {
      "Sequence": "sequence",
      "Fallback": "fallback",
      "Parallel": "parallel",
      "Retry": "retry",
      "RepeatUntil": "repeat",
      "Guard": "guard",
      "Approval": "approval",
      "Check": "check",
      "Do": "action",
      "AskUser": "ask",
      "Delegate": "delegate",
      "Child": "child"
    },
    "tools": {
      "sequence": {
        "id": "abm.toolbox.sequence",
        "drop": "abm.add.sequence"
      },
      "fallback": {
        "id": "abm.toolbox.fallback",
        "drop": "abm.add.fallback"
      },
      "parallel": {
        "id": "abm.toolbox.parallel",
        "drop": "abm.add.parallel"
      },
      "retry": {
        "id": "abm.toolbox.retry",
        "drop": "abm.add.retry"
      },
      "repeat": {
        "id": "abm.toolbox.repeat",
        "drop": "abm.add.repeat"
      },
      "guard": {
        "id": "abm.toolbox.guard",
        "drop": "abm.add.guard"
      },
      "approval": {
        "id": "abm.toolbox.approval",
        "drop": "abm.add.approval"
      },
      "check": {
        "id": "abm.toolbox.check",
        "drop": "abm.add.check"
      },
      "action": {
        "id": "abm.toolbox.action",
        "drop": "abm.add.action"
      },
      "ask": {
        "id": "abm.toolbox.ask",
        "drop": "abm.add.ask"
      },
      "delegate": {
        "id": "abm.toolbox.delegate",
        "drop": "abm.add.delegate"
      }
    },
    "actions": {
      "editLabel": "abm.rename",
      "delete": "abm.remove",
      "moveUp": "abm.move-earlier",
      "moveDown": "abm.move-later",
      "editNotes": "abm.edit-notes",
      "addChild": "abm.add.<kind>",
      "addHere": "abm.add.<kind>",
      "moveUnder": "abm.connect.child",
      "arrange": "abm.arrange",
      "arrangeFromNode": "abm.arrange"
    },
    "properties": {
      "Kind": "abm.kind",
      "label": "abm.label",
      "attempts": "abm.attempts",
      "notes": "abm.notes",
      "Place": "abm.place"
    }
  },
  "x-adp": {
    "kind": "Diagram",
    "state": "Prototype",
    "companion": "agent-behavior-modelling.md"
  }
}
