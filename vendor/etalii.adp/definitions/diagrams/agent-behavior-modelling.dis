{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.etalii.agent-behavior-modelling",
    "version": "0.3.0",
    "origin": "etalii/agent-behavior-modelling",
    "label": "Agent Behavior Modelling",
    "doc": {
      "summary": "A chat agent's instructions drawn as a behavior tree - what it checks, does, tries, repeats and asks - stored as the Markdown the agent reads.",
      "description": "Agent Behavior Modelling borrows the behavior tree from game development and tunes it to agent engineering. A tree of nodes says how an agent works through a task: composites (Do in order, Try in order, Do together) arrange their children, wrappers (Retry up to N times, Repeat until, Only while, Ask approval before) govern exactly one child, and leaves (Check, Do, Ask the user, Delegate) are the work itself.\n\nThe tree is not stored in a model file of its own. It is a keyword-marked bullet list under the `Behavior` heading of an ordinary Markdown file, and that Markdown file is the instruction file the agent reads (a system prompt, an `AGENTS.md`, a skill). The `.adp` registration beside it keeps only what the drawing needs: the heights the author dragged rows to.\n\nWhat this specification states through `x-abm-` keys, each shaped as the construct proposed for it - a drop placed under the nearest node above with room, the Kind field filtered by children, the right-button line, the tidy-tree layout, and the plugin changes FBL lacks - and the Markdown format itself are described in `agent-behavior-modelling.md` beside this file.",
      "rationale": "An instruction file written as prose hides its control flow: which steps are ordered, which are alternatives, where the agent must stop and ask. Drawn as a behavior tree, the flow is visible and checkable, while the file the agent reads stays plain Markdown.",
      "tags": [
        "agent",
        "behavior tree",
        "prompt",
        "instructions",
        "agent engineering",
        "humans and agents together"
      ],
      "audience": [
        "user",
        "author"
      ],
      "seeAlso": [
        {
          "title": "Behavior tree (artificial intelligence, robotics and control)",
          "href": "https://en.wikipedia.org/wiki/Behavior_tree_(artificial_intelligence,_robotics_and_control)"
        }
      ]
    },
    "defaultLocale": "en",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "license": "Apache-2.0",
    "icon": "mdi-robot-outline",
    "fileExtension": "md",
    "requires": {
      "conformance": "standard",
      "features": [
        "anchor.sides"
      ]
    }
  },
  "functions": {
    "keyword": {
      "params": [
        {
          "name": "n",
          "type": "Element"
        }
      ],
      "returns": "string",
      "cel": "n.type == 'Retry' ? 'Retry up to ' + string(n.attempts) + (n.attempts == 1 ? ' time' : ' times') : {'Sequence': 'Do in order', 'Fallback': 'Try in order', 'Parallel': 'Do together', 'RepeatUntil': 'Repeat until', 'Guard': 'Only while', 'Approval': 'Ask approval before', 'Check': 'Check', 'Do': 'Do', 'AskUser': 'Ask the user', 'Delegate': 'Delegate'}[n.type]",
      "doc": "The keyword a node is drawn and named with: the canonical one of its kind, with a Retry's count and the singular `time` for one attempt (AbmNodeKinds.KeywordOf)."
    },
    "kinds": {
      "params": [],
      "returns": "list(string)",
      "cel": "['Sequence', 'Fallback', 'Parallel', 'Retry', 'RepeatUntil', 'Guard', 'Approval', 'Check', 'Do', 'AskUser', 'Delegate']",
      "doc": "The eleven kinds, in the order the toolbox and the menus list them (AbmNodeKinds.All)."
    },
    "kindChoice": {
      "params": [
        {
          "name": "t",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'Sequence': 'Do in order', 'Fallback': 'Try in order', 'Parallel': 'Do together', 'Retry': 'Retry', 'RepeatUntil': 'Repeat until', 'Guard': 'Only while', 'Approval': 'Ask approval before', 'Check': 'Check', 'Do': 'Do', 'AskUser': 'Ask the user', 'Delegate': 'Delegate'}[t]",
      "doc": "A kind as menus and the Kind choice name it: its keyword, and `Retry` for a Retry."
    },
    "familyOf": {
      "params": [
        {
          "name": "t",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'Sequence': 'composite', 'Fallback': 'composite', 'Parallel': 'composite', 'Retry': 'decorator', 'RepeatUntil': 'decorator', 'Guard': 'decorator', 'Approval': 'decorator', 'Check': 'leaf', 'Do': 'leaf', 'AskUser': 'leaf', 'Delegate': 'leaf'}[t]",
      "doc": "A kind's family: `composite`, `decorator` or `leaf` (AbmNodeCategory)."
    },
    "startingLabel": {
      "params": [
        {
          "name": "t",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'Sequence': 'New steps', 'Fallback': 'New alternatives', 'Parallel': 'New independent work', 'Retry': '', 'RepeatUntil': 'New condition', 'Guard': 'New condition', 'Approval': '', 'Check': 'New question', 'Do': 'New action', 'AskUser': 'New question for the user', 'Delegate': 'New task'}[t]",
      "doc": "The label a new node of a kind starts with, before the author types their own (AddAbmNodeCommandHandler.StartingLabel); empty for a Retry and an Ask approval before."
    },
    "takesAnotherChild": {
      "params": [
        {
          "name": "n",
          "type": "Element"
        }
      ],
      "returns": "bool",
      "cel": "n.isA('Composite') || (n.isA('Decorator') && n.children.size() == 0)",
      "doc": "Whether another child may be added beneath a node (AbmNode.TakesAnotherChild)."
    },
    "canBecome": {
      "params": [
        {
          "name": "t",
          "type": "string"
        },
        {
          "name": "n",
          "type": "Element"
        }
      ],
      "returns": "bool",
      "cel": "familyOf(t) == 'leaf' ? n.children.size() == 0 : (familyOf(t) == 'decorator' ? n.children.size() <= 1 : true)",
      "doc": "Whether a node can become kind `t` without losing a child (AbmContextPropertyProvider.KindsFor)."
    },
    "shorten": {
      "params": [
        {
          "name": "s",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "size(s) <= 60 ? s : s.substring(0, 57) + '...'",
      "doc": "A label cut to 60 characters for a message (AbmParser.Shorten)."
    }
  },
  "metamodel": {
    "doc": "Eleven node types in three families, nested to any depth. The tree is containment: every node but a root has exactly one parent, the order of a node's children is meaningful and stored, and the family decides how many children a node may hold.",
    "types": {
      "BehaviorNode": {
        "abstract": true,
        "doc": "Everything that can be placed in a behavior tree.",
        "labelAttribute": "label",
        "attributes": {
          "label": {
            "type": "string",
            "label": "Label",
            "default": "",
            "order": 1,
            "doc": {
              "summary": "What this node does, or the condition it names.",
              "description": "The text after the keyword on the node's list item, kept on one line. For Repeat until and Only while it is the condition; for Delegate it names the sub-agent or links another behavior file."
            }
          },
          "notes": {
            "type": "text",
            "label": "Notes",
            "markup": "markdown",
            "default": "",
            "order": 3,
            "doc": {
              "summary": "Further instructions for this node, kept as written.",
              "description": "The lines indented under the node's list item that are not list items themselves. The agent reads them with the node; the diagram never draws them."
            }
          }
        }
      },
      "Composite": {
        "abstract": true,
        "extends": "BehaviorNode",
        "doc": "A node that arranges one or more children.",
        "children": {
          "allowed": [
            "BehaviorNode"
          ],
          "ordered": true,
          "min": 1
        }
      },
      "Decorator": {
        "abstract": true,
        "extends": "BehaviorNode",
        "doc": "A node that governs exactly one child: when it runs, how often, or whether the user agrees first.",
        "children": {
          "allowed": [
            "BehaviorNode"
          ],
          "ordered": true,
          "min": 1,
          "max": 1
        }
      },
      "Leaf": {
        "abstract": true,
        "extends": "BehaviorNode",
        "doc": "A node that does the work and holds no children."
      },
      "Sequence": {
        "extends": "Composite",
        "label": "Do in order",
        "icon": "mdi-arrow-right-bold-outline",
        "doc": "Runs its children one after another, and fails as soon as one fails.",
        "x-abm": {
          "keyword": "Do in order",
          "kind": "sequence"
        }
      },
      "Fallback": {
        "extends": "Composite",
        "label": "Try in order",
        "icon": "mdi-help-rhombus-outline",
        "doc": "Tries its children one after another, and succeeds as soon as one succeeds.",
        "x-abm": {
          "keyword": "Try in order",
          "kind": "fallback"
        }
      },
      "Parallel": {
        "extends": "Composite",
        "label": "Do together",
        "icon": "mdi-call-split",
        "doc": "Runs its children independently, at the same time where you can, and succeeds when all of them succeed.",
        "x-abm": {
          "keyword": "Do together",
          "kind": "parallel"
        }
      },
      "Retry": {
        "extends": "Decorator",
        "label": "Retry",
        "icon": "mdi-replay",
        "doc": "Runs its child again when it fails, at most N times in all.",
        "x-abm": {
          "keyword": "Retry up to N times",
          "kind": "retry"
        },
        "attributes": {
          "attempts": {
            "type": "int",
            "label": "Attempts",
            "default": 3,
            "min": 1,
            "order": 2,
            "doc": "The N of `Retry up to N times`: the most attempts in all, the first included. A new Retry, and a node changed into one, allows 3. `std.facets` is switched off, so a Retry read with 0 is reported once, by `abm.no-attempts`."
          }
        }
      },
      "RepeatUntil": {
        "extends": "Decorator",
        "label": "Repeat until",
        "icon": "mdi-repeat",
        "doc": "Runs its child again and again until its condition holds.",
        "x-abm": {
          "keyword": "Repeat until",
          "kind": "repeat"
        }
      },
      "Guard": {
        "extends": "Decorator",
        "label": "Only while",
        "icon": "mdi-shield-outline",
        "doc": "Runs its child only while its condition holds, and abandons it when the condition stops holding.",
        "x-abm": {
          "keyword": "Only while",
          "kind": "guard"
        }
      },
      "Approval": {
        "extends": "Decorator",
        "label": "Ask approval before",
        "icon": "mdi-account-check-outline",
        "doc": "Says what its child is about to do and waits for the user's explicit approval; without it, the node fails.",
        "x-abm": {
          "keyword": "Ask approval before",
          "kind": "approval"
        }
      },
      "Check": {
        "extends": "Leaf",
        "label": "Check",
        "icon": "mdi-help-circle-outline",
        "doc": "Answers its question from the conversation, your memory or a tool result; it succeeds when the answer is yes, and never acts.",
        "x-abm": {
          "keyword": "Check",
          "kind": "check"
        }
      },
      "Do": {
        "extends": "Leaf",
        "label": "Do",
        "icon": "mdi-play-outline",
        "doc": "Carries out one piece of work: a tool call, an answer, an edit.",
        "x-abm": {
          "keyword": "Do",
          "kind": "action"
        },
        "attributes": {
          "implicit": {
            "type": "bool",
            "label": "Implicit",
            "default": false,
            "readOnly": true,
            "readOnlyReasons": [
              "Whether an item carries a keyword is read from the Markdown; give it one by changing its Kind."
            ],
            "doc": "True for a list item the Markdown gave no keyword (or a bold lead that is none of the eleven): it is read as a Do labelled with the whole item, drawn dashed and reported by `abm.no-keyword`. Set by the reader only, never written."
          }
        }
      },
      "AskUser": {
        "extends": "Leaf",
        "label": "Ask the user",
        "icon": "mdi-account-question-outline",
        "doc": "Asks its question and waits for the answer.",
        "x-abm": {
          "keyword": "Ask the user",
          "kind": "ask"
        }
      },
      "Delegate": {
        "extends": "Leaf",
        "label": "Delegate",
        "icon": "mdi-account-arrow-right-outline",
        "doc": "Hands its task to a sub-agent, or follows the behavior file it links to.",
        "x-abm": {
          "keyword": "Delegate",
          "kind": "delegate"
        }
      }
    },
    "relations": {
      "Child": {
        "label": "Child",
        "doc": {
          "summary": "The line from a node to each of its children, in order.",
          "description": "Not a stored relation: a line is derived from containment, one per node that has a parent, named `child:` and the child's place. A line is drawn even under a leaf, so a file that breaks a rule is drawn as the agent will read it. Drawing a new line from a node to another moves the second, with everything under it, to be the first's last child (the `moveUnder` operation); removing or reconnecting one is not offered."
        },
        "source": "BehaviorNode",
        "target": "BehaviorNode",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "acyclic": true,
        "derived": {
          "from": "diagram.nodes.filter(n, n.parent != null)",
          "id": "'child:' + item.id",
          "source": "item.parent",
          "target": "item",
          "sources": "[item]",
          "edits": {
            "connect": "moveUnder"
          },
          "doc": "One line per node with a parent. The source end is any node rather than Composite or Decorator, so a leaf's children keep their lines; which nodes may start a new line is said by `moveUnder`'s aborts."
        }
      }
    }
  },
  "coordinates": {
    "doc": "One free pixel canvas. Every position is computed by the tree layout; a row the author dragged keeps its height in the .adp registration.",
    "systems": {
      "canvas": {
        "kind": "cartesian",
        "x": {
          "kind": "linear",
          "unit": "px"
        },
        "y": {
          "kind": "linear",
          "unit": "px"
        },
        "orientation": "y-down",
        "grid": {
          "visible": false
        }
      }
    },
    "default": "canvas"
  },
  "notation": {
    "doc": "The family is the shape, as behavior tree editors in games draw it: a composite is a squircle, a wrapper a hexagon. Among the leaves a Check is a pill, a Do a box, an Ask the user a parallelogram and a Delegate a diode. Every node shows its keyword in small capitals above its label.",
    "theme": {
      "tokens": {
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.surface": "#ffffff",
        "color.border": "#e2e8f0",
        "color.abm.composite": "#aaed92",
        "color.abm.decorator": "#fcf281",
        "color.abm.check": "#9edcfa",
        "color.abm.action": "#ededed",
        "color.abm.other": "#86e6d9"
      },
      "modes": {
        "dark": {
          "color.text": "#f1f5f9",
          "color.text.muted": "#94a3b8",
          "color.surface": "#1e293b",
          "color.border": "#334155",
          "color.abm.composite": "#2e7814",
          "color.abm.decorator": "#736a03",
          "color.abm.check": "#086fa1",
          "color.abm.action": "#696969",
          "color.abm.other": "#187569"
        }
      },
      "defaultMode": "light",
      "followSystem": true,
      "doc": "The fills are the functional decomposition graph's: composites green, wrappers yellow, a Check blue, a Do grey, an Ask the user and a Delegate teal."
    },
    "styles": {
      "node": {
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1.5
        },
        "font": {
          "size": 12,
          "color": {
            "token": "color.text"
          }
        },
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "composite": {
        "extends": "node",
        "fill": {
          "token": "color.abm.composite"
        }
      },
      "decorator": {
        "extends": "node",
        "fill": {
          "token": "color.abm.decorator"
        }
      },
      "check": {
        "extends": "node",
        "fill": {
          "token": "color.abm.check"
        }
      },
      "action": {
        "extends": "node",
        "fill": {
          "token": "color.abm.action"
        }
      },
      "other": {
        "extends": "node",
        "fill": {
          "token": "color.abm.other"
        }
      },
      "implicit": {
        "stroke": {
          "dash": [
            4,
            3
          ]
        }
      },
      "keyword": {
        "font": {
          "size": 10,
          "weight": 600,
          "letterSpacing": 0.2,
          "transform": "uppercase",
          "color": {
            "token": "color.text"
          }
        }
      },
      "label": {
        "font": {
          "size": 12,
          "color": {
            "token": "color.text"
          }
        }
      },
      "child": {
        "stroke": {
          "color": {
            "token": "color.text.muted"
          },
          "width": 1.5
        }
      }
    },
    "shapes": {
      "diode": {
        "label": "Diode",
        "doc": "Square on the left and round on the right: a rectangle closed on the right by a semicircle of radius r = min(h / 2, w), as the canvas library's built-in diode draws it. DISL has no built-in diode.",
        "path": {
          "segments": [
            {
              "op": "M",
              "x": 0,
              "y": 0
            },
            {
              "op": "L",
              "x": "w - min(h / 2.0, w)",
              "y": 0
            },
            {
              "op": "A",
              "rx": "min(h / 2.0, w)",
              "ry": "min(h / 2.0, w)",
              "rotation": 0,
              "largeArc": false,
              "sweep": true,
              "x": "w - min(h / 2.0, w)",
              "y": "h"
            },
            {
              "op": "L",
              "x": 0,
              "y": "h"
            },
            {
              "op": "Z"
            }
          ]
        },
        "textArea": {
          "x": 6,
          "y": "h * 0.15",
          "w": "w - 0.134 * min(h / 2.0, w) - 12",
          "h": "h * 0.7"
        }
      }
    },
    "nodes": {
      "Sequence": {
        "shape": {
          "type": "superellipse",
          "params": {
            "exponent": 4
          }
        },
        "style": "composite",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "anchors": {
          "mode": "sides",
          "sides": [
            "top",
            "bottom"
          ]
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "keyword(self)"
            },
            "editable": false,
            "style": "keyword",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "style": "label",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                40
              ]
            },
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "keyword(self) + ': ' + self.label"
          }
        },
        "doubleClick": "editLabel",
        "doc": "Every node is 200 by 60, with its keyword in small capitals 20 below its top and its label 40 below it. Only the label is edited in place: the keyword is the node's kind, changed through the Kind field. Lines leave the middle of the parent's bottom and arrive at the middle of the child's top."
      },
      "Fallback": {
        "shape": {
          "type": "superellipse",
          "params": {
            "exponent": 4
          }
        },
        "style": "composite",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "anchors": {
          "mode": "sides",
          "sides": [
            "top",
            "bottom"
          ]
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "keyword(self)"
            },
            "editable": false,
            "style": "keyword",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "style": "label",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                40
              ]
            },
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "keyword(self) + ': ' + self.label"
          }
        },
        "doubleClick": "editLabel"
      },
      "Parallel": {
        "shape": {
          "type": "superellipse",
          "params": {
            "exponent": 4
          }
        },
        "style": "composite",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
          },
          "y": {
            "layout": true
          },
          "anchor": "center",
          "movable": true,
          "resizable": false
        },
        "anchors": {
          "mode": "sides",
          "sides": [
            "top",
            "bottom"
          ]
        },
        "labels": [
          {
            "id": "keyword",
            "text": {
              "cel": "keyword(self)"
            },
            "editable": false,
            "style": "keyword",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "editable": "inline",
            "style": "label",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                40
              ]
            },
            "wrap": "none",
            "overflow": "ellipsis",
            "tooltip": {
              "cel": "self.label"
            }
          }
        ],
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "keyword(self) + ': ' + self.label"
          }
        },
        "doubleClick": "editLabel"
      },
      "Retry": {
        "shape": "hexagon",
        "style": "decorator",
        "size": {
          "default": [
            200,
            60
          ],
          "resizable": false
        },
        "placement": {
          "x": {
            "layout": true
