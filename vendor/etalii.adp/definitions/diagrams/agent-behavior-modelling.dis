    "edges": {
      "Child": {
        "style": "child",
        "line": {
          "routing": "orthogonal",
          "bendpoints": {
            "editable": false
          }
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "deletable": false,
        "reconnectable": false,
        "connect": {
          "pointer": {
            "button": "secondary",
            "start": "body",
            "doc": "A new line is drawn by dragging with the right mouse button from the parent's body to the child's body, because side anchors draw no handle."
          }
        },
        "doc": "An orthogonal line from the middle of the parent's bottom down to the middle of the child's top, with an arrowhead at the child."
      }
    }
  },
  "forms": {
    "node": {
      "for": "BehaviorNode",
      "usage": [
        "inspector"
      ],
      "label": "Behavior node",
      "items": [
        {
          "kind": "section",
          "title": "Node",
          "items": [
            {
              "kind": "type",
              "label": "Kind",
              "options": {
                "cel": "kinds().filter(t, canBecome(t, self))"
              },
              "optionLabel": "kindChoice(item)",
              "refusals": [
                {
                  "when": "familyOf(newValue) == 'leaf' && self.children.size() > 0",
                  "message": {
                    "cel": "'\"' + kindChoice(newValue) + '\" holds no children, and this node has ' + (self.children.size() == 1 ? '1 child' : string(self.children.size()) + ' children') + '.'"
                  }
                },
                {
                  "when": "familyOf(newValue) == 'decorator' && self.children.size() > 1",
                  "message": {
                    "cel": "'\"' + (newValue == 'Retry' ? 'Retry up to 3 times' : kindChoice(newValue)) + '\" holds exactly one child, and this node has ' + string(self.children.size()) + '.'"
                  }
                }
              ],
              "doc": "An editable choice of the kinds this node can become without losing a child, shown by their menu names, which retypes the node through `behavior.retype` as one undoable step. The refusals are reached only by a value typed past the list."
            },
            {
              "attribute": "label",
              "label": "Label"
            },
            {
              "attribute": "attempts",
              "label": "Attempts",
              "visible": "self.type == 'Retry'",
              "validate": [
                {
                  "rule": "value >= 1",
                  "message": {
                    "cel": "'\\'' + string(value) + '\\' is not a number of attempts; a Retry allows at least 1.'"
                  },
                  "timing": "commit"
                }
              ]
            },
            {
              "attribute": "notes",
              "label": "Notes",
              "widget": "textarea"
            },
            {
              "kind": "computed",
              "label": "Place",
              "value": {
                "cel": "self.id"
              },
              "readOnlyReasons": [
                "A node's place follows from where it sits in the tree."
              ],
              "doc": "The node's place in the tree (1, 1.2, 1.2.1), which is also its id."
            }
          ]
        }
      ]
    },
    "notesDialog": {
      "for": "BehaviorNode",
      "usage": [
        "popover"
      ],
      "label": "Notes",
      "icon": "mdi-note-text-outline",
      "submitLabel": "Save",
      "items": [
        {
          "attribute": "notes",
          "label": "Notes",
          "widget": "textarea",
          "initial": "self.notes"
        }
      ]
    }
  },
  "toolbox": {
    "doc": "One tool per kind, in one list. A tool is dropped where the node belongs: it goes under the nearest node above the drop that can take another child, among that node's children by where it landed, or becomes the root of an empty tree; its label is then edited in place. New lines are drawn on the canvas with a right-button drag, not from the toolbox.",
    "generic": {
      "select": true,
      "pan": true
    },
    "groups": [
      {
        "id": "nodes",
        "tools": [
          {
            "id": "sequence",
            "creates": "Sequence",
            "mode": "drop",
            "label": "Do in order",
            "icon": "mdi-arrow-right-bold-outline",
            "doc": "Runs its children one after another, and fails as soon as one fails. Drop it below the node it belongs under.",
            "initial": {
              "label": "New steps"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "fallback",
            "creates": "Fallback",
            "mode": "drop",
            "label": "Try in order",
            "icon": "mdi-help-rhombus-outline",
            "doc": "Tries its children one after another, and succeeds as soon as one succeeds. Drop it below the node it belongs under.",
            "initial": {
              "label": "New alternatives"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "parallel",
            "creates": "Parallel",
            "mode": "drop",
            "label": "Do together",
            "icon": "mdi-call-split",
            "doc": "Runs its children independently, at the same time where you can, and succeeds when all of them succeed. Drop it below the node it belongs under.",
            "initial": {
              "label": "New independent work"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "retry",
            "creates": "Retry",
            "mode": "drop",
            "label": "Retry",
            "icon": "mdi-replay",
            "doc": "Runs its child again when it fails, at most N times in all. Drop it below the node it belongs under.",
            "initial": {
              "label": ""
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "repeat",
            "creates": "RepeatUntil",
            "mode": "drop",
            "label": "Repeat until",
            "icon": "mdi-repeat",
            "doc": "Runs its child again and again until its condition holds. Drop it below the node it belongs under.",
            "initial": {
              "label": "New condition"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "guard",
            "creates": "Guard",
            "mode": "drop",
            "label": "Only while",
            "icon": "mdi-shield-outline",
            "doc": "Runs its child only while its condition holds, and abandons it when the condition stops holding. Drop it below the node it belongs under.",
            "initial": {
              "label": "New condition"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "approval",
            "creates": "Approval",
            "mode": "drop",
            "label": "Ask approval before",
            "icon": "mdi-account-check-outline",
            "doc": "Says what its child is about to do and waits for the user's explicit approval; without it, the node fails. Drop it below the node it belongs under.",
            "initial": {
              "label": ""
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "check",
            "creates": "Check",
            "mode": "drop",
            "label": "Check",
            "icon": "mdi-help-circle-outline",
            "doc": "Answers its question from the conversation, your memory or a tool result; it succeeds when the answer is yes, and never acts. Drop it below the node it belongs under.",
            "initial": {
              "label": "New question"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "action",
            "creates": "Do",
            "mode": "drop",
            "label": "Do",
            "icon": "mdi-play-outline",
            "doc": "Carries out one piece of work: a tool call, an answer, an edit. Drop it below the node it belongs under.",
            "initial": {
              "label": "New action"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "ask",
            "creates": "AskUser",
            "mode": "drop",
            "label": "Ask the user",
            "icon": "mdi-account-question-outline",
            "doc": "Asks its question and waits for the answer. Drop it below the node it belongs under.",
            "initial": {
              "label": "New question for the user"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          },
          {
            "id": "delegate",
            "creates": "Delegate",
            "mode": "drop",
            "label": "Delegate",
            "icon": "mdi-account-arrow-right-outline",
            "doc": "Hands its task to a sub-agent, or follows the behavior file it links to. Drop it below the node it belongs under.",
            "initial": {
              "label": "New task"
            },
            "after": "none",
            "drop": {
              "place": "underNearestAbove"
            }
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "BehaviorNode"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "editLabel",
            "group": "edit",
            "label": "Rename…",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "editNotes",
            "group": "edit",
            "label": "Edit notes…",
            "icon": "mdi-note-text-outline"
          },
          {
            "kind": "moveUp",
            "group": "edit",
            "label": "Move earlier",
            "icon": "mdi-arrow-left",
            "shortcut": "Alt+Up"
          },
          {
            "kind": "moveDown",
            "group": "edit",
            "label": "Move later",
            "icon": "mdi-arrow-right",
            "shortcut": "Alt+Down"
          },
          {
            "kind": "delete",
            "group": "edit",
            "label": "Remove",
            "icon": "mdi-delete-outline",
            "shortcut": "Delete"
          },
          {
            "kind": "operation",
            "operation": "addChild",
            "group": "add",
            "forEach": "kinds()",
            "as": "kind",
            "label": {
              "cel": "'Add child: ' + kindChoice(kind)"
            },
            "icon": "mdi-plus",
            "args": {
              "kind": "kind"
            },
            "visible": "takesAnotherChild(self)"
          },
          {
            "kind": "operation",
            "operation": "arrangeFromNode",
            "group": "arrange",
            "label": "Arrange diagram",
            "icon": "mdi-sitemap-outline"
          }
        ]
      },
      {
        "for": [
          "diagram"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "addHere",
            "group": "add",
            "forEach": "kinds()",
            "as": "kind",
            "label": {
              "cel": "'Add ' + kindChoice(kind) + ' here'"
            },
            "icon": "mdi-plus",
            "args": {
              "kind": "kind"
            }
          },
          {
            "kind": "operation",
            "operation": "arrange",
            "group": "arrange",
            "label": "Arrange diagram",
            "icon": "mdi-sitemap-outline"
          }
        ],
        "doc": "The menu of the empty canvas: a node of any kind placed where the menu was opened, and Arrange diagram."
      }
    ]
  },
  "behavior": {
    "doc": "Every change - add, remove, rename, change the kind, edit notes, reorder, re-parent, drag - is one undoable step that restores the whole Markdown text.",
    "messages": {
      "std.atStart": "It is already the first of its siblings.",
      "std.atEnd": "It is already the last of its siblings."
    },
    "placements": {
      "underNearestAbove": {
        "candidates": "diagram.nodes.filter(n, takesAnotherChild(n) && n.view.bounds.center()[1] < position.y)",
        "as": "candidate",
        "rank": "math.abs(position.x - candidate.view.bounds.center()[0]) + 2.0 * (position.y - candidate.view.bounds.center()[1])",
        "index": "parent.children.filter(c, c.view.bounds.center()[0] < position.x).size()",
        "whenEmpty": "root",
        "refusal": "Drop the node below the node it belongs under: a Do in order, a Try in order, a Do together, or a Retry, Repeat until, Only while or Ask approval before that has no child yet.",
        "doc": "The parent is the candidate of lowest rank, the first in model order on a tie; the new node goes before its first child whose centre lies right of the drop. An empty tree takes the node as its root."
      }
    },
    "operations": {
      "addChild": {
        "label": "Add child",
        "for": [
          "BehaviorNode"
        ],
        "icon": "mdi-plus",
        "params": {
          "kind": {
            "type": "string",
            "label": "Kind"
          }
        },
        "unavailable": [
          {
            "when": "self.isA('Leaf')",
            "message": {
              "cel": "'\"' + keyword(self) + '\" holds no children. Add the node under a Do in order, Try in order or Do together.'"
            }
          },
          {
            "when": "self.isA('Decorator') && self.children.size() > 0",
            "message": {
              "cel": "'\"' + keyword(self) + '\" holds exactly one child, and already has it.'"
            }
          }
        ],
        "doc": "Adds a node of the chosen kind as the last child, then edits its label in place.",
        "actions": [
          {
            "create": {
              "type": "p.kind",
              "parent": "self",
              "attributes": {
                "label": "startingLabel(p.kind)"
              }
            },
            "as": "added"
          },
          {
            "select": "added"
          },
          {
            "editLabel": {
              "target": "added",
              "label": "label"
            }
          }
        ]
      },
      "addHere": {
        "label": "Add here",
        "for": "diagram",
        "icon": "mdi-plus",
        "params": {
          "kind": {
            "type": "string",
            "label": "Kind"
          }
        },
        "doc": "Adds a node of the chosen kind where the empty-canvas menu was opened, placed as a toolbox drop is, then edits its label in place.",
        "actions": [
          {
            "create": {
              "type": "p.kind",
              "attributes": {
                "label": "startingLabel(p.kind)"
              },
              "place": "underNearestAbove"
            },
            "as": "added"
          },
          {
            "select": "added"
          },
          {
            "editLabel": {
              "target": "added",
              "label": "label"
            }
          }
        ]
      },
      "editNotes": {
        "label": "Edit notes…",
        "for": [
          "BehaviorNode"
        ],
        "icon": "mdi-note-text-outline",
        "params": {
          "notes": {
            "type": "text",
            "label": "Notes",
            "markup": "markdown"
          }
        },
        "paramsForm": "notesDialog",
        "doc": "Replaces the node's notes from a dialog pre-filled with them; empty notes remove the lines.",
        "actions": [
          {
            "set": {
              "notes": "p.notes"
            }
          }
        ]
      },
      "moveUnder": {
        "label": "Move under this node",
        "for": [
          "Child"
        ],
        "icon": "mdi-file-tree-outline",
        "doc": "Run by a new line drawn from a node (the source) to another (the target), mapped from the derived Child's `connect` gesture: the target moves, with everything under it, to be the source's last child. The menu always offers it, as the module does; a line that cannot move the target is refused when it is run, with the writer's sentence, so the refusals are aborts rather than `unavailable` reasons.",
        "actions": [
          {
            "if": "self.source.id == self.target.id || self.target.descendants().exists(d, d.id == self.source.id)",
            "then": [
              {
                "abort": {
                  "message": "'A node cannot move beneath itself.'"
                }
              }
            ]
          },
          {
            "if": "self.source.isA('Leaf')",
            "then": [
              {
                "abort": {
                  "message": {
                    "cel": "'\"' + keyword(self.source) + '\" holds no children.'"
                  }
                }
              }
            ]
          },
          {
            "if": "self.source.isA('Decorator') && self.source.children.size() > 0 && !(self.target.parent != null && self.target.parent.id == self.source.id)",
            "then": [
              {
                "abort": {
                  "message": {
                    "cel": "'\"' + keyword(self.source) + '\" holds exactly one child, and already has it.'"
                  }
                }
              }
            ]
          },
          {
            "if": "self.target.parent != null && self.target.parent.id == self.source.id && self.target.positionIn(self.source.children) == self.source.children.size() - 1",
            "then": [
              {
                "abort": {
                  "message": "'That node is already there.'"
                }
              }
            ]
          },
          {
            "reparent": {
              "target": "self.target",
              "parent": "self.source"
            }
          }
        ]
      },
      "arrange": {
        "label": "Arrange diagram",
        "for": "diagram",
        "icon": "mdi-sitemap-outline",
        "unavailable": [
          {
            "when": "diagram.nodes.size() == 0",
            "message": "There is nothing to arrange until this behavior model has a node."
          }
        ],
        "doc": "Forgets every position a node was dragged to, so the whole tree is drawn by the computed layout again: it removes the registration's `layout:` block and never touches the Markdown, and one undo puts the registration back byte for byte. The plugin refuses with \"This behavior model was opened without a registration, so it has no dragged positions to forget.\" and \"This behavior model is already arranged.\"",
        "plugin": {
          "name": "net.etalii.adp.etalii.abmArrange"
        }
      },
      "arrangeFromNode": {
        "label": "Arrange diagram",
        "for": [
          "BehaviorNode"
        ],
        "icon": "mdi-sitemap-outline",
        "unavailable": [
          {
            "when": "diagram.nodes.size() == 0",
            "message": "There is nothing to arrange until this behavior model has a node."
          }
        ],
        "doc": "Arrange diagram offered on a node, because it is about the whole tree; an operation's `for` cannot name both the diagram and a type.",
        "plugin": {
          "name": "net.etalii.adp.etalii.abmArrange"
        }
      }
    },
    "deletion": {
      "BehaviorNode": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "count": "self.descendants().size()",
          "threshold": 1,
          "title": "Remove",
          "message": {
            "cel": "count == 1 ? 'Removing this node also removes the 1 node beneath it.' : 'Removing this node also removes the ' + string(count) + ' nodes beneath it.'"
          },
          "confirmLabel": "Remove",
          "danger": true
        },
        "doc": "Removing a node removes everything under it, as one splice of its lines. A leaf, or a node with nothing beneath it, goes without asking."
      }
    },
    "retype": {
      "Sequence": {
        "to": [
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Fallback": {
        "to": [
          "Sequence",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Parallel": {
        "to": [
          "Sequence",
          "Fallback",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Retry": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "RepeatUntil": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "Guard",
          "Approval",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Guard": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Approval",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Approval": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Check",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Check": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Do",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Do": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
          "AskUser",
          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "AskUser": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
