          "Delegate"
        ],
        "attributeMapping": {
          "attempts": "has(old.attempts) ? max(old.attempts, 3) : 3"
        }
      },
      "Delegate": {
        "to": [
          "Sequence",
          "Fallback",
          "Parallel",
          "Retry",
          "RepeatUntil",
          "Guard",
          "Approval",
          "Check",
