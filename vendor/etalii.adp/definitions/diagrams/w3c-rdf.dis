{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.w3c.rdf",
    "version": "2.0.0",
    "origin": "w3c/rdf",
    "label": "RDF graph",
    "icon": "mdi-graph-outline",
    "fileExtension": "ttl",
    "license": "Apache-2.0",
    "homepage": "https://www.w3.org/TR/rdf11-concepts/",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "limits": {
      "maxElements": 1000,
      "budgets": {
        "cards": {
          "measure": {
            "count": [
              "Resource",
              "BlankNode"
            ]
          },
          "max": 1000,
          "order": "index",
          "withhold": {
            "edits": "model",
            "reason": {
              "reason": "truncated"
            }
          },
          "notice": {
            "text": {
              "cel": "'Showing ' + string(budget('cards').shown) + ' of ' + string(budget('cards').total) + ' resources — edits are withheld on this truncated view'"
            },
            "severity": "warning",
            "position": "top"
          },
          "doc": "At most 1000 cards are drawn, in the order the file first names them; a statement is drawn only when both its cards are. While it truncates, every edit through the diagram is withheld and moves stay allowed."
        }
      }
    },
    "requires": {
      "conformance": "standard",
      "features": [
        "limits.budgets",
        "persistence.fbl"
      ]
    },
    "doc": {
      "summary": "What an RDF file states: its resources, their relationships and their values, straight from Turtle or N-Triples.",
      "description": "The data graph of an RDF file stored as Turtle (`.ttl`) or N-Triples (`.nt`). Every IRI or blank node in subject or object position is a card; a triple between two of them is a labelled, arrowed edge; a triple whose object is a literal is a row inside its subject's card; an `rdf:type` triple with an IRI object is a type badge on the card, not an edge; an RDF collection is drawn as ordered member edges labelled with their position, its cons cells staying in the file. Nothing is inferred and nothing is fetched: the diagram shows what the file says.\n\nThis is the anchor reading of the file: a bare `.ttl` or `.nt` opens as this diagram, and the OWL, SKOS and SHACL readings (`w3c-owl.dis`, `w3c-skos.dis`, `w3c-shacl.dis`) are chosen deliberately over the same bytes. The turtle plugin reads the file into stored `Triple`, `Prefix` and `Base` elements, which every reading shares; the cards, their rows and badges and the statement edges are derived from them here (4.11). Positions are kept in the `.adp` registration beside the file. What this specification cannot express is written down in `w3c-rdf.md` beside this file.",
      "tags": [
        "rdf",
        "turtle",
        "n-triples",
        "linked data",
        "knowledge graph",
        "semantic web"
      ],
      "seeAlso": [
        {
          "title": "W3C RDF 1.1 Concepts and Abstract Syntax",
          "href": "https://www.w3.org/TR/rdf11-concepts/"
        },
        {
          "title": "W3C RDF 1.1 Turtle",
          "href": "https://www.w3.org/TR/turtle/"
        },
        {
          "title": "W3C RDF 1.1 N-Triples",
          "href": "https://www.w3.org/TR/n-triples/"
        },
        {
          "title": "What DISL cannot express for this tool",
          "href": "w3c-rdf.md"
        }
      ]
    }
  },
  "functions": {
    "typeTriple": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "bool",
      "cel": "t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' && t.oKind == 'iri'",
      "doc": "An `rdf:type` triple with an IRI object: a type, never an edge."
    },
    "isCell": {
      "params": [
        {
          "name": "ordinal",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'blank' && t.s == ordinal && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first')",
      "doc": "Whether a blank node is a cons cell of an RDF collection: one with an `rdf:first` triple."
    },
    "isPlumbing": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "bool",
      "cel": "t.sKind == 'blank' && (t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first' || t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest') && isCell(t.s)",
      "doc": "A collection's `rdf:first` or `rdf:rest` triple, which is folded into its members and never drawn itself."
    },
    "collectionMembers": {
      "params": [
        {
          "name": "cell",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "recursion": {
        "maxDepth": 1000,
        "atMaxDepth": "[]"
      },
      "cel": "cel.bind(f, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == cell && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first'), cel.bind(r, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == cell && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest'), f.size() == 0 ? [] : [f[0]] + (r.size() > 0 && r[0].oKind == 'blank' && isCell(r[0].o) ? collectionMembers(r[0].o) : [])))",
      "doc": "The `rdf:first` triples of the collection starting at `cell`, in order, walked through `rdf:rest` until `rdf:nil` or a node that is no cons cell."
    },
    "repeatSuffix": {
      "params": [
        {
          "name": "e",
          "type": "Element"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(same, e.isA('Triple') ? diagram.nodesOfType('Triple').filter(u, u.s == e.s && u.p == e.p && u.o == e.o) : diagram.nodesOfType('Prefix').filter(u, u.name == e.name), cel.bind(n, e.positionIn(same), n > 0 ? '|' + string(n) : ''))",
      "doc": "The repeat counter of a stored triple or prefix declaration (11.5.2): '' for the first with its parts, '|1' for the second and so on, in reading order."
    },
    "withRepeat": {
      "params": [
        {
          "name": "xs",
          "type": "list"
        }
      ],
      "returns": "list",
      "cel": "lists.range(xs.size()).map(i, xs[i] + [lists.range(i).filter(j, xs[j][0] == xs[i][0]).size()])",
      "doc": "Each item of `xs`, whose first entry is its key, with the number of earlier items of the same key appended: the repeat counter of a derived edge id (11.5.2), 0 for the first."
    },
    "cardId": {
      "params": [
        {
          "name": "term",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "(kind == 'blank' ? 'blank:' : 'res:') + term",
      "doc": "The id of the card the RDF graph reading draws a subject or object term as."
    },
    "cardTerms": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "isPlumbing(t) ? [] : ([[t.s, t.sKind, t.sLabel, t]] + (typeTriple(t) || t.oKind == 'literal' ? [] : (t.oKind == 'blank' && isCell(t.o) ? collectionMembers(t.o).filter(m, m.oKind != 'literal').map(m, [m.o, m.oKind, m.oLabel, t]) : [[t.o, t.oKind, t.oLabel, t]])))",
      "doc": "The terms a triple draws an RDF graph card for, in the order the tool meets them: its subject, then its object or its collection's members, each with its kind, its written label and the triple. A type's IRI and a literal are no card; a cons cell is folded away."
    },
    "familyTruncated": {
      "params": [],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').map(t, cardTerms(t)).flatten().map(c, cardId(c[0], c[1])).distinct().size() > 1000",
      "doc": "Whether the RDF graph reading of this body is cut by its budget of 1000 cards. Every reading withholds its edits while it is, because the tool gates every reading's edits on that one count."
    },
    "cardTerm": {
      "params": [
        {
          "name": "term",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        }
      ],
      "returns": "Element",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.elementById(cardId(term, kind))",
      "doc": "The card a subject or object term is drawn as."
    }
  },
  "metamodel": {
    "doc": "The plugin reads one stored `Triple` per triple, one `Prefix` per directive and at most one `Base`, and none of them is drawn. Every card and edge is derived from the triples (4.11): a card groups every triple that names its term, and a statement is a triple between two cards. Derived elements are never written and fire no hooks; their edits go through the operations their `edits` name.",
    "dataTypes": {
      "LiteralRow": {
        "doc": "One literal value folded into its subject's card, in document order, duplicates kept.",
        "fields": {
          "predicate": {
            "type": "string",
            "required": true,
            "doc": "The predicate as drawn, with `[n]` after it for the n-th member of a collection."
          },
          "value": {
            "type": "string",
            "required": true,
            "doc": "The lexical form, quotes stripped and escapes resolved."
          },
          "annotation": {
            "type": "string",
            "default": "",
            "doc": "`@` and the language tag, else the datatype as a prefixed name, else nothing for a plain or `xsd:string` literal."
          }
        },
        "display": {
          "cel": "value.predicate + ': ' + value.value + (value.annotation != '' ? ' ' + value.annotation : '')"
        }
      }
    },
    "enums": {
      "TermKind": {
        "values": {
          "iri": {
            "label": "IRI"
          },
          "blank": {
            "label": "Blank node"
          },
          "literal": {
            "label": "Literal"
          }
        }
      },
      "PrefixForm": {
        "values": {
          "turtle": {
            "label": "@prefix"
          },
          "sparql": {
            "label": "PREFIX"
          }
        }
      }
    },
    "types": {
      "Triple": {
        "doc": "One triple of the file as the plugin reads it, with the line it starts on. Never drawn: every drawn element is derived from these.",
        "attributes": {
          "s": {
            "type": "string",
            "required": true,
            "doc": "The subject: an IRI, or for a blank node its ordinal, the zero-based order of first appearance in this parse."
          },
          "sKind": {
            "type": "TermKind",
            "required": true
          },
          "sLabel": {
            "type": "string",
            "default": "",
            "doc": "A blank subject's label as written (`_:x` is `x`); '' for an IRI or an anonymous blank node."
          },
          "p": {
            "type": "uri",
            "required": true
          },
          "o": {
            "type": "string",
            "required": true,
            "doc": "The object: an IRI, a blank node's ordinal, or a literal's lexical form."
          },
          "oKind": {
            "type": "TermKind",
            "required": true
          },
          "oLabel": {
            "type": "string",
            "default": "",
            "doc": "A blank object's label as written; '' otherwise."
          },
          "language": {
            "type": "string",
            "default": ""
          },
          "datatype": {
            "type": "string",
            "default": ""
          },
          "line": {
            "type": "int",
            "readOnly": true,
            "doc": "The 1-based line the triple's subject is written on."
          }
        }
      },
      "Prefix": {
        "doc": "One `@prefix` or `PREFIX` directive, re-declarations included, in document order. Never drawn.",
        "attributes": {
          "name": {
            "type": "string",
            "required": true,
            "doc": "The prefix without its colon; '' for the default prefix."
          },
          "iri": {
            "type": "uri",
            "required": true
          },
          "form": {
            "type": "PrefixForm",
            "default": "turtle"
          },
          "line": {
            "type": "int",
            "readOnly": true
          }
        }
      },
      "Base": {
        "doc": "The file's last `@base` or `BASE` directive; at most one. Never drawn.",
        "multiplicity": {
          "max": 1
        },
        "attributes": {
          "iri": {
            "type": "uri",
            "required": true,
            "readOnly": true
          }
        }
      },
      "Term": {
        "abstract": true,
        "doc": "What resource cards and blank-node cards share: the types the file asserts for them and the literal rows they carry.",
        "attributes": {
          "types": {
            "type": "uri",
            "many": true,
            "readOnly": true,
            "doc": "Objects of the term's `rdf:type` triples with an IRI object, in document order, duplicates kept."
          },
          "rows": {
            "type": "LiteralRow",
            "many": true,
            "readOnly": true
          },
          "badgeLine": {
            "type": "string",
            "derived": "self.types.map(t, rdfDisplayName(t)).join(' · ')"
          },
          "band": {
            "type": "string",
            "derived": "size(self.types) > 0 ? rdfDisplayName(self.types[0]) : ''",
            "doc": "The layout band: the display form of the first type, '' for an untyped card."
          }
        }
      },
      "Resource": {
        "extends": "Term",
        "label": "Resource",
        "labelAttribute": "display",
        "attributes": {
          "iri": {
            "type": "uri",
            "label": "IRI",
            "group": "Identity"
          },
          "display": {
            "type": "string",
            "derived": "rdfDisplayName(self.iri)"
          },
          "typesText": {
            "type": "string",
            "label": "Types",
            "group": "Identity",
            "derived": "self.types.map(t, rdfDisplayName(t)).join(', ')"
          },
          "label": {
            "type": "string",
            "label": "Label",
            "group": "Documentation",
            "derived": "self.sources.exists(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal') ? self.sources.filter(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal')[0].o : ''"
          },
          "comment": {
            "type": "text",
            "label": "Comment",
            "group": "Documentation",
            "derived": "self.sources.exists(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal') ? self.sources.filter(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal')[0].o : ''"
          }
        },
        "derived": {
          "from": "diagram.nodesOfType('Triple').map(t, cardTerms(t)).flatten().filter(c, c[1] == 'iri')",
          "key": "item[0]",
          "id": "'res:' + item[0]",
          "attributes": {
            "iri": "item[0]",
            "types": "group.map(g, g[3]).distinct().filter(t, t.s == item[0] && typeTriple(t)).map(t, t.o)",
            "rows": "group.map(g, g[3]).distinct().filter(t, t.s == item[0] && !typeTriple(t)).map(t, t.oKind == 'literal' ? [{'predicate': rdfDisplayName(t.p), 'value': t.o, 'annotation': (t.language != '' ? '@' + t.language : (t.datatype != '' && t.datatype != 'http://www.w3.org/2001/XMLSchema#string' ? rdfCompress(t.datatype) : ''))}] : (t.oKind == 'blank' && isCell(t.o) ? collectionMembers(t.o).filter(m, m.oKind == 'literal').map(m, {'predicate': rdfDisplayName(t.p) + ' [' + string(collectionMembers(t.o).indexOf(m) + 1) + ']', 'value': m.o, 'annotation': (m.language != '' ? '@' + m.language : (m.datatype != '' && m.datatype != 'http://www.w3.org/2001/XMLSchema#string' ? rdfCompress(m.datatype) : ''))}) : [])).flatten()"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'iri' && t.s == item[0]) || (t.oKind == 'iri' && t.o == item[0]))",
          "reason": "Resources are read from the triples; add, rename or remove them through the context menu.",
          "edits": {
            "delete": "removeResource",
            "rename": "renameResource",
            "attribute:label": "setLabel",
            "attribute:comment": "setComment"
          },
          "doc": "One card per IRI in subject or object position, in the order the file first names it, grouping every triple that names it. A class used only as an `rdf:type` object is a badge, not a card."
        }
      },
      "BlankNode": {
        "extends": "Term",
        "label": "Blank node",
        "labelAttribute": "name",
        "attributes": {
          "ordinal": {
            "type": "string",
            "readOnly": true,
            "doc": "The order of first appearance within one parse."
          },
          "writtenLabel": {
            "type": "string",
            "default": "",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "label": "Node",
            "group": "Identity",
            "derived": "self.writtenLabel != '' ? '_:' + self.writtenLabel : '_:b' + self.ordinal"
          }
        },
        "derived": {
          "from": "diagram.nodesOfType('Triple').map(t, cardTerms(t)).flatten().filter(c, c[1] == 'blank')",
          "key": "item[0]",
          "id": "'blank:' + item[0]",
          "attributes": {
            "ordinal": "item[0]",
            "writtenLabel": "item[2]",
            "types": "group.map(g, g[3]).distinct().filter(t, t.s == item[0] && t.sKind == 'blank' && typeTriple(t)).map(t, t.o)",
            "rows": "group.map(g, g[3]).distinct().filter(t, t.s == item[0] && t.sKind == 'blank' && !typeTriple(t)).map(t, t.oKind == 'literal' ? [{'predicate': rdfDisplayName(t.p), 'value': t.o, 'annotation': (t.language != '' ? '@' + t.language : (t.datatype != '' && t.datatype != 'http://www.w3.org/2001/XMLSchema#string' ? rdfCompress(t.datatype) : ''))}] : (t.oKind == 'blank' && isCell(t.o) ? collectionMembers(t.o).filter(m, m.oKind == 'literal').map(m, {'predicate': rdfDisplayName(t.p) + ' [' + string(collectionMembers(t.o).indexOf(m) + 1) + ']', 'value': m.o, 'annotation': (m.language != '' ? '@' + m.language : (m.datatype != '' && m.datatype != 'http://www.w3.org/2001/XMLSchema#string' ? rdfCompress(m.datatype) : ''))}) : [])).flatten()"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'blank' && t.s == item[0]) || (t.oKind == 'blank' && t.o == item[0]))",
          "reason": "A blank node's identity does not survive a reparse, so nothing about it can be edited from the diagram."
        }
      }
    },
    "relations": {
      "Statement": {
        "label": "Statement",
        "source": {
          "types": [
            "Resource",
            "BlankNode"
          ]
        },
        "target": {
          "types": [
            "Resource",
            "BlankNode"
          ]
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "predicateIri": {
            "type": "uri",
            "label": "Predicate",
            "group": "Identity"
          },
          "predicate": {
            "type": "string",
            "readOnly": true,
            "doc": "The predicate as drawn, with `[n]` for a collection member."
          },
          "direct": {
            "type": "bool",
            "readOnly": true,
            "doc": "Whether the edge is one triple between two resources, which is what Remove statement removes; a collection member's edge and a blank node's are not."
          }
        },
        "derived": {
          "from": "withRepeat(diagram.nodesOfType('Triple').filter(t, !isPlumbing(t) && !typeTriple(t) && t.oKind != 'literal').map(t, t.oKind == 'blank' && isCell(t.o) ? collectionMembers(t.o).filter(m, m.oKind != 'literal').map(m, [cardId(t.s, t.sKind) + '|' + t.p + '|' + cardId(m.o, m.oKind), t, m.o, m.oKind, rdfDisplayName(t.p) + ' [' + string(collectionMembers(t.o).indexOf(m) + 1) + ']']) : [[cardId(t.s, t.sKind) + '|' + t.p + '|' + cardId(t.o, t.oKind), t, t.o, t.oKind, rdfDisplayName(t.p)]]).flatten())",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "cardTerm(item[1].s, item[1].sKind)",
          "target": "cardTerm(item[2], item[3])",
          "attributes": {
            "predicateIri": "item[1].p",
            "predicate": "item[4]",
            "direct": "item[1].sKind == 'iri' && item[3] == 'iri' && item[2] == item[1].o"
          },
          "sources": "[item[1]]",
          "reason": "A statement is a triple of the file; remove it, or relate two resources to state a new one.",
          "edits": {
            "delete": "removeStatement",
            "connect": "relate"
          },
          "doc": "One edge per triple between two cards, and one per member of a collection, labelled with the member's 1-based position. A repeated edge between the same two cards with the same predicate takes a repeat counter after its id (`edge:a|p|b|1`), as the tool numbers them."
        }
      }
    }
  },
  "notation": {
    "doc": "Resource cards in the Ontodia convention: a titled box listing its literal rows, one straight arrowed edge per statement. Cards are arranged in bands by their first type, which is the module's layout code (`w3c-rdf.md`).",
    "theme": {
      "tokens": {
        "color.surface": "#ffffff",
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.border": "#e2e8f0",
        "color.primary": "limegreen",
        "font.body": "system-ui, sans-serif"
      },
      "modes": {
        "dark": {
          "color.surface": "#1e293b",
          "color.text": "#f1f5f9",
          "color.text.muted": "#94a3b8",
          "color.border": "#334155"
        }
      },
      "followSystem": true
    },
    "styles": {
      "card": {
        "fill": {
          "token": "color.surface"
        },
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1.5
        },
        "font": {
          "family": {
            "token": "font.body"
          },
          "size": 12,
          "color": {
            "token": "color.text"
          }
        }
      },
      "badge": {
        "font": {
          "size": 11,
          "color": {
            "token": "color.primary"
          }
        }
      },
      "row": {
        "font": {
          "size": 11,
          "color": {
            "token": "color.text.muted"
          }
        }
      },
      "statement": {
        "stroke": {
          "color": {
            "token": "color.text.muted"
          },
          "width": 1.5
        },
        "font": {
          "size": 11,
          "color": {
            "token": "color.text.muted"
          }
        }
      }
    },
    "nodes": {
      "Resource": {
        "shape": "rect",
        "style": "card",
        "size": {
          "default": [
            220,
            40
          ],
          "resizable": false,
          "autoSize": "fitHeight"
        },
        "labels": [
          {
            "id": "title",
            "text": {
              "attribute": "display"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          },
          {
            "id": "badges",
            "text": {
              "attribute": "badgeLine"
            },
            "position": {
              "anchor": [
                0,
                0
              ],
              "offset": [
                8,
                40
              ],
              "align": "start"
            },
            "style": "badge",
            "overflow": "ellipsis",
            "maxLines": 1,
            "visible": {
              "cel": "size(self.types) > 0"
            }
          }
        ],
        "compartments": [
          {
            "id": "rows",
            "items": {
              "attribute": "rows"
            },
            "itemText": {
              "cel": "item.predicate + ': ' + item.value + (item.annotation != '' ? ' ' + item.annotation : '')"
            },
            "itemStyle": "row",
            "layout": "vertical",
            "separator": "none",
            "overflow": "grow"
          }
        ],
        "anchors": {
          "mode": "fixed",
          "points": [
            {
              "id": "w",
              "x": 0,
              "y": 0.5
            },
            {
              "id": "e",
              "x": 1,
              "y": 0.5
            }
          ]
        },
        "tooltip": {
          "cel": "self.iri"
        },
        "copyable": false,
        "doubleClick": "none",
        "refusals": {
          "reparent": [
            "A resource has no parent to move it under; dragging changes where it sits on the canvas."
          ]
        }
      },
      "BlankNode": {
        "shape": "rect",
        "style": [
          "card",
          {
            "stroke": {
              "dash": [
                5,
                3
              ],
              "dashScale": "absolute"
            },
            "opacity": 0.75
          }
        ],
        "size": {
          "default": [
            220,
            40
          ],
          "resizable": false,
          "autoSize": "fitHeight"
        },
        "labels": [
          {
            "id": "title",
            "text": {
              "attribute": "name"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          },
          {
            "id": "badges",
            "text": {
              "attribute": "badgeLine"
            },
            "position": {
              "anchor": [
                0,
                0
              ],
              "offset": [
                8,
                40
              ],
              "align": "start"
            },
            "style": "badge",
            "overflow": "ellipsis",
            "maxLines": 1,
            "visible": {
              "cel": "size(self.types) > 0"
            }
          }
        ],
        "compartments": [
          {
            "id": "rows",
            "items": {
              "attribute": "rows"
            },
            "itemText": {
              "cel": "item.predicate + ': ' + item.value + (item.annotation != '' ? ' ' + item.annotation : '')"
            },
            "itemStyle": "row",
            "layout": "vertical",
            "separator": "none",
            "overflow": "grow"
          }
        ],
        "anchors": {
          "mode": "outline"
        },
        "tooltip": "Blank node",
        "copyable": false,
        "doubleClick": "none",
        "doc": "Dashed and at 75 % opacity: visibly provisional, the blank-node identity boundary's look."
      }
    },
    "edges": {
      "Statement": {
        "style": "statement",
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "predicate",
            "text": {
              "attribute": "predicate"
            },
            "at": "middle",
            "side": "above",
            "distance": 6,
            "editable": false
          }
        ],
        "reconnectable": false,
        "hitWidthScreenPx": 14,
        "selectable": {
          "cel": "self.direct"
        },
        "refusals": {
          "move": [
            "That element is not something this diagram can move."
          ]
        },
        "connect": {
          "from": {
            "w": "source",
            "e": "source"
          },
          "doc": "A statement starts at a card's left or right side; the card dragged from becomes its subject."
        }
      }
    }
  },
  "forms": {
    "resourceInspector": {
      "for": [
        "Resource"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "iri",
              "id": "iri",
              "widget": "readonly",
              "readOnlyReasons": [
                "Rename through the context menu, so every reference follows the name."
              ]
            },
            {
              "attribute": "typesText",
              "id": "types",
              "widget": "readonly",
              "readOnlyReasons": [
                "Types are stated by triples; add or remove them as statements."
              ]
            }
          ]
        },
        {
          "kind": "section",
          "label": "Documentation",
          "items": [
            {
              "attribute": "label",
              "id": "label",
              "widget": "text",
              "readOnlyReasons": [
                {
                  "reason": "truncated"
                }
              ]
            },
            {
              "attribute": "comment",
              "id": "comment",
              "widget": "text",
              "readOnlyReasons": [
                {
                  "reason": "truncated"
                }
              ]
            }
          ]
        }
      ]
    },
    "blankInspector": {
      "for": [
        "BlankNode"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "name",
              "id": "iri",
              "widget": "readonly",
              "readOnlyReasons": [
                "A blank node's identity does not survive a reparse, so nothing about it can be edited from the diagram."
              ]
            }
          ]
        }
      ]
    },
    "statementInspector": {
      "for": [
        "Statement"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "predicateIri",
              "id": "predicateIri",
              "widget": "readonly",
              "display": {
                "cel": "rdfDisplayName(self.predicateIri)"
              },
              "readOnlyReasons": [
                "A statement's predicate is the statement; remove and restate to change it."
              ]
            }
          ]
        }
      ]
    },
    "addResourceDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Add resource",
      "icon": "mdi-card-plus-outline",
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "iri",
          "label": "IRI or prefixed name",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "declarePrefixDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Declare prefix",
      "icon": "mdi-at",
      "submitLabel": "Declare",
      "items": [
        {
          "attribute": "declaration",
          "label": "Declaration, e.g. ex: http://example.org/",
          "validate": [
            {
              "rule": "value.matches('^\\\\s*[^:\\\\s]+\\\\s*:\\\\s*<?[A-Za-z][A-Za-z0-9+.-]*:[^\\\\s<>]*>?\\\\s*$')",
              "message": "Write the declaration as 'prefix: iri', e.g. ex: http://example.org/."
            }
          ]
        }
      ]
    },
    "relateDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Relate",
      "icon": "mdi-ray-start-arrow",
      "submitLabel": "Relate",
      "items": [
        {
          "attribute": "predicate",
          "label": "Predicate (IRI or prefixed name)",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "renameDialog": {
      "for": [
        "Resource"
      ],
      "usage": [
        "popover"
      ],
      "label": "Rename resource",
      "icon": "mdi-pencil-outline",
      "submitLabel": "Rename",
      "items": [
        {
          "attribute": "newName",
          "label": "New IRI or prefixed name",
          "initial": "rdfCompress(self.iri)",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            },
            {
              "rule": "!diagram.nodesOfType('Triple').exists(t, (t.sKind == 'iri' && t.s == rdfResolveTerm(value)) || (t.oKind == 'iri' && t.o == rdfResolveTerm(value)))",
              "message": {
                "cel": "rdfResolveTerm(value) + ' already names something in this document; renaming onto it would silently merge two resources.'"
              }
            }
          ]
        }
      ]
    }
  },
  "toolbox": {
    "generic": {
      "select": true,
      "pan": true
    },
    "groups": [
      {
        "id": "rdf",
        "label": "RDF",
        "tools": [
          {
            "id": "resource",
            "kind": "operation",
            "operation": "addResource",
            "label": "Resource",
            "icon": "mdi-card-plus-outline",
            "mode": "drop",
            "doc": "An IRI-named resource. Drop it where it should sit; you will be asked for its name."
          },
          {
            "id": "prefix",
            "kind": "operation",
            "operation": "declarePrefix",
            "label": "Prefix",
            "icon": "mdi-at",
            "mode": "drop",
            "doc": "A namespace declaration, so terms can be written short."
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "Resource"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "renameResource",
            "label": "Rename…",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "removeResource",
            "icon": "mdi-delete-outline",
            "shortcut": "Delete"
          }
        ]
      },
      {
        "for": [
          "Statement"
        ],
        "when": "self.direct",
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "removeStatement",
            "label": "Remove statement",
            "icon": "mdi-vector-polyline-remove",
            "shortcut": "Delete"
          }
        ]
      },
      {
        "for": [
          "diagram"
        ],
        "placement": "menu",
        "standardEntries": false,
        "doc": "A placement: the empty canvas at a point.",
        "tools": [
          {
            "kind": "operation",
            "operation": "addResource",
            "label": "Add resource here…",
            "icon": "mdi-card-plus-outline"
          },
          {
            "kind": "operation",
            "operation": "declarePrefix",
            "label": "Declare prefix…",
            "icon": "mdi-at"
          }
        ]
      },
      {
        "for": [
          "connection"
        ],
        "placement": "menu",
        "standardEntries": false,
        "doc": "A finished connect gesture between two cards.",
        "tools": [
          {
            "kind": "operation",
            "operation": "relate",
            "label": "Relate…",
            "icon": "mdi-ray-start-arrow",
            "args": {
              "from": "source",
              "to": "target"
            }
          }
        ]
      }
    ]
  },
  "constraints": {
    "doc": "Facts about the file, never a reasoner's opinion. The five `rdf.*` findings are the plugin's own, raised as it reads the body and shared by every reading of it (FBL 9.1); a body that does not parse is `rdf.unparseable`, which replaces every other finding.",
    "builtIn": {
      "std.unparseable": {
        "code": "rdf.unparseable",
        "message": {
          "cel": "'This is not RDF that can be read: ' + detail.reason"
        }
      }
    }
  },
  "behavior": {
    "reasons": {
      "truncated": {
        "when": "budget('cards').truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead.",
        "doc": "The truncation gate: one sentence, shown on every withheld gesture, menu entry and property row."
      }
    },
    "editGate": [
      {
        "reason": "truncated"
      }
    ],
    "messages": {
      "std.notApplicable": {
        "cel": "'\\'' + operationId + '\\' does not apply to this selection.'"
      }
    },
    "operations": {
      "addResource": {
        "label": "Add resource here…",
        "icon": "mdi-card-plus-outline",
        "for": "diagram",
        "params": {
          "iri": {
            "type": "string",
            "label": "IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "addResourceDialog",
        "doc": "Writes one triple, `{iri} a rdfs:Resource`; the card follows from it.",
        "actions": [
          {
            "if": "rdfResolveTerm(p.iri) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.iri)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "rdfResolveTerm(p.iri)",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/1999/02/22-rdf-syntax-ns#type'",
                "o": "'http://www.w3.org/2000/01/rdf-schema#Resource'",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "declarePrefix": {
        "label": "Declare prefix…",
        "icon": "mdi-at",
        "for": "diagram",
        "params": {
          "declaration": {
            "type": "string",
            "label": "Declaration, e.g. ex: http://example.org/",
            "required": true
          }
        },
        "paramsForm": "declarePrefixDialog",
        "doc": "Writes one `@prefix` directive from `prefix: iri`, brackets tolerated. A plugin action: the directive is written where the tool writes it, after the last declaration, which no change of one stored element says (`w3c-rdf.md`, gap 2).",
        "plugin": {
          "name": "net.etalii.adp.w3c.turtle",
          "args": {
            "action": "addPrefix"
          }
        }
      },
      "renameResource": {
        "label": "Rename…",
        "for": [
          "Resource"
        ],
        "params": {
          "newName": {
            "type": "string",
            "label": "New IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "renameDialog",
        "doc": "Rewrites every token that names the IRI, in subject, predicate, object and datatype position, bracketed or prefixed under the prefixes in force where it stands. A plugin action, since no change of one stored element says it (`w3c-rdf.md`, gap 2).",
        "plugin": {
          "name": "net.etalii.adp.w3c.turtle",
          "args": {
            "action": "renameTerm"
          }
        }
      },
      "removeResource": {
        "for": [
          "Resource"
        ],
        "label": {
          "cel": "self.sources.size() == 1 ? 'Remove' : 'Remove (with ' + string(self.sources.size()) + ' statements)'"
        },
        "confirm": {
          "count": "self.sources.size()",
          "threshold": 2,
          "title": "Remove resource",
          "message": {
            "cel": "'Removing this resource also removes the ' + string(count) + ' statements it appears in.'"
          },
          "confirmLabel": "Remove",
          "danger": true
        },
        "doc": "Removes every triple the card is drawn from; the card disappears on recomputation. A resource in one statement goes without a question.",
        "actions": [
          {
            "delete": "self.sources"
          }
        ]
      },
      "removeStatement": {
        "label": "Remove statement",
        "for": [
          "Statement"
        ],
        "actions": [
          {
            "delete": "self.sources"
          }
        ]
      },
      "relate": {
        "label": "Relate…",
        "icon": "mdi-ray-start-arrow",
        "for": "diagram",
        "params": {
          "from": {
            "type": "Term",
            "required": true
          },
          "to": {
            "type": "Term",
            "required": true
          },
          "predicate": {
            "type": "string",
            "label": "Predicate (IRI or prefixed name)",
            "required": true
          }
        },
        "paramsForm": "relateDialog",
        "actions": [
          {
            "if": "p.from.isA('BlankNode') || p.to.isA('BlankNode')",
            "then": [
              {
                "abort": {
                  "message": "'A blank node\\'s identity does not survive a reparse, so relations to it cannot land in the file. Name it with an IRI first.'"
                }
              }
            ]
          },
          {
            "if": "rdfResolveTerm(p.predicate) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.predicate)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "p.from.iri",
                "sKind": "'iri'",
                "p": "rdfResolveTerm(p.predicate)",
                "o": "p.to.iri",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "setLabel": {
        "label": "Label",
        "for": [
          "Resource"
        ],
        "params": {
          "value": {
            "type": "string",
            "required": true
          }
        },
        "doc": "Rewrites the lexical form of the first `rdfs:label` literal, keeping its language and datatype, or adds a plain one when there is none.",
        "actions": [
          {
            "if": "self.sources.exists(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal')",
            "then": [
              {
                "target": "self.sources.filter(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal')[0]",
                "set": {
                  "o": "p.value"
                }
              }
            ],
            "else": [
              {
                "create": {
                  "type": "'Triple'",
                  "attributes": {
                    "s": "self.iri",
                    "sKind": "'iri'",
                    "p": "'http://www.w3.org/2000/01/rdf-schema#label'",
                    "o": "p.value",
                    "oKind": "'literal'"
                  }
                }
              }
            ]
          }
        ]
      },
      "setComment": {
        "label": "Comment",
        "for": [
          "Resource"
        ],
        "params": {
          "value": {
            "type": "string",
            "required": true
          }
        },
        "doc": "Rewrites the lexical form of the first `rdfs:comment` literal, keeping its language and datatype, or adds a plain one when there is none.",
        "actions": [
          {
            "if": "self.sources.exists(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal')",
            "then": [
              {
                "target": "self.sources.filter(t, t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal')[0]",
                "set": {
                  "o": "p.value"
                }
              }
            ],
            "else": [
              {
                "create": {
                  "type": "'Triple'",
                  "attributes": {
                    "s": "self.iri",
                    "sKind": "'iri'",
                    "p": "'http://www.w3.org/2000/01/rdf-schema#comment'",
                    "o": "p.value",
                    "oKind": "'literal'"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "doc": "An edit writes triples, and the cards and edges follow from recomputation; no hook fires for a derived element."
  },
  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/rdf/backend/EtAlii.Adp.Diagram.Rdf/w3c-turtle.fbl#turtle",
    "doc": "The RDF file itself is the model, read and written through the module's FBL binding and the turtle plugin; positions live in the `.adp` registration, keyed by element id.",
    "ids": {
      "strategy": "natural",
      "stable": false,
      "types": {
        "Triple": {
          "strategy": "derived",
          "expression": "'triple:' + self.s + '|' + self.p + '|' + self.o + repeatSuffix(self)",
          "ephemeral": {
            "cel": "self.sKind == 'blank' || self.oKind == 'blank'"
          },
          "doc": "A triple by its three parts and a repeat counter. One that names a blank node is ephemeral, since the blank's label is the parse's own."
        },
        "Prefix": {
          "strategy": "derived",
          "expression": "'prefix:' + self.name + repeatSuffix(self)",
          "doc": "A declaration by its prefix and a repeat counter for a re-declaration."
        },
        "Base": {
          "strategy": "derived",
          "expression": "'base'",
          "doc": "A fixed singleton id."
        },
        "BlankNode": {
          "ephemeral": true,
          "reason": "That is a blank node, whose identity does not survive a reparse, so a stored position could not be trusted. Name it with an IRI to arrange it."
        }
      },
      "pattern": "^(res:.+|blank:[0-9]+|edge:.+|triple:.+|prefix:.*|base|truncation)$"
    },
    "view": {
      "store": [
        "bounds"
      ],
      "styleOverrides": "none"
    }
  },
  "layout": {
    "doc": "Pure and deterministic, no physics: the same file always opens the same way. Authored positions from the registration override computed ones element by element.",
    "algorithms": {
      "typeBands": {
        "algorithm": "plugin:net.etalii.adp.w3c.rdfTypeBands",
        "direction": "down",
        "spacing": {
          "node": 60,
          "layer": 160,
          "component": 80
        },
        "options": {
          "columns": 4,
          "columnWidth": 280,
          "rowHeight": 160,
          "bandGap": 80
        },
        "doc": "One band per first type badge, typed bands in ordinal order of the badge text and the untyped band last; inside a band cards fill a four-column grid in document order."
      },
      "fallback": {
        "algorithm": "lanes",
        "direction": "down",
        "spacing": {
          "node": 60,
          "layer": 160,
          "component": 80
        },
        "options": {
          "laneBy": "band"
        },
        "doc": "What a runtime without the plugin uses: one lane per `band` value."
      }
    },
    "default": "typeBands",
    "trigger": "onLoadIfMissing",
    "respect": "all",
    "incremental": true
  },
  "viewpoints": {
    "graph": {
      "label": "Graph",
      "exclude": [
        "Triple",
        "Prefix",
        "Base"
      ],
      "default": true
    }
  },
  "plugins": {
    "net.etalii.adp.w3c.turtle": {
      "version": "^0.1.0",
      "required": true,
      "provides": [
        "persistenceFormat",
        "celFunctions",
        "action"
      ],
      "plans": [
        "add",
        "set",
        "remove"
      ],
      "doc": "The RDF family's engine: it reads a `.ttl` or `.nt` body into the stored `Triple`, `Prefix` and `Base` elements and the five `rdf.*` findings, plans the splices of an added, set or removed triple, carries out the two edits that are not a change of one triple (renaming a term everywhere it is written, declaring a prefix; gap 2 of `w3c-rdf.md`), and provides the naming functions. Every function is called by its bare name.",
      "celFunctions": [
        {
          "name": "rdfLocalName",
          "params": [
            {
              "name": "iri",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 1,
          "fallback": "iri.substring(math.greatest(iri.lastIndexOf('#'), iri.lastIndexOf('/')) + 1)",
          "doc": "The part of an IRI after its last '#' or '/', or the whole IRI."
        },
        {
          "name": "rdfDisplayName",
          "params": [
            {
              "name": "iri",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "rdfLocalName(iri) != '' ? rdfLocalName(iri) : iri",
          "doc": "An IRI as drawn: a prefixed name under the file's prefixes, else the local name, else the IRI."
        },
        {
          "name": "rdfCompress",
          "params": [
            {
              "name": "iri",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "'<' + iri + '>'",
          "doc": "An IRI as the writer spells it: `prefix:local`, else the bracketed `<iri>`."
        },
        {
          "name": "rdfResolveTerm",
          "params": [
            {
              "name": "term",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "doc": "The full IRI a typed term names; '' when it names nothing. No fallback: without the engine a typed term cannot be resolved, so the dialogs refuse."
        },
        {
          "name": "rdfMintIri",
          "params": [
            {
              "name": "label",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "doc": "The IRI a new term labelled `label` starts life under: the namespace of the prefix the file's first prefixed subject is written under, else the first declared prefix, then the label with every character but ASCII letters, digits, '-' and '_' replaced by '_' and '_' trimmed from both ends; '' when there is no prefix or nothing usable is left. No fallback: the written form of a subject is the engine's."
        },
        {
          "name": "rdfMintRefusal",
          "params": [
            {
              "name": "label",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "'\\'' + label + '\\' cannot be turned into an IRI without the RDF engine.'",
          "doc": "The sentence explaining why rdfMintIri returned ''."
        },
        {
          "name": "rdfTermRefusal",
          "params": [
            {
              "name": "term",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "'\\'' + term + '\\' cannot be resolved without the RDF engine.'",
          "doc": "The sentence explaining why rdfResolveTerm returned ''."
        }
      ]
    }
  },
  "x-rdf": {
    "doc": "Today's wire ids, which the standalone client and backend share, mapped from this specification's names. A tool is keyed by its id, an action by its operation, a property by its form item's id.",
    "tools": {
      "resource": {
        "id": "rdf.toolbox.resource",
        "drop": "rdf.add-resource"
      },
      "prefix": {
        "id": "rdf.toolbox.prefix",
        "drop": "rdf.add-prefix"
      }
    },
    "actions": {
      "addResource": "rdf.add-resource",
      "declarePrefix": "rdf.add-prefix",
      "relate": "rdf.connect",
      "renameResource": "rdf.rename-resource",
      "removeResource": "rdf.remove-resource",
      "removeStatement": "rdf.remove-edge"
    },
    "properties": {
      "iri": "rdf.iri",
      "types": "rdf.types",
      "label": "rdf.label",
      "comment": "rdf.comment",
      "predicateIri": "rdf.predicate"
    }
  },
  "x-adp": {
    "origin": "w3c/rdf",
    "state": "implemented",
    "extensions": [
      ".ttl",
      ".nt"
    ],
    "claimsBareFiles": true,
    "suggestWhenBodyContains": [],
    "family": [
      "w3c/rdf",
      "w3c/owl",
      "w3c/skos",
      "w3c/shacl"
    ],
    "implementations": {
      "standalone": "etalii.adp.ide.standalone src/diagrams/rdf"
    }
  }
}
