{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.databricks.job",
    "version": "0.2.0",
    "origin": "databricks/job",
    "label": "Databricks job",
    "icon": "mdi-transit-connection-horizontal",
    "fileExtension": ".yml",
    "license": "Apache-2.0",
    "homepage": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/databricks",
    "doc": {
      "summary": "A job's tasks and what each waits for - conditions, outcomes and the compute they run on.",
      "description": "The diagram of one Databricks job, read from the job's own resource YAML (`resources.jobs.<key>`) in a Databricks Asset Bundle. Each task is a node, each `depends_on` entry an edge from the task waited for to the waiting task, and each `job_clusters` entry a compute node in a band beneath the tasks. The YAML stays Databricks' own file: ADP never writes positions into it. The `x-databricks` block maps this specification's names to the wire ids the standalone tool uses today. See `databricks-job.md` beside this file for what DISL 0.3 cannot say.",
      "seeAlso": [
        { "title": "Databricks: configure task dependencies", "href": "https://docs.databricks.com/aws/en/jobs/run-if" },
        { "title": "Databricks: job resource in a bundle", "href": "https://docs.databricks.com/aws/en/dev-tools/bundles/resources#job" }
      ]
    },
    "requires": { "conformance": "standard" }
  },

  "functions": {
    "upstreamSettled": {
      "params": [ { "name": "t", "type": "Element" }, { "name": "state", "type": "map(string, string)" } ],
      "returns": "bool",
      "cel": "t.incomingOf('Dependency').all(d, d.source != null && d.source.id in state && state[d.source.id] in ['succeeded', 'failed', 'skipped'])",
      "doc": "Whether every task this one waits for has finished in the previous step. A dependency on a task the job does not declare never finishes, and neither does one on the task itself, so either holds the task back for the whole run."
    },
    "mayRun": {
      "params": [ { "name": "t", "type": "Element" }, { "name": "state", "type": "map(string, string)" } ],
      "returns": "bool",
      "cel": "cel.bind(ups, t.incomingOf('Dependency'), cel.bind(failures, ups.filter(d, state[d.source.id] != 'succeeded').size(), cel.bind(successes, ups.filter(d, state[d.source.id] == 'succeeded').size(), cel.bind(excluded, ups.exists(d, has(d.outcome) && d.outcome != '' && d.outcome != 'true'), cel.bind(runIf, has(t.runIf) && t.runIf != '' ? t.runIf : 'ALL_SUCCESS', runIf == 'ALL_DONE' ? true : (runIf == 'AT_LEAST_ONE_FAILED' ? failures > 0 : (runIf == 'AT_LEAST_ONE_SUCCESS' ? successes > 0 || ups.size() == 0 : failures == 0 && !excluded)))))))",
      "doc": "Whether a task whose upstream tasks have settled runs or is skipped. Every condition task answers true, so a dependency whose outcome is anything else excludes its branch. ALL_DONE always runs; AT_LEAST_ONE_FAILED runs when an upstream task did not succeed; AT_LEAST_ONE_SUCCESS runs when one succeeded or there is none; ALL_SUCCESS, an absent run_if and any other value run when every upstream task succeeded and no branch is excluded. Called only once `upstreamSettled` holds."
    }
  },

  "metamodel": {
    "diagram": {
      "doc": "The job itself: the one `resources.jobs.<key>` mapping the diagram reads. Its own scalars are kept but not drawn.",
      "attributes": {
        "jobKey": { "type": "string", "required": true, "readOnly": true, "doc": "The key under `resources.jobs`; chosen by the `.adp` registration's `resource:` header when a file declares several jobs." },
        "name": { "type": "string", "doc": "The job's `name`." },
        "schedule": { "type": "string", "doc": "`schedule.quartz_cron_expression`, when the job is scheduled." },
        "continuous": { "type": "bool", "default": false, "doc": "True when the job has a `continuous:` block." }
      }
    },
    "enums": {
      "TaskType": {
        "doc": "Which `*_task` mapping a task carries. The value is fixed by the file; it cannot be changed from the diagram. CEL uses the keys; the stored form is `value` where it differs.",
        "values": {
          "notebook": { "label": "Notebook", "doc": "`notebook_task`; source is `notebook_path`." },
          "python": { "label": "Python", "doc": "`spark_python_task`; source is `python_file`." },
          "wheel": { "label": "Python wheel", "doc": "`python_wheel_task`; source is `entry_point`." },
          "sql": { "label": "SQL", "doc": "`sql_task`; source is the query, dashboard, alert or file it names." },
          "dbt": { "label": "dbt", "doc": "`dbt_task`; source is `project_directory`." },
          "pipeline": { "label": "Pipeline", "doc": "`pipeline_task`; source is `pipeline_id`." },
          "run_job": { "value": "run-job", "label": "Run job", "doc": "`run_job_task`; source is `job_id`. Stored as `run-job`, the tool's wire value." },
          "condition": { "label": "Condition", "doc": "`condition_task`; source is its `op`. Downstream edges carry its true or false outcome." },
          "for_each": { "value": "for-each", "label": "For each", "doc": "`for_each_task`; source is `inputs`. Stored as `for-each`, the tool's wire value." },
          "jar": { "label": "JAR", "doc": "`spark_jar_task`; source is `main_class_name`." },
          "other": { "label": "Other", "doc": "Any task mapping the reader does not know." }
        }
      },
      "RunIf": {
        "extensible": true,
        "doc": "A task's `run_if`. An absent value means Databricks' default, ALL_SUCCESS. Extensible because the dialog and the row accept any text.",
        "values": {
          "ALL_SUCCESS": { "label": "All succeeded" },
          "AT_LEAST_ONE_SUCCESS": { "label": "At least one succeeded" },
          "NONE_FAILED": { "label": "None failed" },
          "ALL_DONE": { "label": "All done" },
          "AT_LEAST_ONE_FAILED": { "label": "At least one failed" },
          "ALL_FAILED": { "label": "All failed" }
        }
      },
      "Outcome": {
        "doc": "The `outcome` of a `depends_on` entry on a condition task.",
        "values": {
          "true": { "label": "true", "color": "#15803d" },
          "false": { "label": "false", "color": "#dc2626" }
        }
      },
      "SimulatedState": {
        "doc": "Where a task stands in a simulated run. Never stored.",
        "values": { "pending": {}, "running": {}, "succeeded": {}, "failed": {}, "skipped": {} }
      }
    },
    "types": {
      "Task": {
        "label": "Task",
        "doc": "One entry of the job's `tasks` list. An entry without `task_key` is not drawn; the reader reports it (`std.unreadableEntry`).",
        "labelAttribute": "key",
        "attributes": {
          "key": { "type": "string", "required": true, "key": true, "minLength": 1, "doc": "`task_key`. Renaming it rewrites every `depends_on` reference to it." },
          "taskType": { "type": "TaskType", "required": true, "readOnly": true },
          "taskSource": { "type": "string", "readOnly": true, "doc": "The principal source field of the task's type, in display form." },
          "clusterKey": { "type": "string", "doc": "`job_cluster_key`; absent means serverless." },
          "runIf": { "type": "RunIf", "doc": "`run_if`; absent means ALL_SUCCESS. Setting it to empty removes the key from the file." },
          "simulated": { "type": "SimulatedState", "transient": "viewer", "readOnly": true, "doc": "Set only by a simulated run; never written." }
        }
      },
      "JobCluster": {
        "label": "Job cluster",
        "doc": "One entry of the job's `job_clusters` list, drawn in a band beneath the tasks.",
        "labelAttribute": "key",
        "attributes": {
          "key": { "type": "string", "required": true, "key": true, "readOnly": true, "doc": "`job_cluster_key`." },
          "sparkVersion": { "type": "string", "readOnly": true, "doc": "`new_cluster.spark_version`." },
          "nodeType": { "type": "string", "readOnly": true, "doc": "`new_cluster.node_type_id`." },
          "workers": { "type": "int", "readOnly": true, "min": 0, "default": 0, "doc": "`new_cluster.num_workers`." }
        }
      }
    },
    "relations": {
      "Dependency": {
        "label": "Depends on",
        "doc": "One `depends_on` entry, stored on the target task: the target waits for the source. A self-dependency, a second entry naming the same task and a circle can all be written in the file; they are kept and the circle is reported, not prevented. An entry naming a key no task has is a relation without a source, reported by `std.references`.",
        "source": "Task",
        "target": "Task",
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "acyclic": false,
        "attributes": {
          "upstreamKey": { "type": "string", "required": true, "readOnly": true, "doc": "The `task_key` the entry names, as written; kept when no task has that key." },
          "outcome": { "type": "Outcome", "doc": "The condition outcome this dependency follows; only meaningful when the source is a condition task." }
        }
      }
    }
  },

  "notation": {
    "styles": {
      "box": {
        "fill": { "token": "color.surface" },
        "stroke": { "color": { "token": "color.border" }, "width": 1 },
        "cornerRadius": 4,
        "font": { "size": 13 }
      },
      "badges": { "font": { "size": 10, "color": "#5a6376" } },
      "simPending": { "opacity": 0.5 },
      "simRunning": { "stroke": { "color": "limegreen", "width": 2.5 } },
      "simSucceeded": { "stroke": { "color": "#15803d", "width": 2 } },
      "simFailed": { "stroke": { "color": "#dc2626", "width": 2.5 } },
      "simSkipped": { "opacity": 0.35, "stroke": { "dash": [3, 3] } }
    },
    "nodes": {
      "Task": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": "inline", "overflow": "ellipsis" },
          { "id": "badges", "text": { "cel": "(has(self.runIf) && self.runIf != '' ? self.runIf + ' · ' : '') + (has(self.clusterKey) && self.clusterKey != '' ? self.clusterKey : 'serverless')" },
            "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" }, "editable": false, "style": "badges" }
        ],
        "anchors": { "mode": "fixed", "points": [ { "id": "left", "x": 0, "y": 0.5 }, { "id": "right", "x": 1, "y": 0.5 } ] },
        "variants": [
          { "when": "self.taskType == 'condition'", "style": { "cornerRadius": 16 }, "doc": "Condition tasks read differently at a glance: their outcomes branch." }
        ],
        "conditions": [
          { "when": "has(self.simulated) && self.simulated == 'pending'", "style": "simPending" },
          { "when": "has(self.simulated) && self.simulated == 'running'", "style": "simRunning" },
          { "when": "has(self.simulated) && self.simulated == 'succeeded'", "style": "simSucceeded" },
          { "when": "has(self.simulated) && self.simulated == 'failed'", "style": "simFailed" },
          { "when": "has(self.simulated) && self.simulated == 'skipped'", "style": "simSkipped" }
        ]
      },
      "JobCluster": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" },
          { "id": "badges",
            "text": { "cel": "[has(self.sparkVersion) ? self.sparkVersion : '', has(self.nodeType) ? self.nodeType : '', self.workers > 0 ? string(self.workers) + ' workers' : ''].filter(b, b != '').join(' · ')" },
            "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" }, "style": "badges" }
        ],
        "connectable": false
      }
    },
    "edges": {
      "Dependency": {
        "line": { "stroke": { "color": { "token": "color.border" }, "width": 1.5 }, "routing": "bezier", "startDirection": "right", "endDirection": "left" },
        "anchoring": {
          "source": { "mode": "fixed", "points": [ { "id": "right", "x": 1, "y": 0.5 } ] },
          "target": { "mode": "fixed", "points": [ { "id": "left", "x": 0, "y": 0.5 } ] }
        },
        "targetMarker": "arrowFilled",
        "labels": [ { "id": "outcome", "text": { "cel": "has(self.outcome) ? self.outcome : ''" }, "at": "middle", "offset": -6, "editable": false } ],
        "conditions": [
          { "when": "has(self.outcome) && self.outcome == 'true'", "style": { "stroke": { "color": "#15803d" } }, "doc": "Outcome edges wear their answer." },
          { "when": "has(self.outcome) && self.outcome == 'false'", "style": { "stroke": { "color": "#dc2626" } } }
        ]
      }
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      { "id": "tasks", "label": "Tasks", "tools": [
        { "id": "notebookTask", "kind": "operation", "operation": "addNotebookTask", "mode": "drop", "label": "Notebook task", "icon": "mdi-notebook-outline",
          "doc": "Runs a notebook. Drop on the canvas where it should sit.",
          "drop": { "targets": [ { "on": ["canvas"], "kind": "operation", "operation": "addNotebookTask",
            "args": { "key": "freeTaskKey(diagram.nodesOfType('Task').map(t, t.key), 'notebook')" } } ] } },
        { "id": "pythonTask", "kind": "operation", "operation": "addPythonTask", "mode": "drop", "label": "Python task", "icon": "mdi-language-python",
          "doc": "Runs a Python file. Drop on the canvas where it should sit.",
          "drop": { "targets": [ { "on": ["canvas"], "kind": "operation", "operation": "addPythonTask",
            "args": { "key": "freeTaskKey(diagram.nodesOfType('Task').map(t, t.key), 'python')" } } ] } },
        { "id": "conditionTask", "kind": "operation", "operation": "addConditionTask", "mode": "drop", "label": "Condition task", "icon": "mdi-call-split",
          "doc": "Branches on a condition; downstream edges follow its true or false outcome.",
          "drop": { "targets": [ { "on": ["canvas"], "kind": "operation", "operation": "addConditionTask",
            "args": { "key": "freeTaskKey(diagram.nodesOfType('Task').map(t, t.key), 'condition')" } } ] } }
      ] }
    ],
    "contextMenus": [
      { "for": ["Task"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "renameTask", "group": "edit", "label": "Rename…", "icon": "mdi-pencil-outline", "shortcut": "F2" },
        { "kind": "operation", "operation": "setRunIf", "group": "edit", "label": "Set run if…", "icon": "mdi-filter-outline" },
        { "kind": "operation", "operation": "assignCluster", "group": "edit", "label": "Assign cluster…", "icon": "mdi-server" },
        { "kind": "operation", "operation": "removeDependency", "group": "edit",
          "forEach": "self.incomingOf('Dependency')", "as": "dep",
          "label": { "cel": "'Disconnect from \\'' + dep.upstreamKey + '\\''" },
          "icon": "mdi-vector-polyline-remove",
          "args": { "dependency": "dep", "from": "dep.upstreamKey" },
          "doc": "One entry per `depends_on` entry of the task, in the file's order, a dependency on a task the job does not declare included." },
        { "kind": "delete", "group": "edit", "label": "Remove", "icon": "mdi-delete-outline", "shortcut": "Delete" },
        { "kind": "operation", "operation": "simulateRun", "group": "simulate", "label": "Run job (simulated)", "icon": "mdi-play-outline" }
      ] },
      { "for": ["Dependency"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "delete", "label": "Remove dependency", "icon": "mdi-vector-polyline-remove", "shortcut": "Delete" }
      ] },
      { "for": ["diagram"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "addNotebookTask", "group": "add", "label": "Add notebook task here", "icon": "mdi-notebook-outline",
          "args": { "key": "freeTaskKey(diagram.nodesOfType('Task').map(t, t.key), 'notebook')" } },
        { "kind": "operation", "operation": "addPythonTask", "group": "add", "label": "Add Python task here", "icon": "mdi-language-python",
          "args": { "key": "freeTaskKey(diagram.nodesOfType('Task').map(t, t.key), 'python')" } },
        { "kind": "operation", "operation": "addConditionTask", "group": "add", "label": "Add condition task here", "icon": "mdi-call-split",
          "args": { "key": "freeTaskKey(diagram.nodesOfType('Task').map(t, t.key), 'condition')" } }
      ], "doc": "The menu of the empty canvas, where a drop would land." },
      { "for": ["connection"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "connectTasks", "label": "Depend on", "icon": "mdi-ray-start-arrow", "args": { "from": "source", "to": "target" } }
      ], "doc": "A finished connect gesture: the task it ends on comes to depend on the one it started from." }
    ]
  },

  "forms": {
    "task": {
      "for": "Task",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "key", "label": "Key", "widget": "readonly",
            "readOnlyReasons": [ "Rename through the context menu, so every depends_on reference follows the key." ] },
          { "attribute": "taskType", "label": "Type", "widget": "readonly",
            "display": { "cel": "self.taskType == 'run_job' ? 'run-job' : (self.taskType == 'for_each' ? 'for-each' : self.taskType)" },
            "readOnlyReasons": [ "The type is which *_task mapping the file carries; change it in the file." ] },
          { "attribute": "taskSource", "label": "Source", "widget": "readonly",
            "readOnlyReasons": [ "The type is which *_task mapping the file carries; change it in the file." ] }
        ] },
        { "kind": "section", "title": "Execution", "items": [
          { "attribute": "runIf", "label": "Run if", "widget": "text" },
          { "attribute": "clusterKey", "label": "Cluster", "widget": "text",
            "validate": [ { "timing": "commit", "rule": "value == '' || diagram.nodesOfType('JobCluster').exists(c, c.key == value)",
              "message": { "cel": "'There is no cluster named \\'' + value + '\\' in this job.'" } } ] }
        ] },
        { "kind": "section", "title": "Workspace", "items": [
          { "kind": "computed", "label": "Workspace connection", "value": "Not connected",
            "readOnlyReasons": [ "Not connected — a placeholder for the real workspace connection." ] },
          { "kind": "computed", "label": "Last simulated run", "value": "",
            "readOnlyReasons": [ "Simulated runs play on the canvas and never touch the file." ] }
        ] }
      ]
    },
    "renameTask": {
      "for": "Task",
      "label": "Rename task",
      "icon": "mdi-pencil-outline",
      "submitLabel": "Rename",
      "items": [
        { "attribute": "newKey", "label": "Key", "widget": "text", "initial": "self.key",
          "validate": [
            { "timing": "commit", "rule": "value.trim() != ''", "message": "A task needs a key." },
            { "timing": "commit", "rule": "!diagram.nodesOfType('Task').exists(t, t.key == value)", "message": { "cel": "'A task named \\'' + value + '\\' is already there.'" } }
          ] }
      ]
    },
    "setRunIf": {
      "for": "Task",
      "label": "Set run if",
      "icon": "mdi-filter-outline",
      "submitLabel": "Set",
      "items": [
        { "attribute": "runIf", "label": "Run if (empty = ALL_SUCCESS)", "widget": "text", "initial": "has(self.runIf) ? self.runIf : ''" }
      ]
    },
    "assignCluster": {
      "for": "Task",
      "label": "Assign cluster",
      "icon": "mdi-server",
      "submitLabel": "Assign",
      "items": [
        { "attribute": "clusterKey", "label": "Cluster key (empty = serverless)", "widget": "text", "initial": "has(self.clusterKey) ? self.clusterKey : ''" }
      ]
    },
    "addTask": {
      "label": "Add task",
      "icon": "mdi-plus",
      "submitLabel": "Add",
      "items": [
        { "attribute": "key", "label": "Task key", "widget": "text", "initial": "''",
          "validate": [ { "timing": "commit", "rule": "value.trim() != ''", "message": "A task needs a key." } ] }
      ]
    }
  },

  "constraints": {
    "doc": "Every finding is located at a line of the job's YAML: a rule on an element reports the element's `location()`, which the reader records, so a task's findings stand on its `task_key` entry and a missing upstream on its `depends_on` entry.",
    "builtIn": {
      "std.unreadableEntry": {
        "code": "databricks.task-key-missing",
        "severity": "error",
        "message": "A task has no task_key. Give it one, or nothing can depend on it.",
        "doc": "A task written without task_key is not drawn at all, so the reader reports it at its line."
      },
      "std.references": {
        "code": "databricks.missing-task",
        "severity": "error",
        "message": { "cel": "'\\'' + self.target.key + '\\' depends on \\'' + self.upstreamKey + '\\', which is not a task in this job. Fix the key or remove the dependency.'" },
        "doc": "A `depends_on` entry naming a key no task of this job has: the relation is kept without a source and reported at the entry's line."
      },
      "std.duplicateId": {
        "enabled": false,
        "doc": "A second task of one key is the rule `duplicateTaskKey`'s to report."
      },
      "std.unparseable": {
        "code": "databricks.unparseable",
        "severity": "error",
        "message": { "cel": "'This is not configuration that can be read: ' + detail.reason" }
      }
    },
    "rules": [
      { "id": "danglingCluster", "code": "databricks.dangling-cluster", "scope": "Task", "severity": "error",
        "when": "has(self.clusterKey) && self.clusterKey != ''",
        "rule": "diagram.nodesOfType('JobCluster').exists(c, c.key == self.clusterKey)",
        "message": { "cel": "'\\'' + self.key + '\\' runs on cluster \\'' + self.clusterKey + '\\', which this job does not declare. Declare it under job_clusters, or clear the binding for serverless.'" } },
      { "id": "duplicateTaskKey", "code": "databricks.duplicate-task-key", "scope": "Task", "severity": "error",
        "rule": "self.positionIn(diagram.nodesOfType('Task').filter(t, t.key == self.key)) == 0",
        "message": { "cel": "'The task key \\'' + self.key + '\\' is used more than once. Every task needs its own.'" },
        "doc": "Reported on the second and later tasks with the key, not the first, each at its own line." },
      { "id": "cycle", "code": "databricks.cycle", "scope": "Task", "severity": "error",
        "when": "self.positionIn(diagram.nodesOfType('Task').filter(t, t.key == self.key)) == 0",
        "rule": "!(self.inCycle('Dependency') || diagram.nodesOfType('Task').exists(t, t.inCycle('Dependency') && self in t.reachable('Dependency')))",
        "message": { "cel": "'\\'' + self.key + '\\' is part of a dependency circle, so it can never run. Break the circle.'" },
        "doc": "A task on a circle, and a task downstream of one, can never run: both are reported, the first holder of a key only. A dependency on a task the job does not declare holds nothing back here." }
    ]
  },

  "behavior": {
    "operations": {
      "renameTask": {
        "label": "Rename…",
        "icon": "mdi-pencil-outline",
        "for": ["Task"],
        "params": { "newKey": { "type": "string", "required": true, "label": "Key" } },
        "paramsForm": "renameTask",
        "actions": [
          { "abort": { "message": "'A task needs a key.'" }, "when": "p.newKey.trim() == ''" },
          { "abort": { "message": "'A task named \\'' + p.newKey + '\\' is already there.'" }, "when": "diagram.nodesOfType('Task').exists(t, t.key == p.newKey)" },
          { "set": { "key": "p.newKey" } }
        ],
        "doc": "Renames the task inline on its label; the file's own task_key and every depends_on reference to it are rewritten in the same undoable step."
      },
      "setRunIf": {
        "label": "Set run if…",
        "icon": "mdi-filter-outline",
        "for": ["Task"],
        "params": { "runIf": { "type": "string", "label": "Run if (empty = ALL_SUCCESS)" } },
        "paramsForm": "setRunIf",
        "actions": [
          { "unset": ["runIf"], "when": "!has(p.runIf) || p.runIf == ''" },
          { "set": { "runIf": "p.runIf" }, "when": "has(p.runIf) && p.runIf != ''" }
        ]
      },
      "assignCluster": {
        "label": "Assign cluster…",
        "icon": "mdi-server",
        "for": ["Task"],
        "params": { "clusterKey": { "type": "string", "label": "Cluster key (empty = serverless)" } },
        "paramsForm": "assignCluster",
        "actions": [
          { "abort": { "message": "'There is no cluster named \\'' + p.clusterKey + '\\' in this job.'" },
            "when": "has(p.clusterKey) && p.clusterKey != '' && !diagram.nodesOfType('JobCluster').exists(c, c.key == p.clusterKey)" },
          { "unset": ["clusterKey"], "when": "!has(p.clusterKey) || p.clusterKey == ''" },
          { "set": { "clusterKey": "p.clusterKey" }, "when": "has(p.clusterKey) && p.clusterKey != ''" }
        ]
      },
      "removeDependency": {
        "label": "Disconnect",
        "icon": "mdi-vector-polyline-remove",
        "for": ["Task"],
        "params": {
          "dependency": { "type": "Dependency", "required": true },
          "from": { "type": "string", "required": true, "doc": "The upstream key as written, which names the entry." }
        },
        "actions": [
          { "abort": { "message": "'There is no dependency from \\'' + p.from + '\\' to \\'' + self.key + '\\' any more.'" },
            "when": "!self.incomingOf('Dependency').exists(d, d.upstreamKey == p.from)" },
          { "delete": "p.dependency" }
        ],
        "doc": "Invoked from a generated menu entry whose `args` supply the dependency and its upstream key, so no dialog opens."
      },
      "connectTasks": {
        "label": "Depend on",
        "icon": "mdi-ray-start-arrow",
        "for": "diagram",
        "params": {
          "from": { "type": "Element", "doc": "Where the gesture started: the task to depend on." },
          "to": { "type": "Element", "doc": "Where the gesture ended: the task that comes to depend." }
        },
        "actions": [
          { "abort": { "message": "'Drop the dependency on a task; a dependency needs both of its ends.'" },
            "when": "!has(p.from) || !has(p.to) || p.from == null || p.to == null || !p.from.isA('Task') || !p.to.isA('Task')" },
          { "abort": { "message": "'A task cannot depend on itself.'" }, "when": "p.from == p.to" },
          { "abort": { "message": "'\\'' + p.to.key + '\\' already depends on \\'' + p.from.key + '\\'.'" },
            "when": "p.to.incomingOf('Dependency').exists(d, d.upstreamKey == p.from.key)" },
          { "connect": { "type": "'Dependency'", "source": "p.from", "target": "p.to", "attributes": { "upstreamKey": "p.from.key" } } }
        ],
        "doc": "Appends a depends_on entry naming the gesture's start to the task it ended on. A gesture whose end names a task that is gone is refused by the host with 'One of those tasks is not there any more.'"
      },
      "addNotebookTask": {
        "label": "Add notebook task here",
        "icon": "mdi-notebook-outline",
        "for": "diagram",
        "params": { "key": { "type": "string", "required": true, "label": "Task key" } },
        "paramsForm": "addTask",
        "actions": [
          { "abort": { "message": "'A task needs a key.'" }, "when": "p.key.trim() == ''" },
          { "abort": { "message": "'A task named \\'' + p.key + '\\' is already there.'" }, "when": "diagram.nodesOfType('Task').exists(t, t.key == p.key)" },
          { "create": { "type": "'Task'", "at": "position", "attributes": { "key": "p.key", "taskType": "'notebook'", "taskSource": "'notebooks/' + p.key" } } }
        ],
        "doc": "From a drop or the canvas menu the key is the first free `notebook_<n>` (`freeTaskKey`) and no dialog opens; from a click on the toolbox entry the dialog asks for it."
      },
      "addPythonTask": {
        "label": "Add Python task here",
        "icon": "mdi-language-python",
        "for": "diagram",
        "params": { "key": { "type": "string", "required": true, "label": "Task key" } },
        "paramsForm": "addTask",
        "actions": [
          { "abort": { "message": "'A task needs a key.'" }, "when": "p.key.trim() == ''" },
          { "abort": { "message": "'A task named \\'' + p.key + '\\' is already there.'" }, "when": "diagram.nodesOfType('Task').exists(t, t.key == p.key)" },
          { "create": { "type": "'Task'", "at": "position", "attributes": { "key": "p.key", "taskType": "'python'", "taskSource": "'scripts/' + p.key + '.py'" } } }
        ],
        "doc": "From a drop or the canvas menu the key is the first free `python_<n>` (`freeTaskKey`) and no dialog opens; from a click on the toolbox entry the dialog asks for it."
      },
      "addConditionTask": {
        "label": "Add condition task here",
        "icon": "mdi-call-split",
        "for": "diagram",
        "params": { "key": { "type": "string", "required": true, "label": "Task key" } },
        "paramsForm": "addTask",
        "actions": [
          { "abort": { "message": "'A task needs a key.'" }, "when": "p.key.trim() == ''" },
          { "abort": { "message": "'A task named \\'' + p.key + '\\' is already there.'" }, "when": "diagram.nodesOfType('Task').exists(t, t.key == p.key)" },
          { "create": { "type": "'Task'", "at": "position", "attributes": { "key": "p.key", "taskType": "'condition'", "taskSource": "'EQUAL_TO'" } } }
        ],
        "doc": "From a drop or the canvas menu the key is the first free `condition_<n>` (`freeTaskKey`) and no dialog opens; from a click on the toolbox entry the dialog asks for it."
      },
      "simulateRun": {
        "label": "Run job (simulated)",
        "icon": "mdi-play-outline",
        "for": ["Task"],
        "simulate": {
          "for": ["Task"],
          "state": "simulated",
          "initial": "'pending'",
          "next": "state[self.id] == 'running' ? 'succeeded' : (state[self.id] == 'pending' && upstreamSettled(self, state) ? (mayRun(self, state) ? 'running' : 'skipped') : state[self.id])",
          "until": "diagram.nodesOfType('Task').all(t, state[t.id] != 'running' && !(state[t.id] == 'pending' && upstreamSettled(t, state)))",
          "stepMs": 700,
          "notice": { "running": "Simulated: job run", "finished": "Simulated: job run — finished" },
          "doc": "A mock run in waves, one step every 700 ms: each wave finishes what was running, every task succeeding, then starts or skips every task whose upstream tasks have all finished. The run ends when a wave would change nothing, so a task held back by a missing upstream stays pending. Nothing is written, nothing enters the undo history."
        }
      }
    },
    "deletion": {
      "Task": {
        "relations": "delete",
        "confirm": {
          "count": "self.incomingOf('Dependency').size() + self.outgoingOf('Dependency').size()",
          "threshold": 1,
          "title": "Remove task",
          "message": { "cel": "'Removing this task also removes the ' + (count == 1 ? '1 dependency' : string(count) + ' dependencies') + ' touching it.'" },
          "confirmLabel": "Remove",
          "danger": true,
          "doc": "Asked only when a dependency touches the task: its own depends_on entries and every entry naming it. The confirmation's icon is mdi-delete-outline, the menu entry's."
        }
      }
    }
  },

  "layout": {
    "algorithms": {
      "jobColumns": {
        "algorithm": "plugin:net.etalii.adp.databricks.layout",
        "direction": "right",
        "options": { "reading": "job", "columnWidth": 260, "rowHeight": 120, "clusterBandGap": 80 },
        "doc": "Longest-path layering left to right, cycle-tolerant, with job clusters in a band beneath the deepest task row."
      },
      "layered": {
        "algorithm": "layered",
        "direction": "right",
        "doc": "The declarative approximation of jobColumns, for a runtime without the plugin."
      }
    },
    "default": "jobColumns",
    "trigger": "always",
    "respect": "all"
  },

  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/databricks/backend/EtAlii.Adp.Diagram.Databricks/databricks.fbl#configuration",
    "ids": {
      "strategy": "natural",
      "prefix": { "Task": "task:", "JobCluster": "cluster:" },
      "pattern": "^[^\\r\\n]{1,512}$",
      "types": {
        "Dependency": { "strategy": "derived", "expression": "'edge:' + self.upstreamKey + '->' + self.target.key", "doc": "From the key as written, so a dependency on a missing task keeps its id." }
      },
      "doc": "`task:<task_key>`, `cluster:<job_cluster_key>` and `edge:<from>-><to>`: renaming a task changes its id, which is intended."
    },
    "view": { "store": ["bounds"], "styleOverrides": "none" },
    "typeMap": {
      "Job": { "as": "diagram", "doc": "A job resource is the job reading's diagram: its key, name, schedule and whether it runs continuously." },
      "Task": { "as": "Task" },
      "JobCluster": { "as": "JobCluster" },
      "Dependency": { "as": "Dependency", "attributes": { "from": "source", "to": "target" }, "doc": "A depends_on entry, read as an element so that one naming a task the job does not declare is kept with its upstream end unset (11.2), and reported by the missing-task rule." },
      "KeylessTask": { "as": "unreadable", "doc": "A task without a task_key: reported, and not drawn." }
    }
  },

  "plugins": {
    "net.etalii.adp.databricks.taskKeys": {
      "version": "^0.1.0",
      "provides": ["celFunctions"],
      "required": true,
      "doc": "The fresh key of a new task, which CEL cannot search for (see databricks-job.md).",
      "celFunctions": [
        {
          "name": "freeTaskKey",
          "params": [ { "name": "keys", "type": "list(string)" }, { "name": "type", "type": "string" } ],
          "returns": "string",
          "cost": 10,
          "deterministic": true,
          "doc": "The first `<type>_<n>`, counting `n` from 1, that is not in `keys`: `freeTaskKey(['notebook_2'], 'notebook')` is `notebook_1`."
        }
      ]
    },
    "net.etalii.adp.databricks.layout": {
      "version": "^0.1.0",
      "provides": ["layout"],
      "required": false,
      "fallback": { "layout": "layered" },
      "args": {
        "reading": { "type": "string", "required": true },
        "columnWidth": { "type": "number" },
        "rowHeight": { "type": "number" },
        "clusterBandGap": { "type": "number" }
      },
      "doc": "The family's computed layouts."
    }
  },

  "x-databricks": {
    "doc": "Today's wire ids, which the standalone backend and client share, mapped from this specification's names, as x-ghg does for the hype cycle. A tool is keyed by its id. An action is keyed by its entry's operation, else its kind; a key \"<Type>/<kind>\" overrides that for the entries offered on <Type>, and `<from>` is replaced by the entry's `from` argument. A property is keyed by its form item's row id: its id, else its attribute, else a computed item's label.",
    "tools": {
      "notebookTask": { "id": "databricks.toolbox.notebook-task", "drop": "databricks.add-task:notebook" },
      "pythonTask": { "id": "databricks.toolbox.python-task", "drop": "databricks.add-task:python" },
      "conditionTask": { "id": "databricks.toolbox.condition-task", "drop": "databricks.add-task:condition" }
    },
    "actions": {
      "renameTask": "databricks.rename-task",
      "setRunIf": "databricks.set-run-if",
      "assignCluster": "databricks.assign-cluster",
      "removeDependency": "databricks.disconnect:<from>",
      "Task/delete": "databricks.remove-task",
      "Dependency/delete": "databricks.remove-edge",
      "simulateRun": "databricks.simulated.run-job",
      "addNotebookTask": "databricks.add-task:notebook",
      "addPythonTask": "databricks.add-task:python",
      "addConditionTask": "databricks.add-task:condition",
      "connectTasks": "databricks.connect"
    },
    "properties": {
      "key": "databricks.task-key",
      "taskType": "databricks.task-type",
      "taskSource": "databricks.task-source",
      "runIf": "databricks.run-if",
      "clusterKey": "databricks.cluster",
      "Workspace connection": "databricks.workspace",
      "Last simulated run": "databricks.last-simulated-run"
    }
  }
}
