{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.4",
  "doc": "The activity file of the Agent activity diagram (agent-activity-diagram.dis, agent-activity-diagram.md): ADP's own YAML, written by agents and by ADP. Five lists of elements; tasks are entries of a specification and pull requests entries of a location. A relation is a key on the element at its 'one' end, bound as a reference by id, from which the specification derives the drawn line. The user's part is the top-level mapping view, holding showArchived, placements and groups; FBL 0.4 creates view with the first of them and removes it with the last (research R3 of etalii.adp spec 014). Each list rule's when refuses an item that is not a mapping, which that list's not-a-mapping rule then takes, and its computed unknownKeys lists the keys the diagram does not read, which it reports while FBL keeps them.",
  "bindings": {
    "aad": {
      "title": "Agent activity diagram",
      "claims": {
        "extensions": [".aad"],
        "origins": ["etalii/agent-activity-diagram"]
      },
      "body": { "kind": "file", "family": "yaml" },
      "reader": "declared",
      "text": { "newline": "crlf", "indent": 2, "sequenceIndent": "indented", "finalNewline": true, "quote": "double" },
      "header": { "key": "agent-activity-diagram", "value": 1 },
      "elements": [
        {
          "name": "diagram",
          "type": "Diagram",
          "doc": "The root mapping: the file's version, and the archived switch under view. Setting showArchived in a file without view creates view at the end of the file with the switch as its only key; in a view without the switch, the switch becomes its first key (FBL 0.4, section 5.2).",
          "at": "/",
          "attributes": {
            "version": { "key": "agent-activity-diagram", "readOnly": "The file's version is written when the file is created and changed by nobody but a migration." },
            "showArchived": { "key": "showArchived", "child": "view", "default": false, "create": { "at": "end" } },
            "unknownKeys": { "value": "entry.filter(k, !(k in ['agent-activity-diagram', 'projects', 'specifications', 'agents', 'locations', 'environments', 'view'])) + (has(entry.view) && type(entry.view) == map ? entry.view.filter(k, !(k in ['showArchived', 'placements', 'groups'])).map(k, 'view.' + k) : [])" }
          }
        },
        {
          "name": "project",
          "type": "Project",
          "at": "/projects/*",
          "when": "entry.all(k, true)",
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'name', 'link']))" },
            "name": { "key": "name", "empty": "refuse" },
            "link": { "key": "link", "empty": "remove" }
          },
          "insert": {
            "place": "after-last",
            "container": "/projects",
            "create": { "at": "end-of-document" },
            "keys": ["id", "name", "link"]
          },
          "remove": { "cascade": ["placement"], "container": "remove-when-empty" }
        },
        {
          "name": "specification",
          "type": "Specification",
          "at": "/specifications/*",
          "when": "entry.all(k, true)",
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'project', 'name', 'link', 'status', 'tasks']))" },
            "project": { "key": "project", "empty": "remove", "reference": { "to": ["project"], "by": "id" } },
            "name": { "key": "name", "empty": "refuse" },
            "link": { "key": "link", "empty": "remove" },
            "status": { "key": "status", "empty": "refuse" }
          },
          "insert": {
            "place": "after-last",
            "container": "/specifications",
            "create": { "at": "end-of-document" },
            "keys": ["id", "project", "name", "link", "status"]
          },
          "remove": { "cascade": ["placement", "group"], "container": "remove-when-empty" }
        },
        {
          "name": "task",
          "type": "Task",
          "at": "/specifications/*/tasks/*",
          "when": "entry.all(k, true)",
          "parent": { "rules": ["specification"], "slot": "tasks" },
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'title', 'status', 'updated', 'link']))" },
            "title": { "key": "title", "empty": "refuse" },
            "status": { "key": "status", "empty": "refuse" },
            "updated": { "key": "updated", "empty": "remove" },
            "link": { "key": "link", "empty": "remove" }
          },
          "insert": {
            "place": "after-last",
            "container": "tasks",
            "create": { "at": { "after": "status" } },
            "keys": ["id", "title", "status", "updated", "link"]
          },
          "remove": { "container": "remove-when-empty" }
        },
        {
          "name": "agent",
          "type": "Agent",
          "at": "/agents/*",
          "when": "entry.all(k, true)",
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'name', 'specification', 'link']))" },
            "name": { "key": "name", "empty": "refuse" },
            "specification": { "key": "specification", "empty": "remove", "reference": { "to": ["specification"], "by": "id" } },
            "link": { "key": "link", "empty": "remove" }
          },
          "insert": {
            "place": "after-last",
            "container": "/agents",
            "create": { "at": "end-of-document" },
            "keys": ["id", "name", "specification", "link"]
          },
          "remove": { "cascade": ["placement"], "container": "remove-when-empty" }
        },
        {
          "name": "location",
          "type": "Location",
          "at": "/locations/*",
          "when": "entry.all(k, true)",
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'agent', 'environment', 'folder', 'folderLink', 'branchLink', 'branch', 'pullRequests']))" },
            "agent": { "key": "agent", "empty": "remove", "reference": { "to": ["agent"], "by": "id" } },
            "environment": { "key": "environment", "empty": "remove", "reference": { "to": ["environment"], "by": "id" } },
            "folder": { "key": "folder", "empty": "remove", "default": "Default" },
            "folderLink": { "key": "folderLink", "empty": "remove" },
            "branchLink": { "key": "branchLink", "empty": "remove" },
            "branch": { "key": "branch", "empty": "refuse" }
          },
          "insert": {
            "place": "after-last",
            "container": "/locations",
            "create": { "at": "end-of-document" },
            "keys": ["id", "agent", "environment", "folder", "folderLink", "branchLink", "branch"]
          },
          "remove": { "cascade": ["placement", "group"], "container": "remove-when-empty" }
        },
        {
          "name": "pullRequest",
          "type": "PullRequest",
          "at": "/locations/*/pullRequests/*",
          "when": "entry.all(k, true)",
          "parent": { "rules": ["location"], "slot": "pullRequests" },
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'title', 'updated', 'link']))" },
            "title": { "key": "title", "empty": "refuse" },
            "updated": { "key": "updated", "empty": "remove" },
            "link": { "key": "link", "empty": "remove" }
          },
          "insert": {
            "place": "after-last",
            "container": "pullRequests",
            "create": { "at": { "after": "branch" } },
            "keys": ["id", "title", "updated", "link"]
          },
          "remove": { "container": "remove-when-empty" }
        },
        {
          "name": "environment",
          "type": "Environment",
          "at": "/environments/*",
          "when": "entry.all(k, true)",
          "id": { "from": { "key": "id" } },
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['id', 'name', 'kind', 'link']))" },
            "name": { "key": "name", "empty": "refuse" },
            "environmentKind": { "key": "kind", "empty": "refuse" },
            "link": { "key": "link", "empty": "remove" }
          },
          "insert": {
            "place": "after-last",
            "container": "/environments",
            "create": { "at": "end-of-document" },
            "keys": ["id", "name", "kind", "link"]
          },
          "remove": { "cascade": ["placement"], "container": "remove-when-empty" }
        },
        {
          "name": "placement",
          "type": "Placement",
          "doc": "A locked position: the element it names and where it is. It has no id of its own; the specification binds it as view data of the element it names (DISL 0.4, persistence.view.bind), which identifies it.",
          "at": "/view/placements/*",
          "when": "entry.all(k, true)",
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['element', 'x', 'y']))" },
            "element": { "key": "element", "empty": "refuse", "reference": { "to": ["project", "specification", "agent", "location", "environment"], "by": "id" } },
            "x": { "key": "x", "number": { "decimals": 2 } },
            "y": { "key": "y", "number": { "decimals": 2 } }
          },
          "insert": {
            "place": "after-last",
            "container": "/view/placements",
            "create": { "at": "end" },
            "keys": ["element", "x", "y"]
          },
          "remove": { "container": "remove-empty-levels" }
        },
        {
          "name": "group",
          "type": "GroupState",
          "doc": "The state of one group of one element, stored only while it differs from the group's default (DISL 0.4, section 6.9). It has no id of its own; the element and the group identify it.",
          "at": "/view/groups/*",
          "when": "entry.all(k, true)",
          "attributes": {
            "unknownKeys": { "value": "entry.filter(k, !(k in ['element', 'group', 'collapsed']))" },
            "element": { "key": "element", "empty": "refuse", "reference": { "to": ["specification", "location"], "by": "id" } },
            "group": { "key": "group", "empty": "refuse" },
            "collapsed": { "key": "collapsed" }
          },
          "insert": {
            "place": "after-last",
            "container": "/view/groups",
            "create": { "at": "end" },
            "keys": ["element", "group", "collapsed"]
          },
          "remove": { "container": "remove-empty-levels" }
        },
        { "name": "project-not-a-mapping", "type": "Unreadable", "at": "/projects/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "specification-not-a-mapping", "type": "Unreadable", "at": "/specifications/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "task-not-a-mapping", "type": "Unreadable", "at": "/specifications/*/tasks/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "agent-not-a-mapping", "type": "Unreadable", "at": "/agents/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "location-not-a-mapping", "type": "Unreadable", "at": "/locations/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "pullRequest-not-a-mapping", "type": "Unreadable", "at": "/locations/*/pullRequests/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "environment-not-a-mapping", "type": "Unreadable", "at": "/environments/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "placement-not-a-mapping", "type": "Unreadable", "at": "/view/placements/*", "readOnly": "This entry is not a mapping, so it is kept as it is." },
        { "name": "group-not-a-mapping", "type": "Unreadable", "at": "/view/groups/*", "readOnly": "This entry is not a mapping, so it is kept as it is." }
      ],
      "template": { "text": "agent-activity-diagram: 1\r\n" }
    }
  }
}
