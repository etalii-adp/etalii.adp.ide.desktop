atd 0.1

/// What an asset bundle deploys: its resources, its variables, and the targets each lands on.
///
/// The diagram of one Databricks Asset Bundle, read from its `databricks.yml`. The bundle is one node on top, the jobs
/// and pipelines it declares a row of nodes beneath it, and each deployment target a dashed frame at the bottom, with a
/// dashed arrow to every resource the target overrides. Configuration the tool does not model is drawn as a generic
/// node and never rewritten. The YAML stays Databricks' own file: ADP never writes positions into it. The
/// `x-databricks` block maps this specification's names to the wire ids the standalone tool uses today. See
/// `databricks-bundle.md` beside this file for what DISL 0.3 cannot say.
diagram databricks/bundle version "0.2.0" {
  label "Databricks bundle"
  id: "net.etalii.adp.databricks.bundle"
  icon: "mdi-package-variant-closed"
  fileExtension: ".yml"
  license: "Apache-2.0"
  homepage: "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/databricks"
  requires: { conformance: standard }
  doc {
    seeAlso: [{
      title: "Databricks: bundle configuration"
      href: "https://docs.databricks.com/aws/en/dev-tools/bundles/settings"
    }
    , {
      title: "Databricks: deployment modes"
      href: "https://docs.databricks.com/aws/en/dev-tools/bundles/deployment-modes"
    }
    ]
  }

  import "databricks-bundle.notation.atd"
  import "databricks-bundle.bundle.atd"
  requires capability layout.bands@^1

  model {
    /// The bundle file. Its includes and variables are read and kept for constraints, but not drawn.
    document {
      /// The `include:` globs. While any is present, overrides of resources this file does not declare are not
      /// reported, because an included file may declare them.
      attribute includes: string many readonly
      /// The `variables:` declarations.
      attribute variables: Variable many readonly
    }

    datatype Variable {
      label: "Variable"
      fields: { name: { type: "string", required: true }, default: { type: "string" }, description: { type: "string" } }
      display: (self.name)
    }

    /// The resource kinds the tool models. Every other kind under `resources:` becomes an unknown node.
    enum ResourceKind {
      jobs { label: "Job", icon: "mdi-transit-connection-horizontal" }
      pipelines { label: "Pipeline", icon: "mdi-pipe" }
    }

    /// A target's `mode`; absent is allowed.
    enum TargetMode {
      development { label: "development" }
      production { label: "production" }
      extensible: true
    }

    /// Where an element stands in a simulated deploy. Never stored.
    enum SimulatedState {
      pending
      running
      succeeded
    }

    /// The `bundle:` section. There is exactly one, drawn whether or not the file has a `bundle:` key (see
    /// databricks-bundle.md).
    element Bundle {
      label "Bundle"
      /// `bundle.name`; absent when the file has no `bundle:` section or the section no name.
      attribute name: string
      multiplicity: { min: 1, max: 1 }
      labelAttribute: "name"
    }

    /// The bundle of a file with no `bundle:` section, or none that can be read: one is drawn whatever the file holds
    /// (databricks-bundle.md, gap 8), under the id of the bundle it stands for.
    element AbsentBundle {
      label "Bundle"
      derived: {
        from: (diagram.nodesOfType('Bundle').size() == 0 ? ['bundle'] : [])
        id: ('bundle')
        reason: "This file has no bundle section to change."
      }
    }

    /// One entry under `resources.jobs` or `resources.pipelines`.
    element Resource {
      label "Resource"
      attribute resourceKind: ResourceKind required readonly
      /// The resource's key under its kind.
      attribute key: string required readonly { minLength: 1 }
      attribute simulated: SimulatedState readonly { transient: viewer }
      labelAttribute: "key"
    }

    /// A root key other than bundle, include, variables, resources and targets (for example workspace, sync,
    /// permissions), or a resource kind other than jobs and pipelines (for example experiments, models, schemas). Drawn
    /// generically, never written.
    element Unknown {
      label "Unmodelled configuration"
      /// The key's path: `workspace`, or `resources.experiments`.
      attribute path: string required readonly
      /// The key itself.
      attribute key: string required readonly
      attribute simulated: SimulatedState readonly { transient: viewer }
      labelAttribute: "key"
    }

    /// One entry under `targets:`, drawn as a frame.
    element Target {
      label "Target"
      attribute name: string required readonly { key: true }
      /// `mode`.
      attribute mode: TargetMode readonly
      /// `default: true`.
      attribute isDefault: bool readonly default false
      labelAttribute: "name"
    }

    /// One entry of a target's own `resources:` section: the target sets some of the resource's fields for deployments
    /// to it. Read from the file, never drawn by the user. An entry naming a resource this bundle does not declare has
    /// no target end; it is not drawn, and the rule `overrideOfUndeclared` reports it.
    relation Override from Target to Resource {
      label "Overrides"
      /// The resource kind the entry is written under, as written.
      attribute writtenKind: string required readonly
      /// The resource key the entry names, as written.
      attribute writtenKey: string required readonly
      directed: true
      allowSelfLoops: false
      allowParallel: false
      target: { optional: true }
    }
  }

  // ---------------------------------------------------------------- Functions

  /// The element's place in a ripple: the members ordered by position on the canvas, left to right, then top to bottom,
  /// then in reading order.
  fn rippleRank(e: Element, members: list<Element>) -> int {
    return cel.bind(x, e.view.bounds.center()[0], cel.bind(y, e.view.bounds.center()[1], members.filter(o, o.view.bounds.center()[0] < x || (o.view.bounds.center()[0] == x && (o.view.bounds.center()[1] < y || (o.view.bounds.center()[1] == y && o.positionIn(members) < e.positionIn(members))))).size()))
  }

  /// What a simulated deploy ripples over: every resource and every piece of unmodelled configuration.
  fn deployMembers() -> list<Element> {
    // uses: ["diagram"]
    return diagram.nodesOfType('Resource') + diagram.nodesOfType('Unknown')
  }

  // ---------------------------------------------------------------- Constraints

  /// Every finding is located at a line of the bundle's YAML: a rule on an element reports the element's `location()`,
  /// which the reader records.
  constraints {
    builtin std.references {
      enabled: false
      doc "An override of a resource this bundle does not declare is the rule `overrideOfUndeclared`'s to report."
    }
    builtin std.unparseable {
      code: "databricks.unparseable"
      severity: "error"
      message: ('This is not configuration that can be read: ' + detail.reason)
    }

    /// A relation is drawn between its ends, so moving one is refused in the tool's words.
    constraint relationStays for Override {
      rule false
      message "That element is not something this diagram can move."
      kind: placement
      enforcement: prevent
    }

    /// Reported at the first target's line, and only when the bundle has targets.
    constraint noDefaultTarget for diagram {
      when diagram.nodesOfType('Target').size() > 0
      rule diagram.nodesOfType('Target').exists(t, t.isDefault)
      severity warning
      message "No target says default: true, so every deploy must name one. Mark one target as the default."
      code: "databricks.no-default-target"
      location: (diagram.nodesOfType('Target')[0].location().orValue(null))
    }

    /// Reported on the second and later default targets, not the first, each at its own line.
    constraint multipleDefaultTargets for Target {
      when self.isDefault
      rule self.positionIn(diagram.nodesOfType('Target').filter(t, t.isDefault)) == 0
      severity error
      message ('\'' + self.name + '\' is a second default target; only one target may be the default.')
      code: "databricks.multiple-default-targets"
      location: (self.location().orValue(null))
      target: ([])
    }

    /// Reported at the override entry's line. Quiet while the bundle has `include:` globs, because an included file may
    /// declare the resource.
    constraint overrideOfUndeclared for Override {
      when diagram.includes.size() == 0
      rule self.target != null
      severity warning
      message ('Target \'' + self.source.name + '\' overrides ' + self.writtenKind + ' \'' + self.writtenKey + '\', which this bundle does not declare. Declare the resource or drop the override.')
      code: "databricks.override-of-undeclared"
      location: (self.location().orValue(null))
      target: ([])
    }
  }

  // ---------------------------------------------------------------- Operations

  /// Renames the bundle inline on its label.
  operation renameBundle "Rename…" for Bundle {
    param name: string required { label: "Name" }
    icon: "mdi-pencil-outline"
    paramsForm: "renameBundle"
    if p.name == '' {
      fail 'A bundle needs a name.'
    }
    set name = p.name
  }

  /// Writes a job resource skeleton, complete with a starter task.
  operation addJobResource "Add job resource…" for diagram {
    param key: string required { label: "Key" }
    icon: "mdi-transit-connection-horizontal"
    paramsForm: "addResource"
    if p.key.trim() == '' {
      fail 'A resource needs a key.'
    }
    if diagram.nodesOfType('Resource').exists(r, r.resourceKind == 'jobs' && r.key == p.key.trim()) {
      fail 'A jobs resource named \'' + p.key.trim() + '\' is already there.'
    }
    create Resource { resourceKind: 'jobs', key: p.key.trim() }
  }

  /// Writes a pipeline resource skeleton, complete with a starter library.
  operation addPipelineResource "Add pipeline resource…" for diagram {
    param key: string required { label: "Key" }
    icon: "mdi-pipe"
    paramsForm: "addResource"
    if p.key.trim() == '' {
      fail 'A resource needs a key.'
    }
    if diagram.nodesOfType('Resource').exists(r, r.resourceKind == 'pipelines' && r.key == p.key.trim()) {
      fail 'A pipelines resource named \'' + p.key.trim() + '\' is already there.'
    }
    create Resource { resourceKind: 'pipelines', key: p.key.trim() }
  }

  /// Runs the job reading's command of the same name, which adds a notebook task to a job of the file; the tool offers
  /// it under this reading too.
  operation addNotebookTaskHere "Add notebook task here" for diagram {
    icon: "mdi-notebook-outline"
    plugin: { name: "net.etalii.adp.databricks.files", args: { taskType: "notebook" } }
  }

  /// Runs the job reading's command of the same name, which adds a Python task to a job of the file; the tool offers it
  /// under this reading too.
  operation addPythonTaskHere "Add Python task here" for diagram {
    icon: "mdi-language-python"
    plugin: { name: "net.etalii.adp.databricks.files", args: { taskType: "python" } }
  }

  /// Runs the job reading's command of the same name, which adds a condition task to a job of the file; the tool offers
  /// it under this reading too.
  operation addConditionTaskHere "Add condition task here" for diagram {
    icon: "mdi-call-split"
    plugin: { name: "net.etalii.adp.databricks.files", args: { taskType: "condition" } }
  }

  /// Runs the job reading's connect command, which the tool offers under this reading too.
  operation connectTasks "Depend on" for diagram {
    /// Where the gesture started.
    param from: Element
    /// Where the gesture ended.
    param to: Element
    icon: "mdi-ray-start-arrow"
    plugin: { name: "net.etalii.adp.databricks.files", args: { connect: "dependency" } }
  }

  operation simulateDeploy "Deploy here (simulated)" for Target {
    icon: "mdi-rocket-launch-outline"
    simulate: {
      for: ["Resource", "Unknown"]
      state: "simulated"
      initial: ('pending')
      next: (cel.bind(r, rippleRank(self, deployMembers()), step == 2 * r + 1 ? 'running' : (step >= 2 * r + 2 ? 'succeeded' : 'pending')))
      until: (step >= 2 * deployMembers().size())
      stepMs: 700
      notice: { running: "Simulated: deploy", finished: "Simulated: deploy — finished" }
      doc: "A mock deploy that ripples over the resources and the unmodelled configuration, one element at a time in position order: each goes from pending to running to succeeded, one change every 700 ms. Nothing is written, nothing enters the undo history."
    }
  }

  // ---------------------------------------------------------------- Persistence

  persistence {
    format: fbl
    files: {
      mode: split
      model: "databricks.yml"
      view: "{name}.adp"
      doc: "The model is the bundle's own databricks.yml, which Databricks owns; the view is the ADP registration file's layout: block."
    }
    ids: {
      strategy: natural
      prefix: { Target: "target:" }
      pattern: "^[^\\r\\n]{1,512}$"
      types: {
        Bundle: { strategy: derived, expression: ('bundle'), doc: "The one bundle node keeps one id." }
        Resource: { strategy: derived, expression: ('resource:' + self.resourceKind + '/' + self.key) }
        Unknown: { strategy: derived, expression: ('unknown:' + self.path) }
        Override: {
          strategy: derived
          expression: ('override:' + self.source.name + '/' + self.writtenKind + '/' + self.writtenKey)
        }
      }
      doc: "`bundle`, `resource:<kind>/<key>`, `unknown:<path>`, `target:<name>` and `override:<target>/<kind>/<key>`."
    }
    view: { store: [bounds], styleOverrides: none }
    typeMap: {
      BundleFile: { as: diagram }
      Override: {
        as: Override
        attributes: { from: "source", to: "target" }
        doc: "Read as an entry with two reference attributes, so that an override of a resource the bundle does not declare is kept with that end unset (DISL 4.9)."
      }
    }
  }

  plugin net.etalii.adp.databricks.files {
    version: "^0.1.0"
    provides: [persistenceFormat, action]
    required: false
    doc "Reads and writes the bundle inside Databricks' own databricks.yml by line splices, so an untouched file saves byte for byte, and keeps positions in the .adp registration's layout: block. As an action it runs the job reading's commands that the tool offers under this reading too. This description states the reading and the writing as the binding `bundle` (databricks-bundle.bundle.atd), a declared one, and those commands stay the plugin's (spec 067: an operation of one reading writing another's types has no statement of its own yet); the plugin stays declared for the hosts that run the JSON files."
  }

  plugin net.etalii.adp.databricks.layout {
    version: "^0.1.0"
    provides: [layout]
    required: false
    fallback: { layout: "grid" }
    args: {
      reading: { type: "string", required: true }
      columnWidth: { type: "number" }
      bundleY: { type: "number" }
      resourceY: { type: "number" }
      targetY: { type: "number" }
    }
    doc "The family's computed layouts. This description requires the bundle's as the capability `layout.bands`; the plugin stays declared for the hosts that run the JSON files."
  }

  x-databricks: {
    doc: "Today's wire ids, which the standalone backend and client share, mapped from this specification's names, as x-ghg does for the hype cycle. A tool is keyed by its id. An action is keyed by its entry's operation, else its kind. A property is keyed by its form item's row id: its id, else its attribute, else a computed item's label. A target's two rows reuse the ids of a task's key and type rows."
    tools: {
      jobResource: { id: "databricks.toolbox.job-resource", drop: "databricks.add-resource:jobs" }
      pipelineResource: { id: "databricks.toolbox.pipeline-resource", drop: "databricks.add-resource:pipelines" }
    }
    actions: {
      renameBundle: "databricks.rename-bundle"
      addJobResource: "databricks.add-resource:jobs"
      addPipelineResource: "databricks.add-resource:pipelines"
      simulateDeploy: "databricks.simulated.deploy"
      addNotebookTaskHere: "databricks.add-task:notebook"
      addPythonTaskHere: "databricks.add-task:python"
      addConditionTaskHere: "databricks.add-task:condition"
      connectTasks: "databricks.connect"
    }
    properties: {
      name: "databricks.bundle-name"
      targetName: "databricks.task-key"
      targetMode: "databricks.task-type"
      "Workspace connection": "databricks.workspace"
      "Last simulated run": "databricks.last-simulated-run"
    }
  }
}
