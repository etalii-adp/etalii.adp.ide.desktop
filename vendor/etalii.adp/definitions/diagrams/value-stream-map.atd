atd 0.1

/// How a demand becomes value: the steps it passes through, who performs them, how long each works and waits, and
/// where the stream loses time, in the current state and a future one.
///
/// A value stream map is one plain YAML file, .vsm, that a person or an agent can write by hand. Its trigger, steps
/// and outcome are joined by flows; an alternative carries a share of a step's work and rework sends a rate of it
/// back. The diagram computes lead time, process time, flow efficiency and hand-offs by the expected visits of each
/// step, marks the three longest waits, and compares a future state with the current one. The activity and practice
/// lists belong to the document and start from a template. What the diagram does not do, and the file for agents,
/// are in value-stream-map.md.
diagram generic/value-stream-map version "0.1.0" {
  label "Value stream map"
  id: "net.etalii.adp.generic.value-stream-map"
  fileExtension: "vsm"
  license: "Apache-2.0"
  authors: [{ name: "Peter Vrenken" }]
  icon: "mdi-transit-connection-variant"
  limits: {
    budgets: {
      steps: {
        measure: (max(stepsOf('current').size(), stepsOf('future').size()))
        max: 64
        truncate: false
        notice: false
        withhold: { edits: "none" }
        doc: "Steps per state. Beyond it nothing is cut and nothing withheld: the totals of that state are not computed, and vsm.too-many-steps says so (research R10)."
      }
    }
  }
  doc: {
    tags: ["value stream", "service management", "lead time", "flow efficiency", "hand-offs"]
    seeAlso: [{ title: "The file, the totals and what this diagram does not do", href: "value-stream-map.md" }]
  }
  x-adp: { kind: "Diagram", companion: "value-stream-map.md" }

  import "value-stream-map.notation.atd"
  import "value-stream-map.vsm.atd"

  /// A duration in minutes, the unit every total is computed in.
  fn minutesOf(d: duration) -> double {
    return double(d.getSeconds()) / 60.0
  }

  /// Minutes in the diagram's unit: minutes, hours (the default) or days of 24 hours. Working-day calendars are out
  /// of scope (value-stream-map.md).
  fn inUnit(minutes: double, unit: string) -> double {
    return unit == 'minutes' ? minutes : unit == 'days' ? minutes / 1440.0 : minutes / 60.0
  }

  /// The abbreviation a total is shown with.
  fn unitWord(unit: string) -> string {
    return unit == 'minutes' ? 'min' : unit == 'days' ? 'd' : 'h'
  }

  /// A total as the summary shows it, in the diagram's unit with at most two decimals.
  fn shownTotal(minutes: double, unit: string) -> string {
    return formatNumber(inUnit(minutes, unit), '#,##0.##') + ' ' + unitWord(unit)
  }

  /// A step's process time in minutes; a missing one counts as zero and is reported (vsm.missing-process-time).
  fn processMinutes(s: Step) -> double {
    return has(s.processTime) ? minutesOf(s.processTime) : 0.0
  }

  /// A step's wait time in minutes; a missing one counts as zero and is reported (vsm.missing-wait).
  fn waitMinutes(s: Step) -> double {
    return has(s.waitTime) ? minutesOf(s.waitTime) : 0.0
  }

  /// The part of the visits of its source a forward flow carries: its share for an alternative, all of them
  /// otherwise.
  fn share(f: Flow) -> double {
    return f.isA('Alternative') ? f.share : 1.0
  }

  /// A hand-off is not stored: it is a forward flow between two steps whose performers differ (research R5, FR-001).
  fn isHandoff(f: Flow) -> bool {
    return f.source.isA('Step') && f.target.isA('Step') && f.source.performer != f.target.performer
  }

  /// How often an element is reached by forward flows alone, counting the trigger once and weighting each flow by its
  /// share. A step no forward path reaches from the trigger gets zero. The visited ids stop a cycle of forward flows,
  /// which vsm.unmarked-cycle reports; 64 is the step budget (research R4, R10).
  fn baseVisits(n: Element, visited: list<string>) -> double recursion 64 {
    return n.isA('Trigger') ? 1.0 : n.id in visited ? 0.0 : n.incomingOf('Flow').map(f, baseVisits(f.source, visited + [n.id]) * share(f)).sum()
  }

  /// The product of the numbers of a list from position i, since CEL has no product of its own.
  fn product(l: list<double>, i: int) -> double recursion 64 {
    return i >= l.size() ? 1.0 : l[i] * product(l, i + 1)
  }

  /// Whether a step lies on the forward path a rework flow repeats: from its target to its source, both included.
  fn inLoop(s: Element, r: Rework) -> bool {
    return s == r.target || s == r.source || (s in r.target.reachable('Flow') && r.source in s.reachable('Flow'))
  }

  /// How much more often rework makes a step run: 1 / (1 - rate) for each rework loop the step lies on (research R4).
  fn loopFactor(s: Element) -> double {
    return product(diagram.relationsOfType('Rework').filter(r, r.rate > 0.0 && r.rate < 1.0 && inLoop(s, r)).map(r, 1.0 / (1.0 - r.rate)), 0)
  }

  /// The expected number of times a step runs: its visits by forward flows, times the factor of each rework loop it
  /// lies on. With no branch and no rework every reached step runs once.
  fn visits(s: Element) -> double {
    return baseVisits(s, []) * loopFactor(s)
  }

  /// How often a forward flow is taken: inside a rework loop as often as the loop runs, on the way out of it once.
  fn flowTraversals(f: Flow) -> double {
    return baseVisits(f.source, []) * share(f) * product(diagram.relationsOfType('Rework').filter(r, r.rate > 0.0 && r.rate < 1.0 && inLoop(f.source, r) && inLoop(f.target, r)).map(r, 1.0 / (1.0 - r.rate)), 0)
  }

  /// The steps of one state.
  fn stepsOf(state: string) -> list<Step> {
    return diagram.nodesOfType('Step').filter(s, s.state == state)
  }

  /// Whether a state's totals are computed: it has steps, at most the budget of 64, one trigger and no cycle of
  /// forward flows (vsm.empty-stream, vsm.too-many-steps, vsm.missing-trigger, vsm.second-trigger,
  /// vsm.unmarked-cycle).
  fn computable(state: string) -> bool {
    return stepsOf(state).size() > 0 && stepsOf(state).size() <= 64 && diagram.nodesOfType('Trigger').filter(t, t.state == state).size() == 1 && !stepsOf(state).exists(s, s.inCycle('Flow'))
  }

  /// Lead time in minutes: the sum over the state's steps of visits × (process time + wait time).
  fn leadTime(state: string) -> double {
    return stepsOf(state).map(s, visits(s) * (processMinutes(s) + waitMinutes(s))).sum()
  }

  /// Total process time in minutes: the sum over the state's steps of visits × process time.
  fn processTotal(state: string) -> double {
    return stepsOf(state).map(s, visits(s) * processMinutes(s)).sum()
  }

  /// Process time over lead time, between 0 and 1; -1 stands for absent when the lead time is zero.
  fn flowEfficiency(state: string) -> double {
    return leadTime(state) > 0.0 ? processTotal(state) / leadTime(state) : -1.0
  }

  /// The expected number of hand-offs: the sum over the state's hand-off flows of how often each is taken.
  fn handoffs(state: string) -> double {
    return diagram.relationsOfType('Flow').filter(f, f.source.state == state && isHandoff(f)).map(f, flowTraversals(f)).sum()
  }

  /// Flow efficiency as a percentage with one decimal, or a dash when it is absent.
  fn shownEfficiency(state: string) -> string {
    return flowEfficiency(state) < 0.0 ? '–' : formatNumber(flowEfficiency(state) * 100.0, '0.#') + ' %'
  }

  /// A count of hand-offs, which rework and alternatives make fractional.
  fn shownCount(n: double) -> string {
    return formatNumber(n, '0.##')
  }

  /// The column an element stands in: one more than the deepest element a forward flow reaches it from; the trigger
  /// and an unconnected step stand in column 0 (research R8).
  fn depth(n: Element, visited: list<string>) -> int recursion 64 {
    return n.isA('Trigger') || n.incomingOf('Flow').size() == 0 || n.id in visited ? 0 : n.incomingOf('Flow').map(f, depth(f.source, visited + [n.id])).max() + 1
  }

  /// The row an element stands in within its state: the row of what its first forward flow comes from, moved down by
  /// the rank of that flow among its source's alternatives, largest share first, so the main path stays on top
  /// (research R8).
  fn lane(n: Element, visited: list<string>) -> int recursion 64 {
    return n.isA('Trigger') || n.incomingOf('Flow').size() == 0 || n.id in visited ? 0 : cel.bind(f, n.incomingOf('Flow')[0], f.isA('Alternative') ? lane(f.source, visited + [n.id]) + f.source.outgoingOf('Alternative').filter(a, a.share > f.share || (a.share == f.share && a.id < f.id)).size() : lane(f.source, visited + [n.id]))
  }

  /// The band a state is drawn in when both are shown in one picture, such as an exported image: the current state
  /// above, the future below.
  fn stateRow(state: string) -> int {
    return state == 'future' ? 1 : 0
  }

  /// The column of the element of a state furthest along its flow, after which the summary stands.
  fn longestColumn(state: string) -> int {
    return diagram.nodes.filter(n, (n.isA('Step') || n.isA('Outcome')) && n.state == state).map(n, depth(n, [])).max()
  }

  /// A step is marked when fewer than three steps of its state wait strictly longer, so ties are all marked (research
  /// R9, FR-005).
  fn longWait(s: Step) -> bool {
    return has(s.waitTime) && waitMinutes(s) > 0.0 && stepsOf(s.state).count(o, waitMinutes(o) > waitMinutes(s)) < 3
  }

  /// The longest wait of a state, against which each step's wait band is drawn.
  fn longestWait(state: string) -> double {
    return stepsOf(state).size() == 0 ? 0.0 : stepsOf(state).map(s, waitMinutes(s)).max()
  }

  /// A value stream: a trigger, steps and an outcome joined by flows, in a current state and an optional future
  /// state, with the stream's own vocabularies of activities and practices. A hand-off is not stored: it is a flow
  /// between two steps whose performers differ (FR-001). The figures of each state are derived nodes computed by the
  /// functions (FR-004).
  model {
    /// The stream's name, the unit its totals are shown in, and the state the kept filter shows.
    document {
      /// What the stream is called.
      attribute name: string required { label: "Name", order: 1 }
      /// The unit the summary and comparison show totals in. Default hours.
      attribute unit: Unit default hours { label: "Totals in", order: 2 }
      /// The state the canvas shows; kept in the file as view.state (persistence.view.bind). Written by the diagram only.
      attribute shownState: State default current { label: "Shown state", order: 3 }
    }

    /// An entry of the stream's activity vocabulary (FR-003): the names a step's activity is chosen from, with a
    /// colour. Not drawn: it is edited in the diagram's form, and a template supplies a starting list.
    element Activity {
      label "Activity"
      labelAttribute: "name"
      /// The activity's name, as steps write it.
      attribute name: string required { label: "Name", order: 1 }
      /// The colour of the steps of this activity.
      attribute color: color { label: "Colour", order: 2 }
    }

    /// An entry of the stream's practice list (FR-003): the names a step's practices are chosen from. Not drawn.
    element Practice {
      label "Practice"
      labelAttribute: "name"
      /// The practice's name, as steps write it.
      attribute name: string required { label: "Name", order: 1 }
    }

    /// An element of one state of the stream.
    element StreamNode {
      abstract: true
      labelAttribute: "name"
      /// What it is called.
      attribute name: string required { label: "Name", order: 1, group: "Identity" }
      /// current or future: read from the key the element stands under (research R2). Never written as a key.
      attribute state: State readonly {
        label: "State"
        readOnlyReasons: [
          {
            message: "Which state an element belongs to is where it stands in the file, under current: or future:. Create the future state from the menu."
          }
        ]
        group: "Identity"
      }
      /// In the future state, the id of the current element this one was copied from by Create future state (research
      /// R3). Lets the comparison and an agent tell which future step replaced which current one.
      attribute basedOn: string readonly { label: "Based on", group: "Identity" }
    }

    /// What starts the stream: a demand or an event. One per state (vsm.missing-trigger, vsm.second-trigger).
    element Trigger extends StreamNode {
      label "Trigger"
      icon: "mdi-play-circle-outline"
      /// The key the trigger is written under in its state, always trigger; a new trigger takes it from this default, and
      /// a state that already has one refuses a second (FBL 0.14, a new member named by its key).
      attribute role: string readonly default trigger
    }

    /// The value the stream delivers. One per state (vsm.missing-outcome, vsm.second-outcome).
    element Outcome extends StreamNode {
      label "Outcome"
      icon: "mdi-flag-checkered"
      /// The key the outcome is written under in its state, always outcome.
      attribute role: string readonly default outcome
    }

    /// One piece of work in the stream, with who does it and how long it takes and waits (FR-002).
    element Step extends StreamNode {
      label "Step"
      icon: "mdi-rectangle-outline"
      /// The activity the step belongs to, one of the stream's activities; a name not in the list is kept and reported
      /// (vsm.unknown-activity).
      attribute activity: string { label: "Activity", order: 2, group: "Work" }
      /// The practices the step uses, from the stream's practice list; a name not in the list is kept and reported
      /// (vsm.unknown-practice).
      attribute practices: string many { label: "Practices", order: 3, group: "Work" }
      /// Who does the step: a team, a role or an agent. Two steps joined by a flow with different performers make a
      /// hand-off.
      attribute performer: string { label: "Performer", order: 4, group: "Work" }
      /// How long the work itself takes, as an ISO 8601 duration without months or years (PT20M, PT3H, P2D); shown in the
      /// unit it is written in (research R6).
      attribute processTime: duration { label: "Process time", order: 5, group: "Times" }
      /// How long the work waits before the step starts, in the same form.
      attribute waitTime: duration { label: "Wait time", order: 6, group: "Times" }
      /// Anything else worth knowing about the step.
      attribute note: text { label: "Note", order: 7, group: "Work" }
    }

    /// The figures of one state (FR-004): lead time, process time, flow efficiency and hand-offs, in the diagram's
    /// unit. Derived, one per state that has a trigger; a state whose totals cannot be computed shows why instead.
    element Summary {
      label "Summary"
      icon: "mdi-sigma"
      derived: {
        from: (diagram.nodesOfType('Trigger').map(t, t.state).distinct())
        id: ('summary-' + item)
        attributes: {
          state: (item)
          computed: (computable(item))
          leadTime: (computable(item) ? shownTotal(leadTime(item), diagram.unit) : '–')
          processTime: (computable(item) ? shownTotal(processTotal(item), diagram.unit) : '–')
          efficiency: (computable(item) ? shownEfficiency(item) : '–')
          handoffs: (computable(item) ? shownCount(handoffs(item)) : '–')
        }
        sources: (stepsOf(item))
        reason: "The summary is computed from the steps and flows of its state; change those to change it."
      }
      attribute state: State { label: "State" }
      attribute leadTime: string { label: "Lead time" }
      attribute processTime: string { label: "Process time" }
      attribute efficiency: string { label: "Flow efficiency" }
      attribute handoffs: string { label: "Hand-offs" }
      attribute computed: bool { label: "Computed" }
    }

    /// Each figure of the current and the future state side by side, with the difference (FR-006). Derived, only while
    /// both states can be computed.
    element Comparison {
      label "Comparison"
      icon: "mdi-compare-horizontal"
      derived: {
        from: (computable('current') && computable('future') ? ['comparison'] : [])
        id: (item)
        attributes: {
          leadTime: (shownTotal(leadTime('current'), diagram.unit) + ' → ' + shownTotal(leadTime('future'), diagram.unit) + ' (' + shownTotal(leadTime('future') - leadTime('current'), diagram.unit) + ')')
          processTime: (shownTotal(processTotal('current'), diagram.unit) + ' → ' + shownTotal(processTotal('future'), diagram.unit) + ' (' + shownTotal(processTotal('future') - processTotal('current'), diagram.unit) + ')')
          efficiency: (shownEfficiency('current') + ' → ' + shownEfficiency('future'))
          handoffs: (shownCount(handoffs('current')) + ' → ' + shownCount(handoffs('future')) + ' (' + shownCount(handoffs('future') - handoffs('current')) + ')')
        }
        sources: (diagram.nodesOfType('Step'))
        reason: "The comparison is computed from both states; change their steps and flows to change it."
      }
      attribute leadTime: string { label: "Lead time" }
      attribute processTime: string { label: "Process time" }
      attribute efficiency: string { label: "Flow efficiency" }
      attribute handoffs: string { label: "Hand-offs" }
    }

    /// The work moves on from its source to its target. Drawn as a hand-off when both ends are steps whose performers
    /// differ (research R5).
    relation Flow from Trigger, Step to Step, Outcome {
      label "Flow"
      icon: "mdi-arrow-right"
      directed: true
      allowSelfLoops: false
      allowParallel: false
    }

    /// One of several ways on from a step, taken by a share of its work. The shares leaving one step sum to 1
    /// (vsm.shares).
    relation Alternative extends Flow from Step to Step, Outcome {
      label "Alternative"
      icon: "mdi-call-split"
      /// The part of the source's work that goes this way, between 0 and 1 (0.8 is 80 %).
      attribute share: number required { label: "Share", exclusiveMin: 0, max: 1 }
    }

    /// A share of a step's work goes back to an earlier step and runs again (vsm.rework-forward when the target does
    /// not precede the source).
    relation Rework from Step to Step {
      label "Rework"
      icon: "mdi-backup-restore"
      directed: true
      allowSelfLoops: true
      allowParallel: false
      /// The part of the source's work that goes back, between 0 and 1 exclusive (0.1 is 10 %).
      attribute rate: number required { label: "Rate", exclusiveMin: 0, exclusiveMax: 1 }
    }

    /// The two states one document holds (FR-006).
    enum State {
      current { label: "Current", doc: "The stream as it runs today." }
      future { label: "Future", doc: "The stream as it should run." }
    }

    enum Unit {
      minutes { label: "Minutes" }
      hours { label: "Hours" }
      days { label: "Days (24 hours)" }
    }
  }

  /// A map an agent or a person wrote that breaks a rule still opens and draws; each breach is a finding, never a
  /// refusal, so nothing anyone wrote is lost (FR-007). Two gestures are refused: a flow that crosses states, and a
  /// flow that is both an alternative and rework, which the file cannot hold.
  constraints {
    blockSaveOn: never

    constraint emptyStream for diagram {
      label "State without steps"
      rule diagram.nodesOfType('Trigger').all(t, stepsOf(t.state).size() > 0)
      severity info
      message ('The ' + diagram.nodesOfType('Trigger').filter(t, stepsOf(t.state).size() == 0)[0].state + ' state has no step yet.')
      code: "vsm.empty-stream"
    }

    constraint missingTrigger for diagram {
      label "No trigger"
      rule diagram.nodesOfType('Step').all(s, diagram.nodesOfType('Trigger').exists(t, t.state == s.state))
      severity warning
      message ('The ' + diagram.nodesOfType('Step').filter(s, !diagram.nodesOfType('Trigger').exists(t, t.state == s.state))[0].state + ' state has no trigger; its totals are not computed.')
      code: "vsm.missing-trigger"
    }

    constraint missingOutcome for diagram {
      label "No outcome"
      rule diagram.nodesOfType('Trigger').all(t, diagram.nodesOfType('Outcome').exists(o, o.state == t.state))
      severity warning
      message ('The ' + diagram.nodesOfType('Trigger').filter(t, !diagram.nodesOfType('Outcome').exists(o, o.state == t.state))[0].state + ' state has no outcome.')
      code: "vsm.missing-outcome"
    }

    constraint secondTrigger for Trigger {
      label "Second trigger"
      rule diagram.nodesOfType('Trigger').filter(t, t.state == self.state).size() == 1
      severity warning
      message ('"' + self.name + '" is a second trigger of the ' + self.state + ' state; a stream starts once.')
      code: "vsm.second-trigger"
    }

    constraint secondOutcome for Outcome {
      label "Second outcome"
      rule diagram.nodesOfType('Outcome').filter(o, o.state == self.state).size() == 1
      severity warning
      message ('"' + self.name + '" is a second outcome of the ' + self.state + ' state; a stream ends once.')
      code: "vsm.second-outcome"
    }

    constraint unconnectedStep for Step {
      label "Unconnected step"
      rule diagram.nodesOfType('Trigger').exists(t, t.state == self.state && self in t.reachable('Flow'))
      severity warning
      message ('No flow reaches "' + self.name + '" from the trigger; it is left out of the totals.')
      code: "vsm.unconnected-step"
    }

    constraint missingWait for Step {
      label "No wait time"
      rule has(self.waitTime)
      severity info
      message ('"' + self.name + '" has no wait time; it counts as zero.')
      code: "vsm.missing-wait"
      attribute: "waitTime"
    }

    constraint missingProcessTime for Step {
      label "No process time"
      rule has(self.processTime)
      severity info
      message ('"' + self.name + '" has no process time; it counts as zero.')
      code: "vsm.missing-process-time"
      attribute: "processTime"
    }

    constraint shares for Step {
      label "Shares do not add up"
      rule self.outgoingOf('Alternative').size() == 0 || math.abs(self.outgoingOf('Alternative').map(a, a.share).sum() - 1.0) < 0.0001
      severity warning
      message ('The alternatives leaving "' + self.name + '" take ' + formatNumber(self.outgoingOf('Alternative').map(a, a.share).sum() * 100.0, '0.#') + ' % of its work, not 100 %.')
      code: "vsm.shares"
    }

    constraint unmarkedCycle for Step {
      label "Cycle of forward flows"
      rule !self.inCycle('Flow')
      severity error
      message ('"' + self.name + '" lies on a cycle of forward flows. Mark the flow that goes back as rework; until then the totals of its state are not computed.')
      code: "vsm.unmarked-cycle"
    }

    constraint reworkForward for Rework {
      label "Rework that goes forward"
      rule self.source == self.target || self.source in self.target.reachable('Flow')
      severity warning
      message ('The rework from "' + self.source.name + '" goes to "' + self.target.name + '", which does not come before it; rework goes back to an earlier step.')
      code: "vsm.rework-forward"
    }

    constraint tooManySteps for diagram {
      label "Too many steps"
      rule stepsOf('current').size() <= 64 && stepsOf('future').size() <= 64
      severity warning
      message ('A state has more than 64 steps; its totals are not computed.')
      code: "vsm.too-many-steps"
    }

    constraint unknownActivity for Step {
      label "Activity not in the list"
      rule !has(self.activity) || self.activity == '' || diagram.nodesOfType('Activity').exists(a, a.name == self.activity)
      severity info
      message ('"' + self.activity + '" is not one of the stream\'s activities; it is kept as written.')
      code: "vsm.unknown-activity"
      attribute: "activity"
    }

    constraint unknownPractice for Step {
      label "Practice not in the list"
      rule self.practices.all(p, diagram.nodesOfType('Practice').exists(q, q.name == p))
      severity info
      message ('"' + self.practices.filter(p, !diagram.nodesOfType('Practice').exists(q, q.name == p))[0] + '" is not one of the stream\'s practices; it is kept as written.')
      code: "vsm.unknown-practice"
      attribute: "practices"
    }

    /// Relations never cross states (data-model.md).
    constraint sameState {
      label "Flow across states"
      rule source.state == target.state
      message ('A flow joins two elements of one state; "' + source.name + '" is in the ' + source.state + ' state and "' + target.name + '" in the ' + target.state + ' state.')
      code: "vsm.cross-state"
      kind: "connect"
    }
  }

  /// Every edit is one undoable step. Creating the future state copies the current one in one step; showing a state
  /// changes the kept filter, which is also one step.

  /// Research R3: every trigger, step, outcome and flow of the current state is copied into future:, each copy
  /// carrying basedOn, the id of what it copies; then the canvas shows the future state.
  operation createFutureState "Create future state" for document {
    icon: mdi-content-copy
    unavailable [
      {
        when: (diagram.nodes.exists(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'future'))
        message: "The map already has a future state. Remove it first to copy the current state again."
      },
      {
        when: (!diagram.nodesOfType('Trigger').exists(t, t.state == 'current'))
        message: "The current state has no trigger to copy yet."
      }
    ]
    for n in diagram.nodes.filter(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'current') limit 200 {
      if n.isA('Trigger') {
        create Trigger { name: n.name, state: 'future', basedOn: n.id }
      } else if n.isA('Outcome') {
        create Outcome { name: n.name, state: 'future', basedOn: n.id }
      } else {
        create Step { name: n.name, state: 'future', basedOn: n.id, practices: n.practices } as copy
        if has(n.activity) {
          set copy.activity = n.activity
        }
        if has(n.performer) {
          set copy.performer = n.performer
        }
        if has(n.processTime) {
          set copy.processTime = n.processTime
        }
        if has(n.waitTime) {
          set copy.waitTime = n.waitTime
        }
        if has(n.note) {
          set copy.note = n.note
        }
      }
    }
    for r in diagram.relations.filter(r, (r.isA('Flow') || r.isA('Rework')) && r.source.state == 'current') limit 1000 {
      let head = diagram.nodes.filter(m, m.state == 'future' && m.basedOn == r.source.id)[0]
      let tail = diagram.nodes.filter(m, m.state == 'future' && m.basedOn == r.target.id)[0]
      if r.isA('Alternative') {
        connect Alternative from head to tail { share: r.share }
      } else if r.isA('Rework') {
        connect Rework from head to tail { rate: r.rate }
      } else {
        connect Flow from head to tail
      }
    }
    view diagram { filters: {'state': 'future'} }
  }

  operation showCurrent "Show current state" for document {
    unavailable [{ when: (diagram.shownState == 'current'), message: "The current state is shown." }]
    view diagram { filters: {'state': 'current'} }
  }

  operation showFuture "Show future state" for document {
    unavailable [
      {
        when: (!diagram.nodesOfType('Trigger').exists(t, t.state == 'future'))
        message: "The map has no future state yet. Create it from the current state first."
      },
      { when: (diagram.shownState == 'future'), message: "The future state is shown." }
    ]
    view diagram { filters: {'state': 'future'} }
  }

  operation removeFutureState "Remove future state" for document {
    icon: mdi-delete-outline
    unavailable [
      {
        when: (!diagram.nodes.exists(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'future'))
        message: "The map has no future state."
      }
    ]
    confirm { message: ('Remove the future state and its ' + string(stepsOf('future').size()) + ' steps? The current state is kept.'), danger: true }
    view diagram { filters: {'state': 'current'} }
    for n in diagram.nodes.filter(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'future') limit 200 {
      delete n
    }
  }

  /// The vocabularies are lists of names, edited in forms and never drawn.
  viewpoint stream "Value stream" { exclude: ["Activity", "Practice"], default: true }

  /// One YAML file, .vsm, read and written through the FBL binding value-stream-map.fbl#vsm with byte-preserving
  /// splices. Its shape for people and agents is in value-stream-map.md, and its JSON Schema is
  /// value-stream-map.schema.json.
  persistence {
    format: "fbl"
    ids: {
      strategy: "sequential"
      prefix: { Trigger: "t", Step: "s", Outcome: "o" }
      types: {
        Flow: {
          strategy: "derived"
          expression: ('flow:' + self.source.id + '->' + self.target.id)
          doc: "A flow is written as its ends alone, so its id is formed from them; two flows between the same ends are refused (allowParallel false)."
        }
        Rework: { strategy: "derived", expression: ('rework:' + self.source.id + '->' + self.target.id) }
        Activity: { strategy: "derived", expression: ('activity:' + self.name) }
        Practice: { strategy: "derived", expression: ('practice:' + self.name) }
      }
      doc: "A new trigger, step or outcome takes the next free id of its kind, across the file: t, s or o followed by a number (contracts/value-stream-document.md, Rules). Ids written by hand are kept as written. A flow and a vocabulary entry have no id key in the file: theirs are formed from their ends or their name."
    }
    typeMap: {
      Diagram: {
        as: "diagram"
        attributes: { shownState: null }
        hostAttributes: ["unknownKeys"]
        doc: "The root mapping: name and unit; view.state is the kept filter's value (view.bind)."
      }
      Activity: { as: "Activity" }
      Practice: { as: "Practice" }
      Trigger: { as: "Trigger", hostAttributes: ["unknownKeys"] }
      Step: { as: "Step", hostAttributes: ["unknownKeys"] }
      Outcome: { as: "Outcome", hostAttributes: ["unknownKeys"] }
      Flow: { as: "Flow" }
      Alternative: { as: "Alternative" }
      Rework: { as: "Rework" }
    }
    view: {
      store: ["filters"]
      viewer: ["selection", "viewport"]
      bind: {
        filters: { type: "Diagram", values: { state: "shownState" }, doc: "The shown state is the key view.state." }
      }
      doc: "The only view data kept in the file is the shown state, under view:, which the diagram writes and an agent leaves alone. Placement is computed from the flows, so nothing else is stored."
    }
  }
}
