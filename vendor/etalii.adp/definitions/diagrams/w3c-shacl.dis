{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.w3c.shacl",
    "version": "1.0.0",
    "label": "SHACL shapes",
    "icon": "mdi:check-decagram-outline",
    "fileExtension": "ttl",
    "license": "Apache-2.0",
    "homepage": "https://www.w3.org/TR/shacl/",
    "authors": [ { "name": "Peter Vrenken" } ],
    "limits": { "maxElements": 1000 },
    "requires": { "conformance": "standard" },
    "doc": {
      "summary": "The constraints a shapes graph states: node shapes as cards, their property constraints as rows, and what each one targets - drawn, never executed.",
      "description": "A reading of a SHACL shapes graph stored as Turtle (`.ttl`) or N-Triples (`.nt`). Every shape the file declares or uses is read: IRI-named node shapes become cards, property shapes become constraint rows on the cards that reference them (path, constraint summary, cardinality), target declarations become sentences on their card, and shape-to-shape references (`sh:node`, `sh:and`, `sh:or`, `sh:xone`, `sh:not`, and `sh:class` where exactly one card claims the class) become labelled edges. A shapes graph is about data held elsewhere, so no element is ever made for a targeted term, and nothing is ever run against data.\n\nThe diagram is stored in the shapes file itself, which other tools own; ADP writes only minimal splices into it, and keeps positions in the `.adp` registration beside it. What this specification cannot express - which triples make a shape, the row summary's parameter order, path syntax, the splice discipline, the refusal sentences, and where the implementation differs - is written down in `w3c-shacl.md` beside this file.",
      "tags": [ "shacl", "shapes", "constraints", "application profile", "rdf", "semantic web" ],
      "seeAlso": [
        { "title": "W3C SHACL recommendation", "href": "https://www.w3.org/TR/shacl/" },
        { "title": "SHACL Play", "href": "https://shacl-play.sparna.fr/play/" }
      ]
    }
  },

  "metamodel": {
    "doc": "Only shapes become elements, by the recommendation's declaration-or-use definition: a subject typed `sh:NodeShape` or `sh:PropertyShape`, a subject of a target predicate or a constraint parameter, an object of `sh:node`, `sh:property`, `sh:qualifiedValueShape` or `sh:not`, or a member of an `sh:and`, `sh:or` or `sh:xone` list. Co-resident ontology or instance content belongs to the sibling readings of the same file. Typing is read from stated triples and never inferred.",
    "diagram": {
      "attributes": {
        "truncated": {
          "type": "bool", "default": false, "readOnly": true,
          "doc": "The file holds more cards than the drawn-element budget (1000), so the view is partial and the banner shows."
        },
        "editsWithheld": {
          "type": "bool", "default": false, "readOnly": true,
          "doc": "The file is over the RDF family's node budget (1000 RDF nodes), so every edit through the diagram is refused. Measured on the family projection, not on the cards: see w3c-shacl.md."
        },
        "shown": { "type": "int", "readOnly": true, "doc": "Cards drawn under the budget." },
        "total": { "type": "int", "readOnly": true, "doc": "Cards the file's shapes yield." },
        "externalReferences": {
          "type": "string", "many": true, "readOnly": true,
          "doc": "Displays of the IRIs that an `sh:node` or `sh:property` triple references and that are never a subject in this file, one per referencing triple, in document order."
        },
        "unknownTerms": {
          "type": "string", "many": true, "readOnly": true,
          "doc": "Local names of predicates or IRI objects in the `sh:` namespace that SHACL does not define, one per occurrence, in document order."
        }
      }
    },
    "dataTypes": {
      "TargetChip": {
        "doc": "One target declaration on a card: a sentence, never an element and never an edge, whether or not the targeted term is described in this file.",
        "fields": {
          "kind": { "type": "TargetKind", "required": true },
          "term": { "type": "string", "required": true, "doc": "The targeted term's display: a prefixed name, a literal's lexical form, or `_:label` for a blank node; the card's own display for the implicit target." },
          "termIri": { "type": "string", "default": "", "doc": "The targeted IRI; empty for a literal or blank target." },
          "predicateIri": { "type": "string", "default": "", "doc": "The target predicate; empty for the implicit class target, which no triple declares." },
          "describedInFile": { "type": "bool", "default": false, "doc": "The targeted term is a subject somewhere in this file. A fact the grid states, never a finding." }
        },
        "display": { "cel": "value.kind == 'implicitClass' ? 'targets its own instances' : 'targets ' + {'class': 'class ', 'node': 'node ', 'subjectsOf': 'subjects of ', 'objectsOf': 'objects of '}[value.kind] + value.term" }
      },
      "ConstraintRow": {
        "doc": "One row on a card: a referenced property shape, a combinator or `sh:not` with a blank operand stated on the card, or an `sh:sparql` constraint. Rows carry no identity or position of their own.",
        "fields": {
          "kind": { "type": "RowKind", "required": true },
          "path": { "type": "string", "default": "", "doc": "The property shape's `sh:path` in SHACL path syntax (`^p`, `a/b`, `a|b`, `p*`, `p+`, `p?`); empty for card-level rows and for a property shape without a path." },
          "name": { "type": "string", "default": "", "doc": "The first `sh:name` literal; carried to the grid, not drawn on the card." },
          "summary": { "type": "string", "default": "", "doc": "The constraint parameters in the fixed order of w3c-shacl.md, joined with ', '." },
          "cardinality": { "type": "string", "default": "", "doc": "`[min..max]`, 0 and * standing in for an absent `sh:minCount` or `sh:maxCount`; empty on card-level rows." },
          "sparql": { "type": "bool", "default": false, "doc": "The row carries an `sh:sparql` constraint, drawn opaque and never run." },
          "blank": { "type": "bool", "default": false, "doc": "The row's shape is a blank node: readable, never editable." },
          "severity": { "type": "string", "default": "", "doc": "A non-default `sh:severity` on the row's shape, as its display; carried but not drawn." },
          "shapeDisplay": { "type": "string", "default": "", "doc": "How findings name the row's property shape: its IRI display, or 'An anonymous shape'." },
          "pathCount": { "type": "int", "default": 1, "doc": "How many `sh:path` values the property shape states." },
          "minCount": { "type": "int", "default": -1, "doc": "The first `sh:minCount` integer; -1 when absent." },
          "maxCount": { "type": "int", "default": -1, "doc": "The first `sh:maxCount` integer; -1 when absent." },
          "hasDatatype": { "type": "bool", "default": false },
          "hasClass": { "type": "bool", "default": false }
        },
        "display": { "cel": "((value.sparql ? 'SPARQL constraint' : value.path) + '  ' + value.summary + '  ' + value.cardinality).trim()" }
      }
    },
    "enums": {
      "TargetKind": {
        "doc": "The four target predicates, plus the implicit class target of a shape the file states to be a class.",
        "values": {
          "class": { "label": "Target class", "doc": "`sh:targetClass`." },
          "node": { "label": "Target node", "doc": "`sh:targetNode`." },
          "subjectsOf": { "label": "Target subjects of", "doc": "`sh:targetSubjectsOf`." },
          "objectsOf": { "label": "Target objects of", "doc": "`sh:targetObjectsOf`." },
          "implicitClass": { "label": "Target (implicit)", "doc": "The shape is typed `rdfs:Class`, or typed with a class whose stated `rdfs:subClassOf` chain reaches `rdfs:Class`." }
        }
      },
      "RowKind": {
        "doc": "Where a row comes from.",
        "values": {
          "property": { "label": "Property shape", "doc": "One per `sh:property` object." },
          "combinator": { "label": "Combinator", "doc": "`sh:and`, `sh:or` or `sh:xone` stated on the card with at least one blank operand." },
          "not": { "label": "Negation", "doc": "`sh:not` stated on the card with a blank operand." },
          "sparql": { "label": "SPARQL constraint", "doc": "`sh:sparql` stated on the card." }
        }
      },
      "ReferenceKind": {
        "doc": "Which triple a reference edge stands for.",
        "values": {
          "node": { "doc": "`sh:node`, from the card or from one of its property rows." },
          "and": { "doc": "An IRI operand of `sh:and` on the card." },
          "or": { "doc": "An IRI operand of `sh:or` on the card." },
          "xone": { "doc": "An IRI operand of `sh:xone` on the card." },
          "not": { "doc": "An IRI operand of `sh:not` on the card." },
          "class": { "doc": "A property row's `sh:class`, where exactly one drawn card claims that class through `sh:targetClass` or its implicit target." }
        }
      }
    },
    "types": {
      "Shape": {
        "icon": "mdi:check-decagram-outline",
        "labelAttribute": "title",
        "doc": {
          "summary": "A card: an IRI-named node shape, an IRI-named property shape no card references, or a blank node shape that `sh:node` references or that is no operand at all.",
          "description": "Blank shapes living only inside a combinator, `sh:not` or `sh:qualifiedValueShape` are summarized inline in the referring row instead. Card flags come only from the card's own subject triples."
        },
        "attributes": {
          "iri": {
            "type": "uri", "key": true, "unique": "diagram", "readOnly": true, "label": "IRI", "group": "Identity",
            "doc": { "summary": "The shape's full IRI; empty for an anonymous shape, which the grid shows as '(anonymous)'.", "description": "Rename through the context menu, so every reference follows the name." }
          },
          "display": {
            "type": "string", "readOnly": true, "label": "Name", "group": "Identity",
            "doc": { "summary": "The IRI compressed with the file's own prefixes, else its last segment; `_:label` or 'anonymous shape' for a blank node.", "description": "Rename through the context menu, so every reference follows the name." }
          },
          "blank": { "type": "bool", "default": false, "readOnly": true, "doc": "The shape is a blank node: drawn, but never positioned or edited." },
          "isPropertyShape": { "type": "bool", "default": false, "readOnly": true, "doc": "The shape is the subject of an `sh:path` triple, the recommendation's own distinction." },
          "name": { "type": "string", "label": "sh:name", "group": "Shape", "doc": "The first `sh:name` literal. Editing rewrites its lexical form in place, or adds one." },
          "description": { "type": "string", "label": "sh:description", "group": "Shape", "doc": "The first `sh:description` literal. Editing rewrites its lexical form in place, or adds one." },
          "message": {
            "type": "string", "many": true, "readOnly": true, "label": "sh:message", "group": "Shape",
            "doc": { "summary": "Every `sh:message` literal's lexical form.", "description": "This is edited as triples in the graph reading." }
          },
          "deactivated": {
            "type": "bool", "default": false, "readOnly": true, "label": "Deactivated", "group": "Shape",
            "doc": { "summary": "An `sh:deactivated` literal whose lexical form is 'true'.", "description": "Switch the shape off and on through the context menu." }
          },
          "closed": {
            "type": "bool", "default": false, "readOnly": true, "label": "Closed", "group": "Shape",
            "doc": { "summary": "An `sh:closed` literal whose lexical form is 'true'.", "description": "This is edited as triples in the graph reading." }
          },
          "severity": {
            "type": "string", "default": "", "readOnly": true, "label": "Severity", "group": "Shape",
            "doc": { "summary": "A `sh:severity` other than `sh:Violation`, as its display; empty for the default.", "description": "This is edited as triples in the graph reading." }
          },
          "targets": {
            "type": "TargetChip", "many": true, "readOnly": true, "label": "Targets", "group": "Targets",
            "doc": { "summary": "One chip per target triple on the shape in source order, then the implicit class target where it applies.", "description": "Targets are declared and withdrawn through the context menu." }
          },
          "rows": {
            "type": "ConstraintRow", "many": true, "readOnly": true, "label": "Constraints", "group": "Constraints",
            "doc": { "summary": "The card's rows in the order of its own triples.", "description": "Property rows are added through the context menu, and edited as triples." }
          },
          "sparqlQueries": {
            "type": "text", "many": true, "readOnly": true, "label": "sh:select", "group": "Constraints",
            "doc": { "summary": "The first `sh:select` literal of each `sh:sparql` constraint on the shape.", "description": "Shown as written, never parsed beyond extraction and never executed - this reading draws constraints, it does not run them." }
          },
          "pathCount": { "type": "int", "default": 0, "readOnly": true, "doc": "How many `sh:path` values the card's own shape states." },
          "minCount": { "type": "int", "default": -1, "readOnly": true, "doc": "The card's own first `sh:minCount` integer; -1 when absent." },
          "maxCount": { "type": "int", "default": -1, "readOnly": true, "doc": "The card's own first `sh:maxCount` integer; -1 when absent." },
          "hasDatatype": { "type": "bool", "default": false, "readOnly": true },
          "hasClass": { "type": "bool", "default": false, "readOnly": true },
          "removalCount": {
            "type": "int", "default": 0, "readOnly": true,
            "doc": "The statements 'Remove shape' takes: the shape's own subject triples plus every triple of a blank subtree reachable only from it."
          },
          "title": {
            "type": "string",
            "derived": "self.name != '' ? self.display + ' — ' + self.name : self.display",
            "doc": "The card's title: the display, joined with `sh:name` when the shape has one."
          },
          "badges": {
            "type": "string",
            "derived": "[self.deactivated ? 'deactivated' : '', self.closed ? 'closed' : '', self.severity].filter(b, b != '').join(' · ')"
          }
        }
      }
    },
    "relations": {
      "Reference": {
        "label": "Reference",
        "doc": {
          "summary": "A shape-to-shape reference stated in the file, drawn between two drawn cards. Read-only: no gesture creates one.",
          "description": "Kept only when both ends are drawn cards, and at most one per (source, kind, target). A property row's `sh:node` and `sh:class` edges start at the card that holds the row and carry the row's path as their label. Targets never draw an edge, even when the targeted term is itself a drawn shape."
        },
        "source": { "types": [ "Shape" ], "role": "referrer" },
        "target": { "types": [ "Shape" ], "role": "referenced" },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true,
        "attributes": {
          "referenceKind": { "type": "ReferenceKind", "required": true, "readOnly": true },
          "label": { "type": "string", "readOnly": true, "doc": "The kind's name, or the referring row's path for a row-level `node` or `class` edge." }
        }
      }
    }
  },

  "notation": {
    "doc": "SHACL Play's UML-card convention in this repository's card idiom: a card per shape, targets as sentences under the title, one row per constraint. Colours come from the host's theme: the tokens copy standalone's theme variables (`src/client/src/index.css`), light and dark.",
    "theme": {
      "tokens": {
        "color.surface": "#ffffff",
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.border": "#e2e8f0",
        "color.node.outline": "#8892a6",
        "color.primary": "limegreen",
        "color.warning": "#b45309",
        "font.body": "system-ui, sans-serif",
        "font.mono": "ui-monospace, monospace"
      },
      "modes": {
        "dark": { "color.surface": "#1e293b", "color.text": "#f1f5f9", "color.text.muted": "#94a3b8", "color.border": "#334155", "color.warning": "#fbbf24" }
      },
      "followSystem": true
    },
    "styles": {
      "card": { "fill": { "token": "color.surface" }, "stroke": { "color": { "token": "color.border" }, "width": 1.5 }, "cornerRadius": 6, "font": { "size": 12, "color": { "token": "color.text" } } },
      "small": { "font": { "size": 10 } },
      "muted": { "extends": "small", "font": { "color": { "token": "color.text.muted" } } },
      "target": { "font": { "size": 11, "style": "italic", "color": { "token": "color.text" } }, "opacity": 0.85 },
      "row": { "font": { "size": 11, "color": { "token": "color.text" } } }
    },
    "nodes": {
      "Shape": {
        "shape": { "type": "roundedRect", "params": { "radius": 6 } },
        "style": "card",
        "size": { "width": 260, "height": { "cel": "56 + (size(self.targets) + size(self.rows)) * 22" }, "resizable": false },
        "labels": [
          { "id": "title", "text": { "cel": "self.title" }, "position": { "anchor": [ 0.5, 0 ], "offset": [ 0, 20 ] }, "overflow": "ellipsis", "maxLines": 1, "editable": false,
            "style": { "font": { "weight": 600 } } },
          { "id": "badges", "text": { "cel": "self.badges" }, "position": { "anchor": [ 1, 0 ], "offset": [ -8, 20 ], "align": "end" },
            "style": { "font": { "size": 11, "color": { "token": "color.text.muted" } } }, "visible": { "cel": "self.badges != ''" } }
        ],
        "compartments": [
          { "id": "targets",
            "items": { "attribute": "targets" },
            "itemText": { "cel": "item.kind == 'implicitClass' ? 'targets its own instances' : 'targets ' + {'class': 'class ', 'node': 'node ', 'subjectsOf': 'subjects of ', 'objectsOf': 'objects of '}[item.kind] + item.term" },
            "itemStyle": "target",
            "separator": "none",
            "overflow": "grow" },
          { "id": "rows",
            "items": { "attribute": "rows" },
            "itemText": { "cel": "((item.sparql ? 'SPARQL constraint' : item.path) + '   ' + item.summary + '   ' + item.cardinality).trim()" },
            "itemStyle": "row",
            "itemConditions": [ { "when": "item.sparql", "style": { "font": { "style": "italic" } } } ],
            "separator": "none",
            "overflow": "grow" }
        ],
        "anchors": { "mode": "outline" },
        "conditions": [
          { "when": "self.blank", "style": { "stroke": { "dash": [ 4, 3 ], "dashScale": "absolute" } }, "doc": "An anonymous shape draws like any other and simply cannot be moved; the dash says so without hiding it." },
          { "when": "self.deactivated", "style": { "opacity": 0.55 }, "doc": "A deactivated shape is dimmed rather than removed: a reader auditing shapes needs to see what is switched off." }
        ],
        "connectable": false,
        "doubleClick": "none",
        "tooltip": { "cel": "self.blank ? 'Anonymous shape' : self.iri" }
      }
    },
    "edges": {
      "Reference": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5 }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [ { "id": "label", "text": { "cel": "self.label" }, "at": "middle", "side": "above", "distance": 6, "editable": false,
          "style": { "font": { "size": 11, "color": { "token": "color.text.muted" } } } } ],
        "reconnectable": false,
        "deletable": false,
        "doc": "Every kind draws the same line; the label names the kind or the row's path."
      }
    },
    "canvas": {
      "watermark": { "id": "truncation", "text": { "cel": "'Showing ' + string(diagram.shown) + ' of ' + string(diagram.total) + ' shapes. Edits are withheld while the view is partial.'" }, "visible": { "cel": "diagram.truncated" } }
    }
  },

  "forms": {
    "shapeInspector": {
      "for": [ "Shape" ],
      "usage": [ "inspector" ],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "iri", "widget": "readonly" },
          { "attribute": "display", "widget": "readonly" }
        ] },
        { "kind": "section", "title": "Shape", "items": [
          { "attribute": "name", "widget": "text", "readOnly": { "cel": "self.blank || diagram.editsWithheld" } },
          { "attribute": "description", "widget": "text", "readOnly": { "cel": "self.blank || diagram.editsWithheld" } },
          { "attribute": "message", "widget": "readonly", "visible": "!self.blank && size(self.message) > 0" },
          { "attribute": "deactivated", "widget": "readonly" },
          { "attribute": "closed", "widget": "readonly", "visible": "self.closed" },
          { "attribute": "severity", "widget": "readonly", "visible": "self.severity != ''" }
        ] },
        { "kind": "section", "title": "Targets", "items": [
          { "attribute": "targets", "widget": "table" }
        ] },
        { "kind": "section", "title": "Constraints", "items": [
          { "attribute": "rows", "widget": "table" },
          { "attribute": "sparqlQueries", "widget": "code", "visible": "!self.blank && size(self.sparqlQueries) > 0" }
        ] },
        { "kind": "problems" }
      ]
    },
    "addNodeShapeDialog": {
      "for": "diagram",
      "usage": [ "create" ],
      "label": "Add node shape",
      "icon": "mdi:check-decagram-outline",
      "items": [ { "attribute": "iri", "placeholder": "Shape IRI or prefixed name" } ]
    },
    "addTargetClassDialog": {
      "for": [ "Shape" ],
      "usage": [ "popover" ],
      "label": "Add target class",
      "icon": "mdi:crosshairs",
      "items": [ { "attribute": "term", "placeholder": "Class IRI or prefixed name" } ]
    },
    "addTargetNodeDialog": {
      "for": [ "Shape" ],
      "usage": [ "popover" ],
      "label": "Add target node",
      "icon": "mdi:crosshairs-gps",
      "items": [ { "attribute": "term", "placeholder": "Node IRI or prefixed name" } ]
    },
    "addPropertyRowDialog": {
      "for": [ "Shape" ],
      "usage": [ "popover" ],
      "label": "Add property row",
      "icon": "mdi:table-row-plus-after",
      "items": [ { "attribute": "path", "placeholder": "Path IRI or prefixed name" } ]
    },
    "removeTargetDialog": {
      "for": [ "Shape" ],
      "usage": [ "popover" ],
      "label": "Remove target",
      "icon": "mdi:crosshairs-off",
      "items": [ { "attribute": "target", "widget": "select", "options": { "cel": "self.targets.filter(t, t.predicateIri != '' && t.termIri != '')" } } ]
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      { "id": "shapes", "label": "SHACL", "tools": [
        { "id": "nodeShape", "kind": "operation", "operation": "addNodeShape", "label": "Node shape", "icon": "mdi:check-decagram-outline",
          "enabled": "!diagram.editsWithheld",
          "doc": "A shape that constrains focus nodes. Drop it where it should sit; you will be asked for its name." },
        { "id": "propertyRow", "kind": "operation", "operation": "addPropertyRow", "label": "Property row", "icon": "mdi:table-row-plus-after",
          "enabled": "!diagram.editsWithheld",
          "doc": "A constraint on the values reached over one path. Drop it on a shape; you will be asked for the path." }
      ] }
    ],
    "contextMenus": [
      { "for": [ "Shape" ], "placement": "menu", "tools": [
        { "kind": "operation", "operation": "addTargetClass", "label": "Add target class…", "icon": "mdi:crosshairs" },
        { "kind": "operation", "operation": "addTargetNode", "label": "Add target node…", "icon": "mdi:crosshairs-gps" },
        { "kind": "operation", "operation": "addPropertyRow", "label": "Add property row…", "icon": "mdi:table-row-plus-after" },
        { "kind": "operation", "operation": "deactivate", "label": "Deactivate shape", "icon": "mdi:pause-circle-outline" },
        { "kind": "operation", "operation": "reactivate", "label": "Reactivate shape", "icon": "mdi:play-circle-outline" },
        { "kind": "operation", "operation": "removeTarget", "label": "Remove target", "icon": "mdi:crosshairs-off" },
        { "kind": "operation", "operation": "rename", "label": "Rename…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
        { "kind": "operation", "operation": "removeShape", "label": "Remove shape", "icon": "mdi:delete-outline", "shortcut": "Delete" }
      ] }
    ]
  },

  "constraints": {
    "doc": "Facts about the shapes file, never about data: no data graph is loaded, nothing is run, and nothing outside the file is read. Parse failures are reported by the Turtle plugin as one finding that replaces all of these; the family's own findings (duplicate prefix, relative IRI, language tag, unknown datatype) pass through from it unchanged.",
    "rules": [
      { "id": "pathCardinality", "label": "Property shape without exactly one path", "scope": "Shape",
        "rule": "self.rows.all(r, r.kind != 'property' || r.pathCount == 1)", "severity": "error",
        "message": { "cel": "self.rows.filter(r, r.kind == 'property' && r.pathCount != 1)[0].pathCount == 0 ? self.rows.filter(r, r.kind == 'property' && r.pathCount == 0)[0].shapeDisplay + ' is used as a property shape but states no sh:path; SHACL requires exactly one, and the row is drawn with an empty path.' : self.rows.filter(r, r.kind == 'property' && r.pathCount > 1)[0].shapeDisplay + ' states ' + string(self.rows.filter(r, r.kind == 'property' && r.pathCount > 1)[0].pathCount) + ' sh:path values; SHACL requires exactly one, so which values it constrains is undefined.'" },
        "doc": { "summary": "shacl.path-cardinality", "rationale": "The recommendation requires exactly one sh:path on a property shape. Only shapes used as the object of sh:property are checked." } },
      { "id": "impossibleCounts", "label": "Impossible counts", "scope": "Shape",
        "rule": "self.minCount < 0 || self.maxCount < 0 || self.minCount <= self.maxCount", "severity": "warning", "attribute": "rows",
        "message": { "cel": "(self.blank ? 'An anonymous shape' : self.display) + ' requires at least ' + string(self.minCount) + ' values and at most ' + string(self.maxCount) + ', so nothing can ever conform to it.'" },
        "doc": "shacl.impossible-counts, on the card's own shape." },
      { "id": "impossibleRowCounts", "label": "Impossible counts", "scope": "Shape",
        "rule": "self.rows.all(r, r.minCount < 0 || r.maxCount < 0 || r.minCount <= r.maxCount)", "severity": "warning", "attribute": "rows",
        "message": { "cel": "self.rows.filter(r, r.minCount >= 0 && r.maxCount >= 0 && r.minCount > r.maxCount)[0].shapeDisplay + ' requires at least ' + string(self.rows.filter(r, r.minCount >= 0 && r.maxCount >= 0 && r.minCount > r.maxCount)[0].minCount) + ' values and at most ' + string(self.rows.filter(r, r.minCount >= 0 && r.maxCount >= 0 && r.minCount > r.maxCount)[0].maxCount) + ', so nothing can ever conform to it.'" },
        "doc": "shacl.impossible-counts, on a property shape drawn as a row." },
      { "id": "datatypeAndClass", "label": "Datatype and class", "scope": "Shape",
        "rule": "!(self.hasDatatype && self.hasClass)", "severity": "warning",
        "message": { "cel": "(self.blank ? 'An anonymous shape' : self.display) + ' constrains its values by both sh:datatype and sh:class, and no value is both a literal and an instance of a class, so nothing can conform.'" },
        "doc": "shacl.datatype-and-class, on the card's own shape." },
      { "id": "datatypeAndClassInRow", "label": "Datatype and class", "scope": "Shape",
        "rule": "self.rows.all(r, !(r.hasDatatype && r.hasClass))", "severity": "warning", "attribute": "rows",
        "message": { "cel": "self.rows.filter(r, r.hasDatatype && r.hasClass)[0].shapeDisplay + ' constrains its values by both sh:datatype and sh:class, and no value is both a literal and an instance of a class, so nothing can conform.'" },
        "doc": "shacl.datatype-and-class, on a property shape drawn as a row." },
      { "id": "referenceLeavesFile", "label": "Reference leaves the file", "scope": "diagram",
        "rule": "size(diagram.externalReferences) == 0", "severity": "info",
        "message": { "cel": "diagram.externalReferences[0] + ' is referenced as a shape but not described in this file - it is defined elsewhere, or missing. Nothing outside the file is read to find out.'" },
        "doc": { "summary": "shacl.reference-leaves-file", "rationale": "Info, not warning: with no network this tool cannot tell 'missing' from 'described in another file'. A target naming an absent term is never a finding." } },
      { "id": "unknownTerm", "label": "Unknown SHACL term", "scope": "diagram",
        "rule": "size(diagram.unknownTerms) == 0", "severity": "warning",
        "message": { "cel": "'sh:' + diagram.unknownTerms[0] + ' is not a term SHACL defines, so no processor will act on it - check the spelling.'" },
        "doc": { "summary": "shacl.unknown-term", "rationale": "The typo that silently disables a constraint is this format's classic failure." } },
      { "id": "referencesAreRead", "kind": "connect",
        "rule": "false",
        "message": "A reference between shapes is stated in the file as a triple, so it is drawn rather than drawn-on; write it as text." },
      { "id": "blankNotPositioned", "kind": "placement", "scope": "Shape",
        "rule": "!self.blank",
        "message": "This constraint is written as a blank node, which has no identity that survives a reparse, so an edit keyed to it could not be undone reliably. Open the file as text to change it, or give the shape an IRI of its own." },
      { "id": "noReparentByDrag", "kind": "placement", "scope": "Shape",
        "rule": "newParent == self.parent",
        "message": "A shape is not held inside another shape; a reference between them is stated as a triple. Dragging changes where a card sits on the canvas." },
      { "id": "blankChange", "kind": "change", "scope": "Shape",
        "rule": "!self.blank",
        "message": "This constraint is written as a blank node, which has no identity that survives a reparse, so an edit keyed to it could not be undone reliably. Open the file as text to change it, or give the shape an IRI of its own." },
      { "id": "blankDelete", "kind": "delete", "scope": "Shape",
        "rule": "!self.blank",
        "message": "This constraint is written as a blank node, which has no identity that survives a reparse, so an edit keyed to it could not be undone reliably. Open the file as text to change it, or give the shape an IRI of its own." },
      { "id": "truncatedCreate", "kind": "create", "rule": "!diagram.editsWithheld",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedDelete", "kind": "delete", "rule": "!diagram.editsWithheld",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedChange", "kind": "change", "rule": "!diagram.editsWithheld",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." }
    ]
  },

  "behavior": {
    "operations": {
      "addNodeShape": {
        "label": "Add node shape here…",
        "icon": "mdi:check-decagram-outline",
        "for": "diagram",
        "doc": "Writes one `rdf:type sh:NodeShape` triple for the named IRI: a new statement at the end of the file, or a continuation of the subject's last statement when the IRI already has one.",
        "params": { "iri": { "type": "string", "label": "Shape IRI or prefixed name", "required": true } },
        "paramsForm": "addNodeShapeDialog",
        "enabled": "!diagram.editsWithheld",
        "actions": [
          { "let": { "term": "rdfResolveTerm(p.iri.trim())" } },
          { "if": "term == ''", "then": [ { "abort": { "message": "rdfTermRefusal(p.iri.trim())" } } ] },
          { "create": { "type": "'Shape'", "attributes": { "iri": "term" } }, "as": "shape" },
          { "select": "shape" }
        ]
      },
      "addTargetClass": {
        "label": "Add target class…",
        "icon": "mdi:crosshairs",
        "for": [ "Shape" ],
        "doc": "Splices exactly one `sh:targetClass` triple onto the shape's statement. Duplicates are not checked.",
        "params": { "term": { "type": "string", "label": "Class IRI or prefixed name", "required": true } },
        "paramsForm": "addTargetClassDialog",
        "enabled": "!self.blank && !diagram.editsWithheld",
        "actions": [
          { "let": { "term": "rdfResolveTerm(p.term.trim())" } },
          { "if": "term == ''", "then": [ { "abort": { "message": "rdfTermRefusal(p.term.trim())" } } ] },
          { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'addTarget'", "shape": "self.iri", "predicate": "'http://www.w3.org/ns/shacl#targetClass'", "term": "term" } }
        ]
      },
      "addTargetNode": {
        "label": "Add target node…",
        "icon": "mdi:crosshairs-gps",
        "for": [ "Shape" ],
        "doc": "Splices exactly one `sh:targetNode` triple onto the shape's statement, always with an IRI object.",
        "params": { "term": { "type": "string", "label": "Node IRI or prefixed name", "required": true } },
        "paramsForm": "addTargetNodeDialog",
        "enabled": "!self.blank && !diagram.editsWithheld",
        "actions": [
          { "let": { "term": "rdfResolveTerm(p.term.trim())" } },
          { "if": "term == ''", "then": [ { "abort": { "message": "rdfTermRefusal(p.term.trim())" } } ] },
          { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'addTarget'", "shape": "self.iri", "predicate": "'http://www.w3.org/ns/shacl#targetNode'", "term": "term" } }
        ]
      },
      "addPropertyRow": {
        "label": "Add property row…",
        "icon": "mdi:table-row-plus-after",
        "for": [ "Shape" ],
        "doc": "Splices one `sh:property [ sh:path P ]` block into the shape's statement, on its own line, in the statement's indentation and with the file's own prefixes. The blank node is created, never addressed, which is why this edit is permitted under the blank-node boundary.",
        "params": { "path": { "type": "string", "label": "Path IRI or prefixed name", "required": true } },
        "paramsForm": "addPropertyRowDialog",
        "enabled": "!self.blank && !diagram.editsWithheld",
        "actions": [
          { "let": { "path": "rdfResolveTerm(p.path.trim())" } },
          { "if": "path == ''", "then": [ { "abort": { "message": "rdfTermRefusal(p.path.trim())" } } ] },
          { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'appendPropertyShape'", "shape": "self.iri", "path": "path" } }
        ]
      },
      "deactivate": {
        "label": "Deactivate shape",
        "icon": "mdi:pause-circle-outline",
        "for": [ "Shape" ],
        "doc": "Adds `sh:deactivated \"true\"^^xsd:boolean`; a no-op when any `sh:deactivated` triple already exists.",
        "enabled": "!self.deactivated && !self.blank && !diagram.editsWithheld",
        "actions": [ { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'setDeactivated'", "shape": "self.iri", "deactivated": "true" } } ]
      },
      "reactivate": {
        "label": "Reactivate shape",
        "icon": "mdi:play-circle-outline",
        "for": [ "Shape" ],
        "doc": "Removes the first `sh:deactivated` triple, whatever its value; a no-op when there is none.",
        "enabled": "self.deactivated && !self.blank && !diagram.editsWithheld",
        "actions": [ { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'setDeactivated'", "shape": "self.iri", "deactivated": "false" } } ]
      },
      "removeTarget": {
        "label": "Remove target",
        "icon": "mdi:crosshairs-off",
        "for": [ "Shape" ],
        "doc": "Removes exactly the first (shape, predicate, IRI term) target triple. Literal and blank targets, and the implicit class target, cannot be removed here.",
        "params": { "target": { "type": "TargetChip", "label": "Target", "required": true } },
        "paramsForm": "removeTargetDialog",
        "enabled": "!self.blank && !diagram.editsWithheld && self.targets.exists(t, t.predicateIri != '' && t.termIri != '')",
        "actions": [
          { "if": "p.target.predicateIri == ''", "then": [ { "abort": { "message": "'This shape targets its own instances because the file states it to be a class, not through a target triple, so there is no declaration to remove. Remove the class typing instead, as text.'" } } ] },
          { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'removeTarget'", "shape": "self.iri", "predicate": "p.target.predicateIri", "term": "p.target.termIri" } }
        ]
      },
      "removeShape": {
        "label": "Remove shape",
        "icon": "mdi:delete-outline",
        "shortcut": "Delete",
        "for": [ "Shape" ],
        "doc": "Removes the shape's own subject triples and every blank subtree reachable only from it, as one undo. Triples naming the shape as their object stay.",
        "enabled": "!self.blank && !diagram.editsWithheld",
        "actions": [ { "plugin": "net.etalii.adp.w3c.turtle", "args": { "action": "'removeShapeWithSubtrees'", "shape": "self.iri" } } ]
      },
      "rename": {
        "label": "Rename…",
        "icon": "mdi:pencil-outline",
        "shortcut": "F2",
        "for": [ "Shape" ],
        "enabled": "!self.blank && !diagram.editsWithheld",
        "params": { "newName": { "type": "string", "label": "New IRI or prefixed name", "required": true } },
        "doc": "The family rename: rewrites every occurrence of the IRI - subject, predicate and object positions, prefixed or full - as one command; a collision is refused before anything is written.",
        "plugin": { "name": "net.etalii.adp.w3c.turtle", "args": { "action": "renameTerm" } }
      }
    },
    "deletion": {
      "Shape": { "relations": "delete", "doc": "Deleting a card runs removeShape: the references it states go with it, references to it from other shapes stay in the file and stop drawing." }
    },
    "undo": { "mergeWindowMs": 0 }
  },

  "layout": {
    "doc": "Pure and deterministic, no physics: the same file always opens the same way. Authored positions from the registration override computed ones card by card; anonymous cards always take their computed place.",
    "algorithms": {
      "shapeGrid": {
        "algorithm": "plugin:net.etalii.adp.w3c.shaclGrid",
        "spacing": { "node": 60, "layer": 48 },
        "options": { "columns": 3, "columnPitch": 320, "headerHeight": 64, "lineHeight": 22, "rowGap": 48 },
        "doc": "Cards in discovery order fill three columns left to right; each grid row is as tall as its tallest card."
      },
      "fallback": {
        "algorithm": "grid",
        "spacing": { "node": 60, "layer": 48 },
        "options": { "columns": 3 },
        "doc": "What a runtime without the plugin uses: a three-column grid in persistence order."
      }
    },
    "default": "shapeGrid",
    "trigger": "onLoadIfMissing",
    "respect": "all"
  },

  "persistence": {
    "doc": "The shapes graph's own Turtle or N-Triples file is the model; ADP writes only minimal splices into it. Positions live in the `.adp` registration's `layout:` block, keyed by element id, and nothing of ADP's is ever written into the RDF.",
    "format": "plugin:net.etalii.adp.w3c.turtle",
    "files": { "mode": "split", "model": "{name}.ttl", "view": "{name}.adp" },
    "ids": { "strategy": "natural", "stable": false, "pattern": "^(res:.+|blank:[0-9]+|shacl-edge:.+)$" },
    "view": { "store": [ "bounds" ], "styleOverrides": "none" },
    "import": [ { "format": "plugin:net.etalii.adp.w3c.turtle", "label": "N-Triples (.nt)" } ]
  },

  "plugins": {
    "net.etalii.adp.w3c.turtle": {
      "version": "^0.1.0",
      "provides": [ "persistenceFormat", "import", "action", "celFunctions" ],
      "required": true,
      "doc": "The RDF family's shared engine: one store per file parsing Turtle and N-Triples into triples plus a line-level concrete syntax, byte-identical round trips, edits as minimal splices, the drawn-element budget, and the projection of triples onto this specification's elements. Shared with the w3c/rdf, w3c/owl and w3c/skos specifications.",
      "celFunctions": [
        {"name": "rdfLocalName", "params": ["string"], "returns": "string", "cost": 1, "doc": "The part of an IRI after its last '#' or '/', or the whole IRI."},
        {"name": "rdfMintIri", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI for a new resource: the label slugged to [A-Za-z0-9_-] under the namespace of the file's first prefixed subject, else its first declared prefix; '' when neither exists or nothing usable is left."},
        {"name": "rdfMintRefusal", "params": ["string"], "returns": "string", "cost": 10, "doc": "The sentence explaining why rdfMintIri returned ''."},
        {"name": "rdfTermExists", "params": ["string"], "returns": "bool", "cost": 10, "doc": "The IRI appears as a subject or object anywhere in the file."},
        {"name": "rdfCompress", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI as the writer spells it: `prefix:local` under the longest declared namespace whose remainder is a clean local name, else the bracketed `<iri>`."},
        {"name": "rdfDisplayName", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI as drawn: rdfCompress's prefixed name when there is one, else rdfLocalName when it is not empty, else the whole IRI unbracketed."},
        {"name": "rdfResolveTerm", "params": ["string"], "returns": "string", "cost": 10, "doc": "The full IRI a typed term names: a bracketed `<iri>`, a text containing '://', or `prefix:local` under a declared prefix; '' when it names nothing."},
        {"name": "rdfTermRefusal", "params": ["string"], "returns": "string", "cost": 10, "doc": "The sentence explaining why rdfResolveTerm returned ''."}
      ]
    },
    "net.etalii.adp.w3c.shaclGrid": {
      "version": "^1.0.0",
      "provides": [ "layout" ],
      "required": false,
      "fallback": { "layout": "grid" },
      "doc": "The shapes grid: three columns in discovery order, grid rows as tall as their tallest card; see w3c-shacl.md."
    }
  },

  "x-adp": {
    "origin": "w3c/shacl",
    "state": "implemented",
    "extensions": [ ".ttl", ".nt" ],
    "claimsBareFiles": false,
    "suggestWhenBodyContains": [ "sh:NodeShape", "sh:property", "http://www.w3.org/ns/shacl#NodeShape" ],
    "family": [ "w3c/rdf", "w3c/owl", "w3c/skos", "w3c/shacl" ],
    "implementations": { "standalone": "etalii.adp.ide.standalone src/diagrams/rdf (Shacl/)" }
  }
}
