{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.w3c.skos",
    "version": "0.1.0",
    "label": "SKOS concept scheme",
    "icon": "mdi:file-tree",
    "fileExtension": "ttl",
    "license": "Apache-2.0",
    "homepage": "https://www.w3.org/TR/skos-reference/",
    "authors": [ { "name": "Peter Vrenken" } ],
    "limits": { "maxElements": 1000 },
    "requires": { "conformance": "standard" },
    "doc": {
      "summary": "A thesaurus or controlled vocabulary: concepts under their schemes, broader and narrower drawn as a hierarchy, related links across it.",
      "description": "A reading of a SKOS vocabulary stored as Turtle (`.ttl`) or N-Triples (`.nt`). Every concept scheme, concept and collection the file *asserts* is drawn: schemes head their bands, concepts sit in layers below their broader concepts, `skos:related` and in-file mapping links cross the hierarchy. Nothing is inferred: an edge exists because a triple states it, and the inverse of `skos:broader` is never written back.\n\nThe diagram is stored in the vocabulary's own file, which other tools own; ADP writes only minimal splices into it, and keeps positions in the `.adp` registration beside it. What this specification cannot express - the triple projection, the label chooser's tie-breaks, the splice discipline, the registration header - is written down in `w3c-skos.md` beside this file.",
      "tags": [ "skos", "thesaurus", "taxonomy", "controlled vocabulary", "rdf", "semantic web" ],
      "seeAlso": [
        { "title": "W3C SKOS reference", "href": "https://www.w3.org/TR/skos-reference/" },
        { "title": "SKOS Play", "href": "https://skos-play.sparna.fr/" }
      ]
    }
  },

  "functions": {
    "textsIn": {
      "params": [ { "name": "labels", "type": "list(LangString)" }, { "name": "tag", "type": "string" } ],
      "returns": "list(string)",
      "cel": "labels.filter(l, l.language == tag).map(l, l.text).sort()",
      "doc": "The texts of the labels carrying exactly one language tag ('' for untagged), ordinally sorted, so the first one is the S14 tie-break."
    },
    "tagFor": {
      "params": [ { "name": "labels", "type": "list(LangString)" }, { "name": "display", "type": "string" } ],
      "returns": "string",
      "cel": "size(textsIn(labels, display)) > 0 ? display : (size(textsIn(labels, 'en')) > 0 ? 'en' : (size(textsIn(labels, '')) > 0 ? '' : (size(labels) > 0 ? labels.map(l, l.language).filter(t, t != '').sort()[0] : '')))",
      "doc": "The language tag the chooser settles on within one label kind: the display language, then English, then untagged, then the ordinally smallest remaining tag."
    },
    "chooseLabel": {
      "params": [
        { "name": "pref", "type": "list(LangString)" },
        { "name": "alt", "type": "list(LangString)" },
        { "name": "display", "type": "string" },
        { "name": "fallback", "type": "string" }
      ],
      "returns": "string",
      "cel": "size(pref) > 0 ? textsIn(pref, tagFor(pref, display))[0] : (size(alt) > 0 ? textsIn(alt, tagFor(alt, display))[0] : fallback)",
      "doc": "The one name a scheme, concept or collection is drawn with: a preferred label in any language beats every alternate label; the IRI's local name stands in when neither exists. Hidden labels never display."
    },
    "chosenTag": {
      "params": [
        { "name": "pref", "type": "list(LangString)" },
        { "name": "alt", "type": "list(LangString)" },
        { "name": "display", "type": "string" }
      ],
      "returns": "string",
      "cel": "size(pref) > 0 ? tagFor(pref, display) : (size(alt) > 0 ? tagFor(alt, display) : '')",
      "doc": "The language tag of the chosen label, or '' for an untagged label or the IRI fallback."
    }
  },

  "metamodel": {
    "doc": "Only resources the file types `skos:ConceptScheme`, `skos:Concept`, `skos:Collection` or `skos:OrderedCollection` become elements. Typing is read from `rdf:type` triples with an IRI object and never inferred.",
    "diagram": {
      "attributes": {
        "language": {
          "type": "string", "default": "en", "readOnly": true, "pattern": "^[a-z]{2,8}(-[a-z0-9]{1,8})*$",
          "doc": "The display language labels are chosen in. Read from the registration's `language:` header, lower-cased; English when absent."
        },
        "languageHeaderLine": {
          "type": "int", "default": 0, "readOnly": true,
          "doc": "The registration line of a `language:` header placed above `body:` or `view:`, where it is ignored; 0 when the header is absent or well placed."
        },
        "usesSkosXl": {
          "type": "bool", "default": false, "readOnly": true,
          "doc": "The file labels something through SKOS-XL (`skosxl:prefLabel`, `altLabel`, `hiddenLabel`), which this reading detects but never resolves."
        },
        "truncated": {
          "type": "bool", "default": false, "readOnly": true,
          "doc": "The file holds more than the drawn-element budget; edits through the diagram are withheld."
        },
        "shown": { "type": "int", "readOnly": true, "doc": "Elements drawn under the budget." },
        "total": { "type": "int", "readOnly": true, "doc": "Schemes, concepts and collections the file asserts." }
      }
    },
    "dataTypes": {
      "LangString": {
        "doc": "One label literal: its lexical form and its language tag, lower-cased, '' when untagged.",
        "fields": {
          "text": { "type": "string", "required": true },
          "language": { "type": "string", "default": "" }
        },
        "display": { "cel": "value.language == '' ? value.text : value.text + ' @' + value.language" }
      },
      "OutOfFileMapping": {
        "doc": "A mapping triple whose object is not a concept this file types, shown in the property grid rather than drawn.",
        "fields": {
          "predicate": { "type": "MappingKind", "required": true },
          "target": { "type": "uri", "required": true }
        },
        "display": { "cel": "value.predicate + ' ' + value.target" }
      }
    },
    "enums": {
      "LabelKind": {
        "doc": "Which kind of label the drawn name came from.",
        "values": {
          "preferred": { "label": "Preferred label" },
          "alternate": { "label": "Alternate label", "doc": "No prefLabel exists in any language, so an altLabel stands in." },
          "iriFallback": { "label": "IRI", "doc": "No prefLabel or altLabel exists, so the IRI's local name stands in." }
        }
      },
      "MappingKind": {
        "doc": "The five SKOS mapping properties.",
        "values": {
          "exactMatch": {}, "closeMatch": {}, "broadMatch": {}, "narrowMatch": {}, "relatedMatch": {}
        }
      }
    },
    "types": {
      "Labelled": {
        "abstract": true,
        "doc": "What schemes, concepts and collections share: an IRI, their labels, notations and documentation properties.",
        "labelAttribute": "label",
        "attributes": {
          "iri": {
            "type": "uri", "key": true, "unique": "diagram", "readOnly": true, "label": "IRI", "group": "Identity",
            "doc": { "summary": "The resource's IRI; empty for a blank node.", "description": "Rename through the context menu, so every reference follows the name." }
          },
          "blank": { "type": "bool", "default": false, "readOnly": true, "doc": "The resource is a blank node: drawn, but never positioned or edited." },
          "prefLabel": { "type": "LangString", "many": true, "label": "Preferred", "group": "Labels", "doc": "`skos:prefLabel` literals. Editable per language." },
          "altLabel": { "type": "LangString", "many": true, "readOnly": true, "label": "Alternate", "group": "Labels", "doc": "`skos:altLabel` literals. Alternate and hidden labels are edited as triples." },
          "hiddenLabel": { "type": "LangString", "many": true, "readOnly": true, "label": "Hidden", "group": "Labels", "doc": "`skos:hiddenLabel` literals; never displayed." },
          "xlLabelled": { "type": "bool", "default": false, "readOnly": true, "doc": "Labelled through SKOS-XL, which this reading does not resolve; preferred labels then refuse edits." },
          "notation": {
            "type": "string", "many": true, "readOnly": true, "group": "Identity",
            "doc": { "summary": "`skos:notation` codes in document order; the first is badged on the canvas.", "description": "Notations are codes other systems key off; edit them as triples." }
          },
          "definition": { "type": "text", "group": "Documentation", "doc": "The first `skos:definition` literal, in any language." },
          "scopeNote": { "type": "text", "group": "Documentation" },
          "example": { "type": "text", "group": "Documentation" },
          "note": { "type": "text", "group": "Documentation" },
          "historyNote": { "type": "text", "group": "Documentation" },
          "editorialNote": { "type": "text", "group": "Documentation" },
          "changeNote": { "type": "text", "group": "Documentation" },
          "label": {
            "type": "string",
            "derived": "chooseLabel(self.prefLabel, self.altLabel, diagram.language, self.blank ? '' : rdfLocalName(self.iri))",
            "doc": "The drawn name, chosen by the label chooser; never recomputed from anything but the file."
          },
          "labelTag": { "type": "string", "derived": "chosenTag(self.prefLabel, self.altLabel, diagram.language)" },
          "labelKind": {
            "type": "LabelKind",
            "derived": "size(self.prefLabel) > 0 ? 'preferred' : (size(self.altLabel) > 0 ? 'alternate' : 'iriFallback')"
          }
        }
      },
      "ConceptScheme": {
        "extends": "Labelled",
        "icon": "mdi:file-tree",
        "doc": { "summary": "A `skos:ConceptScheme`: the head of a band holding the concepts filed in it.", "rationale": "One registration draws every scheme in the file, each as its own band." },
        "attributes": {
          "topConcepts": {
            "type": "Concept", "many": true, "readOnly": true, "group": "Membership",
            "doc": "Objects of `skos:hasTopConcept` from the scheme plus subjects of `skos:topConceptOf` to it, in document order."
          },
          "memberCount": {
            "type": "int", "label": "Members",
            "derived": "diagram.nodesOfType('Concept').filter(c, self in c.inScheme).size()"
          }
        }
      },
      "Concept": {
        "extends": "Labelled",
        "icon": "mdi:tag-outline",
        "doc": { "summary": "A `skos:Concept`, drawn once however many broader concepts it has.", "description": "A polyhierarchical concept is placed once, below its deepest broader concept, with one hierarchy edge per parent." },
        "attributes": {
          "inScheme": {
            "type": "ConceptScheme", "many": true, "readOnly": true, "label": "In schemes", "group": "Membership",
            "doc": { "summary": "Schemes named by `skos:inScheme`, `skos:topConceptOf` or a scheme's `skos:hasTopConcept`, restricted to IRIs the file types as schemes.", "description": "Membership is stated by triples; file and unfile concepts on the canvas." }
          },
          "mappings": {
            "type": "OutOfFileMapping", "many": true, "readOnly": true, "group": "Mappings",
            "doc": "The mapped concept lives outside this file, so the mapping shows here rather than drawing."
          },
          "languageChip": {
            "type": "bool",
            "derived": "self.labelTag != '' && self.labelTag != diagram.language",
            "doc": "The chosen label is in another language than the display language, so the node wears the tag."
          }
        },
        "ports": {
          "file": { "label": "File under", "direction": "out", "accepts": [ "Broader" ], "doc": "Dragging from here files this concept under the one dropped on." },
          "relate": { "label": "Relate", "direction": "inout", "accepts": [ "Related" ], "doc": "Dragging from here relates this concept to the one dropped on." }
        }
      },
      "Collection": {
        "extends": "Labelled",
        "icon": "mdi:format-list-bulleted",
        "doc": { "summary": "A `skos:Collection` or `skos:OrderedCollection`: a labelled grouping, never part of the hierarchy (SKOS S13's disjoint families)." },
        "attributes": {
          "ordered": { "type": "bool", "default": false, "readOnly": true, "doc": "Typed `skos:OrderedCollection`; members come from the `skos:memberList` RDF list in list order." },
          "members": { "type": "Concept", "many": true, "readOnly": true, "group": "Membership", "doc": "`skos:member` objects in document order, or the `skos:memberList` walk for an ordered collection." }
        }
      }
    },
    "relations": {
      "Broader": {
        "label": "Hierarchy",
        "doc": {
          "summary": "One edge per (narrower, broader) pair, whether the file states `skos:broader`, `skos:narrower` or both.",
          "description": "The source is the narrower concept (the subject of `skos:broader`), the target the broader. The inverse is never synthesised and never written. Drawn without an arrowhead: the layering carries the direction."
        },
        "source": { "types": [ "Concept" ], "ports": [ "file" ], "role": "narrower" },
        "target": { "types": [ "Concept" ], "role": "broader" },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "attributes": {
          "assertedBothWays": { "type": "bool", "default": false, "readOnly": true, "doc": "The pair is stated by more than one triple (both directions, or repeated); disconnecting removes them all as one undo." }
        }
      },
      "Related": {
        "label": "Related",
        "doc": "`skos:related` between two concepts, in either direction; does not affect layering.",
        "source": { "types": [ "Concept" ], "ports": [ "relate" ] },
        "target": { "types": [ "Concept" ] },
        "directed": false,
        "allowSelfLoops": false,
        "allowParallel": false,
        "attributes": {
          "assertedBothWays": { "type": "bool", "default": false, "readOnly": true }
        }
      },
      "Mapping": {
        "label": "Mapping",
        "doc": "A mapping triple whose subject and object are both concepts typed in this file; one edge per triple. Read-only: no gesture creates one.",
        "source": { "types": [ "Concept" ] },
        "target": { "types": [ "Concept" ] },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "predicate": { "type": "MappingKind", "required": true, "readOnly": true }
        }
      }
    }
  },

  "notation": {
    "doc": "Concepts are plain boxes, not VOWL circles; schemes and collections are unfilled header boxes. Colours come from the host's theme: the tokens copy standalone's theme variables (`src/client/src/index.css`), light and dark.",
    "theme": {
      "tokens": {
        "color.surface": "#ffffff",
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.border": "#e2e8f0",
        "color.node.outline": "#8892a6",
        "color.primary": "limegreen",
        "color.warning": "#b45309",
        "font.body": "system-ui, sans-serif",
        "font.mono": "ui-monospace, monospace"
      },
      "modes": {
        "dark": { "color.surface": "#1e293b", "color.text": "#f1f5f9", "color.text.muted": "#94a3b8", "color.border": "#334155", "color.warning": "#fbbf24" }
      },
      "followSystem": true
    },
    "styles": {
      "node": { "fill": { "token": "color.surface" }, "stroke": { "color": { "token": "color.border" }, "width": 1.5 }, "font": { "size": 12, "color": { "token": "color.text" } } },
      "region": { "extends": "node", "fill": "none" },
      "small": { "font": { "size": 10 } },
      "muted": { "extends": "small", "font": { "color": { "token": "color.text.muted" } } }
    },
    "nodes": {
      "Concept": {
        "shape": "rect",
        "style": "node",
        "size": { "fixed": [ 200, 44 ] },
        "labels": [
          { "id": "name", "text": { "cel": "self.label" }, "position": { "anchor": [ 0.5, 0.68 ] }, "overflow": "ellipsis", "maxLines": 1, "editable": false },
          { "id": "notation", "text": { "cel": "size(self.notation) > 0 ? self.notation[0] : ''" }, "position": { "anchor": [ 0, 0 ], "offset": [ 8, 14 ], "align": "start" },
            "style": { "extends": "small", "font": { "color": { "token": "color.primary" } } }, "visible": { "cel": "size(self.notation) > 0" } },
          { "id": "chip", "text": { "cel": "self.labelTag" }, "position": { "anchor": [ 1, 0 ], "offset": [ -8, 14 ], "align": "end" },
            "style": "muted", "visible": { "cel": "self.languageChip" }, "tooltip": "The chosen label is in another language than the display language." }
        ],
        "ports": {
          "file": { "shape": "none", "side": "top", "position": 0.5 },
          "relate": { "shape": "none", "side": "right", "position": 0.5 }
        },
        "conditions": [
          { "when": "self.labelKind == 'alternate'", "style": { "font": { "style": "italic" } }, "doc": "An alternate label stands in: italic." },
          { "when": "self.labelKind == 'iriFallback'", "style": { "font": { "family": { "token": "font.mono" }, "size": 11 }, "opacity": 0.7 }, "doc": "The IRI stands in: dimmed monospace." },
          { "when": "self.blank", "style": { "stroke": { "dash": [ 5, 3 ], "dashScale": "absolute" }, "opacity": 0.75 }, "doc": "A blank node is visibly provisional." }
        ],
        "doubleClick": "openForm",
        "tooltip": { "cel": "self.blank ? 'Blank node' : self.iri" }
      },
      "ConceptScheme": {
        "shape": "rect",
        "style": "region",
        "size": { "fixed": [ 260, 40 ] },
        "labels": [
          { "id": "name", "text": { "cel": "self.label + ' (' + string(self.memberCount) + ')'" }, "position": { "anchor": [ 0.5, 0.625 ] }, "overflow": "ellipsis", "maxLines": 1, "editable": false }
        ],
        "doubleClick": "openForm"
      },
      "Collection": {
        "shape": "rect",
        "style": "region",
        "size": { "fixed": [ 260, 40 ] },
        "labels": [
          { "id": "name", "text": { "cel": "self.label" }, "position": { "anchor": [ 0.5, 0.625 ] }, "overflow": "ellipsis", "maxLines": 1, "editable": false },
          { "id": "kind", "text": "ordered", "position": { "anchor": [ 0, 0 ], "offset": [ 8, 34 ], "align": "start" }, "style": "muted", "visible": { "cel": "self.ordered" } }
        ],
        "doubleClick": "openForm"
      }
    },
    "edges": {
      "Broader": {
        "line": { "stroke": { "color": { "token": "color.border" }, "width": 1 }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "doc": "Solid and arrowless: the broader concept sits above."
      },
      "Related": {
        "line": { "stroke": { "color": { "token": "color.border" }, "width": 1, "dash": [ 6, 4 ], "dashScale": "absolute" }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false
      },
      "Mapping": {
        "line": { "stroke": { "color": { "token": "color.border" }, "width": 1, "dash": [ 2, 3 ], "dashScale": "absolute" }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [ { "id": "predicate", "text": { "cel": "self.predicate" }, "at": "middle", "side": "above", "distance": 6, "editable": false } ],
        "reconnectable": false,
        "deletable": false
      }
    },
    "canvas": {
      "watermark": { "id": "truncation", "text": { "cel": "'Showing ' + string(diagram.shown) + ' of ' + string(diagram.total) + ' terms — edits are withheld on this truncated view'" }, "visible": { "cel": "diagram.truncated" } }
    }
  },

  "forms": {
    "labelledInspector": {
      "for": [ "ConceptScheme", "Concept", "Collection" ],
      "usage": [ "inspector" ],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "iri", "widget": "readonly" },
          { "attribute": "notation", "widget": "readonly", "visible": "size(self.notation) > 0" }
        ] },
        { "kind": "section", "title": "Labels", "items": [
          { "attribute": "prefLabel", "widget": "table", "readOnly": { "cel": "self.xlLabelled || diagram.truncated" },
            "doc": "Editing a preferred label rewrites only its lexical form; the language tag is kept. A language without a label gets a new `skos:prefLabel` triple." },
          { "attribute": "altLabel", "widget": "table" },
          { "attribute": "hiddenLabel", "widget": "table" }
        ] },
        { "kind": "section", "title": "Documentation", "items": [
          { "attribute": "definition", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "scopeNote", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "example", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "note", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "historyNote", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "editorialNote", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "changeNote", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } }
        ] },
        { "kind": "section", "title": "Membership", "visible": "self.isA('Concept')", "items": [
          { "attribute": "inScheme", "widget": "readonly" }
        ] },
        { "kind": "section", "title": "Mappings", "visible": "self.isA('Concept')", "items": [
          { "attribute": "mappings", "widget": "readonly" }
        ] },
        { "kind": "problems" }
      ]
    },
    "addConceptDialog": {
      "for": "diagram",
      "usage": [ "create" ],
      "label": "Add concept",
      "icon": "mdi:tag-plus-outline",
      "items": [ { "attribute": "label", "label": "Preferred label" } ]
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      { "id": "vocabulary", "label": "SKOS", "tools": [
        { "id": "concept", "kind": "operation", "operation": "addConcept", "label": "Concept", "icon": "mdi:tag-plus-outline",
          "enabled": "size(diagram.nodesOfType('ConceptScheme')) > 0 && !diagram.truncated",
          "doc": { "summary": "A concept, filed into the file's first scheme. Drop it where it should sit; you will be asked for its preferred label.", "rationale": "Schemes and collections are modeled deliberately, not dropped." } }
      ] }
    ],
    "contextTools": [
      { "for": [ "Concept" ], "placement": "around", "tools": [
        { "kind": "connect", "via": "Broader", "label": "File under (broader)", "icon": "mdi:file-tree", "position": "top" },
        { "kind": "connect", "via": "Related", "label": "Relate (skos:related)", "icon": "mdi:swap-horizontal", "position": "right" }
      ] }
    ],
    "contextMenus": [
      { "for": [ "ConceptScheme", "Concept", "Collection" ], "placement": "menu", "when": "!self.blank && !diagram.truncated", "tools": [
        { "kind": "operation", "operation": "rename", "label": "Rename…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove", "icon": "mdi:delete-outline", "shortcut": "Delete" }
      ] },
      { "for": [ "Broader" ], "placement": "menu", "when": "!diagram.truncated", "tools": [
        { "kind": "delete", "label": "Disconnect", "icon": "mdi:link-off", "shortcut": "Delete" }
      ] },
      { "for": [ "Related" ], "placement": "menu", "when": "!diagram.truncated", "tools": [
        { "kind": "delete", "label": "Remove related link", "icon": "mdi:link-off", "shortcut": "Delete" }
      ] }
    ]
  },

  "constraints": {
    "doc": "Facts about the file, never a reasoner's opinion: nothing is fetched and nothing is inferred. Parse failures and serialization refusals are reported by the Turtle plugin as one finding that replaces all of these.",
    "builtIn": {
      "std.endpoints": { "severity": "warning", "enabled": true }
    },
    "rules": [
      { "id": "hierarchyCycle", "label": "Hierarchy cycle", "scope": "Concept",
        "rule": "!self.inCycle('Broader')", "severity": "error", "cost": "expensive",
        "message": { "cel": "'The broader/narrower hierarchy runs in a circle through ' + self.label + '. The diagram draws every edge and breaks the circle for layering only.'" },
        "doc": { "summary": "skos.hierarchy-cycle", "rationale": "SKOS does not forbid a cycle, but a thesaurus with one is almost always wrong; the layout has to break it to layer at all." } },
      { "id": "duplicatePrefLabel", "label": "Two preferred labels in one language", "scope": "Concept",
        "rule": "self.prefLabel.map(l, l.language).isUnique()", "severity": "error", "attribute": "prefLabel",
        "message": { "cel": "self.label + ' has more than one preferred label in one language; SKOS allows one (S14). The lexicographically first is drawn.'" },
        "doc": { "summary": "skos.duplicate-preflabel", "rationale": "SKOS integrity condition S14." } },
      { "id": "missingPrefLabel", "label": "No preferred label", "scope": "Concept",
        "rule": "size(self.prefLabel) > 0", "severity": "warning", "attribute": "prefLabel",
        "message": { "cel": "self.label + ' has no skos:prefLabel in any language, so the diagram falls back to ' + (size(self.altLabel) + size(self.hiddenLabel) > 0 ? 'an alternate label' : 'its IRI') + '.'" },
        "doc": "skos.missing-preflabel" },
      { "id": "relatedOverlap", "label": "Related and hierarchical", "scope": "Related",
        "rule": "!(self.target in self.source.successors('Broader') || self.source in self.target.successors('Broader'))", "severity": "warning",
        "message": { "cel": "self.source.label() + ' and ' + self.target.label() + ' are both hierarchy-linked and skos:related, which SKOS S27 forbids. Only this direct case is checked: the transitive case would need inference, which this diagram never does.'" },
        "doc": { "summary": "skos.related-overlap", "rationale": "SKOS integrity condition S27, direct case only." } },
      { "id": "unfiledConcept", "label": "Unfiled concept", "scope": "Concept",
        "rule": "size(self.inScheme) > 0 || diagram.nodesOfType('ConceptScheme').exists(s, s.topConcepts.exists(t, t == self || t in self.reachable('Broader')))",
        "severity": "info", "cost": "expensive",
        "message": { "cel": "rdfLocalName(self.iri) + ' is in no concept scheme and under no top concept - legal SKOS, and usually a mistake. It draws in the unfiled band.'" },
        "doc": "skos.unfiled-concept" },
      { "id": "xlLabels", "label": "SKOS-XL labels", "scope": "diagram",
        "rule": "!diagram.usesSkosXl", "severity": "info",
        "message": "This file labels concepts through SKOS-XL, which this reading does not resolve; the plain-SKOS fallbacks apply (Requirement 3.6).",
        "doc": "skos.xl-labels" },
      { "id": "misplacedHeader", "label": "Misplaced language header", "scope": "diagram",
        "rule": "diagram.languageHeaderLine == 0", "severity": "warning",
        "message": { "cel": "'The registration\\'s language: header (line ' + string(diagram.languageHeaderLine) + ') sits above a body: or view: line, where core\\'s header scan would stop before reaching them. It is ignored; move it below body:/view: and above layout:.'" },
        "doc": "skos.misplaced-header" },
      { "id": "gestureEndsAreConcepts", "kind": "connect", "when": "relationType in ['Broader', 'Related']",
        "rule": "source.isA('Concept') && target.isA('Concept') && !source.blank && !target.blank",
        "message": "Both ends of this gesture must be concepts the file types as skos:Concept." },
      { "id": "gestureNotToSelf", "kind": "connect",
        "rule": "source != target", "message": "A concept cannot be filed under or related to itself." },
      { "id": "mappingsAreRead", "kind": "connect",
        "rule": "relationType != 'Mapping'", "message": "Mapping links are read from the file; write them as triples." },
      { "id": "blankNotPositioned", "kind": "placement", "scope": "Labelled",
        "rule": "!self.blank",
        "message": "That is a blank node, whose identity does not survive a reparse, so a stored position could not be trusted. Name it with an IRI to arrange it." },
      { "id": "noReparentByDrag", "kind": "placement", "scope": "Concept",
        "rule": "newParent == self.parent",
        "message": "A concept is filed under a parent with the hierarchy gesture; dragging changes where it sits on the canvas." },
      { "id": "truncatedCreate", "kind": "create", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedConnect", "kind": "connect", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedDelete", "kind": "delete", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedChange", "kind": "change", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "xlPrefLabelLocked", "kind": "change", "scope": "Labelled", "when": "attribute == 'prefLabel'",
        "rule": "!self.xlLabelled",
        "message": "This concept's labels are stated through SKOS-XL, which this reading does not resolve (Requirement 3.6). Edit them as triples in the graph reading." }
    ]
  },

  "behavior": {
    "operations": {
      "addConcept": {
        "label": "Add concept here…",
        "icon": "mdi:tag-plus-outline",
        "for": "diagram",
        "doc": "Writes three triples as one undo: `rdf:type skos:Concept`, a `skos:prefLabel` tagged `@en`, and `skos:inScheme` the file's first scheme. The IRI is minted under the namespace the file's subjects already use.",
        "params": { "label": { "type": "string", "label": "Preferred label" } },
        "enabled": "size(diagram.nodesOfType('ConceptScheme')) > 0 && !diagram.truncated",
        "actions": [
          { "if": "p.label.trim() == ''", "then": [ { "abort": { "message": "'A concept needs a preferred label.'" } } ] },
          { "let": { "iri": "rdfMintIri(p.label.trim())" } },
          { "if": "iri == ''", "then": [ { "abort": { "message": "rdfMintRefusal(p.label.trim())" } } ] },
          { "if": "rdfTermExists(iri)", "then": [ { "abort": { "message": "iri + ' already names something in this document. Choose a different label, or rename the existing resource first.'" } } ] },
          { "create": { "type": "'Concept'", "attributes": {
              "iri": "iri",
              "prefLabel": "[{'text': p.label.trim(), 'language': 'en'}]",
              "inScheme": "[diagram.nodesOfType('ConceptScheme')[0]]"
            } }, "as": "concept" },
          { "select": "concept" }
        ]
      },
      "rename": {
        "label": "Rename…",
        "icon": "mdi:pencil-outline",
        "shortcut": "F2",
        "for": [ "Labelled" ],
        "enabled": "!self.blank && !diagram.truncated",
        "params": { "newName": { "type": "string", "label": "New IRI or prefixed name", "required": true } },
        "doc": "Rewrites every occurrence of the IRI - subject, predicate and object positions, prefixed or full - as one command; a collision is refused before anything is written.",
        "plugin": { "name": "net.etalii.adp.w3c.turtle", "args": { "action": "renameTerm" } }
      }
    },
    "deletion": {
      "Labelled": { "relations": "delete", "confirm": "Removing this resource also removes the statements it appears in." },
      "Broader": { "confirm": "This pair is asserted in both directions; disconnecting removes both statements as one undo." }
    },
    "undo": { "mergeWindowMs": 0 }
  },

  "layout": {
    "doc": "Pure and deterministic, no physics: the same file always opens the same way. Authored positions from the registration override computed ones element by element.",
    "algorithms": {
      "schemeBands": {
        "algorithm": "plugin:net.etalii.adp.w3c.skosBands",
        "direction": "down",
        "spacing": { "node": 40, "layer": 66, "component": 90 },
        "options": { "columnWidth": 240, "rowHeight": 110, "regionGap": 90, "regionHeader": 60 },
        "doc": "One band per scheme in IRI order, then an unfiled band, then a row of collections; inside a band every concept sits one row below its deepest broader concept, rows filled left to right in id order."
      },
      "fallback": {
        "algorithm": "layered",
        "direction": "down",
        "spacing": { "node": 40, "layer": 66 },
        "doc": "What a runtime without the plugin uses: a layered layout over the hierarchy edges."
      }
    },
    "default": "schemeBands",
    "trigger": "onLoadIfMissing",
    "respect": "all",
    "incremental": true
  },

  "persistence": {
    "doc": "The vocabulary's own Turtle or N-Triples file is the model; ADP writes only minimal splices into it. Positions live in the `.adp` registration's `layout:` block, keyed by element id, and nothing of ADP's is ever written into the RDF.",
    "format": "plugin:net.etalii.adp.w3c.turtle",
    "files": { "mode": "split", "model": "{name}.ttl", "view": "{name}.adp" },
    "ids": { "strategy": "natural", "stable": false, "pattern": "^(res:.+|blank:[0-9]+|edge:.+)$" },
    "view": { "store": [ "bounds" ], "styleOverrides": "none" },
    "import": [ { "format": "plugin:net.etalii.adp.w3c.turtle", "label": "N-Triples (.nt)" } ]
  },

  "plugins": {
    "net.etalii.adp.w3c.turtle": {
      "version": "^0.1.0",
      "provides": [ "persistenceFormat", "import", "action", "celFunctions" ],
      "required": true,
      "doc": "The RDF family's shared engine: one store per file parsing Turtle and N-Triples into triples plus a line-level concrete syntax, byte-identical round trips, edits as minimal splices, the drawn-element budget, and the projection of triples onto this specification's elements. Shared with the w3c/rdf, w3c/owl and w3c/shacl specifications.",
      "celFunctions": [
        {"name": "rdfLocalName", "params": ["string"], "returns": "string", "cost": 1, "doc": "The part of an IRI after its last '#' or '/', or the whole IRI."},
        {"name": "rdfMintIri", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI for a new resource: the label slugged to [A-Za-z0-9_-] under the namespace of the file's first prefixed subject, else its first declared prefix; '' when neither exists or nothing usable is left."},
        {"name": "rdfMintRefusal", "params": ["string"], "returns": "string", "cost": 10, "doc": "The sentence explaining why rdfMintIri returned ''."},
        {"name": "rdfTermExists", "params": ["string"], "returns": "bool", "cost": 10, "doc": "The IRI appears as a subject or object anywhere in the file."},
        {"name": "rdfCompress", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI as the writer spells it: `prefix:local` under the longest declared namespace whose remainder is a clean local name, else the bracketed `<iri>`."},
        {"name": "rdfDisplayName", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI as drawn: rdfCompress's prefixed name when there is one, else rdfLocalName when it is not empty, else the whole IRI unbracketed."},
        {"name": "rdfResolveTerm", "params": ["string"], "returns": "string", "cost": 10, "doc": "The full IRI a typed term names: a bracketed `<iri>`, a text containing '://', or `prefix:local` under a declared prefix; '' when it names nothing."},
        {"name": "rdfTermRefusal", "params": ["string"], "returns": "string", "cost": 10, "doc": "The sentence explaining why rdfResolveTerm returned ''."}
      ]
    },
    "net.etalii.adp.w3c.skosBands": {
      "version": "^0.1.0",
      "provides": [ "layout" ],
      "required": false,
      "fallback": { "layout": "layered" },
      "doc": "The scheme-band layout with deterministic cycle breaking; see w3c-skos.md."
    }
  },

  "x-adp": {
    "origin": "w3c/skos",
    "state": "prototype",
    "extensions": [ ".ttl", ".nt" ],
    "claimsBareFiles": false,
    "suggestWhenBodyContains": [ "skos:ConceptScheme", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
    "registrationHeaders": { "language": "The display language; after body:/view:, before layout:." },
    "family": [ "w3c/rdf", "w3c/owl", "w3c/skos", "w3c/shacl" ],
    "implementations": { "standalone": "etalii.adp.ide.standalone src/diagrams/rdf (Skos/)" }
  }
}
