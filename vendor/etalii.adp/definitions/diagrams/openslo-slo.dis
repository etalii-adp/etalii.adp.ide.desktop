            },
            "position": "top-right",
            "style": "inline",
            "tooltip": "Written inside the object it is joined to, not as a document of its own (research R3)."
          }
        ],
        "tooltip": {
          "cel": "has(self.description) && self.description != '' ? self.description : self.name"
        }
