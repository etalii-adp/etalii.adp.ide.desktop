  "constraints": {
    "doc": "The findings of User Story 3 (FR-005), each with its code and sentence. A file that breaks a rule still opens and draws: a finding never refuses, so nothing anyone wrote is lost.",
    "blockSaveOn": "never",
    "rules": [
      {
        "id": "missingReference",
        "code": "openslo.missing-reference",
        "label": "Reference not in the file",
        "severity": "info",
        "scope": [
          "SLO",
          "Objective",
          "SLI",
          "AlertPolicy"
        ],
        "rule": "unresolved(self).size() == 0",
        "message": {
          "cel": "cel.bind(r, unresolved(self)[0], 'The ' + r[0] + ' \"' + r[1] + '\" is not in this file' + (unresolved(self).size() > 1 ? ', nor ' + string(unresolved(self).size() - 1) + ' more' : '') + '; it is drawn as a placeholder.')"
        },
        "doc": "A reference that names no object of its kind in the reading. Info in a bare file, where the object may well be in another file; a folder reading draws it in full (research R4; openslo-slo.md, Gaps)."
      },
      {
        "id": "noAlerting",
        "code": "openslo.no-alerting",
        "label": "No alert policy",
        "severity": "info",
        "scope": [
          "SLO"
        ],
        "rule": "self.alertPolicyRefs.size() > 0 || self.childrenOfType('AlertPolicy').size() > 0",
        "message": {
          "cel": "'The SLO \"' + self.name + '\" has no alert policy; nobody is told when its budget burns.'"
        }
      },
      {
        "id": "targetRange",
        "code": "openslo.target-range",
        "label": "Target out of range",
        "severity": "error",
        "scope": [
          "Objective"
        ],
        "rule": "(!has(self.targetRatio) || (self.targetRatio >= 0.0 && self.targetRatio < 1.0)) && (!has(self.targetPercent) || (self.targetPercent >= 0.0 && self.targetPercent < 100.0))",
        "message": {
          "cel": "'The target ' + (has(self.targetRatio) ? string(self.targetRatio) : string(self.targetPercent) + ' %') + ' is outside what OpenSLO allows: target from 0 up to 1, targetPercent from 0 up to 100.'"
        }
      },
      {
        "id": "targetTwice",
        "code": "openslo.target-twice",
        "label": "Target written twice or not at all",
        "severity": "error",
        "scope": [
          "Objective"
        ],
        "rule": "has(self.targetRatio) != has(self.targetPercent)",
        "message": {
          "cel": "has(self.targetRatio) ? 'The objective has both target and targetPercent; write one of them.' : 'The objective has no target; write target or targetPercent.'"
        }
      },
      {
        "id": "indicatorTwice",
        "code": "openslo.indicator-twice",
        "label": "Indicator written twice or not at all",
        "severity": "error",
        "scope": [
          "SLO"
        ],
        "rule": "(has(self.indicatorRef) && self.indicatorRef != '') != self.hasIndicator || (!self.hasIndicator && !(has(self.indicatorRef) && self.indicatorRef != '') && self.childrenOfType('Objective').all(o, has(o.indicatorRef) && o.indicatorRef != ''))",
        "message": {
          "cel": "self.hasIndicator ? 'The SLO has both an inline indicator and indicatorRef; write one of them.' : 'The SLO has no indicator; write indicatorRef or an inline indicator.'"
        },
        "doc": "One of indicator and indicatorRef, unless every objective names its own SLI, as a composite SLO does."
      },
      {
        "id": "windowCount",
        "code": "openslo.window-count",
        "label": "More than one time window",
        "severity": "warning",
        "scope": [
          "SLO"
        ],
        "rule": "self.windowCount <= 1",
        "message": {
          "cel": "'The SLO has ' + string(self.windowCount) + ' time windows; OpenSLO allows one, and the diagram reads the first.'"
        }
      },
      {
        "id": "timesliceFields",
        "code": "openslo.timeslice-fields",
        "label": "Slice target or window missing",
        "severity": "error",
        "scope": [
          "Objective"
        ],
        "rule": "self.parent.budgetingMethod != 'Timeslices' || (has(self.timeSliceTarget) && has(self.timeSliceWindow))",
        "message": {
          "cel": "'A Timeslices objective needs timeSliceTarget and timeSliceWindow; this one lacks ' + (has(self.timeSliceTarget) ? 'timeSliceWindow' : has(self.timeSliceWindow) ? 'timeSliceTarget' : 'both') + '.'"
        }
      },
      {
        "id": "conflictingWindows",
        "code": "openslo.conflicting-windows",
        "label": "SLOs on one SLI with different windows",
        "severity": "warning",
        "scope": [
          "SLI"
        ],
        "rule": "diagram.relationsOfType('Measures').filter(m, m.target == self && m.source.isA('SLO') && has(m.source.duration)).map(m, m.source.duration + (m.source.isRolling ? ' rolling' : '')).distinct().size() <= 1",
        "message": {
          "cel": "'The SLI \"' + self.name + '\" is measured by SLOs with different windows: ' + diagram.relationsOfType('Measures').filter(m, m.target == self && m.source.isA('SLO') && has(m.source.duration)).map(m, m.source.name + ' ' + windowText(m.source)).join(', ') + '.'"
        }
      },
      {
        "id": "unknownKind",
        "code": "openslo.unknown-kind",
        "label": "Document not drawn",
        "severity": "info",
        "scope": [
          "Unbound"
        ],
        "rule": "isOtherVersion(self)",
        "message": {
          "cel": "'A document of kind \"' + (self.kindName != '' ? self.kindName : 'none') + '\" is not drawn; it is kept as written and listed.'"
        }
      },
      {
        "id": "version",
        "code": "openslo.version",
        "label": "Another OpenSLO version",
        "severity": "warning",
        "scope": [
          "Unbound"
        ],
        "rule": "!isOtherVersion(self)",
        "message": {
          "cel": "'A document of ' + self.apiVersion + ' is kept as written and not drawn; this diagram reads openslo/v1. Edit this file in a tool for that version.'"
        },
        "doc": "Research R7. DISL and FBL cannot make a reading read-only on a condition, so the documents of openslo/v1 stay editable and this one is never touched (openslo-slo.md, Gaps)."
      },
      {
        "id": "name",
        "code": "openslo.name",
        "label": "Name is not an RFC 1123 label",
        "severity": "error",
        "scope": [
          "Service",
          "SLO",
          "SLI",
          "DataSource",
          "AlertPolicy",
          "AlertCondition",
          "AlertNotificationTarget"
        ],
        "rule": "isName(self.name)",
        "message": {
          "cel": "'\"' + self.name + '\" is not a valid OpenSLO name: at most 63 lower-case letters, digits and hyphens, starting and ending with a letter or a digit.'"
        },
        "attribute": "name"
      }
    ]
  },
  "behavior": {
    "doc": "Every edit is one undoable step. A new SLO is written with its service and an SLI referenced; deleting an object others refer to asks first and names them (User Story 2).",
    "operations": {
      "addSlo": {
        "label": "SLO",
        "icon": "mdi-target",
        "for": "diagram",
        "actions": [
          {
            "let": {
              "service": "diagram.nodesOfType('Service').filter(n, !n.inline).map(n, n.name).first().orValue('')",
              "sli": "diagram.nodesOfType('SLI').filter(n, !n.inline).map(n, n.name).first().orValue('')"
            }
          },
          {
            "create": {
              "type": "'SLO'",
              "attributes": {
                "name": "'new-slo'",
                "service": "service",
                "indicatorRef": "sli",
                "budgetingMethod": "'Occurrences'"
              }
            },
            "as": "slo"
          },
          {
            "create": {
              "type": "'Objective'",
              "parent": "slo",
              "slot": "'objectives'",
              "attributes": {
                "displayName": "'Objective'",
                "targetRatio": "0.99"
              }
            }
          }
        ],
        "doc": "User Story 2, scenario 2: a new SLO document with the first service and the first SLI of the file referenced, a 28-day rolling window, the Occurrences method and one objective of 99 %. Without a service or an SLI the reference is left empty and openslo.missing-reference says so."
      },
      "addSloForService": {
        "label": "Add an SLO",
        "icon": "mdi-target",
        "for": [
          "Service"
        ],
        "actions": [
          {
            "let": {
              "sli": "diagram.nodesOfType('SLI').filter(n, !n.inline).map(n, n.name).first().orValue('')"
            }
          },
          {
            "create": {
              "type": "'SLO'",
              "attributes": {
                "name": "self.name + '-slo'",
                "service": "self.name",
                "indicatorRef": "sli",
                "budgetingMethod": "'Occurrences'"
              }
            },
            "as": "slo"
          },
          {
            "create": {
              "type": "'Objective'",
              "parent": "slo",
              "slot": "'objectives'",
              "attributes": {
                "displayName": "'Objective'",
                "targetRatio": "0.99"
              }
            }
          }
        ],
        "doc": "The same, for the service it is invoked on."
      },
      "addObjective": {
        "label": "Add an objective",
        "icon": "mdi-bullseye-arrow",
        "for": [
          "SLO"
        ],
        "actions": [
          {
            "create": {
              "type": "'Objective'",
              "parent": "self",
              "slot": "'objectives'",
              "attributes": {
                "displayName": "'Objective ' + string(self.childrenOfType('Objective').size() + 1)",
                "targetRatio": "0.99"
              }
            }
          }
        ],
        "doc": "A new entry at the end of spec.objectives."
      }
    },
    "deletion": {
      "Service": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "message": {
            "cel": "'Delete \"' + self.name + '\"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'Service' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'Service' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.'"
          },
          "when": "!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'Service' && r[1] == self.name))",
          "danger": true
        }
      },
      "SLI": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "message": {
            "cel": "'Delete \"' + self.name + '\"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'SLI' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'SLI' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.'"
          },
          "when": "!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'SLI' && r[1] == self.name))",
          "danger": true
        }
      },
      "DataSource": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "message": {
            "cel": "'Delete \"' + self.name + '\"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'DataSource' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'DataSource' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.'"
          },
          "when": "!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'DataSource' && r[1] == self.name))",
          "danger": true
        }
      },
      "AlertPolicy": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "message": {
            "cel": "'Delete \"' + self.name + '\"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertPolicy' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertPolicy' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.'"
          },
          "when": "!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'AlertPolicy' && r[1] == self.name))",
          "danger": true
        }
      },
      "AlertCondition": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "message": {
            "cel": "'Delete \"' + self.name + '\"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertCondition' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertCondition' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.'"
          },
          "when": "!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'AlertCondition' && r[1] == self.name))",
          "danger": true
        }
      },
      "AlertNotificationTarget": {
        "children": "delete",
        "relations": "delete",
        "confirm": {
          "message": {
            "cel": "'Delete \"' + self.name + '\"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertNotificationTarget' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertNotificationTarget' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.'"
          },
          "when": "!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'AlertNotificationTarget' && r[1] == self.name))",
          "danger": true
        }
      }
    }
  },
  "layout": {
    "doc": "Research R8: the force layout in tiers, the service in the middle, then its SLOs, then their objectives and SLIs, the data sources outermost, and the alerting on the ring of the SLOs. A position a user pins is kept in the registration's layout block (FBL 8.3), never in the OpenSLO file (FR-008).",
    "algorithms": {
      "tiers": {
        "algorithm": "force",
        "force": {
          "tiers": [
            "Service",
            [
              "SLO",
              "AlertPolicy",
              "Missing"
            ],
            [
              "Objective",
              "SLI",
              "AlertCondition",
              "AlertNotificationTarget"
            ],
            [
              "DataSource",
              "Unbound"
            ]
          ],
          "gap": 28
        },
        "doc": "openslo-slo.md, Layout, gives the reference algorithm."
      }
    },
    "default": "tiers",
    "trigger": "onChange",
    "respect": "pinned",
    "animate": {
      "durationMs": 250
    }
  },
  "viewpoints": {
    "objectives": {
      "label": "Objectives",
      "default": true,
      "doc": "Every kind is drawn."
    }
  },
  "persistence": {
    "format": "fbl",
    "binding": "openslo-slo.fbl#openslo",
    "ids": {
      "strategy": "derived",
      "expression": "self.type + ':' + self.name",
      "pattern": "^.+$",
      "doc": "An OpenSLO name is unique within its kind, not across kinds (a Service and an SLI are often named alike), so an id is the kind and the name; an inline object's id adds it to its owner's, and an objective's is its owner's with its position (research R3). Pinned positions are keyed by these ids in the registration.",
      "types": {
        "Service": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/Service:' + self.name : 'Service:' + self.name"
        },
        "SLO": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/SLO:' + self.name : 'SLO:' + self.name"
        },
        "SLI": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/SLI:' + self.name : 'SLI:' + self.name"
        },
        "DataSource": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/DataSource:' + self.name : 'DataSource:' + self.name"
        },
        "AlertPolicy": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/AlertPolicy:' + self.name : 'AlertPolicy:' + self.name"
        },
        "AlertCondition": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/AlertCondition:' + self.name : 'AlertCondition:' + self.name"
        },
        "AlertNotificationTarget": {
          "strategy": "derived",
          "expression": "self.inline && self.parent != null ? self.parent.id + '/AlertNotificationTarget:' + self.name : 'AlertNotificationTarget:' + self.name"
        },
        "Objective": {
          "strategy": "derived",
          "expression": "self.parent.id + '/objective:' + string(self.positionIn(self.parent.childrenOfType('Objective')) + 1)"
        },
        "Unbound": {
          "strategy": "derived",
          "expression": "'document@' + string(self.line)",
          "ephemeral": true,
          "reason": "A document the diagram does not draw is known only by the line it starts on, which an edit above it changes."
        }
      }
    },
    "typeMap": {
      "Service": {
        "as": "Service"
      },
      "SLO": {
        "as": "SLO"
      },
      "SLI": {
        "as": "SLI"
      },
      "DataSource": {
        "as": "DataSource"
      },
      "AlertPolicy": {
        "as": "AlertPolicy"
      },
      "AlertCondition": {
        "as": "AlertCondition"
      },
      "AlertNotificationTarget": {
        "as": "AlertNotificationTarget",
        "attributes": {
          "target": "destination"
        },
        "doc": "spec.target is the attribute destination, since DISL reserves target."
      },
      "Unbound": {
        "as": "Unbound"
      },
      "Objective": {
        "as": "Objective",
        "attributes": {
          "target": "targetRatio",
          "value": "threshold"
        },
        "doc": "DISL reserves target and value (DISL 2.2), so the objective's target and value keys are the attributes targetRatio and threshold (research R11)."
      }
    },
    "view": {
      "store": [
        "bounds"
      ],
      "viewer": [
        "selection",
        "viewport"
      ],
      "styleOverrides": "none",
      "doc": "Only the positions a user pins are stored, in the registration's layout block (FBL 8.3), never in the OpenSLO file (FR-008, research R8)."
    },
    "doc": "OpenSLO's own YAML, openslo/v1, read and written through openslo-slo.fbl#openslo with byte-preserving splices, every document of a stream bound (FBL 0.22). A folder is read through openslo-slo.fbl#folder from a registration whose body is the folder."
  },
  "x-adp": {
    "kind": "Diagram",
    "companion": "openslo-slo.md"
  }
}
