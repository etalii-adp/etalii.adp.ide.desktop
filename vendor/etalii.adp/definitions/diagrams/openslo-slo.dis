            "id": "label",
            "text": "on",
            "at": "middle",
            "side": "above",
            "distance": 4
          }
        ]
      },
      "Notifies": {
        "style": "reference",
        "line": {
          "routing": "rounded"
        },
        "targetMarker": "arrowFilled",
        "conditions": [
          {
            "when": "self.target.isA('Missing')",
            "style": "toMissing"
          }
        ],
        "labels": [
          {
            "id": "label",
            "text": "notifies",
            "at": "middle",
            "side": "above",
            "distance": 4
          }
        ]
      }
    },
    "canvas": {
      "empty": {
        "text": "No OpenSLO objects yet. Add a service and an SLO from the toolbox."
      }
    }
  },
  "toolbox": {
    "doc": "One tool per kind of document, and objectives added to an SLO from its menu. A new SLO is written with its service and an SLI referenced (User Story 2, scenario 2).",
    "groups": [
      {
        "id": "objects",
        "label": "OpenSLO",
        "tools": [
          {
            "id": "service",
            "kind": "create-node",
            "creates": "Service",
            "label": "Service",
            "initial": {
              "name": "new-service"
            }
          },
          {
            "id": "slo",
            "kind": "operation",
            "operation": "addSlo",
            "label": "SLO"
          },
          {
            "id": "sli",
            "kind": "create-node",
            "creates": "SLI",
            "label": "SLI",
            "initial": {
              "name": "new-sli"
            }
          },
          {
            "id": "dataSource",
            "kind": "create-node",
            "creates": "DataSource",
            "label": "Data source",
            "initial": {
              "name": "new-data-source"
            }
          },
          {
            "id": "alertPolicy",
            "kind": "create-node",
            "creates": "AlertPolicy",
            "label": "Alert policy",
            "initial": {
              "name": "new-alert-policy"
            }
          },
          {
            "id": "alertCondition",
            "kind": "create-node",
            "creates": "AlertCondition",
            "label": "Alert condition",
            "initial": {
              "name": "new-alert-condition"
            }
          },
          {
            "id": "notificationTarget",
            "kind": "create-node",
            "creates": "AlertNotificationTarget",
            "label": "Notification target",
            "initial": {
              "name": "new-notification-target"
            }
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "SLO"
        ],
        "tools": [
          {
            "kind": "operation",
            "operation": "addObjective"
          }
        ]
      },
      {
        "for": [
          "Service"
        ],
        "tools": [
          {
            "kind": "operation",
            "operation": "addSloForService"
          }
        ]
      }
    ]
  },
  "forms": {
