{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.databricks.pipeline",
    "version": "0.2.0",
    "origin": "databricks/pipeline",
    "label": "Databricks pipeline",
    "icon": "mdi-pipe",
    "fileExtension": ".json",
    "license": "Apache-2.0",
    "homepage": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/databricks",
    "doc": {
      "summary": "A declarative pipeline's flow: source libraries through the pipeline into its catalog target.",
      "description": "The diagram of one Lakeflow Declarative Pipeline (formerly Delta Live Tables), read from its settings: either a bare pipeline settings JSON file, or a `resources.pipelines.<key>` mapping in a Databricks Asset Bundle's YAML. The source libraries sit on the left, each flowing into the pipeline node, which flows into the catalog and schema it publishes to; the compute and the notifications sit beneath. This is the settings view, not the graph of datasets the pipeline defines. The settings stay Databricks' own file: ADP never writes positions into it. The `x-databricks` block maps this specification's names to the wire ids the standalone tool uses today. See `databricks-pipeline.md` beside this file for what DISL 0.3 cannot say.",
      "seeAlso": [
        { "title": "Databricks: pipeline settings", "href": "https://docs.databricks.com/aws/en/dlt/configure-pipeline" },
        { "title": "Databricks: pipeline resource in a bundle", "href": "https://docs.databricks.com/aws/en/dev-tools/bundles/resources#pipeline" }
      ]
    },
    "requires": { "conformance": "standard" }
  },

  "functions": {
    "rippleRank": {
      "params": [ { "name": "e", "type": "Element" }, { "name": "members", "type": "list(Element)" } ],
      "returns": "int",
      "cel": "cel.bind(x, e.view.bounds.center()[0], cel.bind(y, e.view.bounds.center()[1], members.filter(o, o.view.bounds.center()[0] < x || (o.view.bounds.center()[0] == x && (o.view.bounds.center()[1] < y || (o.view.bounds.center()[1] == y && o.positionIn(members) < e.positionIn(members))))).size()))",
      "doc": "The element's place in a ripple: the members ordered by position on the canvas, left to right, then top to bottom, then in reading order."
    },
    "updateMembers": {
      "params": [],
      "returns": "list(Element)",
      "uses": ["diagram"],
      "cel": "diagram.nodesOfType('Library') + diagram.nodesOfType('Pipeline') + diagram.nodesOfType('Destination')",
      "doc": "What a simulated update ripples over: the source libraries, the pipeline and its target."
    }
  },

  "metamodel": {
    "diagram": {
      "attributes": {
        "pipelineKey": { "type": "string", "readOnly": true, "doc": "The key under `resources.pipelines` when the pipeline lives in a bundle; empty for a bare settings file. Chosen by the `.adp` registration's `resource:` header when a file declares several." }
      }
    },
    "dataTypes": {
      "Notification": {
        "label": "Notification",
        "fields": {
          "recipients": { "type": "string", "many": true, "doc": "`email_recipients`." },
          "alerts": { "type": "string", "many": true, "doc": "`alerts`, the events that send it." }
        }
      }
    },
    "enums": {
      "LibraryKind": {
        "values": {
          "notebook": { "label": "Notebook", "icon": "mdi-notebook-outline", "doc": "`{ notebook: { path } }`." },
          "file": { "label": "File", "icon": "mdi-file-code-outline", "doc": "`{ file: { path } }`." },
          "glob": { "label": "Glob", "doc": "`{ glob: { include } }`." },
          "other": { "label": "Other", "doc": "Any other library entry (for example a jar, whl or maven entry). Its path is empty." }
        }
      },
      "Channel": {
        "extensible": true,
        "values": { "CURRENT": { "label": "CURRENT" }, "PREVIEW": { "label": "PREVIEW" } }
      },
      "SimulatedState": {
        "doc": "Where an element stands in a simulated update. Never stored.",
        "values": { "pending": {}, "running": {}, "succeeded": {} }
      }
    },
    "types": {
      "Library": {
        "label": "Library",
        "doc": "One entry of the pipeline's `libraries` list: a source its transformations come from.",
        "labelAttribute": "path",
        "attributes": {
          "libraryKind": { "type": "LibraryKind", "required": true, "readOnly": true },
          "path": { "type": "string", "required": true, "key": true, "readOnly": true, "doc": "`path`, or `include` for a glob; empty for an `other` entry." },
          "simulated": { "type": "SimulatedState", "transient": "viewer", "readOnly": true }
        }
      },
      "Pipeline": {
        "label": "Pipeline",
        "doc": "The pipeline's own settings. There is exactly one.",
        "multiplicity": { "min": 1, "max": 1 },
        "labelAttribute": "name",
        "attributes": {
          "name": { "type": "string", "doc": "`name`." },
          "catalog": { "type": "string", "doc": "`catalog`, the Unity Catalog the pipeline publishes to." },
          "schema": { "type": "string", "doc": "`schema`, or the legacy `target` when there is no `schema`." },
          "serverless": { "type": "bool", "default": false, "readOnly": true },
          "continuous": { "type": "bool", "default": false, "readOnly": true },
          "development": { "type": "bool", "default": false, "readOnly": true },
          "channel": { "type": "Channel", "doc": "`channel`." },
          "simulated": { "type": "SimulatedState", "transient": "viewer", "readOnly": true }
        }
      },
      "Destination": {
        "label": "Target",
        "doc": "Where the pipeline publishes: its catalog and schema. Drawn from the pipeline's own settings, always, with no entry of its own (see databricks-pipeline.md).",
        "multiplicity": { "min": 1, "max": 1 },
        "attributes": {
          "simulated": { "type": "SimulatedState", "transient": "viewer", "readOnly": true }
        }
      },
      "Compute": {
        "label": "Compute",
        "doc": "What the pipeline runs on: serverless, or clusters. Drawn from `serverless`, always, with no entry of its own (see databricks-pipeline.md).",
        "multiplicity": { "min": 1, "max": 1 }
      },
      "Notifications": {
        "label": "Notifications",
        "doc": "The `notifications` list. Present only when the pipeline has notifications.",
        "multiplicity": { "min": 0, "max": 1 },
        "attributes": {
          "entries": { "type": "Notification", "many": true, "readOnly": true, "minItems": 1 }
        }
      }
    },
    "relations": {
      "Flow": {
        "label": "Flows into",
        "doc": "From every library into the pipeline, and from the pipeline into its target. Not stored: it follows from the libraries list.",
        "source": ["Library", "Pipeline"],
        "target": ["Pipeline", "Destination"],
        "directed": true,
        "allowSelfLoops": false,
        "derived": {
          "from": "diagram.nodesOfType('Library') + diagram.nodesOfType('Destination')",
          "id": "item.isA('Library') ? 'flow:' + item.path + '->pipeline' : 'flow:pipeline->target'",
          "source": "item.isA('Library') ? item : diagram.nodesOfType('Pipeline')[0]",
          "target": "item.isA('Library') ? diagram.nodesOfType('Pipeline')[0] : item",
          "sources": "[item]",
          "reason": "A flow follows from the libraries list; add or remove a library instead."
        }
      }
    }
  },

  "notation": {
    "styles": {
      "box": {
        "fill": { "token": "color.surface" },
        "stroke": { "color": { "token": "color.border" }, "width": 1 },
        "cornerRadius": 4,
        "font": { "size": 13 }
      },
      "badges": { "font": { "size": 10, "color": "#5a6376" } },
      "simPending": { "opacity": 0.5 },
      "simRunning": { "stroke": { "color": "limegreen", "width": 2.5 } },
      "simSucceeded": { "stroke": { "color": "#15803d", "width": 2 } }
    },
    "nodes": {
      "Library": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "path", "text": { "attribute": "path" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" },
          { "id": "kind", "text": { "cel": "self.libraryKind" }, "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" }, "style": "badges" }
        ],
        "connectable": false,
        "conditions": [
          { "when": "has(self.simulated) && self.simulated == 'pending'", "style": "simPending" },
          { "when": "has(self.simulated) && self.simulated == 'running'", "style": "simRunning" },
          { "when": "has(self.simulated) && self.simulated == 'succeeded'", "style": "simSucceeded" }
        ]
      },
      "Pipeline": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "name", "text": { "attribute": "name" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" },
          { "id": "badges",
            "text": { "cel": "[self.serverless ? 'serverless' : '', self.continuous ? 'continuous' : '', self.development ? 'development' : '', has(self.channel) ? self.channel : ''].filter(b, b != '').join(' · ')" },
            "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" }, "style": "badges" }
        ],
        "connectable": false,
        "deletable": false,
        "conditions": [
          { "when": "has(self.simulated) && self.simulated == 'pending'", "style": "simPending" },
          { "when": "has(self.simulated) && self.simulated == 'running'", "style": "simRunning" },
          { "when": "has(self.simulated) && self.simulated == 'succeeded'", "style": "simSucceeded" }
        ]
      },
      "Destination": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "name",
            "text": { "cel": "diagram.nodesOfType('Pipeline').map(p, has(p.catalog) && p.catalog != '' && has(p.schema) && p.schema != '' ? p.catalog + '.' + p.schema : (has(p.catalog) && p.catalog != '' ? p.catalog : (has(p.schema) ? p.schema : '')))[0]" },
            "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" }
        ],
        "connectable": false,
        "deletable": false,
        "conditions": [
          { "when": "has(self.simulated) && self.simulated == 'pending'", "style": "simPending" },
          { "when": "has(self.simulated) && self.simulated == 'running'", "style": "simRunning" },
          { "when": "has(self.simulated) && self.simulated == 'succeeded'", "style": "simSucceeded" }
        ]
      },
      "Compute": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "name", "text": { "cel": "diagram.nodesOfType('Pipeline').exists(p, p.serverless) ? 'serverless' : 'cluster'" },
            "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false }
        ],
        "connectable": false,
        "deletable": false
      },
      "Notifications": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "recipients", "text": { "cel": "self.entries.map(e, e.recipients.join(', ')).filter(r, r != '').join(', ')" },
            "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" }
        ],
        "connectable": false,
        "deletable": false
      }
    },
    "edges": {
      "Flow": {
        "line": { "stroke": { "color": { "token": "color.border" }, "width": 1.5 }, "routing": "bezier", "startDirection": "right", "endDirection": "left" },
        "anchoring": {
          "source": { "mode": "fixed", "points": [ { "id": "right", "x": 1, "y": 0.5 } ] },
          "target": { "mode": "fixed", "points": [ { "id": "left", "x": 0, "y": 0.5 } ] }
        },
        "targetMarker": "arrowFilled"
      }
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      { "id": "libraries", "label": "Libraries", "tools": [
        { "id": "notebookLibrary", "kind": "operation", "operation": "addNotebookLibrary", "label": "Notebook library", "icon": "mdi-notebook-outline",
          "doc": "A notebook the pipeline's transformations come from." },
        { "id": "fileLibrary", "kind": "operation", "operation": "addFileLibrary", "label": "File library", "icon": "mdi-file-code-outline",
          "doc": "A source file the pipeline's transformations come from." }
      ] }
    ],
    "contextMenus": [
      { "for": ["Pipeline"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "addNotebookLibrary", "group": "add", "label": "Add notebook library…", "icon": "mdi-notebook-outline" },
        { "kind": "operation", "operation": "addFileLibrary", "group": "add", "label": "Add file library…", "icon": "mdi-file-code-outline" },
        { "kind": "operation", "operation": "simulateUpdate", "group": "simulate", "label": "Start update (simulated)", "icon": "mdi-play-outline" }
      ] },
      { "for": ["Library"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "delete", "label": "Remove library", "icon": "mdi-delete-outline", "shortcut": "Delete" }
      ] },
      { "for": ["diagram"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "addNotebookTaskHere", "group": "add", "label": "Add notebook task here", "icon": "mdi-notebook-outline" },
        { "kind": "operation", "operation": "addPythonTaskHere", "group": "add", "label": "Add Python task here", "icon": "mdi-language-python" },
        { "kind": "operation", "operation": "addConditionTaskHere", "group": "add", "label": "Add condition task here", "icon": "mdi-call-split" }
      ], "doc": "The tool offers the job reading's canvas entries under this reading too (see databricks-pipeline.md)." },
      { "for": ["connection"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "connectTasks", "label": "Depend on", "icon": "mdi-ray-start-arrow", "args": { "from": "source", "to": "target" } }
      ], "doc": "The tool offers the job reading's connection entry under this reading too (see databricks-pipeline.md)." }
    ]
  },

  "forms": {
    "pipeline": {
      "for": "Pipeline",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "name", "label": "Name", "widget": "text",
            "validate": [ { "timing": "commit", "rule": "value != ''", "message": "A pipeline needs a name." } ] },
          { "attribute": "catalog", "label": "Catalog", "widget": "text" },
          { "attribute": "schema", "label": "Schema", "widget": "text" }
        ] },
        { "kind": "section", "title": "Execution", "items": [
          { "attribute": "channel", "label": "Channel", "widget": "text" }
        ] },
        { "kind": "section", "title": "Workspace", "items": [
          { "kind": "computed", "label": "Workspace connection", "value": "Not connected",
            "readOnlyReasons": [ "Not connected — a placeholder for the real workspace connection." ] },
          { "kind": "computed", "label": "Last simulated run", "value": "",
            "readOnlyReasons": [ "Simulated runs play on the canvas and never touch the file." ] }
        ] }
      ]
    },
    "addLibrary": {
      "label": "Add library",
      "icon": "mdi-plus",
      "submitLabel": "Add",
      "items": [
        { "attribute": "path", "label": "Path", "widget": "text", "initial": "''",
          "validate": [ { "timing": "commit", "rule": "value != ''", "message": "A library needs a path." } ] }
      ]
    }
  },

  "constraints": {
    "doc": "Every finding is located at a line of the pipeline's settings: a rule on an element reports the element's `location()`, which the reader records, so both of the pipeline's findings stand on its first line.",
    "builtIn": {
      "std.duplicateId": {
        "enabled": false,
        "doc": "Two libraries of one path and different kinds share an id, as do every library of kind `other` (finding B15), and the tool has never reported it: the writer edits the first."
      },
      "std.unparseable": {
        "code": "databricks.unparseable",
        "severity": "error",
        "message": { "cel": "'This is not configuration that can be read: ' + detail.reason" }
      }
    },
    "rules": [
      { "id": "noLibraries", "code": "databricks.no-libraries", "scope": "Pipeline", "severity": "error",
        "rule": "diagram.nodesOfType('Library').size() > 0",
        "message": { "cel": "'The pipeline' + (has(self.name) && self.name != '' ? ' \\'' + self.name + '\\'' : '') + ' has no libraries, so it has nothing to run. Add at least one notebook, file or glob.'" } },
      { "id": "schemaWithoutCatalog", "code": "databricks.schema-without-catalog", "scope": "Pipeline", "severity": "warning",
        "rule": "!(has(self.schema) && self.schema != '' && (!has(self.catalog) || self.catalog == ''))",
        "message": { "cel": "'The pipeline' + (has(self.name) && self.name != '' ? ' \\'' + self.name + '\\'' : '') + ' sets a schema but no catalog, so the schema has nowhere to live. Set catalog too.'" } },
      { "id": "keepOneLibrary", "kind": "delete", "scope": "Library", "enforcement": "prevent",
        "rule": "diagram.nodesOfType('Library').size() > 1",
        "message": "A pipeline needs at least one library; removing the last one is not allowed." }
    ]
  },

  "behavior": {
    "operations": {
      "addNotebookLibrary": {
        "label": "Add notebook library…",
        "icon": "mdi-notebook-outline",
        "for": "diagram",
        "params": { "path": { "type": "string", "required": true, "label": "Path" } },
        "paramsForm": "addLibrary",
        "actions": [
          { "abort": { "message": "'A library needs a path.'" }, "when": "p.path == ''" },
          { "abort": { "message": "'The notebook library \\'' + p.path + '\\' is already there.'" },
            "when": "diagram.nodesOfType('Library').exists(l, l.libraryKind == 'notebook' && l.path == p.path)" },
          { "create": { "type": "'Library'", "attributes": { "libraryKind": "'notebook'", "path": "p.path" } } }
        ]
      },
      "addFileLibrary": {
        "label": "Add file library…",
        "icon": "mdi-file-code-outline",
        "for": "diagram",
        "params": { "path": { "type": "string", "required": true, "label": "Path" } },
        "paramsForm": "addLibrary",
        "actions": [
          { "abort": { "message": "'A library needs a path.'" }, "when": "p.path == ''" },
          { "abort": { "message": "'The file library \\'' + p.path + '\\' is already there.'" },
            "when": "diagram.nodesOfType('Library').exists(l, l.libraryKind == 'file' && l.path == p.path)" },
          { "create": { "type": "'Library'", "attributes": { "libraryKind": "'file'", "path": "p.path" } } }
        ]
      },
      "addNotebookTaskHere": {
        "label": "Add notebook task here",
        "icon": "mdi-notebook-outline",
        "for": "diagram",
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "taskType": "notebook" } },
        "doc": "Runs the job reading's command of the same name, which adds a notebook task to a job of the file; the tool offers it under this reading too."
      },
      "addPythonTaskHere": {
        "label": "Add Python task here",
        "icon": "mdi-language-python",
        "for": "diagram",
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "taskType": "python" } },
        "doc": "Runs the job reading's command of the same name, which adds a Python task to a job of the file; the tool offers it under this reading too."
      },
      "addConditionTaskHere": {
        "label": "Add condition task here",
        "icon": "mdi-call-split",
        "for": "diagram",
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "taskType": "condition" } },
        "doc": "Runs the job reading's command of the same name, which adds a condition task to a job of the file; the tool offers it under this reading too."
      },
      "connectTasks": {
        "label": "Depend on",
        "icon": "mdi-ray-start-arrow",
        "for": "diagram",
        "params": {
          "from": { "type": "Element", "doc": "Where the gesture started." },
          "to": { "type": "Element", "doc": "Where the gesture ended." }
        },
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "connect": "dependency" } },
        "doc": "Runs the job reading's connect command, which the tool offers under this reading too."
      },
      "simulateUpdate": {
        "label": "Start update (simulated)",
        "icon": "mdi-play-outline",
        "for": ["Pipeline"],
        "simulate": {
          "for": ["Library", "Pipeline", "Destination"],
          "state": "simulated",
          "initial": "'pending'",
          "next": "cel.bind(r, rippleRank(self, updateMembers()), step == 2 * r + 1 ? 'running' : (step >= 2 * r + 2 ? 'succeeded' : 'pending'))",
          "until": "step >= 2 * updateMembers().size()",
          "stepMs": 700,
          "notice": { "running": "Simulated: pipeline update", "finished": "Simulated: pipeline update — finished" },
          "doc": "A mock update that ripples over the sources, the pipeline and its target, one element at a time in position order: each goes from pending to running to succeeded, one change every 700 ms. Nothing is written, nothing enters the undo history."
        }
      }
    }
  },

  "layout": {
    "algorithms": {
      "flow": {
        "algorithm": "plugin:net.etalii.adp.databricks.layout",
        "direction": "right",
        "options": { "reading": "pipeline", "sourceX": 0, "pipelineX": 320, "targetX": 640, "rowHeight": 120, "satelliteBandGap": 80 },
        "doc": "Sources stacked on the left, the pipeline and its target level with their middle, compute and notifications in a band beneath."
      },
      "layered": { "algorithm": "layered", "direction": "right", "doc": "The declarative approximation of flow, for a runtime without the plugin." }
    },
    "default": "flow",
    "trigger": "always",
    "respect": "all"
  },

  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/databricks/backend/EtAlii.Adp.Diagram.Databricks/databricks.fbl#configuration",
    "ids": {
      "strategy": "natural",
      "prefix": { "Library": "library:" },
      "pattern": "^[^\\r\\n]{1,512}$",
      "types": {
        "Pipeline": { "strategy": "derived", "expression": "'pipeline'" },
        "Destination": { "strategy": "derived", "expression": "'target'" },
        "Compute": { "strategy": "derived", "expression": "'compute'" },
        "Notifications": { "strategy": "derived", "expression": "'notifications'" }
      },
      "doc": "`library:<path>`, the fixed `pipeline`, `target`, `compute` and `notifications`, and the derived flows `flow:<path>->pipeline` and `flow:pipeline->target`."
    },
    "view": { "store": ["bounds"], "styleOverrides": "none" },
    "typeMap": {
      "Pipeline": { "as": "Pipeline" },
      "Library": { "as": "Library" },
      "Notification": { "as": "unreadable", "doc": "One notifications entry: the pipeline's one notifications node holds them all." }
    }
  },

  "plugins": {
    "net.etalii.adp.databricks.files": {
      "version": "^0.1.0",
      "provides": ["action"],
      "required": true,
      "doc": "Runs the job reading's commands that the tool offers under this reading too. The pipeline itself is read and written through the binding (persistence)."
    },
    "net.etalii.adp.databricks.layout": {
      "version": "^0.1.0",
      "provides": ["layout"],
      "required": false,
      "fallback": { "layout": "layered" },
      "args": {
        "reading": { "type": "string", "required": true },
        "sourceX": { "type": "number" },
        "pipelineX": { "type": "number" },
        "targetX": { "type": "number" },
        "rowHeight": { "type": "number" },
        "satelliteBandGap": { "type": "number" }
      },
      "doc": "The family's computed layouts."
    }
  },

  "x-databricks": {
    "doc": "Today's wire ids, which the standalone backend and client share, mapped from this specification's names, as x-ghg does for the hype cycle. A tool is keyed by its id. An action is keyed by its entry's operation, else its kind; a key \"<Type>/<kind>\" overrides that for the entries offered on <Type>. A property is keyed by its form item's row id: its id, else its attribute, else a computed item's label.",
    "tools": {
      "notebookLibrary": { "id": "databricks.toolbox.notebook-library", "drop": "databricks.add-library:notebook" },
      "fileLibrary": { "id": "databricks.toolbox.file-library", "drop": "databricks.add-library:file" }
    },
    "actions": {
      "addNotebookLibrary": "databricks.add-library:notebook",
      "addFileLibrary": "databricks.add-library:file",
      "Library/delete": "databricks.remove-library",
      "simulateUpdate": "databricks.simulated.pipeline-update",
      "addNotebookTaskHere": "databricks.add-task:notebook",
      "addPythonTaskHere": "databricks.add-task:python",
      "addConditionTaskHere": "databricks.add-task:condition",
      "connectTasks": "databricks.connect"
    },
    "properties": {
