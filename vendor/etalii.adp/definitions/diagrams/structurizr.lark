// The Structurizr DSL (https://docs.structurizr.com/dsl) in ATD grammar notation (ATD section 4), for the binding of
// structurizr.fbl: FBL 0.11's grammar family (FBL section 4.9). It reads what the C4 tool types read of a workspace:
// the eight element kinds, groups, deployment environments, relationships with or without a source, the six view
// kinds with their keys, and the view statements, and every other statement as an unbound generic one, kept byte for
// byte. Directives (!include, !identifiers, !docs) are statements too, never followed.
//
// - Line ends are tokens (_NL): the DSL is line-oriented, and a statement ends at its line's end. Horizontal
//   whitespace and the three comment forms are ignored; a block comment that is never closed runs to the end of the
//   body, which recover.unclosed reports. A `#` outside a string starts a comment wherever it stands, so a colour
//   written `#08427b` in a style is read as its statement's comment and kept as written.
// - Positional arguments are rules named by position (name, description, technology, tags, instances), so that a
//   slot selects each by name; an argument is quoted (STRING) or bare (WORD). Arguments past the last named one are
//   `extra`.
// - Keywords are strings matched in any case (`"group"i`), at WORD's priority, which WORD matches whole: a word is
//   read as WORD and is a keyword only when it is spelled as one and the parser's state can shift it, so that
//   `grouped` is an identifier and never `group` and `ed` (ATD section 3.6).
// - A block is "{" after a statement, and only the statements below open one (FBL section 4.9).

start: unit*

?unit: workspace
     | directive
     | _NL

workspace: _WORKSPACE [name [description]] _workspace_block
_workspace_block: "{" _workspace_item* "}"
_workspace_item: _workspace_statement _NL
               | _NL
_workspace_statement: model
                    | views
                    | directive
                    | generic

// ---------------------------------------------------------------------------------------------------------- the model

model: _MODEL _model_block
_model_block: "{" _model_item* "}"
_model_item: _model_statement _NL
           | _NL
_model_statement: person
                | software_system
                | container
                | component
                | deployment_environment
                | deployment_node
                | infrastructure_node
                | container_instance
                | software_system_instance
                | group
                | relationship
                | tags_statement
                | directive
                | generic

person: [identifier "="] _PERSON name [description [tags extra*]] [_model_block]
software_system: [identifier "="] _SOFTWARE_SYSTEM name [description [tags extra*]] [_model_block]
container: [identifier "="] _CONTAINER name [description [technology [tags extra*]]] [_model_block]
component: [identifier "="] _COMPONENT name [description [technology [tags extra*]]] [_model_block]
deployment_environment: [identifier "="] _DEPLOYMENT_ENVIRONMENT name [_model_block]
deployment_node: [identifier "="] _DEPLOYMENT_NODE name [description [technology [tags [instances extra*]]]] [_model_block]
infrastructure_node: [identifier "="] _INFRASTRUCTURE_NODE name [description [technology [tags extra*]]] [_model_block]
container_instance: [identifier "="] _CONTAINER_INSTANCE instance_of [deployment_groups [tags extra*]] [_model_block]
software_system_instance: [identifier "="] _SOFTWARE_SYSTEM_INSTANCE instance_of [deployment_groups [tags extra*]] [_model_block]
group: [identifier "="] _GROUP name [_model_block]
relationship: [identifier "="] [source] _ARROW destination [description [technology [tags extra*]]] [_model_block]
tags_statement: _TAGS tag*

identifier: WORD
source: WORD
destination: WORD
instance_of: WORD
name: _arg
description: _arg
technology: _arg
tags: _arg
instances: _arg
deployment_groups: _arg
tag: _arg
extra: _arg

// ---------------------------------------------------------------------------------------------------------- the views

views: _VIEWS _views_block
_views_block: "{" _views_item* "}"
_views_item: _views_statement _NL
           | _NL
_views_statement: system_landscape_view
                | system_context_view
                | container_view
                | component_view
                | dynamic_view
                | deployment_view
                | directive
                | generic

// A view written without a key is the rule's alias `<kind>_view_default`, whose key the binding gives.
system_landscape_view: _SYSTEM_LANDSCAPE key [description] _view_block
                     | _SYSTEM_LANDSCAPE _view_block -> system_landscape_view_default
system_context_view: _SYSTEM_CONTEXT scope key [description] _view_block
                   | _SYSTEM_CONTEXT scope _view_block -> system_context_view_default
container_view: _CONTAINER scope key [description] _view_block
              | _CONTAINER scope _view_block -> container_view_default
component_view: _COMPONENT scope key [description] _view_block
              | _COMPONENT scope _view_block -> component_view_default
dynamic_view: _DYNAMIC scope key [description] _view_block
            | _DYNAMIC scope _view_block -> dynamic_view_default
deployment_view: _DEPLOYMENT scope environment key [description] _view_block
               | _DEPLOYMENT scope environment _view_block -> deployment_view_default

scope: _arg
environment: _arg
key: _arg

_view_block: "{" _view_item* "}"
_view_item: _view_statement _NL
          | _NL
_view_statement: include_statement
               | exclude_statement
               | title_statement
               | auto_layout_statement
               | interaction
               | directive
               | generic

include_statement: _INCLUDE member*
exclude_statement: _EXCLUDE member*
title_statement: _TITLE title
auto_layout_statement: _AUTO_LAYOUT [direction [rank_separation [node_separation extra*]]]
interaction: [source] _ARROW destination [description [technology extra*]]

member: _arg
title: _arg
direction: _arg
rank_separation: _arg
node_separation: _arg

// ------------------------------------------------------------------------------------------- everything else, unbound

directive: DIRECTIVE _arg* [_generic_block]
generic: keyword _arg* [_generic_block]
       | STRING _arg* [_generic_block] -> string_statement
keyword: WORD

_generic_block: "{" _generic_item* "}"
_generic_item: _generic_statement _NL
             | _NL
_generic_statement: generic
                  | directive

_arg: STRING
    | WORD

// --------------------------------------------------------------------------------------------------------- terminals

_WORKSPACE: "workspace"i
_MODEL: "model"i
_VIEWS: "views"i
_PERSON: "person"i
_SOFTWARE_SYSTEM: "softwareSystem"i
_CONTAINER: "container"i
_COMPONENT: "component"i
_DEPLOYMENT_ENVIRONMENT: "deploymentEnvironment"i
_DEPLOYMENT_NODE: "deploymentNode"i
_INFRASTRUCTURE_NODE: "infrastructureNode"i
_CONTAINER_INSTANCE: "containerInstance"i
_SOFTWARE_SYSTEM_INSTANCE: "softwareSystemInstance"i
_GROUP: "group"i
_TAGS: "tags"i
_SYSTEM_LANDSCAPE: "systemLandscape"i
_SYSTEM_CONTEXT: "systemContext"i
_DYNAMIC: "dynamic"i
_DEPLOYMENT: "deployment"i
_INCLUDE: "include"i
_EXCLUDE: "exclude"i
_TITLE: "title"i
_AUTO_LAYOUT: "autoLayout"i

_ARROW: "->"
DIRECTIVE: /![A-Za-z]+/
STRING: /"([^"\\\r\n]|\\[^\r\n])*"/
// A bare word: no whitespace, quote, brace or "=", not starting with "#", "/" or "!", and holding no "->".
WORD: /([^ \t\r\n"{}=#\/!\-]|-[^ \t\r\n"{}=>\-])([^ \t\r\n"{}=\-]|-[^ \t\r\n"{}=>\-])*/

_NL: /(\r?\n[ \t]*)+/
WHITESPACE: /[ \t]+/
LINE_COMMENT: /\/\/[^\r\n]*/
HASH_COMMENT: /#[^\r\n]*/
BLOCK_COMMENT: /\/\*([^*]|\*+[^*\/])*(\*+\/)?/

%ignore WHITESPACE
%ignore LINE_COMMENT
%ignore HASH_COMMENT
%ignore BLOCK_COMMENT
