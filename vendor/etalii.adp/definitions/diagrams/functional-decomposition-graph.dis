{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.etalii.functional-decomposition-graph",
    "version": "0.2.0",
    "origin": "etalii/functional-decomposition-graph",
    "label": "Functional decomposition graph",
    "doc": {
      "summary": "What an application is made of - its screens, the actions on them, the data it keeps and the functions behind them - each owned by one parent, with Shows for where an action leads.",
      "description": "A functional decomposition graph structures frontend application development before and while it is built: which screens exist and how they nest, what a user can do on each, which data each screen and action works on, and which background processes sit behind them.\n\nFour kinds of element (UI Element, Data Element, Action, Function) are linked parent to child by four **ownership** relations, which together form a set of strict trees: every element has at most one parent and ownership never loops. A fifth relation, **Shows**, is navigation: an Action shows or updates one UI Element, and navigation may loop back (a task list, a task detail and back to the task list). Comments annotate the graph and connect to nothing. The `.fdg` document is read and written through the FBL binding the standalone module ships. What DISL 0.3 cannot state, the wire ids, is declared under `x-fdg`, and everything else DISL 0.3 cannot express is described in `functional-decomposition-graph.md` beside this file.",
      "rationale": "Because only meaningful links can be drawn, the diagram doubles as a check on the design: ownership stays a clean tree, while navigation is free to loop back.",
      "tags": ["frontend", "decomposition", "ui", "software delivery"],
      "audience": ["user", "author"],
      "seeAlso": [
        { "title": "What DISL cannot express for this tool", "href": "functional-decomposition-graph.md" }
      ]
    },
    "defaultLocale": "en",
    "authors": [{ "name": "Peter Vrenken" }],
    "license": "Apache-2.0",
    "homepage": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/functional-decomposition-graph",
    "icon": "mdi-file-tree-outline",
    "fileExtension": "fdg",
    "requires": {
      "conformance": "standard",
      "features": ["placement.bound", "shape.custom", "edge.bezier", "label.parse", "persistence.fbl"]
    }
  },

  "functions": {
    "documentTypeOf": {
      "params": [{ "name": "type", "type": "string" }],
      "returns": "string",
      "cel": "{'UiElement': 'ui-element', 'DataElement': 'data-element', 'Action': 'action', 'Function': 'function', 'Comment': 'comment', 'UiChild': 'ui-child', 'OwnsAction': 'owns-action', 'OwnsData': 'owns-data', 'OwnsFunction': 'owns-function', 'Shows': 'shows'}[type]",
      "doc": "The document's spelling of a type of this specification, as an entry's `type:` writes it (`UiChild` is `ui-child`). The tool's sentences name types this way."
    },
    "nameOf": {
      "params": [{ "name": "e", "type": "dyn" }],
      "returns": "string",
      "cel": "e.name != '' ? e.name : e.id",
      "doc": "An element as a refusal names it: its name, or its id when the name is empty (`FdgConnectVerdict.NameOf`)."
    },
    "sizeText": {
      "params": [{ "name": "a", "type": "double" }],
      "returns": "string",
      "cel": "string(math.round(a * 10000.0) / 10000.0)",
      "doc": "A width or height as the property grid shows it: at most four decimals and none when whole, such as `140`, `12.5` or `140.1235`, the same on every machine (`DslNumber.Format`, `0.####` in the invariant culture)."
    },
    "uniqueName": {
      "params": [{ "name": "base", "type": "string" }],
      "returns": "string",
      "uses": ["diagram"],
      "cel": "cel.bind(taken, diagram.nodes.map(n, n.name), !(base in taken) ? base : cel.bind(free, diagram.nodes.map(n, n.positionIn(diagram.nodes) + 2).filter(k, !((base + ' ' + string(k)) in taken)), base + ' ' + string(free.size() > 0 ? free[0] : diagram.nodes.size() + 2)))",
      "doc": {
        "summary": "`base` when no element carries it as its name yet, otherwise `base 2`, `base 3` and so on: the first number from 2 up that no element carries (`UniqueName.Of`).",
        "description": "Every element's `name` is counted, a Comment's stray `name` and an entry of an unknown type included, because the tool counts the name of every entry it read. The candidates 2 to N + 1, for N elements, are made from the elements' positions; when all of them are taken, N + 2 is free."
      }
    }
  },

  "metamodel": {
    "doc": "Five element types and five relation types, and two types for the entries the notation does not have. The four named element types are linked parent to child by the four ownership relations; Shows links an Action to the UI Element it shows; a Comment links to nothing. Every type carries the document's spelling of itself in `documentType`, which the tool's sentences use.",
    "types": {
      "FdgElement": {
        "abstract": true,
        "doc": "Everything that can be placed on a functional decomposition graph. Its top-left corner and its width are stored; the y axis grows downwards.",
        "attributes": {
          "description": {
            "type": "text",
            "label": "Description",
            "markup": "plain",
            "doc": {
              "summary": "What this element means. Kept in the document and shown in the property grid, but never drawn on the diagram.",
              "rationale": "Requirement 7.1 of the standalone specification: every element and connection has a Description that is never shown on the diagram."
            }
          },
          "x": { "type": "number", "default": 0, "unit": "canvas units", "doc": "The left edge. A value that does not read as a number keeps the element at zero." },
          "y": { "type": "number", "default": 0, "unit": "canvas units", "doc": "The top edge, downwards." },
          "width": {
            "type": "number",
            "label": "Width",
            "min": 80,
            "unit": "canvas units",
            "outOfRange": { "drag": "clamp", "typed": "clamp" },
            "doc": "At least 80. A width below 80 that is entered or dragged is written as 80, never refused; a stored one below 80 is kept, drawn and reported."
          },
          "documentType": { "type": "string", "readOnly": true, "doc": "The entry's `type:` as the document writes it. Fixed for every type the notation has; read from the file for an entry of a type it does not have." }
        }
      },
      "NamedElement": {
        "abstract": true,
        "extends": "FdgElement",
        "doc": "An element that shows its Name inside its shape: a UI Element, Data Element, Action or Function, and an entry of a type the notation does not have.",
        "labelAttribute": "name",
        "attributes": {
          "name": {
            "type": "string",
            "label": "Name",
            "doc": "Drawn inside the shape, editable in place and in the property grid. It may be empty."
          },
          "height": {
            "type": "number",
            "fixed": 48,
            "readOnlyReasons": ["Only a Comment has its own height; the others share one."],
            "doc": "The named types share one height of 48: read-only, never written to the `.fdg`, and a stored value is ignored."
          }
        }
      },
      "UiElement": {
        "extends": "NamedElement",
        "label": "UI element",
        "icon": "mdi-application-outline",
        "doc": {
          "summary": "A screen, or a part of one. Drop it where it belongs; its parent is a connection drawn to it.",
          "description": "UI windows, pages and components. A UI Element may own child UI Elements, Actions, Data Elements and Functions, and has at most one parent UI Element.",
          "tags": ["screen", "page", "component", "window"]
        },
        "attributes": { "documentType": { "type": "string", "fixed": "ui-element" } }
      },
      "DataElement": {
        "extends": "NamedElement",
        "label": "Data element",
        "icon": "mdi-database-outline",
        "doc": {
          "summary": "Something the application keeps. A screen, an action or other data owns it.",
          "description": "Input fields, data objects and collections shown in a list. A Data Element may own nested Data Elements (child properties) and Functions, and has at most one parent in total among UI Element, Action and Data Element.",
          "tags": ["data", "field", "object", "collection"]
        },
        "attributes": { "documentType": { "type": "string", "fixed": "data-element" } }
      },
      "Action": {
        "extends": "NamedElement",
        "label": "Action",
        "icon": "mdi-gesture-tap",
        "doc": {
          "summary": "Something the user does on a screen. A screen owns it.",
          "description": "Actions and interactions, for example a button click. An Action has at most one parent UI Element, may own Data Elements and Functions, and shows at most one UI Element.",
          "tags": ["action", "interaction", "click"]
        },
        "attributes": { "documentType": { "type": "string", "fixed": "action" } }
      },
      "Function": {
        "extends": "NamedElement",
        "label": "Function",
        "icon": "mdi-cog-outline",
        "doc": {
          "summary": "Something that runs behind the screens. Anything but a Comment may own it.",
          "description": "Background processes and important code functions. A Function has at most one parent in total among UI Element, Action, Data Element and Function; Function to Function is a call chain. A background process shared by several parents cannot be drawn: each parent needs its own Function.",
          "tags": ["function", "background process", "service"]
        },
        "attributes": { "documentType": { "type": "string", "fixed": "function" } }
      },
      "Comment": {
        "extends": "FdgElement",
        "label": "Comment",
        "icon": "mdi-note-text-outline",
        "labelAttribute": "text",
        "doc": {
          "summary": "A note on the graph. It connects to nothing.",
          "description": "A resizable, multiline box whose text wraps automatically. A Comment has no Name: its text is its content, editable in place and in the property grid.",
          "tags": ["note", "comment"]
        },
        "attributes": {
          "text": {
            "type": "text",
            "label": "Text",
            "markup": "plain",
            "doc": "The comment's content, drawn wrapped inside the box. Line breaks are kept."
          },
          "height": {
            "type": "number",
            "label": "Height",
            "min": 48,
            "unit": "canvas units",
            "outOfRange": { "drag": "clamp", "typed": "clamp" },
            "doc": "Stored only for a Comment, at least 48. A height below 48 that is entered or dragged is written as 48, never refused."
          },
          "name": {
            "type": "string",
            "readOnly": true,
            "readOnlyReasons": ["A Comment has no name; its text is its content."],
            "doc": "A `name` written on a Comment by hand. It is kept, shown nowhere and edited by nothing, and it counts when a new element is named (`uniqueName`)."
          },
          "documentType": { "type": "string", "fixed": "comment" }
        }
      },
      "UnknownElement": {
        "extends": "NamedElement",
        "label": "Unknown element",
        "doc": {
          "summary": "An entry of `elements:` whose `type:` names no element type of this notation, or that has none.",
          "description": "Kept byte for byte, never drawn, and reported. It has no tool, no notation and no creation: nothing makes one but a hand edit. Its id counts where ids are counted, and a connection to it is reported by the type check with the type it was written with. It is renamed, removed, resized and described like a named element."
        }
      }
    },
    "relations": {
      "FdgRelation": {
        "abstract": true,
        "doc": "Every link of a functional decomposition graph: directed, from parent to child, never from an element to itself, and never to or from a Comment.",
        "directed": true,
        "allowSelfLoops": false,
        "attributes": {
          "name": {
            "type": "string",
            "label": "Name",
            "doc": "Drawn beside the curve when given; when empty nothing is drawn."
          },
          "description": {
            "type": "text",
            "label": "Description",
            "markup": "plain",
            "doc": "What this link means. Never drawn on the diagram."
          },
          "documentType": { "type": "string", "readOnly": true, "doc": "The connection's `type:` as the document writes it." }
        }
      },
      "Ownership": {
        "abstract": true,
        "extends": "FdgRelation",
        "acyclic": true,
        "doc": {
          "summary": "Ownership: the four relations a decomposition is made of.",
          "description": "UI child, Action, Data and Function together form a set of strict trees. Each child kind has exactly one ownership relation arriving at it, and that relation allows one parent, so every element has at most one parent in total. `acyclic` on this abstract type covers all four subtypes together (4.9): no directed cycle may run through any mix of them. Shows is not ownership and is exempt.",
          "rationale": "The one-parent limits alone do not prevent a loop - a Data Element that owns another which owns it back has one parent each - so it is the cycle rule that keeps ownership loop-free."
        }
      },
      "UiChild": {
        "extends": "Ownership",
        "allowSelfLoops": false,
        "label": "UI child",
        "source": "UiElement",
        "target": { "types": ["UiElement"], "max": 1, "role": "child",
                    "doc": "A UI Element has at most one parent UI Element." },
        "doc": "A UI Element nested in another: a page holding a list, a list holding a row. A UI Element may have any number of UI children.",
        "attributes": { "documentType": { "type": "string", "fixed": "ui-child" } }
      },
      "OwnsAction": {
        "extends": "Ownership",
        "allowSelfLoops": false,
        "label": "Action",
        "source": "UiElement",
        "target": { "types": ["Action"], "max": 1, "role": "action",
                    "doc": "An Action has at most one parent." },
        "doc": "An Action offered by a UI Element, such as a button click. A UI Element may have any number of Actions.",
        "attributes": { "documentType": { "type": "string", "fixed": "owns-action" } }
      },
      "OwnsData": {
        "extends": "Ownership",
        "allowSelfLoops": false,
        "label": "Data",
        "source": ["UiElement", "Action", "DataElement"],
        "target": { "types": ["DataElement"], "max": 1, "role": "data",
                    "doc": "A Data Element has at most one parent in total." },
        "doc": "Data a UI Element shows or binds, data an Action works on, or a child property of a Data Element (nesting allowed). A parent may have any number of Data Elements.",
        "attributes": { "documentType": { "type": "string", "fixed": "owns-data" } }
      },
      "OwnsFunction": {
        "extends": "Ownership",
        "allowSelfLoops": false,
        "label": "Function",
        "source": ["UiElement", "Action", "DataElement", "Function"],
        "target": { "types": ["Function"], "max": 1, "role": "function",
                    "doc": "A Function has at most one parent in total." },
        "doc": "A background process or important code function that relates to its parent. Function to Function is a call chain. A parent may have any number of Functions.",
        "attributes": { "documentType": { "type": "string", "fixed": "owns-function" } }
      },
      "Shows": {
        "extends": "FdgRelation",
        "allowSelfLoops": false,
        "label": "Shows",
        "source": { "types": ["Action"], "max": 1, "role": "action",
                    "doc": "An Action shows or updates at most one UI Element." },
        "target": { "types": ["UiElement"], "role": "shown" },
        "doc": {
          "summary": "An Action shows a page, or updates a UI Element.",
          "description": "Navigation, not ownership: it is exempt from the cycle rule, so an Action may show its own page or any page above it, and a navigation round trip can be drawn. A UI Element may be shown by any number of Actions."
        },
        "attributes": { "documentType": { "type": "string", "fixed": "shows" } }
      },
      "UnknownConnection": {
        "extends": "FdgRelation",
        "allowSelfLoops": false,
        "label": "Unknown connection",
        "source": ["FdgElement"],
        "target": ["FdgElement"],
        "doc": {
          "summary": "An entry of `connections:` whose `type:` names no relation of this notation, or that has none.",
          "description": "Kept byte for byte, never drawn, and reported. It has no tool, no notation and no connect gesture: nothing makes one but a hand edit. Its id counts where ids are counted. It is renamed, removed and described like any connection."
        }
      }
    }
  },

  "coordinates": {
    "doc": "One free canvas in canvas units. Positions are the author's and are never computed; nothing snaps.",
    "systems": {
      "canvas": { "kind": "cartesian", "x": { "kind": "linear" }, "y": { "kind": "linear" },
                  "doc": "The top-left corner of each element is stored; the y axis grows downwards." }
    }
  },

  "notation": {
    "doc": "Each element type is recognisable at a glance by its shape and its fill. Four types share one height of 48 and differ in width; a Comment is sized freely. An entry of a type the notation does not have is not drawn.",
    "theme": {
      "tokens": {
        "color.text": "#0f172a",
        "color.surface": "#ffffff",
        "color.border": "#e2e8f0",
        "color.fdg.ui-element": "#aaed92",
        "color.fdg.data-element": "#ededed",
        "color.fdg.action": "#9edcfa",
        "color.fdg.function": "#86e6d9",
        "color.fdg.comment": "#fcf281"
      },
      "modes": {
        "dark": {
          "color.text": "#f1f5f9",
          "color.surface": "#1e293b",
          "color.border": "#334155",
          "color.fdg.ui-element": "#2e7814",
          "color.fdg.data-element": "#696969",
          "color.fdg.action": "#086fa1",
          "color.fdg.function": "#187569",
          "color.fdg.comment": "#736a03"
        }
      },
      "defaultMode": "light",
      "followSystem": true,
      "contrast": [
        {
          "foreground": "color.text",
          "background": ["color.fdg.ui-element", "color.fdg.data-element", "color.fdg.action", "color.fdg.function", "color.fdg.comment"],
          "minRatio": 4.5,
          "doc": "The fills were chosen for text contrast against the text colour in both themes."
        }
      ],
      "doc": {
        "summary": "Light mode uses the requested colours exactly; dark mode uses a darker variant of each hue.",
        "rationale": "Each dark variant keeps the light colour's hue and saturation with the lightness lowered to the lightest value that reaches 5.0:1 against the dark text, a margin above the 4.5:1 WCAG AA line. The light fills reach 11.96:1 to 15.44:1 against the light text."
      }
    },

    "styles": {
      "element": {
        "stroke": { "color": { "token": "color.border" }, "width": 1.5 },
        "font": { "size": 12, "color": { "token": "color.text" } },
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "uiElement": { "extends": "element", "fill": { "token": "color.fdg.ui-element" } },
      "dataElement": { "extends": "element", "fill": { "token": "color.fdg.data-element" } },
      "action": { "extends": "element", "fill": { "token": "color.fdg.action" } },
      "function": { "extends": "element", "fill": { "token": "color.fdg.function" } },
      "comment": { "extends": "element", "fill": { "token": "color.fdg.comment" } },
      "link": {
        "stroke": { "color": { "token": "color.text" }, "width": 1.5 },
        "font": { "size": 12, "color": { "token": "color.text" } }
      }
    },

    "shapes": {
      "diode": {
        "label": "Diode",
        "doc": "Square on the left and round on the right: a rectangle from the left edge to w - r, closed on the right by a semicircle of radius r = min(h / 2, w). Just a fill and a border, no other ornaments. A custom shape is exact here, so DISL needs no built-in for it (6.7).",
        "path": { "segments": [
          { "op": "M", "x": 0, "y": 0 },
          { "op": "L", "x": "w - min(h / 2.0, w)", "y": 0 },
          { "op": "A", "rx": "min(h / 2.0, w)", "ry": "min(h / 2.0, w)", "rotation": 0, "largeArc": false, "sweep": true,
            "x": "w - min(h / 2.0, w)", "y": "h" },
          { "op": "L", "x": 0, "y": "h" },
          { "op": "Z" }
        ] },
        "textArea": { "x": 6, "y": "h * 0.25", "w": "w - 0.134 * min(h / 2.0, w) - 12", "h": "h * 0.5" }
      }
    },

    "nodes": {
      "UiElement": {
        "shape": { "type": "superellipse", "params": { "exponent": 4 } },
        "style": "uiElement",
        "size": { "default": [160, 48], "min": [80, 48], "max": [null, 48], "width": { "attribute": "width" }, "height": { "attribute": "height" }, "resizable": "horizontal" },
        "placement": { "system": "canvas", "x": { "attribute": "x" }, "y": { "attribute": "y" }, "anchor": "top-left", "movable": true, "resizable": { "x": true, "y": false } },
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "editable": "inline", "wrap": "none", "overflow": "ellipsis" } ],
        "anchors": { "mode": "outline" },
        "doubleClick": "editLabel",
        "doc": "A superellipse with exponent 4, filled with the UI Element colour."
      },
      "DataElement": {
        "shape": { "type": "parallelogram", "params": { "skew": 0.2, "direction": "right" } },
        "style": "dataElement",
        "size": { "default": [160, 48], "min": [80, 48], "max": [null, 48], "width": { "attribute": "width" }, "height": { "attribute": "height" }, "resizable": "horizontal" },
        "placement": { "system": "canvas", "x": { "attribute": "x" }, "y": { "attribute": "y" }, "anchor": "top-left", "movable": true, "resizable": { "x": true, "y": false } },
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "editable": "inline", "wrap": "none", "overflow": "ellipsis" } ],
        "anchors": { "mode": "outline" },
        "doubleClick": "editLabel",
        "doc": "A parallelogram with its top shifted right relative to its bottom, by a fifth of the width: corners at (0.2, 0), (1, 0), (0.8, 1) and (0, 1) of the bounds. Filled with the Data Element colour."
      },
      "Action": {
        "shape": { "type": "trapezoid", "params": { "inset": 0.15, "direction": "down" } },
        "style": "action",
        "size": { "default": [160, 48], "min": [80, 48], "max": [null, 48], "width": { "attribute": "width" }, "height": { "attribute": "height" }, "resizable": "horizontal" },
        "placement": { "system": "canvas", "x": { "attribute": "x" }, "y": { "attribute": "y" }, "anchor": "top-left", "movable": true, "resizable": { "x": true, "y": false } },
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "editable": "inline", "wrap": "none", "overflow": "ellipsis" } ],
        "anchors": { "mode": "outline" },
        "doubleClick": "editLabel",
        "doc": "A trapezoid narrower at the bottom than the top: corners at (0, 0), (1, 0), (0.85, 1) and (0.15, 1) of the bounds. Both parameters are stated because DISL's defaults (an inset of 0.2, the narrow side at the top) differ. Filled with the Action colour."
      },
      "Function": {
        "shape": "diode",
        "style": "function",
        "size": { "default": [160, 48], "min": [80, 48], "max": [null, 48], "width": { "attribute": "width" }, "height": { "attribute": "height" }, "resizable": "horizontal" },
        "placement": { "system": "canvas", "x": { "attribute": "x" }, "y": { "attribute": "y" }, "anchor": "top-left", "movable": true, "resizable": { "x": true, "y": false } },
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "editable": "inline", "wrap": "none", "overflow": "ellipsis" } ],
        "anchors": { "mode": "outline" },
        "doubleClick": "editLabel",
        "doc": "A diode, square on the left and round on the right, filled with the Function colour."
      },
      "Comment": {
        "shape": "rect",
        "style": "comment",
        "size": { "default": [240, 96], "min": [80, 48], "width": { "attribute": "width" }, "height": { "attribute": "height" }, "resizable": true },
        "placement": { "system": "canvas", "x": { "attribute": "x" }, "y": { "attribute": "y" }, "anchor": "top-left", "movable": true, "resizable": true },
        "labels": [ { "id": "text", "text": { "attribute": "text" }, "editable": "multiline", "wrap": "word",
                      "maxWidth": "parent", "overflow": "ellipsis" } ],
        "connectable": false,
        "doubleClick": "editLabel",
        "doc": "A box filled with the Comment colour, resizable in both directions, its text wrapped inside it and centred, as the element labels are; text that does not fit ends in an ellipsis and its whole is shown on hover. It has no anchors: no connection starts or ends on it and it is never highlighted as a target."
      }
    },

    "edges": {
      "UiChild": { "style": "link",
        "line": { "routing": "bezier", "startDirection": "normal", "endDirection": "normal", "bendpoints": { "editable": false } },
        "sourceMarker": "none", "targetMarker": "arrowFilled",
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "at": "middle", "side": "above", "editable": "inline" } ],
        "connect": { "pointer": { "button": "secondary", "start": "body" } } },
      "OwnsAction": { "style": "link",
        "line": { "routing": "bezier", "startDirection": "normal", "endDirection": "normal", "bendpoints": { "editable": false } },
        "sourceMarker": "none", "targetMarker": "arrowFilled",
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "at": "middle", "side": "above", "editable": "inline" } ],
        "connect": { "pointer": { "button": "secondary", "start": "body" } } },
      "OwnsData": { "style": "link",
        "line": { "routing": "bezier", "startDirection": "normal", "endDirection": "normal", "bendpoints": { "editable": false } },
        "sourceMarker": "none", "targetMarker": "arrowFilled",
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "at": "middle", "side": "above", "editable": "inline" } ],
        "connect": { "pointer": { "button": "secondary", "start": "body" } } },
      "OwnsFunction": { "style": "link",
        "line": { "routing": "bezier", "startDirection": "normal", "endDirection": "normal", "bendpoints": { "editable": false } },
        "sourceMarker": "none", "targetMarker": "arrowFilled",
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "at": "middle", "side": "above", "editable": "inline" } ],
        "connect": { "pointer": { "button": "secondary", "start": "body" } } },
      "Shows": { "style": "link",
        "line": { "routing": "bezier", "startDirection": "normal", "endDirection": "normal", "bendpoints": { "editable": false } },
        "sourceMarker": "none", "targetMarker": "arrowFilled",
        "labels": [ { "id": "name", "text": { "attribute": "name" }, "at": "middle", "side": "above", "editable": "inline" } ],
        "connect": { "pointer": { "button": "secondary", "start": "body" } },
        "doc": "Drawn as the ownership links are, solid. Every relation is drawn by a right-button drag from one element's body to another's; which of the five the drag makes follows from the two ends, because each relation is told apart by its target type (see the companion, gap 7)." }
    }
  },

  "forms": {
    "namedElement": {
      "for": ["NamedElement"],
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "label": "Identity", "items": [
          { "attribute": "name", "label": "Name" },
          { "attribute": "description", "label": "Description", "widget": "textarea" }
        ] },
        { "kind": "section", "label": "Size", "items": [
          {
            "attribute": "width",
            "label": "Width",
            "widget": "text",
            "display": { "cel": "sizeText(self.width)" },
            "parse": {
              "accepts": "value.trim().matches('^[-+]?([0-9]+\\\\.?[0-9]*|\\\\.[0-9]+)([eE][-+]?[0-9]+)?$') && double(value.trim()) > 0.0",
              "write": [ { "set": { "width": "double(value.trim())" } } ],
              "refusal": { "cel": "'\\'' + value + '\\' is not a size this graph can draw.'" },
              "doc": "The route a canvas resize takes. A positive number is accepted and a width below 80 is written as 80 (`outOfRange`); anything else is refused, naming the value."
            }
          }
        ] }
      ]
    },
    "comment": {
      "for": "Comment",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "label": "Identity", "items": [
          { "attribute": "text", "label": "Text", "widget": "textarea" },
          { "attribute": "description", "label": "Description", "widget": "textarea" }
        ] },
        { "kind": "section", "label": "Size", "items": [
          {
            "attribute": "width",
            "label": "Width",
            "widget": "text",
            "display": { "cel": "sizeText(self.width)" },
            "parse": {
              "accepts": "value.trim().matches('^[-+]?([0-9]+\\\\.?[0-9]*|\\\\.[0-9]+)([eE][-+]?[0-9]+)?$') && double(value.trim()) > 0.0",
              "write": [ { "set": { "width": "double(value.trim())" } } ],
              "refusal": { "cel": "'\\'' + value + '\\' is not a size this graph can draw.'" }
            }
          },
          {
            "attribute": "height",
            "label": "Height",
            "widget": "text",
            "display": { "cel": "sizeText(self.height)" },
            "parse": {
              "accepts": "value.trim().matches('^[-+]?([0-9]+\\\\.?[0-9]*|\\\\.[0-9]+)([eE][-+]?[0-9]+)?$') && double(value.trim()) > 0.0",
              "write": [ { "set": { "height": "double(value.trim())" } } ],
              "refusal": { "cel": "'\\'' + value + '\\' is not a size this graph can draw.'" },
              "doc": "A height below 48 is written as 48 (`outOfRange`)."
            }
          }
        ] }
      ]
    },
    "connection": {
      "for": ["FdgRelation"],
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "label": "Identity", "items": [
          { "attribute": "name", "id": "connectionName", "label": "Name" },
          { "attribute": "description", "label": "Description", "widget": "textarea" }
        ] }
      ]
    }
  },

  "toolbox": {
    "groups": [
      { "id": "elements", "label": "Elements", "tools": [
        { "id": "uiElement", "creates": "UiElement", "label": "UI element", "icon": "mdi-application-outline", "mode": "drop", "after": "select",
          "initial": {
            "name": { "cel": "uniqueName('New UI element')" },
            "x": { "cel": "double(position.x) - 80.0" },
            "y": { "cel": "double(position.y) - 24.0" },
            "width": 160
          },
          "doc": "A screen, or a part of one. Drop it where it belongs; its parent is a connection drawn to it." },
        { "id": "action", "creates": "Action", "label": "Action", "icon": "mdi-gesture-tap", "mode": "drop", "after": "select",
          "initial": {
            "name": { "cel": "uniqueName('New action')" },
            "x": { "cel": "double(position.x) - 80.0" },
            "y": { "cel": "double(position.y) - 24.0" },
            "width": 160
          },
          "doc": "Something the user does on a screen. A screen owns it." },
        { "id": "dataElement", "creates": "DataElement", "label": "Data element", "icon": "mdi-database-outline", "mode": "drop", "after": "select",
          "initial": {
            "name": { "cel": "uniqueName('New data element')" },
            "x": { "cel": "double(position.x) - 80.0" },
            "y": { "cel": "double(position.y) - 24.0" },
            "width": 160
          },
          "doc": "Something the application keeps. A screen, an action or other data owns it." },
        { "id": "function", "creates": "Function", "label": "Function", "icon": "mdi-cog-outline", "mode": "drop", "after": "select",
          "initial": {
            "name": { "cel": "uniqueName('New function')" },
            "x": { "cel": "double(position.x) - 80.0" },
            "y": { "cel": "double(position.y) - 24.0" },
            "width": 160
          },
          "doc": "Something that runs behind the screens. Anything but a Comment may own it." },
        { "id": "comment", "creates": "Comment", "label": "Comment", "icon": "mdi-note-text-outline", "mode": "drop", "after": "select",
          "initial": {
            "text": "New comment",
            "x": { "cel": "double(position.x) - 120.0" },
            "y": { "cel": "double(position.y) - 48.0" },
            "width": 240,
            "height": 96
          },
          "doc": "A note on the graph. It connects to nothing." }
      ],
      "doc": "Five drop tools and no link tool: a relation is drawn by a right-button drag from one element's body to another's. A dropped element is centred on the drop point; its top-left corner is stored." }
    ],
    "contextMenus": [
      { "for": ["NamedElement"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "editLabel", "label": "Rename…", "icon": "mdi-pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove", "icon": "mdi-delete-outline", "shortcut": "Delete" }
      ] },
      { "for": ["Comment"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "editLabel", "label": "Edit text…", "icon": "mdi-pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove", "icon": "mdi-delete-outline", "shortcut": "Delete" }
      ] },
      { "for": ["FdgRelation"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "editLabel", "label": "Rename…", "icon": "mdi-pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove connection", "icon": "mdi-vector-polyline-remove", "shortcut": "Delete" }
      ] },
      { "for": ["diagram"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "addUiElementHere", "label": "Add ui element here", "icon": "mdi-plus" },
        { "kind": "operation", "operation": "addDataElementHere", "label": "Add data element here", "icon": "mdi-plus" },
        { "kind": "operation", "operation": "addActionHere", "label": "Add action here", "icon": "mdi-plus" },
        { "kind": "operation", "operation": "addFunctionHere", "label": "Add function here", "icon": "mdi-plus" },
        { "kind": "operation", "operation": "addCommentHere", "label": "Add comment here", "icon": "mdi-plus" }
      ],
        "doc": "A placement: the empty canvas at a point. The five entries follow the order of the tool's element types (`FdgElementTypes.All`), which is not the palette's." },
      { "for": ["connection"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "connect", "via": "UiChild", "label": "ui child", "icon": "mdi-ray-start-arrow", "args": { "relation": "'UiChild'" } },
        { "kind": "connect", "via": "OwnsAction", "label": "owns action", "icon": "mdi-ray-start-arrow", "args": { "relation": "'OwnsAction'" } },
        { "kind": "connect", "via": "OwnsData", "label": "owns data", "icon": "mdi-ray-start-arrow", "args": { "relation": "'OwnsData'" } },
        { "kind": "connect", "via": "OwnsFunction", "label": "owns function", "icon": "mdi-ray-start-arrow", "args": { "relation": "'OwnsFunction'" } },
        { "kind": "connect", "via": "Shows", "label": "shows", "icon": "mdi-ray-start-arrow", "args": { "relation": "'Shows'" } }
      ],
        "doc": "A finished connect gesture: all five relations are offered whatever the two ends are, labelled with the document's spelling of the relation; one the checks refuse is refused when chosen. `args.relation` names the relation for the wire id (`x-fdg`)." }
    ]
  },

  "constraints": {
    "doc": "The rules are declared on the metamodel: the relations' endpoints and limits, no self-links, the cycle rule on ownership, and the least width and Comment height. A document edited outside ADP that breaks them still opens, and each breach is reported with the tool's code and sentence. A connect gesture is checked in DISL's order (8.4) - type (`std.endpoints`), then cardinality (`std.multiplicity`), then cycle (`std.acyclic`) - and the first refusal is shown, in the tool's words.",
    "blockSaveOn": "never",
    "order": [
      "fdg.duplicate-id", "fdg.unreadable-entry", "fdg.dangling-reference", "fdg.self-link", "fdg.forbidden-link",
      "fdg.second-parent", "fdg.second-shows", "fdg.ownership-cycle"
    ],
    "builtIn": {
      "std.endpoints": {
        "severity": "error",
        "code": { "cel": "detail.?violation.orValue(self.source == self.target ? 'selfLoop' : 'target') == 'selfLoop' ? 'fdg.self-link' : 'fdg.forbidden-link'" },
        "message": { "cel": "detail.?violation.orValue(self.source == self.target ? 'selfLoop' : 'target') == 'selfLoop' ? '`' + self.id + '` links `' + self.source.id + '` to itself; no relation allows that.' : '`' + self.documentType + '` does not admit a link from a ' + self.source.documentType + ' to a ' + self.target.documentType + '.'" },
        "refusal": { "cel": "source == target ? 'Refused by the type check: no relation links an element to itself.' : 'Refused by the type check: `' + documentTypeOf(relationType) + '` does not link a ' + source.documentType + ' to a ' + target.documentType + '.'" },
        "doc": "Covers fdg.self-link and fdg.forbidden-link for a pair of ends the relation does not admit. A connection of a relation the notation does not have is fdg.forbidden-link by the rule unknownRelation."
      },
      "std.multiplicity": {
        "severity": "error",
        "code": { "cel": "detail.relationType == 'Shows' ? 'fdg.second-shows' : 'fdg.second-parent'" },
        "message": { "cel": "'`' + self.id + '` has ' + string(detail.count) + ' `' + documentTypeOf(detail.relationType) + '` ' + (detail.relationType == 'Shows' ? 'links' : 'parents') + '; it may have ' + string(detail.max) + '.'" },
        "refusal": { "cel": "violation.end == 'source' ? 'Refused by the cardinality check: `' + nameOf(source) + '` already has its `' + documentTypeOf(violation.relationType) + '` link, and may have ' + string(violation.max) + '.' : 'Refused by the cardinality check: `' + nameOf(target) + '` already has its `' + documentTypeOf(violation.relationType) + '` parent, and may have ' + string(violation.max) + '.'" },
        "doc": "Covers fdg.second-parent (a target end's `max` of the four ownership relations) and fdg.second-shows (the source end's `max` of Shows, the only source limit)."
      },
      "std.acyclic": {
        "severity": "error",
        "code": "fdg.ownership-cycle",
        "message": { "cel": "cel.bind(c, detail.?cycle.orValue([]), cel.bind(least, c.filter(e, c.all(o, o.id >= e.id)), least.size() == 0 ? 'Ownership loops.' : cel.bind(p, least[0].positionIn(c), 'Ownership loops: ' + c.map(e, c[(e.positionIn(c) + p) % c.size()].id).join(' -> ') + ' -> ' + least[0].id + '.')))" },
        "refusal": { "cel": "'Refused by the cycle check: `' + nameOf(target) + '` already owns `' + nameOf(source) + '`, so this link would make an ownership loop.'" },
        "doc": "Over Ownership and all four of its subtypes; Shows is exempt. A loop is one finding, its members in loop order from the one with the least id: \"Ownership loops: a -> b -> a.\" 8.7 binds no `cycle` in this built-in's `detail`, so the message reads it optionally (see the companion, gap 12)."
      },
      "std.references": {
        "severity": "error",
        "code": "fdg.dangling-reference",
        "message": { "cel": "'`' + self.id + '` names `' + detail.missingId + '`, which is not an element in this document.'" }
      },
      "std.duplicateId": {
        "severity": "error",
        "code": "fdg.duplicate-id",
        "message": { "cel": "'`' + detail.id + '` is declared ' + string(detail.?count.orValue(2)) + ' times; an id names one entry.'" },
        "oncePerGroup": "last",
        "doc": "Ids are unique across elements and connections together. An id held several times is reported once, on its last holder, with the count; an edit and the canvas go to its first holder."
      },
      "std.facets": {
        "severity": "warning",
        "code": "fdg.unreadable-entry",
        "message": { "cel": "detail.attribute == 'height' ? '`' + self.id + '` is ' + string(self.height) + ' tall; a Comment\\'s minimum is 48.' : '`' + self.id + '` is ' + string(self.width) + ' wide; the minimum is 80.'" },
        "doc": "A stored width below 80, or a Comment's height below 48, is kept, drawn and reported as a warning. The number is written as the document has it, the same on every machine."
      },
      "std.unreadableEntry": {
        "code": "fdg.unreadable-entry",
        "message": { "cel": "detail.reason" },
        "doc": "The reader's own sentences: a key it does not read, a `name` on a Comment, an entry that is not a mapping, a number that does not read, and the header's."
      },
      "std.unparseable": {
        "severity": "warning",
        "code": "fdg.unreadable-entry",
        "message": { "cel": "'The document could not be read as YAML: ' + detail.reason" }
      },
      "std.missingId": {
        "enabled": false,
        "doc": "An entry without an id is read with an empty one and reported by nothing, as today (held to today's findings by the standalone conversion's Q4)."
      }
    },
    "rules": [
      {
        "id": "unknownElementType",
        "code": "fdg.unreadable-entry",
        "scope": "UnknownElement",
        "rule": "false",
        "severity": "warning",
        "message": { "cel": "'`' + self.documentType + '` is not an element type this module knows.'" }
      },
      {
        "id": "unknownRelationType",
        "code": "fdg.unreadable-entry",
        "scope": "UnknownConnection",
        "rule": "false",
        "severity": "warning",
        "message": { "cel": "'`' + self.documentType + '` is not a relation this module knows.'" }
      },
      {
        "id": "unknownRelation",
        "code": "fdg.forbidden-link",
        "scope": "UnknownConnection",
        "rule": "false",
        "severity": "error",
        "message": { "cel": "'`' + self.id + '` names the relation `' + self.documentType + '`, which this notation does not have.'" }
      }
    ]
  },

  "behavior": {
    "doc": "Every change - add, remove, move, resize, connect, disconnect, rename, set a description - is one undoable step.",
    "operations": {
      "addUiElementHere": {
        "label": "Add ui element here",
        "icon": "mdi-plus",
        "for": "diagram",
        "actions": [ { "create": { "type": "'UiElement'", "at": "position", "attributes": {
          "name": "uniqueName('New UI element')", "x": "double(position.x) - 80.0", "y": "double(position.y) - 24.0", "width": "160.0"
        } } } ],
        "doc": "Adds at the point that was clicked, as a toolbox drop there would."
      },
      "addDataElementHere": {
        "label": "Add data element here",
        "icon": "mdi-plus",
        "for": "diagram",
        "actions": [ { "create": { "type": "'DataElement'", "at": "position", "attributes": {
          "name": "uniqueName('New data element')", "x": "double(position.x) - 80.0", "y": "double(position.y) - 24.0", "width": "160.0"
        } } } ]
      },
      "addActionHere": {
        "label": "Add action here",
        "icon": "mdi-plus",
        "for": "diagram",
        "actions": [ { "create": { "type": "'Action'", "at": "position", "attributes": {
          "name": "uniqueName('New action')", "x": "double(position.x) - 80.0", "y": "double(position.y) - 24.0", "width": "160.0"
        } } } ]
      },
      "addFunctionHere": {
        "label": "Add function here",
        "icon": "mdi-plus",
        "for": "diagram",
        "actions": [ { "create": { "type": "'Function'", "at": "position", "attributes": {
          "name": "uniqueName('New function')", "x": "double(position.x) - 80.0", "y": "double(position.y) - 24.0", "width": "160.0"
        } } } ]
      },
      "addCommentHere": {
        "label": "Add comment here",
        "icon": "mdi-plus",
        "for": "diagram",
        "actions": [ { "create": { "type": "'Comment'", "at": "position", "attributes": {
          "text": "'New comment'", "x": "double(position.x) - 120.0", "y": "double(position.y) - 48.0", "width": "240.0", "height": "96.0"
        } } } ]
      }
    },
    "deletion": {
      "FdgElement": {
        "relations": "delete",
        "confirm": {
          "count": "self.incoming.size() + self.outgoing.filter(r, r.target != self).size()",
          "threshold": 1,
          "title": "Remove",
          "message": { "cel": "'Removing this element also removes the ' + string(count) + (count == 1 ? ' connection' : ' connections') + ' to or from it.'" },
          "confirmLabel": "Remove",
          "danger": true,
          "doc": "Removing an element also removes every connection to or from it, in the same undoable step. It asks first only when there is such a connection, naming how many; a Comment connects to nothing and never asks."
        }
      }
    }
  },

  "layout": {
    "trigger": "manual",
    "respect": "all",
    "doc": "No automatic layout: positions are the author's own, written to the document and never computed."
  },

  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/functional-decomposition-graph/backend/EtAlii.Adp.Diagram.FunctionalDecompositionGraph/functional-decomposition-graph.fbl#fdg",
    "ids": {
      "strategy": "uuid-v4",
      "encoding": "base36",
      "stable": true,
      "doc": "New entries get a ShortGuid: a version 4 GUID written as 25 characters of base 36. Hand-written ids such as `task-detail` are any token and are kept as written. Ids are unique across elements and connections together."
    },
    "view": { "store": [] },
    "typeMap": {
      "Graph": { "as": "header", "doc": "The `functional-decomposition-graph: 1` header, read as an element of its own." },
      "UiElement": { "as": "UiElement", "hostAttributes": ["storedId", "unknownKeys"] },
      "DataElement": { "as": "DataElement", "hostAttributes": ["storedId", "unknownKeys"] },
      "Action": { "as": "Action", "hostAttributes": ["storedId", "unknownKeys"] },
      "Function": { "as": "Function", "hostAttributes": ["storedId", "unknownKeys"] },
      "Comment": { "as": "Comment", "attributes": { "strayName": "name" }, "hostAttributes": ["storedId", "unknownKeys"] },
      "UnknownElement": { "as": "UnknownElement", "hostAttributes": ["storedId", "unknownKeys"],
        "doc": "The catch-all rule for an entry of `elements:` whose type the notation does not have. It stays in the model, so its id is counted and a connection to it is reported by the type check." },
      "UiChild": { "as": "UiChild", "attributes": { "from": "source", "to": "target" }, "hostAttributes": ["storedId", "unknownKeys"] },
      "OwnsAction": { "as": "OwnsAction", "attributes": { "from": "source", "to": "target" }, "hostAttributes": ["storedId", "unknownKeys"] },
      "OwnsData": { "as": "OwnsData", "attributes": { "from": "source", "to": "target" }, "hostAttributes": ["storedId", "unknownKeys"] },
      "OwnsFunction": { "as": "OwnsFunction", "attributes": { "from": "source", "to": "target" }, "hostAttributes": ["storedId", "unknownKeys"] },
      "Shows": { "as": "Shows", "attributes": { "from": "source", "to": "target" }, "hostAttributes": ["storedId", "unknownKeys"] },
      "UnknownConnection": { "as": "UnknownConnection", "attributes": { "from": "source", "to": "target" }, "hostAttributes": ["storedId", "unknownKeys"],
        "doc": "The catch-all rule for an entry of `connections:` whose relation the notation does not have. It stays in the model, so its id is counted." },
      "Unreadable": { "as": "unreadable", "doc": "An entry that is not a mapping." }
    },
    "doc": "A functional decomposition graph is a `.fdg` file of ADP's own YAML: a version header, then its elements and connections, registered by an `.adp` file whose origin is etalii/functional-decomposition-graph. The FBL binding's element types and attributes are mapped onto this metamodel; a connection is read as an element with reference attributes, so one whose end names nothing is kept and reported. A document ADP did not change is written back byte-identical, and an edit splices only what it changes."
  },

  "x-fdg": {
    "doc": "Today's wire ids, which the standalone client (client/fdgIds.ts) and backend share, mapped from this specification's names, as x-ghg does for the hype cycle. A tool is keyed by its id. An action is keyed by its entry's operation, else its kind; a key \"<Type>/<kind>\" overrides that for the entries offered on <Type> or its subtypes, and a <name> in an id is replaced by the entry's argument of that name, mapped through types. A property is keyed by its form item's id, else its attribute. An element's wire id is the id written in the document, with no prefix.",
    "tools": {
      "uiElement": { "id": "fdg.toolbox.ui-element", "drop": "fdg.add.ui-element" },
      "action": { "id": "fdg.toolbox.action", "drop": "fdg.add.action" },
      "dataElement": { "id": "fdg.toolbox.data-element", "drop": "fdg.add.data-element" },
      "function": { "id": "fdg.toolbox.function", "drop": "fdg.add.function" },
      "comment": { "id": "fdg.toolbox.comment", "drop": "fdg.add.comment" }
    },
    "actions": {
      "editLabel": "fdg.rename",
      "delete": "fdg.remove",
      "FdgRelation/editLabel": "fdg.rename-connection",
      "FdgRelation/delete": "fdg.disconnect",
      "addUiElementHere": "fdg.add.ui-element",
      "addDataElementHere": "fdg.add.data-element",
      "addActionHere": "fdg.add.action",
      "addFunctionHere": "fdg.add.function",
      "addCommentHere": "fdg.add.comment",
      "connect": "fdg.connect.<relation>"
    },
    "properties": {
      "name": "fdg.name",
      "text": "fdg.text",
