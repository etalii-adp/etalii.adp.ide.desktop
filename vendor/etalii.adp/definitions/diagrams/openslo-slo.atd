atd 0.1

/// A service's objectives as one picture: the service, its SLOs with their targets, windows and error budgets, the
/// SLIs they measure, the data sources behind them, and the alerting, drawn from the OpenSLO files where they are.
///
/// The SLO map opens OpenSLO documents (openslo/v1), the vendor-neutral YAML in which reliability engineers write
/// service level objectives as code, and draws every object as an element and every reference as a connection. Each
/// objective states its target as a percentage, its window and its error budget in its budgeting method's own
/// terms, with the equivalent time of complete failure, so that a service level manager reads the commitments
/// without reading YAML. Edits from forms are byte-preserving splices into the files, which stay valid OpenSLO; a
/// document the diagram does not draw is kept as written. What it does not do, and the format for agents, are in
/// openslo-slo.md.
diagram openslo/slo version "0.1.0" {
  label "SLO map"
  id: "net.etalii.adp.openslo.slo"
  license: "Apache-2.0"
  authors: [{ name: "Peter Vrenken" }]
  icon: "mdi-target"
  doc: {
    tags: ["OpenSLO", "service level objective", "error budget", "service management", "reliability"]
    seeAlso: [
      { title: "OpenSLO", href: "https://openslo.com" },
      { title: "The objects, the budgets and what this diagram does not do", href: "openslo-slo.md" }
    ]
  }
  x-adp: { kind: "Diagram", companion: "openslo-slo.md" }

  import "openslo-slo.notation.atd"
  import "openslo-slo.openslo.atd"

  /// The seconds of an OpenSLO duration shorthand (5m, 4w, 1M, 1Q, 1Y). Calendar units have no fixed length and are
  /// taken at their shortest: a month of 28 days, a quarter of 89, a year of 365 (research R5). -1 when the text is
  /// not a shorthand.
  fn windowSeconds(s: string) -> double {
    return !s.matches('^[0-9]+[smhdwMQY]$') ? -1.0 : cel.bind(u, s.substring(size(s) - 1), double(int(s.substring(0, size(s) - 1))) * (u == 's' ? 1.0 : u == 'm' ? 60.0 : u == 'h' ? 3600.0 : u == 'd' ? 86400.0 : u == 'w' ? 604800.0 : u == 'M' ? 2419200.0 : u == 'Q' ? 7689600.0 : 31536000.0))
  }

  /// The seconds of a time slice: a bare number is minutes, as OpenSLO says of timeSliceWindow; otherwise a duration
  /// shorthand.
  fn sliceSeconds(s: string) -> double {
    return s.matches('^[0-9]+$') ? double(int(s)) * 60.0 : windowSeconds(s)
  }

  /// Whether a duration is in months, quarters or years, whose budget is stated for the shortest such window and
  /// labelled at least.
  fn calendarUnit(s: string) -> bool {
    return s.matches('^[0-9]+[MQY]$')
  }

  /// A duration shorthand in words: 28d is 28 days, 1M is 1 month.
  fn durationWords(s: string) -> string {
    return !s.matches('^[0-9]+[smhdwMQY]$') ? s : cel.bind(u, s.substring(size(s) - 1), cel.bind(n, s.substring(0, size(s) - 1), n + ' ' + (u == 's' ? 'second' : u == 'm' ? 'minute' : u == 'h' ? 'hour' : u == 'd' ? 'day' : u == 'w' ? 'week' : u == 'M' ? 'month' : u == 'Q' ? 'quarter' : 'year') + (n == '1' ? '' : 's')))
  }

  /// A number of seconds as days, hours, minutes and whole seconds, leaving out the parts that are zero: 2,419.2
  /// seconds is 40 min 19 s (research R6).
  fn shownTime(seconds: double) -> string {
    return seconds < 0.0 ? '?' : cel.bind(t, int(seconds + 0.000001), cel.bind(p, [t / 86400 > 0 ? string(t / 86400) + ' d' : '', t % 86400 / 3600 > 0 ? string(t % 86400 / 3600) + ' h' : '', t % 3600 / 60 > 0 ? string(t % 3600 / 60) + ' min' : '', t % 60 > 0 ? string(t % 60) + ' s' : ''].filter(x, x != ''), p.size() == 0 ? '0 s' : p.join(' ')))
  }

  /// An objective's target as a share between 0 and 1: target, or targetPercent divided by 100; -1 when it has
  /// neither (openslo.target-twice).
  fn targetShare(o: Objective) -> double {
    return has(o.targetRatio) ? o.targetRatio : has(o.targetPercent) ? o.targetPercent / 100.0 : -1.0
  }

  /// An objective's target as a percentage, with up to three decimals: 0.999 is 99.9 %.
  fn targetText(o: Objective) -> string {
    return targetShare(o) < 0.0 ? 'no target' : formatNumber(targetShare(o) * 100.0, '0.###') + ' %'
  }

  /// An SLO's time window in words: 28 days rolling, 1 month calendar-aligned.
  fn windowText(s: SLO) -> string {
    return !has(s.duration) ? 'no time window' : durationWords(s.duration) + (has(s.isRolling) && s.isRolling ? ' rolling' : ' calendar-aligned')
  }

  /// The error budget as time of complete failure, in seconds: (1 - target) × the window (research R6). For a
  /// calendar window it is the budget of the shortest such window.
  fn budgetTime(o: Objective) -> double {
    return targetShare(o) < 0.0 || !has(o.parent.duration) || windowSeconds(o.parent.duration) < 0.0 ? -1.0 : (1.0 - targetShare(o)) * windowSeconds(o.parent.duration)
  }

  /// For Timeslices: how many slices may be bad, (1 - target) × window ÷ slice, rounded down; -1 when it cannot be
  /// computed.
  fn budgetSlices(o: Objective) -> int {
    return budgetTime(o) < 0.0 || !has(o.timeSliceWindow) || sliceSeconds(o.timeSliceWindow) <= 0.0 ? -1 : int(budgetTime(o) / sliceSeconds(o.timeSliceWindow) + 0.000001)
  }

  /// The sentence an objective shows, in its budgeting method's own terms, with the equivalent time of complete
  /// failure for every method (research R6): Occurrences, the share of events that may fail; Timeslices, the number
  /// of slices that may be bad; RatioTimeslices, the average ratio the slices may fall to.
  fn budgetText(o: Objective) -> string {
    return budgetTime(o) < 0.0 ? 'Error budget not computed: see the findings.' : cel.bind(least, calendarUnit(o.parent.duration) ? 'at least ' : '', cel.bind(time, least + shownTime(budgetTime(o)) + ' of failure allowed', o.parent.budgetingMethod == 'Timeslices' ? (budgetSlices(o) < 0 ? time : least + string(budgetSlices(o)) + ' bad slices of ' + durationWords(o.timeSliceWindow) + ' allowed; ' + time) : o.parent.budgetingMethod == 'RatioTimeslices' ? 'The average good ratio of the slices may fall to ' + targetText(o) + '; ' + time : formatNumber((1.0 - targetShare(o)) * 100.0, '0.###') + ' % of events may fail; ' + time))
  }

  /// Whether an object of a kind with a name is in the reading, as a document of its own: an inline object is not
  /// referable by name.
  fn found(kind: string, name: string) -> bool {
    return diagram.nodesOfType(kind).exists(n, n.name == name && !n.inline)
  }

  /// The object a reference names, or the placeholder that stands for it when it is not in the reading (research R4).
  fn resolve(kind: string, name: string) -> Element {
    return cel.bind(f, diagram.nodesOfType(kind).filter(n, n.name == name && !n.inline), f.size() > 0 ? f[0] : diagram.nodesOfType('Missing').filter(m, m.id == 'missing:' + kind + ':' + name)[0])
  }

  /// Every reference an object makes, as a kind and a name: an SLO's service, indicatorRef and alertPolicyRef; an
  /// objective's indicatorRef; an SLI's metricSourceRef; an alert policy's conditionRef and targetRef (FR-001).
  fn references(e: Element) -> list<list<string>> {
    return e.isA('SLO') ? (has(e.service) && e.service != '' ? [['Service', e.service]] : []) + (has(e.indicatorRef) && e.indicatorRef != '' ? [['SLI', e.indicatorRef]] : []) + e.alertPolicyRefs.map(n, ['AlertPolicy', n]) : e.isA('Objective') ? (has(e.indicatorRef) && e.indicatorRef != '' ? [['SLI', e.indicatorRef]] : []) : e.isA('SLI') ? e.sourceRefs.map(n, ['DataSource', n]) : e.isA('AlertPolicy') ? e.conditionRefs.map(n, ['AlertCondition', n]) + e.targetRefs.map(n, ['AlertNotificationTarget', n]) : []
  }

  /// The references of an object that name nothing in the reading.
  fn unresolved(e: Element) -> list<list<string>> {
    return references(e).filter(r, !found(r[0], r[1]))
  }

  /// Whether a document the diagram does not draw is OpenSLO of another version, such as openslo.com/v2alpha
  /// (research R7), rather than a kind it does not draw or not OpenSLO at all.
  fn isOtherVersion(u: Unbound) -> bool {
    return u.apiVersion != 'openslo/v1' && u.apiVersion.startsWith('openslo')
  }

  /// Whether a name is an RFC 1123 label, as OpenSLO requires of metadata.name: at most 63 lower-case letters, digits
  /// and hyphens, starting and ending with a letter or a digit.
  fn isName(s: string) -> bool {
    return size(s) <= 63 && s.matches('^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')
  }

  /// OpenSLO's kinds, one element type each (FR-001): a service, its SLOs with their objectives, the SLIs they
  /// measure, the data sources behind them, and the alert policies with their conditions and notification targets.
  /// Every reference between them is a relation, derived from the reference keys the documents hold, and an inline
  /// object is an element contained in the object it is written in. A reference to an object not in the reading ends
  /// at a Missing placeholder (research R4).
  model {
    /// The file, or the folder a registration names. It has nothing of its own: every document is an element.
    document {
    }

    /// What every OpenSLO object has: metadata.name, metadata.displayName and a description. labels and annotations are
    /// kept as written and not shown (openslo-slo.md, Gaps).
    element OpenSloObject {
      abstract: true
      labelAttribute: "name"
      /// metadata.name: the object's name, unique within its kind (openslo.name when it is not an RFC 1123 label).
      attribute name: string required { label: "Name", order: 1, group: "Identity" }
      /// metadata.displayName: the name people read, shown in place of the name where it is set.
      attribute displayName: string { label: "Display name", order: 2, group: "Identity" }
      /// spec.description.
      attribute description: text { label: "Description", order: 3, group: "Identity" }
      /// True for an object defined inside another rather than as a document of its own (research R3). Set by the rule
      /// that reads it, never written.
      attribute inline: bool readonly default false { label: "Inline", group: "Identity" }
    }

    /// What a set of objectives is about.
    element Service extends OpenSloObject {
      label "Service"
      icon: "mdi-server"
    }

    /// A service level objective: a target for an SLI over a time window, with a budgeting method, its objectives
    /// contained in it.
    element SLO extends OpenSloObject {
      label "SLO"
      icon: "mdi-target"
      children: {
        allowed: ["Objective", "SLI", "AlertPolicy"]
        slots: {
          objectives: { allowed: ["Objective"] }
          indicator: { allowed: ["SLI"], max: 1 }
          alertPolicies: { allowed: ["AlertPolicy"] }
        }
      }
      /// spec.service: the name of the Service the SLO is about.
      attribute service: string required { label: "Service", order: 4, group: "References" }
      /// spec.indicatorRef: the name of the SLI the SLO measures, when it is not written inline
      /// (openslo.indicator-twice).
      attribute indicatorRef: string { label: "Indicator", order: 5, group: "References" }
      /// The names in spec.alertPolicies[*].alertPolicyRef. An inline alert policy is a contained element instead.
      attribute alertPolicyRefs: string many readonly { label: "Alert policies", order: 6, group: "References" }
      /// spec.timeWindow[0].duration, a duration shorthand such as 28d or 1M (research R5).
      attribute duration: string { label: "Window", order: 7, group: "Window", pattern: "^[0-9]+[smhdwMQY]$" }
      /// spec.timeWindow[0].isRolling: a rolling window, or one aligned to the calendar.
      attribute isRolling: bool default false { label: "Rolling", order: 8, group: "Window" }
      /// spec.timeWindow[0].calendar.startTime, as written.
      attribute calendarStart: string { label: "Calendar start", order: 9, group: "Window" }
      /// spec.timeWindow[0].calendar.timeZone, an IANA time zone.
      attribute timeZone: string { label: "Time zone", order: 10, group: "Window" }
      /// How many items spec.timeWindow holds; OpenSLO allows one (openslo.window-count).
      attribute windowCount: int readonly default 0 { label: "Windows" }
      /// spec.budgetingMethod.
      attribute budgetingMethod: BudgetingMethod required { label: "Budgeting method", order: 11, group: "Window" }
      /// Whether spec.indicator is written, for openslo.indicator-twice.
      attribute hasIndicator: bool readonly default false { label: "Inline indicator" }
    }

    /// One entry of an SLO's spec.objectives, contained in it. Its sentence is its target, its window and its error
    /// budget (FR-004).
    element Objective {
      label "Objective"
      icon: "mdi-bullseye-arrow"
      labelAttribute: "displayName"
      /// displayName of the objective.
      attribute displayName: string { label: "Display name", order: 1 }
      /// op: the comparison of a threshold metric.
      attribute op: Operator { label: "Operator", order: 2 }
      /// value: the threshold a threshold metric is compared with.
      attribute threshold: number { label: "Threshold", order: 3 }
      /// target, a share between 0 and 1 (0.999 is 99.9 %).
      attribute targetRatio: number { label: "Target", order: 4, min: 0 }
      /// targetPercent, the same target as a percentage; write target or targetPercent, not both (openslo.target-twice).
      attribute targetPercent: number { label: "Target percent", order: 5, min: 0 }
      /// timeSliceTarget: the ratio a slice must meet to be good, for Timeslices.
      attribute timeSliceTarget: number { label: "Slice target", order: 6 }
      /// timeSliceWindow: the length of a slice, a duration shorthand or a bare number of minutes.
      attribute timeSliceWindow: string { label: "Slice", order: 7 }
      /// indicatorRef: the SLI of this objective, for a composite SLO.
      attribute indicatorRef: string { label: "Indicator", order: 8, group: "References" }
      /// compositeWeight, for a composite SLO.
      attribute compositeWeight: number { label: "Composite weight", order: 9 }
      /// An objective is always written inside its SLO.
      attribute inline: bool readonly default true
    }

    /// A service level indicator: a threshold metric or a ratio of good, bad or total events. Each metric names a
    /// DataSource with metricSourceRef or carries an inline metricSource.
    element SLI extends OpenSloObject {
      label "SLI"
      icon: "mdi-gauge"
      /// threshold or ratio, from which of thresholdMetric and ratioMetric is written.
      attribute metric: string readonly { label: "Metric" }
      /// The names in the metricSourceRef keys of its metrics.
      attribute sourceRefs: string many readonly { label: "Data sources", order: 4, group: "References" }
      /// The type of each inline metricSource, such as Prometheus.
      attribute sourceTypes: string many readonly { label: "Inline sources", order: 5 }
    }

    /// Where an SLI's metrics come from.
    element DataSource extends OpenSloObject {
      label "Data source"
      icon: "mdi-database"
      /// spec.type, such as Prometheus or Datadog.
      attribute sourceType: string { label: "Type", order: 4 }
    }

    /// When the consumption of an SLO's budget is told to someone: its conditions and notification targets, by
    /// reference or inline.
    element AlertPolicy extends OpenSloObject {
      label "Alert policy"
      icon: "mdi-bell-outline"
      children: {
        allowed: ["AlertCondition", "AlertNotificationTarget"]
        slots: {
          conditions: { allowed: ["AlertCondition"] }
          notificationTargets: { allowed: ["AlertNotificationTarget"] }
        }
      }
      /// spec.alertWhenNoData.
      attribute alertWhenNoData: bool { label: "When no data", order: 4 }
      /// spec.alertWhenResolved.
      attribute alertWhenResolved: bool { label: "When resolved", order: 5 }
      /// spec.alertWhenBreaching.
      attribute alertWhenBreaching: bool { label: "When breaching", order: 6 }
      /// The names in spec.conditions[*].conditionRef.
      attribute conditionRefs: string many readonly { label: "Conditions", order: 7, group: "References" }
      /// The names in spec.notificationTargets[*].targetRef.
      attribute targetRefs: string many readonly { label: "Notification targets", order: 8, group: "References" }
    }

    /// When an alert fires: a burn-rate condition with an operator, a threshold, a lookback window and how long it must
    /// hold.
    element AlertCondition extends OpenSloObject {
      label "Alert condition"
      icon: "mdi-alert-outline"
      /// spec.severity, as written (page, ticket or another word).
      attribute severity: string { label: "Severity", order: 4 }
      /// spec.condition.kind, such as burnrate.
      attribute conditionKind: string { label: "Condition", order: 5 }
      /// spec.condition.op.
      attribute op: Operator { label: "Operator", order: 6 }
      /// spec.condition.threshold.
      attribute threshold: number { label: "Threshold", order: 7 }
      /// spec.condition.lookbackWindow, a duration shorthand.
      attribute lookbackWindow: string { label: "Lookback", order: 8 }
      /// spec.condition.alertAfter, a duration shorthand.
      attribute alertAfter: string { label: "Alert after", order: 9 }
    }

    /// Who or what an alert is sent to.
    element AlertNotificationTarget extends OpenSloObject {
      label "Notification target"
      icon: "mdi-send-outline"
      /// spec.target, such as slack or email.
      attribute destination: string { label: "Target", order: 4 }
    }

    /// A document of a kind or a version the diagram does not draw: listed, kept as written, never changed (User Story
    /// 3, scenario 3; research R7).
    element Unbound {
      label "Other document"
      icon: "mdi-file-question-outline"
      labelAttribute: "kindName"
      /// Its kind, as written, or empty.
      attribute kindName: string readonly { label: "Kind" }
      /// Its apiVersion, as written, or empty.
      attribute apiVersion: string readonly { label: "API version" }
      /// The line its document starts on.
      attribute line: int readonly { label: "Line" }
      attribute inline: bool readonly default false
    }

    /// The end of a reference whose target is not in the reading (research R4): drawn dashed and labelled not in this
    /// file. Derived, one per kind and name referred to.
    element Missing {
      label "Not in this file"
      icon: "mdi-help-circle-outline"
      labelAttribute: "name"
      derived: {
        from: (diagram.nodes.filter(n, !n.derived).map(n, unresolved(n)).flatten().map(r, r[0] + ':' + r[1]).distinct())
        id: ('missing:' + item)
        attributes: { kindName: (item.split(':')[0]), name: (item.substring(size(item.split(':')[0]) + 1)) }
        sources: (diagram.nodes.filter(n, !n.derived && unresolved(n).exists(r, r[0] + ':' + r[1] == item)))
        reason: "This object is not in the file. Open the folder it belongs to through a registration to draw it, or add its document here."
      }
      attribute kindName: string { label: "Kind" }
      attribute name: string { label: "Name" }
      attribute inline: bool default false
    }

    /// An SLO is about its service: spec.service.
    relation OfService from SLO to Service, Missing {
      label "of service"
      directed: true
      derived: {
        from: (diagram.nodesOfType('SLO').filter(s, has(s.service) && s.service != '').map(s, [s, resolve('Service', s.service)]))
        source: (item[0])
        target: (item[1])
        reason: "The line is the reference the document writes; change the reference in the form to change it."
      }
    }

    /// An SLO or an objective measures an SLI: indicatorRef, or the SLI written inline in the SLO, which is joined to
    /// it and marked inline (User Story 1, scenario 3).
    relation Measures from SLO, Objective to SLI, Missing {
      label "measures"
      directed: true
      derived: {
        from: (diagram.nodesOfType('SLO').filter(s, has(s.indicatorRef) && s.indicatorRef != '').map(s, [s, resolve('SLI', s.indicatorRef)]) + diagram.nodesOfType('Objective').filter(s, has(s.indicatorRef) && s.indicatorRef != '').map(s, [s, resolve('SLI', s.indicatorRef)]) + diagram.nodesOfType('SLI').filter(i, i.inline && i.parent != null).map(i, [i.parent, i]))
        source: (item[0])
        target: (item[1])
        reason: "The line is the reference the document writes; change the reference in the form to change it."
      }
    }

    /// An SLI reads a metric from a data source: metricSourceRef.
    relation ReadsFrom from SLI to DataSource, Missing {
      label "reads from"
      directed: true
      derived: {
        from: (diagram.nodesOfType('SLI').map(s, s.sourceRefs.map(n, [s, resolve('DataSource', n)])).flatten())
        source: (item[0])
        target: (item[1])
        reason: "The line is the reference the document writes; change the reference in the form to change it."
      }
    }

    /// An SLO's budget is watched by an alert policy: alertPolicyRef, or an inline policy.
    relation AlertsWith from SLO to AlertPolicy, Missing {
      label "alerts with"
      directed: true
      derived: {
        from: (diagram.nodesOfType('SLO').map(s, s.alertPolicyRefs.map(n, [s, resolve('AlertPolicy', n)])).flatten() + diagram.nodesOfType('AlertPolicy').filter(p, p.inline && p.parent != null).map(p, [p.parent, p]))
        source: (item[0])
        target: (item[1])
        reason: "The line is the reference the document writes; change the reference in the form to change it."
      }
    }

    /// An alert policy fires on an alert condition: conditionRef, or an inline condition.
    relation OnCondition from AlertPolicy to AlertCondition, Missing {
      label "on"
      directed: true
      derived: {
        from: (diagram.nodesOfType('AlertPolicy').map(s, s.conditionRefs.map(n, [s, resolve('AlertCondition', n)])).flatten() + diagram.nodesOfType('AlertCondition').filter(c, c.inline && c.parent != null).map(c, [c.parent, c]))
        source: (item[0])
        target: (item[1])
        reason: "The line is the reference the document writes; change the reference in the form to change it."
      }
    }

    /// An alert policy notifies a target: targetRef, or an inline target.
    relation Notifies from AlertPolicy to AlertNotificationTarget, Missing {
      label "notifies"
      directed: true
      derived: {
        from: (diagram.nodesOfType('AlertPolicy').map(s, s.targetRefs.map(n, [s, resolve('AlertNotificationTarget', n)])).flatten() + diagram.nodesOfType('AlertNotificationTarget').filter(t, t.inline && t.parent != null).map(t, [t.parent, t]))
        source: (item[0])
        target: (item[1])
        reason: "The line is the reference the document writes; change the reference in the form to change it."
      }
    }

    /// OpenSLO's three budgeting methods (research R6).
    enum BudgetingMethod {
      Occurrences { label: "Occurrences", doc: "The share of good events among all events." }
      Timeslices {
        label: "Timeslices"
        doc: "The share of good time slices, a slice being good when its ratio meets timeSliceTarget."
      }
      RatioTimeslices { label: "Ratio timeslices", doc: "The average of the slices' good ratios." }
    }

    /// The comparison of a threshold objective or an alert condition.
    enum Operator {
      lt { label: "less than" }
      lte { label: "at most" }
      gt { label: "greater than" }
      gte { label: "at least" }
    }

    /// An alert condition's severity, as OpenSLO writes it.
    enum Severity {
      page { label: "Page" }
      ticket { label: "Ticket" }
      info { label: "Info" }
    }
  }

  /// The findings of User Story 3 (FR-005), each with its code and sentence. A file that breaks a rule still opens
  /// and draws: a finding never refuses, so nothing anyone wrote is lost.
  constraints {
    blockSaveOn: never

    /// A reference that names no object of its kind in the reading. Info in a bare file, where the object may well be
    /// in another file; a folder reading draws it in full (research R4; openslo-slo.md, Gaps).
    constraint missingReference for SLO, Objective, SLI, AlertPolicy {
      label "Reference not in the file"
      rule unresolved(self).size() == 0
      severity info
      message (cel.bind(r, unresolved(self)[0], 'The ' + r[0] + ' "' + r[1] + '" is not in this file' + (unresolved(self).size() > 1 ? ', nor ' + string(unresolved(self).size() - 1) + ' more' : '') + '; it is drawn as a placeholder.'))
      code: "openslo.missing-reference"
    }

    constraint noAlerting for SLO {
      label "No alert policy"
      rule self.alertPolicyRefs.size() > 0 || self.childrenOfType('AlertPolicy').size() > 0
      severity info
      message ('The SLO "' + self.name + '" has no alert policy; nobody is told when its budget burns.')
      code: "openslo.no-alerting"
    }

    constraint targetRange for Objective {
      label "Target out of range"
      rule (!has(self.targetRatio) || (self.targetRatio >= 0.0 && self.targetRatio < 1.0)) && (!has(self.targetPercent) || (self.targetPercent >= 0.0 && self.targetPercent < 100.0))
      severity error
      message ('The target ' + (has(self.targetRatio) ? string(self.targetRatio) : string(self.targetPercent) + ' %') + ' is outside what OpenSLO allows: target from 0 up to 1, targetPercent from 0 up to 100.')
      code: "openslo.target-range"
    }

    constraint targetTwice for Objective {
      label "Target written twice or not at all"
      rule has(self.targetRatio) != has(self.targetPercent)
      severity error
      message (has(self.targetRatio) ? 'The objective has both target and targetPercent; write one of them.' : 'The objective has no target; write target or targetPercent.')
      code: "openslo.target-twice"
    }

    /// One of indicator and indicatorRef, unless every objective names its own SLI, as a composite SLO does.
    constraint indicatorTwice for SLO {
      label "Indicator written twice or not at all"
      rule (has(self.indicatorRef) && self.indicatorRef != '') != self.hasIndicator || (!self.hasIndicator && !(has(self.indicatorRef) && self.indicatorRef != '') && self.childrenOfType('Objective').all(o, has(o.indicatorRef) && o.indicatorRef != ''))
      severity error
      message (self.hasIndicator ? 'The SLO has both an inline indicator and indicatorRef; write one of them.' : 'The SLO has no indicator; write indicatorRef or an inline indicator.')
      code: "openslo.indicator-twice"
    }

    constraint windowCount for SLO {
      label "More than one time window"
      rule self.windowCount <= 1
      severity warning
      message ('The SLO has ' + string(self.windowCount) + ' time windows; OpenSLO allows one, and the diagram reads the first.')
      code: "openslo.window-count"
    }

    constraint timesliceFields for Objective {
      label "Slice target or window missing"
      rule self.parent.budgetingMethod != 'Timeslices' || (has(self.timeSliceTarget) && has(self.timeSliceWindow))
      severity error
      message ('A Timeslices objective needs timeSliceTarget and timeSliceWindow; this one lacks ' + (has(self.timeSliceTarget) ? 'timeSliceWindow' : has(self.timeSliceWindow) ? 'timeSliceTarget' : 'both') + '.')
      code: "openslo.timeslice-fields"
    }

    constraint conflictingWindows for SLI {
      label "SLOs on one SLI with different windows"
      rule diagram.relationsOfType('Measures').filter(m, m.target == self && m.source.isA('SLO') && has(m.source.duration)).map(m, m.source.duration + (m.source.isRolling ? ' rolling' : '')).distinct().size() <= 1
      severity warning
      message ('The SLI "' + self.name + '" is measured by SLOs with different windows: ' + diagram.relationsOfType('Measures').filter(m, m.target == self && m.source.isA('SLO') && has(m.source.duration)).map(m, m.source.name + ' ' + windowText(m.source)).join(', ') + '.')
      code: "openslo.conflicting-windows"
    }

    constraint unknownKind for Unbound {
      label "Document not drawn"
      rule isOtherVersion(self)
      severity info
      message ('A document of kind "' + (self.kindName != '' ? self.kindName : 'none') + '" is not drawn; it is kept as written and listed.')
      code: "openslo.unknown-kind"
    }

    /// Research R7. DISL and FBL cannot make a reading read-only on a condition, so the documents of openslo/v1 stay
    /// editable and this one is never touched (openslo-slo.md, Gaps).
    constraint version for Unbound {
      label "Another OpenSLO version"
      rule !isOtherVersion(self)
      severity warning
      message ('A document of ' + self.apiVersion + ' is kept as written and not drawn; this diagram reads openslo/v1. Edit this file in a tool for that version.')
      code: "openslo.version"
    }

    constraint name for Service, SLO, SLI, DataSource, AlertPolicy, AlertCondition, AlertNotificationTarget {
      label "Name is not an RFC 1123 label"
      rule isName(self.name)
      severity error
      message ('"' + self.name + '" is not a valid OpenSLO name: at most 63 lower-case letters, digits and hyphens, starting and ending with a letter or a digit.')
      code: "openslo.name"
      attribute: "name"
    }
  }


  /// User Story 2, scenario 2: a new SLO document with the first service and the first SLI of the file referenced, a
  /// 28-day rolling window, the Occurrences method and one objective of 99 %. Without a service or an SLI the
  /// reference is left empty and openslo.missing-reference says so.
  operation addSlo "SLO" for document {
    icon: mdi-target
    let service = diagram.nodesOfType('Service').filter(n, !n.inline).map(n, n.name).first().orValue('')
    let sli = diagram.nodesOfType('SLI').filter(n, !n.inline).map(n, n.name).first().orValue('')
    create SLO { name: 'new-slo', service: service, indicatorRef: sli, budgetingMethod: 'Occurrences' } as slo
    create Objective { displayName: 'Objective', targetRatio: 0.99 } in slo slot objectives
  }

  /// The same, for the service it is invoked on.
  operation addSloForService "Add an SLO" for Service {
    icon: mdi-target
    let sli = diagram.nodesOfType('SLI').filter(n, !n.inline).map(n, n.name).first().orValue('')
    create SLO { name: self.name + '-slo', service: self.name, indicatorRef: sli, budgetingMethod: 'Occurrences' } as slo
    create Objective { displayName: 'Objective', targetRatio: 0.99 } in slo slot objectives
  }

  /// A new entry at the end of spec.objectives.
  operation addObjective "Add an objective" for SLO {
    icon: mdi-bullseye-arrow
    create Objective { displayName: 'Objective ' + string(self.childrenOfType('Objective').size() + 1), targetRatio: 0.99 } in self slot objectives
  }

  behavior {
    doc: "Every edit is one undoable step. A new SLO is written with its service and an SLI referenced; deleting an object others refer to asks first and names them (User Story 2)."
    deletion: {
      Service: {
        children: "delete"
        relations: "delete"
        confirm: {
          message: ('Delete "' + self.name + '"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'Service' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'Service' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.')
          when: (!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'Service' && r[1] == self.name)))
          danger: true
        }
      }
      SLI: {
        children: "delete"
        relations: "delete"
        confirm: {
          message: ('Delete "' + self.name + '"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'SLI' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'SLI' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.')
          when: (!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'SLI' && r[1] == self.name)))
          danger: true
        }
      }
      DataSource: {
        children: "delete"
        relations: "delete"
        confirm: {
          message: ('Delete "' + self.name + '"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'DataSource' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'DataSource' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.')
          when: (!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'DataSource' && r[1] == self.name)))
          danger: true
        }
      }
      AlertPolicy: {
        children: "delete"
        relations: "delete"
        confirm: {
          message: ('Delete "' + self.name + '"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertPolicy' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertPolicy' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.')
          when: (!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'AlertPolicy' && r[1] == self.name)))
          danger: true
        }
      }
      AlertCondition: {
        children: "delete"
        relations: "delete"
        confirm: {
          message: ('Delete "' + self.name + '"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertCondition' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertCondition' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.')
          when: (!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'AlertCondition' && r[1] == self.name)))
          danger: true
        }
      }
      AlertNotificationTarget: {
        children: "delete"
        relations: "delete"
        confirm: {
          message: ('Delete "' + self.name + '"? ' + string(diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertNotificationTarget' && r[1] == self.name)).size()) + ' object(s) refer to it: ' + diagram.nodes.filter(n, !n.derived && references(n).exists(r, r[0] == 'AlertNotificationTarget' && r[1] == self.name)).map(n, n.name).join(', ') + '. Their references stay and will point at nothing.')
          when: (!self.inline && diagram.nodes.exists(n, !n.derived && references(n).exists(r, r[0] == 'AlertNotificationTarget' && r[1] == self.name)))
          danger: true
        }
      }
    }
  }

  /// Every kind is drawn.
  viewpoint objectives "Objectives" { default: true }

  /// OpenSLO's own YAML, openslo/v1, read and written through openslo-slo.fbl#openslo with byte-preserving splices,
  /// every document of a stream bound (FBL 0.22). A folder is read through openslo-slo.fbl#folder from a registration
  /// whose body is the folder.
  persistence {
    format: "fbl"
    ids: {
      strategy: "derived"
      expression: (self.type + ':' + self.name)
      pattern: "^.+$"
      doc: "An OpenSLO name is unique within its kind, not across kinds (a Service and an SLI are often named alike), so an id is the kind and the name; an inline object's id adds it to its owner's, and an objective's is its owner's with its position (research R3). Pinned positions are keyed by these ids in the registration."
      types: {
        Service: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/Service:' + self.name : 'Service:' + self.name)
        }
        SLO: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/SLO:' + self.name : 'SLO:' + self.name)
        }
        SLI: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/SLI:' + self.name : 'SLI:' + self.name)
        }
        DataSource: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/DataSource:' + self.name : 'DataSource:' + self.name)
        }
        AlertPolicy: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/AlertPolicy:' + self.name : 'AlertPolicy:' + self.name)
        }
        AlertCondition: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/AlertCondition:' + self.name : 'AlertCondition:' + self.name)
        }
        AlertNotificationTarget: {
          strategy: "derived"
          expression: (self.inline && self.parent != null ? self.parent.id + '/AlertNotificationTarget:' + self.name : 'AlertNotificationTarget:' + self.name)
        }
        Objective: {
          strategy: "derived"
          expression: (self.parent.id + '/objective:' + string(self.positionIn(self.parent.childrenOfType('Objective')) + 1))
        }
        Unbound: {
          strategy: "derived"
          expression: ('document@' + string(self.line))
          ephemeral: true
          reason: "A document the diagram does not draw is known only by the line it starts on, which an edit above it changes."
        }
      }
    }
    typeMap: {
      Service: { as: "Service" }
      SLO: { as: "SLO" }
      SLI: { as: "SLI" }
      DataSource: { as: "DataSource" }
      AlertPolicy: { as: "AlertPolicy" }
      AlertCondition: { as: "AlertCondition" }
      AlertNotificationTarget: {
        as: "AlertNotificationTarget"
        attributes: { target: "destination" }
        doc: "spec.target is the attribute destination, since DISL reserves target."
      }
      Unbound: { as: "Unbound" }
      Objective: {
        as: "Objective"
        attributes: { target: "targetRatio", value: "threshold" }
        doc: "DISL reserves target and value (DISL 2.2), so the objective's target and value keys are the attributes targetRatio and threshold (research R11)."
      }
    }
    view: {
      store: ["bounds"]
      viewer: ["selection", "viewport"]
      styleOverrides: "none"
      doc: "Only the positions a user pins are stored, in the registration's layout block (FBL 8.3), never in the OpenSLO file (FR-008, research R8)."
    }
  }
}
