{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.w3c.owl",
    "version": "1.0.0",
    "label": "OWL ontology",
    "icon": "mdi:shape-outline",
    "fileExtension": "ttl",
    "license": "Apache-2.0",
    "homepage": "https://www.w3.org/TR/owl2-overview/",
    "authors": [ { "name": "Peter Vrenken" } ],
    "limits": { "maxElements": 1000 },
    "requires": { "conformance": "standard" },
    "doc": {
      "summary": "Explore an OWL 2 ontology's classes, hierarchy and restrictions as a VOWL-style graph.",
      "description": "A reading of an OWL 2 ontology stored as Turtle (`.ttl`) or N-Triples (`.nt`): what the file *asserts*, not what a reasoner would infer. Classes are ellipses in columns by asserted subclass depth, roots on the left; datatypes are boxes; individuals and the `owl:Ontology` header are cards with their literal rows; object and datatype properties are labelled edges between their stated domains and ranges; anonymous class expressions (restrictions, unions, intersections, complements, enumerations) are compact dashed ellipses beside the class that uses them, labelled in DL symbols. Nothing is inferred, nothing is fetched: `owl:imports` is named, never followed.\n\nThe diagram is stored in the ontology's own file, which other tools own; ADP writes only minimal splices into it, and keeps positions in the `.adp` registration beside it. What this specification cannot express - the projection from triples, the expression renderer, the identity boundary of anonymous expressions, the depth-column layout, the refusals - is written down in `w3c-owl.md` beside this file.",
      "rationale": "OWL axioms are dense in Turtle or RDF/XML; the VOWL notation shows classes, properties and restrictions so an ontology can be checked by eye.",
      "tags": [ "owl", "ontology", "vowl", "rdf", "semantic web", "asserted" ],
      "seeAlso": [
        { "title": "W3C OWL 2 overview", "href": "https://www.w3.org/TR/owl2-overview/" },
        { "title": "OWL 2 mapping to RDF graphs", "href": "https://www.w3.org/TR/owl2-mapping-to-rdf/" },
        { "title": "VOWL notation (Semantic Web Journal)", "href": "https://www.semantic-web-journal.net/system/files/swj750.pdf" },
        { "title": "WebVOWL", "href": "https://service.tib.eu/webvowl/" }
      ]
    }
  },

  "functions": {
    "propertyLabel": {
      "params": [ { "name": "name", "type": "string" }, { "name": "words", "type": "list(string)" }, { "name": "inverse", "type": "string" } ],
      "returns": "string",
      "cel": "size(words) == 0 && inverse == '' ? name : name + ' (' + (words + (inverse == '' ? [] : ['inverse of ' + inverse])).join(', ') + ')'",
      "doc": "A property edge's label: the property's display name, then its characteristic words in the order their type triples appear and 'inverse of' the property it names, in parentheses."
    },
    "roundLabel": {
      "params": [ { "name": "display", "type": "string" }, { "name": "elided", "type": "bool" } ],
      "returns": "string",
      "cel": "elided ? display + ' …' : display",
      "doc": "The text drawn inside a round shape: an elided expression's label carries a trailing ellipsis, so the cut is visible as such."
    }
  },

  "metamodel": {
    "doc": "Only what the file asserts, classified by OWL's own vocabulary and never inferred. One IRI can play several roles at once (punning): a class and an individual draw as two elements. Properties are never nodes; they are edges derived from their domain and range triples.",
    "diagram": {
      "attributes": {
        "usable": {
          "type": "bool", "default": true, "readOnly": true,
          "doc": "The file parses. A file that does not opens empty, reports why, and withholds every edit."
        },
        "ontologyDeclared": {
          "type": "bool", "default": false, "readOnly": true,
          "doc": "The file holds a triple `? rdf:type owl:Ontology`. Only then does the canvas context menu offer the four OWL add actions."
        },
        "registered": {
          "type": "bool", "default": true, "readOnly": true,
          "doc": "The file was opened through an `.adp` registration, so a position has somewhere to be stored."
        },
        "editable": {
          "type": "bool", "default": true, "readOnly": true,
          "doc": "The diagram was opened with a history to execute commands on."
        },
        "undeclaredProperties": {
          "type": "string", "many": true, "readOnly": true,
          "doc": "Display names of IRIs used as the subject of `rdfs:domain`/`rdfs:range` or the object of `owl:onProperty` that are not built in and not declared as an object, datatype or annotation property in this file."
        },
        "truncated": {
          "type": "bool", "default": false, "readOnly": true,
          "doc": "The file holds more than the drawn-element budget; edits through the diagram are withheld."
        },
        "shown": { "type": "int", "readOnly": true, "doc": "Elements drawn under the budget." },
        "total": { "type": "int", "readOnly": true, "doc": "Elements the whole file projects to." }
      }
    },
    "dataTypes": {
      "LiteralRow": {
        "doc": "One triple with this element's IRI as subject and a literal as object, `owl:deprecated` excepted; the header also gets one row per `owl:imports`.",
        "fields": {
          "predicate": { "type": "string", "required": true, "doc": "The predicate as a prefixed name under the file's own prefixes." },
          "value": { "type": "string", "required": true, "doc": "The literal's lexical form." },
          "annotation": { "type": "string", "default": "", "doc": "`@lang`, or the compressed datatype when it is not `xsd:string`; empty otherwise." }
        },
        "display": { "cel": "value.predicate + ': ' + value.value + ' ' + value.annotation" }
      }
    },
    "enums": {
      "AxiomKind": {
        "doc": "The three predicates whose blank-node object roots a drawn class expression.",
        "values": {
          "subClassOf": { "label": "Subclass of" },
          "equivalentClass": { "label": "Equivalent to" },
          "disjointWith": { "label": "Disjoint with" }
        }
      },
      "OperatorKind": {
        "doc": "The set operators an operator expression draws.",
        "values": {
          "union": { "label": "∪", "doc": "`owl:unionOf` over an `rdf:List`." },
          "intersection": { "label": "∩", "doc": "`owl:intersectionOf` over an `rdf:List`." },
          "complement": { "label": "¬", "doc": "`owl:complementOf`." },
          "oneOf": { "label": "{ }", "doc": "`owl:oneOf`, an enumeration of individuals or values." }
        }
      },
      "AnchorSide": {
        "doc": "Which end of a property an anchor stands in for.",
        "values": { "domain": {}, "range": {} }
      }
    },
    "types": {
      "Term": {
        "abstract": true,
        "doc": "A named element: an IRI the file uses in one of OWL's roles.",
        "labelAttribute": "display",
        "attributes": {
          "iri": {
            "type": "uri", "key": true, "readOnly": true, "label": "IRI", "group": "Identity",
            "doc": { "summary": "The term's full IRI.", "description": "Rename through the context menu, so every reference follows the name." }
          },
          "types": {
            "type": "string", "many": true, "readOnly": true, "label": "Types", "group": "Identity",
            "doc": { "summary": "The display of every `rdf:type` object, built-ins included.", "description": "Types are stated by triples; add or remove them as statements." }
          },
          "display": {
            "type": "string", "readOnly": true,
            "doc": "The drawn name: the first `rdfs:label` literal in document order, in any language; else the prefixed name under the file's own prefixes; else the IRI's local name; else the whole IRI."
          },
          "label": { "type": "string", "label": "Label", "group": "Documentation", "doc": "The first `rdfs:label` literal. Editing rewrites only its lexical form; language and datatype are kept. With none, the first edit adds a plain `rdfs:label` triple." },
          "comment": { "type": "text", "label": "Comment", "group": "Documentation", "doc": "The first `rdfs:comment` literal, edited the same way." },
          "rows": { "type": "LiteralRow", "many": true, "readOnly": true, "doc": "Every literal-valued triple about this IRI, in document order." },
          "subClassOf": {
            "type": "string", "many": true, "readOnly": true, "label": "Subclass of", "group": "Axioms",
            "doc": { "summary": "Objects of `rdfs:subClassOf`: a named class's display, or an expression's full, uncapped rendering.", "description": "Axioms are stated by triples; draw or remove them as edges and statements." }
          },
          "equivalentTo": { "type": "string", "many": true, "readOnly": true, "label": "Equivalent to", "group": "Axioms", "doc": "Objects of `owl:equivalentClass`, rendered the same way." },
          "disjointWith": { "type": "string", "many": true, "readOnly": true, "label": "Disjoint with", "group": "Axioms", "doc": "Objects of `owl:disjointWith`, rendered the same way." },
          "deprecated": { "type": "bool", "default": false, "readOnly": true, "doc": "The file asserts `owl:deprecated` with the lexical form `true` on this IRI." },
          "external": { "type": "bool", "default": false, "readOnly": true, "doc": "A class or individual whose IRI is not built in and is never the subject of a triple in this file: used here, owned elsewhere." },
          "liveReferences": { "type": "int", "default": 0, "readOnly": true, "doc": "Triples, other than `rdf:type` and `owl:deprecated`, whose object is this IRI and whose subject is a blank node or a non-deprecated IRI." },
          "doubled": {
            "type": "bool",
            "derived": "self.incomingOf('EquivalentClass').size() + self.outgoingOf('EquivalentClass').size() > 0",
            "doc": "An equivalence axiom touches this element, which doubles its outline."
          }
        }
      },
      "Class": {
        "extends": "Term",
        "icon": "mdi:shape-circle-plus",
        "doc": { "summary": "An IRI typed `owl:Class` or `rdfs:Class`, the subject or IRI object of `rdfs:subClassOf`, an object of `rdfs:domain`, either end of an IRI-to-IRI `owl:equivalentClass` or `owl:disjointWith`, a member of `owl:AllDisjointClasses`, or an IRI a class expression references.", "description": "A class node carries literal rows like every term, but its ellipse draws none of them; they are in the property grid." },
        "ports": {
          "axiomLeft": { "label": "Subclass of", "direction": "out", "accepts": [ "SubClassOf" ], "doc": "Dragging from here to another class states that this one is its subclass." },
          "axiomRight": { "label": "Subclass of", "direction": "out", "accepts": [ "SubClassOf" ] }
        }
      },
      "Thing": {
        "extends": "Term",
        "icon": "mdi:circle-outline",
        "doc": "`owl:Thing` wherever the file uses it as a subject or object, and `owl:Nothing` where it is used as a class. Drawn small and dashed.",
        "attributes": {
          "nothing": { "type": "bool", "default": false, "readOnly": true, "doc": "This is `owl:Nothing`." }
        },
        "ports": {
          "axiomLeft": { "label": "Subclass of", "direction": "out", "accepts": [ "SubClassOf" ] },
          "axiomRight": { "label": "Subclass of", "direction": "out", "accepts": [ "SubClassOf" ] }
        }
      },
      "Datatype": {
        "extends": "Term",
        "icon": "mdi:form-textbox",
        "doc": "An IRI in the XSD namespace, `rdfs:Literal`, `rdf:langString`, or an IRI typed `rdfs:Datatype`, wherever the file uses it as a subject or object. One node per datatype, shared by every property ranging over it. Never dimmed as external."
      },
      "Individual": {
        "extends": "Term",
        "icon": "mdi:account-outline",
        "doc": "An IRI typed `owl:NamedIndividual`, or typed by a class this file knows as a class.",
        "attributes": {
          "badges": { "type": "string", "many": true, "readOnly": true, "doc": "The display of every `rdf:type` object that is not built in, so `owl:NamedIndividual` is never a badge." },
          "punned": { "type": "bool", "default": false, "readOnly": true, "doc": "The same IRI is also a class; this card is its individual role and its literal rows stay on the class." }
        }
      },
      "OntologyHeader": {
        "extends": "Term",
        "icon": "mdi:file-document-outline",
        "doc": "The subject of the first `rdf:type owl:Ontology` triple, drawn once as a card.",
        "attributes": {
          "imports": { "type": "uri", "many": true, "readOnly": true, "group": "Identity", "doc": "Objects of `owl:imports`, each also a row on the card. Named, never fetched." }
        }
      },
      "ThingAnchor": {
        "icon": "mdi:circle-outline",
        "labelAttribute": "display",
        "doc": { "summary": "VOWL's owl:Thing anchor for one side of one property that states no usable domain or range.", "description": "Each property gets its own anchor per missing side, distinct from a stated `owl:Thing`. Drawn where its property needs it; never positioned, renamed or removed." },
        "attributes": {
          "property": { "type": "uri", "readOnly": true, "doc": "The property this anchor serves." },
          "side": { "type": "AnchorSide", "readOnly": true },
          "display": { "type": "string", "default": "Thing", "readOnly": true }
        }
      },
      "LiteralAnchor": {
        "icon": "mdi:form-textbox",
        "labelAttribute": "display",
        "doc": "The stand-in datatype box for a datatype property with no datatype range. Never positioned, renamed or removed.",
        "attributes": {
          "property": { "type": "uri", "readOnly": true },
          "display": { "type": "string", "default": "Literal", "readOnly": true }
        }
      },
      "Expression": {
        "abstract": true,
        "labelAttribute": "display",
        "doc": { "summary": "An anonymous class expression: a blank node that is the object of `rdfs:subClassOf`, `owl:equivalentClass` or `owl:disjointWith` with a named subject, or a blank filler or member nested inside one.", "rationale": "Its identity is structural and deterministic within one parse but deliberately unstable across edits, so it is drawn and selectable, and nothing about it is stored or edited from the diagram." },
        "attributes": {
          "axiomOwner": { "type": "Term", "readOnly": true, "doc": "The named element whose axiom roots this expression; nested expressions share their root's owner." },
          "axiom": { "type": "AxiomKind", "readOnly": true },
          "display": { "type": "string", "readOnly": true, "doc": "The rendering capped at two levels of nesting; deeper structure reads as `…`." },
          "text": {
            "type": "text", "readOnly": true, "label": "Expression", "group": "Identity",
            "doc": { "summary": "The full rendering, uncapped.", "description": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text." }
          },
          "elided": { "type": "bool", "default": false, "readOnly": true, "doc": "The canvas rendering hit the depth cap." },
          "malformed": { "type": "bool", "default": false, "readOnly": true, "doc": "A restriction without `owl:onProperty` or without exactly one quantifier, a cyclic structure, or a set-operator list that does not end in `rdf:nil`." },
          "doubled": {
            "type": "bool",
            "derived": "self.incomingOf('EquivalentClass').size() > 0",
            "doc": "The expression is the object of an equivalence axiom."
          }
        }
      },
      "Restriction": {
        "extends": "Expression",
        "icon": "mdi:filter-outline",
        "doc": "An `owl:Restriction`, or any blank class expression that is not an operator: `∃ p.C`, `∀ p.C`, `∋ p.v`, `= n p`, `≥ n p`, `≤ n p`, the qualified forms with `.C`."
      },
      "Operator": {
        "extends": "Expression",
        "icon": "mdi:set-center",
        "doc": "A blank node carrying `owl:unionOf`, `owl:intersectionOf`, `owl:complementOf` or `owl:oneOf`: `(A ∪ B)`, `(A ∩ B)`, `¬A`, `{a, b}`.",
        "attributes": {
          "operator": { "type": "OperatorKind", "readOnly": true, "doc": "The first operator triple in document order." }
        }
      }
    },
    "relations": {
      "SubClassOf": {
        "label": "Subclass of",
        "doc": { "summary": "One edge per `rdfs:subClassOf` triple from a named subject to a named class or to an expression.", "description": "The source is the subclass. The only relation a gesture creates; drawing one writes exactly one triple." },
        "source": { "types": [ "Class", "Thing" ], "ports": [ "axiomLeft", "axiomRight" ], "role": "subclass" },
        "target": { "types": [ "Class", "Thing", "Expression" ], "role": "superclass" },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true
      },
      "EquivalentClass": {
        "label": "Equivalent to",
        "doc": "One edge per `owl:equivalentClass` triple from a named class to a named class or an expression. Read from the file; no gesture creates one.",
        "source": { "types": [ "Class", "Thing" ] },
        "target": { "types": [ "Class", "Thing", "Expression" ] },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true
      },
      "DisjointWith": {
        "label": "Disjoint with",
        "doc": "One edge per `owl:disjointWith` triple, and one per pair of members of an `owl:AllDisjointClasses` list, in list order.",
        "source": { "types": [ "Class", "Thing" ] },
        "target": { "types": [ "Class", "Thing", "Expression" ] },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "fromGroup": { "type": "bool", "default": false, "readOnly": true, "doc": "Expanded from an `owl:AllDisjointClasses` group: no single triple backs it, so it cannot be removed as a statement." }
        }
      },
      "PropertyEdge": {
        "abstract": true,
        "doc": { "summary": "A property drawn as an edge from each stated domain to each stated range.", "description": "No triple backs the edge itself; it is the property. Selecting it shows the property's IRI and axioms, all read-only." },
        "attributes": {
          "property": { "type": "uri", "readOnly": true, "label": "IRI", "group": "Identity", "doc": "Rename the property through its declaration as text." },
          "name": { "type": "string", "readOnly": true, "doc": "The property's display: first `rdfs:label`, else its prefixed or local name." },
          "characteristics": {
            "type": "string", "many": true, "readOnly": true, "label": "Characteristic", "group": "Axioms",
            "doc": "One word per characteristic type triple, in document order: functional, inverse functional, transitive, symmetric, asymmetric, reflexive, irreflexive."
          },
          "inverseName": { "type": "string", "default": "", "readOnly": true, "label": "Inverse of", "group": "Axioms", "doc": "The display of the `owl:inverseOf` object when this property is its subject; '' otherwise." },
          "domain": { "type": "string", "many": true, "readOnly": true, "label": "Domain", "group": "Axioms" },
          "range": { "type": "string", "many": true, "readOnly": true, "label": "Range", "group": "Axioms" },
          "label": { "type": "string", "derived": "propertyLabel(self.name, self.characteristics, self.inverseName)" }
        }
      },
      "ObjectProperty": {
        "extends": "PropertyEdge",
        "label": "Object property",
        "doc": "An IRI typed `owl:ObjectProperty` or one of the characteristic classes that only object properties take. Ranges that are datatypes are left out.",
        "source": { "types": [ "Class", "Thing", "ThingAnchor", "Datatype", "Individual", "OntologyHeader" ], "role": "domain" },
        "target": { "types": [ "Class", "Thing", "ThingAnchor", "Datatype", "Individual", "OntologyHeader" ], "role": "range" },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true
      },
      "DatatypeProperty": {
        "extends": "PropertyEdge",
        "label": "Datatype property",
        "doc": "An IRI typed `owl:DatatypeProperty`, to each datatype range, or to its own Literal anchor when none is stated.",
        "source": { "types": [ "Class", "Thing", "ThingAnchor", "Datatype", "Individual", "OntologyHeader" ], "role": "domain" },
        "target": { "types": [ "Datatype", "LiteralAnchor" ], "role": "range" },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true
      },
      "Assertion": {
        "label": "Assertion",
        "doc": "A triple from an individual, through a predicate that is not built in, to an IRI that is drawn as an individual.",
        "source": { "types": [ "Individual" ] },
        "target": { "types": [ "Individual" ] },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "predicate": { "type": "uri", "readOnly": true, "label": "Predicate", "group": "Identity", "doc": "A statement's predicate is the statement; remove and restate to change it." },
          "name": { "type": "string", "readOnly": true, "doc": "The predicate's display." }
        }
      },
      "References": {
        "label": "Expression reference",
        "doc": "From an expression to what it mentions: a filler of `owl:someValuesFrom`, `owl:allValuesFrom`, `owl:onClass`, `owl:onDataRange` or `owl:hasValue`, the object of `owl:complementOf`, or a member of a set-operator list. `owl:onProperty` is not a reference; the property shows only in the label.",
        "source": { "types": [ "Expression" ] },
        "target": { "types": [ "Class", "Thing", "Datatype", "Expression" ] },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true
      }
    }
  },

  "notation": {
    "doc": "VOWL's structural vocabulary - ellipse classes, box datatypes, a dashed small owl:Thing, a doubled outline for equivalence, labelled property edges, dimmed deprecated and external terms - without its fixed palette: kind is carried by shape and line style, colours come from the host's theme. The tokens copy standalone's theme variables (`src/client/src/index.css`), light and dark.",
    "theme": {
      "tokens": {
        "color.surface": "#ffffff",
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.border": "#e2e8f0",
        "color.node.outline": "#8892a6",
        "color.primary": "limegreen",
        "color.warning": "#b45309",
        "font.body": "system-ui, sans-serif",
        "font.mono": "ui-monospace, monospace"
      },
      "modes": {
        "dark": { "color.surface": "#1e293b", "color.text": "#f1f5f9", "color.text.muted": "#94a3b8", "color.border": "#334155", "color.warning": "#fbbf24" }
      },
      "followSystem": true
    },
    "styles": {
      "node": { "fill": { "token": "color.surface" }, "stroke": { "color": { "token": "color.border" }, "width": 1 }, "font": { "size": 12, "color": { "token": "color.text" } } },
      "expression": { "extends": "node", "stroke": { "dash": [ 3, 2 ], "dashScale": "absolute" }, "font": { "size": 11 } },
      "badges": { "font": { "size": 11, "color": { "token": "color.primary" } } },
      "row": { "font": { "size": 11, "color": { "token": "color.text.muted" } } },
      "edge": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5 } },
      "dimmed": { "opacity": 0.55 },
      "doubled": { "stroke": { "double": { "gap": 4 } } }
    },
    "nodes": {
      "Class": {
        "shape": "ellipse",
        "style": "node",
        "size": { "fixed": [ 190, 70 ] },
        "labels": [ { "id": "name", "text": { "cel": "self.display" }, "position": "center", "overflow": "ellipsis", "maxLines": 1, "editable": false } ],
        "ports": {
          "axiomLeft": { "shape": "none", "side": "left", "position": 0.5 },
          "axiomRight": { "shape": "none", "side": "right", "position": 0.5 }
        },
        "conditions": [
          { "when": "self.doubled", "style": "doubled", "doc": "Equivalence: a second ring 4 inside the first." },
          { "when": "self.deprecated || self.external", "style": "dimmed", "doc": "Deprecated and borrowed terms are dimmed alike." }
        ],
        "tooltip": { "cel": "self.display" },
        "doubleClick": "openForm"
      },
      "Thing": {
        "shape": "ellipse",
        "style": "node",
        "size": { "fixed": [ 104.5, 38.5 ] },
        "labels": [ { "id": "name", "text": { "cel": "self.display" }, "position": "center", "overflow": "ellipsis", "maxLines": 1, "editable": false } ],
        "ports": {
          "axiomLeft": { "shape": "none", "side": "left", "position": 0.5 },
          "axiomRight": { "shape": "none", "side": "right", "position": 0.5 }
        },
        "conditions": [
          { "when": "true", "style": { "stroke": { "dash": [ 4, 3 ], "dashScale": "absolute" } }, "doc": "owl:Thing is drawn dashed and at 0.55 of a class's size." },
          { "when": "self.doubled", "style": "doubled" },
          { "when": "self.deprecated", "style": "dimmed" }
        ],
        "tooltip": { "cel": "self.display" }
      },
      "ThingAnchor": {
        "shape": "ellipse",
        "style": { "extends": "node", "stroke": { "dash": [ 4, 3 ], "dashScale": "absolute" } },
        "size": { "fixed": [ 104.5, 38.5 ] },
        "labels": [ { "id": "name", "text": "Thing", "position": "center", "editable": false } ],
        "tooltip": "Thing",
        "deletable": false,
        "copyable": false
      },
      "Datatype": {
        "shape": "rect",
        "style": "node",
        "size": { "fixed": [ 190, 70 ] },
        "labels": [ { "id": "name", "text": { "cel": "self.display" }, "position": "center", "overflow": "ellipsis", "maxLines": 1, "editable": false } ],
        "conditions": [ { "when": "self.deprecated", "style": "dimmed" } ],
        "tooltip": { "cel": "self.display" },
        "doubleClick": "openForm"
      },
      "LiteralAnchor": {
        "shape": "rect",
        "style": "node",
        "size": { "fixed": [ 190, 70 ] },
        "labels": [ { "id": "name", "text": "Literal", "position": "center", "editable": false } ],
        "tooltip": "Literal",
        "deletable": false,
        "copyable": false
      },
      "Individual": {
        "shape": "rect",
        "style": "node",
        "size": { "width": 220, "height": { "cel": "30 + (size(self.badges) > 0 ? 16 : 0) + 16 * size(self.rows) + 10" }, "resizable": false },
        "labels": [
          { "id": "title", "text": { "cel": "self.display" }, "position": { "anchor": [ 0.5, 0 ], "offset": [ 0, 20 ] }, "overflow": "ellipsis", "maxLines": 1, "editable": false },
          { "id": "badges", "text": { "cel": "self.badges.join(' · ')" }, "position": { "anchor": [ 0, 0 ], "offset": [ 8, 40 ], "align": "start" },
            "style": "badges", "overflow": "ellipsis", "maxLines": 1, "visible": { "cel": "size(self.badges) > 0" } }
        ],
        "compartments": [
          { "id": "rows", "items": { "attribute": "rows" }, "itemText": { "cel": "item.predicate + ': ' + item.value + ' ' + item.annotation" },
            "itemStyle": "row", "layout": "vertical", "separator": "none", "overflow": "ellipsis", "editable": { "add": false, "remove": false, "reorder": false, "inline": false } }
        ],
        "conditions": [ { "when": "self.deprecated || self.external", "style": "dimmed" } ],
        "tooltip": { "cel": "self.display" },
        "doubleClick": "openForm"
      },
      "OntologyHeader": {
        "shape": "rect",
        "style": "node",
        "size": { "width": 220, "height": { "cel": "30 + 16 * size(self.rows) + 10" }, "resizable": false },
        "labels": [
          { "id": "title", "text": { "cel": "self.display" }, "position": { "anchor": [ 0.5, 0 ], "offset": [ 0, 20 ] }, "overflow": "ellipsis", "maxLines": 1, "editable": false }
        ],
        "compartments": [
          { "id": "rows", "items": { "attribute": "rows" }, "itemText": { "cel": "item.predicate + ': ' + item.value + ' ' + item.annotation" },
            "itemStyle": "row", "layout": "vertical", "separator": "none", "overflow": "ellipsis", "editable": { "add": false, "remove": false, "reorder": false, "inline": false } }
        ],
        "conditions": [ { "when": "self.deprecated", "style": "dimmed" } ],
        "tooltip": { "cel": "self.display" },
        "doubleClick": "openForm"
      },
      "Restriction": {
        "shape": "ellipse",
        "style": "expression",
        "size": { "fixed": [ 190, 70 ] },
        "labels": [ { "id": "name", "text": { "cel": "roundLabel(self.display, self.elided)" }, "position": "center", "overflow": "ellipsis", "maxLines": 1, "editable": false } ],
        "conditions": [
          { "when": "self.doubled", "style": "doubled" },
          { "when": "self.malformed", "style": { "stroke": { "color": { "token": "color.warning" } } }, "doc": "A broken structure is marked, not hidden." }
        ],
        "tooltip": { "cel": "self.display" },
        "deletable": false,
        "copyable": false
      },
      "Operator": {
        "shape": "ellipse",
        "style": "expression",
        "size": { "fixed": [ 190, 70 ] },
        "labels": [ { "id": "name", "text": { "cel": "roundLabel(self.display, self.elided)" }, "position": "center", "overflow": "ellipsis", "maxLines": 1, "editable": false } ],
        "conditions": [
          { "when": "self.doubled", "style": "doubled" },
          { "when": "self.malformed", "style": { "stroke": { "color": { "token": "color.warning" } } } }
        ],
        "tooltip": { "cel": "self.display" },
        "deletable": false,
        "copyable": false
      }
    },
    "edges": {
      "SubClassOf": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5, "dash": [ 6, 4 ], "dashScale": "absolute" }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "reconnectable": false,
        "doc": "Dashed, with an arrow at the superclass."
      },
      "EquivalentClass": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 2 }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "doc": "Solid and heavier, no marker; both ends also wear the doubled outline."
      },
      "DisjointWith": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5, "dash": [ 1, 5 ], "dashScale": "absolute", "cap": "round" }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "deletable": { "cel": "!self.fromGroup" },
        "doc": "Dotted with round caps, no marker."
      },
      "ObjectProperty": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5 }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [ { "id": "name", "text": { "cel": "self.label" }, "at": "middle", "side": "above", "distance": 6, "editable": false } ],
        "reconnectable": false,
        "deletable": false
      },
      "DatatypeProperty": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5 }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [ { "id": "name", "text": { "cel": "self.label" }, "at": "middle", "side": "above", "distance": 6, "editable": false } ],
        "reconnectable": false,
        "deletable": false
      },
      "Assertion": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5 }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [ { "id": "name", "text": { "cel": "self.name" }, "at": "middle", "side": "above", "distance": 6, "editable": false } ],
        "reconnectable": false
      },
      "References": {
        "line": { "stroke": { "color": { "token": "color.text.muted" }, "width": 1.5, "opacity": 0.7, "dash": [ 2, 3 ], "dashScale": "absolute" }, "routing": "straight" },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "deletable": false
      }
    },
    "canvas": {
      "watermark": { "id": "truncation", "text": { "cel": "'Showing ' + string(diagram.shown) + ' of ' + string(diagram.total) + ' elements — edits are withheld on this truncated view'" }, "visible": { "cel": "diagram.truncated" } }
    }
  },

  "forms": {
    "termInspector": {
      "for": [ "Class", "Thing", "Datatype", "Individual", "OntologyHeader" ],
      "usage": [ "inspector" ],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "iri", "widget": "readonly" },
          { "attribute": "types", "widget": "readonly" },
          { "attribute": "imports", "widget": "readonly", "visible": "self.isA('OntologyHeader')" }
        ] },
        { "kind": "section", "title": "Documentation", "items": [
          { "attribute": "label", "widget": "text", "readOnly": { "cel": "diagram.truncated" } },
          { "attribute": "comment", "widget": "textarea", "readOnly": { "cel": "diagram.truncated" } }
        ] },
        { "kind": "section", "title": "Axioms", "items": [
          { "attribute": "subClassOf", "widget": "readonly", "visible": "size(self.subClassOf) > 0" },
          { "attribute": "equivalentTo", "widget": "readonly", "visible": "size(self.equivalentTo) > 0" },
          { "attribute": "disjointWith", "widget": "readonly", "visible": "size(self.disjointWith) > 0" }
        ] },
        { "kind": "problems" }
      ]
    },
    "expressionInspector": {
      "for": [ "Expression" ],
      "usage": [ "inspector" ],
      "items": [
        { "kind": "section", "title": "Identity", "items": [ { "attribute": "text", "widget": "readonly" } ] },
        { "kind": "problems" }
      ]
    },
    "propertyInspector": {
      "for": [ "ObjectProperty", "DatatypeProperty" ],
      "usage": [ "inspector" ],
      "items": [
        { "kind": "section", "title": "Identity", "items": [ { "attribute": "property", "widget": "readonly" } ] },
        { "kind": "section", "title": "Axioms", "items": [
          { "attribute": "domain", "widget": "readonly" },
          { "attribute": "range", "widget": "readonly" },
          { "attribute": "inverseName", "widget": "readonly", "visible": "self.inverseName != ''" },
          { "attribute": "characteristics", "widget": "readonly", "visible": "size(self.characteristics) > 0" }
        ] }
      ]
    },
    "statementInspector": {
      "for": [ "Assertion" ],
      "usage": [ "inspector" ],
      "items": [ { "kind": "section", "title": "Identity", "items": [ { "attribute": "predicate", "widget": "readonly" } ] } ]
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      { "id": "ontology", "label": "OWL", "tools": [
        { "id": "class", "kind": "operation", "operation": "addClass", "label": "Class", "icon": "mdi:shape-circle-plus",
          "doc": "A named class. Drop it where it should sit; you will be asked for its name." },
        { "id": "objectProperty", "kind": "operation", "operation": "addObjectProperty", "label": "Object property", "icon": "mdi:ray-start-arrow",
          "doc": "A property relating individuals to individuals - drawn as an edge once it has a domain and a range." },
        { "id": "datatypeProperty", "kind": "operation", "operation": "addDatatypeProperty", "label": "Datatype property", "icon": "mdi:form-textbox",
          "doc": "A property relating individuals to data values - drawn as an edge to its datatype." },
        { "id": "individual", "kind": "operation", "operation": "addIndividual", "label": "Individual", "icon": "mdi:account-outline",
          "doc": { "summary": "A named individual - a member of the classes this ontology describes.", "rationale": "There is no restriction entry: a restriction needs a structure no drop can state." } }
      ] }
    ],
    "contextTools": [
      { "for": [ "Class", "Thing" ], "placement": "around", "tools": [
        { "kind": "connect", "via": "SubClassOf", "label": "Subclass of", "icon": "mdi:file-tree", "position": "left" },
        { "kind": "connect", "via": "SubClassOf", "label": "Subclass of", "icon": "mdi:file-tree", "position": "right" }
      ] }
    ],
    "contextMenus": [
      { "for": [ "Term" ], "placement": "menu", "when": "diagram.usable && !diagram.truncated", "tools": [
        { "kind": "operation", "operation": "rename", "label": "Rename…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove", "icon": "mdi:delete-outline", "shortcut": "Delete" }
      ] },
      { "for": [ "SubClassOf", "EquivalentClass", "Assertion" ], "placement": "menu", "when": "diagram.usable && !diagram.truncated", "tools": [
        { "kind": "delete", "label": "Remove statement", "icon": "mdi:vector-polyline-remove", "shortcut": "Delete" }
      ] },
      { "for": [ "DisjointWith" ], "placement": "menu", "when": "diagram.usable && !diagram.truncated && !self.fromGroup", "tools": [
        { "kind": "delete", "label": "Remove statement", "icon": "mdi:vector-polyline-remove", "shortcut": "Delete" }
      ] }
    ]
  },

  "constraints": {
    "doc": "Facts about the asserted ontology, never a reasoner's opinion: nothing is fetched and nothing is inferred. The shared engine's file-level findings (a parse failure, a redeclared prefix, relative IRIs without a base, a malformed language tag, an unknown XSD datatype) are reported by the Turtle plugin under this origin too; a parse failure replaces all of these.",
    "builtIn": {
      "std.endpoints": { "severity": "warning", "enabled": true }
    },
    "rules": [
      { "id": "subclassCycle", "label": "Subclass cycle", "scope": [ "Class", "Thing" ],
        "rule": "!self.inCycle('SubClassOf')", "severity": "warning", "cost": "expensive",
        "message": { "cel": "'These classes assert each other as subclasses in a cycle: ' + ([self] + self.reachable('SubClassOf').filter(c, c != self && self in c.reachable('SubClassOf'))).map(c, rdfDisplayName(c.iri)).join(', ') + '. That is legal OWL - it makes them mutually equivalent - and it is almost always a mistake.'" },
        "doc": { "summary": "owl.subclass-cycle", "rationale": "A cycle is legal OWL (it asserts mutual equivalence) and almost always an authoring mistake, which is what a warning is for." } },
      { "id": "malformedExpression", "label": "Malformed class expression", "scope": "Expression",
        "rule": "!self.malformed", "severity": "error",
        "message": { "cel": "\"This class expression is not well-formed: it renders as '\" + self.display + \"', with ? standing for what the structure is missing.\"" },
        "doc": "owl.malformed-expression" },
      { "id": "undeclaredProperty", "label": "Undeclared property", "scope": "diagram",
        "rule": "size(diagram.undeclaredProperties) == 0", "severity": "info",
        "message": { "cel": "diagram.undeclaredProperties.map(p, p + ' is used as a property but declared nowhere in this file - it may live in an import, which is deliberately not fetched.').join(' ')" },
        "doc": "owl.undeclared-property" },
      { "id": "deprecatedReference", "label": "Deprecated but referenced", "scope": "Term",
        "rule": "!self.deprecated || self.liveReferences == 0", "severity": "info",
        "message": { "cel": "rdfDisplayName(self.iri) + ' is deprecated, and something not deprecated still references it.'" },
        "doc": "owl.deprecated-reference" },
      { "id": "importsNotFetched", "label": "Imports not fetched", "scope": "OntologyHeader",
        "rule": "size(self.imports) == 0", "severity": "info",
        "message": { "cel": "self.imports.map(i, 'This ontology imports ' + i + ', which is not fetched: the diagram shows what this file asserts, not the import closure a reasoner would load.').join(' ')" },
        "doc": { "summary": "owl.imports-not-fetched", "rationale": "The no-network rule made visible: the drawn ontology is this file alone." } },
      { "id": "subclassNamedEnds", "kind": "connect", "when": "relationType == 'SubClassOf'",
        "rule": "source.isA('Term') && target.isA('Term') && !(source.isA('Individual') && source.punned) && !(target.isA('Individual') && target.punned)",
        "message": "A subclass relation needs two named classes." },
      { "id": "subclassNotRepeated", "kind": "connect", "when": "relationType == 'SubClassOf'",
        "rule": "!(target in source.successors('SubClassOf'))",
        "message": "That subclass relation is already asserted; drawing it again would state nothing new." },
      { "id": "expressionNotPositioned", "kind": "placement", "scope": "Expression",
        "rule": "false",
        "message": "That is an anonymous class expression, whose identity does not survive an edit to the file, so a stored position could not be trusted. It takes its place beside the class that uses it; edit the expression as text." },
      { "id": "anchorNotPositioned", "kind": "placement", "scope": [ "ThingAnchor", "LiteralAnchor" ],
        "rule": "false",
        "message": "That element is drawn where its property needs it and cannot be arranged on its own." },
      { "id": "unregisteredNotPositioned", "kind": "placement",
        "rule": "diagram.registered",
        "message": "This diagram was opened without a registration, so there is nowhere to store a position. Register the file to arrange it." },
      { "id": "readOnlyNotPositioned", "kind": "placement",
        "rule": "diagram.editable",
        "message": "This diagram is read-only." },
      { "id": "noReparentByDrag", "kind": "placement", "scope": "Term",
        "rule": "newParent == self.parent",
        "message": "An ontology element has no parent to move it under; dragging changes where it sits on the canvas." },
      { "id": "expressionNotEdited", "kind": "change", "scope": "Expression",
        "rule": "false",
        "message": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text." },
      { "id": "expressionNotDeleted", "kind": "delete", "scope": "Expression",
        "rule": "false",
        "message": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text." },
      { "id": "truncatedCreate", "kind": "create", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedConnect", "kind": "connect", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedDelete", "kind": "delete", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." },
      { "id": "truncatedChange", "kind": "change", "rule": "!diagram.truncated",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead." }
    ]
  },

  "behavior": {
    "operations": {
      "addClass": {
        "label": "Add class here…",
        "icon": "mdi:shape-circle-plus",
        "for": "diagram",
        "doc": "Writes exactly one triple, `<iri> a owl:Class`, as one undo. No label, no superclass.",
        "params": { "iri": { "type": "string", "label": "IRI or prefixed name", "required": true } },
        "enabled": "diagram.usable && !diagram.truncated",
        "actions": [
          { "let": { "resolved": "rdfResolveTerm(p.iri)" } },
          { "if": "resolved == ''", "then": [ { "abort": { "message": "rdfTermRefusal(p.iri)" } } ] },
          { "create": { "type": "'Class'", "attributes": { "iri": "resolved" } }, "as": "created" },
          { "select": "created" }
        ]
      },
      "addIndividual": {
        "label": "Add individual…",
        "icon": "mdi:account-outline",
        "for": "diagram",
        "doc": "Writes exactly one triple, `<iri> a owl:NamedIndividual`, as one undo. No class membership is written.",
        "params": { "iri": { "type": "string", "label": "IRI or prefixed name", "required": true } },
        "enabled": "diagram.usable && !diagram.truncated",
        "actions": [
          { "let": { "resolved": "rdfResolveTerm(p.iri)" } },
          { "if": "resolved == ''", "then": [ { "abort": { "message": "rdfTermRefusal(p.iri)" } } ] },
          { "create": { "type": "'Individual'", "attributes": { "iri": "resolved" } }, "as": "created" },
          { "select": "created" }
        ]
      },
      "addObjectProperty": {
        "label": "Add object property…",
        "icon": "mdi:ray-start-arrow",
        "for": "diagram",
        "doc": "Writes exactly one triple, `<iri> a owl:ObjectProperty`, as one undo. With no domain or range it draws between two Thing anchors of its own.",
        "params": { "iri": { "type": "string", "label": "IRI or prefixed name", "required": true } },
        "enabled": "diagram.usable && !diagram.truncated",
        "plugin": { "name": "net.etalii.adp.w3c.turtle", "args": { "action": "declareTerm", "type": "http://www.w3.org/2002/07/owl#ObjectProperty" } }
      },
      "addDatatypeProperty": {
        "label": "Add datatype property…",
        "icon": "mdi:form-textbox",
        "for": "diagram",
        "doc": "Writes exactly one triple, `<iri> a owl:DatatypeProperty`, as one undo. With no domain or range it draws from a Thing anchor to a Literal anchor.",
        "params": { "iri": { "type": "string", "label": "IRI or prefixed name", "required": true } },
        "enabled": "diagram.usable && !diagram.truncated",
        "plugin": { "name": "net.etalii.adp.w3c.turtle", "args": { "action": "declareTerm", "type": "http://www.w3.org/2002/07/owl#DatatypeProperty" } }
      },
      "rename": {
        "label": "Rename…",
        "icon": "mdi:pencil-outline",
        "shortcut": "F2",
        "for": [ "Term" ],
        "enabled": "diagram.usable && !diagram.truncated",
        "params": { "newName": { "type": "string", "label": "New IRI or prefixed name", "required": true } },
        "doc": "Rewrites every occurrence of the IRI - subject, predicate and object positions, prefixed or full - as one command; a target that already names something is refused before anything is written.",
        "plugin": { "name": "net.etalii.adp.w3c.turtle", "args": { "action": "renameTerm" } }
      }
    },
    "deletion": {
      "Term": { "relations": "delete", "confirm": "Removing this resource also removes the statements it appears in." }
    },
    "undo": { "mergeWindowMs": 0 }
  },

  "layout": {
    "doc": "Pure and deterministic, no physics: the same file always opens the same way. Authored positions from the registration override computed ones for named terms only; expressions and anchors always take their computed place.",
    "algorithms": {
      "depthColumns": {
        "algorithm": "plugin:net.etalii.adp.w3c.owlDepthColumns",
        "direction": "right",
        "spacing": { "node": 60, "layer": 90, "component": 140 },
        "options": {
          "columnWidth": 530, "laneOffsetX": 250, "slotHeight": 130, "satelliteHeight": 110, "satelliteFirstOffsetY": 10,
          "headerGap": 80, "bandGap": 140, "bandColumnGap": 60, "bandRowGap": 50, "bandColumns": 5
        },
        "doc": "The header card top-left; classes in columns by asserted subclass depth, roots left, a cycle collapsed to one depth; each class's expressions, datatypes and anchors in a lane beside it; individuals in a five-wide band below; anything left over in a band below that."
      },
      "fallback": {
        "algorithm": "layered",
        "direction": "left",
        "spacing": { "node": 60, "layer": 90 },
        "doc": "What a runtime without the plugin uses: a layered layout over the subclass edges, which run from subclass to superclass, so direction left puts the roots on the left."
      }
    },
    "default": "depthColumns",
    "trigger": "always",
    "respect": "all",
    "incremental": false
  },

  "persistence": {
    "doc": "The ontology's own Turtle or N-Triples file is the model; ADP writes only minimal splices into it. Positions live in the `.adp` registration's `layout:` block, keyed by element id, and nothing of ADP's is ever written into the RDF.",
    "format": "plugin:net.etalii.adp.w3c.turtle",
    "files": { "mode": "split", "model": "{name}.ttl", "view": "{name}.adp" },
    "ids": { "strategy": "natural", "stable": false, "pattern": "^(res:.+|ind:.+|expr:.+|thing:.+\\|(domain|range)|dt:.+|edge:.+)$" },
    "view": { "store": [ "bounds" ], "styleOverrides": "none" },
    "import": [ { "format": "plugin:net.etalii.adp.w3c.turtle", "label": "N-Triples (.nt)" } ]
  },

  "plugins": {
    "net.etalii.adp.w3c.turtle": {
      "version": "^0.1.0",
      "provides": [ "persistenceFormat", "import", "action", "celFunctions" ],
      "required": true,
      "doc": "The RDF family's shared engine: one store per file parsing Turtle and N-Triples into triples plus a line-level concrete syntax, byte-identical round trips, edits as minimal splices, the drawn-element budget, and the projection of triples onto this specification's elements. Shared with the w3c/rdf, w3c/skos and w3c/shacl specifications.",
      "celFunctions": [
        {"name": "rdfLocalName", "params": ["string"], "returns": "string", "cost": 1, "doc": "The part of an IRI after its last '#' or '/', or the whole IRI."},
        {"name": "rdfMintIri", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI for a new resource: the label slugged to [A-Za-z0-9_-] under the namespace of the file's first prefixed subject, else its first declared prefix; '' when neither exists or nothing usable is left."},
        {"name": "rdfMintRefusal", "params": ["string"], "returns": "string", "cost": 10, "doc": "The sentence explaining why rdfMintIri returned ''."},
        {"name": "rdfTermExists", "params": ["string"], "returns": "bool", "cost": 10, "doc": "The IRI appears as a subject or object anywhere in the file."},
        {"name": "rdfCompress", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI as the writer spells it: `prefix:local` under the longest declared namespace whose remainder is a clean local name, else the bracketed `<iri>`."},
        {"name": "rdfDisplayName", "params": ["string"], "returns": "string", "cost": 10, "doc": "An IRI as drawn: rdfCompress's prefixed name when there is one, else rdfLocalName when it is not empty, else the whole IRI unbracketed."},
        {"name": "rdfResolveTerm", "params": ["string"], "returns": "string", "cost": 10, "doc": "The full IRI a typed term names: a bracketed `<iri>`, a text containing '://', or `prefix:local` under a declared prefix; '' when it names nothing."},
        {"name": "rdfTermRefusal", "params": ["string"], "returns": "string", "cost": 10, "doc": "The sentence explaining why rdfResolveTerm returned ''."}
      ]
    },
    "net.etalii.adp.w3c.owlDepthColumns": {
      "version": "^1.0.0",
      "provides": [ "layout" ],
      "required": false,
      "fallback": { "layout": "layered" },
      "doc": "The subclass-depth column layout with satellite lanes and bottom bands; see w3c-owl.md."
    }
  },

  "x-adp": {
    "origin": "w3c/owl",
    "state": "implemented",
    "extensions": [ ".ttl", ".nt" ],
    "claimsBareFiles": false,
    "suggestWhenBodyContains": [ "owl:Ontology", "http://www.w3.org/2002/07/owl#Ontology" ],
    "family": [ "w3c/rdf", "w3c/owl", "w3c/skos", "w3c/shacl" ],
    "implementations": { "standalone": "etalii.adp.ide.standalone src/diagrams/rdf (Owl/)" }
  }
}
