{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.w3c.owl",
    "version": "2.0.0",
    "label": "OWL ontology",
    "icon": "mdi-shape-outline",
    "fileExtension": "ttl",
    "license": "Apache-2.0",
    "homepage": "https://www.w3.org/TR/owl2-overview/",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "limits": {
      "maxElements": 1000,
      "budgets": {
        "elements": {
          "measure": {
            "count": [
              "Class",
              "Thing",
              "Datatype",
              "Individual",
              "OntologyHeader",
              "ThingAnchor",
              "LiteralAnchor",
              "Restriction",
              "Operator"
            ]
          },
          "max": 1000,
          "order": "index",
          "withhold": {
            "edits": "model",
            "reason": {
              "reason": "truncated"
            }
          },
          "notice": {
            "text": {
              "cel": "'Showing ' + string(budget('elements').shown) + ' of ' + string(budget('elements').total) + ' elements — edits are withheld on this truncated view'"
            },
            "severity": "warning",
            "position": "top"
          },
          "doc": "At most 1000 nodes are drawn; an edge is drawn only when both its ends are. Today the cut walks whole units, a named node with its expressions and anchors, in order of first appearance (`w3c-owl.md`)."
        }
      }
    },
    "requires": {
      "conformance": "standard",
      "features": [
        "limits.budgets",
        "persistence.fbl"
      ]
    },
    "doc": {
      "summary": "Explore an OWL 2 ontology's classes, hierarchy and restrictions as a VOWL-style graph.",
      "description": "A reading of an OWL 2 ontology stored as Turtle (`.ttl`) or N-Triples (`.nt`): what the file *asserts*, not what a reasoner would infer. Classes are ellipses in columns by asserted subclass depth, roots on the left; datatypes are boxes; individuals and the `owl:Ontology` header are cards with their literal rows; object and datatype properties are labelled edges between their stated domains and ranges; anonymous class expressions (restrictions, unions, intersections, complements, enumerations) are compact dashed ellipses beside the class that uses them, labelled in DL symbols. Nothing is inferred, nothing is fetched: `owl:imports` is named, never followed.\n\nThe turtle plugin reads the file into stored `Triple`, `Prefix` and `Base` elements, which every reading of it shares; every node and edge here is derived from them (4.11), the expression text by a recursive function with a depth cap. Positions are kept in the `.adp` registration beside the file. What this specification cannot express is written down in `w3c-owl.md` beside this file.",
      "rationale": "OWL axioms are dense in Turtle or RDF/XML; the VOWL notation shows classes, properties and restrictions so an ontology can be checked by eye.",
      "tags": [
        "owl",
        "ontology",
        "vowl",
        "rdf",
        "semantic web",
        "asserted"
      ],
      "seeAlso": [
        {
          "title": "W3C OWL 2 overview",
          "href": "https://www.w3.org/TR/owl2-overview/"
        },
        {
          "title": "OWL 2 mapping to RDF graphs",
          "href": "https://www.w3.org/TR/owl2-mapping-to-rdf/"
        },
        {
          "title": "VOWL notation (Semantic Web Journal)",
          "href": "https://www.semantic-web-journal.net/system/files/swj750.pdf"
        },
        {
          "title": "WebVOWL",
          "href": "https://service.tib.eu/webvowl/"
        }
      ]
    },
    "origin": "w3c/owl"
  },
  "functions": {
    "typeTriple": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "bool",
      "cel": "t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' && t.oKind == 'iri'",
      "doc": "An `rdf:type` triple with an IRI object: a type, never an edge."
    },
    "isCell": {
      "params": [
        {
          "name": "ordinal",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'blank' && t.s == ordinal && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first')",
      "doc": "Whether a blank node is a cons cell of an RDF collection: one with an `rdf:first` triple."
    },
    "isPlumbing": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "bool",
      "cel": "t.sKind == 'blank' && (t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first' || t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest') && isCell(t.s)",
      "doc": "A collection's `rdf:first` or `rdf:rest` triple, which is folded into its members and never drawn itself."
    },
    "collectionMembers": {
      "params": [
        {
          "name": "cell",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "recursion": {
        "maxDepth": 1000,
        "atMaxDepth": "[]"
      },
      "cel": "cel.bind(f, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == cell && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first'), cel.bind(r, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == cell && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest'), f.size() == 0 ? [] : [f[0]] + (r.size() > 0 && r[0].oKind == 'blank' && isCell(r[0].o) ? collectionMembers(r[0].o) : [])))",
      "doc": "The `rdf:first` triples of the collection starting at `cell`, in order, walked through `rdf:rest` until `rdf:nil` or a node that is no cons cell."
    },
    "repeatSuffix": {
      "params": [
        {
          "name": "e",
          "type": "Element"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(same, e.isA('Triple') ? diagram.nodesOfType('Triple').filter(u, u.s == e.s && u.p == e.p && u.o == e.o) : diagram.nodesOfType('Prefix').filter(u, u.name == e.name), cel.bind(n, e.positionIn(same), n > 0 ? '|' + string(n) : ''))",
      "doc": "The repeat counter of a stored triple or prefix declaration (11.5.2): '' for the first with its parts, '|1' for the second and so on, in reading order."
    },
    "withRepeat": {
      "params": [
        {
          "name": "xs",
          "type": "list"
        }
      ],
      "returns": "list",
      "cel": "lists.range(xs.size()).map(i, xs[i] + [lists.range(i).filter(j, xs[j][0] == xs[i][0]).size()])",
      "doc": "Each item of `xs`, whose first entry is its key, with the number of earlier items of the same key appended: the repeat counter of a derived edge id (11.5.2), 0 for the first."
    },
    "cardId": {
      "params": [
        {
          "name": "term",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "(kind == 'blank' ? 'blank:' : 'res:') + term",
      "doc": "The id of the card the RDF graph reading draws a subject or object term as."
    },
    "cardTerms": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "isPlumbing(t) ? [] : ([[t.s, t.sKind, t.sLabel, t]] + (typeTriple(t) || t.oKind == 'literal' ? [] : (t.oKind == 'blank' && isCell(t.o) ? collectionMembers(t.o).filter(m, m.oKind != 'literal').map(m, [m.o, m.oKind, m.oLabel, t]) : [[t.o, t.oKind, t.oLabel, t]])))",
      "doc": "The terms a triple draws an RDF graph card for, in the order the tool meets them: its subject, then its object or its collection's members, each with its kind, its written label and the triple. A type's IRI and a literal are no card; a cons cell is folded away."
    },
    "familyTruncated": {
      "params": [],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').map(t, cardTerms(t)).flatten().map(c, cardId(c[0], c[1])).distinct().size() > 1000",
      "doc": "Whether the RDF graph reading of this body is cut by its budget of 1000 cards. Every reading withholds its edits while it is, because the tool gates every reading's edits on that one count."
    },
    "owlBuiltIn": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "cel": "iri.startsWith('http://www.w3.org/2002/07/owl#') || iri.startsWith('http://www.w3.org/2000/01/rdf-schema#') || iri.startsWith('http://www.w3.org/1999/02/22-rdf-syntax-ns#') || iri.startsWith('http://www.w3.org/2001/XMLSchema#')",
      "doc": "Whether the IRI is vocabulary (OWL, RDFS, RDF or XSD) rather than this ontology's own entity."
    },
    "owlTyped": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        },
        {
          "name": "types",
          "type": "list"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == iri && typeTriple(t) && t.o in types)",
      "doc": "Whether the file types the IRI as one of `types`."
    },
    "owlDatatype": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "iri.startsWith('http://www.w3.org/2001/XMLSchema#') || iri == 'http://www.w3.org/2000/01/rdf-schema#Literal' || iri == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#langString' || owlTyped(iri, ['http://www.w3.org/2000/01/rdf-schema#Datatype'])",
      "doc": "A datatype in this file's terms: XSD's, `rdfs:Literal`, `rdf:langString`, or one typed `rdfs:Datatype`."
    },
    "owlDisjointMember": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(g, g.sKind == 'blank' && typeTriple(g) && g.o == 'http://www.w3.org/2002/07/owl#AllDisjointClasses' && diagram.nodesOfType('Triple').exists(m, m.sKind == 'blank' && m.s == g.s && m.p == 'http://www.w3.org/2002/07/owl#members' && m.oKind == 'blank' && collectionMembers(m.o).exists(x, x.oKind == 'iri' && x.o == iri)))",
      "doc": "Whether the IRI is a member of an `owl:AllDisjointClasses` group."
    },
    "owlClass": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && ((t.s == iri && ((typeTriple(t) && t.o in ['http://www.w3.org/2002/07/owl#Class', 'http://www.w3.org/2000/01/rdf-schema#Class']) || t.p == 'http://www.w3.org/2000/01/rdf-schema#subClassOf' || ((t.p == 'http://www.w3.org/2002/07/owl#equivalentClass' || t.p == 'http://www.w3.org/2002/07/owl#disjointWith') && t.oKind == 'iri'))) || (t.oKind == 'iri' && t.o == iri && t.p in ['http://www.w3.org/2000/01/rdf-schema#domain', 'http://www.w3.org/2000/01/rdf-schema#subClassOf', 'http://www.w3.org/2002/07/owl#equivalentClass', 'http://www.w3.org/2002/07/owl#disjointWith']))) || owlDisjointMember(iri)",
      "doc": "Whether the file uses the IRI as a class: typed `owl:Class` or `rdfs:Class`, either end of `rdfs:subClassOf`, an `rdfs:domain`, either end of an IRI-to-IRI `owl:equivalentClass` or `owl:disjointWith`, or a member of `owl:AllDisjointClasses`. Classification by role, so a punned IRI is several things."
    },
    "owlIndividual": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == iri && typeTriple(t) && (t.o == 'http://www.w3.org/2002/07/owl#NamedIndividual' || (!owlBuiltIn(t.o) && owlClass(t.o))))",
      "doc": "An IRI typed `owl:NamedIndividual`, or typed by a class this file uses as one."
    },
    "owlOntologyIri": {
      "params": [],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(o, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && typeTriple(t) && t.o == 'http://www.w3.org/2002/07/owl#Ontology'), o.size() > 0 ? o[0].s : '')",
      "doc": "The subject of the first `rdf:type owl:Ontology` triple, or ''."
    },
    "owlDisplay": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : rdfDisplayName(iri))",
      "doc": "A term as the ontology reading draws it: its first `rdfs:label` in any language, else its name as drawn."
    },
    "owlTerms": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').map(t, [[t.s, t.sKind], [t.o, t.oKind]]).flatten().filter(x, x[1] == 'iri').map(x, x[0]).distinct()",
      "doc": "Every IRI in subject or object position, in order of first appearance: the order nodes are met in."
    },
    "owlHasNode": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "owlClass(iri) || iri == 'http://www.w3.org/2002/07/owl#Thing' || owlDatatype(iri) || owlIndividual(iri) || iri == owlOntologyIri()",
      "doc": "Whether a named node carries the IRI under `res:`."
    },
    "owlIndividualId": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "(owlClass(iri) ? 'ind:' : 'res:') + iri",
      "doc": "An individual's id: `ind:` beside its class's `res:` when the IRI is punned."
    },
    "owlRows": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == iri && t.oKind == 'literal' && t.p != 'http://www.w3.org/2002/07/owl#deprecated').map(t, {'predicate': rdfDisplayName(t.p), 'value': t.o, 'annotation': t.language != '' ? '@' + t.language : (t.datatype != '' && t.datatype != 'http://www.w3.org/2001/XMLSchema#string' ? rdfCompress(t.datatype) : '')})",
      "doc": "Every literal-valued triple about the IRI, `owl:deprecated` excepted, in document order."
    },
    "owlDeprecated": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == iri && t.p == 'http://www.w3.org/2002/07/owl#deprecated' && t.oKind == 'literal' && t.o == 'true')",
      "doc": "The file asserts `owl:deprecated true` on the IRI."
    },
    "owlExternal": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "!owlBuiltIn(iri) && !diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == iri)",
      "doc": "Used here, owned elsewhere: not built in and never the subject of a triple in this file."
    },
    "owlCharacteristics": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(words, {'http://www.w3.org/2002/07/owl#FunctionalProperty': 'functional', 'http://www.w3.org/2002/07/owl#InverseFunctionalProperty': 'inverse functional', 'http://www.w3.org/2002/07/owl#TransitiveProperty': 'transitive', 'http://www.w3.org/2002/07/owl#SymmetricProperty': 'symmetric', 'http://www.w3.org/2002/07/owl#AsymmetricProperty': 'asymmetric', 'http://www.w3.org/2002/07/owl#ReflexiveProperty': 'reflexive', 'http://www.w3.org/2002/07/owl#IrreflexiveProperty': 'irreflexive'}, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == iri && typeTriple(t) && t.o in words).map(t, words[t.o]))",
      "doc": "One word per characteristic type triple of the property, in document order."
    },
    "owlInverse": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(i, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == iri && t.p == 'http://www.w3.org/2002/07/owl#inverseOf' && t.oKind == 'iri'), i.size() > 0 ? owlDisplay(i[i.size() - 1].o) : '')",
      "doc": "The display of the last `owl:inverseOf` object of the property, or ''."
    },
    "owlProperties": {
      "params": [
        {
          "name": "types",
          "type": "list"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && typeTriple(t) && t.o in types).map(t, t.s).distinct()",
      "doc": "The properties typed as one of `types`, in the order their first such type triple appears."
    },
    "owlObjects": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        },
        {
          "name": "predicate",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == iri && t.p == predicate && t.oKind == 'iri').map(t, t.o)",
      "doc": "The IRI objects of `iri predicate ?`, in document order, repeats kept."
    },
    "owlDomainIds": {
      "params": [
        {
          "name": "property",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(d, owlObjects(property, 'http://www.w3.org/2000/01/rdf-schema#domain').filter(c, owlHasNode(c)).map(c, 'res:' + c), d.size() > 0 ? d : ['thing:' + property + '|domain'])",
      "doc": "The nodes a property starts at: each stated domain, or its own Thing anchor."
    },
    "owlRangeIds": {
      "params": [
        {
          "name": "property",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(r, owlObjects(property, 'http://www.w3.org/2000/01/rdf-schema#range').filter(c, !owlDatatype(c) && owlHasNode(c)).map(c, 'res:' + c), r.size() > 0 ? r : ['thing:' + property + '|range'])",
      "doc": "The nodes an object property ends at: each stated range that is no datatype, or its own Thing anchor."
    },
    "owlDatatypeRangeIds": {
      "params": [
        {
          "name": "property",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(r, owlObjects(property, 'http://www.w3.org/2000/01/rdf-schema#range').filter(c, owlDatatype(c)).map(c, 'res:' + c), r.size() > 0 ? r : ['dt:' + property])",
      "doc": "The nodes a datatype property ends at: each datatype range, or its own Literal anchor."
    },
    "owlAbout": {
      "params": [
        {
          "name": "blank",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == blank)",
      "doc": "The triples whose subject is the blank node, in document order."
    },
    "owlReferences": {
      "params": [
        {
          "name": "blank",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "owlAbout(blank).map(t, t.p in ['http://www.w3.org/2002/07/owl#someValuesFrom', 'http://www.w3.org/2002/07/owl#allValuesFrom', 'http://www.w3.org/2002/07/owl#onClass', 'http://www.w3.org/2002/07/owl#onDataRange', 'http://www.w3.org/2002/07/owl#hasValue', 'http://www.w3.org/2002/07/owl#complementOf'] ? [[t.o, t.oKind]] : (t.p in ['http://www.w3.org/2002/07/owl#unionOf', 'http://www.w3.org/2002/07/owl#intersectionOf', 'http://www.w3.org/2002/07/owl#oneOf'] && t.oKind == 'blank' ? collectionMembers(t.o).map(m, [m.o, m.oKind]) : [])).flatten()",
      "doc": "What an expression mentions, in order: the filler of a quantifier, `owl:onClass` or `owl:onDataRange`, the object of `owl:complementOf`, each member of a set operator's list. `owl:onProperty` is not a reference."
    },
    "owlExpressionNodes": {
      "params": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "owner",
          "type": "string"
        },
        {
          "name": "axiom",
          "type": "string"
        },
        {
          "name": "blank",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "recursion": {
        "maxDepth": 1000,
        "atMaxDepth": "[]"
      },
      "cel": "cel.bind(kids, owlReferences(blank).filter(c, c[1] == 'blank'), [[id, owner, axiom, blank]] + lists.range(kids.size()).map(i, owlExpressionNodes(id + '/' + string(i), owner, axiom, kids[i][0])).flatten())",
      "doc": "The expression rooted at `blank` and every blank expression nested in it, depth first, each with its structural id: the parent's id and `/` and its position among the parent's blank references."
    },
    "owlExpressions": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(xs, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.p in ['http://www.w3.org/2000/01/rdf-schema#subClassOf', 'http://www.w3.org/2002/07/owl#equivalentClass', 'http://www.w3.org/2002/07/owl#disjointWith']), lists.range(xs.size()).filter(i, xs[i].oKind == 'blank').map(i, owlExpressionNodes('expr:' + xs[i].s + '|' + xs[i].p + '|' + string(lists.range(i).filter(j, xs[j].s == xs[i].s && xs[j].p == xs[i].p).size()), 'res:' + xs[i].s, xs[i].p, xs[i].o)).flatten())",
      "doc": "Every drawn class expression: a blank object of `rdfs:subClassOf`, `owl:equivalentClass` or `owl:disjointWith` with a named subject, numbered by the axiom's position among that subject's axioms of that predicate, and everything nested in it."
    },
    "owlOperator": {
      "params": [
        {
          "name": "blank",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "owlAbout(blank).exists(t, t.p in ['http://www.w3.org/2002/07/owl#unionOf', 'http://www.w3.org/2002/07/owl#intersectionOf', 'http://www.w3.org/2002/07/owl#complementOf', 'http://www.w3.org/2002/07/owl#oneOf'])",
      "doc": "Whether the expression is a set operator rather than a restriction."
    },
    "owlTextKids": {
      "params": [
        {
          "name": "blank",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(about, owlAbout(blank), cel.bind(op, about.filter(t, t.p in ['http://www.w3.org/2002/07/owl#unionOf', 'http://www.w3.org/2002/07/owl#intersectionOf', 'http://www.w3.org/2002/07/owl#complementOf', 'http://www.w3.org/2002/07/owl#oneOf']), op.size() > 0 ? (op[0].p == 'http://www.w3.org/2002/07/owl#complementOf' ? [[op[0].o, op[0].oKind]] : (op[0].oKind == 'blank' ? collectionMembers(op[0].o).map(m, [m.o, m.oKind]) : [])) : cel.bind(q, about.filter(t, t.p in ['http://www.w3.org/2002/07/owl#someValuesFrom', 'http://www.w3.org/2002/07/owl#allValuesFrom', 'http://www.w3.org/2002/07/owl#hasValue', 'http://www.w3.org/2002/07/owl#cardinality', 'http://www.w3.org/2002/07/owl#minCardinality', 'http://www.w3.org/2002/07/owl#maxCardinality', 'http://www.w3.org/2002/07/owl#qualifiedCardinality', 'http://www.w3.org/2002/07/owl#minQualifiedCardinality', 'http://www.w3.org/2002/07/owl#maxQualifiedCardinality']), q.size() == 0 ? [] : (q[0].p in ['http://www.w3.org/2002/07/owl#someValuesFrom', 'http://www.w3.org/2002/07/owl#allValuesFrom', 'http://www.w3.org/2002/07/owl#hasValue'] ? [[q[0].o, q[0].oKind]] : (q[0].p in ['http://www.w3.org/2002/07/owl#qualifiedCardinality', 'http://www.w3.org/2002/07/owl#minQualifiedCardinality', 'http://www.w3.org/2002/07/owl#maxQualifiedCardinality'] ? cel.bind(f, about.filter(t, t.p == 'http://www.w3.org/2002/07/owl#onClass' || t.p == 'http://www.w3.org/2002/07/owl#onDataRange'), f.size() > 0 ? [[f[0].o, f[0].oKind]] : []) : [])))))",
      "doc": "The terms an expression's text renders inside it, in order."
    },
    "owlFlag": {
      "params": [
        {
          "name": "term",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        },
        {
          "name": "depth",
          "type": "int"
        },
        {
          "name": "path",
          "type": "list"
        },
        {
          "name": "cap",
          "type": "int"
        },
        {
          "name": "which",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "recursion": {
        "maxDepth": 1000,
        "atMaxDepth": "false"
      },
      "cel": "kind != 'blank' ? false : (depth > cap ? which == 'elided' : (term in path ? which == 'cyclic' : owlTextKids(term).exists(c, owlFlag(c[0], c[1], depth + 1, path + [term], cap, which))))",
      "doc": "Whether rendering the term at `depth` under `cap` elides structure (`which` 'elided') or revisits a node already on its path (`which` 'cyclic'). The depth cap is checked first, as the renderer does."
    },
    "owlText": {
      "params": [
        {
          "name": "term",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        },
        {
          "name": "depth",
          "type": "int"
        },
        {
          "name": "path",
          "type": "list"
        },
        {
          "name": "cap",
          "type": "int"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "recursion": {
        "maxDepth": 1000,
        "atMaxDepth": "'…'"
      },
      "cel": "kind == 'iri' ? owlDisplay(term) : (kind == 'literal' ? term : (kind != 'blank' ? '?' : (depth > cap || term in path ? '…' : cel.bind(about, owlAbout(term), cel.bind(inner, path + [term], cel.bind(op, about.filter(t, t.p in ['http://www.w3.org/2002/07/owl#unionOf', 'http://www.w3.org/2002/07/owl#intersectionOf', 'http://www.w3.org/2002/07/owl#complementOf', 'http://www.w3.org/2002/07/owl#oneOf']), op.size() > 0 ? cel.bind(members, op[0].oKind != 'blank' ? [] : collectionMembers(op[0].o).map(m, owlText(m.o, m.oKind, depth + 1, inner, cap)), op[0].p == 'http://www.w3.org/2002/07/owl#unionOf' ? '(' + (members.size() == 0 ? '?' : members.join(' ∪ ')) + ')' : (op[0].p == 'http://www.w3.org/2002/07/owl#intersectionOf' ? '(' + (members.size() == 0 ? '?' : members.join(' ∩ ')) + ')' : (op[0].p == 'http://www.w3.org/2002/07/owl#complementOf' ? '¬' + owlText(op[0].o, op[0].oKind, depth + 1, inner, cap) : '{' + (members.size() == 0 ? '?' : members.join(', ')) + '}'))) : cel.bind(pr, about.filter(t, t.p == 'http://www.w3.org/2002/07/owl#onProperty'), cel.bind(pt, pr.size() > 0 && pr[0].oKind == 'iri' ? owlDisplay(pr[0].o) : '?', cel.bind(q, about.filter(t, t.p in ['http://www.w3.org/2002/07/owl#someValuesFrom', 'http://www.w3.org/2002/07/owl#allValuesFrom', 'http://www.w3.org/2002/07/owl#hasValue', 'http://www.w3.org/2002/07/owl#cardinality', 'http://www.w3.org/2002/07/owl#minCardinality', 'http://www.w3.org/2002/07/owl#maxCardinality', 'http://www.w3.org/2002/07/owl#qualifiedCardinality', 'http://www.w3.org/2002/07/owl#minQualifiedCardinality', 'http://www.w3.org/2002/07/owl#maxQualifiedCardinality']), q.size() == 0 ? '? ' + pt : (q[0].p in ['http://www.w3.org/2002/07/owl#someValuesFrom', 'http://www.w3.org/2002/07/owl#allValuesFrom', 'http://www.w3.org/2002/07/owl#hasValue'] ? {'http://www.w3.org/2002/07/owl#someValuesFrom': '∃', 'http://www.w3.org/2002/07/owl#allValuesFrom': '∀', 'http://www.w3.org/2002/07/owl#hasValue': '∋'}[q[0].p] + ' ' + pt + '.' + owlText(q[0].o, q[0].oKind, depth + 1, inner, cap) : cel.bind(head, {'http://www.w3.org/2002/07/owl#cardinality': '=', 'http://www.w3.org/2002/07/owl#minCardinality': '≥', 'http://www.w3.org/2002/07/owl#maxCardinality': '≤', 'http://www.w3.org/2002/07/owl#qualifiedCardinality': '=', 'http://www.w3.org/2002/07/owl#minQualifiedCardinality': '≥', 'http://www.w3.org/2002/07/owl#maxQualifiedCardinality': '≤'}[q[0].p] + ' ' + (q[0].oKind == 'literal' ? q[0].o : '?') + ' ' + pt, !(q[0].p in ['http://www.w3.org/2002/07/owl#qualifiedCardinality', 'http://www.w3.org/2002/07/owl#minQualifiedCardinality', 'http://www.w3.org/2002/07/owl#maxQualifiedCardinality']) ? head : cel.bind(f, about.filter(t, t.p == 'http://www.w3.org/2002/07/owl#onClass' || t.p == 'http://www.w3.org/2002/07/owl#onDataRange'), f.size() > 0 ? head + '.' + owlText(f[0].o, f[0].oKind, depth + 1, inner, cap) : head))))))))))))",
      "doc": "The Manchester-style text of a term inside an expression: a named term's display, a literal's lexical form, `…` past the depth cap or at a node already on the path; for a blank node, the first operator triple as `(A ∪ B)`, `(A ∩ B)`, `¬A` or `{a, b}` with `?` for an empty list, else a restriction, `∃ p.C`, `∀ p.C`, `∋ p.v`, `= n p`, `≥ n p`, `≤ n p` and the qualified forms with `.C`, `?` standing for a missing property or count and `? p` for a missing quantifier."
    },
    "owlListBroken": {
      "params": [
        {
          "name": "head",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "recursion": {
        "maxDepth": 1000,
        "atMaxDepth": "true"
      },
      "cel": "kind == 'blank' ? (isCell(head) ? cel.bind(r, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == head && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest'), r.size() > 0 ? owlListBroken(r[0].o, r[0].oKind) : false) : true) : !(kind == 'iri' && head == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#nil')",
      "doc": "Whether a set operator's list ends anywhere but `rdf:nil`."
    },
    "owlMalformed": {
      "params": [
        {
          "name": "blank",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(about, owlAbout(blank), (!owlOperator(blank) && (!about.exists(t, t.p == 'http://www.w3.org/2002/07/owl#onProperty') || about.filter(t, t.p in ['http://www.w3.org/2002/07/owl#someValuesFrom', 'http://www.w3.org/2002/07/owl#allValuesFrom', 'http://www.w3.org/2002/07/owl#hasValue', 'http://www.w3.org/2002/07/owl#cardinality', 'http://www.w3.org/2002/07/owl#minCardinality', 'http://www.w3.org/2002/07/owl#maxCardinality', 'http://www.w3.org/2002/07/owl#qualifiedCardinality', 'http://www.w3.org/2002/07/owl#minQualifiedCardinality', 'http://www.w3.org/2002/07/owl#maxQualifiedCardinality']).size() != 1)) || about.exists(t, t.p in ['http://www.w3.org/2002/07/owl#unionOf', 'http://www.w3.org/2002/07/owl#intersectionOf', 'http://www.w3.org/2002/07/owl#oneOf'] && owlListBroken(t.o, t.oKind)) || owlFlag(blank, 'blank', 1, [], 2, 'cyclic'))",
      "doc": "A restriction without `owl:onProperty` or without exactly one quantifier, a set-operator list that does not end in `rdf:nil`, or a structure that revisits itself within the canvas depth."
    },
    "owlFillers": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "owlExpressions().map(e, owlReferences(e[3]).filter(c, c[1] == 'iri' && (!owlBuiltIn(c[0]) || owlDatatype(c[0]) || c[0] == 'http://www.w3.org/2002/07/owl#Thing' || c[0] == 'http://www.w3.org/2002/07/owl#Nothing')).map(c, c[0])).flatten().distinct()",
      "doc": "The named terms expressions draw a reference to."
    },
    "owlEdges": {
      "params": [
        {
          "name": "xs",
          "type": "list"
        }
      ],
      "returns": "list",
      "cel": "withRepeat(xs.map(x, [x[0] + '|' + x[1] + '|' + x[2]] + x))",
      "doc": "Edge items `[from, property, to, …]` keyed `from|property|to` and numbered as the tool numbers a repeat (`edge:a|p|b|1`)."
    },
    "owlUndeclared": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(c, (t.p == 'http://www.w3.org/2000/01/rdf-schema#domain' || t.p == 'http://www.w3.org/2000/01/rdf-schema#range') && t.sKind == 'iri' ? t.s : (t.p == 'http://www.w3.org/2002/07/owl#onProperty' && t.oKind == 'iri' ? t.o : ''), c == '' || owlBuiltIn(c) || owlTyped(c, ['http://www.w3.org/2002/07/owl#ObjectProperty', 'http://www.w3.org/2002/07/owl#InverseFunctionalProperty', 'http://www.w3.org/2002/07/owl#TransitiveProperty', 'http://www.w3.org/2002/07/owl#SymmetricProperty', 'http://www.w3.org/2002/07/owl#AsymmetricProperty', 'http://www.w3.org/2002/07/owl#ReflexiveProperty', 'http://www.w3.org/2002/07/owl#IrreflexiveProperty', 'http://www.w3.org/2002/07/owl#DatatypeProperty', 'http://www.w3.org/2002/07/owl#AnnotationProperty']) ? '' : c)",
      "doc": "The IRI a triple uses as a property without the file declaring it as an object, datatype or annotation property, or ''."
    },
    "owlDeprecatedTarget": {
      "params": [
        {
          "name": "t",
          "type": "Element"
        }
      ],
      "returns": "string",
      "uses": [
        "diagram"
      ],
      "cel": "t.p != 'http://www.w3.org/2002/07/owl#deprecated' && t.p != 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' && t.oKind == 'iri' && owlDeprecated(t.o) && !(t.sKind == 'iri' && owlDeprecated(t.s)) ? t.o : ''",
      "doc": "The deprecated IRI a non-deprecated axiom references, or ''."
    },
    "propertyLabel": {
      "params": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "words",
          "type": "list(string)"
        },
        {
          "name": "inverse",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "size(words) == 0 && inverse == '' ? name : name + ' (' + (words + (inverse == '' ? [] : ['inverse of ' + inverse])).join(', ') + ')'",
      "doc": "A property edge's label: the property's display name, then its characteristic words in the order their type triples appear and 'inverse of' the property it names, in parentheses."
    },
    "roundLabel": {
      "params": [
        {
          "name": "display",
          "type": "string"
        },
        {
          "name": "elided",
          "type": "bool"
        }
      ],
      "returns": "string",
      "cel": "elided ? display + ' …' : display",
      "doc": "The text drawn inside a round shape: an elided expression's label carries a trailing ellipsis, so the cut is visible as such."
    },
    "owlAxioms": {
      "params": [
        {
          "name": "iri",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(names, {'http://www.w3.org/2000/01/rdf-schema#subClassOf': 'Subclass of', 'http://www.w3.org/2002/07/owl#equivalentClass': 'Equivalent to', 'http://www.w3.org/2002/07/owl#disjointWith': 'Disjoint with', 'http://www.w3.org/2000/01/rdf-schema#domain': 'Domain', 'http://www.w3.org/2000/01/rdf-schema#range': 'Range', 'http://www.w3.org/2002/07/owl#inverseOf': 'Inverse of'}, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == iri && t.p in names).map(t, {'name': names[t.p], 'value': t.oKind == 'iri' ? rdfDisplayName(t.o) : (t.oKind == 'blank' ? owlText(t.o, 'blank', 1, [], 1000) : ''), 'expression': t.oKind == 'blank'}) + owlCharacteristics(iri).map(w, {'name': 'Characteristic', 'value': w, 'expression': false}))",
      "doc": "A term's axioms as the property grid lists them: each axiom triple about it in document order, an expression rendered in full, then its characteristics."
    }
  },
  "metamodel": {
    "doc": "Only what the file asserts, classified by OWL's own vocabulary and never inferred. One IRI can play several roles at once (punning): a class and an individual draw as two elements. Properties are never nodes; they are edges derived from their domain and range triples. The turtle plugin reads the triples into stored `Triple`, `Prefix` and `Base` elements, which every reading of the file shares; every node and edge here is derived from them (4.11), in the order the tool meets them.",
    "dataTypes": {
      "LiteralRow": {
        "doc": "One triple with this element's IRI as subject and a literal as object, `owl:deprecated` excepted; the header also gets one row per `owl:imports`.",
        "fields": {
          "predicate": {
            "type": "string",
            "required": true,
            "doc": "The predicate as a prefixed name under the file's own prefixes."
          },
          "value": {
            "type": "string",
            "required": true,
            "doc": "The literal's lexical form."
          },
          "annotation": {
            "type": "string",
            "default": "",
            "doc": "`@lang`, or the compressed datatype when it is not `xsd:string`; empty otherwise."
          }
        },
        "display": {
          "cel": "value.predicate + ': ' + value.value + ' ' + value.annotation"
        }
      },
      "AxiomRow": {
        "doc": "One axiom of a term as the property grid lists it.",
        "fields": {
          "name": {
            "type": "string",
            "required": true,
            "doc": "Subclass of, Equivalent to, Disjoint with, Domain, Range, Inverse of or Characteristic."
          },
          "value": {
            "type": "string",
            "required": true,
            "doc": "A named object's display, an expression's full rendering, '' for a literal, or the characteristic's word."
          },
          "expression": {
            "type": "bool",
            "default": false,
            "doc": "The row renders a class expression, whose reason is the expression's identity sentence rather than the axioms' one."
          }
        },
        "display": {
          "cel": "value.name + ': ' + value.value"
        }
      }
    },
    "enums": {
      "TermKind": {
        "values": {
          "iri": {
            "label": "IRI"
          },
          "blank": {
            "label": "Blank node"
          },
          "literal": {
            "label": "Literal"
          }
        }
      },
      "PrefixForm": {
        "values": {
          "turtle": {
            "label": "@prefix"
          },
          "sparql": {
            "label": "PREFIX"
          }
        }
      },
      "AxiomKind": {
        "doc": "The three predicates whose blank-node object roots a drawn class expression.",
        "values": {
          "subClassOf": {
            "label": "Subclass of"
          },
          "equivalentClass": {
            "label": "Equivalent to"
          },
          "disjointWith": {
            "label": "Disjoint with"
          }
        }
      },
      "OperatorKind": {
        "doc": "The set operators an operator expression draws.",
        "values": {
          "union": {
            "label": "∪",
            "doc": "`owl:unionOf` over an `rdf:List`."
          },
          "intersection": {
            "label": "∩",
            "doc": "`owl:intersectionOf` over an `rdf:List`."
          },
          "complement": {
            "label": "¬",
            "doc": "`owl:complementOf`."
          },
          "oneOf": {
            "label": "{ }",
            "doc": "`owl:oneOf`, an enumeration of individuals or values."
          }
        }
      },
      "AnchorSide": {
        "doc": "Which end of a property an anchor stands in for.",
        "values": {
          "domain": {},
          "range": {}
        }
      }
    },
    "types": {
      "Triple": {
        "doc": "One triple of the file as the plugin reads it, with the line it starts on. Never drawn: every drawn element is derived from these.",
        "attributes": {
          "s": {
            "type": "string",
            "required": true,
            "doc": "The subject: an IRI, or for a blank node its ordinal, the zero-based order of first appearance in this parse."
          },
          "sKind": {
            "type": "TermKind",
            "required": true
          },
          "sLabel": {
            "type": "string",
            "default": "",
            "doc": "A blank subject's label as written (`_:x` is `x`); '' for an IRI or an anonymous blank node."
          },
          "p": {
            "type": "uri",
            "required": true
          },
          "o": {
            "type": "string",
            "required": true,
            "doc": "The object: an IRI, a blank node's ordinal, or a literal's lexical form."
          },
          "oKind": {
            "type": "TermKind",
            "required": true
          },
          "oLabel": {
            "type": "string",
            "default": "",
            "doc": "A blank object's label as written; '' otherwise."
          },
          "language": {
            "type": "string",
            "default": ""
          },
          "datatype": {
            "type": "string",
            "default": ""
          },
          "line": {
            "type": "int",
            "readOnly": true,
            "doc": "The 1-based line the triple's subject is written on."
          }
        }
      },
      "Prefix": {
        "doc": "One `@prefix` or `PREFIX` directive, re-declarations included, in document order. Never drawn.",
        "attributes": {
          "name": {
            "type": "string",
            "required": true,
            "doc": "The prefix without its colon; '' for the default prefix."
          },
          "iri": {
            "type": "uri",
            "required": true
          },
          "form": {
            "type": "PrefixForm",
            "default": "turtle"
          },
          "line": {
            "type": "int",
            "readOnly": true
          }
        }
      },
      "Base": {
        "doc": "The file's last `@base` or `BASE` directive; at most one. Never drawn.",
        "multiplicity": {
          "max": 1
        },
        "attributes": {
          "iri": {
            "type": "uri",
            "required": true,
            "readOnly": true
          }
        }
      },
      "Term": {
        "abstract": true,
        "doc": "A named element: an IRI the file uses in one of OWL's roles.",
        "labelAttribute": "display",
        "attributes": {
          "iri": {
            "type": "uri",
            "readOnly": true,
            "label": "IRI",
            "group": "Identity",
            "doc": {
              "summary": "The term's full IRI.",
              "description": "Rename through the context menu, so every reference follows the name."
            }
          },
          "types": {
            "type": "string",
            "many": true,
            "readOnly": true,
            "label": "Types",
            "group": "Identity",
            "doc": {
              "summary": "The display of every `rdf:type` object, built-ins included, in document order.",
              "description": "Types are stated by triples; add or remove them as statements."
            }
          },
          "display": {
            "type": "string",
            "readOnly": true,
            "doc": "The drawn name: the first `rdfs:label` literal in document order, in any language; else the prefixed name under the file's own prefixes; else the IRI's local name; else the whole IRI."
          },
          "label": {
            "type": "string",
            "label": "Label",
            "group": "Documentation",
            "doc": "The first `rdfs:label` literal. Editing rewrites only its lexical form; language and datatype are kept. With none, the first edit adds a plain `rdfs:label` triple."
          },
          "comment": {
            "type": "text",
            "label": "Comment",
            "group": "Documentation",
            "doc": "The first `rdfs:comment` literal, edited the same way."
          },
          "rows": {
            "type": "LiteralRow",
            "many": true,
            "readOnly": true,
            "doc": "Every literal-valued triple about this IRI, in document order."
          },
          "deprecated": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "The file asserts `owl:deprecated` with the lexical form `true` on this IRI."
          },
          "external": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "A class or individual whose IRI is not built in and is never the subject of a triple in this file: used here, owned elsewhere."
          },
          "doubled": {
            "type": "bool",
            "derived": "self.incomingOf('EquivalentClass').size() + self.outgoingOf('EquivalentClass').size() > 0",
            "doc": "An equivalence axiom touches this element, which doubles its outline."
          },
          "typesText": {
            "type": "string",
            "label": "Types",
            "group": "Identity",
            "derived": "self.types.join(', ')"
          },
          "axioms": {
            "type": "AxiomRow",
            "many": true,
            "readOnly": true,
            "label": "Axioms",
            "group": "Axioms",
            "doc": "Each `rdfs:subClassOf`, `owl:equivalentClass`, `owl:disjointWith`, `rdfs:domain`, `rdfs:range` and `owl:inverseOf` triple about the term in document order, then one row per characteristic type."
          }
        }
      },
      "Class": {
        "extends": "Term",
        "icon": "mdi-shape-circle-plus",
        "doc": {
          "summary": "An IRI typed `owl:Class` or `rdfs:Class`, the subject or IRI object of `rdfs:subClassOf`, an object of `rdfs:domain`, either end of an IRI-to-IRI `owl:equivalentClass` or `owl:disjointWith`, a member of `owl:AllDisjointClasses`, or an IRI a class expression references.",
          "description": "A class node carries literal rows like every term, but its ellipse draws none of them; they are in the property grid."
        },
        "ports": {
          "axiomLeft": {
            "label": "Subclass of",
            "direction": "out",
            "accepts": [
              "SubClassOf"
            ],
            "doc": "Dragging from here to another class states that this one is its subclass."
          },
          "axiomRight": {
            "label": "Subclass of",
            "direction": "out",
            "accepts": [
              "SubClassOf"
            ]
          }
        },
        "derived": {
          "from": "owlTerms().filter(i, owlClass(i) && i != 'http://www.w3.org/2002/07/owl#Thing' && i != 'http://www.w3.org/2002/07/owl#Nothing') + owlFillers().filter(i, !owlHasNode(i) && !owlDatatype(i))",
          "key": "item",
          "id": "'res:' + item",
          "attributes": {
            "iri": "item",
            "types": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && typeTriple(t)).map(t, rdfDisplayName(t.o))",
            "display": "owlDisplay(item)",
            "label": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "comment": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "deprecated": "owlDeprecated(item)",
            "axioms": "owlAxioms(item)",
            "rows": "owlRows(item)",
            "external": "owlExternal(item)"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'iri' && t.s == item) || (t.oKind == 'iri' && t.o == item))",
          "reason": "Ontology elements are read from the triples; add, rename or remove them through the context menu.",
          "edits": {
            "delete": "removeResource",
            "rename": "renameResource",
            "attribute:label": "setLabel",
            "attribute:comment": "setComment"
          },
          "doc": "Every IRI the file uses as a class, in order of first appearance, then every IRI an expression references that has no node of its own."
        }
      },
      "Thing": {
        "extends": "Term",
        "icon": "mdi-circle-outline",
        "doc": "`owl:Thing` wherever the file uses it as a subject or object, and `owl:Nothing` where it is used as a class. Drawn small and dashed.",
        "attributes": {
          "nothing": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "This is `owl:Nothing`."
          }
        },
        "ports": {
          "axiomLeft": {
            "label": "Subclass of",
            "direction": "out",
            "accepts": [
              "SubClassOf"
            ]
          },
          "axiomRight": {
            "label": "Subclass of",
            "direction": "out",
            "accepts": [
              "SubClassOf"
            ]
          }
        },
        "derived": {
          "from": "owlTerms().filter(i, i == 'http://www.w3.org/2002/07/owl#Thing' || (i == 'http://www.w3.org/2002/07/owl#Nothing' && owlClass(i)))",
          "key": "item",
          "id": "'res:' + item",
          "attributes": {
            "iri": "item",
            "types": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && typeTriple(t)).map(t, rdfDisplayName(t.o))",
            "display": "owlDisplay(item)",
            "label": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "comment": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "deprecated": "owlDeprecated(item)",
            "axioms": "owlAxioms(item)",
            "rows": "owlRows(item)",
            "nothing": "item == 'http://www.w3.org/2002/07/owl#Nothing'"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'iri' && t.s == item) || (t.oKind == 'iri' && t.o == item))",
          "reason": "Ontology elements are read from the triples; add, rename or remove them through the context menu.",
          "edits": {
            "delete": "removeResource",
            "rename": "renameResource",
            "attribute:label": "setLabel",
            "attribute:comment": "setComment"
          }
        }
      },
      "Datatype": {
        "extends": "Term",
        "icon": "mdi-form-textbox",
        "doc": "An IRI in the XSD namespace, `rdfs:Literal`, `rdf:langString`, or an IRI typed `rdfs:Datatype`, wherever the file uses it as a subject or object. One node per datatype, shared by every property ranging over it. Never dimmed as external.",
        "derived": {
          "from": "owlTerms().filter(i, owlDatatype(i) && !owlClass(i))",
          "key": "item",
          "id": "'res:' + item",
          "attributes": {
            "iri": "item",
            "types": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && typeTriple(t)).map(t, rdfDisplayName(t.o))",
            "display": "owlDisplay(item)",
            "label": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "comment": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "deprecated": "owlDeprecated(item)",
            "axioms": "owlAxioms(item)",
            "rows": "owlIndividual(item) || item == owlOntologyIri() ? [] : owlRows(item)"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'iri' && t.s == item) || (t.oKind == 'iri' && t.o == item))",
          "reason": "Ontology elements are read from the triples; add, rename or remove them through the context menu.",
          "edits": {
            "delete": "removeResource",
            "rename": "renameResource",
            "attribute:label": "setLabel",
            "attribute:comment": "setComment"
          }
        }
      },
      "Individual": {
        "extends": "Term",
        "icon": "mdi-account-outline",
        "doc": "An IRI typed `owl:NamedIndividual`, or typed by a class this file knows as a class.",
        "attributes": {
          "badges": {
            "type": "string",
            "many": true,
            "readOnly": true,
            "doc": "The display of every `rdf:type` object that is not built in, so `owl:NamedIndividual` is never a badge."
          },
          "punned": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "The same IRI is also a class; this card is its individual role and its literal rows stay on the class."
          }
        },
        "derived": {
          "from": "owlTerms().filter(i, owlIndividual(i) && (owlClass(i) || !owlDatatype(i)))",
          "key": "item",
          "id": "owlIndividualId(item)",
          "attributes": {
            "iri": "item",
            "types": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && typeTriple(t)).map(t, rdfDisplayName(t.o))",
            "display": "owlDisplay(item)",
            "label": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "comment": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "deprecated": "owlDeprecated(item)",
            "axioms": "owlAxioms(item)",
            "rows": "owlClass(item) || item == owlOntologyIri() ? [] : owlRows(item)",
            "external": "owlExternal(item)",
            "badges": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && typeTriple(t) && !owlBuiltIn(t.o)).map(t, owlDisplay(t.o))",
            "punned": "owlClass(item)"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'iri' && t.s == item) || (t.oKind == 'iri' && t.o == item))",
          "reason": "Ontology elements are read from the triples; add, rename or remove them through the context menu.",
          "edits": {
            "delete": "removeResource",
            "rename": "renameResource",
            "attribute:label": "setLabel",
            "attribute:comment": "setComment"
          }
        }
      },
      "OntologyHeader": {
        "extends": "Term",
        "icon": "mdi-file-document-outline",
        "doc": "The subject of the first `rdf:type owl:Ontology` triple, drawn once as a card, unless the IRI is already drawn in another role.",
        "attributes": {
          "imports": {
            "type": "uri",
            "many": true,
            "readOnly": true,
            "group": "Identity",
            "doc": "Objects of `owl:imports`, each also a row on the card. Named, never fetched."
          }
        },
        "derived": {
          "from": "cel.bind(o, owlOntologyIri(), o != '' && !owlClass(o) && o != 'http://www.w3.org/2002/07/owl#Thing' && !owlDatatype(o) && !owlIndividual(o) ? [o] : [])",
          "key": "item",
          "id": "'res:' + item",
          "attributes": {
            "iri": "item",
            "types": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && typeTriple(t)).map(t, rdfDisplayName(t.o))",
            "display": "owlDisplay(item)",
            "label": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "comment": "cel.bind(l, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : '')",
            "deprecated": "owlDeprecated(item)",
            "axioms": "owlAxioms(item)",
            "rows": "owlRows(item) + owlObjects(item, 'http://www.w3.org/2002/07/owl#imports').map(i, {'predicate': 'owl:imports', 'value': i, 'annotation': ''})",
            "imports": "owlObjects(item, 'http://www.w3.org/2002/07/owl#imports')"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, (t.sKind == 'iri' && t.s == item) || (t.oKind == 'iri' && t.o == item))",
          "reason": "Ontology elements are read from the triples; add, rename or remove them through the context menu.",
          "edits": {
            "delete": "removeResource",
            "rename": "renameResource",
            "attribute:label": "setLabel",
            "attribute:comment": "setComment"
          }
        }
      },
      "ThingAnchor": {
        "icon": "mdi-circle-outline",
        "labelAttribute": "display",
        "doc": {
          "summary": "VOWL's owl:Thing anchor for one side of one property that states no usable domain or range.",
          "description": "Each property gets its own anchor per missing side, distinct from a stated `owl:Thing`. Drawn where its property needs it; never positioned, renamed or removed."
        },
        "attributes": {
          "property": {
            "type": "uri",
            "readOnly": true,
            "doc": "The property this anchor serves."
          },
          "side": {
            "type": "AnchorSide",
            "readOnly": true
          },
          "display": {
            "type": "string",
            "default": "Thing",
            "readOnly": true
          }
        },
        "derived": {
          "from": "owlProperties(['http://www.w3.org/2002/07/owl#ObjectProperty', 'http://www.w3.org/2002/07/owl#InverseFunctionalProperty', 'http://www.w3.org/2002/07/owl#TransitiveProperty', 'http://www.w3.org/2002/07/owl#SymmetricProperty', 'http://www.w3.org/2002/07/owl#AsymmetricProperty', 'http://www.w3.org/2002/07/owl#ReflexiveProperty', 'http://www.w3.org/2002/07/owl#IrreflexiveProperty']).map(p, owlDomainIds(p).filter(d, d.startsWith('thing:')) + owlRangeIds(p).filter(r, r.startsWith('thing:'))).flatten() + owlProperties(['http://www.w3.org/2002/07/owl#DatatypeProperty']).map(p, owlDomainIds(p).filter(d, d.startsWith('thing:'))).flatten()",
          "key": "item",
          "id": "item",
          "attributes": {
            "property": "item.substring(6, item.lastIndexOf('|'))",
            "side": "item.endsWith('|domain') ? 'domain' : 'range'"
          },
          "reason": "That element is drawn where its property needs it and cannot be arranged on its own.",
          "doc": "One anchor per side of a property that states no usable domain or range, object properties first."
        }
      },
      "LiteralAnchor": {
        "icon": "mdi-form-textbox",
        "labelAttribute": "display",
        "doc": "The stand-in datatype box for a datatype property with no datatype range. Never positioned, renamed or removed.",
        "attributes": {
          "property": {
            "type": "uri",
            "readOnly": true
          },
          "display": {
            "type": "string",
            "default": "Literal",
            "readOnly": true
          }
        },
        "derived": {
          "from": "owlProperties(['http://www.w3.org/2002/07/owl#DatatypeProperty']).map(p, owlDatatypeRangeIds(p).filter(r, r.startsWith('dt:'))).flatten()",
          "key": "item",
          "id": "item",
          "attributes": {
            "property": "item.substring(3)"
          },
          "reason": "That element is drawn where its property needs it and cannot be arranged on its own."
        }
      },
      "Expression": {
        "abstract": true,
        "labelAttribute": "display",
        "doc": {
          "summary": "An anonymous class expression: a blank node that is the object of `rdfs:subClassOf`, `owl:equivalentClass` or `owl:disjointWith` with a named subject, or a blank filler or member nested inside one.",
          "rationale": "Its identity is structural and deterministic within one parse but deliberately unstable across edits, so it is drawn and selectable, and nothing about it is stored or edited from the diagram."
        },
        "attributes": {
          "axiomOwner": {
            "type": "Term",
            "readOnly": true,
            "doc": "The named element whose axiom roots this expression; nested expressions share their root's owner. Null when the owner is drawn in no role that carries `res:`."
          },
          "axiom": {
            "type": "AxiomKind",
            "readOnly": true
          },
          "display": {
            "type": "string",
            "readOnly": true,
            "doc": "The rendering capped at two levels of nesting; deeper structure reads as `…`."
          },
          "text": {
            "type": "text",
            "readOnly": true,
            "label": "Expression",
            "group": "Identity",
            "doc": {
              "summary": "The full rendering, uncapped.",
              "description": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text."
            }
          },
          "elided": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "The canvas rendering hit the depth cap."
          },
          "malformed": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "A restriction without `owl:onProperty` or without exactly one quantifier, a cyclic structure, or a set-operator list that does not end in `rdf:nil`."
          },
          "doubled": {
            "type": "bool",
            "derived": "self.incomingOf('EquivalentClass').size() > 0",
            "doc": "The expression is the object of an equivalence axiom."
          },
          "line": {
            "type": "int",
            "readOnly": true,
            "doc": "The line of the first triple about the expression's blank node."
          }
        }
      },
      "Restriction": {
        "extends": "Expression",
        "icon": "mdi-filter-outline",
        "doc": "An `owl:Restriction`, or any blank class expression that is not an operator: `∃ p.C`, `∀ p.C`, `∋ p.v`, `= n p`, `≥ n p`, `≤ n p`, the qualified forms with `.C`.",
        "derived": {
          "id": "item[0]",
          "attributes": {
            "axiomOwner": "diagram.elementById(item[1])",
            "axiom": "{'http://www.w3.org/2000/01/rdf-schema#subClassOf': 'subClassOf', 'http://www.w3.org/2002/07/owl#equivalentClass': 'equivalentClass', 'http://www.w3.org/2002/07/owl#disjointWith': 'disjointWith'}[item[2]]",
            "display": "owlText(item[3], 'blank', 1, [], 2)",
            "text": "owlText(item[3], 'blank', 1, [], 1000)",
            "elided": "owlFlag(item[3], 'blank', 1, [], 2, 'elided')",
            "malformed": "owlMalformed(item[3])",
            "line": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == item[3])[0].line"
          },
          "sources": "owlAbout(item[3])",
          "reason": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text.",
          "from": "owlExpressions().filter(e, !owlOperator(e[3]))"
        }
      },
      "Operator": {
        "extends": "Expression",
        "icon": "mdi-set-center",
        "doc": "A blank node carrying `owl:unionOf`, `owl:intersectionOf`, `owl:complementOf` or `owl:oneOf`: `(A ∪ B)`, `(A ∩ B)`, `¬A`, `{a, b}`.",
        "attributes": {
          "operator": {
            "type": "OperatorKind",
            "readOnly": true,
            "doc": "The first operator triple in document order."
          }
        },
        "derived": {
          "id": "item[0]",
          "attributes": {
            "axiomOwner": "diagram.elementById(item[1])",
            "axiom": "{'http://www.w3.org/2000/01/rdf-schema#subClassOf': 'subClassOf', 'http://www.w3.org/2002/07/owl#equivalentClass': 'equivalentClass', 'http://www.w3.org/2002/07/owl#disjointWith': 'disjointWith'}[item[2]]",
            "display": "owlText(item[3], 'blank', 1, [], 2)",
            "text": "owlText(item[3], 'blank', 1, [], 1000)",
            "elided": "owlFlag(item[3], 'blank', 1, [], 2, 'elided')",
            "malformed": "owlMalformed(item[3])",
            "line": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == item[3])[0].line",
            "operator": "cel.bind(op, owlAbout(item[3]).filter(t, t.p in ['http://www.w3.org/2002/07/owl#unionOf', 'http://www.w3.org/2002/07/owl#intersectionOf', 'http://www.w3.org/2002/07/owl#complementOf', 'http://www.w3.org/2002/07/owl#oneOf'])[0].p, {'http://www.w3.org/2002/07/owl#unionOf': 'union', 'http://www.w3.org/2002/07/owl#intersectionOf': 'intersection', 'http://www.w3.org/2002/07/owl#complementOf': 'complement', 'http://www.w3.org/2002/07/owl#oneOf': 'oneOf'}[op])"
          },
          "sources": "owlAbout(item[3])",
          "reason": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text.",
          "from": "owlExpressions().filter(e, owlOperator(e[3]))"
        }
      }
    },
    "relations": {
      "SubClassOf": {
        "label": "Subclass of",
        "doc": {
          "summary": "One edge per `rdfs:subClassOf` triple from a named subject to a named class or to an expression.",
          "description": "The source is the subclass. The only relation a gesture creates; drawing one writes exactly one triple."
        },
        "source": {
          "types": [
            "Class",
            "Thing"
          ],
          "ports": [
            "axiomLeft",
            "axiomRight"
          ],
          "role": "subclass"
        },
        "target": {
          "types": [
            "Class",
            "Thing",
            "Expression"
          ],
          "role": "superclass"
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "derived": {
          "from": "owlEdges(diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.p == 'http://www.w3.org/2000/01/rdf-schema#subClassOf' && t.oKind == 'iri').map(t, ['res:' + t.s, t.p, 'res:' + t.o, t]) + owlExpressions().filter(e, e[2] == 'http://www.w3.org/2000/01/rdf-schema#subClassOf' && e[0].indexOf('/') < 0 && owlHasNode(e[1].substring(4))).map(e, [e[1], e[2], e[0], null]))",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "sources": "item[4] == null ? [] : [item[4]]",
          "reason": "An axiom is a triple of the file; remove it as a statement, or draw a subclass relation between two classes.",
          "edits": {
            "delete": "removeStatement",
            "connect": "subclass"
          }
        },
        "attributes": {
          "direct": {
            "type": "bool",
            "derived": "self.sources.size() > 0 && self.source.id.startsWith('res:') && self.target.id.startsWith('res:')",
            "doc": "One triple between two named terms, which is what Remove statement removes."
          }
        }
      },
      "EquivalentClass": {
        "label": "Equivalent to",
        "doc": "One edge per `owl:equivalentClass` triple from a named class to a named class or an expression. Read from the file; no gesture creates one.",
        "source": {
          "types": [
            "Class",
            "Thing"
          ]
        },
        "target": {
          "types": [
            "Class",
            "Thing",
            "Expression"
          ]
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "derived": {
          "from": "owlEdges(diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.p == 'http://www.w3.org/2002/07/owl#equivalentClass' && t.oKind == 'iri' && owlClass(t.s)).map(t, ['res:' + t.s, t.p, 'res:' + t.o, t]) + owlExpressions().filter(e, e[2] == 'http://www.w3.org/2002/07/owl#equivalentClass' && e[0].indexOf('/') < 0 && owlHasNode(e[1].substring(4))).map(e, [e[1], e[2], e[0], null]))",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "sources": "item[4] == null ? [] : [item[4]]",
          "reason": "An axiom is a triple of the file; remove it as a statement, or draw a subclass relation between two classes.",
          "edits": {
            "delete": "removeStatement"
          }
        },
        "attributes": {
          "direct": {
            "type": "bool",
            "derived": "self.sources.size() > 0 && self.source.id.startsWith('res:') && self.target.id.startsWith('res:')",
            "doc": "One triple between two named terms, which is what Remove statement removes."
          }
        }
      },
      "DisjointWith": {
        "label": "Disjoint with",
        "doc": "One edge per `owl:disjointWith` triple, and one per pair of members of an `owl:AllDisjointClasses` list, in list order.",
        "source": {
          "types": [
            "Class",
            "Thing"
          ]
        },
        "target": {
          "types": [
            "Class",
            "Thing",
            "Expression"
          ]
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "fromGroup": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "doc": "Expanded from an `owl:AllDisjointClasses` group: no single triple backs it, so it cannot be removed as a statement."
          },
          "direct": {
            "type": "bool",
            "derived": "self.sources.size() > 0 && self.source.id.startsWith('res:') && self.target.id.startsWith('res:')",
            "doc": "One triple between two named terms, which is what Remove statement removes."
          }
        },
        "derived": {
          "from": "owlEdges(diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.p == 'http://www.w3.org/2002/07/owl#disjointWith' && t.oKind == 'iri').map(t, ['res:' + t.s, t.p, 'res:' + t.o, t]) + owlExpressions().filter(e, e[2] == 'http://www.w3.org/2002/07/owl#disjointWith' && e[0].indexOf('/') < 0 && owlHasNode(e[1].substring(4))).map(e, [e[1], e[2], e[0], null]) + diagram.nodesOfType('Triple').filter(g, g.sKind == 'blank' && typeTriple(g) && g.o == 'http://www.w3.org/2002/07/owl#AllDisjointClasses').map(g, g.s).distinct().map(g, cel.bind(ms, cel.bind(mt, diagram.nodesOfType('Triple').filter(m, m.sKind == 'blank' && m.s == g && m.p == 'http://www.w3.org/2002/07/owl#members'), mt.size() > 0 && mt[0].oKind == 'blank' ? collectionMembers(mt[0].o).filter(x, x.oKind == 'iri').map(x, x.o) : []), lists.range(ms.size()).map(i, lists.range(ms.size()).filter(j, j > i).map(j, ['res:' + ms[i], 'http://www.w3.org/2002/07/owl#AllDisjointClasses', 'res:' + ms[j], null])).flatten())).flatten())",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "sources": "item[4] == null ? [] : [item[4]]",
          "reason": "An axiom is a triple of the file; remove it as a statement, or draw a subclass relation between two classes.",
          "edits": {
            "delete": "removeStatement"
          },
          "attributes": {
            "fromGroup": "item[2] == 'http://www.w3.org/2002/07/owl#AllDisjointClasses'"
          }
        }
      },
      "PropertyEdge": {
        "abstract": true,
        "allowSelfLoops": true,
        "doc": {
          "summary": "A property drawn as an edge from each stated domain to each stated range.",
          "description": "No triple backs the edge itself; it is the property. Selecting it shows the property's IRI and axioms, all read-only."
        },
        "attributes": {
          "property": {
            "type": "uri",
            "readOnly": true,
            "label": "IRI",
            "group": "Identity",
            "doc": "Rename the property through its declaration as text."
          },
          "name": {
            "type": "string",
            "readOnly": true,
            "doc": "The property's display: first `rdfs:label`, else its prefixed or local name."
          },
          "characteristics": {
            "type": "string",
            "many": true,
            "readOnly": true,
            "label": "Characteristic",
            "group": "Axioms",
            "doc": "One word per characteristic type triple, in document order: functional, inverse functional, transitive, symmetric, asymmetric, reflexive, irreflexive."
          },
          "inverseName": {
            "type": "string",
            "default": "",
            "readOnly": true,
            "label": "Inverse of",
            "group": "Axioms",
            "doc": "The display of the `owl:inverseOf` object when this property is its subject; '' otherwise."
          },
          "domain": {
            "type": "string",
            "many": true,
            "readOnly": true,
            "label": "Domain",
            "group": "Axioms"
          },
          "range": {
            "type": "string",
            "many": true,
            "readOnly": true,
            "label": "Range",
            "group": "Axioms"
          },
          "label": {
            "type": "string",
            "derived": "propertyLabel(self.name, self.characteristics, self.inverseName)"
          },
          "axioms": {
            "type": "AxiomRow",
            "many": true,
            "readOnly": true,
            "label": "Axioms",
            "group": "Axioms"
          },
          "declared": {
            "type": "bool",
            "derived": "owlTyped(self.property, ['http://www.w3.org/2002/07/owl#ObjectProperty', 'http://www.w3.org/2002/07/owl#DatatypeProperty'])",
            "doc": "The property is typed `owl:ObjectProperty` or `owl:DatatypeProperty` itself; only then does selecting the edge show its rows."
          }
        }
      },
      "ObjectProperty": {
        "extends": "PropertyEdge",
        "label": "Object property",
        "doc": "An IRI typed `owl:ObjectProperty` or one of the characteristic classes that only object properties take. Ranges that are datatypes are left out.",
        "source": {
          "types": [
            "Class",
            "Thing",
            "ThingAnchor",
            "Datatype",
            "Individual",
            "OntologyHeader"
          ],
          "role": "domain"
        },
        "target": {
          "types": [
            "Class",
            "Thing",
            "ThingAnchor",
            "Datatype",
            "Individual",
            "OntologyHeader"
          ],
          "role": "range"
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "derived": {
          "from": "owlEdges(owlProperties(['http://www.w3.org/2002/07/owl#ObjectProperty', 'http://www.w3.org/2002/07/owl#InverseFunctionalProperty', 'http://www.w3.org/2002/07/owl#TransitiveProperty', 'http://www.w3.org/2002/07/owl#SymmetricProperty', 'http://www.w3.org/2002/07/owl#AsymmetricProperty', 'http://www.w3.org/2002/07/owl#ReflexiveProperty', 'http://www.w3.org/2002/07/owl#IrreflexiveProperty']).map(p, owlDomainIds(p).map(d, owlRangeIds(p).map(r, [d, p, r, null]))).flatten().flatten())",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "attributes": {
            "property": "item[2]",
            "name": "owlDisplay(item[2])",
            "characteristics": "owlCharacteristics(item[2])",
            "inverseName": "owlInverse(item[2])",
            "domain": "owlObjects(item[2], 'http://www.w3.org/2000/01/rdf-schema#domain').map(c, rdfDisplayName(c))",
            "range": "owlObjects(item[2], 'http://www.w3.org/2000/01/rdf-schema#range').map(c, rdfDisplayName(c))",
            "axioms": "owlAxioms(item[2])"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item[2])",
          "reason": "A property is drawn from its domain and range triples; edit its declaration as text."
        }
      },
      "DatatypeProperty": {
        "extends": "PropertyEdge",
        "label": "Datatype property",
        "doc": "An IRI typed `owl:DatatypeProperty`, to each datatype range, or to its own Literal anchor when none is stated.",
        "source": {
          "types": [
            "Class",
            "Thing",
            "ThingAnchor",
            "Datatype",
            "Individual",
            "OntologyHeader"
          ],
          "role": "domain"
        },
        "target": {
          "types": [
            "Datatype",
            "LiteralAnchor"
          ],
          "role": "range"
        },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true,
        "derived": {
          "from": "owlEdges(owlProperties(['http://www.w3.org/2002/07/owl#DatatypeProperty']).map(p, owlDomainIds(p).map(d, owlDatatypeRangeIds(p).map(r, [d, p, r, null]))).flatten().flatten())",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "attributes": {
            "property": "item[2]",
            "name": "owlDisplay(item[2])",
            "characteristics": "owlCharacteristics(item[2])",
            "inverseName": "owlInverse(item[2])",
            "domain": "owlObjects(item[2], 'http://www.w3.org/2000/01/rdf-schema#domain').map(c, rdfDisplayName(c))",
            "range": "owlObjects(item[2], 'http://www.w3.org/2000/01/rdf-schema#range').map(c, rdfDisplayName(c))",
            "axioms": "owlAxioms(item[2])"
          },
          "sources": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == item[2])",
          "reason": "A property is drawn from its domain and range triples; edit its declaration as text."
        }
      },
      "Assertion": {
        "label": "Assertion",
        "doc": "A triple from an individual, through a predicate that is not built in, to an IRI that is drawn as an individual.",
        "source": {
          "types": [
            "Individual"
          ]
        },
        "target": {
          "types": [
            "Individual"
          ]
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "predicate": {
            "type": "uri",
            "readOnly": true,
            "label": "Predicate",
            "group": "Identity",
            "doc": "A statement's predicate is the statement; remove and restate to change it."
          },
          "name": {
            "type": "string",
            "readOnly": true,
            "doc": "The predicate's display."
          },
          "declared": {
            "type": "bool",
            "readOnly": true,
            "doc": "The predicate is typed `owl:ObjectProperty` or `owl:DatatypeProperty`: selecting the edge shows the property's rows instead of the predicate's."
          },
          "axioms": {
            "type": "AxiomRow",
            "many": true,
            "readOnly": true,
            "label": "Axioms",
            "group": "Axioms"
          },
          "direct": {
            "type": "bool",
            "readOnly": true,
            "doc": "Both ends carry `res:`, which is what Remove statement can name."
          }
        },
        "derived": {
          "from": "owlEdges(diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && owlIndividual(t.s) && t.oKind == 'iri' && !owlBuiltIn(t.p) && (owlIndividual(t.o) || (!owlClass(t.o) && owlHasNode(t.o)))).map(t, [owlIndividualId(t.s), t.p, owlIndividualId(t.o), t]))",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "attributes": {
            "predicate": "item[2]",
            "name": "owlDisplay(item[2])",
            "declared": "owlTyped(item[2], ['http://www.w3.org/2002/07/owl#ObjectProperty', 'http://www.w3.org/2002/07/owl#DatatypeProperty'])",
            "axioms": "owlAxioms(item[2])",
            "direct": "item[1].startsWith('res:') && item[3].startsWith('res:')"
          },
          "sources": "[item[4]]",
          "reason": "A statement is a triple of the file; remove it, or relate two resources to state a new one.",
          "edits": {
            "delete": "removeStatement"
          }
        }
      },
      "References": {
        "label": "Expression reference",
        "doc": "From an expression to what it mentions: a filler of `owl:someValuesFrom`, `owl:allValuesFrom`, `owl:onClass`, `owl:onDataRange` or `owl:hasValue`, the object of `owl:complementOf`, or a member of a set-operator list. `owl:onProperty` is not a reference; the property shows only in the label.",
        "source": {
          "types": [
            "Expression"
          ]
        },
        "target": {
          "types": [
            "Class",
            "Thing",
            "Datatype",
            "Expression"
          ]
        },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true,
        "derived": {
          "from": "owlEdges(owlExpressions().map(e, cel.bind(refs, owlReferences(e[3]), cel.bind(kids, refs.filter(c, c[1] == 'blank'), refs.filter(c, c[1] == 'blank' || (c[1] == 'iri' && (!owlBuiltIn(c[0]) || owlDatatype(c[0]) || c[0] == 'http://www.w3.org/2002/07/owl#Thing' || c[0] == 'http://www.w3.org/2002/07/owl#Nothing'))).map(c, [e[0], '', c[1] == 'iri' ? 'res:' + c[0] : e[0] + '/' + string(kids.indexOf(c)), null])))).flatten())",
          "id": "'edge:' + item[0] + (item[5] > 0 ? '|' + string(item[5]) : '')",
          "source": "diagram.elementById(item[1])",
          "target": "diagram.elementById(item[3])",
          "reason": "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text.",
          "doc": "From an expression to each thing it mentions, named fillers and nested expressions alike, in the order the expression mentions them."
        }
      }
    }
  },
  "notation": {
    "doc": "VOWL's structural vocabulary - ellipse classes, box datatypes, a dashed small owl:Thing, a doubled outline for equivalence, labelled property edges, dimmed deprecated and external terms - without its fixed palette: kind is carried by shape and line style, colours come from the host's theme. The tokens copy standalone's theme variables (`src/client/src/index.css`), light and dark.",
    "theme": {
      "tokens": {
        "color.surface": "#ffffff",
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.border": "#e2e8f0",
        "color.node.outline": "#8892a6",
        "color.primary": "limegreen",
        "color.warning": "#b45309",
        "font.body": "system-ui, sans-serif",
        "font.mono": "ui-monospace, monospace"
      },
      "modes": {
        "dark": {
          "color.surface": "#1e293b",
          "color.text": "#f1f5f9",
          "color.text.muted": "#94a3b8",
          "color.border": "#334155",
          "color.warning": "#fbbf24"
        }
      },
      "followSystem": true
    },
    "styles": {
      "node": {
        "fill": {
          "token": "color.surface"
        },
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1
        },
        "font": {
          "size": 12,
          "color": {
            "token": "color.text"
          }
        }
      },
      "expression": {
        "extends": "node",
        "stroke": {
          "dash": [
            3,
            2
          ],
          "dashScale": "absolute"
        },
        "font": {
          "size": 11
        }
      },
      "badges": {
        "font": {
          "size": 11,
          "color": {
            "token": "color.primary"
          }
        }
      },
      "row": {
        "font": {
          "size": 11,
          "color": {
            "token": "color.text.muted"
          }
        }
      },
      "edge": {
        "stroke": {
          "color": {
            "token": "color.text.muted"
          },
          "width": 1.5
        }
      },
      "dimmed": {
        "opacity": 0.55
      },
      "doubled": {
        "stroke": {
          "double": {
            "gap": 4
          }
        }
      }
    },
    "nodes": {
      "Class": {
        "shape": "ellipse",
        "style": "node",
        "size": {
          "fixed": [
            190,
            70
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "self.display"
            },
            "position": "center",
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          }
        ],
        "ports": {
          "axiomLeft": {
            "shape": "none",
            "side": "left",
            "position": 0.5
          },
          "axiomRight": {
            "shape": "none",
            "side": "right",
            "position": 0.5
          }
        },
        "conditions": [
          {
            "when": "self.doubled",
            "style": "doubled",
            "doc": "Equivalence: a second ring 4 inside the first."
          },
          {
            "when": "self.deprecated || self.external",
            "style": "dimmed",
            "doc": "Deprecated and borrowed terms are dimmed alike."
          }
        ],
        "tooltip": {
          "cel": "self.display"
        },
        "doubleClick": "openForm"
      },
      "Thing": {
        "shape": "ellipse",
        "style": "node",
        "size": {
          "fixed": [
            104.5,
            38.5
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "self.display"
            },
            "position": "center",
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          }
        ],
        "ports": {
          "axiomLeft": {
            "shape": "none",
            "side": "left",
            "position": 0.5
          },
          "axiomRight": {
            "shape": "none",
            "side": "right",
            "position": 0.5
          }
        },
        "conditions": [
          {
            "when": "true",
            "style": {
              "stroke": {
                "dash": [
                  4,
                  3
                ],
                "dashScale": "absolute"
              }
            },
            "doc": "owl:Thing is drawn dashed and at 0.55 of a class's size."
          },
          {
            "when": "self.doubled",
            "style": "doubled"
          },
          {
            "when": "self.deprecated",
            "style": "dimmed"
          }
        ],
        "tooltip": {
          "cel": "self.display"
        }
      },
      "ThingAnchor": {
        "shape": "ellipse",
        "style": {
          "extends": "node",
          "stroke": {
            "dash": [
              4,
              3
            ],
            "dashScale": "absolute"
          }
        },
        "size": {
          "fixed": [
            104.5,
            38.5
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": "Thing",
            "position": "center",
            "editable": false
          }
        ],
        "tooltip": "Thing",
        "deletable": false,
        "copyable": false
      },
      "Datatype": {
        "shape": "rect",
        "style": "node",
        "size": {
          "fixed": [
            190,
            70
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "self.display"
            },
            "position": "center",
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          }
        ],
        "conditions": [
          {
            "when": "self.deprecated",
            "style": "dimmed"
          }
        ],
        "tooltip": {
          "cel": "self.display"
        },
        "doubleClick": "openForm"
      },
      "LiteralAnchor": {
        "shape": "rect",
        "style": "node",
        "size": {
          "fixed": [
            190,
            70
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": "Literal",
            "position": "center",
            "editable": false
          }
        ],
        "tooltip": "Literal",
        "deletable": false,
        "copyable": false
      },
      "Individual": {
        "shape": "rect",
        "style": "node",
        "size": {
          "width": 220,
          "height": {
            "cel": "30 + (size(self.badges) > 0 ? 16 : 0) + 16 * size(self.rows) + 10"
          },
          "resizable": false
        },
        "labels": [
          {
            "id": "title",
            "text": {
              "cel": "self.display"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          },
          {
            "id": "badges",
            "text": {
              "cel": "self.badges.join(' · ')"
            },
            "position": {
              "anchor": [
                0,
                0
              ],
              "offset": [
                8,
                40
              ],
              "align": "start"
            },
            "style": "badges",
            "overflow": "ellipsis",
            "maxLines": 1,
            "visible": {
              "cel": "size(self.badges) > 0"
            }
          }
        ],
        "compartments": [
          {
            "id": "rows",
            "items": {
              "attribute": "rows"
            },
            "itemText": {
              "cel": "item.predicate + ': ' + item.value + ' ' + item.annotation"
            },
            "itemStyle": "row",
            "layout": "vertical",
            "separator": "none",
            "overflow": "ellipsis",
            "editable": {
              "add": false,
              "remove": false,
              "reorder": false,
              "inline": false
            }
          }
        ],
        "conditions": [
          {
            "when": "self.deprecated || self.external",
            "style": "dimmed"
          }
        ],
        "tooltip": {
          "cel": "self.display"
        },
        "doubleClick": "openForm"
      },
      "OntologyHeader": {
        "shape": "rect",
        "style": "node",
        "size": {
          "width": 220,
          "height": {
            "cel": "30 + 16 * size(self.rows) + 10"
          },
          "resizable": false
        },
        "labels": [
          {
            "id": "title",
            "text": {
              "cel": "self.display"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                20
              ]
            },
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          }
        ],
        "compartments": [
          {
            "id": "rows",
            "items": {
              "attribute": "rows"
            },
            "itemText": {
              "cel": "item.predicate + ': ' + item.value + ' ' + item.annotation"
            },
            "itemStyle": "row",
            "layout": "vertical",
            "separator": "none",
            "overflow": "ellipsis",
            "editable": {
              "add": false,
              "remove": false,
              "reorder": false,
              "inline": false
            }
          }
        ],
        "conditions": [
          {
            "when": "self.deprecated",
            "style": "dimmed"
          }
        ],
        "tooltip": {
          "cel": "self.display"
        },
        "doubleClick": "openForm"
      },
      "Restriction": {
        "shape": "ellipse",
        "style": "expression",
        "size": {
          "fixed": [
            190,
            70
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "roundLabel(self.display, self.elided)"
            },
            "position": "center",
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          }
        ],
        "conditions": [
          {
            "when": "self.doubled",
            "style": "doubled"
          },
          {
            "when": "self.malformed",
            "style": {
              "stroke": {
                "color": {
                  "token": "color.warning"
                }
              }
            },
            "doc": "A broken structure is marked, not hidden."
          }
        ],
        "tooltip": {
          "cel": "self.display"
        },
        "deletable": false,
        "copyable": false
      },
      "Operator": {
        "shape": "ellipse",
        "style": "expression",
        "size": {
          "fixed": [
            190,
            70
          ]
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "roundLabel(self.display, self.elided)"
            },
            "position": "center",
            "overflow": "ellipsis",
            "maxLines": 1,
            "editable": false
          }
        ],
        "conditions": [
          {
            "when": "self.doubled",
            "style": "doubled"
          },
          {
            "when": "self.malformed",
            "style": {
              "stroke": {
                "color": {
                  "token": "color.warning"
                }
              }
            }
          }
        ],
        "tooltip": {
          "cel": "self.display"
        },
        "deletable": false,
        "copyable": false
      }
    },
    "edges": {
      "SubClassOf": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5,
            "dash": [
              6,
              4
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "reconnectable": false,
        "doc": "Dashed, with an arrow at the superclass."
      },
      "EquivalentClass": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 2
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "doc": "Solid and heavier, no marker; both ends also wear the doubled outline."
      },
      "DisjointWith": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5,
            "dash": [
              1,
              5
            ],
            "dashScale": "absolute",
            "cap": "round"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "deletable": {
          "cel": "!self.fromGroup"
        },
        "doc": "Dotted with round caps, no marker."
      },
      "ObjectProperty": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "self.label"
            },
            "at": "middle",
            "side": "above",
            "distance": 6,
            "editable": false
          }
        ],
        "reconnectable": false,
        "deletable": false
      },
      "DatatypeProperty": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "self.label"
            },
            "at": "middle",
            "side": "above",
            "distance": 6,
            "editable": false
          }
        ],
        "reconnectable": false,
        "deletable": false
      },
      "Assertion": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrow",
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "self.name"
            },
            "at": "middle",
            "side": "above",
            "distance": 6,
            "editable": false
          }
        ],
        "reconnectable": false
      },
      "References": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5,
            "opacity": 0.7,
            "dash": [
              2,
              3
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "none",
        "reconnectable": false,
        "deletable": false
      }
    }
  },
  "forms": {
    "termInspector": {
      "for": [
        "Class",
        "Thing",
        "Datatype",
        "Individual",
        "OntologyHeader"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "iri",
              "id": "iri",
              "widget": "readonly",
              "readOnlyReasons": [
                "Rename through the context menu, so every reference follows the name."
              ]
            },
            {
              "attribute": "typesText",
              "id": "types",
              "widget": "readonly",
              "readOnlyReasons": [
                "Types are stated by triples; add or remove them as statements."
              ]
            }
          ]
        },
        {
          "kind": "section",
          "label": "Documentation",
          "items": [
            {
              "attribute": "label",
              "id": "label",
              "widget": "text",
              "readOnlyReasons": [
                {
                  "reason": "truncated"
                }
              ]
            },
            {
              "attribute": "comment",
              "id": "comment",
              "widget": "text",
              "readOnlyReasons": [
                {
                  "reason": "truncated"
                }
              ]
            }
          ]
        },
        {
          "kind": "section",
          "label": "Axioms",
          "items": [
            {
              "attribute": "axioms",
              "id": "axioms",
              "widget": "readonly",
              "visible": "size(self.axioms) > 0",
              "readOnlyReasons": [
                "Axioms are stated by triples; draw or remove them as edges and statements."
              ],
              "doc": "One row per axiom, each with its own wire id (`x-owl`); a row rendering an expression reads the expression's identity sentence (`w3c-owl.md`)."
            }
          ]
        }
      ]
    },
    "expressionInspector": {
      "for": [
        "Expression"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "text",
              "id": "expression",
              "widget": "readonly",
              "readOnlyReasons": [
                "That is an anonymous class expression, whose identity does not survive an edit to the file, so nothing about it can be edited from the diagram. Edit the expression as text."
              ]
            }
          ]
        }
      ]
    },
    "propertyInspector": {
      "for": [
        "ObjectProperty",
        "DatatypeProperty"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "visible": "self.declared",
          "items": [
            {
              "attribute": "property",
              "id": "iri",
              "widget": "readonly",
              "readOnlyReasons": [
                "Rename through the context menu, so every reference follows the name."
              ]
            }
          ]
        },
        {
          "kind": "section",
          "label": "Axioms",
          "visible": "self.declared && size(self.axioms) > 0",
          "items": [
            {
              "attribute": "axioms",
              "id": "axioms",
              "widget": "readonly",
              "readOnlyReasons": [
                "Axioms are stated by triples; draw or remove them as edges and statements."
              ]
            }
          ]
        }
      ]
    },
    "assertionInspector": {
      "for": [
        "Assertion"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "predicate",
              "id": "iri",
              "widget": "readonly",
              "visible": "self.declared",
              "readOnlyReasons": [
                "Rename through the context menu, so every reference follows the name."
              ]
            },
            {
              "attribute": "predicate",
              "id": "predicateIri",
              "widget": "readonly",
              "visible": "!self.declared && self.direct",
              "display": {
                "cel": "rdfDisplayName(self.predicate)"
              },
              "readOnlyReasons": [
                "A statement's predicate is the statement; remove and restate to change it."
              ]
            }
          ]
        },
        {
          "kind": "section",
          "label": "Axioms",
          "visible": "self.declared && size(self.axioms) > 0",
          "items": [
            {
              "attribute": "axioms",
              "id": "axioms",
              "widget": "readonly",
              "readOnlyReasons": [
                "Axioms are stated by triples; draw or remove them as edges and statements."
              ]
            }
          ]
        }
      ]
    },
    "axiomInspector": {
      "for": [
        "SubClassOf",
        "EquivalentClass",
        "DisjointWith"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "visible": "self.direct",
          "items": [
            {
              "kind": "computed",
              "id": "predicateIri",
              "label": "Predicate",
              "value": "rdfDisplayName(self.sources[0].p)",
              "readOnlyReasons": [
                "A statement's predicate is the statement; remove and restate to change it."
              ]
            }
          ]
        }
      ]
    },
    "addResourceDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Add resource",
      "icon": "mdi-card-plus-outline",
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "iri",
          "label": "IRI or prefixed name",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "declarePrefixDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Declare prefix",
      "icon": "mdi-at",
      "submitLabel": "Declare",
      "items": [
        {
          "attribute": "declaration",
          "label": "Declaration, e.g. ex: http://example.org/",
          "validate": [
            {
              "rule": "value.matches('^\\\\s*[^:\\\\s]+\\\\s*:\\\\s*<?[A-Za-z][A-Za-z0-9+.-]*:[^\\\\s<>]*>?\\\\s*$')",
              "message": "Write the declaration as 'prefix: iri', e.g. ex: http://example.org/."
            }
          ]
        }
      ]
    },
    "relateDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Relate",
      "icon": "mdi-ray-start-arrow",
      "submitLabel": "Relate",
      "items": [
        {
          "attribute": "predicate",
          "label": "Predicate (IRI or prefixed name)",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "renameDialog": {
      "for": [
        "Term"
      ],
      "usage": [
        "popover"
      ],
      "label": "Rename resource",
      "icon": "mdi-pencil-outline",
      "submitLabel": "Rename",
      "items": [
        {
          "attribute": "newName",
          "label": "New IRI or prefixed name",
          "initial": "rdfCompress(self.iri)",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            },
            {
              "rule": "!diagram.nodesOfType('Triple').exists(t, (t.sKind == 'iri' && t.s == rdfResolveTerm(value)) || (t.oKind == 'iri' && t.o == rdfResolveTerm(value)))",
              "message": {
                "cel": "rdfResolveTerm(value) + ' already names something in this document; renaming onto it would silently merge two resources.'"
              }
            }
          ]
        }
      ]
    },
    "addClassDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Add class",
      "icon": "mdi-shape-circle-plus",
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "iri",
          "label": "IRI or prefixed name",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "addObjectPropertyDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Add object property",
      "icon": "mdi-shape-circle-plus",
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "iri",
          "label": "IRI or prefixed name",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "addDatatypePropertyDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Add datatype property",
      "icon": "mdi-shape-circle-plus",
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "iri",
          "label": "IRI or prefixed name",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    },
    "addIndividualDialog": {
      "for": "diagram",
      "usage": [
        "popover"
      ],
      "label": "Add individual",
      "icon": "mdi-shape-circle-plus",
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "iri",
          "label": "IRI or prefixed name",
          "validate": [
            {
              "rule": "rdfResolveTerm(value) != ''",
              "message": {
                "cel": "rdfTermRefusal(value)"
              }
            }
          ]
        }
      ]
    }
  },
  "toolbox": {
    "generic": {
      "select": true,
      "pan": true
    },
    "groups": [
      {
        "id": "ontology",
        "label": "OWL",
        "tools": [
          {
            "id": "class",
            "kind": "operation",
            "operation": "addClass",
            "label": "Class",
            "icon": "mdi-shape-circle-plus",
            "doc": "A named class. Drop it where it should sit; you will be asked for its name.",
            "mode": "drop"
          },
          {
            "id": "objectProperty",
            "kind": "operation",
            "operation": "addObjectProperty",
            "label": "Object property",
            "icon": "mdi-ray-start-arrow",
            "doc": "A property relating individuals to individuals - drawn as an edge once it has a domain and a range.",
            "mode": "drop"
          },
          {
            "id": "datatypeProperty",
            "kind": "operation",
            "operation": "addDatatypeProperty",
            "label": "Datatype property",
            "icon": "mdi-form-textbox",
            "doc": "A property relating individuals to data values - drawn as an edge to its datatype.",
            "mode": "drop"
          },
          {
            "id": "individual",
            "kind": "operation",
            "operation": "addIndividual",
            "label": "Individual",
            "icon": "mdi-account-outline",
            "doc": "A named individual - a member of the classes this ontology describes.",
            "mode": "drop"
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "Class",
          "Thing",
          "Datatype",
          "Individual",
          "OntologyHeader"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "renameResource",
            "label": "Rename…",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "removeResource",
            "icon": "mdi-delete-outline",
            "shortcut": "Delete"
          }
        ],
        "doc": "Every named term, the individual role of a punned IRI included; an expression, an anchor and a property edge have no menu."
      },
      {
        "for": [
          "SubClassOf",
          "EquivalentClass",
          "DisjointWith",
          "Assertion"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "removeStatement",
            "label": "Remove statement",
            "icon": "mdi-vector-polyline-remove",
            "shortcut": "Delete"
          }
        ],
        "when": "self.direct"
      },
      {
        "for": [
          "diagram"
        ],
        "placement": "menu",
        "standardEntries": false,
        "doc": "A placement: the empty canvas at a point.",
        "tools": [
          {
            "kind": "operation",
            "operation": "addResource",
            "label": "Add resource here…",
            "icon": "mdi-card-plus-outline"
          },
          {
            "kind": "operation",
            "operation": "declarePrefix",
            "label": "Declare prefix…",
            "icon": "mdi-at"
          },
          {
            "kind": "operation",
            "operation": "addClass",
            "label": "Add class here…",
            "icon": "mdi-shape-circle-plus",
            "visible": "diagram.nodesOfType('Triple').exists(t, typeTriple(t) && t.o == 'http://www.w3.org/2002/07/owl#Ontology')"
          },
          {
            "kind": "operation",
            "operation": "addObjectProperty",
            "label": "Add object property…",
            "icon": "mdi-ray-start-arrow",
            "visible": "diagram.nodesOfType('Triple').exists(t, typeTriple(t) && t.o == 'http://www.w3.org/2002/07/owl#Ontology')"
          },
          {
            "kind": "operation",
            "operation": "addDatatypeProperty",
            "label": "Add datatype property…",
            "icon": "mdi-form-textbox",
            "visible": "diagram.nodesOfType('Triple').exists(t, typeTriple(t) && t.o == 'http://www.w3.org/2002/07/owl#Ontology')"
          },
          {
            "kind": "operation",
            "operation": "addIndividual",
            "label": "Add individual…",
            "icon": "mdi-account-outline",
            "visible": "diagram.nodesOfType('Triple').exists(t, typeTriple(t) && t.o == 'http://www.w3.org/2002/07/owl#Ontology')"
          }
        ]
      },
      {
        "for": [
          "connection"
        ],
        "placement": "menu",
        "standardEntries": false,
        "doc": "A finished connect gesture between two elements.",
        "tools": [
          {
            "kind": "operation",
            "operation": "subclass",
            "label": "Subclass of",
            "icon": "mdi-file-tree",
            "visible": "source.id.startsWith('res:') && target.id.startsWith('res:') && (diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == source.iri && ((typeTriple(t) && t.o in ['http://www.w3.org/2002/07/owl#Class', 'http://www.w3.org/2000/01/rdf-schema#Class']) || t.p == 'http://www.w3.org/2000/01/rdf-schema#subClassOf')) || diagram.nodesOfType('Triple').exists(t, t.oKind == 'iri' && t.o == source.iri && t.p in ['http://www.w3.org/2000/01/rdf-schema#subClassOf', 'http://www.w3.org/2000/01/rdf-schema#domain', 'http://www.w3.org/2000/01/rdf-schema#range'])) && (diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == target.iri && ((typeTriple(t) && t.o in ['http://www.w3.org/2002/07/owl#Class', 'http://www.w3.org/2000/01/rdf-schema#Class']) || t.p == 'http://www.w3.org/2000/01/rdf-schema#subClassOf')) || diagram.nodesOfType('Triple').exists(t, t.oKind == 'iri' && t.o == target.iri && t.p in ['http://www.w3.org/2000/01/rdf-schema#subClassOf', 'http://www.w3.org/2000/01/rdf-schema#domain', 'http://www.w3.org/2000/01/rdf-schema#range']))",
            "args": {
              "from": "source",
              "to": "target"
            }
          },
          {
            "kind": "operation",
            "operation": "relate",
            "label": "Relate…",
            "icon": "mdi-ray-start-arrow",
            "args": {
              "from": "source",
              "to": "target"
            }
          }
        ]
      }
    ]
  },
  "constraints": {
    "doc": "Facts about the asserted ontology, never a reasoner's opinion: nothing is fetched and nothing is inferred. The five `rdf.*` findings are the plugin's, raised as it reads the body and shared by every reading (FBL 9.1); a parse failure replaces every other finding.",
    "builtIn": {
      "std.unparseable": {
        "code": "rdf.unparseable",
        "message": {
          "cel": "'This is not RDF that can be read: ' + detail.reason"
        }
      }
    },
    "rules": [
      {
        "id": "subclassCycle",
        "code": "owl.subclass-cycle",
        "label": "Subclass cycle",
        "scope": "diagram",
        "forEach": "diagram.cycles('SubClassOf', 1000)",
        "severity": "warning",
        "cost": "expensive",
        "message": {
          "cel": "'These classes assert each other as subclasses in a cycle: ' + item.map(c, rdfDisplayName(c.iri)).join(', ') + '. That is legal OWL - it makes them mutually equivalent - and it is almost always a mistake.'"
        },
        "location": "{'line': diagram.nodesOfType('Triple').filter(t, t.p == 'http://www.w3.org/2000/01/rdf-schema#subClassOf' && t.sKind == 'iri' && item.exists(c, c.iri == t.s))[0].line}",
        "doc": "One finding per cycle, at the first `rdfs:subClassOf` triple whose subject is in it. A cycle is legal OWL and almost always an authoring mistake, which is what a warning is for."
      },
      {
        "id": "malformedExpression",
        "code": "owl.malformed-expression",
        "label": "Malformed class expression",
        "scope": "Expression",
        "rule": "!self.malformed",
        "severity": "error",
        "message": {
          "cel": "\"This class expression is not well-formed: it renders as '\" + self.display + \"', with ? standing for what the structure is missing.\""
        },
        "location": "{'line': self.line}"
      },
      {
        "id": "undeclaredProperty",
        "code": "owl.undeclared-property",
        "label": "Undeclared property",
        "scope": "diagram",
        "forEach": "diagram.nodesOfType('Triple').filter(t, owlUndeclared(t) != '').filter(t, t.positionIn(diagram.nodesOfType('Triple').filter(t, owlUndeclared(t) != '').filter(u, owlUndeclared(u) == owlUndeclared(t))) == 0)",
        "severity": "info",
        "message": {
          "cel": "rdfDisplayName(owlUndeclared(item)) + ' is used as a property but declared nowhere in this file - it may live in an import, which is deliberately not fetched.'"
        },
        "location": "{'line': item.line}"
      },
      {
        "id": "deprecatedReference",
        "code": "owl.deprecated-reference",
        "label": "Deprecated but referenced",
        "scope": "diagram",
        "forEach": "diagram.nodesOfType('Triple').filter(t, owlDeprecatedTarget(t) != '').filter(t, t.positionIn(diagram.nodesOfType('Triple').filter(t, owlDeprecatedTarget(t) != '').filter(u, owlDeprecatedTarget(u) == owlDeprecatedTarget(t))) == 0)",
        "severity": "info",
        "message": {
          "cel": "rdfDisplayName(item.o) + ' is deprecated, and something not deprecated still references it.'"
        },
        "location": "{'line': item.line}"
      },
      {
        "id": "importsNotFetched",
        "code": "owl.imports-not-fetched",
        "label": "Imports not fetched",
        "scope": "diagram",
        "forEach": "diagram.nodesOfType('Triple').filter(t, t.p == 'http://www.w3.org/2002/07/owl#imports' && t.oKind == 'iri')",
        "severity": "info",
        "message": {
          "cel": "'This ontology imports ' + item.o + ', which is not fetched: the diagram shows what this file asserts, not the import closure a reasoner would load.'"
        },
        "location": "{'line': item.line}",
        "doc": "The no-network rule made visible: the drawn ontology is this file alone."
      }
    ]
  },
  "behavior": {
    "reasons": {
      "truncated": {
        "when": "familyTruncated()",
        "message": "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead.",
        "doc": "The truncation gate: one sentence, shown on every withheld gesture, menu entry and property row. Today every reading gates its edits on the RDF graph reading's count of cards, not on its own drawn count, so this reason reads that count."
      }
    },
    "editGate": [
      {
        "reason": "truncated"
      }
    ],
    "messages": {
      "std.notApplicable": {
        "cel": "'\\'' + operationId + '\\' does not apply to this selection.'"
      }
    },
    "operations": {
      "addResource": {
        "label": "Add resource here…",
        "icon": "mdi-card-plus-outline",
        "for": "diagram",
        "params": {
          "iri": {
            "type": "string",
            "label": "IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "addResourceDialog",
        "doc": "Writes one triple, `{iri} a rdfs:Resource`; the card follows from it.",
        "actions": [
          {
            "if": "rdfResolveTerm(p.iri) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.iri)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "rdfResolveTerm(p.iri)",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/1999/02/22-rdf-syntax-ns#type'",
                "o": "'http://www.w3.org/2000/01/rdf-schema#Resource'",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "declarePrefix": {
        "label": "Declare prefix…",
        "icon": "mdi-at",
        "for": "diagram",
        "params": {
          "declaration": {
            "type": "string",
            "label": "Declaration, e.g. ex: http://example.org/",
            "required": true
          }
        },
        "paramsForm": "declarePrefixDialog",
        "doc": "Writes one `@prefix` directive from `prefix: iri`, brackets tolerated. A plugin action: the directive is written where the tool writes it, after the last declaration, which no change of one stored element says (`w3c-rdf.md`, gap 2).",
        "plugin": {
          "name": "net.etalii.adp.w3c.turtle",
          "args": {
            "action": "addPrefix"
          }
        }
      },
      "renameResource": {
        "label": "Rename…",
        "for": "Term",
        "params": {
          "newName": {
            "type": "string",
            "label": "New IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "renameDialog",
        "doc": "Rewrites every token that names the IRI, in subject, predicate, object and datatype position, bracketed or prefixed under the prefixes in force where it stands. A plugin action, since no change of one stored element says it (`w3c-rdf.md`, gap 2).",
        "plugin": {
          "name": "net.etalii.adp.w3c.turtle",
          "args": {
            "action": "renameTerm"
          }
        }
      },
      "removeResource": {
        "for": "Term",
        "label": {
          "cel": "self.sources.size() == 1 ? 'Remove' : 'Remove (with ' + string(self.sources.size()) + ' statements)'"
        },
        "confirm": {
          "count": "self.sources.size()",
          "threshold": 2,
          "title": "Remove resource",
          "message": {
            "cel": "'Removing this resource also removes the ' + string(count) + ' statements it appears in.'"
          },
          "confirmLabel": "Remove",
          "danger": true
        },
        "doc": "Removes every triple whose subject or object is the IRI; the element disappears on recomputation. A resource in one statement goes without a question.",
        "actions": [
          {
            "delete": "self.sources"
          }
        ]
      },
      "removeStatement": {
        "label": "Remove statement",
        "for": [
          "SubClassOf",
          "EquivalentClass",
          "DisjointWith",
          "Assertion"
        ],
        "actions": [
          {
            "delete": "self.sources"
          }
        ]
      },
      "relate": {
        "label": "Relate…",
        "icon": "mdi-ray-start-arrow",
        "for": "diagram",
        "params": {
          "from": {
            "type": "Term",
            "required": true
          },
          "to": {
            "type": "Term",
            "required": true
          },
          "predicate": {
            "type": "string",
            "label": "Predicate (IRI or prefixed name)",
            "required": true
          }
        },
        "paramsForm": "relateDialog",
        "actions": [
          {
            "if": "rdfResolveTerm(p.predicate) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.predicate)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "p.from.iri",
                "sKind": "'iri'",
                "p": "rdfResolveTerm(p.predicate)",
                "o": "p.to.iri",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "setLabel": {
        "label": "Label",
        "for": "Term",
        "params": {
          "value": {
            "type": "string",
            "required": true
          }
        },
        "doc": "Rewrites the lexical form of the first `rdfs:label` literal, keeping its language and datatype, or adds a plain one when there is none.",
        "actions": [
          {
            "if": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal').size() > 0",
            "then": [
              {
                "target": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal')[0]",
                "set": {
                  "o": "p.value"
                }
              }
            ],
            "else": [
              {
                "create": {
                  "type": "'Triple'",
                  "attributes": {
                    "s": "self.iri",
                    "sKind": "'iri'",
                    "p": "'http://www.w3.org/2000/01/rdf-schema#label'",
                    "o": "p.value",
                    "oKind": "'literal'"
                  }
                }
              }
            ]
          }
        ]
      },
      "setComment": {
        "label": "Comment",
        "for": "Term",
        "params": {
          "value": {
            "type": "string",
            "required": true
          }
        },
        "doc": "Rewrites the lexical form of the first `rdfs:comment` literal, keeping its language and datatype, or adds a plain one when there is none.",
        "actions": [
          {
            "if": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal').size() > 0",
            "then": [
              {
                "target": "diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal')[0]",
                "set": {
                  "o": "p.value"
                }
              }
            ],
            "else": [
              {
                "create": {
                  "type": "'Triple'",
                  "attributes": {
                    "s": "self.iri",
                    "sKind": "'iri'",
                    "p": "'http://www.w3.org/2000/01/rdf-schema#comment'",
                    "o": "p.value",
                    "oKind": "'literal'"
                  }
                }
              }
            ]
          }
        ]
      },
      "addClass": {
        "label": "Add class here…",
        "icon": "mdi-shape-circle-plus",
        "for": "diagram",
        "params": {
          "iri": {
            "type": "string",
            "label": "IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "addClassDialog",
        "doc": "Writes exactly one triple, `{iri} a owl:Class`.",
        "actions": [
          {
            "if": "rdfResolveTerm(p.iri) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.iri)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "rdfResolveTerm(p.iri)",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/1999/02/22-rdf-syntax-ns#type'",
                "o": "'http://www.w3.org/2002/07/owl#Class'",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "addObjectProperty": {
        "label": "Add object property…",
        "icon": "mdi-ray-start-arrow",
        "for": "diagram",
        "params": {
          "iri": {
            "type": "string",
            "label": "IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "addObjectPropertyDialog",
        "doc": "Writes exactly one triple, `{iri} a owl:ObjectProperty`.",
        "actions": [
          {
            "if": "rdfResolveTerm(p.iri) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.iri)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "rdfResolveTerm(p.iri)",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/1999/02/22-rdf-syntax-ns#type'",
                "o": "'http://www.w3.org/2002/07/owl#ObjectProperty'",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "addDatatypeProperty": {
        "label": "Add datatype property…",
        "icon": "mdi-form-textbox",
        "for": "diagram",
        "params": {
          "iri": {
            "type": "string",
            "label": "IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "addDatatypePropertyDialog",
        "doc": "Writes exactly one triple, `{iri} a owl:DatatypeProperty`.",
        "actions": [
          {
            "if": "rdfResolveTerm(p.iri) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.iri)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "rdfResolveTerm(p.iri)",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/1999/02/22-rdf-syntax-ns#type'",
                "o": "'http://www.w3.org/2002/07/owl#DatatypeProperty'",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "addIndividual": {
        "label": "Add individual…",
        "icon": "mdi-account-outline",
        "for": "diagram",
        "params": {
          "iri": {
            "type": "string",
            "label": "IRI or prefixed name",
            "required": true
          }
        },
        "paramsForm": "addIndividualDialog",
        "doc": "Writes exactly one triple, `{iri} a owl:NamedIndividual`.",
        "actions": [
          {
            "if": "rdfResolveTerm(p.iri) == ''",
            "then": [
              {
                "abort": {
                  "message": "rdfTermRefusal(p.iri)"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "rdfResolveTerm(p.iri)",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/1999/02/22-rdf-syntax-ns#type'",
                "o": "'http://www.w3.org/2002/07/owl#NamedIndividual'",
                "oKind": "'iri'"
              }
            }
          }
        ]
      },
      "subclass": {
        "label": "Subclass of",
        "icon": "mdi-file-tree",
        "for": "diagram",
        "params": {
          "from": {
            "type": "Term",
            "required": true
          },
          "to": {
            "type": "Term",
            "required": true
          }
        },
        "doc": "Writes one `rdfs:subClassOf` triple from the gesture's source to its target, without a dialog.",
        "actions": [
          {
            "if": "diagram.nodesOfType('Triple').exists(t, t.sKind == 'iri' && t.s == p.from.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#subClassOf' && t.oKind == 'iri' && t.o == p.to.iri)",
            "then": [
              {
                "abort": {
                  "message": "'That subclass relation is already asserted; drawing it again would state nothing new.'"
                }
              }
            ]
          },
          {
            "create": {
              "type": "'Triple'",
              "attributes": {
                "s": "p.from.iri",
                "sKind": "'iri'",
                "p": "'http://www.w3.org/2000/01/rdf-schema#subClassOf'",
                "o": "p.to.iri",
                "oKind": "'iri'"
              }
            }
          }
        ]
      }
    },
    "doc": "An edit writes triples, and every node and edge follows from recomputation; no hook fires for a derived element."
  },
  "layout": {
    "doc": "Pure and deterministic, no physics: the same file always opens the same way. Authored positions from the registration override computed ones for named terms only; expressions and anchors always take their computed place.",
    "algorithms": {
      "depthColumns": {
        "algorithm": "plugin:net.etalii.adp.w3c.owlDepthColumns",
        "direction": "right",
        "spacing": {
          "node": 60,
          "layer": 90,
          "component": 140
        },
        "options": {
          "columnWidth": 530,
          "laneOffsetX": 250,
          "slotHeight": 130,
          "satelliteHeight": 110,
          "satelliteFirstOffsetY": 10,
          "headerGap": 80,
          "bandGap": 140,
          "bandColumnGap": 60,
          "bandRowGap": 50,
          "bandColumns": 5
        },
        "doc": "The header card top-left; classes in columns by asserted subclass depth, roots left, a cycle collapsed to one depth; each class's expressions, datatypes and anchors in a lane beside it; individuals in a five-wide band below; anything left over in a band below that."
      },
      "fallback": {
        "algorithm": "layered",
        "direction": "left",
        "spacing": {
          "node": 60,
          "layer": 90
        },
        "doc": "What a runtime without the plugin uses: a layered layout over the subclass edges, which run from subclass to superclass, so direction left puts the roots on the left."
      }
    },
    "default": "depthColumns",
    "trigger": "always",
    "respect": "all",
    "incremental": false
  },
  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/rdf/backend/EtAlii.Adp.Diagram.Rdf/w3c-turtle.fbl#turtle",
    "doc": "The RDF file itself is the model, read and written through the module's FBL binding and the turtle plugin; positions live in the `.adp` registration, keyed by element id.",
    "ids": {
      "strategy": "natural",
      "stable": false,
      "types": {
        "Triple": {
          "strategy": "derived",
          "expression": "'triple:' + self.s + '|' + self.p + '|' + self.o + repeatSuffix(self)",
          "ephemeral": {
            "cel": "self.sKind == 'blank' || self.oKind == 'blank'"
          },
          "doc": "A triple by its three parts and a repeat counter. One that names a blank node is ephemeral, since the blank's label is the parse's own."
        },
        "Prefix": {
          "strategy": "derived",
          "expression": "'prefix:' + self.name + repeatSuffix(self)",
          "doc": "A declaration by its prefix and a repeat counter for a re-declaration."
        },
        "Base": {
          "strategy": "derived",
          "expression": "'base'",
          "doc": "A fixed singleton id."
        },
        "Restriction": {
          "ephemeral": true,
          "reason": "That is an anonymous class expression, whose identity does not survive an edit to the file, so a stored position could not be trusted. It takes its place beside the class that uses it; edit the expression as text.",
          "doc": "An expression's structural id is deterministic within one parse and deliberately unstable across edits."
        },
        "Operator": {
          "ephemeral": true,
          "reason": "That is an anonymous class expression, whose identity does not survive an edit to the file, so a stored position could not be trusted. It takes its place beside the class that uses it; edit the expression as text.",
          "doc": "An expression's structural id is deterministic within one parse and deliberately unstable across edits."
        },
        "ThingAnchor": {
          "ephemeral": true,
          "reason": "That element is drawn where its property needs it and cannot be arranged on its own."
        },
        "LiteralAnchor": {
          "ephemeral": true,
          "reason": "That element is drawn where its property needs it and cannot be arranged on its own."
        }
      },
      "pattern": "^(res:.+|ind:.+|expr:.+|thing:.+\\|(domain|range)|dt:.+|edge:.+|triple:.+|prefix:.*|base|truncation)$"
    },
    "view": {
      "store": [
        "bounds"
      ],
      "styleOverrides": "none"
    }
  },
  "viewpoints": {
    "ontology": {
      "label": "Ontology",
      "exclude": [
        "Triple",
        "Prefix",
        "Base"
      ],
      "default": true
    }
  },
  "plugins": {
    "net.etalii.adp.w3c.turtle": {
      "version": "^0.1.0",
      "required": true,
      "provides": [
        "persistenceFormat",
        "celFunctions",
        "action"
      ],
      "plans": [
        "add",
        "set",
        "remove"
      ],
      "doc": "The RDF family's engine: it reads a `.ttl` or `.nt` body into the stored `Triple`, `Prefix` and `Base` elements and the five `rdf.*` findings, plans the splices of an added, set or removed triple, carries out the two edits that are not a change of one triple (renaming a term everywhere it is written, declaring a prefix; gap 2 of `w3c-rdf.md`), and provides the naming functions. Every function is called by its bare name.",
      "celFunctions": [
        {
          "name": "rdfLocalName",
          "params": [
            {
              "name": "iri",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 1,
          "fallback": "iri.substring(math.greatest(iri.lastIndexOf('#'), iri.lastIndexOf('/')) + 1)",
          "doc": "The part of an IRI after its last '#' or '/', or the whole IRI."
        },
        {
          "name": "rdfDisplayName",
          "params": [
            {
              "name": "iri",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "rdfLocalName(iri) != '' ? rdfLocalName(iri) : iri",
          "doc": "An IRI as drawn: a prefixed name under the file's prefixes, else the local name, else the IRI."
        },
        {
          "name": "rdfCompress",
          "params": [
            {
              "name": "iri",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "'<' + iri + '>'",
          "doc": "An IRI as the writer spells it: `prefix:local`, else the bracketed `<iri>`."
        },
        {
          "name": "rdfResolveTerm",
          "params": [
            {
              "name": "term",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "doc": "The full IRI a typed term names; '' when it names nothing. No fallback: without the engine a typed term cannot be resolved, so the dialogs refuse."
        },
        {
          "name": "rdfMintIri",
          "params": [
            {
              "name": "label",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "doc": "The IRI a new term labelled `label` starts life under: the namespace of the prefix the file's first prefixed subject is written under, else the first declared prefix, then the label with every character but ASCII letters, digits, '-' and '_' replaced by '_' and '_' trimmed from both ends; '' when there is no prefix or nothing usable is left. No fallback: the written form of a subject is the engine's."
        },
        {
          "name": "rdfMintRefusal",
          "params": [
            {
              "name": "label",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "'\\'' + label + '\\' cannot be turned into an IRI without the RDF engine.'",
          "doc": "The sentence explaining why rdfMintIri returned ''."
        },
        {
          "name": "rdfTermRefusal",
          "params": [
            {
              "name": "term",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 10,
          "uses": [
            "diagram"
          ],
          "fallback": "'\\'' + term + '\\' cannot be resolved without the RDF engine.'",
          "doc": "The sentence explaining why rdfResolveTerm returned ''."
        }
      ]
    }
  },
  "x-owl": {
    "doc": "Today's wire ids, which the standalone client and backend share, mapped from this specification's names. A tool is keyed by its id, an action by its operation, a property by its form item's id; an axiom row's id is numbered by its position among the element's axiom rows.",
    "tools": {
      "class": {
        "id": "owl.toolbox.class",
        "drop": "owl.add-class"
      },
      "objectProperty": {
        "id": "owl.toolbox.object-property",
        "drop": "owl.add-object-property"
      },
      "datatypeProperty": {
        "id": "owl.toolbox.datatype-property",
        "drop": "owl.add-datatype-property"
      },
      "individual": {
        "id": "owl.toolbox.individual",
        "drop": "owl.add-individual"
      }
    },
    "actions": {
      "addResource": "rdf.add-resource",
      "declarePrefix": "rdf.add-prefix",
      "relate": "rdf.connect",
      "renameResource": "rdf.rename-resource",
      "removeResource": "rdf.remove-resource",
      "removeStatement": "rdf.remove-edge",
      "subclass": "owl.subclass",
      "addClass": "owl.add-class",
      "addObjectProperty": "owl.add-object-property",
      "addDatatypeProperty": "owl.add-datatype-property",
      "addIndividual": "owl.add-individual"
    },
    "properties": {
      "iri": "rdf.iri",
      "types": "rdf.types",
      "label": "rdf.label",
      "comment": "rdf.comment",
      "predicateIri": "rdf.predicate",
      "expression": "owl.expression",
      "axioms": {
        "rows": "owl.axiom.{index}",
        "characteristics": "owl.characteristic.{index}",
        "doc": "Axiom rows are `owl.axiom.{index}`, characteristic rows `owl.characteristic.{index}`, with one index counting both."
      }
    }
  },
  "x-adp": {
    "origin": "w3c/owl",
    "state": "implemented",
    "extensions": [
      ".ttl",
      ".nt"
    ],
    "claimsBareFiles": false,
    "suggestWhenBodyContains": [
      "owl:Ontology",
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
