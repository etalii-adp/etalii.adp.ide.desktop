            "style": "external",
            "doc": "An element outside the scope being described is muted grey, so scope is readable at a glance."
          }
        ],
        "variants": [
          {
            "when": "self.database",
            "shape": "c4Cylinder",
            "doc": "An element tagged Database is drawn as a cylinder."
          }
        ],
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "placement": {
          "x": "free",
          "y": "free",
          "anchor": "center",
          "resizable": false
        },
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "shownName(self)"
          }
        }
      },
      "SoftwareSystemInstance": {
        "shape": {
          "type": "roundedRect",
          "params": {
            "radius": 8
          }
        },
        "style": "softwareSystem",
        "size": {
          "min": [
            160,
            39.6
          ],
          "max": [
            240,
            null
          ],
          "autoSize": "fitContent",
          "resizable": false
        },
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "displayedName(self)"
            },
            "editText": {
              "attribute": "name"
            },
            "editable": "inline",
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                22
              ],
              "align": "center"
            },
            "style": "cardName",
            "wrap": "none",
            "overflow": "visible"
          },
          {
            "id": "type",
            "text": {
              "cel": "typeLine(self)"
            },
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                38
              ],
              "align": "center"
            },
            "style": "cardType",
            "wrap": "none",
            "overflow": "ellipsis"
          },
          {
            "id": "description",
            "text": {
              "cel": "displayedDescription(self)"
            },
            "editable": false,
            "position": {
              "anchor": [
                0.5,
                0
              ],
              "offset": [
                0,
                58
              ],
              "align": "center"
            },
            "style": "cardDescription",
            "wrap": "word",
            "maxWidth": "parent"
          }
        ],
        "conditions": [
          {
            "when": "self.external",
            "style": "external",
            "doc": "An element outside the scope being described is muted grey, so scope is readable at a glance."
          }
        ],
        "variants": [
          {
            "when": "self.database",
            "shape": "c4Cylinder",
            "doc": "An element tagged Database is drawn as a cylinder."
          }
        ],
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "placement": {
          "x": "free",
          "y": "free",
          "anchor": "center",
          "resizable": false
        },
        "accessibility": {
          "role": "button",
          "name": {
            "cel": "shownName(self)"
          }
        }
      }
    },
    "edges": {
      "Relationship": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.line"
            },
            "width": 1.5,
            "dash": [
              6,
              4
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "label",
            "at": "middle",
            "side": "above",
            "distance": 6,
            "orientation": "horizontal",
            "text": {
              "cel": "lineLabel(self.description, self.technology)"
            },
            "editText": {
              "attribute": "description"
            },
            "editable": "inline",
            "style": "relationshipLabel",
            "wrap": "none"
          }
        ],
        "anchoring": {
          "source": {
            "mode": "outline"
          },
          "target": {
            "mode": "outline"
          }
        },
        "deletable": false,
        "reconnectable": false
      },
      "LiftedRelationship": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.line"
            },
            "width": 1.5,
            "dash": [
              6,
              4
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "label",
            "at": "middle",
            "side": "above",
            "distance": 6,
            "orientation": "horizontal",
            "text": {
              "cel": "lineLabel(self.description, self.technology)"
            },
            "editable": false,
            "style": "relationshipLabel",
            "wrap": "none"
          }
        ],
        "anchoring": {
          "source": {
            "mode": "outline"
          },
          "target": {
            "mode": "outline"
          }
        },
        "deletable": false,
        "reconnectable": false
      },
      "InstanceLine": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.line"
            },
            "width": 1.5,
            "dash": [
              6,
              4
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "label",
            "at": "middle",
            "side": "above",
            "distance": 6,
            "orientation": "horizontal",
            "text": {
              "cel": "lineLabel(self.description, self.technology)"
            },
            "editable": false,
            "style": "relationshipLabel",
            "wrap": "none"
          }
        ],
        "anchoring": {
          "source": {
            "mode": "outline"
          },
          "target": {
            "mode": "outline"
          }
        },
        "deletable": false,
        "reconnectable": false
      },
      "InteractionLine": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.line"
            },
            "width": 1.5,
            "dash": [
              6,
              4
            ],
            "dashScale": "absolute"
          },
          "routing": "straight"
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "label",
            "at": "middle",
            "side": "above",
            "distance": 6,
            "orientation": "horizontal",
            "text": {
              "cel": "self.description == '' ? '' : (self.order != '' ? self.order + '. ' + self.description : self.description)"
            },
            "editable": false,
            "style": "relationshipLabel",
            "wrap": "none"
          }
        ],
        "anchoring": {
          "source": {
            "mode": "outline"
          },
          "target": {
            "mode": "outline"
          }
        },
        "deletable": false,
        "reconnectable": false
      }
    },
    "canvas": {
      "background": {
        "token": "color.canvas"
      },
      "title": {
        "id": "heading",
        "text": {
          "attribute": "heading"
        },
        "style": "diagramTitle",
        "editable": false
      },
      "legend": {
        "visible": true,
        "position": "outside-bottom",
        "title": "Key",
        "from": "drawn",
        "computed": {
          "key": "self.legendLabel",
          "label": {
            "cel": "self.legendLabel"
          },
          "swatch": {
            "shape": {
              "type": "roundedRect",
              "params": {
                "radius": 4
              }
            },
            "fill": {
              "cel": "self.external ? token('color.external') : token({'Person': 'color.person', 'SoftwareSystem': 'color.softwareSystem', 'Container': 'color.container', 'Component': 'color.component', 'DeploymentNode': 'color.deploymentNode', 'InfrastructureNode': 'color.deploymentNode', 'ContainerInstance': 'color.container', 'SoftwareSystemInstance': 'color.softwareSystem'}[self.type])"
            }
          },
          "doc": "One entry per distinct kind among the elements drawn, ` (external)` appended where it applies, each with a swatch in the card's background colour (`C4ElementMapper.LegendFor`). The tool lists the entries in the order of the view's members, the order of its `include` statements first (companion, gap 15)."
        }
      },
      "doc": "C4 asks every diagram for a title that says its type and scope, and a key of the shapes and colours it uses: the title is drawn above the drawing surface and the key below it."
    },
    "doc": "The Structurizr default theme: a card per element, a dashed arrow per line. How big a card is, the boundary drawn around a container view's system or a hosting deployment node (`boundary:<id>`) and the moving of outsiders out of it are the host's (finding A16)."
  },
  "toolbox": {
    "generic": {
      "select": true,
      "pan": true,
      "lasso": false,
      "text": false,
      "note": false,
      "image": false,
      "freehand": false
    },
    "groups": [
      {
        "id": "elements",
        "label": "C4 deployment diagram",
        "tools": [
          {
            "id": "deploymentNode",
            "kind": "operation",
            "operation": "addDeploymentNode",
            "label": "Deployment Node",
            "icon": "mdi-server",
            "mode": "drop",
            "drop": {
              "targets": [
                {
                  "on": [
                    "canvas",
                    "Element"
                  ],
                  "kind": "operation",
                  "operation": "addDeploymentNode"
                }
              ],
              "doc": "The tool offers it and answers the drop with a refusal: its add action is not implemented."
            },
            "doc": "Where things run: a server, a cluster, an execution environment."
          },
          {
            "id": "infrastructureNode",
            "kind": "operation",
            "operation": "addInfrastructureNode",
            "label": "Infrastructure Node",
            "icon": "mdi-lan",
            "mode": "drop",
            "drop": {
              "targets": [
                {
                  "on": [
                    "canvas",
                    "Element"
                  ],
                  "kind": "operation",
                  "operation": "addInfrastructureNode"
                }
              ],
              "doc": "The tool offers it and answers the drop with a refusal: its add action is not implemented."
            },
            "doc": "Supporting infrastructure: DNS, a load balancer, a firewall."
          },
          {
            "id": "containerInstance",
            "kind": "operation",
            "operation": "addContainerInstance",
            "label": "Container Instance",
            "icon": "mdi-package-variant-closed",
            "mode": "drop",
            "drop": {
              "targets": [
                {
                  "on": [
                    "canvas",
                    "Element"
                  ],
                  "kind": "operation",
                  "operation": "addContainerInstance"
                }
              ],
              "doc": "The tool offers it and answers the drop with a refusal: its add action is not implemented."
            },
            "doc": "A container, deployed onto a node."
          },
          {
            "id": "softwareSystemInstance",
            "kind": "operation",
            "operation": "addSoftwareSystemInstance",
            "label": "Software System Instance",
            "icon": "mdi-application-outline",
            "mode": "drop",
            "drop": {
              "targets": [
                {
                  "on": [
                    "canvas",
                    "Element"
                  ],
                  "kind": "operation",
                  "operation": "addSoftwareSystemInstance"
                }
              ],
              "doc": "The tool offers it and answers the drop with a refusal: its add action is not implemented."
            },
            "doc": "Software System Instance"
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "Element"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "rename",
            "group": "g1",
            "label": "Rename…",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "editDescription",
            "group": "g1",
            "icon": "mdi-text-box-outline"
          },
          {
            "kind": "operation",
            "operation": "setTechnology",
            "group": "g1",
            "icon": "mdi-tools",
            "visible": "hasTechnology(self)"
          }
        ],
        "doc": "An element's menu has no add group: what can be added inside an element is added from the toolbox."
      },
      {
        "for": [
          "Relationship"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "relabel",
            "group": "g1",
            "label": "Relabel…",
            "icon": "mdi-pencil-outline",
            "shortcut": "F2"
          },
          {
            "kind": "operation",
            "operation": "setProtocol",
            "group": "g1",
            "label": "Set technology…",
            "icon": "mdi-transit-connection-variant"
          }
        ],
        "doc": "A stored relationship drawn as itself. A lifted line, a line between instances and an interaction have no menu (finding A10)."
      },
      {
        "for": [
          "diagram"
        ],
        "placement": "menu",
        "standardEntries": false,
        "tools": [
          {
            "kind": "operation",
            "operation": "addPerson",
            "group": "g1",
            "label": "Add person…",
            "icon": "mdi-plus"
          },
          {
            "kind": "operation",
            "operation": "addSoftwareSystem",
            "group": "g1",
            "label": "Add software system…",
            "icon": "mdi-plus"
          }
        ],
        "doc": "The empty canvas offers the two kinds that need no parent. The labels end in an ellipsis, as every label that asks for a value does; they ended in a literal `&` until finding A14 of the standalone tool's c4-disl-fbl specification was fixed."
      }
    ]
  },
  "forms": {
    "element": {
      "for": "Element",
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "attribute": "name",
          "label": "Name",
          "widget": "text"
        },
        {
          "attribute": "description",
          "label": "Description",
          "widget": "textarea"
        },
        {
          "attribute": "technology",
          "label": "Technology",
          "widget": "text",
          "visible": "hasTechnology(self)"
        },
        {
          "attribute": "tags",
          "label": "Tags",
          "widget": "text",
          "display": {
            "cel": "self.tags.join(', ')"
          },
          "readOnlyReasons": [
            "Tags are edited in the document until an action exists for them."
          ]
        },
        {
          "kind": "section",
          "label": "Model",
          "items": [
            {
              "kind": "computed",
              "id": "kind",
              "label": "Kind",
              "widget": "text",
              "value": {
                "cel": "kindName(self.type)"
              },
              "readOnlyReasons": [
                "Changing this changes the shape of the model rather than a value, so it is done from the diagram rather than here."
              ]
            },
            {
              "kind": "computed",
              "id": "identifier",
              "label": "Identifier",
              "widget": "text",
              "value": {
                "cel": "self.id"
              },
              "readOnlyReasons": [
                "Changing this changes the shape of the model rather than a value, so it is done from the diagram rather than here."
              ]
            }
          ]
        }
      ]
    },
    "relationship": {
      "for": "Relationship",
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "attribute": "description",
          "id": "relationshipDescription",
          "label": "Description",
          "widget": "text"
        },
        {
          "attribute": "technology",
          "id": "relationshipTechnology",
          "label": "Technology",
          "widget": "text"
        },
        {
          "kind": "section",
          "label": "Model",
          "items": [
            {
              "kind": "computed",
              "id": "from",
              "label": "From",
              "widget": "text",
              "value": {
                "cel": "self.source != null ? shownName(self.source) : writtenEnd(self, 'source')"
              },
              "readOnlyReasons": [
                "The ends of a relationship are what it is. Draw a different relationship to connect something else."
              ]
            },
            {
              "kind": "computed",
              "id": "to",
              "label": "To",
              "widget": "text",
              "value": {
                "cel": "self.target != null ? shownName(self.target) : writtenEnd(self, 'target')"
              },
              "readOnlyReasons": [
                "The ends of a relationship are what it is. Draw a different relationship to connect something else."
              ]
            }
          ]
        }
      ],
      "doc": "A stored relationship drawn as itself. A lifted line, a line between instances and an interaction have no rows (finding A10)."
    },
    "renameElement": {
      "label": "Rename element",
      "icon": "mdi-pencil-outline",
      "usage": [
        "popover"
      ],
      "submitLabel": "Rename",
      "items": [
        {
          "attribute": "name",
          "label": "Name",
          "widget": "text",
          "initial": "self.name",
          "validate": [
            {
              "rule": "value.trim() != ''",
              "message": "Every C4 element needs a name."
            }
          ]
        }
      ]
    },
    "describeElement": {
