      "icon": "mdi-text-box-outline",
      "usage": [
        "popover"
      ],
      "submitLabel": "Save",
      "items": [
        {
          "attribute": "description",
          "label": "Description",
          "widget": "textarea",
          "initial": "self.description"
        }
      ]
    },
    "setTechnology": {
      "label": "Set technology",
      "icon": "mdi-tools",
      "usage": [
        "popover"
      ],
      "submitLabel": "Save",
      "items": [
        {
          "attribute": "technology",
          "label": "Technology",
          "widget": "text",
          "initial": "self.technology"
        }
      ]
    },
    "relabelRelationship": {
      "label": "Relabel relationship",
      "icon": "mdi-pencil-outline",
      "usage": [
        "popover"
      ],
      "submitLabel": "Save",
      "items": [
        {
          "attribute": "description",
          "label": "Description",
          "widget": "text",
          "initial": "self.description"
        }
      ]
    },
    "setProtocol": {
      "label": "Set technology",
      "icon": "mdi-transit-connection-variant",
      "usage": [
        "popover"
      ],
      "submitLabel": "Save",
      "items": [
        {
          "attribute": "technology",
          "label": "Technology",
          "widget": "text",
          "initial": "self.technology"
        }
      ]
    },
    "addPerson": {
      "label": "Add person",
      "icon": "mdi-plus",
      "usage": [
        "popover"
      ],
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "name",
          "label": "Name",
          "widget": "text",
          "initial": "''",
          "validate": [
            {
              "rule": "value.trim() != ''",
              "message": "Every C4 element needs a name."
            }
          ]
        }
      ]
    },
    "addSoftwareSystem": {
      "label": "Add software system",
      "icon": "mdi-plus",
      "usage": [
        "popover"
      ],
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "name",
          "label": "Name",
          "widget": "text",
          "initial": "''",
          "validate": [
            {
              "rule": "value.trim() != ''",
              "message": "Every C4 element needs a name."
            }
          ]
        }
      ]
    },
    "addContainer": {
      "label": "Add container",
      "icon": "mdi-plus",
      "usage": [
        "popover"
      ],
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "name",
          "label": "Name",
          "widget": "text",
          "initial": "''",
          "validate": [
            {
              "rule": "value.trim() != ''",
              "message": "Every C4 element needs a name."
            }
          ]
        }
      ]
    },
    "addComponent": {
      "label": "Add component",
      "icon": "mdi-plus",
      "usage": [
        "popover"
      ],
      "submitLabel": "Add",
      "items": [
        {
          "attribute": "name",
          "label": "Name",
          "widget": "text",
          "initial": "''",
          "validate": [
            {
              "rule": "value.trim() != ''",
              "message": "Every C4 element needs a name."
            }
          ]
        }
      ]
    }
  },
  "constraints": {
    "defaults": {
      "severity": "warning",
      "timing": [
        "live",
        "save"
      ]
    },
    "blockSaveOn": "never",
    "builtIn": {
      "std.duplicateId": {
        "enabled": false,
        "doc": "Two elements of one identifier are both read and the first is the one a lookup finds, as today; reporting it is a change of its own (Q4)."
      },
      "std.references": {
        "enabled": false,
        "doc": "A relationship whose end names nothing is reported once, by `danglingRelationship`, in the tool's sentence (Q4, finding A13)."
      },
      "std.missingId": {
        "enabled": false,
        "doc": "An element declared without an identifier is read without a finding, as today (finding A8, Q7)."
      },
      "std.containment": {
        "enabled": false,
        "doc": "An element is read wherever the body declares it, and one in the wrong place is reported by `misplacedElement`, in the tool's sentence."
      }
    },
    "doc": "Every rule is about the model, never about one reading of it, so every C4 definition reports the same findings for a workspace whichever view is open. The tool reports them element by element, which DISL's order by rule cannot state (companion, gap 10). Its finding `c4.unknown-view-scope` (\"The '<key>' view is scoped to '<id>', which the model does not declare.\", at the view's line) is not a rule here: a View exposes neither the scope it was written with nor its line (companion, gaps 13 and 14).",
    "rules": [
      {
        "id": "includeNotFollowed",
        "code": "c4.include-not-followed",
        "label": "Include not followed",
        "scope": "IncludedFile",
        "rule": "false",
        "target": "[]",
        "location": "null",
        "message": {
          "cel": "\"This model includes '\" + self.path + \"', which ADP does not read. Anything declared there is missing from this diagram, and ADP will not edit it.\""
        },
        "doc": "Reported without a location, as today (finding B11, Q4)."
      },
      {
        "id": "missingDescription",
        "code": "c4.missing-description",
        "label": "Missing description",
        "scope": [
          "Person",
          "SoftwareSystem",
          "Container",
          "Component"
        ],
        "rule": "self.description != ''",
        "attribute": "description",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' has no description. C4 asks for a short description on every element, so a reader can tell at a glance what it is responsible for.\""
        }
      },
      {
        "id": "missingDeploymentDescription",
        "code": "c4.missing-deployment-description",
        "label": "Missing description",
        "scope": "DeploymentNode",
        "rule": "self.description != ''",
        "attribute": "description",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' has no description. C4 asks for a short description on every element, so a reader can tell at a glance what it is responsible for.\""
        }
      },
      {
        "id": "missingInfrastructureDescription",
        "code": "c4.missing-infrastructure-description",
        "label": "Missing description",
        "scope": "InfrastructureNode",
        "rule": "self.description != ''",
        "attribute": "description",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' has no description. C4 asks for a short description on every element, so a reader can tell at a glance what it is responsible for.\""
        }
      },
      {
        "id": "missingTechnology",
        "code": "c4.missing-technology",
        "label": "Missing technology",
        "scope": [
          "Container",
          "Component"
        ],
        "rule": "self.technology != ''",
        "attribute": "technology",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' has no technology. C4 asks for one explicitly on every \" + self.type.lowerAscii() + \".\""
        }
      },
      {
        "id": "missingDeploymentTechnology",
        "code": "c4.missing-deployment-technology",
        "label": "Missing technology",
        "scope": "DeploymentNode",
        "rule": "self.technology != ''",
        "attribute": "technology",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' names no technology. A deployment diagram is read to find out what actually runs where, so say what this node is.\""
        }
      },
      {
        "id": "missingInfrastructureTechnology",
        "code": "c4.missing-infrastructure-technology",
        "label": "Missing technology",
        "scope": "InfrastructureNode",
        "rule": "self.technology != ''",
        "attribute": "technology",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' names no technology. A deployment diagram is read to find out what actually runs where, so say what this node is.\""
        }
      },
      {
        "id": "disconnectedElement",
        "code": "c4.disconnected-element",
        "label": "Disconnected element",
        "over": "model",
        "scope": [
          "Person",
          "SoftwareSystem",
          "Container",
          "Component"
        ],
        "when": "diagram.views.size() > 0",
        "rule": "diagram.relationsOfType('Relationship').exists(r, reaches(r, self))",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' is in no relationship at all. An element nothing reaches and that reaches nothing is either unfinished or left over.\""
        },
        "doc": "Silent while the model declares no view. A relationship connects the elements it crosses: its ends and their ancestors, less the ancestors both ends share."
      },
      {
        "id": "misplacedElement",
        "code": "c4.misplaced-element",
        "label": "Misplaced element",
        "scope": [
          "Container",
          "Component"
        ],
        "rule": "cel.bind(required, self.isA('Container') ? 'SoftwareSystem' : 'Container', self.parent != null && self.parent.type == required)",
        "message": {
          "cel": "cel.bind(required, self.isA('Container') ? 'software system' : 'container', self.parent == null ? \"'\" + shownName(self) + \"' is a \" + spelled(self.type) + \" declared outside any \" + required + \". In C4 a \" + spelled(self.type) + \" is part of a \" + required + \".\" : \"'\" + shownName(self) + \"' is a \" + spelled(self.type) + \" inside a \" + spelled(self.parent.type) + \". In C4 a \" + spelled(self.type) + \" is part of a \" + required + \".\")"
        }
      },
      {
        "id": "danglingRelationship",
        "code": "c4.dangling-relationship",
        "label": "Dangling relationship",
        "scope": "Relationship",
        "rule": "self.source != null && self.target != null",
        "message": {
          "cel": "\"The relationship on line \" + string(self.location().orValue({'line': 0}).line) + \" names '\" + (self.source == null ? writtenEnd(self, 'source') : writtenEnd(self, 'target')) + \"', which the model does not declare.\""
        },
        "doc": "Once per relationship, naming the source when both ends name nothing, at the relationship's line (finding A13)."
      },
      {
        "id": "unlabelledRelationship",
        "code": "c4.unlabelled-relationship",
        "label": "Unlabelled relationship",
        "scope": "Relationship",
        "when": "self.source != null && self.target != null",
        "rule": "self.description != ''",
        "attribute": "description",
        "message": {
          "cel": "\"The relationship from '\" + shownName(self.source) + \"' to '\" + shownName(self.target) + \"' has no label. C4 asks what the relationship is for, in the direction of the arrow.\""
        }
      },
      {
        "id": "missingProtocol",
        "code": "c4.missing-protocol",
        "label": "Missing technology",
        "scope": "Relationship",
        "when": "self.source != null && self.target != null",
        "rule": "self.technology != ''",
        "attribute": "technology",
        "message": {
          "cel": "\"The relationship from '\" + shownName(self.source) + \"' to '\" + shownName(self.target) + \"' names no technology. How two elements communicate - a protocol, a library, a call - is what tells a reader where a boundary really is.\""
        }
      },
      {
        "id": "kindNotPermitted",
        "code": "c4.kind-not-permitted-on-view",
        "label": "Kind not permitted on the view",
        "over": "model",
        "scope": "Element",
        "forEach": "diagram.views.filter(v, v.members.exists(m, m == self) && !(self.type in permitted(v.viewpoint)))",
        "target": "self",
        "subject": "item.id",
        "message": {
          "cel": "\"The '\" + item.id + \"' view shows '\" + shownName(self) + \"', which is a \" + spelled(self.type) + \". A \" + viewSpelled(item.viewpoint) + \" view shows \" + permitted(item.viewpoint).map(t, spelled(t)).join(', ') + \".\""
        },
        "doc": "Only an element a view's `include` names can be of a kind the view does not permit; `include *` selects permitted kinds only. The subject is the view's key: the tool reports a view's findings together (companion, gap 10)."
      },
      {
        "id": "emptyView",
        "code": "c4.empty-view",
        "label": "Empty view",
        "over": "model",
        "scope": "diagram",
        "forEach": "diagram.views.filter(v, !v.members.exists(m, m.kind == 'node'))",
        "subject": "item.id",
        "message": {
          "cel": "\"The '\" + item.id + \"' view is empty.\""
        },
        "doc": "The subject is the view's key, a finding having neither a target nor a location otherwise (8.6). The tool locates the finding at the view's line, which a View does not expose (companion, gap 13)."
      },
      {
        "id": "elementNotOnAnyView",
        "code": "c4.element-not-on-any-view",
        "label": "Element not on any view",
        "over": "model",
        "scope": [
          "Person",
          "SoftwareSystem",
          "Container",
          "Component",
          "DeploymentNode",
          "InfrastructureNode"
        ],
        "when": "diagram.views.size() > 0",
        "rule": "diagram.views.exists(v, v.members.exists(m, m == self))",
        "message": {
          "cel": "\"'\" + shownName(self) + \"' is on no view. An element the model declares but nothing draws is invisible to every reader of the diagrams.\""
        },
        "doc": "Silent while the model declares no view. An instance is drawn or not on account of its node and what it instantiates, and is not reported."
      },
      {
        "id": "noTechnologyHere",
        "kind": "change",
        "scope": "Element",
        "enforcement": "prevent",
        "rule": "attribute != 'technology' || hasTechnology(self)",
        "message": {
          "cel": "'A ' + self.type.lowerAscii() + ' has no technology in C4; only containers, components and infrastructure do.'"
        }
      },
      {
        "id": "dragDoesNotReparent",
        "kind": "placement",
        "label": "Dragging does not change containment",
        "enforcement": "prevent",
        "severity": "error",
        "when": "gesture == 'move'",
        "rule": "newParent == self.parent",
        "message": "Dragging changes where an element is drawn, not what contains it."
      }
    ]
  },
  "behavior": {
    "messages": {
      "std.notApplicable": "That element is no longer in this model."
    },
    "operations": {
      "rename": {
        "label": "Rename…",
        "icon": "mdi-pencil-outline",
        "shortcut": "F2",
        "for": [
          "Element"
        ],
        "params": {
          "name": {
            "type": "string",
            "label": "Name"
          }
        },
        "paramsForm": "renameElement",
        "actions": [
          {
            "set": {
              "name": "p.name"
            }
          }
        ],
        "doc": "The prompt may be drawn in place of the element's name."
      },
      "editDescription": {
        "label": {
          "cel": "self.description != '' ? 'Edit description…' : 'Add description…'"
        },
        "icon": "mdi-text-box-outline",
        "for": [
          "Element"
        ],
        "params": {
          "description": {
            "type": "text",
            "label": "Description"
          }
        },
        "paramsForm": "describeElement",
        "actions": [
          {
            "set": {
              "description": "p.description"
            }
          }
        ]
      },
      "setTechnology": {
        "label": {
          "cel": "self.technology != '' ? 'Change technology…' : 'Set technology…'"
        },
        "icon": "mdi-tools",
        "for": [
          "Element"
        ],
        "params": {
          "technology": {
            "type": "string",
            "label": "Technology"
          }
        },
        "paramsForm": "setTechnology",
        "unavailable": [
          {
            "when": "!hasTechnology(self)",
            "message": {
              "cel": "'A ' + self.type.lowerAscii() + ' has no technology in C4; only containers, components and infrastructure do.'"
            }
          }
        ],
        "actions": [
          {
            "set": {
              "technology": "p.technology"
            }
          }
        ]
      },
      "relabel": {
        "label": "Relabel…",
        "icon": "mdi-pencil-outline",
        "shortcut": "F2",
        "for": [
          "Relationship"
        ],
        "params": {
          "description": {
            "type": "string",
            "label": "Description"
          }
        },
        "paramsForm": "relabelRelationship",
        "actions": [
          {
            "set": {
              "description": "p.description"
            }
          }
        ],
        "doc": "The prompt may be drawn in place of the line's label."
      },
      "setProtocol": {
        "label": "Set technology…",
        "icon": "mdi-transit-connection-variant",
        "for": [
          "Relationship"
        ],
        "params": {
          "technology": {
            "type": "string",
            "label": "Technology"
          }
        },
        "paramsForm": "setProtocol",
        "actions": [
          {
            "set": {
              "technology": "p.technology"
            }
          }
        ]
      },
      "addPerson": {
        "label": "Add person…",
        "icon": "mdi-plus",
        "params": {
          "name": {
            "type": "string",
            "label": "Name"
          }
        },
        "paramsForm": "addPerson",
        "actions": [
          {
            "abort": {
              "message": "'An element needs a name.'"
            },
            "when": "p.name.trim() == ''"
          },
          {
            "create": {
              "type": "'Person'",
              "attributes": {
                "name": "p.name",
                "description": "'Describe ' + p.name + '.'"
              }
            }
          }
        ],
        "doc": "Added at the top of the model, from the empty canvas's menu or wherever the tool was dropped, so it names no `for`."
      },
      "addSoftwareSystem": {
        "label": "Add software system…",
        "icon": "mdi-plus",
        "params": {
          "name": {
            "type": "string",
            "label": "Name"
          }
        },
        "paramsForm": "addSoftwareSystem",
        "actions": [
          {
            "abort": {
              "message": "'An element needs a name.'"
            },
            "when": "p.name.trim() == ''"
          },
          {
            "create": {
              "type": "'SoftwareSystem'",
              "attributes": {
                "name": "p.name",
                "description": "'Describe ' + p.name + '.'"
              }
            }
          }
        ],
        "doc": "Added at the top of the model, from the empty canvas's menu or wherever the tool was dropped, so it names no `for`."
      },
      "addContainer": {
        "label": "Add container",
        "icon": "mdi-plus",
        "for": [
          "SoftwareSystem"
        ],
        "params": {
          "name": {
            "type": "string",
            "label": "Name"
          }
        },
        "paramsForm": "addContainer",
        "actions": [
          {
            "abort": {
              "message": "'An element needs a name.'"
            },
            "when": "p.name.trim() == ''"
          },
          {
            "create": {
              "type": "'Container'",
              "parent": "self",
              "attributes": {
                "name": "p.name",
                "description": "'Describe ' + p.name + '.'",
                "technology": "'Technology'"
              }
            }
          }
        ],
        "doc": "Added inside the software system it was dropped on."
      },
      "addComponent": {
        "label": "Add component",
        "icon": "mdi-plus",
        "for": [
          "Container"
        ],
        "params": {
          "name": {
            "type": "string",
            "label": "Name"
          }
        },
        "paramsForm": "addComponent",
        "actions": [
          {
            "abort": {
              "message": "'An element needs a name.'"
            },
            "when": "p.name.trim() == ''"
          },
          {
            "create": {
              "type": "'Component'",
              "parent": "self",
              "attributes": {
                "name": "p.name",
                "description": "'Describe ' + p.name + '.'",
                "technology": "'Technology'"
              }
            }
          }
        ],
        "doc": "Added inside the container it was dropped on."
      },
      "addDeploymentNode": {
        "unavailable": [
          "Adding a deployment node from the toolbox is not supported yet."
        ],
        "doc": "The toolbox offers this kind and the tool answers its drop with this refusal: no add action is implemented for it. A commit of an answer to it is refused by the host with \"'<action id>' does not apply to this selection.\" (companion, *Outside the definition*)."
      },
      "addInfrastructureNode": {
        "unavailable": [
          "Adding an infrastructure node from the toolbox is not supported yet."
        ],
        "doc": "The toolbox offers this kind and the tool answers its drop with this refusal: no add action is implemented for it. A commit of an answer to it is refused by the host with \"'<action id>' does not apply to this selection.\" (companion, *Outside the definition*)."
      },
      "addContainerInstance": {
        "unavailable": [
          "Adding a container instance from the toolbox is not supported yet."
        ],
        "doc": "The toolbox offers this kind and the tool answers its drop with this refusal: no add action is implemented for it. A commit of an answer to it is refused by the host with \"'<action id>' does not apply to this selection.\" (companion, *Outside the definition*)."
      },
      "addSoftwareSystemInstance": {
        "unavailable": [
          "Adding a software system instance from the toolbox is not supported yet."
        ],
        "doc": "The toolbox offers this kind and the tool answers its drop with this refusal: no add action is implemented for it. A commit of an answer to it is refused by the host with \"'<action id>' does not apply to this selection.\" (companion, *Outside the definition*)."
      }
    },
    "doc": "Every edit is one undoable step. A new element is declared with a placeholder description, and a container or component with the technology `Technology`; its identifier is made from its name by the host while gap 11 stands."
  },
  "layout": {
    "algorithms": {
      "c4Ranks": {
        "algorithm": "layered",
        "direction": "down",
        "spacing": {
          "layer": 120,
          "node": 60
        },
        "edgeRouting": "straight",
        "scope": "all",
        "doc": "Longest-path ranks along the view's relationships, one row per rank centred on the axis, top to bottom with ranks 120 and nodes 60 apart unless the view's `autoLayout` says otherwise. DISL cannot bind an algorithm's direction or spacing to a diagram attribute, so these are the defaults (companion, gap 9)."
      }
    },
    "default": "c4Ranks",
    "trigger": "always",
    "respect": "pinned",
    "animate": false,
    "doc": "Every view is laid out by ADP. A position dragged on the canvas is kept for that view and replaces the computed one, except in a view that declares `autoLayout`, where every stored position is ignored (companion, gap 9). How the ranks are computed and how a boundary pushes outsiders out are the host's (finding A16)."
  },
  "persistence": {
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/c4/backend/EtAlii.Adp.Diagram.C4/structurizr.fbl#workspace",
    "ids": {
      "strategy": "natural",
      "stable": true,
      "pattern": "^[^\\s\"{}=\\-][^\\s\"{}=]*$",
      "suffix": "{n}",
      "compare": "ignore-case",
      "missing": "ephemeral",
      "types": {
        "Relationship": {
          "strategy": "derived",
          "pattern": "^.+$",
          "ephemeral": true,
          "expression": "writtenEnd(self, 'source') + '->' + writtenEnd(self, 'target') + '@' + string(self.location().orValue({'line': 0}).line)",
          "doc": "A relationship has no identifier in the DSL: its id is its ends as written and its line, which changes when a line is inserted above it (finding A7, Q7)."
        },
        "Interaction": {
          "strategy": "derived",
          "pattern": "^.+$",
          "ephemeral": true,
          "expression": "'interaction:' + writtenEnd(self, 'source') + '->' + writtenEnd(self, 'target') + '@' + string(self.location().orValue({'line': 0}).line)",
          "doc": "An interaction is a statement of the dynamic view, never drawn itself: the line drawn for it (`InteractionLine`) has its ends as written and its line as its id, so the statement's id is told apart from it by a prefix, since a derived element is not drawn under an id the model already holds."
        },
        "LiftedRelationship": {
          "ephemeral": true
        },
        "InstanceLine": {
          "ephemeral": true
        },
        "InteractionLine": {
          "ephemeral": true
        }
      },
      "doc": "Structurizr DSL identifiers, compared without regard to case as the DSL compares them. An element declared without one is ephemeral: the host names it `<kind>_<name>_<n>` for the session and stores nothing under that name (finding A8, Q7). The lines a view draws are ephemeral too, their ids carrying a line number."
    },
    "view": {
      "store": [
        "bounds"
      ]
    },
    "typeMap": {
      "Workspace": {
        "as": "diagram",
        "attributes": {
          "name": "workspaceName"
        }
      },
      "ViewInclude": {
        "as": "diagram",
        "attributes": {
          "members": "includes"
        }
      },
      "IncludedFile": {
        "as": "IncludedFile"
      },
      "Interaction": {
        "as": "Interaction",
        "attributes": {
          "from": "source",
          "to": "target"
        }
      },
      "Relationship": {
        "as": "Relationship",
        "attributes": {
          "from": "source",
          "to": "target"
        },
        "doc": "Read as an entry with two reference attributes, so that a relationship whose end names nothing is kept with that end unset (finding B8)."
      }
    },
    "doc": "The body is an ordinary Structurizr DSL workspace, read and written through the module's own binding; one body is one model and one history however many of its views are open. While gaps 1, 2 and 6 stand, the module reads the body itself and builds this model from its reading (`C4Disl`). Positions are view data, stored as FBL's registration says."
  },
  "viewpoints": {
    "deployment": {
      "label": "Deployment view",
      "include": [
        "Person",
        "SoftwareSystem",
        "Container",
        "Component",
        "DeploymentNode",
        "InfrastructureNode",
        "ContainerInstance",
        "SoftwareSystemInstance",
        "Relationship",
        "LiftedRelationship",
        "InstanceLine",
        "InteractionLine"
      ],
      "exclude": [
        "IncludedFile",
        "Interaction"
      ],
      "members": "self.isA('Relationship') ? drawsStored(self, 'deployment') : (self.kind == 'relation' ? true : isMember(self, 'deployment'))",
      "toolbox": [
        "elements"
      ],
      "layout": "c4Ranks",
      "default": true,
      "doc": "What the view shows (`isMember`): the elements its statements select, of any kind it names, a stored relationship while it is drawn as itself (`drawsStored`), and the lines derived for this kind of view. The kinds it permits are deployment node, infrastructure node, container instance, software system instance."
    }
  },
  "x-c4": {
    "doc": "Today's wire ids, which the standalone client and backend share, mapped from this specification's names, as x-timeline and x-azure-pipeline do. A tool is keyed by its id. An action is keyed by its entry's operation, else its kind. A property is keyed by its form item's row id: its id, else its attribute. Every finding code is its rule's `code`. The synthetic ids `c4:view` and `boundary:<id>` are the host's.",
    "tools": {
      "deploymentNode": {
        "id": "c4.toolbox.deploymentnode",
        "drop": "c4.add-deploymentnode"
      },
      "infrastructureNode": {
        "id": "c4.toolbox.infrastructurenode",
        "drop": "c4.add-infrastructurenode"
      },
      "containerInstance": {
        "id": "c4.toolbox.containerinstance",
        "drop": "c4.add-containerinstance"
      },
      "softwareSystemInstance": {
        "id": "c4.toolbox.softwaresysteminstance",
        "drop": "c4.add-softwaresysteminstance"
      }
    },
    "actions": {
      "rename": "c4.rename",
      "editDescription": "c4.edit-description",
      "setTechnology": "c4.set-technology",
      "relabel": "c4.relabel",
      "setProtocol": "c4.set-protocol",
      "addPerson": "c4.add-person",
      "addSoftwareSystem": "c4.add-softwaresystem",
      "addContainer": "c4.add-container",
      "addComponent": "c4.add-component",
      "addDeploymentNode": "c4.add-deploymentnode",
      "addInfrastructureNode": "c4.add-infrastructurenode",
      "addContainerInstance": "c4.add-containerinstance",
      "addSoftwareSystemInstance": "c4.add-softwaresysteminstance"
    },
    "properties": {
      "name": "c4.name",
      "description": "c4.description",
      "technology": "c4.technology",
      "tags": "c4.tags",
      "kind": "c4.kind",
      "identifier": "c4.identifier",
      "relationshipDescription": "c4.relationship.description",
      "relationshipTechnology": "c4.relationship.technology",
      "from": "c4.relationship.source",
      "to": "c4.relationship.destination"
    }
  }
}
