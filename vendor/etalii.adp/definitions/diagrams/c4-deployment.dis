{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.5",
  "language": {
    "id": "net.etalii.adp.c4.deployment",
    "version": "0.2.0",
    "origin": "c4/deployment",
    "label": "C4 deployment diagram",
    "doc": {
      "summary": "A system's containers mapped onto the infrastructure they run on.",
      "description": "A C4 deployment diagram shows how the containers of one or more software systems are deployed onto infrastructure in one deployment environment, such as production or staging: deployment nodes, which nest, the container instances running on them, and supporting infrastructure nodes. It is one view of a C4 model kept in a Structurizr DSL document.\n\nIn the ADP catalogue this diagram type is `c4/deployment`. Every sentence, label, code and id below is the standalone tool's, as its parity transcript (`Parity/c4.transcript.json`) records them. The six C4 definitions share one model of the workspace and differ only in their viewpoint, toolbox, labels and origin. What DISL 0.4 and FBL 0.7 cannot state is written down in `c4-deployment.md` beside this file, and the wire ids the standalone client and backend share are declared under `x-c4`.",
      "helpUrl": "https://c4model.com/diagrams/deployment",
      "tags": [
        "c4",
        "architecture",
        "software delivery",
        "systems and strategy"
      ],
      "seeAlso": [
        {
          "title": "What DISL and FBL cannot express for this tool",
          "href": "c4-deployment.md"
        },
        {
          "title": "The C4 model",
          "href": "https://c4model.com"
        },
        {
          "title": "Structurizr DSL",
          "href": "https://docs.structurizr.com/dsl"
        },
        {
          "title": "Standalone implementation",
          "href": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/c4"
        }
      ]
    },
    "defaultLocale": "en",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/c4",
    "icon": "mdi:server-network",
    "fileExtension": "dsl",
    "limits": {
      "celCost": 10000000
    },
    "requires": {
      "conformance": "standard"
    }
  },
  "plugins": {
    "net.etalii.adp.c4.writtenEnds": {
      "version": "^1.0.0",
      "provides": [
        "celFunctions"
      ],
      "required": false,
      "doc": "The text a relationship's or an interaction's end is written with, which the model does not hold for an end that names nothing (companion, gap 14). The standalone module supplies it from its reading (`C4Disl`); without the plugin the fallback gives the resolved end's id, so a dangling relationship's sentence names nothing and its id loses that end.",
      "celFunctions": [
        {
          "name": "writtenEnd",
          "params": [
            {
              "name": "relation",
              "type": "dyn"
            },
            {
              "name": "end",
              "type": "string"
            }
          ],
          "returns": "string",
          "cost": 1,
          "fallback": "end == 'source' ? (relation.source != null ? relation.source.id : '') : (relation.target != null ? relation.target.id : '')",
          "doc": "The identifier the relation's `source` or `target` end is written with in the body, as written (the DSL's `a -> b`), also when it names no element and the end is unset in the model (DISL 11.2)."
        }
      ]
    }
  },
  "functions": {
    "shownName": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "string",
      "cel": "e.name != '' ? e.name : e.id",
      "doc": "What a sentence and the From and To rows call an element: its name, or its identifier when the name is empty (`C4RuleSet.Label`)."
    },
    "sameId": {
      "params": [
        {
          "name": "a",
          "type": "string"
        },
        {
          "name": "b",
          "type": "string"
        }
      ],
      "returns": "bool",
      "cel": "lower(a) == lower(b)",
      "doc": "Two identifiers compared as the DSL compares them, without regard to case, as `persistence.ids.compare` says for every lookup the runtime makes itself."
    },
    "spelled": {
      "params": [
        {
          "name": "typeName",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'Person': 'person', 'SoftwareSystem': 'software system', 'Container': 'container', 'Component': 'component', 'DeploymentNode': 'deployment node', 'InfrastructureNode': 'infrastructure node', 'ContainerInstance': 'container instance', 'SoftwareSystemInstance': 'software system instance'}[typeName]",
      "doc": "A kind as a finding or a refusal spells it inside a sentence."
    },
    "kindName": {
      "params": [
        {
          "name": "typeName",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'Person': 'Person', 'SoftwareSystem': 'Software system', 'Container': 'Container', 'Component': 'Component', 'DeploymentNode': 'Deployment node', 'InfrastructureNode': 'Infrastructure node', 'ContainerInstance': 'Container instance', 'SoftwareSystemInstance': 'Software system instance'}[typeName]",
      "doc": "A kind as the Kind row shows it."
    },
    "kindTag": {
      "params": [
        {
          "name": "typeName",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'Person': 'Person', 'SoftwareSystem': 'Software System', 'Container': 'Container', 'Component': 'Component', 'DeploymentNode': 'Deployment Node', 'InfrastructureNode': 'Infrastructure Node', 'ContainerInstance': 'Container', 'SoftwareSystemInstance': 'Software System'}[typeName]",
      "doc": "A kind as the legend and the bracketed type line name it (`C4Theme.KindTag`, `C4LayoutEngine.TypeLineOf`): an instance is named as what it instantiates."
    },
    "hasTechnology": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "bool",
      "cel": "e.isA('Container') || e.isA('Component') || e.isA('DeploymentNode') || e.isA('InfrastructureNode')",
      "doc": "The four kinds that have a technology in C4."
    },
    "referenced": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "dyn",
      "cel": "e.isA('ContainerInstance') ? e.container : (e.isA('SoftwareSystemInstance') ? e.softwareSystem : null)",
      "doc": "What an instance instantiates, or null."
    },
    "displayedName": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "string",
      "cel": "e.name == '' && referenced(e) != null ? referenced(e).name : e.name",
      "doc": "The name drawn on a card: an instance without a name of its own shows the name of what it instantiates (`C4LayoutEngine.Displayed`)."
    },
    "displayedDescription": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "string",
      "cel": "e.description == '' && referenced(e) != null ? referenced(e).description : e.description"
    },
    "displayedTechnology": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "string",
      "cel": "e.technology == '' && referenced(e) != null ? referenced(e).technology : e.technology"
    },
    "typeLine": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "string",
      "cel": "displayedTechnology(e) != '' ? '[' + kindTag(e.type) + ': ' + displayedTechnology(e) + ']' : '[' + kindTag(e.type) + ']'",
      "doc": "The bracketed line under a card's name: its kind, and its technology where it has one."
    },
    "permitted": {
      "params": [
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "list(string)",
      "cel": "{'systemLandscape': ['Person', 'SoftwareSystem'], 'systemContext': ['Person', 'SoftwareSystem'], 'container': ['Person', 'SoftwareSystem', 'Container'], 'component': ['Person', 'SoftwareSystem', 'Container', 'Component'], 'dynamic': ['Person', 'SoftwareSystem', 'Container', 'Component'], 'deployment': ['DeploymentNode', 'InfrastructureNode', 'ContainerInstance', 'SoftwareSystemInstance']}[viewpoint]",
      "doc": "The kinds a view of each kind shows (`C4RuleSet.PermittedKinds`)."
    },
    "viewSpelled": {
      "params": [
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'systemLandscape': 'system landscape', 'systemContext': 'system context', 'container': 'container', 'component': 'component', 'dynamic': 'dynamic', 'deployment': 'deployment'}[viewpoint]",
      "doc": "A view's kind as a finding spells it."
    },
    "viewTitle": {
      "params": [
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "{'systemLandscape': 'System Landscape', 'systemContext': 'System Context', 'container': 'Container', 'component': 'Component', 'dynamic': 'Dynamic', 'deployment': 'Deployment'}[viewpoint]",
      "doc": "A view's kind as its default title names it."
    },
    "isMember": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        },
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "e != null && e.kind == 'node' && (diagram.includes.exists(i, i != '*' && sameId(i, e.id)) || ('*' in diagram.includes && e.type in permitted(viewpoint)) || (viewpoint == 'dynamic' && diagram.relationsOfType('Interaction').exists(r, r.source == e || r.target == e))) && !diagram.excludes.exists(x, sameId(x, e.id)) && !(viewpoint in ['container', 'component'] && diagram.scope != null && diagram.scope == e)",
      "doc": "Whether the view shows `e` (`C4RuleSet.MembersOf`): an element its `include` names, of any kind; with `include *`, every element of a kind the view permits, in the whole model; on a dynamic view, everything an interaction names; less what `exclude` names, and less the element a container or component view is scoped to, which is drawn as the boundary instead. Identifiers are compared without regard to case. The tool reads no wildcard but a lone `*`: an include such as `web*` names nothing, so an include is compared as an identifier, not matched with `matchesGlob`, which would select `webApp`."
    },
    "liftTo": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        },
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "dyn",
      "uses": [
        "diagram"
      ],
      "cel": "e == null ? null : ([e] + e.ancestors()).filter(a, isMember(a, viewpoint)).first().orValue(null)",
      "doc": "The element `e` is drawn as: itself when the view shows it, else its nearest shown ancestor (`ancestors()` lists the parent first), else null (`C4ElementMapper.NearestShown`)."
    },
    "lifted": {
      "params": [
        {
          "name": "r",
          "type": "dyn"
        },
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "list(dyn)",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(s, liftTo(r.source, viewpoint), cel.bind(t, liftTo(r.target, viewpoint), s != null && t != null && !sameId(s.id, t.id) ? [s, t] : []))",
      "doc": "The two elements a relationship is drawn between on the view, or nothing: when an end has no shown element, or when both ends lift to one element, which is that element talking to itself."
    },
    "firstOnPair": {
      "params": [
        {
          "name": "r",
          "type": "dyn"
        },
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "dyn",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.relationsOfType('Relationship').filter(x, lifted(x, viewpoint).size() == 2 && lifted(x, viewpoint) == lifted(r, viewpoint))[0]",
      "doc": "The first relationship, in the order the body declares them, that is drawn between the same two elements as `r`: several relationships that collapse onto one pair draw one line, the first one's."
    },
    "isDirect": {
      "params": [
        {
          "name": "r",
          "type": "dyn"
        },
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "lifted(r, viewpoint) == [r.source, r.target]",
      "doc": "Whether a relationship is drawn between its own two ends, rather than lifted."
    },
    "instancesOf": {
      "params": [
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "list(dyn)",
      "uses": [
        "diagram"
      ],
      "cel": "e == null ? [] : diagram.nodes.filter(n, referenced(n) != null && referenced(n) == e && isMember(n, 'deployment'))",
      "doc": "The instances of `e` a deployment view shows."
    },
    "deploymentEntries": {
      "params": [],
      "returns": "list(list(dyn))",
      "uses": [
        "diagram"
      ],
      "cel": "diagram.relationsOfType('Relationship').map(r, isMember(r.source, 'deployment') && isMember(r.target, 'deployment') ? [[r, r.source, r.target, writtenEnd(r, 'source'), writtenEnd(r, 'target'), true]] : instancesOf(r.source).map(a, instancesOf(r.target).filter(b, !sameId(a.id, b.id)).map(b, [r, a, b, a.id, b.id, false])).flatten()).flatten()",
      "doc": "What a deployment view draws, in the order the body declares the relationships (`C4LayoutEngine.DeploymentRelationshipsOf`): a relationship between two shown elements as itself, keyed by its ends as written; any other once between every two distinct instances of its ends, keyed by the instances. Each entry is `[relationship, source, target, key, key, drawn as itself]`."
    },
    "firstEntry": {
      "params": [
        {
          "name": "entry",
          "type": "list(dyn)"
        }
      ],
      "returns": "list(dyn)",
      "uses": [
        "diagram"
      ],
      "cel": "deploymentEntries().filter(y, y[3] == entry[3] && y[4] == entry[4])[0]",
      "doc": "The first entry with the same key: one line is drawn per key, the first one's."
    },
    "drawsStored": {
      "params": [
        {
          "name": "r",
          "type": "dyn"
        },
        {
          "name": "viewpoint",
          "type": "string"
        }
      ],
      "returns": "bool",
      "uses": [
        "diagram"
      ],
      "cel": "viewpoint == 'dynamic' ? false : (viewpoint == 'deployment' ? deploymentEntries().exists(x, x[0] == r && x[5] && firstEntry(x) == x) : lifted(r, viewpoint).size() == 2 && isDirect(r, viewpoint) && firstOnPair(r, viewpoint) == r)",
      "doc": "Whether the view draws a stored relationship as itself, with its own id, menu and rows. A dynamic view draws its interactions instead."
    },
    "reaches": {
      "params": [
        {
          "name": "r",
          "type": "dyn"
        },
        {
          "name": "e",
          "type": "dyn"
        }
      ],
      "returns": "bool",
      "cel": "cel.bind(s, r.source == null ? [] : ([r.source] + r.source.ancestors()).map(a, a.id), cel.bind(t, r.target == null ? [] : ([r.target] + r.target.ancestors()).map(a, a.id), (e.id in s) != (e.id in t)))",
      "doc": "Whether a relationship crosses `e`: one end is `e` or inside it and the other is not, so a relationship between two containers of one system does not connect the system (`C4RuleSet.ConnectedElements`). Compared by identifier, as the tool compares them: of two elements of one identifier, a relationship that names the first connects the second too."
    },
    "lineLabel": {
      "params": [
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "technology",
          "type": "string"
        }
      ],
      "returns": "string",
      "cel": "technology != '' ? description + ' [' + technology + ']' : description",
      "doc": "What a line says: its description, and its technology in brackets."
    }
  },
  "metamodel": {
    "diagram": {
      "attributes": {
        "workspaceName": {
          "type": "string",
          "label": "Workspace",
          "readOnly": true,
          "default": "",
          "doc": "The workspace's name, as `workspace \"…\"` writes it."
        },
        "viewKey": {
          "type": "string",
          "label": "View key",
          "readOnly": true,
          "default": "",
          "doc": "The key of the view this reading shows, which a registration's `view:` names."
        },
        "title": {
          "type": "string",
          "label": "Title",
          "readOnly": true,
          "default": "",
          "doc": "The title the view declares with a `title` line."
        },
        "heading": {
          "type": "string",
          "derived": "self.title != '' ? self.title : (env.viewpoint == 'systemLandscape' ? (self.workspaceName != '' ? 'System Landscape diagram for ' + self.workspaceName : 'System Landscape diagram') : cel.bind(scopeName, self.scope != null ? self.scope.name : '', env.viewpoint == 'deployment' && self.environment != '' ? (scopeName != '' ? 'Deployment diagram for ' + scopeName + ' - ' + self.environment : 'Deployment diagram - ' + self.environment) : (scopeName != '' ? viewTitle(env.viewpoint) + ' diagram for ' + scopeName : viewTitle(env.viewpoint) + ' diagram')))",
          "doc": "The title drawn above the diagram (`C4ElementMapper.TitleOf`): the declared title, else one made from the view's kind and the name of what it is scoped to, a landscape naming the workspace and a deployment view its environment."
        },
        "scope": {
          "type": "Element",
          "label": "Scope",
          "readOnly": true,
          "doc": "What the view is scoped to: a software system, or a container for a component or dynamic view. Null for a landscape, and when the scope names nothing."
        },
        "environment": {
          "type": "string",
          "label": "Environment",
          "readOnly": true,
          "default": "",
          "doc": "A deployment view's environment."
        },
        "includes": {
          "type": "string",
          "label": "Include",
          "many": true,
          "readOnly": true,
          "doc": "The view's `include` statements, each an identifier or `*`."
        },
        "excludes": {
          "type": "string",
          "label": "Exclude",
          "many": true,
          "readOnly": true,
          "doc": "The view's `exclude` statements, each an identifier."
        },
        "autoLayout": {
          "type": "RankDirection",
          "label": "Automatic layout",
          "readOnly": true,
          "doc": "The direction an `autoLayout` statement names. While the view declares one, every stored position is ignored (companion, gap 9)."
        },
        "rankSeparation": {
          "type": "int",
          "label": "Rank separation",
          "readOnly": true,
          "default": 120
        },
        "nodeSeparation": {
          "type": "int",
          "label": "Node separation",
          "readOnly": true,
          "default": 60
        }
      },
      "doc": "One diagram is one view of a Structurizr DSL workspace; its attributes are the workspace's name and that view's own statements. The view kind is the reading's viewpoint, so the six C4 definitions share this metamodel and every one of them reads every view of the workspace."
    },
    "enums": {
      "RankDirection": {
        "values": {
          "tb": {
            "label": "Top to bottom"
          },
          "bt": {
            "label": "Bottom to top"
          },
          "lr": {
            "label": "Left to right"
          },
          "rl": {
            "label": "Right to left"
          }
        }
      }
    },
    "types": {
      "Element": {
        "abstract": true,
        "labelAttribute": "name",
        "attributes": {
          "name": {
            "type": "string",
            "label": "Name",
            "default": "",
            "key": true,
            "doc": "The key of `natural` ids; a new element's identifier is made from it by the host while gap 11 stands."
          },
          "description": {
            "type": "text",
            "label": "Description",
            "default": ""
          },
          "technology": {
            "type": "string",
            "label": "Technology",
            "default": "",
            "doc": "Read for every kind as the body writes it; only containers, components and the two node kinds have one in C4, and only theirs is shown or written."
          },
          "tags": {
            "type": "string",
            "label": "Tags",
            "many": true,
            "readOnly": true,
            "readOnlyReasons": [
              "Tags are edited in the document until an action exists for them."
            ]
          },
          "external": {
            "type": "bool",
            "derived": "self.tags.exists(t, lower(t) == 'external' || lower(t) == 'existing system')",
            "doc": "Outside the scope being described, which mutes the card."
          },
          "database": {
            "type": "bool",
            "derived": "self.tags.exists(t, lower(t) == 'database')",
            "doc": "Tagged Database, which draws a cylinder."
          },
          "legendLabel": {
            "type": "string",
            "derived": "kindTag(self.type) + (self.external ? ' (external)' : '')",
            "doc": "The legend entry the element counts toward."
          }
        },
        "doc": "What every C4 element has. Every element is a node; containment is the element's parent."
      },
      "Person": {
        "extends": "Element",
        "label": "Person",
        "doc": "A user of the software."
      },
      "SoftwareSystem": {
        "extends": "Element",
        "label": "Software system",
        "children": {
          "allowed": [
            "Container"
          ]
        }
      },
      "Container": {
        "extends": "Element",
        "label": "Container",
        "children": {
          "allowed": [
            "Component"
          ]
        },
        "doc": "An application or a data store - not a Docker container."
      },
      "Component": {
        "extends": "Element",
        "label": "Component"
      },
      "DeploymentNode": {
        "extends": "Element",
        "label": "Deployment node",
        "children": {
          "allowed": [
            "DeploymentNode",
            "InfrastructureNode",
            "ContainerInstance",
            "SoftwareSystemInstance"
          ]
        }
      },
      "InfrastructureNode": {
        "extends": "Element",
        "label": "Infrastructure node"
      },
      "ContainerInstance": {
        "extends": "Element",
        "label": "Container instance",
        "attributes": {
          "container": {
            "type": "Container",
            "label": "Container",
            "readOnly": true
          }
        }
      },
      "SoftwareSystemInstance": {
        "extends": "Element",
        "label": "Software system instance",
        "attributes": {
          "softwareSystem": {
            "type": "SoftwareSystem",
            "label": "Software system",
            "readOnly": true
          }
        }
      },
      "IncludedFile": {
        "label": "Included file",
        "attributes": {
          "path": {
            "type": "string",
            "label": "Path",
            "readOnly": true,
            "default": ""
          }
        },
        "doc": "An `!include` the body names. ADP does not follow it; no viewpoint draws it, and `includeNotFollowed` reports it."
      }
    },
    "relations": {
      "Relationship": {
        "label": "Relationship",
        "source": "Element",
        "target": "Element",
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "description": {
            "type": "string",
            "label": "Description",
            "default": ""
          },
          "technology": {
            "type": "string",
            "label": "Technology",
            "default": ""
          },
          "tags": {
            "type": "string",
            "label": "Tags",
            "many": true,
            "readOnly": true
          }
        },
        "doc": "A relationship as the body states it. An end that names nothing is kept unset (`typeMap`, DISL 11.2) and reported by `danglingRelationship`. A view draws it as itself while both ends are shown and no earlier relationship lands on the same pair (`drawsStored`); otherwise what is drawn is a derived line."
      },
      "Interaction": {
        "label": "Interaction",
        "source": "Element",
        "target": "Element",
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "description": {
            "type": "string",
            "label": "Description",
            "default": ""
          },
          "order": {
            "type": "string",
            "label": "Order",
            "default": "",
            "doc": "The interaction's number, as written or counted."
          }
        },
        "doc": "A statement of the dynamic view this reading shows. No viewpoint draws it: `InteractionLine` does."
      },
      "LiftedRelationship": {
        "label": "Relationship",
        "source": "Element",
        "target": "Element",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "attributes": {
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          }
        },
        "derived": {
          "from": "env.viewpoint in ['systemLandscape', 'systemContext', 'container', 'component'] ? cel.bind(pairs, diagram.relationsOfType('Relationship').map(r, [r, lifted(r, env.viewpoint)]).filter(p, p[1].size() == 2), pairs.filter(p, cel.bind(first, pairs.filter(q, q[1] == p[1])[0], first[1] != [first[0].source, first[0].target])).map(p, p[0])) : []",
          "key": "[lifted(item, env.viewpoint)[0].id, lifted(item, env.viewpoint)[1].id]",
          "id": "lifted(item, env.viewpoint)[0].id + '->' + lifted(item, env.viewpoint)[1].id + '@' + string(item.location().orValue({'line': 0}).line)",
          "source": "lifted(item, env.viewpoint)[0]",
          "target": "lifted(item, env.viewpoint)[1]",
          "attributes": {
            "description": "item.description",
            "technology": "item.technology"
          },
          "sources": "group",
          "reason": "That element is no longer in this model.",
          "doc": "Relationships lifted to the nearest shown ancestor of each end, on a landscape, context, container or component view, and merged: the relationships that land on one pair draw one line, the first one's, with its description and technology and its line in the id. A pair whose first relationship is drawn as itself is not drawn again. No `edits`: the tool offers no menu and no rows on such a line (finding A10)."
        },
        "doc": "A line a view draws for relationships it does not draw as themselves."
      },
      "InstanceLine": {
        "label": "Relationship",
        "source": "Element",
        "target": "Element",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "attributes": {
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          }
        },
        "derived": {
          "from": "env.viewpoint == 'deployment' ? cel.bind(entries, deploymentEntries(), entries.filter(x, !x[5] && entries.filter(y, y[3] == x[3] && y[4] == x[4])[0] == x)) : []",
          "id": "item[3] + '->' + item[4] + '@' + string(item[0].location().orValue({'line': 0}).line)",
          "source": "item[1]",
          "target": "item[2]",
          "attributes": {
            "description": "item[0].description",
            "technology": "item[0].technology"
          },
          "sources": "[item[0]]",
          "reason": "That element is no longer in this model.",
          "doc": "On a deployment view, a relationship between two elements the view does not show, drawn once between every two distinct instances of them, with the relationship's line in the id. No `edits` (finding A10)."
        },
        "doc": "A line a deployment view draws between two instances."
      },
      "InteractionLine": {
        "label": "Interaction",
        "source": "Element",
        "target": "Element",
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "description": {
            "type": "string"
          },
          "order": {
            "type": "string"
          }
        },
        "derived": {
          "from": "env.viewpoint == 'dynamic' ? diagram.relationsOfType('Interaction').filter(i, isMember(i.source, 'dynamic') && isMember(i.target, 'dynamic')) : []",
          "id": "writtenEnd(item, 'source') + '->' + writtenEnd(item, 'target') + '@' + string(item.location().orValue({'line': 0}).line)",
          "source": "item.source",
          "target": "item.target",
          "attributes": {
            "description": "item.description",
            "order": "item.order"
          },
          "sources": "[item]",
          "reason": "That element is no longer in this model.",
          "doc": "A dynamic view's interactions, in their order, each between two shown elements, with its ends as written and its line in the id. No `edits` (finding A10)."
        },
        "doc": "A numbered line of a dynamic view."
      }
    },
    "doc": "The C4 model of one Structurizr DSL workspace, the same in all six C4 definitions: every element kind and every relationship, whichever view a reading shows."
  },
  "notation": {
    "theme": {
      "tokens": {
        "color.person": "#08427b",
        "color.softwareSystem": "#1168bd",
        "color.container": "#438dd5",
        "color.component": "#85bbf0",
        "color.deploymentNode": "#ffffff",
        "color.external": "#999999",
        "color.onDark": "#ffffff",
        "color.onLight": "#000000",
        "color.line": "#8A8880",
        "color.muted": "#6B6A65",
        "color.canvas": "#FFFFFF",
        "font.body": "system-ui, sans-serif"
      },
      "modes": {
        "dark": {
          "color.line": "#B4B2A9",
          "color.muted": "#A9A79E",
          "color.canvas": "#1F1E1C"
        }
      },
      "defaultMode": "light",
      "followSystem": true
    },
    "shapes": {
      "c4Cylinder": {
        "label": "Cylinder",
        "doc": "A data store: a box with an elliptical cap of height 12 at the top and bottom, the top cap drawn before the bottom one.",
        "parts": [
          {
            "id": "side",
            "shape": "rect",
            "box": {
              "x": 0,
              "y": 6,
              "w": "w",
              "h": "h - 12.0"
            },
            "outline": true
          },
          {
            "id": "top",
            "shape": "ellipse",
            "box": {
              "x": 0,
              "y": 0,
              "w": "w",
              "h": 12
            }
          },
          {
            "id": "bottom",
            "shape": "ellipse",
            "box": {
              "x": 0,
              "y": "h - 12.0",
              "w": "w",
              "h": 12
            }
          }
        ]
      }
    },
