atd 0.1
part of w3c/shacl

// The body of a W3C reading and the naming functions every reading shares, in a part of its own (ATD §5.2, §9, §12).

/// A Turtle or N-Triples file, read and written through a declared binding on `w3c-turtle.lark` beside this part, a copy
/// of `specifications/fbl/w3c-turtle.lark`: FBL's grammar family (section 4.9), with no persistence plugin (spec 067,
/// T039, FR-009). One stored `Triple` per triple, one `Prefix` per directive and the `Base`, which every reading of the
/// file shares. A triple reaches up to the subject of the statement or property list around it, its terms read through
/// the file's prefix directives, a blank node by the order of first appearance and a literal unescaped, in the order a
/// construct closes, a member's cell and its `rdf:first` and `rdf:rest` standing in for a collection. Every byte no rule
/// maps is kept. A new triple continues its subject's last statement with `;`, or is a statement of its own at the end of
/// the body when the file has none, and a removed triple takes its separator with it, the whole statement when it is the
/// last (FBL 0.16, spec 067).
binding turtle family grammar {
  label "SHACL shapes in Turtle or N-Triples"
  claims { extensions: [".ttl", ".nt"], origins: ["w3c/shacl"] }
  body {
    kind: file
    start: turtle_doc
    order: closed
    prefixes: {
      declarations: [
        { at: "/statement/prefix_id", name: { node: "PNAME_NS", match: "(?<value>[^:]*):" }, iri: { node: "IRIREF" } },
        { at: "/statement/sparql_prefix", name: { node: "PNAME_NS", match: "(?<value>[^:]*):" }, iri: { node: "IRIREF" } }
      ]
      bases: [{ at: "/statement/base", iri: { node: "IRIREF" } }, { at: "/statement/sparql_base", iri: { node: "IRIREF" } }]
      absolute: "<(?<value>[^>]*)>"
      prefixed: "(?<prefix>[^:<]*):(?<local>.*)"
      local: "(?:[\\pL\\pN_-][\\pL\\pN_.-]*)?[\\pL\\pN_-]"
      terminals: ["PNAME_LN", "PNAME_NS"]
    }
    ordinals: {
      blank: {
        at: ["/**/blank_node/*", "/**/blank_node_property_list", "/**/collection/object"]
        same: BLANK_NODE_LABEL
      }
    }
  }
  grammar from "w3c-turtle.lark"
  text { newline: crlf, indent: 4, finalNewline: true }
  element Base as base at "/statement/base" {
    attribute iri from node "IRIREF" { expand: true }
    readOnly: "The base is written in the file; change it there."
  }
  element Base as sparql-base at "/statement/sparql_base" {
    attribute iri from node "IRIREF" { expand: true }
    readOnly: "The base is written in the file; change it there."
  }
  element Prefix as prefix at "/statement/prefix_id" {
    attribute name from node "PNAME_NS" { match: "(?<value>[^:]*):" }
    attribute iri from node "IRIREF" { match: "<(?<value>[^>]*)>" }
    attribute form from value ('turtle')
    attribute line from value (line)
    insert { place: after-last, container: "/", emit: "@prefix {name}: <{iri}> ." }
    doc: "A directive: its name without its colon, its IRI; written after the last declaration."
  }
  element Prefix as sparql-prefix at "/statement/sparql_prefix" {
    attribute name from node "PNAME_NS" { match: "(?<value>[^:]*):" }
    attribute iri from node "IRIREF" { match: "<(?<value>[^>]*)>" }
    attribute form from value ('sparql')
    attribute line from value (line)
  }
  element Triple as literal at "/**/triples/predicate_object_list/predicate_object/object_list/object" {
    when entry.children[0].type in ['rdf_literal', 'numeric_literal', 'boolean_literal']
    attribute s from node "../../../../subject/iri" {
      expand: true
      map: { empty_collection: "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil" }
      or: [
        { node: "../../../../subject/blank_node/*", ordinal: blank },
        { node: "../../../../subject/collection/object", ordinal: blank },
        { node: "../../../../subject_list/blank_node_property_list", ordinal: blank },
        { node: "../../../../subject/empty_collection", name: true }
      ]
    }
    attribute sKind from node "../../../../*/*" { name: true, map: { iri: "iri", blank_node: "blank", collection: "blank", blank_node_property_list: "blank", empty_collection: "iri" } }
    attribute sLabel from node "../../../../subject/blank_node/BLANK_NODE_LABEL" { match: "_:(?<value>.*)"}
    attribute sWritten from node "../../../../subject/iri"
    attribute p from node "../../verb" { expand: { keywords: { a: "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" } } }
    attribute o from node "rdf_literal/string" {
      match: "(?:\"\"\"|'''|\"|')(?<value>(?s:.*?))(?:\"\"\"|'''|\"|')"
      escape: {
        with: "\\"
        quote: "\""
        sequences: { t: "\t", b: "\b", n: "\n", r: "\r", f: "\f", "'": "'" }
        unicode: { u: 4, U: 8 }
        writes: ["\n", "\r", "\t"]
        requote: "\""
      }
      or: [{ node: "numeric_literal" }, { node: "boolean_literal" }]
    }
    attribute oKind from value ('literal')
    attribute language from node "rdf_literal/LANGTAG" { match: "@(?<value>.*)"}
    attribute datatype from node "rdf_literal/iri" {
      expand: true
      map: {
        INTEGER: "http://www.w3.org/2001/XMLSchema#integer"
        DECIMAL: "http://www.w3.org/2001/XMLSchema#decimal"
        DOUBLE: "http://www.w3.org/2001/XMLSchema#double"
        boolean_literal: "http://www.w3.org/2001/XMLSchema#boolean"
      }
      or: [{ node: "numeric_literal/*", name: true }, { node: "boolean_literal", name: true }]
    }
    attribute line from value (line)
    insert {
      when: "attributes.oKind == 'literal'"
      place: end-of-document
      emit: "\n{s} {p} {o}[@{language}][^^{datatype}] ."
      continues: {
        at: "/triples_statement"
        same: { s: { node: "triples/subject/iri", expand: true } }
        separator: ";"
        emit: "{p} {o}[@{language}][^^{datatype}] ."
      }
    }
    remove { parts: [{ item: ".", separator: "," }, { item: "../..", separator: ";" }], whole: "../../../../.." }
    doc: "A literal object in a statement: `s` reaches up to the statement's subject (FBL 0.15, section 4.9)."
  }
  element Triple as term at "/**/triples/predicate_object_list/predicate_object/object_list/object" {
    when !(entry.children[0].type in ['rdf_literal', 'numeric_literal', 'boolean_literal'])
    attribute s from node "../../../../subject/iri" {
      expand: true
      map: { empty_collection: "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil" }
      or: [
        { node: "../../../../subject/blank_node/*", ordinal: blank },
        { node: "../../../../subject/collection/object", ordinal: blank },
        { node: "../../../../subject_list/blank_node_property_list", ordinal: blank },
        { node: "../../../../subject/empty_collection", name: true }
      ]
    }
    attribute sKind from node "../../../../*/*" { name: true, map: { iri: "iri", blank_node: "blank", collection: "blank", blank_node_property_list: "blank", empty_collection: "iri" } }
    attribute sLabel from node "../../../../subject/blank_node/BLANK_NODE_LABEL" { match: "_:(?<value>.*)"}
    attribute sWritten from node "../../../../subject/iri"
    attribute p from node "../../verb" { expand: { keywords: { a: "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" } } }
    attribute o from node "iri" {
      expand: true
      map: { empty_collection: "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil" }
      or: [
        { node: "blank_node/*", ordinal: blank },
        { node: "collection/object", ordinal: blank },
        { node: "blank_node_property_list", ordinal: blank },
        { node: "empty_collection", name: true }
      ]
    }
    attribute oKind from node "*" { name: true, map: { iri: "iri", blank_node: "blank", collection: "blank", blank_node_property_list: "blank", empty_collection: "iri" } }
    attribute oLabel from node "blank_node/BLANK_NODE_LABEL" { match: "_:(?<value>.*)"}
    attribute line from value (line)
    insert {
      place: end-of-document
      emit: "\n{s} {p} {o} ."
      continues: {
        at: "/triples_statement"
        same: { s: { node: "triples/subject/iri", expand: true } }
        separator: ";"
        emit: "{p} {o} ."
      }
    }
    remove { parts: [{ item: ".", separator: "," }, { item: "../..", separator: ";" }], whole: "../../../../.." }
    doc: "An IRI or blank object in a statement. A blank node is written nowhere: an edit naming one is refused."
  }
  element Triple as nested-literal at "/**/blank_node_property_list/predicate_object_list/predicate_object/object_list/object" {
    when entry.children[0].type in ['rdf_literal', 'numeric_literal', 'boolean_literal']
    attribute s from node "../../../.." { ordinal: blank }
    attribute sKind from value ('blank')
    attribute p from node "../../verb" { expand: { keywords: { a: "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" } } }
    attribute o from node "rdf_literal/string" {
      match: "(?:\"\"\"|'''|\"|')(?<value>(?s:.*?))(?:\"\"\"|'''|\"|')"
      escape: {
        with: "\\"
        quote: "\""
        sequences: { t: "\t", b: "\b", n: "\n", r: "\r", f: "\f", "'": "'" }
        unicode: { u: 4, U: 8 }
        writes: ["\n", "\r", "\t"]
        requote: "\""
      }
      or: [{ node: "numeric_literal" }, { node: "boolean_literal" }]
    }
    attribute oKind from value ('literal')
    attribute language from node "rdf_literal/LANGTAG" { match: "@(?<value>.*)"}
    attribute datatype from node "rdf_literal/iri" {
      expand: true
      map: {
        INTEGER: "http://www.w3.org/2001/XMLSchema#integer"
        DECIMAL: "http://www.w3.org/2001/XMLSchema#decimal"
        DOUBLE: "http://www.w3.org/2001/XMLSchema#double"
        boolean_literal: "http://www.w3.org/2001/XMLSchema#boolean"
      }
      or: [{ node: "numeric_literal/*", name: true }, { node: "boolean_literal", name: true }]
    }
    attribute line from value (line)
  }
  element Triple as nested-term at "/**/blank_node_property_list/predicate_object_list/predicate_object/object_list/object" {
    when !(entry.children[0].type in ['rdf_literal', 'numeric_literal', 'boolean_literal'])
    attribute s from node "../../../.." { ordinal: blank }
    attribute sKind from value ('blank')
    attribute p from node "../../verb" { expand: { keywords: { a: "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" } } }
    attribute o from node "iri" {
      expand: true
      map: { empty_collection: "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil" }
      or: [
        { node: "blank_node/*", ordinal: blank },
        { node: "collection/object", ordinal: blank },
        { node: "blank_node_property_list", ordinal: blank },
        { node: "empty_collection", name: true }
      ]
    }
    attribute oKind from node "*" { name: true, map: { iri: "iri", blank_node: "blank", collection: "blank", blank_node_property_list: "blank", empty_collection: "iri" } }
    attribute oLabel from node "blank_node/BLANK_NODE_LABEL" { match: "_:(?<value>.*)"}
    attribute line from value (line)
  }
  element Triple as first-literal at "/**/collection/object" {
    when entry.children[0].type in ['rdf_literal', 'numeric_literal', 'boolean_literal']
    attribute s from node "." { ordinal: blank }
    attribute sKind from value ('blank')
    attribute p from value ('http://www.w3.org/1999/02/22-rdf-syntax-ns#first')
    attribute o from node "rdf_literal/string" {
      match: "(?:\"\"\"|'''|\"|')(?<value>(?s:.*?))(?:\"\"\"|'''|\"|')"
      escape: {
        with: "\\"
        quote: "\""
        sequences: { t: "\t", b: "\b", n: "\n", r: "\r", f: "\f", "'": "'" }
        unicode: { u: 4, U: 8 }
        writes: ["\n", "\r", "\t"]
        requote: "\""
      }
      or: [{ node: "numeric_literal" }, { node: "boolean_literal" }]
    }
    attribute oKind from value ('literal')
    attribute language from node "rdf_literal/LANGTAG" { match: "@(?<value>.*)"}
    attribute datatype from node "rdf_literal/iri" {
      expand: true
      map: {
        INTEGER: "http://www.w3.org/2001/XMLSchema#integer"
        DECIMAL: "http://www.w3.org/2001/XMLSchema#decimal"
        DOUBLE: "http://www.w3.org/2001/XMLSchema#double"
        boolean_literal: "http://www.w3.org/2001/XMLSchema#boolean"
      }
      or: [{ node: "numeric_literal/*", name: true }, { node: "boolean_literal", name: true }]
    }
    attribute line from value (line)
  }
  element Triple as first-term at "/**/collection/object" {
    when !(entry.children[0].type in ['rdf_literal', 'numeric_literal', 'boolean_literal'])
    attribute s from node "." { ordinal: blank }
    attribute sKind from value ('blank')
    attribute p from value ('http://www.w3.org/1999/02/22-rdf-syntax-ns#first')
    attribute o from node "iri" {
      expand: true
      map: { empty_collection: "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil" }
      or: [
        { node: "blank_node/*", ordinal: blank },
        { node: "collection/object", ordinal: blank },
        { node: "blank_node_property_list", ordinal: blank },
        { node: "empty_collection", name: true }
      ]
    }
    attribute oKind from node "*" { name: true, map: { iri: "iri", blank_node: "blank", collection: "blank", blank_node_property_list: "blank", empty_collection: "iri" } }
    attribute oLabel from node "blank_node/BLANK_NODE_LABEL" { match: "_:(?<value>.*)"}
    attribute line from value (line)
  }
  element Triple as rest at "/**/collection/object/*" {
    attribute s from node ".." { ordinal: blank }
    attribute sKind from value ('blank')
    attribute p from value ('http://www.w3.org/1999/02/22-rdf-syntax-ns#rest')
    attribute o from node "../+" { ordinal: blank, or: [{ value: "'http://www.w3.org/1999/02/22-rdf-syntax-ns#nil'" }] }
    attribute oKind from node "../+" { name: true, map: { object: "blank" }, or: [{ value: "'iri'" }] }
    attribute line from value (line)
    doc: "A collection's rest: each member's entry holds one more, the child of its `object`."
  }
  template "@prefix sh: <http://www.w3.org/ns/shacl#> .\r\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\r\n@prefix ex: <http://example.org/> .\r\n\r\nex:{key}Shape a sh:NodeShape ;\r\n    sh:targetClass ex:{key} ;\r\n    sh:name \"{base}\" ;\r\n    sh:property [\r\n        sh:path ex:name ;\r\n        sh:datatype xsd:string ;\r\n        sh:minCount 1 ;\r\n        sh:maxCount 1 ;\r\n    ] .\r\n"
}

/// Whether an IRI is absolute: a letter, then letters, digits, `+`, `-` or `.`, up to a `:`.
fn rdfAbsolute(iri: string) -> bool {
  return iri.matches('^[A-Za-z][A-Za-z0-9+.-]*:')
}

/// The part of an IRI after its last '#' or '/', or the whole IRI when nothing follows either.
fn rdfLocalName(iri: string) -> string {
  let cut = math.greatest(iri.lastIndexOf('#'), iri.lastIndexOf('/'))
  return cut >= 0 && cut < size(iri) - 1 ? iri.substring(cut + 1) : iri
}

/// Whether `local` may follow a prefix as written: letters, digits, '_', '-' and '.', neither starting nor ending with
/// '.'.
fn rdfCleanLocal(local: string) -> bool {
  return local != '' && !local.startsWith('.') && !local.endsWith('.') && local.matches('^[\\pL\\pN_.-]+$')
}

/// An IRI as the writer spells it: the prefixed name under the longest declared namespace that leaves a clean local
/// name, a later declaration winning a tie, else the bracketed `<iri>`.
fn rdfCompress(iri: string) -> string {
  var namespace = ''
  var prefix = ''
  var found = false
  for declaration in diagram.nodesOfType('Prefix') limit 100000 {
    if iri.startsWith(declaration.iri) && size(iri) != size(declaration.iri) && (!found || size(declaration.iri) >= size(namespace)) {
      namespace = declaration.iri
      prefix = declaration.name
      found = true
    }
  }
  if !found {
    return '<' + iri + '>'
  }
  let local = iri.substring(size(namespace))
  return rdfCleanLocal(local) ? prefix + ':' + local : '<' + iri + '>'
}

/// An IRI as drawn: its prefixed name when it compresses, else its local name.
fn rdfDisplayName(iri: string) -> string {
  let compressed = rdfCompress(iri)
  return compressed.startsWith('<') ? rdfLocalName(iri) : compressed
}

/// What a typed term names, read the way an author writes terms: a full IRI, a bracketed IRI, or a prefixed name under
/// the file's own declarations, the last declaration of a prefix winning; an undeclared prefix is refused by name
/// rather than a declaration invented. The map holds `iri`, '' when the term names nothing, and `refusal`, the
/// sentence saying why.
fn rdfTermResolution(term: string) -> map<string, string> {
  let typed = term.trim()
  if typed == '' {
    return { 'iri': '', 'refusal': 'A term needs a name: a full IRI, or a prefixed name like ex:thing.' }
  }
  if typed.contains(' ') {
    return { 'iri': '', 'refusal': 'An IRI cannot contain spaces.' }
  }
  if size(typed) >= 2 && typed.startsWith('<') && typed.endsWith('>') {
    let inner = typed.substring(1, size(typed) - 1).trim()
    if inner == '' {
      return { 'iri': '', 'refusal': 'The brackets are empty.' }
    }
    return { 'iri': inner, 'refusal': '' }
  }
  if typed.contains('://') {
    return { 'iri': typed, 'refusal': '' }
  }
  let colon = typed.indexOf(':')
  if colon < 0 {
    return {
      'iri': '',
      'refusal': '\'' + typed + '\' is neither a full IRI nor a prefixed name. Write ex:' + typed + ', or a full IRI.'
    }
  }
  let prefix = typed.substring(0, colon)
  let declared = diagram.nodesOfType('Prefix').filter(d, d.name == prefix)
  if size(declared) == 0 {
    return {
      'iri': '',
      'refusal': 'The prefix \'' + prefix + ':\' is not declared in this file. Declare it first, write the full IRI, or bracket a scheme IRI as <' + typed + '>.'
    }
  }
  return { 'iri': declared[size(declared) - 1].iri + typed.substring(colon + 1), 'refusal': '' }
}

/// The full IRI a typed term names; '' when it names nothing.
fn rdfResolveTerm(term: string) -> string {
  return rdfTermResolution(term).iri
}

/// The sentence explaining why `rdfResolveTerm` returned ''.
fn rdfTermRefusal(term: string) -> string {
  return rdfTermResolution(term).refusal
}

/// A prefix declaration typed as `prefix: iri`, brackets tolerated: the map holds `name` and `iri`, both '' when the
/// text is not one (no prefix before the colon, a space in either, or an IRI that is not absolute).
fn rdfPrefixDeclaration(text: string) -> map<string, string> {
  let typed = text.trim()
  let colon = typed.indexOf(':')
  if colon <= 0 {
    return { 'name': '', 'iri': '' }
  }
  let name = typed.substring(0, colon).trim()
  var iri = typed.substring(colon + 1).trim()
  while iri.startsWith('<') limit 100000 {
    iri = iri.substring(1)
  }
  while iri.endsWith('>') limit 100000 {
    iri = iri.substring(0, size(iri) - 1)
  }
  iri = iri.trim()
  let usable = name != '' && iri != '' && !name.contains(' ') && !iri.contains(' ') && iri.matches('^[A-Za-z][A-Za-z0-9+.-]*:')
  return usable ? { 'name': name, 'iri': iri } : { 'name': '', 'iri': '' }
}
