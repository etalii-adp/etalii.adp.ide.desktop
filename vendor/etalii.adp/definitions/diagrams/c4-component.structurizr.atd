atd 0.1
part of c4/component

// The body of a C4 view, in a part of its own (ATD §5.2, §9).

/// A Structurizr DSL workspace (definitions/diagrams/c4-*.dis, c4-container.md), read by the grammar structurizr.lark
/// beside this part, a copy of `specifications/fbl/structurizr.lark`: FBL 0.11's grammar family (section 4.9), one
/// binding shared by six readings. Every C4 specification names 'structurizr.fbl#workspace' as its binding, so a host
/// opens one model and one history per .dsl file however many C4 views of it are open (section 9). Comments are owned
/// and kept wherever they stand; a statement that does not parse is skipped to its line's end, inside blocks too, and a
/// block that is never closed ends at the end of the body (recover). Elements, relationships and the declaration's
/// positional arguments are read by name, quoted or bare, with their escapes; a tags argument holds the tags its text
/// is cut into at its commas (FBL 0.13, split), as Structurizr reads it; an absent argument is written in its place,
/// padded with empty ones. Each view kind is a view of the body, which a reading of any tool type shows, as the module
/// does, and the selected view's include, exclude, title and autoLayout statements, its scope and environment, which the tool types map onto
/// the diagram's attributes, and its interactions are read for it alone. Which elements a view shows, and relationships
/// lifted to the nearest drawn ancestor, are the viewpoint's and DISL's. !include, !script and other directives, styles
/// and properties are unbound statements: kept byte for byte, never followed. This part is
/// `specifications/fbl/structurizr.fbl` in ATD (ATD §11, Appendix C.3), the same in all six C4 descriptions; beyond it,
/// each relationship and interaction also reads its ends as written (`sourceWritten`, `targetWritten`, gap 14), which
/// `writtenEnd` states for the ids and the sentences.
binding structurizr family grammar {
  label "Structurizr DSL workspace"
  claims {
    extensions: [".dsl"],
    origins: ["c4/context", "c4/container", "c4/component", "c4/deployment", "c4/dynamic", "c4/system-landscape"]
  }
  body {
    kind: file,
    recover: { unit: "unit", sync: ["_NL"], nested: { open: "{", close: "}" }, unclosed: { BLOCK_COMMENT: "*/" } }
  }
  grammar from "structurizr.lark"
  text { newline: lf, indent: 4, finalNewline: true }
  registration { legacyLayout: "{base}.layout.json", createOnFirstPlacement: true }

  block systemLandscapeView {
    at: "/workspace/views/system_landscape_view"
    view: { node: "key", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
    insert: {
      place: end,
      container: "/workspace/views",
      emit: "systemLandscape \"{key}\" {\n    include *\n    autoLayout lr\n}"
    }
  }
  block systemLandscapeViewWithoutKey {
    at: "/workspace/views/system_landscape_view_default"
    view: { value: "'landscape'" }
  }
  block systemContextView {
    at: "/workspace/views/system_context_view"
    view: { node: "key", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
    insert: {
      place: end,
      container: "/workspace/views",
      emit: "systemContext {scope} \"{key}\" {\n    include *\n    autoLayout lr\n}"
    }
  }
  block systemContextViewWithoutKey {
    at: "/workspace/views/system_context_view_default"
    view: { value: "'systemcontext'" }
  }
  block containerView {
    at: "/workspace/views/container_view"
    view: { node: "key", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
    insert: {
      place: end,
      container: "/workspace/views",
      emit: "container {scope} \"{key}\" {\n    include *\n    autoLayout lr\n}"
    }
  }
  block containerViewWithoutKey { at: "/workspace/views/container_view_default" view: { value: "'container'" } }
  block componentView {
    at: "/workspace/views/component_view"
    view: { node: "key", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
    insert: {
      place: end,
      container: "/workspace/views",
      emit: "component {scope} \"{key}\" {\n    include *\n    autoLayout lr\n}"
    }
  }
  block componentViewWithoutKey { at: "/workspace/views/component_view_default" view: { value: "'component'" } }
  block dynamicView {
    at: "/workspace/views/dynamic_view"
    view: { node: "key", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
    insert: {
      place: end,
      container: "/workspace/views",
      emit: "dynamic {scope} \"{key}\" {\n    include *\n    autoLayout lr\n}"
    }
  }
  block dynamicViewWithoutKey { at: "/workspace/views/dynamic_view_default" view: { value: "'dynamic'" } }
  block deploymentView {
    at: "/workspace/views/deployment_view"
    view: { node: "key", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
    insert: {
      place: end,
      container: "/workspace/views",
      emit: "deployment {scope} \"{environment}\" \"{key}\" {\n    include *\n    autoLayout lr\n}"
    }
  }
  block deploymentViewWithoutKey {
    at: "/workspace/views/deployment_view_default"
    view: { node: "environment", match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?", escape: { with: "\\", quote: "\"" } }
  }

  /// The workspace's name, which the tool types map onto the diagram's workspaceName.
  element Workspace as workspace at "/workspace" {
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  element Person as person at "/workspace/model/**/person" {
    id from node "identifier"
    attribute identifier from node "identifier" { readOnly: true }
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["name"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    insert { place: end, container: "/workspace/model", emit: "{id} = person \"{name}\" \"{description}\"" }
    remove { cascade: ["relationship"] }
  }

  element SoftwareSystem as softwareSystem at "/workspace/model/**/software_system" {
    id from node "identifier"
    opens: { open: " {", close: "}" }
    attribute identifier from node "identifier" { readOnly: true }
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["name"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    insert { place: end, container: "/workspace/model", emit: "{id} = softwareSystem \"{name}\" \"{description}\"" }
    remove { cascade: ["container", "relationship"] }
  }

  element Container as container at "/workspace/model/**/container" {
    id from node "identifier"
    parent person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance slot containers
    opens: { open: " {", close: "}" }
    attribute identifier from node "identifier" { readOnly: true }
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["name"], pad: true }
    }
    attribute technology from node "technology" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["description", "name"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    insert { place: last-child, emit: "{id} = container \"{name}\" \"{description}\" \"{technology}\"" }
    remove { cascade: ["component", "relationship"] }
  }

  element Component as component at "/workspace/model/**/component" {
    id from node "identifier"
    parent person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance
    opens: { open: " {", close: "}" }
    attribute identifier from node "identifier" { readOnly: true }
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["name"], pad: true }
    }
    attribute technology from node "technology" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["description", "name"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    insert { place: last-child, emit: "{id} = component \"{name}\" \"{description}\" \"{technology}\"" }
    remove { cascade: ["relationship"] }
  }

  element DeploymentNode as deploymentNode at "/workspace/model/**/deployment_node" {
    id from node "identifier"
    parent person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance
    opens: { open: " {", close: "}" }
    attribute identifier from node "identifier" { readOnly: true }
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["name"], pad: true }
    }
    attribute technology from node "technology" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["description", "name"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    remove { cascade: ["relationship"] }
  }

  element InfrastructureNode as infrastructureNode at "/workspace/model/**/infrastructure_node" {
    id from node "identifier"
    parent person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance
    attribute identifier from node "identifier" { readOnly: true }
    attribute name from node "name" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["name"], pad: true }
    }
    attribute technology from node "technology" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["description", "name"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    remove { cascade: ["relationship"] }
  }

  element ContainerInstance as containerInstance at "/workspace/model/**/container_instance" {
    id from node "identifier"
    parent person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance
    attribute identifier from node "identifier" { readOnly: true }
    attribute container from node "instance_of" {
      references container by id
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    remove { cascade: ["relationship"] }
  }

  element SoftwareSystemInstance as softwareSystemInstance at "/workspace/model/**/software_system_instance" {
    id from node "identifier"
    parent person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance
    attribute identifier from node "identifier" { readOnly: true }
    attribute softwareSystem from node "instance_of" {
      references softwareSystem by id
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    remove { cascade: ["relationship"] }
  }

  /// A relationship is read as an entry with two reference attributes, which the tool types map onto a relation, so
  /// that an end that names nothing is kept with that end unset. A relationship written without a source inside an
  /// element's block has that element as its source.
  element Relationship as relationship at "/workspace/model/**/relationship" {
    attribute from from node "source" {
      references person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance by id
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      secondary: { parent: "identifier" }
    }
    attribute to from node "destination" {
      references person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance by id
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["to"], pad: true }
    }
    attribute technology from node "technology" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      empty: keep
      create: { emit: " \"{value}\"", after: ["description", "to"], pad: true }
    }
    attribute tags from node "tags" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      split: ","
      gather: [{
        node: "tags_statement/tag",
        match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
        escape: { with: "\\", quote: "\"" },
        split: ","
      }
      ]
      readOnly: true
    }
    attribute sourceWritten from node "source" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
      secondary: { parent: "identifier" }
    }
    attribute targetWritten from node "destination" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
    insert { place: end, container: "/workspace/model", emit: "{from} -> {to} \"{description}\"" }
    remove {}
  }

  /// The selected view's include statements, which the tool types map onto the diagram's includes.
  element ViewInclude as viewInclude at "/workspace/views/*/include_statement" {
    selectedView: true
    attribute members from node "member" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  element ViewInclude as viewExclude at "/workspace/views/*/exclude_statement" {
    selectedView: true
    attribute excludes from node "member" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  element ViewInclude as viewTitle at "/workspace/views/*/title_statement" {
    selectedView: true
    attribute title from node "title" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  /// autoLayout with no direction lays out top to bottom.
  element ViewInclude as viewAutoLayout at "/workspace/views/*/auto_layout_statement" {
    selectedView: true
    attribute autoLayout from node "direction" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      default: "tb"
      readOnly: true
    }
    attribute rankSeparation from node "rank_separation" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
    attribute nodeSeparation from node "node_separation" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  element ViewInclude as viewScope at "/workspace/views/*/scope" {
    selectedView: true
    attribute scope from node "." {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  element ViewInclude as viewEnvironment at "/workspace/views/*/environment" {
    selectedView: true
    attribute environment from node "." {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  /// A dynamic view's interactions, read for the selected view only.
  element Interaction as interaction at "/workspace/views/*/interaction" {
    selectedView: true
    attribute from from node "source" {
      references person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance by id
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
    }
    attribute to from node "destination" {
      references person, softwareSystem, container, component, deploymentNode, infrastructureNode, containerInstance, softwareSystemInstance by id
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
    }
    attribute description from node "description" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
    attribute sourceWritten from node "source" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
    attribute targetWritten from node "destination" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      readOnly: true
    }
  }

  /// The kind of the selected view, which the tool types map onto the diagram's viewpoint. A rule beyond
  /// `structurizr.fbl`, which says a view's kind by the reading it is for; the cases, recorded from the module, show a
  /// view of any kind in every reading.
  element ViewInclude as viewKind at "/workspace/views/*" {
    selectedView: true
    attribute viewpoint from value({
      'system_landscape_view': 'systemLandscape',
      'system_landscape_view_default': 'systemLandscape',
      'system_context_view': 'systemContext',
      'system_context_view_default': 'systemContext',
      'container_view': 'container',
      'container_view_default': 'container',
      'component_view': 'component',
      'component_view_default': 'component',
      'dynamic_view': 'dynamic',
      'dynamic_view_default': 'dynamic',
      'deployment_view': 'deployment',
      'deployment_view_default': 'deployment'
    }
    [entry.type])
  }

  /// An `!include` the body names, which ADP does not follow: `includeNotFollowed` reports it. A rule beyond
  /// `structurizr.fbl`, which keeps the statement unbound.
  element IncludedFile as includedFile at "/**/directive" {
    when (entry.children[0].text.lowerAscii() == "!include")
    attribute path from node "STRING" {
      match: "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?"
      escape: { with: "\\", quote: "\"" }
      secondary: { node: "WORD", match: "^(?<value>[^/]*(?:/[^/]+)*)(?://.*)?$" }
      readOnly: true
    }
  }

  template {
    text: "workspace \"{base}\" {\n    model {\n        {key} = softwareSystem \"{base}\" \"Describe {base}.\"\n    }\n    views {\n        container {key} \"containers\" {\n            include *\n            autoLayout lr\n        }\n    }\n}\n",
    byOrigin: {
      "c4/context": "workspace \"{base}\" {\n    model {\n        {key} = softwareSystem \"{base}\" \"Describe {base}.\"\n    }\n    views {\n        systemContext {key} \"context\" {\n            include *\n            autoLayout lr\n        }\n    }\n}\n",
      "c4/system-landscape": "workspace \"{base}\" {\n    model {\n        {key} = softwareSystem \"{base}\" \"Describe {base}.\"\n    }\n    views {\n        systemLandscape \"landscape\" {\n            include *\n            autoLayout lr\n        }\n    }\n}\n"
    }
  }
}
