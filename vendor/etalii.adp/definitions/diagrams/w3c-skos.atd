atd 0.1

/// A thesaurus or controlled vocabulary: concepts under their schemes, broader and narrower drawn as a hierarchy,
/// related links across it.
///
/// A reading of a SKOS vocabulary stored as Turtle (`.ttl`) or N-Triples (`.nt`). Every concept scheme, concept and
/// collection the file *asserts* is drawn: schemes head their bands, concepts sit in layers below their broader
/// concepts, `skos:related` and in-file mapping links cross the hierarchy. Nothing is inferred: an edge exists because
/// a triple states it, and the inverse of `skos:broader` is never written back.
///
/// The turtle plugin reads the file into stored `Triple`, `Prefix` and `Base` elements, which every reading of it
/// shares; every node and edge here is derived from them (4.11). Positions are kept in the `.adp` registration beside
/// the file. What this specification cannot express is written down in `w3c-skos.md` beside this file.
diagram w3c/skos version "1.0.0" {
  label "SKOS concept scheme"
  id: "net.etalii.adp.w3c.skos"
  icon: "mdi-file-tree"
  fileExtension: "ttl"
  license: "Apache-2.0"
  homepage: "https://www.w3.org/TR/skos-reference/"
  authors: [{ name: "Peter Vrenken" }]
  limits: {
    maxElements: 1000
    budgets: {
      terms: {
        measure: { count: ["ConceptScheme", "Concept", "Collection"] }
        max: 1000
        order: (skosOrder().indexOf(self.id))
        withhold: { edits: model, reason: { reason: "truncated" } }
        notice: {
          text: ('Showing ' + string(budget('terms').shown) + ' of ' + string(budget('terms').total) + ' terms — edits are withheld on this truncated view')
          severity: warning
          position: top
        }
        doc: "At most 1000 schemes, concepts and collections are drawn, in the order the tool meets the vocabulary, so a cut view is the top of the hierarchy rather than a slice of the file; an edge is drawn only when both its ends are."
      }
    }
  }
  requires: { conformance: standard, features: ["limits.budgets", "persistence.fbl"] }
  doc {
    tags: ["skos", "thesaurus", "taxonomy", "controlled vocabulary", "rdf", "semantic web"]
    seeAlso: [{ title: "W3C SKOS reference", href: "https://www.w3.org/TR/skos-reference/" }, {
      title: "SKOS Play",
      href: "https://skos-play.sparna.fr/"
    }
    ]
  }

  import "w3c-skos.notation.atd"
  import "w3c-skos.turtle.atd"
  requires capability reader.turtle@^1
  requires capability layout.layeredRegions@^1

  /// Only resources the file types `skos:ConceptScheme`, `skos:Concept`, `skos:Collection` or `skos:OrderedCollection`
  /// become elements. Typing is read from `rdf:type` triples with an IRI object and never inferred. The turtle plugin
  /// reads the triples into stored `Triple`, `Prefix` and `Base` elements, which every reading of the file shares;
  /// every node and edge here is derived from them (4.11), in the order the tool meets the vocabulary.
  model {
    document {
      /// The display language labels are chosen in: the registration's `language:` header, lowercased; English when
      /// absent. The binding `turtle` reads it from the registration's headers (`w3c-skos.md`, gap 5).
      attribute language: string readonly default "en" { pattern: "^[a-z]{2,8}(-[a-z0-9]{1,8})*$" }
      /// The line of a `language:` header that stands above a `body:` or `view:` line and is therefore ignored, 0 when
      /// none does; read by the binding `turtle` with the other headers.
      attribute languageLine: int readonly default 0
    }

    /// One label literal: its lexical form and its language tag, lower-cased, '' when untagged.
    datatype LangString {
      fields: { text: { type: "string", required: true }, language: { type: "string", default: "" } }
      display: (value.language == '' ? value.text : value.text + ' @' + value.language)
    }

    /// A mapping triple whose object is not a concept this file types, shown in the property grid rather than drawn.
    datatype OutOfFileMapping {
      fields: { predicate: { type: "MappingKind", required: true }, target: { type: "uri", required: true } }
      display: (value.predicate + ' ' + value.target)
    }

    enum TermKind {
      iri { label: "IRI" }
      blank { label: "Blank node" }
      literal { label: "Literal" }
    }

    enum PrefixForm {
      turtle { label: "@prefix" }
      sparql { label: "PREFIX" }
    }

    /// Which kind of label the drawn name came from.
    enum LabelKind {
      preferred { label: "Preferred label" }
      /// No prefLabel exists in any language, so an altLabel stands in.
      alternate { label: "Alternate label" }
      /// No prefLabel or altLabel exists, so the IRI's local name stands in.
      iriFallback { label: "IRI" }
    }

    /// The five SKOS mapping properties.
    enum MappingKind {
      exactMatch
      closeMatch
      broadMatch
      narrowMatch
      relatedMatch
    }

    /// One triple of the file as the plugin reads it, with the line it starts on. Never drawn: every drawn element is
    /// derived from these.
    element Triple {
      /// The subject: an IRI, or for a blank node its ordinal, the zero-based order of first appearance in this parse.
      attribute s: string required
      attribute sKind: TermKind required
      /// A blank subject's label as written (`_:x` is `x`); '' for an IRI or an anonymous blank node.
      attribute sLabel: string default ""
      /// The subject as written: a prefixed name or a bracketed IRI; '' for a blank node.
      attribute sWritten: string readonly default ""
      attribute p: uri required
      /// The object: an IRI, a blank node's ordinal, or a literal's lexical form.
      attribute o: string required
      attribute oKind: TermKind required
      /// A blank object's label as written; '' otherwise.
      attribute oLabel: string default ""
      attribute language: string default ""
      attribute datatype: string default ""
      /// The 1-based line the triple's subject is written on.
      attribute line: int readonly
    }

    /// One `@prefix` or `PREFIX` directive, re-declarations included, in document order. Never drawn.
    element Prefix {
      /// The prefix without its colon; '' for the default prefix.
      attribute name: string required
      attribute iri: uri required
      attribute form: PrefixForm default "turtle"
      attribute line: int readonly
    }

    /// The file's last `@base` or `BASE` directive; at most one. Never drawn.
    element Base {
      attribute iri: uri required readonly
      multiplicity: { max: 1 }
    }

    /// What schemes, concepts and collections share: an IRI, their labels, notations and documentation properties.
    element Labelled {
      /// The resource's IRI; empty for a blank node.
      ///
      /// Rename through the context menu, so every reference follows the name.
      attribute iri: uri readonly { label: "IRI", group: "Identity" }
      /// The resource is a blank node: drawn, but never positioned or edited.
      attribute blank: bool readonly default false
      /// `skos:prefLabel` literals. Editable per language.
      attribute prefLabel: LangString many { label: "Preferred", group: "Labels" }
      /// `skos:altLabel` literals. Alternate and hidden labels are edited as triples.
      attribute altLabel: LangString many readonly { label: "Alternate", group: "Labels" }
      /// `skos:hiddenLabel` literals; never displayed.
      attribute hiddenLabel: LangString many readonly { label: "Hidden", group: "Labels" }
      /// Labelled through SKOS-XL, which this reading does not resolve; preferred labels then refuse edits.
      attribute xlLabelled: bool readonly default false
      /// `skos:notation` codes in document order; the first is badged on the canvas.
      ///
      /// Notations are codes other systems key off; edit them as triples.
      attribute notation: string many readonly { group: "Identity" }
      /// The first `skos:definition` literal, in any language.
      attribute definition: text { group: "Documentation" }
      attribute scopeNote: text { group: "Documentation" }
      attribute example: text { group: "Documentation" }
      attribute note: text { group: "Documentation" }
      attribute historyNote: text { group: "Documentation" }
      attribute editorialNote: text { group: "Documentation" }
      attribute changeNote: text { group: "Documentation" }
      /// The drawn name, chosen by the label chooser; never recomputed from anything but the file.
      attribute label: string {
        derived: (chooseLabel(self.prefLabel, self.altLabel, diagram.language, self.blank ? '' : rdfLocalName(self.iri)))
      }
      attribute labelTag: string { derived: (chosenTag(self.prefLabel, self.altLabel, diagram.language)) }
      attribute labelKind: LabelKind {
        derived: (size(self.prefLabel) > 0 ? 'preferred' : (size(self.altLabel) > 0 ? 'alternate' : 'iriFallback'))
      }
      abstract: true
      labelAttribute: "label"
    }

    /// A `skos:ConceptScheme`: the head of a band holding the concepts filed in it.
    element ConceptScheme extends Labelled {
      /// Objects of `skos:hasTopConcept` from the scheme plus subjects of `skos:topConceptOf` to it, in document order.
      attribute topConcepts: Concept many readonly { group: "Membership" }
      attribute memberCount: int {
        label: "Members",
        derived: (diagram.nodesOfType('Concept').filter(c, self in c.inScheme).size())
      }
      icon: "mdi-file-tree"
      derived: {
        from: (skosOrder().filter(id, id in skosTyped('http://www.w3.org/2004/02/skos/core#ConceptScheme')))
        key: (item)
        id: (item)
        attributes: {
          iri: (skosNode(item))
          blank: (item.startsWith('blank:'))
          prefLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#prefLabel'))
          altLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#altLabel'))
          hiddenLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#hiddenLabel'))
          xlLabelled: (diagram.nodesOfType('Triple').exists(t, cardId(t.s, t.sKind) == item && t.sKind == 'iri' && t.p in ['http://www.w3.org/2008/05/skos-xl#prefLabel', 'http://www.w3.org/2008/05/skos-xl#altLabel', 'http://www.w3.org/2008/05/skos-xl#hiddenLabel']))
          notation: (diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#notation' && t.oKind == 'literal').map(t, t.o))
          definition: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#definition' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          scopeNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#scopeNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          example: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#example' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          note: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#note' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          historyNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#historyNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          editorialNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#editorialNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          changeNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#changeNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          topConcepts: (skosTops(item).filter(c, c in skosTyped('http://www.w3.org/2004/02/skos/core#Concept')).map(c, diagram.elementById(c)).filter(e, e != null))
        }
        sources: (diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item || (t.oKind != 'literal' && cardId(t.o, t.oKind) == item)))
        reason: "Vocabulary terms are read from the triples; add, rename or remove them through the context menu."
        edits: { delete: "removeResource", rename: "renameResource" }
      }
      doc { rationale: "One registration draws every scheme in the file, each as its own band." }
    }

    /// A `skos:Concept`, drawn once however many broader concepts it has.
    ///
    /// A polyhierarchical concept is placed once, below its deepest broader concept, with one hierarchy edge per
    /// parent.
    element Concept extends Labelled {
      /// Schemes named by `skos:inScheme`, `skos:topConceptOf` or a scheme's `skos:hasTopConcept`, restricted to IRIs
      /// the file types as schemes.
      ///
      /// Membership is stated by triples; file and unfile concepts on the canvas.
      attribute inScheme: ConceptScheme many readonly { label: "In schemes", group: "Membership" }
      /// The mapped concept lives outside this file, so the mapping shows here rather than drawing.
      attribute mappings: OutOfFileMapping many readonly { group: "Mappings" }
      /// The chosen label is in another language than the display language, so the node wears the tag.
      attribute languageChip: bool { derived: (self.labelTag != '' && self.labelTag != diagram.language) }
      /// The schemes the concept's own `skos:inScheme` and `skos:topConceptOf` triples name, as the grid lists them.
      attribute schemesText: string {
        label: "In schemes"
        group: "Membership"
        derived: (cel.bind(s, diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && (t.p == 'http://www.w3.org/2004/02/skos/core#inScheme' || t.p == 'http://www.w3.org/2004/02/skos/core#topConceptOf') && t.oKind == 'iri').map(t, rdfDisplayName(t.o)).distinct(), s.size() > 0 ? s.join(', ') : '(unfiled)'))
      }
      /// Dragging from here files this concept under the one dropped on.
      port file { label: "File under", direction: out, accepts: ["Broader"] }
      /// Dragging from here relates this concept to the one dropped on.
      port relate { label: "Relate", direction: inout, accepts: ["Related"] }
      icon: "mdi-tag-outline"
      derived: {
        from: (skosOrder().filter(id, id in skosTyped('http://www.w3.org/2004/02/skos/core#Concept')))
        key: (item)
        id: (item)
        attributes: {
          iri: (skosNode(item))
          blank: (item.startsWith('blank:'))
          prefLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#prefLabel'))
          altLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#altLabel'))
          hiddenLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#hiddenLabel'))
          xlLabelled: (diagram.nodesOfType('Triple').exists(t, cardId(t.s, t.sKind) == item && t.sKind == 'iri' && t.p in ['http://www.w3.org/2008/05/skos-xl#prefLabel', 'http://www.w3.org/2008/05/skos-xl#altLabel', 'http://www.w3.org/2008/05/skos-xl#hiddenLabel']))
          notation: (diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#notation' && t.oKind == 'literal').map(t, t.o))
          definition: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#definition' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          scopeNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#scopeNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          example: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#example' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          note: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#note' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          historyNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#historyNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          editorialNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#editorialNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          changeNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#changeNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          inScheme: (diagram.nodesOfType('Triple').filter(t, t.oKind != 'literal' && ((cardId(t.s, t.sKind) == item && (t.p == 'http://www.w3.org/2004/02/skos/core#inScheme' || t.p == 'http://www.w3.org/2004/02/skos/core#topConceptOf')) || (t.p == 'http://www.w3.org/2004/02/skos/core#hasTopConcept' && cardId(t.o, t.oKind) == item))).map(t, t.p == 'http://www.w3.org/2004/02/skos/core#hasTopConcept' ? cardId(t.s, t.sKind) : cardId(t.o, t.oKind)).filter(s, s in skosTyped('http://www.w3.org/2004/02/skos/core#ConceptScheme')).distinct().map(s, diagram.elementById(s)).filter(e, e != null))
          mappings: (diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && cardId(t.s, t.sKind) == item && t.p in ['http://www.w3.org/2004/02/skos/core#exactMatch', 'http://www.w3.org/2004/02/skos/core#closeMatch', 'http://www.w3.org/2004/02/skos/core#broadMatch', 'http://www.w3.org/2004/02/skos/core#narrowMatch', 'http://www.w3.org/2004/02/skos/core#relatedMatch'] && t.oKind == 'iri' && !(cardId(t.o, t.oKind) in skosTyped('http://www.w3.org/2004/02/skos/core#Concept'))).map(t, {
            'predicate': t.p.substring(36),
            'target': t.o
          }
          ))
        }
        sources: (diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item || (t.oKind != 'literal' && cardId(t.o, t.oKind) == item)))
        reason: "Vocabulary terms are read from the triples; add, rename or remove them through the context menu."
        edits: { delete: "removeResource", rename: "renameResource" }
      }
    }

    /// A `skos:Collection` or `skos:OrderedCollection`: a labelled grouping, never part of the hierarchy (SKOS S13's
    /// disjoint families).
    element Collection extends Labelled {
      /// Typed `skos:OrderedCollection`; members come from the `skos:memberList` RDF list in list order.
      attribute ordered: bool readonly default false
      /// `skos:member` objects in document order, or the `skos:memberList` walk for an ordered collection.
      attribute members: Concept many readonly { group: "Membership" }
      icon: "mdi-format-list-bulleted"
      derived: {
        from: (skosOrder().filter(id, id in skosTyped('http://www.w3.org/2004/02/skos/core#Collection') || id in skosTyped('http://www.w3.org/2004/02/skos/core#OrderedCollection')))
        key: (item)
        id: (item)
        attributes: {
          iri: (skosNode(item))
          blank: (item.startsWith('blank:'))
          prefLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#prefLabel'))
          altLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#altLabel'))
          hiddenLabel: (skosLabels(item, 'http://www.w3.org/2004/02/skos/core#hiddenLabel'))
          xlLabelled: (diagram.nodesOfType('Triple').exists(t, cardId(t.s, t.sKind) == item && t.sKind == 'iri' && t.p in ['http://www.w3.org/2008/05/skos-xl#prefLabel', 'http://www.w3.org/2008/05/skos-xl#altLabel', 'http://www.w3.org/2008/05/skos-xl#hiddenLabel']))
          notation: (diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#notation' && t.oKind == 'literal').map(t, t.o))
          definition: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#definition' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          scopeNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#scopeNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          example: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#example' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          note: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#note' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          historyNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#historyNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          editorialNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#editorialNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          changeNote: (cel.bind(l, diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#changeNote' && t.oKind == 'literal'), l.size() > 0 ? l[0].o : ''))
          ordered: (item in skosTyped('http://www.w3.org/2004/02/skos/core#OrderedCollection'))
          members: ((item in skosTyped('http://www.w3.org/2004/02/skos/core#OrderedCollection') ? diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#memberList' && t.oKind == 'blank').map(t, collectionMembers(t.o).filter(x, x.oKind != 'literal').map(x, cardId(x.o, x.oKind))).flatten() : diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item && t.p == 'http://www.w3.org/2004/02/skos/core#member' && t.oKind != 'literal').map(t, cardId(t.o, t.oKind))).map(c, diagram.elementById(c)).filter(e, e != null))
        }
        sources: (diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item || (t.oKind != 'literal' && cardId(t.o, t.oKind) == item)))
        reason: "Vocabulary terms are read from the triples; add, rename or remove them through the context menu."
        edits: { delete: "removeResource", rename: "renameResource" }
      }
    }

    /// One edge per (narrower, broader) pair, whether the file states `skos:broader`, `skos:narrower` or both.
    ///
    /// The source is the narrower concept (the subject of `skos:broader`), the target the broader. The inverse is never
    /// synthesised and never written. Drawn without an arrowhead: the layering carries the direction.
    relation Broader from Labelled to Labelled {
      label "Hierarchy"
      /// The pair is stated by more than one triple (both directions, or repeated); disconnecting removes them all as
      /// one undo.
      attribute assertedBothWays: bool readonly default false
      /// Both ends are named, which is what the edge's menu needs to name its triples.
      attribute direct: bool { derived: (self.source.id.startsWith('res:') && self.target.id.startsWith('res:')) }
      directed: true
      allowSelfLoops: true
      allowParallel: false
      derived: {
        from: (skosPairs().filter(p, skosDrawable(p[0]) && skosDrawable(p[1])).map(p, [p[1], p[0], p[2]]))
        key: ([item[0], item[1]])
        id: ('edge:' + item[0] + '|http://www.w3.org/2004/02/skos/core#broader|' + item[1])
        source: (diagram.elementById(item[0]))
        target: (diagram.elementById(item[1]))
        sources: (group.map(g, g[2]))
        reason: "A hierarchy or related link is stated by triples; disconnect it from its menu."
        edits: { delete: "disconnect" }
        attributes: {
          assertedBothWays: (group.map(g, g[2].p).distinct().size() > 1 || group.map(g, cardId(g[2].s, g[2].sKind)).distinct().size() > 1)
        }
        doc: "One edge per pair, keyed `[narrower, broader]` and drawn under the id of the broader-direction triple whichever directions the file asserts, every stating triple among its sources."
      }
      source: { ports: ["file"], role: "narrower" }
      target: { role: "broader" }
    }

    /// `skos:related` between two concepts, in either direction; does not affect layering.
    relation Related from Labelled to Labelled {
      label "Related"
      attribute assertedBothWays: bool readonly default false
      /// Both ends are named, which is what the edge's menu needs to name its triples.
      attribute direct: bool { derived: (self.source.id.startsWith('res:') && self.target.id.startsWith('res:')) }
      directed: false
      allowSelfLoops: true
      allowParallel: false
      derived: {
        from: (diagram.nodesOfType('Triple').filter(t, t.p == 'http://www.w3.org/2004/02/skos/core#related' && t.oKind != 'literal' && skosDrawable(cardId(t.s, t.sKind)) && skosDrawable(cardId(t.o, t.oKind))).map(t, cel.bind(a, cardId(t.s, t.sKind), cel.bind(b, cardId(t.o, t.oKind), a <= b ? [a, b, t] : [b, a, t]))))
        key: ([item[0], item[1]])
        id: ('edge:' + item[0] + '|http://www.w3.org/2004/02/skos/core#related|' + item[1])
        source: (diagram.elementById(item[0]))
        target: (diagram.elementById(item[1]))
        sources: (group.map(g, g[2]))
        reason: "A hierarchy or related link is stated by triples; disconnect it from its menu."
        edits: { delete: "disconnect" }
        attributes: { assertedBothWays: (group.map(g, cardId(g[2].s, g[2].sKind)).distinct().size() > 1) }
        doc: "One edge per unordered pair, from the end whose id sorts first."
      }
      source: { ports: ["relate"] }
    }

    /// A mapping triple whose subject and object are both concepts typed in this file; one edge per triple. Read-only:
    /// no gesture creates one.
    relation Mapping from Concept to Concept {
      label "Mapping"
      attribute predicate: MappingKind required readonly
      /// Both ends are named, which is what the edge's menu needs to name its triples.
      attribute direct: bool { derived: (self.source.id.startsWith('res:') && self.target.id.startsWith('res:')) }
      directed: true
      allowSelfLoops: true
      allowParallel: true
      derived: {
        from: (diagram.nodesOfType('Triple').filter(t, t.p in ['http://www.w3.org/2004/02/skos/core#exactMatch', 'http://www.w3.org/2004/02/skos/core#closeMatch', 'http://www.w3.org/2004/02/skos/core#broadMatch', 'http://www.w3.org/2004/02/skos/core#narrowMatch', 'http://www.w3.org/2004/02/skos/core#relatedMatch'] && t.oKind != 'literal' && cardId(t.s, t.sKind) in skosTyped('http://www.w3.org/2004/02/skos/core#Concept') && cardId(t.o, t.oKind) in skosTyped('http://www.w3.org/2004/02/skos/core#Concept')))
        id: ('edge:' + cardId(item.s, item.sKind) + '|' + item.p + '|' + cardId(item.o, item.oKind))
        source: (diagram.elementById(cardId(item.s, item.sKind)))
        target: (diagram.elementById(cardId(item.o, item.oKind)))
        attributes: { predicate: (item.p.substring(36)) }
        sources: ([item])
        reason: "A mapping is a triple of the file; remove it as a statement."
        edits: { delete: "removeStatement" }
      }
    }
  }

  // ---------------------------------------------------------------- Functions

  /// An `rdf:type` triple with an IRI object: a type, never an edge.
  fn typeTriple(t: Element) -> bool {
    return t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type' && t.oKind == 'iri'
  }

  /// Whether a blank node is a cons cell of an RDF collection: one with an `rdf:first` triple.
  fn isCell(ordinal: string) -> bool {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').exists(t, t.sKind == 'blank' && t.s == ordinal && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first')
  }

  /// A collection's `rdf:first` or `rdf:rest` triple, which is folded into its members and never drawn itself.
  fn isPlumbing(t: Element) -> bool {
    return t.sKind == 'blank' && (t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first' || t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest') && isCell(t.s)
  }

  /// The `rdf:first` triples of the collection starting at `cell`, in order, walked through `rdf:rest` until `rdf:nil`
  /// or a node that is no cons cell.
  fn collectionMembers(cell: string) -> list recursion 64 {
    // uses: ["diagram"]
    return cel.bind(f, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == cell && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#first'), cel.bind(r, diagram.nodesOfType('Triple').filter(t, t.sKind == 'blank' && t.s == cell && t.p == 'http://www.w3.org/1999/02/22-rdf-syntax-ns#rest'), f.size() == 0 ? [] : [f[0]] + (r.size() > 0 && r[0].oKind == 'blank' && isCell(r[0].o) ? collectionMembers(r[0].o) : [])))
  }

  /// The repeat counter of a stored triple or prefix declaration (11.5.2): '' for the first with its parts, '|1' for
  /// the second and so on, in reading order.
  fn repeatSuffix(e: Element) -> string {
    // uses: ["diagram"]
    return cel.bind(same, e.isA('Triple') ? diagram.nodesOfType('Triple').filter(u, u.s == e.s && u.p == e.p && u.o == e.o) : diagram.nodesOfType('Prefix').filter(u, u.name == e.name), cel.bind(n, e.positionIn(same), n > 0 ? '|' + string(n) : ''))
  }

  /// Each item of `xs`, whose first entry is its key, with the number of earlier items of the same key appended: the
  /// repeat counter of a derived edge id (11.5.2), 0 for the first.
  fn withRepeat(xs: list) -> list {
    return lists.range(xs.size()).map(i, xs[i] + [lists.range(i).filter(j, xs[j][0] == xs[i][0]).size()])
  }

  /// The id of the card the RDF graph reading draws a subject or object term as.
  fn cardId(term: string, kind: string) -> string {
    return (kind == 'blank' ? 'blank:' : 'res:') + term
  }

  /// The terms a triple draws an RDF graph card for, in the order the tool meets them: its subject, then its object or
  /// its collection's members, each with its kind, its written label and the triple. A type's IRI and a literal are no
  /// card; a cons cell is folded away.
  fn cardTerms(t: Element) -> list {
    // uses: ["diagram"]
    return isPlumbing(t) ? [] : ([[t.s, t.sKind, t.sLabel, t]] + (typeTriple(t) || t.oKind == 'literal' ? [] : (t.oKind == 'blank' && isCell(t.o) ? collectionMembers(t.o).filter(m, m.oKind != 'literal').map(m, [m.o, m.oKind, m.oLabel, t]) : [[t.o, t.oKind, t.oLabel, t]])))
  }

  /// Whether the RDF graph reading of this body is cut by its budget of 1000 cards. Every reading withholds its edits
  /// while it is, because the tool gates every reading's edits on that one count.
  fn familyTruncated() -> bool {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').map(t, cardTerms(t)).flatten().map(c, cardId(c[0], c[1])).distinct().size() > 1000
  }

  /// The texts of the labels carrying exactly one language tag ('' for untagged), ordinally sorted, so the first one is
  /// the S14 tie-break.
  fn textsIn(labels: list, tag: string) -> list {
    return labels.filter(l, l.language == tag).map(l, l.text).sort()
  }

  /// The language tag the chooser settles on within one label kind: the display language, then English, then untagged,
  /// then the ordinally smallest remaining tag.
  fn tagFor(labels: list, display: string) -> string {
    return size(textsIn(labels, display)) > 0 ? display : (size(textsIn(labels, 'en')) > 0 ? 'en' : (size(textsIn(labels, '')) > 0 ? '' : (size(labels) > 0 ? labels.map(l, l.language).filter(t, t != '').sort()[0] : '')))
  }

  /// The one name a scheme, concept or collection is drawn with: a preferred label in any language beats every
  /// alternate label; the IRI's local name stands in when neither exists. Hidden labels never display.
  fn chooseLabel(pref: list, alt: list, display: string, fallback: string) -> string {
    return size(pref) > 0 ? textsIn(pref, tagFor(pref, display))[0] : (size(alt) > 0 ? textsIn(alt, tagFor(alt, display))[0] : fallback)
  }

  /// The language tag of the chosen label, or '' for an untagged label or the IRI fallback.
  fn chosenTag(pref: list, alt: list, display: string) -> string {
    return size(pref) > 0 ? tagFor(pref, display) : (size(alt) > 0 ? tagFor(alt, display) : '')
  }

  /// The ids of every term the file types as `type`, in document order: `res:` and the IRI, or `blank:` and the
  /// ordinal.
  fn skosTyped(type: string) -> list {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').filter(t, typeTriple(t) && t.o == type && t.sKind != 'literal').map(t, cardId(t.s, t.sKind)).distinct()
  }

  /// Whether the id is a concept, scheme or collection, the only terms this reading draws.
  fn skosDrawable(id: string) -> bool {
    // uses: ["diagram"]
    return id in skosTyped('http://www.w3.org/2004/02/skos/core#Concept') || id in skosTyped('http://www.w3.org/2004/02/skos/core#ConceptScheme') || id in skosTyped('http://www.w3.org/2004/02/skos/core#Collection') || id in skosTyped('http://www.w3.org/2004/02/skos/core#OrderedCollection')
  }

  /// Whether the file files the term in the scheme: `skos:inScheme`, `skos:topConceptOf`, or the scheme's
  /// `skos:hasTopConcept`.
  fn skosMember(id: string, scheme: string) -> bool {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').exists(t, t.oKind != 'literal' && ((cardId(t.s, t.sKind) == id && cardId(t.o, t.oKind) == scheme && (t.p == 'http://www.w3.org/2004/02/skos/core#inScheme' || t.p == 'http://www.w3.org/2004/02/skos/core#topConceptOf')) || (t.p == 'http://www.w3.org/2004/02/skos/core#hasTopConcept' && cardId(t.s, t.sKind) == scheme && cardId(t.o, t.oKind) == id)))
  }

  /// The scheme's asserted top concepts, either direction, in document order.
  fn skosTops(scheme: string) -> list {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').filter(t, t.oKind != 'literal' && ((t.p == 'http://www.w3.org/2004/02/skos/core#topConceptOf' && cardId(t.o, t.oKind) == scheme) || (t.p == 'http://www.w3.org/2004/02/skos/core#hasTopConcept' && cardId(t.s, t.sKind) == scheme))).map(t, t.p == 'http://www.w3.org/2004/02/skos/core#topConceptOf' ? cardId(t.s, t.sKind) : cardId(t.o, t.oKind)).distinct()
  }

  /// Every hierarchy assertion as `[broader, narrower, triple]`, in document order: `n skos:broader b` and `b
  /// skos:narrower n` alike.
  fn skosPairs() -> list {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').filter(t, (t.p == 'http://www.w3.org/2004/02/skos/core#broader' || t.p == 'http://www.w3.org/2004/02/skos/core#narrower') && t.oKind != 'literal').map(t, t.p == 'http://www.w3.org/2004/02/skos/core#broader' ? [cardId(t.o, t.oKind), cardId(t.s, t.sKind), t] : [cardId(t.s, t.sKind), cardId(t.o, t.oKind), t])
  }

  /// The narrower ends of every hierarchy pair whose broader end is the id.
  fn skosChildren(id: string) -> list {
    // uses: ["diagram"]
    return skosPairs().filter(p, p[0] == id).map(p, p[1]).distinct()
  }

  /// The concepts filed in the scheme.
  fn skosConcepts(scheme: string) -> list {
    // uses: ["diagram"]
    return skosTyped('http://www.w3.org/2004/02/skos/core#Concept').filter(c, skosMember(c, scheme))
  }

  /// The scheme's concepts breadth first by layer, each layer in ordinal order, appended to `seen` without repeats.
  fn skosLayers(scheme: string, layer: list, seen: list) -> list recursion 64 {
    // uses: ["diagram"]
    return layer.size() == 0 ? seen : cel.bind(taken, (seen + layer.filter(id, skosDrawable(id) && (skosMember(id, scheme) || id in skosTops(scheme)))).distinct(), skosLayers(scheme, layer.map(id, skosChildren(id)).flatten().filter(c, skosMember(c, scheme) && skosDrawable(c) && !(c in taken)).distinct().sort(), taken))
  }

  /// Each scheme in ordinal order, then its top concepts and broaderless members and their descendants breadth first,
  /// then the members no layer reached.
  fn skosWalk(schemes: list, i: int, seen: list) -> list recursion 64 {
    // uses: ["diagram"]
    return i >= schemes.size() ? seen : cel.bind(s, schemes[i], cel.bind(members, skosConcepts(s), cel.bind(after, skosLayers(s, (skosTops(s) + members.filter(m, !skosPairs().exists(p, p[1] == m && p[0] in members))).distinct().sort(), (seen + [s]).distinct()), skosWalk(schemes, i + 1, (after + members.sort()).distinct()))))
  }

  /// The order the tool meets the vocabulary in, which is the order its budget cuts: schemes with their hierarchies,
  /// then unfiled concepts, then collections, ties by id.
  fn skosOrder() -> list {
    // uses: ["diagram"]
    return (skosWalk(skosTyped('http://www.w3.org/2004/02/skos/core#ConceptScheme').sort(), 0, []) + skosTyped('http://www.w3.org/2004/02/skos/core#Concept').sort() + (skosTyped('http://www.w3.org/2004/02/skos/core#Collection') + skosTyped('http://www.w3.org/2004/02/skos/core#OrderedCollection')).distinct().sort()).distinct()
  }

  /// The label literals of one kind, in document order, their tags lowercased.
  fn skosLabels(id: string, predicate: string) -> list {
    // uses: ["diagram"]
    return diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == id && t.p == predicate && t.oKind == 'literal').map(t, {
      'text': t.o,
      'language': t.language.lowerAscii()
    }
    )
  }

  /// The IRI an id names, or '' for a blank node.
  fn skosNode(id: string) -> string {
    return id.startsWith('res:') ? id.substring(4) : ''
  }

  /// An id's IRI after its last '#' or '/', as the findings name a term.
  fn skosShort(id: string) -> string {
    return cel.bind(iri, id.startsWith('res:') ? id.substring(4) : id, cel.bind(cut, math.greatest(iri.lastIndexOf('#'), iri.lastIndexOf('/')), cut >= 0 && cut < iri.size() - 1 ? iri.substring(cut + 1) : iri))
  }

  /// A term as the findings name it: a concept by its label chosen for English, anything else by its short IRI.
  fn skosFindingName(id: string) -> string {
    // uses: ["diagram"]
    return id in skosTyped('http://www.w3.org/2004/02/skos/core#Concept') ? chooseLabel(skosLabels(id, 'http://www.w3.org/2004/02/skos/core#prefLabel'), skosLabels(id, 'http://www.w3.org/2004/02/skos/core#altLabel'), 'en', skosShort(id)) : skosShort(id)
  }

  /// Every term reachable down the drawn hierarchy from the frontier.
  fn skosReached(frontier: list, seen: list) -> list recursion 64 {
    // uses: ["diagram"]
    return frontier.size() == 0 ? seen : cel.bind(more, frontier.filter(id, !(id in seen)), skosReached(more.map(id, skosChildren(id).filter(c, skosDrawable(c))).flatten().distinct(), (seen + more).distinct()))
  }

  // ---------------------------------------------------------------- Constraints

  /// What makes a vocabulary lie, all by assertion: no inference, no network. The five `rdf.*` findings are the
  /// plugin's, raised as it reads the body and shared by every reading (FBL 9.1); a parse failure replaces every other
  /// finding. `skos.misplaced-header` reads the line the binding `turtle` reports for a `language:` header that the
  /// registration's headers sever.
  constraints {
    builtin std.unparseable { code: "rdf.unparseable", message: ('This is not RDF that can be read: ' + detail.reason) }

    /// One finding per knot of the drawn hierarchy, its members named in id order, at the first triple stating one of
    /// its edges.
    constraint hierarchyCycle for diagram {
      label "Hierarchy cycle"
      severity error
      message ('The broader/narrower hierarchy runs in a circle through ' + item.map(c, c.id).sort().map(id, skosFindingName(id)).join(', ') + '. The diagram draws every edge and breaks the circle for layering only.')
      code: "skos.hierarchy-cycle"
      forEach: (diagram.knots('Broader'))
      cost: expensive
      location: ({
        'line': diagram.relationsOfType('Broader').filter(r, r.source in item && r.target in item)[0].sources[0].line
      }
      )
    }

    constraint duplicatePrefLabel for diagram {
      label "Duplicate preferred label"
      severity error
      message (skosFindingName(item[0].id) + ' has ' + string(item[0].prefLabel.filter(l, l.language == item[1]).size()) + ' preferred labels with ' + (item[1] == '' ? 'no language tag' : "language '" + item[1] + "'") + '; SKOS allows one (S14). The lexicographically first is drawn.')
      code: "skos.duplicate-preflabel"
      forEach: (diagram.nodesOfType('Concept').map(c, c.prefLabel.map(l, l.language).distinct().filter(lang, c.prefLabel.filter(l, l.language == lang).size() > 1).map(lang, [c, lang])).flatten())
      location: ({
        'line': diagram.nodesOfType('Triple').filter(t, cardId(t.s, t.sKind) == item[0].id && t.p == 'http://www.w3.org/2004/02/skos/core#prefLabel' && t.oKind == 'literal' && t.language.lowerAscii() == item[1])[0].line
      }
      )
    }

    constraint missingPrefLabel for Concept {
      label "Missing preferred label"
      rule size(self.prefLabel) > 0
      severity warning
      message (skosFindingName(self.id) + ' has no skos:prefLabel in any language, so the diagram falls back to ' + (size(self.altLabel) + size(self.hiddenLabel) > 0 ? 'an alternate label' : 'its IRI') + '.')
      code: "skos.missing-preflabel"
    }

    /// Only the direct case: the transitive one would need inference.
    constraint relatedOverlap for Related {
      label "Related and hierarchy-linked"
      rule !diagram.relationsOfType('Broader').exists(b, (b.source == self.source && b.target == self.target) || (b.source == self.target && b.target == self.source))
      severity warning
      message (skosFindingName(self.source.id) + ' and ' + skosFindingName(self.target.id) + ' are both hierarchy-linked and skos:related, which SKOS S27 forbids. Only this direct case is checked: the transitive case would need inference, which this diagram never does.')
      code: "skos.related-overlap"
      location: ({ 'line': self.sources[0].line })
    }

    constraint unfiledConcept for Concept {
      label "Unfiled concept"
      rule size(self.inScheme) > 0 || self.id in skosReached(diagram.nodesOfType('ConceptScheme').map(s, skosTops(s.id)).flatten(), [])
      severity info
      message (skosShort(self.iri) + ' is in no concept scheme and under no top concept - legal SKOS, and usually a mistake. It draws in the unfiled band.')
      code: "skos.unfiled-concept"
    }

    constraint nonConceptTarget for diagram {
      label "Not typed skos:Concept"
      severity warning
      message (skosShort(item[1]) + ' takes part in a ' + rdfDisplayName(item[0].p) + ' assertion but is not typed skos:Concept. Typing is never inferred, so only the file\'s own silence is reported.')
      code: "skos.nonconcept-target"
      forEach: (diagram.nodesOfType('Triple').map(t, (t.p in ['http://www.w3.org/2004/02/skos/core#broader', 'http://www.w3.org/2004/02/skos/core#narrower', 'http://www.w3.org/2004/02/skos/core#related'] ? [[t, cardId(t.s, t.sKind)], [t, cardId(t.o, t.oKind)]] : (t.p in ['http://www.w3.org/2004/02/skos/core#inScheme', 'http://www.w3.org/2004/02/skos/core#topConceptOf'] ? [[t, cardId(t.s, t.sKind)]] : (t.p == 'http://www.w3.org/2004/02/skos/core#hasTopConcept' ? [[t, cardId(t.o, t.oKind)]] : []))).filter(x, x[0].oKind != 'literal' || x[1] == cardId(x[0].s, x[0].sKind))).flatten().filter(x, !(x[1] in skosTyped('http://www.w3.org/2004/02/skos/core#Concept'))))
      location: ({ 'line': item[0].line })
    }

    constraint xlLabels for diagram {
      label "SKOS-XL labels"
      rule !diagram.nodesOfType('Triple').exists(t, t.p in ['http://www.w3.org/2008/05/skos-xl#prefLabel', 'http://www.w3.org/2008/05/skos-xl#altLabel', 'http://www.w3.org/2008/05/skos-xl#hiddenLabel'])
      severity info
      message "This file labels concepts through SKOS-XL, which this reading does not resolve; the plain-SKOS fallbacks apply (Requirement 3.6)."
      code: "skos.xl-labels"
    }

    constraint misplacedHeader for diagram {
      label "Misplaced language header"
      rule diagram.languageLine == 0
      severity warning
      message ('The registration\'s language: header (line ' + string(diagram.languageLine) + ') sits above a body: or view: line, where core\'s header scan would stop before reaching them. It is ignored; move it below body:/view: and above layout:.')
      code: "skos.misplaced-header"
    }
  }

  // ---------------------------------------------------------------- Operations

  /// The truncation gate: one sentence, shown on every withheld gesture, menu entry and property row. Today every
  /// reading gates its edits on the RDF graph reading's count of cards, not on its own drawn count, so this reason
  /// reads that count.
  reason truncated {
    when familyTruncated()
    message "The diagram shows only the first part of this file under the drawn-element budget, so edits through it are withheld - an edit through a partial view could touch what the view does not show. Edit the file as text instead."
  }

  message std.notApplicable('\'' + operationId + '\' does not apply to this selection.')

  /// Writes one triple, `{iri} a rdfs:Resource`; the card follows from it.
  operation addResource "Add resource here…" for diagram {
    param iri: string required { label: "IRI or prefixed name" }
    icon: "mdi-card-plus-outline"
    paramsForm: "addResourceDialog"
    if rdfResolveTerm(p.iri) == '' {
      fail rdfTermRefusal(p.iri)
    }
    create Triple {
      s: rdfResolveTerm(p.iri),
      sKind: 'iri',
      p: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type',
      o: 'http://www.w3.org/2000/01/rdf-schema#Resource',
      oKind: 'iri'
    }
  }

  /// Writes one `@prefix` directive from `prefix: iri`, brackets tolerated: a new stored `Prefix`, which the binding
  /// `turtle` writes after the last declaration (`w3c-rdf.md`, gap 2).
  operation declarePrefix "Declare prefix…" for diagram {
    param declaration: string required { label: "Declaration, e.g. ex: http://example.org/" }
    icon: "mdi-at"
    paramsForm: "declarePrefixDialog"
    let declared = rdfPrefixDeclaration(p.declaration)
    if declared.name == '' {
      fail 'Write the declaration as \'prefix: iri\', e.g. ex: http://example.org/.'
    }
    create Prefix { name: declared.name, iri: declared.iri }
  }

  /// Rewrites every token that names the IRI, in subject, predicate, object and datatype position: every stored triple
  /// naming it is changed in one edit, which the binding `turtle` writes token by token, bracketed or prefixed under the
  /// prefixes in force where each stands (`w3c-rdf.md`, gap 2). A name that is already in use is refused, since the
  /// rename would merge two resources.
  operation renameResource "Rename…" for Labelled {
    param newName: string required { label: "New IRI or prefixed name" }
    paramsForm: "renameDialog"
    let renamed = rdfResolveTerm(p.newName)
    if renamed == '' {
      fail rdfTermRefusal(p.newName)
    }
    if diagram.nodesOfType('Triple').exists(t, (t.sKind == 'iri' && t.s == renamed) || (t.oKind == 'iri' && t.o == renamed)) {
      fail renamed + ' already names something in this document; renaming onto it would silently merge two resources.'
    }
    for t in diagram.nodesOfType('Triple') limit 100000 {
      if t.sKind == 'iri' && t.s == self.iri {
        set t.s = renamed
      }
      if t.p == self.iri {
        set t.p = renamed
      }
      if t.oKind == 'iri' && t.o == self.iri {
        set t.o = renamed
      }
      if t.oKind == 'literal' && t.datatype == self.iri {
        set t.datatype = renamed
      }
    }
  }

  /// Removes every triple whose subject or object is the IRI; the element disappears on recomputation. A resource in
  /// one statement goes without a question.
  operation removeResource for Labelled {
    label (self.sources.size() == 1 ? 'Remove' : 'Remove (with ' + string(self.sources.size()) + ' statements)')
    confirm {
      count: (self.sources.size())
      threshold: 2
      title: "Remove resource"
      message: ('Removing this resource also removes the ' + string(count) + ' statements it appears in.')
      confirmLabel: "Remove"
      danger: true
    }
    delete self.sources
  }

  operation removeStatement "Remove statement" for Mapping {
    delete self.sources
  }

  operation relate "Relate…" for diagram {
    param from: Labelled required
    param to: Labelled required
    param predicate: string required { label: "Predicate (IRI or prefixed name)" }
    icon: "mdi-ray-start-arrow"
    paramsForm: "relateDialog"
    if p.from.blank || p.to.blank {
      fail 'A blank node\'s identity does not survive a reparse, so relations to it cannot land in the file. Name it with an IRI first.'
    }
    if rdfResolveTerm(p.predicate) == '' {
      fail rdfTermRefusal(p.predicate)
    }
    create Triple { s: p.from.iri, sKind: 'iri', p: rdfResolveTerm(p.predicate), o: p.to.iri, oKind: 'iri' }
  }

  /// Rewrites the lexical form of the first `rdfs:label` literal, keeping its language and datatype, or adds a plain
  /// one when there is none.
  operation setLabel "Label" for Labelled {
    param value: string required
    if diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal').size() > 0 {
      let target = diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#label' && t.oKind == 'literal')[0]
      set target.o = p.value
    } else {
      create Triple {
        s: self.iri,
        sKind: 'iri',
        p: 'http://www.w3.org/2000/01/rdf-schema#label',
        o: p.value,
        oKind: 'literal'
      }
    }
  }

  /// Rewrites the lexical form of the first `rdfs:comment` literal, keeping its language and datatype, or adds a plain
  /// one when there is none.
  operation setComment "Comment" for Labelled {
    param value: string required
    if diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal').size() > 0 {
      let target = diagram.nodesOfType('Triple').filter(t, t.sKind == 'iri' && t.s == self.iri && t.p == 'http://www.w3.org/2000/01/rdf-schema#comment' && t.oKind == 'literal')[0]
      set target.o = p.value
    } else {
      create Triple {
        s: self.iri,
        sKind: 'iri',
        p: 'http://www.w3.org/2000/01/rdf-schema#comment',
        o: p.value,
        oKind: 'literal'
      }
    }
  }

  /// Writes the concept's type, its preferred label tagged with the default display language, and its filing into the
  /// file's first scheme, as one edit.
  operation addConcept "Add concept here…" for diagram {
    param label: string required { label: "Preferred label" }
    icon: "mdi-tag-plus-outline"
    paramsForm: "addConceptDialog"
    let iri = rdfMintIri(p.label.trim())
    let scheme = diagram.nodesOfType('Triple').filter(t, typeTriple(t) && t.o == 'http://www.w3.org/2004/02/skos/core#ConceptScheme' && t.sKind == 'iri').map(t, t.s)
    create Triple {
      s: iri,
      sKind: 'iri',
      p: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#type',
      o: 'http://www.w3.org/2004/02/skos/core#Concept',
      oKind: 'iri'
    }
    create Triple {
      s: iri,
      sKind: 'iri',
      p: 'http://www.w3.org/2004/02/skos/core#prefLabel',
      o: p.label.trim(),
      oKind: 'literal',
      language: 'en'
    }
    if scheme.size() > 0 {
      create Triple {
        s: iri,
        sKind: 'iri',
        p: 'http://www.w3.org/2004/02/skos/core#inScheme',
        o: scheme[0],
        oKind: 'iri'
      }
    }
  }

  /// One `skos:broader` triple on the dragged concept, naming the one dropped on; the inverse is never written.
  operation fileUnder "File under (broader)" for diagram {
    param from: Concept required
    param to: Concept required
    icon: "mdi-file-tree"
    if p.from.id == p.to.id {
      fail 'A concept cannot be filed under or related to itself.'
    }
    create Triple {
      s: p.from.iri,
      sKind: 'iri',
      p: 'http://www.w3.org/2004/02/skos/core#broader',
      o: p.to.iri,
      oKind: 'iri'
    }
  }

  /// One `skos:related` triple from the dragged concept to the one dropped on.
  operation relateConcepts "Relate (skos:related)" for diagram {
    param from: Concept required
    param to: Concept required
    icon: "mdi-swap-horizontal"
    if p.from.id == p.to.id {
      fail 'A concept cannot be filed under or related to itself.'
    }
    create Triple {
      s: p.from.iri,
      sKind: 'iri',
      p: 'http://www.w3.org/2004/02/skos/core#related',
      o: p.to.iri,
      oKind: 'iri'
    }
  }

  /// Removes every triple that states the pair, as one edit.
  operation disconnect for Broader, Related {
    label (self.isA('Related') ? 'Remove related link' : (self.sources.size() > 1 ? 'Disconnect (both directions)' : 'Disconnect'))
    confirm {
      count: (self.sources.size())
      threshold: 2
      title: "Disconnect"
      message: "This pair is asserted in both directions; disconnecting removes both statements as one undo."
      confirmLabel: "Disconnect"
      danger: false
    }
    delete self.sources
  }

  /// An edit writes triples, and every node and edge follows from recomputation; no hook fires for a derived element.
  behavior { editGate: [{ reason: "truncated" }] }

  // ---------------------------------------------------------------- Persistence

  /// The RDF file itself is the model, read and written through the module's FBL binding and the turtle plugin;
  /// positions live in the `.adp` registration, keyed by element id.
  persistence {
    format: fbl
    ids: {
      strategy: natural
      stable: false
      types: {
        Triple: {
          strategy: derived
          expression: ('triple:' + self.s + '|' + self.p + '|' + self.o + repeatSuffix(self))
          ephemeral: (self.sKind == 'blank' || self.oKind == 'blank')
          doc: "A triple by its three parts and a repeat counter. One that names a blank node is ephemeral, since the blank's label is the parse's own."
        }
        Prefix: {
          strategy: derived
          expression: ('prefix:' + self.name + repeatSuffix(self))
          doc: "A declaration by its prefix and a repeat counter for a re-declaration."
        }
        Base: { strategy: derived, expression: ('base'), doc: "A fixed singleton id." }
        ConceptScheme: {
          ephemeral: (self.blank)
          reason: "That is a blank node, whose identity does not survive a reparse, so a stored position could not be trusted. Name it with an IRI to arrange it."
          doc: "A blank-node term's id restarts with every parse; a named term's is its IRI."
        }
        Concept: {
          ephemeral: (self.blank)
          reason: "That is a blank node, whose identity does not survive a reparse, so a stored position could not be trusted. Name it with an IRI to arrange it."
          doc: "A blank-node term's id restarts with every parse; a named term's is its IRI."
        }
        Collection: {
          ephemeral: (self.blank)
          reason: "That is a blank node, whose identity does not survive a reparse, so a stored position could not be trusted. Name it with an IRI to arrange it."
          doc: "A blank-node term's id restarts with every parse; a named term's is its IRI."
        }
      }
      pattern: "^(res:.+|blank:[0-9]+|edge:.+|triple:.+|prefix:.*|base|truncation)$"
    }
    view: { store: [bounds], styleOverrides: none }
  }

  plugin net.etalii.adp.w3c.turtle {
    version: "^0.1.0"
    required: true
    provides: [persistenceFormat, celFunctions, action]
    plans: [add, set, remove]
    doc "The RDF family's engine: it reads a `.ttl` or `.nt` body into the stored `Triple`, `Prefix` and `Base` elements and the five `rdf.*` findings, plans the splices of an added, set or removed triple, carries out the two edits that are not a change of one triple (renaming a term everywhere it is written, declaring a prefix; gap 2 of `w3c-rdf.md`), and provides the naming functions. Every function is called by its bare name. This description states the reading and the planning as the binding `turtle` (w3c-skos.turtle.atd), whose family is the capability `reader.turtle`, the two edits as model changes the binding writes, and the functions as the script functions of the same names; the plugin stays declared for the hosts that run the JSON files."
  }

  x-skos: {
    doc: "Today's wire ids, which the standalone client and backend share, mapped from this specification's names. A tool is keyed by its id, an action by its operation, a property by its form item's id; a label row's id names its kind and language, a documentation row's its property, a mapping row's its predicate and target."
    tools: { concept: { id: "skos.toolbox.concept", drop: "skos.add-concept" } }
    actions: {
      addResource: "rdf.add-resource"
      declarePrefix: "rdf.add-prefix"
      relate: "rdf.connect"
      renameResource: "rdf.rename-resource"
      removeResource: "rdf.remove-resource"
      removeStatement: "rdf.remove-edge"
      addConcept: "skos.add-concept"
      fileUnder: "skos.file-under"
      relateConcepts: "skos.relate"
      disconnect: "skos.disconnect"
    }
    properties: {
      iri: "skos.iri"
      notation: "skos.notation"
      prefLabel: "skos.label:prefLabel:{language}"
      altLabel: "skos.label:altLabel:{language}"
      hiddenLabel: "skos.label:hiddenLabel:{language}"
      definition: "skos.doc:definition"
      scopeNote: "skos.doc:scopeNote"
      example: "skos.doc:example"
      note: "skos.doc:note"
      historyNote: "skos.doc:historyNote"
      editorialNote: "skos.doc:editorialNote"
      changeNote: "skos.doc:changeNote"
      schemes: "skos.schemes"
      mappings: "skos.mapping:{predicate}:{target}"
    }
  }

  x-adp: {
    origin: "w3c/skos"
    state: "prototype"
    extensions: [".ttl", ".nt"]
    claimsBareFiles: false
    suggestWhenBodyContains: ["skos:ConceptScheme", "http://www.w3.org/2004/02/skos/core#ConceptScheme"]
    registrationHeaders: { language: "The display language; after body:/view:, before layout:." }
    family: ["w3c/rdf", "w3c/owl", "w3c/skos", "w3c/shacl"]
    implementations: { standalone: "etalii.adp.ide.standalone src/diagrams/rdf (Skos/)" }
  }
}
