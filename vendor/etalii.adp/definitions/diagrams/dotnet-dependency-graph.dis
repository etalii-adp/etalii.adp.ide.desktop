{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.dotnet.dependency-graph",
    "version": "0.2.0",
    "origin": "dotnet/dependency-graph",
    "label": ".NET dependency graph",
    "license": "Apache-2.0",
    "authors": [ { "name": "Peter Vrenken", "url": "https://github.com/vrenken" } ],
    "homepage": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/dotnet-dependency-graph",
    "icon": "mdi-file-tree-outline",
    "doc": {
      "summary": "Which projects a solution builds, which NuGet packages they consume, and every reference between them - read from the project files rather than drawn by hand.",
      "description": "A derived diagram type. Its elements are a projection of files the user maintains elsewhere: a `.sln` or `.slnx` solution, the project files it names, the `Directory.Packages.props` files above them and the local NuGet cache. Nothing in the model is authored and nothing in the solution is ever written; the only thing a user changes is where the boxes are. The model is read by the required plugin `net.etalii.adp.dotnet.solution`, which also computes every package's versions, conflict, dependent count and ambient marking and every project's .NET version, so those are stored, read-only attributes here rather than derived ones. What DISL cannot state is described in `dotnet-dependency-graph.md` beside this file; the standalone wire ids are under `x-dotnet`.",
      "tags": [ "dotnet", "nuget", "msbuild", "solution", "dependencies", "software delivery" ],
      "seeAlso": [
        { "title": "PackageReference in project files", "href": "https://learn.microsoft.com/en-us/nuget/consume-packages/package-references-in-project-files" },
        { "title": "Central Package Management", "href": "https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management" },
        { "title": "What DISL cannot express for this tool", "href": "dotnet-dependency-graph.md" }
      ]
    },
    "requires": { "conformance": "standard" }
  },

  "functions": {
    "title": {
      "params": [ { "name": "e", "type": "Element" } ],
      "returns": "string",
      "cel": "e.isA('Package') ? 'Package ' + e.name + (e.versions.size() > 0 ? ' (' + e.versions.join(', ') + ')' : '') + (e.hasVersionConflict ? ' - referenced at more than one version' : '') : 'Project ' + e.name",
      "doc": "What a box says about itself, as its tooltip and its accessible name: `Project <name>`, or `Package <id>` followed by its versions in parentheses when any are known and by `- referenced at more than one version` when they conflict."
    }
  },

  "metamodel": {
    "doc": "Two node kinds and two reference kinds. Every attribute is read-only: its value comes from a file the build owns, and the remedy for a wrong value is always to edit that file.",
    "diagram": {
      "attributes": {
        "solution": {
          "type": "string", "readOnly": true, "label": "Solution",
          "doc": "The solution this diagram is bound to, relative to the registration - the `body:` header. Stated, never inferred, so a folder holding two solutions is unambiguous."
        },
        "showAmbientPackages": {
          "type": "bool", "default": false, "transient": true, "label": "Show ambient packages",
          "doc": {
            "summary": "Whether packages marked ambient are drawn.",
            "rationale": "Hidden by default: a graph whose readability depends on the reader finding a control is not readable. A way of looking at the solution rather than a fact about it, so it is never persisted; it resets when the diagram is opened again."
          }
        }
      }
    },
    "types": {
      "DependencyNode": {
        "abstract": true,
        "doc": "Something a project in the solution can depend on, or a project itself.",
        "attributes": {
          "name": { "type": "string", "required": true, "readOnly": true, "label": "Name",
                    "doc": "What the box is labelled: the project file name without its extension, or the package id as the first reference read spells it." }
        }
      },
      "Project": {
        "extends": "DependencyNode",
        "label": "Project",
        "icon": "mdi-language-csharp",
        "doc": {
          "summary": "One project the solution names and which is on disk.",
          "description": "A project the solution names but which is not on disk is not an element; the rest of the graph is still drawn."
        },
        "labelAttribute": "name",
        "attributes": {
          "path": { "type": "string", "required": true, "readOnly": true, "key": true, "unique": "diagram", "label": "Path",
                    "doc": "The project file's path relative to the solution, forward-slashed on every platform. The element id is built from it, so a stored position survives a rename of the assembly but not a move of the file." },
          "targetFrameworks": { "type": "string", "many": true, "readOnly": true, "label": "Target frameworks",
                                "doc": "Every framework in `TargetFramework` or `TargetFrameworks`, de-duplicated case-insensitively. Multi-targeting is ordinary; a value holding an unexpanded `$(...)` property is not a framework and is left out." },
          "dotNetVersion": { "type": "string", "readOnly": true, "label": ".NET version",
                             "doc": { "summary": "The .NET version the target frameworks name, where they name one; unset otherwise.",
                                      "description": "Read by the plugin: every target framework of the form `net<major>.<minor>` names `<major>.<minor>`, and the distinct ones are joined by `, ` in ordinal order, so a project multi-targeted across two versions shows both. `netstandard2.0` or `net472` name none, which the inspector shows as *Not discoverable* rather than as a blank." } }
        }
      },
      "Package": {
        "extends": "DependencyNode",
        "label": "Package",
        "icon": "mdi-package-variant-closed",
        "doc": {
          "summary": "One NuGet package the solution consumes, however many projects consume it.",
          "description": "One element per package id, **never per version**: a version bump must not change the id and cost the user a stored position. A package asked for at several versions is one element marked as a version conflict. The plugin computes the four attributes below once per reading, from every reference to the package."
        },
        "labelAttribute": "name",
        "attributes": {
          "versions": { "type": "string", "many": true, "readOnly": true, "label": "Versions",
                        "doc": "Every version the solution's projects ask for, distinct and ordered without regard to case. Empty when no reference's version could be discovered." },
          "hasVersionConflict": { "type": "bool", "default": false, "readOnly": true, "label": "Version conflict",
                                  "doc": { "summary": "The projects disagree about the version: two known versions, or a known one beside a reference whose version could not be discovered.",
                                           "rationale": "Collapsing loudly: one element, both versions, marked - rather than two disconnected boxes or a silent collapse." } },
          "dependentProjectCount": { "type": "int", "default": 0, "readOnly": true, "label": "Dependent projects",
                                     "doc": "How many of the solution's projects reference this package." },
          "isAmbient": { "type": "bool", "default": false, "readOnly": true, "label": "Ambient",
                         "doc": { "summary": "Referenced by so many of the solution's projects that the edge discriminates nothing.",
                                  "description": "A package referenced by at least `max(5, ceil(0.15 × number of projects))` projects is ambient. Hidden by default, never removed.",
                                  "rationale": "Measured on the standalone repository's own solution: 104 projects, 17 packages, four of which carry 97 of the 155 package references. An edge on 26 of 104 projects says *this is a test project*, which the project's name already says. Degree rather than a curated name list, which needs maintaining and is wrong on the next repository. Only packages: the two highest-degree nodes there are projects, and they carry the opposite information." } },
          "description": { "type": "text", "readOnly": true, "label": "Description",
                           "doc": { "summary": "The package author's description, from the local NuGet cache only; unset when the package was never restored on this machine.",
                                    "rationale": "No feed is queried and no network call is made (the user's recorded decision). A package never restored here shows *Not available* instead; never an error, a wait or an empty diagram." } }
        }
      }
    },
    "relations": {
      "ProjectReference": {
        "label": "Project reference",
        "doc": "A `ProjectReference`: directed from the referencing project to the referenced one. A reference to a project the solution does not contain is not drawn.",
        "source": "Project",
        "target": "Project",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false
      },
      "PackageReference": {
        "label": "Package reference",
        "doc": "A direct `PackageReference`: directed from the project to the package. Transitive packages are never drawn. One project declaring the same package twice is one reference.",
        "source": "Project",
        "target": "Package",
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false
      }
    }
  },

  "notation": {
    "doc": "A project is a solid box, a package a lighter dashed one, because a package is consumed rather than built. Project references are solid lines, package references dashed, because they leave the solution.",
    "theme": {
      "tokens": {
        "color.project.fill": "#3b6ea5",
        "color.project.stroke": "#2b537c",
        "color.package.fill": "#cbd5e1",
        "color.package.stroke": "#94a3b8",
        "color.node.label": "#ffffff",
        "color.node.sublabel": "#dbe6f2",
        "color.edge.project": "#64748b",
        "color.edge.package": "#e2e8f0",
        "color.warning": "#b45309",
        "font.body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
      },
      "modes": {
        "dark": {
          "color.project.fill": "#3b6ea5",
          "color.project.stroke": "#7fb0e0",
          "color.package.fill": "#4a5568",
          "color.package.stroke": "#6b7280",
          "color.node.label": "#ffffff",
          "color.node.sublabel": "#cbd5e1",
          "color.edge.project": "#94a3b8",
          "color.edge.package": "#334155",
          "color.warning": "#fbbf24"
        }
      },
      "defaultMode": "light",
      "followSystem": true,
      "doc": "The project, package and label colours are the module's own. The edge and warning colours and the font are the host's muted text, border and warning colours and the font its page is set in, copied here with their current values."
    },
    "styles": {
      "node": { "cornerRadius": 6, "font": { "family": { "token": "font.body" } } },
      "project": { "extends": "node", "fill": { "token": "color.project.fill" },
                   "stroke": { "color": { "token": "color.project.stroke" }, "width": 1.5 } },
      "package": { "extends": "node", "fill": { "token": "color.package.fill" },
                   "stroke": { "color": { "token": "color.package.stroke" }, "width": 1.5, "dash": [4, 3], "dashScale": "absolute" } },
      "nodeLabel": { "font": { "weight": 600, "color": { "token": "color.node.label" } } },
      "nodeSubtitle": { "font": { "size": 12, "color": { "token": "color.node.sublabel" } } },
      "conflict": { "stroke": { "color": { "token": "color.warning" }, "width": 2.5, "dash": "solid" } },
      "hidden": { "visible": false }
    },
    "nodes": {
      "Project": {
        "shape": { "type": "roundedRect", "params": { "radius": 6 } },
        "style": "project",
        "size": { "fixed": [220, 56] },
        "labels": [
          { "id": "name", "text": { "attribute": "name" }, "editable": false, "position": "center",
            "overflow": "ellipsis", "maxLines": 1, "style": "nodeLabel" },
          { "id": "subtitle", "text": { "cel": "self.targetFrameworks.join(', ')" },
            "position": { "anchor": [0.5, 0.5], "offset": [0, 14], "align": "center" },
            "visible": { "cel": "self.targetFrameworks.size() > 0" }, "style": "nodeSubtitle" }
        ],
        "anchors": { "mode": "sides", "sides": [ "left", "right" ] },
        "tooltip": { "cel": "title(self)" },
        "accessibility": { "role": "button", "name": { "cel": "title(self)" } },
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "revealProjectFile",
        "doc": "Double-click, or activate from the keyboard, reveals the project file."
      },
      "Package": {
        "shape": { "type": "roundedRect", "params": { "radius": 6 } },
        "style": "package",
        "size": { "fixed": [220, 56] },
        "labels": [
          { "id": "name", "text": { "attribute": "name" }, "editable": false, "position": "center",
            "overflow": "ellipsis", "maxLines": 1, "style": "nodeLabel" },
          { "id": "subtitle", "text": { "cel": "self.versions.join(', ')" },
            "position": { "anchor": [0.5, 0.5], "offset": [0, 14], "align": "center" },
            "visible": { "cel": "self.versions.size() > 0" }, "style": "nodeSubtitle" }
        ],
        "conditions": [
          { "when": "self.hasVersionConflict", "style": "conflict",
            "doc": "A package referenced at more than one version is outlined in the warning colour." },
          { "when": "self.isAmbient && !diagram.showAmbientPackages", "style": "hidden",
            "doc": "Ambient packages are not drawn until the reader asks for them." }
        ],
        "anchors": { "mode": "sides", "sides": [ "left", "right" ] },
        "tooltip": { "cel": "title(self)" },
        "accessibility": { "role": "button", "name": { "cel": "title(self)" } },
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "doc": "Activating a package does nothing: it is not a file in the workspace."
      }
    },
    "edges": {
      "ProjectReference": {
        "line": {
          "stroke": { "color": { "token": "color.edge.project" }, "width": 1.5 },
          "routing": "bezier",
          "startDirection": "right",
          "endDirection": "left",
          "bezier": { "reach": "auto", "backward": "loop",
                      "doc": "Forward, the control points sit at the horizontal midpoint; backward, the curve leaves the source's right side and enters the target's left side the long way round. The exact reach is in the companion file." },
          "bendpoints": { "editable": false }
        },
        "targetMarker": "arrowFilled",
        "anchoring": { "source": { "mode": "sides" }, "target": { "mode": "sides" } },
        "selectable": true,
        "deletable": false,
        "reconnectable": false,
        "tooltip": "ProjectReference"
      },
      "PackageReference": {
        "line": {
          "stroke": { "color": { "token": "color.edge.package" }, "width": 1.5, "dash": [5, 4], "dashScale": "absolute" },
          "routing": "bezier",
          "startDirection": "right",
          "endDirection": "left",
          "bezier": { "reach": "auto", "backward": "loop" },
          "bendpoints": { "editable": false }
        },
        "targetMarker": "arrowFilled",
        "anchoring": { "source": { "mode": "sides" }, "target": { "mode": "sides" } },
        "conditions": [
          { "when": "self.target.isAmbient && !diagram.showAmbientPackages", "style": "hidden",
            "doc": "A reference to a hidden package would be a connector to nothing, so it goes with it." }
        ],
        "selectable": true,
        "deletable": false,
        "reconnectable": false,
        "tooltip": "PackageReference"
      }
    }
  },

  "toolbox": {
    "doc": "Nothing can be created: the graph's shape belongs to the solution. Select and pan only, and no context menu of the type's own.",
    "groups": [],
    "generic": { "select": true, "pan": true, "lasso": false, "text": false, "note": false, "image": false, "freehand": false }
  },

  "forms": {
    "projectInspector": {
      "for": "Project",
      "usage": [ "inspector" ],
      "doc": "Every row is read-only, and every row says where its value is defined: the project file, to be edited in a text editor. A value that cannot be discovered is a row saying so, never a missing row or a blank.",
      "items": [
        { "kind": "section", "label": "Identity", "items": [
          { "attribute": "name", "widget": "readonly", "readOnlyReasons": [ { "reason": "projectFile" } ] },
          { "attribute": "path", "widget": "readonly", "readOnlyReasons": [ { "reason": "projectFile" } ] }
        ] },
        { "kind": "section", "label": "Build", "items": [
          { "attribute": "targetFrameworks", "widget": "readonly",
            "label": { "cel": "self.targetFrameworks.size() == 1 ? 'Target framework' : 'Target frameworks'" },
            "display": { "cel": "self.targetFrameworks.size() == 0 ? 'Not discoverable' : self.targetFrameworks.join(', ')" },
            "readOnlyReasons": [ { "reason": "projectFile" } ] },
          { "attribute": "dotNetVersion", "widget": "readonly",
            "display": { "cel": "has(self.dotNetVersion) ? self.dotNetVersion : 'Not discoverable'" },
            "readOnlyReasons": [ { "reason": "projectFile" } ] }
        ] }
      ]
    },
    "packageInspector": {
      "for": "Package",
      "usage": [ "inspector" ],
      "doc": "Every row is read-only. Identity rows are defined in the project files that reference the package; the description is the package author's.",
      "items": [
        { "kind": "section", "label": "Identity", "items": [
          { "id": "packageId", "attribute": "name", "widget": "readonly", "label": "Package",
            "readOnlyReasons": [ { "reason": "referencingProjects" } ] },
          { "id": "packageVersion", "attribute": "versions", "widget": "readonly",
            "label": { "cel": "self.versions.size() > 1 ? 'Versions' : 'Version'" },
            "display": { "cel": "self.versions.size() == 0 ? 'Not discoverable' : self.versions.join(', ')" },
            "readOnlyReasons": [ { "reason": "referencingProjects" } ] },
          { "kind": "computed", "id": "packageVersionConflict", "label": "Version conflict", "widget": "readonly",
            "value": "This solution's projects reference this package at more than one version.",
            "visible": "self.hasVersionConflict",
            "readOnlyReasons": [ { "reason": "referencingProjects" } ] }
        ] },
        { "kind": "section", "label": "About", "items": [
          { "id": "packageDescription", "attribute": "description", "widget": "readonly",
            "display": { "cel": "has(self.description) ? self.description : 'Not available - this package is not in the local NuGet cache'" },
            "readOnlyReasons": [ "Published by the package's author and read from the local NuGet cache; nothing in this workspace defines it." ] }
        ] }
      ]
    }
  },

  "behavior": {
    "doc": "The model is read-only; besides dragging a box, the three operations are the only commands.",
    "messages": {
      "std.readOnly": "A .NET dependency graph shows the solution as it is and changes nothing in it. Edit the project file this value comes from, and the diagram will follow."
    },
    "reasons": {
      "projectFile": { "message": { "cel": "'Defined in ' + self.path + '; edit it in a text editor.'" },
                       "doc": "Cause first, then the remedy, naming the file the value lives in." },
      "referencingProjects": { "message": "Defined in the project files that reference it; edit it in a text editor." }
    },
    "operations": {
      "revealProjectFile": {
        "label": "Reveal project file",
        "icon": "mdi-file-find-outline",
        "for": [ "Project" ],
        "doc": "Selects the project file in the workspace explorer. A package is not a file in the workspace, so it reveals nothing.",
        "plugin": { "name": "net.etalii.adp.dotnet.solution", "args": { "action": "revealProjectFile" } }
      },
      "showAmbientPackages": {
        "label": "Show them",
        "for": "diagram",
        "enabled": "!diagram.showAmbientPackages && diagram.nodesOfType('Package').exists(p, p.isAmbient)",
        "doc": "Draws every package, including the ambient ones.",
        "actions": [ { "set": { "showAmbientPackages": "true" }, "target": "diagram" } ]
      },
      "hideAmbientPackages": {
        "label": "Hide ambient packages",
        "for": "diagram",
        "enabled": "diagram.showAmbientPackages",
        "doc": "Hides the ambient packages again, and the references to them.",
        "actions": [ { "set": { "showAmbientPackages": "false" }, "target": "diagram" } ]
      }
    },
    "deletion": {
      "Project": { "relations": "forbid", "references": "forbid" },
      "Package": { "relations": "forbid", "references": "forbid" }
    },
    "clipboard": { "relations": "none" }
  },

  "layout": {
    "doc": "Projects layered by dependency depth, packages banded beyond them. Positions a user drags are stored and win element by element; everything else follows the computed layout on every render.",
    "algorithms": {
      "dependencyDepth": {
        "algorithm": "plugin:net.etalii.adp.dotnet.dependencyLayers",
        "direction": "right",
        "spacing": { "layer": 320, "node": 90 },
        "doc": "A project that references no other project sits in the first layer; every other project one layer beyond the deepest project it references. A layer of more than twelve wraps into columns 260 apart. Packages form one band 200 beyond the last project column, ordered by id."
      }
    },
    "default": "dependencyDepth",
    "trigger": "onChange",
    "respect": "pinned",
    "animate": false
  },

  "persistence": {
    "doc": "The model is not stored by this diagram type: it is read from the solution each time. The registration (`.adp`) holds the binding and the positions the user dragged, nothing else. No `.sln`, `.slnx` or project file is ever written.",
    "format": "fbl",
    "binding": "https://raw.githubusercontent.com/etalii-adp/etalii.adp.ide.standalone/develop/src/diagrams/dotnet-dependency-graph/backend/EtAlii.Adp.Diagram.DotNetDependencyGraph/dotnet-dependency-graph.fbl#solution",
    "ids": { "strategy": "natural", "prefix": { "Project": "project:", "Package": "package:" }, "stable": true,
             "pattern": "^(project|package|depends):.{1,1024}$",
             "doc": "A project is `project:<path>`, a package `package:<id>`, and a reference `depends:<source id>-><target id>`. A project's path holds `/`, a reference holds `>` and two ids, and either can pass 128 characters, so the pattern admits them where DISL 11.5's default would not." },
    "view": { "store": [ "bounds" ], "styleOverrides": "none" }
  },

  "plugins": {
    "net.etalii.adp.dotnet.solution": {
      "version": "^0.1.0",
      "provides": [ "persistenceFormat", "action" ],
      "required": true,
      "plans": [],
      "args": {
        "action": { "type": "string", "doc": "`revealProjectFile`." }
      },
      "doc": "Reads a `.sln` or `.slnx`, the project files it names, the `Directory.Packages.props` files above them and the local NuGet cache into the model, computes the packages' and projects' read-only summaries, watches those files, and never writes any of them."
    },
    "net.etalii.adp.dotnet.dependencyLayers": {
      "version": "^0.1.0",
      "provides": [ "layout" ],
      "required": false,
      "fallback": { "layout": "layered" },
      "args": {
        "layerWidth": { "type": "number", "default": 320 },
        "rowHeight": { "type": "number", "default": 90 },
        "packageBandGap": { "type": "number", "default": 200 },
        "layerWrapAt": { "type": "int", "default": 12 },
        "wrapColumnWidth": { "type": "number", "default": 260 }
      },
      "doc": "The depth-layered placement with wrapped layers and a package band. Without it, a generic layered layout is a fair approximation."
    }
  },

  "x-dotnet": {
    "doc": "Today's wire ids, which the standalone client and backend share, mapped from this specification's names, as x-ghg does for the hype cycle graph. The element kinds on the wire are the prefix followed by project, package or edge. A type or relation is keyed by its name, an action by its operation, a property by its form item's row id: its id, else its attribute.",
    "typePrefix": "dotnet/dependency-graph+",
    "types": {
      "Project": "project",
      "Package": "package",
      "ProjectReference": "project-reference",
      "PackageReference": "package-reference"
    },
    "actions": {
      "revealProjectFile": "dotnet-dependency.activate"
    },
    "properties": {
      "name": "dotnet.name",
      "path": "dotnet.path",
      "targetFrameworks": "dotnet.target-frameworks",
      "dotNetVersion": "dotnet.dotnet-version",
      "packageId": "dotnet.package-id",
      "packageVersion": "dotnet.package-version",
      "packageVersionConflict": "dotnet.package-version-conflict",
      "packageDescription": "dotnet.package-description"
    }
  },

  "x-adp": {
    "kind": "Diagram",
    "state": "Prototype",
    "companion": "dotnet-dependency-graph.md",
    "documentExtensions": [ ".sln", ".slnx" ],
    "sharedExtension": true
  }
}
