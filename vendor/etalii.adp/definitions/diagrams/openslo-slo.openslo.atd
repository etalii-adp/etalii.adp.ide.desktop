  /// A document of kind AlertPolicy: one element, named by metadata.name (research R3).
  element AlertPolicy as alertPolicy at "/" {
    files yaml, yml
    when type(entry) == map && has(entry.apiVersion) && entry.apiVersion == 'openslo/v1' && has(entry.kind) && entry.kind == 'AlertPolicy'
    attribute name from key "name" { child: "metadata", empty: "refuse" }
