              "label": "Anonymous variable",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "kind": "computed",
              "id": "projected",
              "label": "Projected",
              "value": "No",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            }
          ]
        },
        {
          "kind": "section",
          "label": "Structure",
          "items": [
            {
              "kind": "computed",
              "id": "joins",
              "label": "Joins",
              "value": "0",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "kind": "computed",
              "id": "definition",
              "label": "Defined by",
              "value": "",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            }
          ]
        }
      ]
    },
    "iriInspector": {
      "for": [
        "Iri"
      ],
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "display",
              "id": "display",
              "label": "Prefixed name",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "attribute": "full",
              "id": "full",
              "label": "IRI",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "kind": "computed",
              "id": "annotation",
              "label": "Type",
              "value": "",
