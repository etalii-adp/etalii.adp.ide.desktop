      ],
      "items": [
        {
          "kind": "section",
          "label": "Identity",
          "items": [
            {
              "attribute": "display",
              "id": "display",
              "label": "Literal",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "attribute": "full",
              "id": "full",
              "label": "As written",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "attribute": "annotation",
              "id": "annotation",
              "label": "Type",
              "widget": "readonly",
              "readOnlyReasons": [
