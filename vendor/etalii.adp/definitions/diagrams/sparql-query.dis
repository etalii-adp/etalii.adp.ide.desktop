{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.w3c.sparql",
    "version": "2.0.0",
    "origin": "w3c/sparql",
    "label": "SPARQL query",
    "icon": "mdi-help-network-outline",
    "fileExtension": "rq",
    "license": "Apache-2.0",
    "homepage": "https://etalii.net/adp/",
    "authors": [
      {
        "name": "Peter Vrenken"
      }
    ],
    "limits": {
      "maxElements": 500,
      "budgets": {
        "drawn": {
          "measure": {
            "count": [
              "Scope",
              "Term",
              "TriplePattern",
              "ProjectedJoin",
              "Annotation"
            ]
          },
          "max": 500,
          "order": "drawOrder(self)",
          "notice": {
            "text": {
              "cel": "'Showing ' + string(budget('drawn').shown) + ' of ' + string(budget('drawn').total) + ' elements — this query is larger than the diagram draws'"
            },
            "severity": "warning",
            "position": "top"
          },
          "withhold": {
            "edits": "none"
          },
          "doc": "At most 500 regions, nodes, edges and annotations are drawn: the regions first, then the nodes, the edges and the annotations, each in the order the tool walks the query (`drawOrder`). An edge is drawn only when both its ends are. It is the tool's own bound, so that a generated query degrades honestly; a hand-written one holds tens of patterns. Nothing is withheld, because nothing is editable."
        }
      }
    },
    "requires": {
      "conformance": "standard",
      "features": [
        "limits.budgets",
        "persistence.fbl"
      ]
    },
    "doc": {
      "summary": "What a query asks: its graph pattern as nodes and edges, its variables as the joins they are, and its form and modifiers as the frame around them.",
      "description": "A read-only diagram of one SPARQL 1.1 query file (`.rq`). Triple patterns are directed, labelled edges between term nodes; every occurrence of a variable name is one node, so a variable's degree on the canvas is its join count. Group-shaped constructs (`OPTIONAL`, `UNION`, `MINUS`, `GRAPH`, `SERVICE`, a braced group, the `CONSTRUCT` template) are labelled containment regions; expression-shaped constructs (`FILTER`, `BIND`, `VALUES`) are annotations showing their text as written; the form and solution modifiers are the header above the canvas.\n\nThe query text is the model and is never written: it is edited in a text editor and the diagram follows. The plugin `net.etalii.adp.w3c.sparqlQuery` reads it, through the binding named by `persistence`, into stored records, one per entry of the query: the prologue's prefixes, the groups, the triple patterns, the constraints and the subqueries. The variable and term nodes, where each is placed and the pattern edges are derived from them here (4.11). The one thing a user changes is where an element sits, and that is stored in the `.adp` registration beside the query, never in it. What this specification cannot express is written down in `sparql-query.md` beside this file.",
      "rationale": "A query shows *asking*, not modelling. The query-builder tradition (NITELIGHT, QueryVOWL, Gruff, RDF Explorer) keeps failing by drowning the pattern in boxes for the non-graph machinery; this type draws only what is a graph as structure and keeps the rest as annotation and frame.",
      "tags": [
        "sparql",
        "rdf",
        "query",
        "semantic web",
        "read-only"
      ],
      "seeAlso": [
        {
          "title": "SPARQL 1.1 Query Language",
          "href": "https://www.w3.org/TR/sparql11-query/"
        },
        {
          "title": "QueryVOWL: a visual query notation for Linked Data",
          "href": "https://link.springer.com/chapter/10.1007/978-3-319-25639-9_51"
        },
        {
          "title": "What DISL cannot express for this tool",
          "href": "sparql-query.md"
        }
      ]
    }
  },
  "functions": {
    "walkScopes": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "['where'] + diagram.nodesOfType('Scope').filter(s, s.path.startsWith('where/')).map(s, s.path) + diagram.nodesOfType('Scope').filter(s, s.path == 'template' || s.path.startsWith('template/')).map(s, s.path)",
      "doc": "Every scope path in the order the tool walks the query: the where clause and its groups depth first, then the `CONSTRUCT` template and its groups. Groups are read in document order, which is depth first."
    },
    "scopeRank": {
      "params": [
        {
          "name": "path",
          "type": "string"
        }
      ],
      "returns": "int",
      "uses": [
        "diagram"
      ],
      "cel": "walkScopes().indexOf(path)",
      "doc": "A scope's place in `walkScopes()`."
    },
    "patternsIn": {
      "params": [
        {
          "name": "path",
          "type": "string"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "path == 'template' && diagram.templateRepeatsWhere ? diagram.nodesOfType('Pattern').filter(p, p.scope == 'where') : diagram.nodesOfType('Pattern').filter(p, p.scope == path)",
      "doc": "The patterns a scope states, in reading order. The template of `CONSTRUCT WHERE { ... }` states the where clause's own patterns again: it has no entries of its own."
    },
    "walkPatterns": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "walkScopes().map(s, patternsIn(s).map(p, [p, s])).flatten()",
      "doc": "Every pattern the query states, as `[pattern, scope path]`, in the order the tool walks them: scope by scope in `walkScopes()` order, each scope's own patterns in reading order. A `CONSTRUCT WHERE` pattern is in it twice, once for the where clause and once for the template."
    },
    "repeatOf": {
      "params": [
        {
          "name": "p",
          "type": "Element"
        },
        {
          "name": "path",
          "type": "string"
        }
      ],
      "returns": "int",
      "uses": [
        "diagram"
      ],
      "cel": "path == 'template' && diagram.templateRepeatsWhere ? diagram.nodesOfType('Pattern').filter(q, q.scope == 'where' && q.sKey == p.sKey && q.predicate == p.predicate && q.oKey == p.oKey).size() + p.repeat : p.repeat",
      "doc": "How many patterns with the same subject, predicate as written and object come before this one in `walkPatterns()`: the plugin's `repeat`, and for the template's copy of a `CONSTRUCT WHERE` pattern, every where pattern with those parts as well."
    },
    "mentions": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "walkScopes().map(s, patternsIn(s).map(p, (p.sKind == 'var' ? [[p.sKey.substring(4), s, true, '']] : []) + (p.predicateVariable != '' ? [[p.predicateVariable, s, true, '']] : []) + (p.oKind == 'var' ? [[p.oKey.substring(4), s, true, '']] : [])).flatten() + diagram.nodesOfType('Annotation').filter(c, c.scope == s).map(c, c.referencedVariables.map(n, [n, s, false, '']) + (c.definedVariable != '' ? [[c.definedVariable, s, false, c.text]] : [])).flatten() + diagram.nodesOfType('SubQuery').filter(q, q.scope == s).map(q, q.projectedNames.map(n, [n, s, false, ''])).flatten()).flatten() + lists.range(diagram.projection.size()).map(i, [diagram.projection[i], '', false, diagram.projectionExpressions[i]])",
      "doc": "Every mention of a variable name, as `[name, scope path, in a pattern, defining text]`, in the order the tool indexes them: scope by scope in `walkScopes()` order, first the subject, predicate and object of each pattern, then the names each constraint reads and the name it defines with its text, then the names each subquery projects; and last the projection, with no scope and with its alias's text. A name is in it once per mention."
    },
    "shallowestScope": {
      "params": [
        {
          "name": "paths",
          "type": "list"
        }
      ],
      "returns": "string",
      "cel": "paths.size() == 0 ? 'where' : cel.bind(segs, paths[0].split('/'), cel.bind(common, lists.range(segs.size()).map(k, segs.slice(0, k + 1).join('/')).filter(c, paths.all(p, p == c || p.startsWith(c + '/'))), cel.bind(best, common.size() == 0 ? 'where' : common[common.size() - 1], best.contains('/') && best.substring(best.lastIndexOf('/') + 1).startsWith('union.') ? best.substring(0, best.lastIndexOf('/')) : best)))",
      "doc": "The shallowest scope that holds every path given: their longest common ancestor, lifted out of a `UNION`, because a name its branches share joins at the scope that joins the branches. The where clause when none is given or none is common."
    },
    "regionAt": {
      "params": [
        {
          "name": "path",
          "type": "string"
        }
      ],
      "returns": "Element",
      "uses": [
        "diagram"
      ],
      "cel": "path == 'where' ? null : diagram.elementById('region:' + path)",
      "doc": "The region a scope path is drawn as; null for the where clause, which is the open canvas."
    },
    "termMentions": {
      "params": [],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "cel.bind(ms, diagram.describeTerms.map(t, [t.kind, t.key, t.display, t.full, t.annotation, '']) + walkPatterns().map(x, [[x[0].sKind, x[0].sKey, x[0].sDisplay, x[0].sFull, x[0].sAnnotation, x[1]], [x[0].oKind, x[0].oKey, x[0].oDisplay, x[0].oFull, x[0].oAnnotation, x[1]]]).flatten(), lists.range(ms.size()).map(i, ms[i] + [i]))",
      "doc": "Every mention of a term in subject or object position, as `[kind, key, display, full, annotation, scope path, position]`, in the order the tool meets them: the `DESCRIBE` targets with no scope, then each pattern's subject and object in `walkPatterns()` order. The position is the mention's index in this list, by which the term nodes of three types are ordered together."
    },
    "drawOrder": {
      "params": [
        {
          "name": "e",
          "type": "Element"
        }
      ],
      "returns": "list",
      "uses": [
        "diagram"
      ],
      "cel": "e.isA('Scope') ? [0, scopeRank(e.path)] : e.isA('Variable') ? [1, 0, e.firstScope, e.name] : e.isA('SubQuery') ? [1, 2, scopeRank(e.scope), e.ordinal] : e.isA('Term') ? [1, 1, e.firstMention] : e.isA('TriplePattern') ? [2, 0, e.positionIn(diagram.relationsOfType('TriplePattern'))] : e.isA('ProjectedJoin') ? [2, 1, e.positionIn(diagram.relationsOfType('ProjectedJoin'))] : [3, scopeRank(e.scope), e.positionIn(diagram.nodesOfType('Annotation').filter(a, a.scope == e.scope))]",
      "doc": "Where an element comes in the tool's order, which is the budget's: regions in `walkScopes()` order; then the variables by the scope of their first mention and then by name, both by code point, a name mentioned only by the projection first with the scope '', the terms in the order they are first mentioned, and the subqueries scope by scope; then the pattern edges in `walkPatterns()` order and the subqueries' edges; then the annotations scope by scope."
    }
  },
  "metamodel": {
    "doc": "The plugin reads one stored record per entry of the query: a `Prefix` per declaration, a `Scope` per group, a `Pattern` per triple pattern, an `Annotation` per `FILTER`, `BIND` or `VALUES` (its binding type is `Constraint`) and a `SubQuery` per nested `SELECT`, each with the span and line it was read from, and the query's form, projection and modifiers as the diagram's attributes. `Prefix` and `Pattern` are never drawn. The variable and term nodes, their containment and the edges are derived (4.11). Every attribute is read-only, because the text editor is where a query is edited.",
    "diagram": {
      "doc": "The query's frame: its form, projection and modifiers. Shown as the header above the canvas and as the property rows of the diagram itself, never as canvas structure.",
      "attributes": {
        "form": {
          "type": "QueryForm",
          "readOnly": true,
          "default": "select",
          "doc": "Which of the four SPARQL query forms the file is."
        },
        "distinct": {
          "type": "bool",
          "readOnly": true,
          "default": false,
          "doc": "The form writes `DISTINCT`."
        },
        "reduced": {
          "type": "bool",
          "readOnly": true,
          "default": false,
          "doc": "The form writes `REDUCED`."
        },
        "projectsAll": {
          "type": "bool",
          "readOnly": true,
          "default": false,
          "doc": "The projection is `SELECT *`; `projection` then names every variable the query mentions, in the order it first mentions them."
        },
        "projection": {
          "type": "string",
          "readOnly": true,
          "many": true,
          "doc": "The names the query's own projection carries outward, without their sigil, in the order written: named in `SELECT`, aliased by `(expr AS ?name)`, every mentioned variable for `SELECT *`, or a `DESCRIBE` query's variable targets."
        },
        "projectionExpressions": {
          "type": "string",
          "readOnly": true,
          "many": true,
          "doc": "For each entry of `projection`, at the same place, the text of the `(expr AS ?name)` that defines it as written, or ''."
        },
        "describeTargets": {
          "type": "string",
          "readOnly": true,
          "many": true,
          "doc": "A `DESCRIBE` query's targets as written (`*` included); empty for the other forms."
        },
        "describeTerms": {
          "type": "DescribeTerm",
          "readOnly": true,
          "many": true,
          "doc": "A `DESCRIBE` query's targets that are terms, in the order written, each drawn as a node."
        },
        "datasetClauses": {
          "type": "string",
          "readOnly": true,
          "many": true,
          "doc": "The `FROM` and `FROM NAMED` clauses, as written."
        },
        "modifierRows": {
          "type": "string",
          "readOnly": true,
          "many": true,
          "doc": "The solution modifiers as written rows: `GROUP BY ?x`, `HAVING (...)`, `ORDER BY DESC(?d)`, `LIMIT 100`, `OFFSET 10`."
        },
        "templateRepeatsWhere": {
          "type": "bool",
          "readOnly": true,
          "default": false,
          "doc": "The query is `CONSTRUCT WHERE { ... }`, whose template is its where clause: the `template` scope then states the where clause's patterns again."
        },
        "baseIri": {
          "type": "string",
          "readOnly": true,
          "default": "",
          "doc": "The `BASE` IRI, when one is declared."
        },
        "headerForm": {
          "type": "string",
          "label": "Form",
          "derived": "(self.form == 'select' ? 'SELECT' : self.form == 'construct' ? 'CONSTRUCT' : self.form == 'ask' ? 'ASK' : 'DESCRIBE ' + self.describeTargets.join(' ')) + (self.distinct ? ' DISTINCT' : '') + (self.reduced ? ' REDUCED' : '')",
          "doc": "The first thing the header says: the form, its `DESCRIBE` targets, then `DISTINCT` or `REDUCED`."
        },
        "modifiers": {
          "type": "string",
          "label": "Modifiers",
          "derived": "(self.datasetClauses + self.modifierRows).join(' · ')",
          "doc": "The dataset clauses and then the solution modifiers, as written, joined by ' · '."
        }
      }
    },
    "dataTypes": {
      "DescribeTerm": {
        "doc": "One term a `DESCRIBE` query names as a target.",
        "fields": {
          "kind": {
            "type": "TermKind",
            "required": true
          },
          "key": {
            "type": "string",
            "required": true,
            "doc": "The id of the node it is drawn as, as for a pattern's ends."
          },
          "display": {
            "type": "string",
            "default": ""
          },
          "full": {
            "type": "string",
            "default": ""
          },
          "annotation": {
            "type": "string",
            "default": ""
          }
        },
        "display": {
          "cel": "value.display"
        }
      }
    },
    "enums": {
      "QueryForm": {
        "doc": "The four query forms of SPARQL 1.1.",
        "values": {
          "select": {
            "label": "SELECT",
            "doc": "A table of bindings."
          },
          "construct": {
            "label": "CONSTRUCT",
            "doc": "A graph built from a template."
          },
          "ask": {
            "label": "ASK",
            "doc": "A yes or no."
          },
          "describe": {
            "label": "DESCRIBE",
            "doc": "Whatever the endpoint says describes the targets."
          }
        }
      },
      "TermKind": {
        "doc": "What a subject, object or `DESCRIBE` target is.",
        "values": {
          "var": {
            "label": "Variable"
          },
          "anon": {
            "label": "Anonymous variable",
            "doc": "A blank node, which in a query is a variable nobody named: `_:label`, `[]`, a blank-node property list or a collection cell."
          },
          "iri": {
            "label": "IRI"
          },
          "lit": {
            "label": "Literal"
          }
        }
      },
      "ScopeKind": {
        "doc": "What a group is: the keyword that opens it, or the shape it has.",
        "values": {
          "group": {
            "label": "Group",
            "doc": "A braced group nested in another group."
          },
          "optional": {
            "label": "OPTIONAL"
          },
          "union": {
            "label": "UNION",
            "doc": "Holds its branches only."
          },
          "branch": {
            "label": "UNION branch"
          },
          "minus": {
            "label": "MINUS"
          },
          "graph": {
            "label": "GRAPH"
          },
          "service": {
            "label": "SERVICE",
            "doc": "Drawn, never contacted: nothing in this type opens a network connection."
          },
          "template": {
            "label": "CONSTRUCT template"
          }
        }
      },
      "ConstraintKind": {
        "values": {
          "filter": {
            "label": "FILTER"
          },
          "bind": {
            "label": "BIND"
          },
          "values": {
            "label": "VALUES"
          }
        }
      }
    },
    "types": {
      "Prefix": {
        "doc": "One `PREFIX` declaration of the prologue, in document order, with the line it is on. Never drawn: it is what the unused-prefix finding is about.",
        "attributes": {
          "prefix": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The prefix without its colon; '' for the default prefix."
          },
          "iri": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The namespace IRI it expands to."
          },
          "used": {
            "type": "bool",
            "readOnly": true,
            "default": false,
            "doc": "Whether `prefix:` occurs anywhere in the text outside a line that starts with `PREFIX`, comments, strings, expressions and modifiers included. The plugin decides it on the source text, which DISL does not read."
          }
        }
      },
      "Pattern": {
        "doc": "One triple pattern as written, with the scope that states it. A `;` or `,` list writes several; a blank-node property list or a collection writes patterns nobody wrote out, one per cell and `rdf:first` or `rdf:rest`. Never drawn: each is the source of one pattern edge, two for a `CONSTRUCT WHERE` query.",
        "attributes": {
          "scope": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The path of the scope whose group states the pattern: `where`, `template`, or a path below either such as `where/optional.0`."
          },
          "sKind": {
            "type": "TermKind",
            "required": true,
            "doc": "What the subject is."
          },
          "sKey": {
            "type": "string",
            "required": true,
            "doc": "The id of the node the subject is drawn as: `var:` and the name, `anon:` and its expansion ordinal, `iri:` and the full IRI, or `lit:` and the lexical form percent-encoded, then `@` and the language or `^` and the datatype's last segment percent-encoded (gap 6 of sparql-query.md)."
          },
          "sDisplay": {
            "type": "string",
            "default": "",
            "doc": "What the subject's node shows: a prefixed name or `<iri>` as written, a literal's lexical form, `_:label` or `[]`; '' for a variable, whose node shows `?` and its name."
          },
          "sFull": {
            "type": "string",
            "default": "",
            "doc": "The subject's full IRI, or a literal exactly as written; '' otherwise."
          },
          "sAnnotation": {
            "type": "string",
            "default": "",
            "doc": "For a literal subject: `@` and its language, else its datatype IRI's last segment after `#` or `/`; '' otherwise."
          },
          "predicate": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The verb as written: a prefixed name, `a`, `<iri>`, `?variable` or a property path."
          },
          "isPath": {
            "type": "bool",
            "readOnly": true,
            "default": false,
            "doc": "The verb is a property path rather than one predicate or variable."
          },
          "predicateVariable": {
            "type": "string",
            "readOnly": true,
            "default": "",
            "doc": "The name of the variable in predicate position, without its sigil; ''."
          },
          "oKind": {
            "type": "TermKind",
            "required": true,
            "doc": "What the object is."
          },
          "oKey": {
            "type": "string",
            "required": true,
            "doc": "The id of the node the object is drawn as: `var:` and the name, `anon:` and its expansion ordinal, `iri:` and the full IRI, or `lit:` and the lexical form percent-encoded, then `@` and the language or `^` and the datatype's last segment percent-encoded (gap 6 of sparql-query.md)."
          },
          "oDisplay": {
            "type": "string",
            "default": "",
            "doc": "What the object's node shows: a prefixed name or `<iri>` as written, a literal's lexical form, `_:label` or `[]`; '' for a variable, whose node shows `?` and its name."
          },
          "oFull": {
            "type": "string",
            "default": "",
            "doc": "The object's full IRI, or a literal exactly as written; '' otherwise."
          },
          "oAnnotation": {
            "type": "string",
            "default": "",
            "doc": "For a literal object: `@` and its language, else its datatype IRI's last segment after `#` or `/`; '' otherwise."
          },
          "repeat": {
            "type": "int",
            "readOnly": true,
            "default": 0,
            "min": 0,
            "doc": "How many patterns with the same subject key, predicate as written and object key the tool meets before this one, where clause first, then template. The plugin counts it, because counting it per pattern in CEL is quadratic in the number of patterns."
          }
        }
      },
      "Term": {
        "abstract": true,
        "doc": "Anything drawn as one node: a variable, a concrete term, or a collapsed subquery.",
        "attributes": {
          "display": {
            "type": "string",
            "readOnly": true,
            "doc": "What the node shows: `?name`, a prefixed name, a literal's lexical form, `_:label` or `[]`, or a subquery's projection."
          }
        },
        "labelAttribute": "display"
      },
      "Variable": {
        "extends": "Term",
        "label": "Variable",
        "doc": {
          "summary": "A named variable: what the query asks for. One node per name, however many patterns mention it.",
          "description": "Every mention of `?name` or `$name` in the query is this one node, subqueries' insides excepted, so the edges meeting it are the joins it takes part in. A variable mentioned only in predicate position, only in a `FILTER`, or only by a projection still gets its node. It sits in the shallowest scope that mentions it, lifted out of a `UNION`, so an edge stated inside a region may cross its border to reach it."
        },
        "attributes": {
          "name": {
            "type": "string",
            "readOnly": true,
            "doc": "The variable's name without its sigil."
          },
          "projected": {
            "type": "bool",
            "readOnly": true,
            "doc": "The query's own projection carries this variable outward."
          },
          "joinCount": {
            "type": "int",
            "min": 0,
            "readOnly": true,
            "doc": "How many triple-pattern positions (subject, predicate or object) mention this variable, template included."
          },
          "definingExpression": {
            "type": "text",
            "readOnly": true,
            "doc": "The `(expr AS ?name)` of the projection that defines the variable, else the last `BIND (...)` that does, as written; '' for an ordinary variable."
          },
          "firstScope": {
            "type": "string",
            "readOnly": true,
            "doc": "The scope path of the name's first mention in `mentions()`; '' for a name only the projection mentions. What `drawOrder` orders the variables by, before their names."
          }
        },
        "derived": {
          "from": "mentions()",
          "key": "item[0]",
          "id": "'var:' + item[0]",
          "attributes": {
            "name": "item[0]",
            "display": "'?' + item[0]",
            "projected": "diagram.projection.exists(n, n == item[0])",
            "joinCount": "group.filter(m, m[2]).size()",
            "definingExpression": "cel.bind(d, group.filter(m, m[3] != ''), d.size() > 0 ? d[d.size() - 1][3] : '')",
            "firstScope": "group[0][1]"
          },
          "parent": "regionAt(shallowestScope(group.filter(m, m[1] != '').map(m, m[1])))",
          "reason": "This diagram reads the query; edit the .rq file in a text editor and the diagram follows.",
          "doc": "One node per name, from every mention of it (`mentions()`), in the order the names are first mentioned; the budget draws them in `drawOrder`, by `firstScope` and then by name. The mentions are not sorted here: sorting each by its name's place among the names costs the square of their number, which the CEL cost limit refuses for a generated query of a few hundred patterns, and nothing would be drawn."
        }
      },
      "AnonymousVariable": {
        "extends": "Term",
        "label": "Anonymous variable",
        "doc": {
          "summary": "A blank node in a pattern, which in a query means a variable nobody named.",
          "description": "Written as `_:label`, `[]`, a blank-node property list `[ ... ]` or a collection `( ... )`, whose cells expand to one anonymous variable each. A labelled blank node is one node wherever its label recurs. It has no name to key a stored position by, so it always takes its computed place."
        },
        "attributes": {
          "firstMention": {
            "type": "int",
            "min": 0,
            "readOnly": true,
            "doc": "The position of its first mention in `termMentions()`."
          }
        },
        "derived": {
          "from": "termMentions().filter(m, m[0] == 'anon')",
          "key": "item[1]",
          "id": "item[1]",
          "attributes": {
            "display": "item[2]",
            "firstMention": "item[6]"
          },
          "parent": "regionAt(shallowestScope(group.filter(m, m[5] != '').map(m, m[5]).distinct()))",
          "reason": "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
        }
      },
      "Iri": {
        "extends": "Term",
        "label": "IRI",
        "doc": "A concrete IRI the query pins down, shown as written, with the full IRI one selection away. One node per distinct full IRI.",
        "attributes": {
          "full": {
            "type": "string",
            "readOnly": true,
            "doc": "The full IRI, resolved against the prologue."
          },
          "firstMention": {
            "type": "int",
            "min": 0,
            "readOnly": true,
            "doc": "The position of its first mention in `termMentions()`."
          }
        },
        "derived": {
          "from": "termMentions().filter(m, m[0] == 'iri')",
          "key": "item[1]",
          "id": "item[1]",
          "attributes": {
            "display": "item[2]",
            "full": "item[3]",
            "firstMention": "item[6]"
          },
          "parent": "regionAt(shallowestScope(group.filter(m, m[5] != '').map(m, m[5]).distinct()))",
          "reason": "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
        }
      },
      "Literal": {
        "extends": "Term",
        "label": "Literal",
        "doc": "A concrete value the query pins down, shown by its lexical form and annotated with its language tag or short datatype. One node per id, which two literals whose datatypes end alike share (finding A10, reproduced).",
        "attributes": {
          "full": {
            "type": "string",
            "readOnly": true,
            "doc": "The literal exactly as the query writes it, quotes and suffix included."
          },
          "annotation": {
            "type": "string",
            "readOnly": true,
            "doc": "`@lang`, or the datatype IRI's last segment after `#` or `/`; ''."
          },
          "firstMention": {
            "type": "int",
            "min": 0,
            "readOnly": true,
            "doc": "The position of its first mention in `termMentions()`."
          }
        },
        "derived": {
          "from": "termMentions().filter(m, m[0] == 'lit')",
          "key": "item[1]",
          "id": "item[1]",
          "attributes": {
            "display": "item[2]",
            "full": "item[3]",
            "annotation": "item[4]",
            "firstMention": "item[6]"
          },
          "parent": "regionAt(shallowestScope(group.filter(m, m[5] != '').map(m, m[5]).distinct()))",
          "reason": "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
        }
      },
      "SubQuery": {
        "extends": "Term",
        "label": "Subquery",
        "doc": {
          "summary": "A nested `SELECT`, collapsed to one node that states its projection.",
          "description": "Its insides are never drawn; the node shows the projection (`SELECT ?x (COUNT(?y) AS ?n)`) and the property rows carry the whole text. Each name it projects joins the outer query through a labelled edge to that variable's node. The plugin reads it as one entry, placed in the region of the scope that holds it."
        },
        "attributes": {
          "scope": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The path of the scope that holds it."
          },
          "ordinal": {
            "type": "int",
            "readOnly": true,
            "min": 0,
            "default": 0,
            "doc": "Its position among the subqueries of that scope."
          },
          "text": {
            "type": "text",
            "readOnly": true,
            "default": "",
            "doc": "The whole subquery, as written."
          },
          "projectedNames": {
            "type": "string",
            "readOnly": true,
            "many": true,
            "doc": "The names the subquery projects; for `SELECT *`, every variable its text mentions."
          }
        }
      },
      "Scope": {
        "label": "Group",
        "doc": "A group of graph patterns other than the root where clause, drawn as a labelled containment region; the plugin reads one per group, each inside the one that holds it. Nodes live at the shallowest scope that mentions them, so an edge stated inside a region may cross its border to reach a node outside; that crossing is the join being shown.",
        "attributes": {
          "path": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The scope's path: its parent's path, `/`, its kind and its position among same-kind siblings (`where/optional.1`, `where/union.0/branch.1`); `template` for the `CONSTRUCT` template. A path numbers groups by their place in the text (gap 4 of sparql-query.md)."
          },
          "scopeKind": {
            "type": "ScopeKind",
            "readOnly": true,
            "required": true,
            "doc": "What the group is."
          },
          "term": {
            "type": "string",
            "readOnly": true,
            "default": "",
            "doc": "The graph term of a `GRAPH`, or the endpoint of a `SERVICE` with `SILENT` before it when written, as written; ''."
          },
          "label": {
            "type": "string",
            "derived": "self.scopeKind == 'optional' ? 'OPTIONAL' : self.scopeKind == 'union' ? 'UNION' : self.scopeKind == 'minus' ? 'MINUS' : self.scopeKind == 'graph' ? 'GRAPH ' + self.term : self.scopeKind == 'service' ? 'SERVICE ' + self.term : self.scopeKind == 'template' ? 'CONSTRUCT' : ''",
            "doc": "The frame's label: the construct keyword, with its graph term or endpoint where it has one; '' for a braced group and a `UNION` branch."
          }
        },
        "children": {
          "allowed": [
            "Term",
            "Scope"
          ],
          "ordered": true
        },
        "labelAttribute": "label"
      },
      "Annotation": {
        "label": "Annotation",
        "doc": "An expression-shaped construct, `FILTER`, `BIND` or `VALUES`, shown as its text exactly as written beside what it constrains, defines or feeds; never as an expression tree. The binding names it `Constraint`.",
        "attributes": {
          "constraintKind": {
            "type": "ConstraintKind",
            "readOnly": true,
            "required": true,
            "doc": "Which construct it is."
          },
          "text": {
            "type": "text",
            "readOnly": true,
            "required": true,
            "doc": "The construct exactly as written."
          },
          "scope": {
            "type": "string",
            "readOnly": true,
            "required": true,
            "doc": "The path of the scope whose group holds it."
          },
          "ordinal": {
            "type": "int",
            "readOnly": true,
            "min": 0,
            "default": 0,
            "doc": "Its position among the annotations of its kind in its scope."
          },
          "definedVariable": {
            "type": "string",
            "readOnly": true,
            "default": "",
            "doc": "The name a `BIND` defines; ''."
          },
          "referencedVariables": {
            "type": "string",
            "readOnly": true,
            "many": true,
            "doc": "The names its text mentions: what a `FILTER` reads, what a `BIND` reads, what a `VALUES` block binds, in the order written."
          },
          "attachedTo": {
            "type": "string",
            "derived": "self.constraintKind == 'bind' ? 'var:' + self.definedVariable : (self.constraintKind == 'values' && self.referencedVariables.size() > 0 ? 'var:' + self.referencedVariables[0] : (self.scope.contains('/') ? 'region:' + self.scope : ''))",
            "doc": "The id of what it is drawn beside: a `BIND` the variable it defines, a `VALUES` block the first variable it binds, anything else the region it sits in; '' at the root, where a `FILTER` floats above the patterns."
          }
        },
        "labelAttribute": "text"
      }
    },
    "relations": {
      "TriplePattern": {
        "label": "Triple pattern",
        "doc": "One triple pattern: an edge from its subject to its object, labelled with the predicate or the property path as written (`foaf:knows+`). It belongs to the scope that states it, which may differ from where its ends live.",
        "source": {
          "types": [
            "Variable",
            "AnonymousVariable",
            "Iri",
            "Literal"
          ],
          "role": "subject"
        },
        "target": {
          "types": [
            "Variable",
            "AnonymousVariable",
            "Iri",
            "Literal"
          ],
          "role": "object"
        },
        "directed": true,
        "allowSelfLoops": true,
        "allowParallel": true,
        "attributes": {
          "predicate": {
            "type": "string",
            "readOnly": true,
            "doc": "The verb as written."
          },
          "isPath": {
            "type": "bool",
            "readOnly": true,
            "doc": "The verb is a property path."
          },
          "scope": {
            "type": "string",
            "readOnly": true,
            "doc": "The path of the scope that states the pattern."
          }
        },
        "derived": {
          "from": "walkPatterns()",
          "id": "'edge:' + item[0].sKey + '|' + item[0].predicate + '|' + item[0].oKey + '|' + string(repeatOf(item[0], item[1]))",
          "source": "diagram.elementById(item[0].sKey)",
          "target": "diagram.elementById(item[0].oKey)",
          "owner": "regionAt(item[1])",
          "attributes": {
            "predicate": "item[0].predicate",
            "isPath": "item[0].isPath",
            "scope": "item[1]"
          },
          "sources": "[item[0]]",
          "reason": "This diagram reads the query; edit the .rq file in a text editor and the diagram follows.",
          "doc": "One edge per pattern the tool walks, a pattern written twice being two edges told apart by the count at the end of the id."
        }
      },
      "ProjectedJoin": {
        "label": "Subquery join",
        "doc": "One name a subquery projects, joining the outer query at that variable's node.",
        "source": {
          "types": [
            "SubQuery"
          ]
        },
        "target": {
          "types": [
            "Variable"
          ]
        },
        "directed": true,
        "allowParallel": false,
        "attributes": {
          "name": {
            "type": "string",
            "readOnly": true,
            "doc": "The projected name, shown as `?name`."
          }
        },
        "derived": {
          "from": "walkScopes().map(s, diagram.nodesOfType('SubQuery').filter(q, q.scope == s).map(q, q.projectedNames.map(n, [q, n])).flatten()).flatten()",
          "id": "'edge:' + item[0].id + '|' + item[1] + '|var:' + item[1] + '|0'",
          "source": "item[0]",
          "target": "diagram.elementById('var:' + item[1])",
          "owner": "regionAt(item[0].scope)",
          "attributes": {
            "name": "item[1]"
          },
          "sources": "[item[0]]",
          "reason": "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
        }
      }
    }
  },
  "coordinates": {
    "systems": {
      "canvas": {
        "kind": "cartesian",
        "x": {
          "kind": "linear"
        },
        "y": {
          "kind": "linear"
        },
        "doc": "Free canvas units; nothing snaps. The computed layout starts at (40, 90), below the header."
      }
    }
  },
  "notation": {
    "doc": "Variables dashed, because they are what the query asks for; concrete terms solid, because they are pinned down; OPTIONAL and MINUS frames dashed, GRAPH and SERVICE frames dotted, the rest solid; FILTER, BIND and VALUES as plain text.",
    "theme": {
      "tokens": {
        "color.surface": "#ffffff",
        "color.border": "#e2e8f0",
        "color.node.border": "#8892a6",
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.primary": "limegreen",
        "color.warning": "#b45309",
        "font.size.node": 12,
        "font.size.hint": 11,
        "font.size.small": 10
      },
      "modes": {
        "dark": {
          "color.surface": "#1e293b",
          "color.border": "#334155",
          "color.text": "#f1f5f9",
          "color.text.muted": "#94a3b8",
          "color.warning": "#fbbf24"
        }
      },
      "defaultMode": "light",
      "followSystem": true
    },
    "styles": {
      "node": {
        "fill": {
          "token": "color.surface"
        },
        "stroke": {
          "color": {
            "token": "color.node.border"
          },
          "width": 1.5
        },
        "font": {
          "size": {
            "token": "font.size.node"
          },
          "color": {
            "token": "color.text"
          }
        },
        "textAlign": "center"
      },
      "variable": {
        "extends": "node",
        "stroke": {
          "dash": [
            5,
            3
          ]
        }
      },
      "hint": {
        "font": {
          "size": {
            "token": "font.size.hint"
          },
          "color": {
            "token": "color.text.muted"
          }
        }
      },
      "frame": {
        "fill": "transparent",
        "stroke": {
          "color": {
            "token": "color.border"
          },
          "width": 1
        }
      }
    },
    "nodes": {
      "Term": {
        "shape": "rect",
        "style": "node",
        "size": {
          "fixed": [
            170,
            64
          ]
        },
        "labels": [
          {
            "id": "display",
            "text": {
              "attribute": "display"
            },
            "position": {
              "anchor": [
                0.5,
                0.5
              ],
              "offset": [
                0,
                2
              ]
            },
            "editable": false,
            "wrap": "none",
            "overflow": "ellipsis",
            "maxWidth": "parent"
          }
        ],
        "anchors": {
          "mode": "outline"
        },
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "refusals": {
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        }
      },
      "Variable": {
        "shape": "rect",
        "style": "variable",
        "size": {
          "fixed": [
            170,
            64
          ]
        },
        "labels": [
          {
            "id": "display",
            "text": {
              "attribute": "display"
            },
            "position": {
              "anchor": [
                0.5,
                0.5
              ],
              "offset": [
                0,
                2
              ]
            },
            "editable": false,
            "wrap": "none",
            "overflow": "ellipsis",
            "maxWidth": "parent"
          },
          {
            "id": "definition",
            "text": {
              "attribute": "definingExpression"
            },
            "editable": false,
            "position": {
              "anchor": [
                0,
                1
              ],
              "offset": [
                8,
                -10
              ],
              "align": "start"
            },
            "style": {
              "font": {
                "size": {
                  "token": "font.size.small"
                },
                "color": {
                  "token": "color.text.muted"
                }
              }
            },
            "visible": {
              "cel": "self.definingExpression != ''"
            },
            "wrap": "none"
          }
        ],
        "badges": [
          {
            "id": "projected",
            "position": "top-left",
            "offset": [
              8,
              16
            ],
            "text": "→",
            "style": {
              "font": {
                "size": 12,
                "color": {
                  "token": "color.primary"
                }
              }
            },
            "visible": {
              "cel": "self.projected"
            }
          }
        ],
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "refusals": {
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        },
        "doc": "Dashed, because a variable is what the query asks for; the arrow marks what leaves the query without consulting the header."
      },
      "AnonymousVariable": {
        "shape": "rect",
        "style": {
          "extends": "variable",
          "opacity": 0.7
        },
        "size": {
          "fixed": [
            170,
            64
          ]
        },
        "labels": [
          {
            "id": "display",
            "text": {
              "attribute": "display"
            },
            "position": {
              "anchor": [
                0.5,
                0.5
              ],
              "offset": [
                0,
                2
              ]
            },
            "editable": false,
            "wrap": "none",
            "overflow": "ellipsis",
            "maxWidth": "parent"
          }
        ],
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "refusals": {
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        },
        "doc": "A variable nobody named: present, and visibly provisional. A move is refused with the reason of its ephemeral id rule."
      },
      "Literal": {
        "shape": "rect",
        "style": "node",
        "size": {
          "fixed": [
            170,
            64
          ]
        },
        "labels": [
          {
            "id": "display",
            "text": {
              "attribute": "display"
            },
            "position": {
              "anchor": [
                0.5,
                0.5
              ],
              "offset": [
                0,
                2
              ]
            },
            "editable": false,
            "wrap": "none",
            "overflow": "ellipsis",
            "maxWidth": "parent"
          },
          {
            "id": "annotation",
            "text": {
              "attribute": "annotation"
            },
            "editable": false,
            "position": {
              "anchor": [
                0,
                1
              ],
              "offset": [
                8,
                -10
              ],
              "align": "start"
            },
            "style": {
              "font": {
                "size": {
                  "token": "font.size.small"
                },
                "color": {
                  "token": "color.text.muted"
                }
              }
            },
            "visible": {
              "cel": "self.annotation != ''"
            }
          }
        ],
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "refusals": {
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        },
        "doc": "Square corners, to read as a value rather than a thing; the datatype or language tag sits in the lower left."
      },
      "SubQuery": {
        "shape": "rect",
        "style": {
          "extends": "node",
          "stroke": {
            "width": 2
          }
        },
        "size": {
          "fixed": [
            170,
            64
          ]
        },
        "labels": [
          {
            "id": "display",
            "text": {
              "attribute": "display"
            },
            "position": {
              "anchor": [
                0.5,
                0.5
              ],
              "offset": [
                0,
                2
              ]
            },
            "editable": false,
            "wrap": "none",
            "overflow": "ellipsis",
            "maxWidth": "parent"
          },
          {
            "id": "marker",
            "text": "subquery",
            "editable": false,
            "position": {
              "anchor": [
                0,
                1
              ],
              "offset": [
                8,
                -10
              ],
              "align": "start"
            },
            "style": {
              "font": {
                "size": {
                  "token": "font.size.small"
                },
                "color": {
                  "token": "color.text.muted"
                }
              }
            }
          }
        ],
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "refusals": {
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        },
        "doc": "A heavier outline marks a collapsed subquery: one level of honesty beats nested unreadability."
      },
      "Scope": {
        "shape": "rect",
        "style": "frame",
        "labels": [
          {
            "id": "label",
            "text": {
              "attribute": "label"
            },
            "position": "outside-top",
            "editable": false,
            "style": "hint",
            "visible": {
              "cel": "self.label != ''"
            }
          }
        ],
        "container": {
          "layout": "grid",
          "columns": 3,
          "gap": 60,
          "padding": 36,
          "header": {
            "size": 30,
            "side": "top"
          },
          "clip": false
        },
        "size": {
          "min": [
            170,
            94
          ],
          "autoSize": "fitContent",
          "resizable": false
        },
        "layer": "background",
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "variants": [
          {
            "when": "self.scopeKind == 'optional' || self.scopeKind == 'minus'",
            "style": {
              "extends": "frame",
              "stroke": {
                "dash": [
                  4,
                  4
                ]
              }
            }
          },
          {
            "when": "self.scopeKind == 'graph' || self.scopeKind == 'service'",
            "style": {
              "extends": "frame",
              "stroke": {
                "dash": [
                  2,
                  3
                ]
              }
            }
          }
        ],
        "refusals": {
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        },
        "doc": "A frame behind its contents; edges cross its border to reach what lives outside it. A stored position moves the frame and what layout placed inside it (gap 5 of sparql-query.md)."
      },
      "Annotation": {
        "shape": "text",
        "style": "hint",
        "size": {
          "default": [
            120,
            14
          ],
          "resizable": false
        },
        "labels": [
          {
            "id": "text",
            "text": {
              "attribute": "text"
            },
            "position": "center",
            "editable": false,
            "wrap": "none"
          }
        ],
        "layer": "foreground",
        "deletable": false,
        "copyable": false,
        "connectable": false,
        "doubleClick": "none",
        "refusals": {
          "move": [
            "An annotation stays with what it constrains; move that instead."
          ],
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        }
      }
    },
    "edges": {
      "TriplePattern": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5
          },
          "routing": "straight",
          "bendpoints": {
            "editable": false
          }
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "predicate",
            "text": {
              "attribute": "predicate"
            },
            "at": "middle",
            "side": "above",
            "distance": 6,
            "editable": false,
            "draggable": false,
            "style": "hint"
          }
        ],
        "variants": [
          {
            "when": "self.isPath",
            "doc": "A property path is a multi-step ask, and says so.",
            "line": {
              "stroke": {
                "color": {
                  "token": "color.text.muted"
                },
                "width": 1.5,
                "dash": [
                  6,
                  2
                ]
              },
              "routing": "straight"
            }
          }
        ],
        "deletable": false,
        "reconnectable": false,
        "layer": "belowNodes",
        "refusals": {
          "move": [
            "An edge is drawn between its endpoints; move one of those instead."
          ],
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        }
      },
      "ProjectedJoin": {
        "line": {
          "stroke": {
            "color": {
              "token": "color.text.muted"
            },
            "width": 1.5
          },
          "routing": "straight",
          "bendpoints": {
            "editable": false
          }
        },
        "sourceMarker": "none",
        "targetMarker": "arrowFilled",
        "labels": [
          {
            "id": "name",
            "text": {
              "cel": "'?' + self.name"
            },
            "at": "middle",
            "side": "above",
            "distance": 6,
            "editable": false,
            "draggable": false,
            "style": "hint"
          }
        ],
        "deletable": false,
        "reconnectable": false,
        "refusals": {
          "move": [
            "An edge is drawn between its endpoints; move one of those instead."
          ],
          "reparent": [
            "A query's structure comes from its text, so nothing here can be moved into a different group. Dragging changes where an element sits on the canvas."
          ]
        }
      }
    },
    "canvas": {
      "background": {
        "token": "color.surface"
      },
      "header": {
        "rows": [
          {
            "id": "form",
            "text": {
              "attribute": "headerForm"
            },
            "editable": false
          },
          {
            "id": "modifiers",
            "text": {
              "attribute": "modifiers"
            },
            "editable": false,
            "visible": {
              "cel": "self.modifiers != ''"
            }
          }
        ],
        "doc": "The query's form and then its dataset clauses and solution modifiers. For a body that cannot be read it shows the default form, `SELECT` (finding B6, gap 7 of sparql-query.md)."
      }
    }
  },
  "forms": {
    "queryInspector": {
      "for": "diagram",
      "usage": [
        "inspector"
      ],
      "items": [
        {
          "kind": "section",
          "label": "Query",
          "items": [
            {
              "attribute": "headerForm",
              "id": "form",
              "label": "Form",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            },
            {
              "attribute": "modifiers",
              "id": "modifiers",
              "label": "Modifiers",
              "widget": "readonly",
              "readOnlyReasons": [
                "This diagram reads the query; edit the .rq file in a text editor and the diagram follows."
              ]
            }
          ]
