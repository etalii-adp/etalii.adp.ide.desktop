{
  "$schema": "https://etalii.net/adp/disl/schema/0.1/disl.schema.json#/$defs/Specification",
  "disl": "0.1",
  "language": {
    "id": "net.etalii.adp.etalii.supply-chain",
    "version": "0.1.0",
    "label": "Supply chain diagram",
    "doc": {
      "summary": "Where things come from and where they go: sources, processors, producers, integrators, hubs, outlets and consumers in their regions, the flows between them with their volumes, and the whole chain up and down from whatever is selected.",
      "description": "A supply chain diagram follows goods - or energy, data or services - from where they start to where they are used. Every **node** is one of seven **stages** - source, processor, producer, integrator, hub, outlet, consumer - which name roles rather than industries, and may state a **quantity** (a capacity, a stock, a demand) in a **unit** of its own. A **flow** carries a **product** from a supplying node to a consuming one, with a **volume** in a unit of its own; its band is as broad as its volume relative to the heaviest flow counted in the same unit. **Groups** - a region, a company, a tier - are frames drawn around their members, joined by dragging a node inside one.\n\nSelecting a node, a flow or a group traces the chain through it: everything that supplies it, directly or not, is marked upstream, everything it supplies downstream, and the rest is dimmed. A selected node's quantity or flow's volume steps up and down in place, by a step each element states, never below zero. Nodes the document does not place are arranged left to right along the flows.",
      "rationale": "A generic diagram shows that two plants are connected; a supply chain diagram shows how much moves between them and what else depends on it, which is the question a supply chain is read for.",
      "tags": ["supply chain", "logistics", "flows", "value chain", "dependencies"],
      "audience": ["user", "author"],
      "seeAlso": [
        { "title": "Aspects DISL cannot express", "href": "supply-chain.md" },
        { "title": "Standalone module", "href": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/supply-chain" },
        { "title": "Inspiration: the yFiles supply chain showcase", "href": "https://www.yfiles.com/demos/showcase/supply-chain/" }
      ]
    },
    "defaultLocale": "en",
    "authors": [{ "name": "Peter Vrenken" }],
    "license": "Apache-2.0",
    "icon": "mdi:truck-delivery-outline",
    "fileExtension": "supply",
    "requires": { "conformance": "standard" }
  },

  "functions": {
    "uniqueName": {
      "params": [{ "name": "base", "type": "string" }],
      "returns": "string",
      "uses": ["diagram"],
      "cel": "!diagram.nodesOfType('Stage').exists(n, n.name == base) ? base : base + ' ' + string(lists.range(diagram.nodes.size() + 2).filter(i, i >= 2 && !diagram.nodesOfType('Stage').exists(n, n.name == base + ' ' + string(i)))[0])",
      "doc": "The name itself when no node carries it yet, otherwise the name followed by the lowest number from 2 up that makes it unique among the nodes (\"New processor\", \"New processor 2\")."
    },
    "uniqueGroupName": {
      "params": [{ "name": "base", "type": "string" }],
      "returns": "string",
      "uses": ["diagram"],
      "cel": "!diagram.nodesOfType('Group').exists(g, g.name == base) ? base : base + ' ' + string(lists.range(diagram.nodes.size() + 2).filter(i, i >= 2 && !diagram.nodesOfType('Group').exists(g, g.name == base + ' ' + string(i)))[0])",
      "doc": "As uniqueName, among the groups' names (\"New group\", \"New group 2\")."
    },
    "stageLabel": {
      "params": [{ "name": "type", "type": "string" }],
      "returns": "string",
      "cel": "{'Source': 'Source', 'Processor': 'Processor', 'Producer': 'Producer', 'Integrator': 'Integrator', 'Hub': 'Hub', 'Outlet': 'Outlet', 'Consumer': 'Consumer'}[type]",
      "doc": "The stage as a reader names it, and as the card's header shows it in capitals."
    },
    "stageToken": {
      "params": [{ "name": "type", "type": "string" }],
      "returns": "string",
      "cel": "{'Source': 'color.supply.source', 'Processor': 'color.supply.processor', 'Producer': 'color.supply.producer', 'Integrator': 'color.supply.integrator', 'Hub': 'color.supply.hub', 'Outlet': 'color.supply.outlet', 'Consumer': 'color.supply.consumer'}[type]",
      "doc": "The theme token of a stage's colour, which its card's header and share bar carry."
    },
    "stepOf": {
      "params": [{ "name": "e", "type": "Element" }],
      "returns": "double",
      "cel": "has(e.step) && e.step > 0.0 ? e.step : 1.0",
      "doc": "How much one increment adds: the element's own step, or 1 when it states none."
    },
    "formatAmount": {
      "params": [{ "name": "v", "type": "double" }],
      "returns": "string",
      "cel": "formatNumber(v, v != 0.0 && math.abs(v) < 1.0 ? '#,##0.###' : '#,##0.##')",
      "doc": "A quantity or volume as the canvas shows it: grouped thousands, two decimals at most, three below one."
    },
    "bandWidth": {
      "params": [{ "name": "f", "type": "Element" }],
      "returns": "double",
      "uses": ["diagram"],
      "cel": "cel.bind(heaviest, diagram.relationsOfType('Flow').filter(o, o.unit == f.unit).map(o, o.volume).max(), 3.0 + math.round(clamp(heaviest > 0.0 ? f.volume / heaviest : 0.0, 0.0, 1.0) * 15.0))",
      "doc": "A flow's band width in canvas units, from 3 for nothing to 18 for the heaviest flow counted in the same unit: tonnes of ore are compared with tonnes, cars with cars."
    },
    "quantityShare": {
      "params": [{ "name": "n", "type": "Element" }],
      "returns": "double",
      "uses": ["diagram"],
      "cel": "!has(n.quantity) ? 0.0 : cel.bind(largest, diagram.nodesOfType('Stage').filter(o, has(o.quantity) && o.unit == n.unit).map(o, o.quantity).max(), largest > 0.0 ? math.least(1.0, n.quantity / largest) : 0.0)",
      "doc": "A node's quantity as a share of the largest quantity among the nodes counting the same unit, for the bar along the foot of its card."
    }
  },

  "metamodel": {
    "doc": "Seven node types, one per stage, under the abstract Stage; one container type, Group; and one relation type, Flow. A stage node is drawn inside at most one group; a flow runs from one stage node to another.",
    "diagram": {
      "doc": "A supply chain diagram has no diagram-level attributes. The document's version header and any keys it does not model are kept verbatim (see supply-chain.md)."
    },
    "types": {
      "Stage": {
        "abstract": true,
        "doc": {
          "summary": "One stage of the chain: a source, a processor, a producer, an integrator, a hub, an outlet, a consumer.",
          "description": "Which stage a node is is its type. Every stage carries the same attributes; only its header colour and title differ. The stage can be changed afterwards, which retypes the node and keeps every attribute and flow."
        },
        "labelAttribute": "name",
        "attributes": {
          "name": {
            "type": "string",
            "label": "Name",
            "group": "Identity",
            "order": 0,
            "doc": "Drawn on the card under the stage's title, editable in place. When empty, the card shows the node's id."
          },
          "description": {
            "type": "text",
            "label": "Description",
            "markup": "plain",
            "group": "Identity",
            "order": 1,
            "doc": "Prose about the node. Kept in the document and shown in the property grid, never drawn."
          },
          "quantity": {
            "type": "number",
            "label": "Quantity",
            "group": "Amount",
            "order": 2,
            "doc": {
              "summary": "The node's own value - a capacity, a stock, a demand - or nothing.",
              "description": "Shown large on the card with its unit, and as a bar for its share of the largest quantity in the same unit. A node without one shows a dash. The + and - step it, never below zero; an edit refuses a negative value."
            }
          },
          "unit": {
            "type": "string",
            "label": "Unit",
            "group": "Amount",
            "order": 3,
            "doc": "What the quantity counts, free text such as kt LCE or million vehicles. Bars compare only nodes with the same unit."
          },
          "step": {
            "type": "number",
            "label": "Step",
            "group": "Amount",
            "order": 4,
            "doc": "How much one + or - changes the quantity. Unset means 1; zero and negative values are refused."
          }
        }
      },
      "Source": {
        "extends": "Stage",
        "label": "Source",
        "icon": "mdi:tray-arrow-up",
        "doc": "Where something enters the chain: a mine, a well, a farm, a data feed.",
        "tags": ["origin", "extraction", "input"],
        "x-supplyChain": { "documentType": "source", "legacyDocumentTypes": ["raw-material"] }
      },
      "Processor": {
        "extends": "Stage",
        "label": "Processor",
        "icon": "mdi:cog-outline",
        "doc": "Turns what it receives into material others can use.",
        "tags": ["refining", "processing", "conversion"],
        "x-supplyChain": { "documentType": "processor", "legacyDocumentTypes": ["supplier"] }
      },
      "Producer": {
        "extends": "Stage",
        "label": "Producer",
        "icon": "mdi:factory",
        "doc": "Makes the parts or components something is built from.",
        "tags": ["plant", "components", "production"],
        "x-supplyChain": { "documentType": "producer", "legacyDocumentTypes": ["manufacturer"] }
      },
      "Integrator": {
        "extends": "Stage",
        "label": "Integrator",
        "icon": "mdi:puzzle-outline",
        "doc": "Combines parts into the finished whole.",
        "tags": ["assembly", "integration"],
        "x-supplyChain": { "documentType": "integrator", "legacyDocumentTypes": ["assembler"] }
      },
      "Hub": {
        "extends": "Stage",
        "label": "Hub",
        "icon": "mdi:hub-outline",
        "doc": "Holds and moves what is finished on to where it is wanted.",
        "tags": ["distribution", "warehouse", "logistics"],
        "x-supplyChain": { "documentType": "hub", "legacyDocumentTypes": ["distributor"] }
      },
      "Outlet": {
        "extends": "Stage",
        "label": "Outlet",
        "icon": "mdi:storefront-outline",
        "doc": "Where the finished whole is offered to those who use it.",
        "tags": ["shop", "channel", "point of sale"],
        "x-supplyChain": { "documentType": "outlet", "legacyDocumentTypes": ["retailer"] }
      },
      "Consumer": {
        "extends": "Stage",
        "label": "Consumer",
        "icon": "mdi:account-outline",
        "doc": "Where the chain ends: whoever uses what it delivers.",
        "tags": ["customer", "user", "market"],
        "x-supplyChain": { "documentType": "consumer" }
      },
      "Group": {
        "label": "Group",
        "icon": "mdi:group",
        "labelAttribute": "name",
        "doc": {
          "summary": "A region, a company or a tier the nodes inside it belong to.",
          "description": "Drawn as a frame around its members: it follows them, and moving it moves them all. A node joins a group by being dragged inside its frame. A group with no members is drawn where its own x and y place it, as large as the frame around one node; without them it draws nothing. Removing a group keeps its members, ungrouped."
        },
        "attributes": {
          "name": {
            "type": "string",
            "label": "Name",
            "group": "Identity",
            "order": 0,
            "doc": "The frame's title, editable in place. When empty, the frame shows the group's id."
          },
          "description": {
            "type": "text",
            "label": "Description",
            "markup": "plain",
            "group": "Identity",
            "order": 1,
            "doc": "Prose about the group, shown in the property grid only."
          },
          "x": {
            "type": "number",
            "label": "X",
            "group": "Position",
            "order": 2,
            "doc": "The left of the frame while the group has no members, not shown in the property grid (the group form omits it), written when a group is dropped from the palette, when its last member leaves it and when an empty group is dragged. A group with members is drawn around them and ignores it."
          },
          "y": {
            "type": "number",
            "label": "Y",
            "group": "Position",
            "order": 3,
            "doc": "The top of the frame while the group has no members; see x."
          }
        },
        "children": {
          "allowed": ["Stage"],
          "min": 0,
          "max": null,
          "doc": "Membership. A node is in at most one group, and groups do not nest."
        },
        "x-supplyChain": { "documentType": "group" }
      }
    },
    "relations": {
      "Flow": {
        "label": "Flow",
        "icon": "mdi:arrow-right-thin",
        "doc": {
          "summary": "Goods moving from a supplying node to a consuming one.",
          "description": "Any stage may supply any other; the stages name roles, not an order the flows must keep, and goods may come back round. Two flows between the same pair in the same direction are never drawn by hand, while a flow each way is allowed."
        },
        "source": { "types": ["Stage"], "role": "supplier" },
        "target": { "types": ["Stage"], "role": "consumer" },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": true,
        "attributes": {
          "product": {
            "type": "string",
            "label": "Product",
            "group": "Identity",
            "order": 0,
            "doc": "What flows - wafers, HBM stacks, cathodes - drawn above the band's middle and editable in place. An empty product removes the key."
          },
          "description": {
            "type": "text",
            "label": "Description",
            "markup": "plain",
            "group": "Identity",
            "order": 1,
            "doc": "Prose about the flow, shown in the property grid only."
          },
          "volume": {
            "type": "number",
            "label": "Volume",
            "group": "Amount",
            "order": 2,
            "doc": "How much flows, shown in a pill under the band's middle and setting the band's width. A flow without one is drawn at the thinnest width with no pill."
          },
          "unit": {
            "type": "string",
            "label": "Unit",
            "group": "Amount",
            "order": 3,
            "doc": "What the volume counts. Band widths compare only flows with the same unit."
          },
          "step": {
            "type": "number",
            "label": "Step",
            "group": "Amount",
            "order": 4,
            "doc": "How much one + or - changes the volume. Unset means 1; zero and negative values are refused."
          }
        },
        "x-supplyChain": { "documentType": "flow" }
      }
    }
  },

  "coordinates": {
    "doc": "One free canvas in canvas units, y growing downwards. A node's top-left corner is stored when the document places it; otherwise the layout places it. A group's frame with members is never stored: it is the box around them. An empty group's top-left is stored as its x and y, and its frame is as large as the one around a single node, 232 by 156.",
    "systems": {
      "canvas": { "kind": "cartesian", "x": { "kind": "linear" }, "y": { "kind": "linear" },
                  "doc": "Positions are written rounded to whole units." }
    }
  },

  "notation": {
    "doc": "Every node is the same card, 192 by 96, recognisable by its stage's coloured header and title; flows are bands as broad as their volume, with the goods moving along them; groups are dashed frames beneath both. While something is selected, its chain is drawn at full strength, with stronger card outlines, and everything else is dimmed; the trace adds no hue of its own, so the seven stage colours stay the only ones.",
    "theme": {
      "tokens": {
        "color.text": "#0f172a",
        "color.text.muted": "#64748b",
        "color.surface": "#ffffff",
        "color.border": "#e2e8f0",
        "color.supply.source": "#7c4a1e",
        "color.supply.processor": "#b91c1c",
        "color.supply.producer": "#1d4ed8",
        "color.supply.integrator": "#0f766e",
        "color.supply.hub": "#475569",
        "color.supply.outlet": "#15803d",
        "color.supply.consumer": "#be185d",
        "color.supply.on-stage": "#ffffff",
        "color.supply.trace": "#64748b",
        "color.supply.flow": "#64748b",
        "color.supply.goods": "#ffffff",
        "color.supply.group-fill": "#0000000f",
        "color.supply.shadow": "#0f172a24"
      },
      "modes": {
        "dark": {
          "color.text": "#f1f5f9",
          "color.text.muted": "#94a3b8",
          "color.surface": "#1e293b",
          "color.border": "#334155",
          "color.supply.source": "#7c4a1e",
          "color.supply.processor": "#b91c1c",
          "color.supply.producer": "#1d4ed8",
          "color.supply.integrator": "#0f766e",
          "color.supply.hub": "#475569",
          "color.supply.outlet": "#15803d",
          "color.supply.consumer": "#be185d",
          "color.supply.on-stage": "#ffffff",
          "color.supply.trace": "#94a3b8",
          "color.supply.flow": "#94a3b8",
          "color.supply.goods": "#1e293b",
          "color.supply.group-fill": "#ffffff0f",
          "color.supply.shadow": "#00000066"
        }
      },
      "defaultMode": "light",
      "followSystem": true,
      "doc": {
        "summary": "The seven stage hues are the module's own, declared in both modes; dark mode lifts each a step so headers and bands still read on the dark surface.",
        "rationale": "The theme names meanings; seven stage hues are this notation's business. The text, surface, border and muted tokens are the host's shared canvas values, carried here so the specification stands alone."
      }
    },

    "styles": {
      "card": {
        "fill": { "token": "color.surface" },
        "stroke": { "color": { "token": "color.border" }, "width": 1.5 },
        "shadow": { "dx": 0, "dy": 2, "blur": 4, "color": { "token": "color.supply.shadow" } },
        "font": { "size": 12, "color": { "token": "color.text" } },
        "textAlign": "left"
      },
      "cardHover": { "shadow": { "dx": 0, "dy": 6, "blur": 12, "color": { "token": "color.supply.shadow" } } },
      "stageHeader": { "fill": { "cel": "token(stageToken(self.type))" }, "stroke": { "width": 0 } },
      "stageBar": { "fill": { "cel": "token(stageToken(self.type))" }, "stroke": { "width": 0 } },
      "barTrack": { "fill": { "token": "color.border" }, "stroke": { "width": 0 } },
      "stageTitle": { "font": { "size": 10, "weight": 700, "color": { "token": "color.supply.on-stage" } } },
      "nodeName": { "font": { "size": 13, "weight": 600, "color": { "token": "color.text" } } },
      "amount": { "font": { "size": 20, "weight": 700, "color": { "token": "color.text" } } },
      "upstream": { "stroke": { "color": { "token": "color.supply.trace" }, "width": 2.5 } },
      "downstream": { "stroke": { "color": { "token": "color.supply.trace" }, "width": 2.5 } },
      "dimmed": { "opacity": 0.22 },
      "groupFrame": {
        "fill": { "token": "color.supply.group-fill" },
        "stroke": { "color": { "token": "color.border" }, "width": 1.5, "dash": [6, 4], "dashScale": "absolute" },
        "visible": { "cel": "self.children.size() > 0 || (has(self.x) && has(self.y))" }
      },
      "groupTraced": { "stroke": { "dash": "solid" } },
      "groupTitle": { "font": { "size": 13, "weight": 700, "color": { "token": "color.text" } } },
      "groupMembers": { "font": { "size": 11, "color": { "token": "color.text.muted" } } },
      "band": {
        "stroke": { "color": { "token": "color.supply.flow" }, "width": { "cel": "bandWidth(self)" }, "opacity": 0.45, "cap": "round" },
        "font": { "size": 12, "color": { "token": "color.text" } }
      },
      "bandUpstream": { "stroke": { "opacity": 0.9 } },
      "bandDownstream": { "stroke": { "opacity": 0.9 } },
      "volume": { "font": { "size": 10, "weight": 600, "color": { "token": "color.text" } } }
    },

    "shapes": {
      "supplyCard": {
        "label": "Supply chain card",
        "doc": "A card with rounded corners: a header band in the stage's colour across the top, squared where it meets the body, and a 4-unit share bar on a track along the foot, inset 14 on each side and 12 from the bottom.",
        "params": {
          "share": { "type": "number", "unit": "fraction", "default": 0, "min": 0, "max": 1, "persist": "none",
                     "doc": "The node's share of the largest quantity in its unit; bound by the node notation." }
        },
        "parts": [
          { "id": "body", "shape": { "type": "roundedRect", "params": { "radius": 8 } },
            "box": { "x": 0, "y": 0, "w": "w", "h": "h" }, "outline": true },
          { "id": "header",
            "shape": { "path": { "segments": [
              { "op": "M", "x": 0, "y": 24 },
              { "op": "L", "x": 0, "y": 8 },
              { "op": "Q", "cx": 0, "cy": 0, "x": 8, "y": 0 },
              { "op": "L", "x": "w - 8.0", "y": 0 },
              { "op": "Q", "cx": "w", "cy": 0, "x": "w", "y": 8 },
              { "op": "L", "x": "w", "y": 24 },
              { "op": "Z" }
            ] } },
            "box": { "x": 0, "y": 0, "w": "w", "h": 24 } },
          { "id": "barTrack", "shape": { "type": "roundedRect", "params": { "radius": 2 } },
            "box": { "x": 14, "y": "h - 12.0", "w": "w - 28.0", "h": 4 } },
          { "id": "bar", "shape": { "type": "roundedRect", "params": { "radius": 2 } },
            "box": { "x": 14, "y": "h - 12.0", "w": "max(4.0, (w - 28.0) * p.share)", "h": 4 },
            "when": "has(self.quantity)" }
        ]
      }
    },

    "nodes": {
      "Stage": {
        "shape": { "type": "supplyCard", "params": { "share": { "cel": "quantityShare(self)" } } },
        "style": "card",
        "partStyles": { "header": "stageHeader", "barTrack": "barTrack", "bar": "stageBar" },
        "size": { "fixed": [192, 96] },
        "labels": [
          { "id": "stage", "text": { "cel": "upper(stageLabel(self.type))" }, "position": { "anchor": [0, 0], "offset": [14, 16] },
            "style": "stageTitle", "editable": false, "wrap": "none" },
          { "id": "name", "text": { "attribute": "name" }, "position": { "anchor": [0, 0], "offset": [14, 46] },
            "style": "nodeName", "editable": "inline", "wrap": "none", "overflow": "ellipsis", "maxWidth": 164 },
          { "id": "amount", "text": { "cel": "has(self.quantity) ? formatAmount(self.quantity) + (self.unit != '' ? ' ' + self.unit : '') : '—'" },
            "position": { "anchor": [0, 0], "offset": [14, 74] }, "style": "amount", "editable": false, "wrap": "none", "overflow": "ellipsis" }
        ],
        "anchors": { "mode": "sides" },
        "tooltip": { "cel": "stageLabel(self.type) + ': ' + (self.name != '' ? self.name : self.id) + (has(self.quantity) ? ' — ' + formatAmount(self.quantity) + (self.unit != '' ? ' ' + self.unit : '') : '')" },
        "states": { "hover": "cardHover" },
        "conditions": [
          { "when": "traceOf(self) == 'upstream'", "style": "upstream", "doc": "It supplies the selection, directly or not." },
          { "when": "traceOf(self) == 'downstream'", "style": "downstream", "doc": "The selection supplies it, directly or not." },
          { "when": "traceOf(self) == 'dimmed'", "style": "dimmed", "doc": "Off the traced chain." }
        ],
        "doubleClick": "editLabel",
        "doc": "One card for all seven stages; the header's colour and title come from the node's type. Flows attach at the middle of the left and right sides."
      },
      "Group": {
        "shape": { "type": "roundedRect", "params": { "radius": 8 } },
        "style": "groupFrame",
        "size": { "autoSize": "fitContent", "resizable": false },
        "labels": [
          { "id": "name", "text": { "attribute": "name" }, "position": { "anchor": [0, 0], "offset": [16, 26] },
            "style": "groupTitle", "editable": "inline", "wrap": "none", "overflow": "ellipsis" },
          { "id": "members", "text": { "cel": "string(self.children.size()) + (self.children.size() == 1 ? ' node' : ' nodes')" },
            "position": { "anchor": [1, 0], "offset": [-16, 26], "align": "end" }, "style": "groupMembers", "editable": false }
        ],
        "container": {
          "layout": "free",
          "padding": [40, 20, 20, 20],
          "header": { "size": 40, "side": "top" },
          "autoGrow": true,
          "doc": "The frame is the box around its members: 20 beyond them left, right and below, and 40 above them for the title. With no members it stands at the group's own x and y, 232 by 156, the frame around one node (see supply-chain.md)."
        },
        "connectable": false,
        "layer": "background",
        "conditions": [
          { "when": "traceOf(self) in ['selected', 'related']", "style": "groupTraced", "doc": "A member is on the traced chain: the frame's dashes close." },
          { "when": "traceOf(self) == 'dimmed'", "style": "dimmed" }
        ],
        "doubleClick": "editLabel",
        "doc": "Drawn beneath the flows, so a band crosses a frame rather than hiding behind it."
      }
    },

    "edges": {
      "Flow": {
        "style": "band",
        "line": { "routing": "bezier", "startDirection": "normal", "endDirection": "normal", "bendpoints": { "editable": false } },
        "anchoring": {
          "source": { "mode": "sides" },
          "target": { "mode": "sides" }
        },
        "sourceMarker": "none",
        "targetMarker": { "type": "arrowFilled", "params": {
          "scaleWithStroke": false,
          "length": { "cel": "7.0 + bandWidth(self) / 3.0" },
          "width": { "cel": "1.4 * (7.0 + bandWidth(self) / 3.0)" } } },
        "midMarkers": [
          { "marker": { "type": "dot", "params": { "fill": { "token": "color.supply.goods" } } }, "repeat": { "spacing": 14 },
            "visible": { "cel": "traceOf(self) != 'dimmed'" },
            "doc": "The goods: dots along the band in the direction they go. The implementation animates them (see supply-chain.md)." }
        ],
        "labels": [
          { "id": "product", "text": { "attribute": "product" }, "at": "middle", "side": "above", "distance": 8, "editable": "inline" },
          { "id": "volume", "text": { "cel": "formatAmount(self.volume) + (self.unit != '' ? ' ' + self.unit : '')" },
            "at": "middle", "side": "below", "distance": 4, "style": "volume", "editable": false,
            "background": { "fill": { "token": "color.surface" }, "stroke": { "color": { "token": "color.border" }, "width": 1 },
                            "padding": [3, 8], "cornerRadius": 9 },
            "visible": { "cel": "has(self.volume)" } }
        ],
        "states": { "hover": { "stroke": { "opacity": 0.8 } } },
        "conditions": [
          { "when": "traceOf(self) == 'upstream'", "style": "bandUpstream" },
          { "when": "traceOf(self) == 'downstream'", "style": "bandDownstream" },
          { "when": "traceOf(self) == 'dimmed'", "style": "dimmed" }
        ],
        "tooltip": { "cel": "self.product" },
        "reconnectable": false,
        "layer": "belowNodes",
        "doc": "A horizontal S from the middle of the supplier's facing side to the middle of the consumer's, leaving and arriving square to the side, its width following its weight, with an arrowhead at the consumer."
      }
    },

    "canvas": { "minimap": false }
  },

  "forms": {
    "stage": {
      "for": ["Stage"],
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "name" },
          { "kind": "computed", "label": "Stage", "value": { "cel": "stageLabel(self.type)" },
            "doc": "A choice of the seven stages in the implementation; choosing one retypes the node (see supply-chain.md)." },
          { "kind": "computed", "label": "Group", "value": { "cel": "self.parent != null ? (self.parent.name != '' ? self.parent.name : self.parent.id) : '(none)'" },
            "doc": "A choice of the diagram's groups and (none) in the implementation; choosing one moves the node into that group (see supply-chain.md)." },
          { "attribute": "description", "widget": "textarea", "rows": 3 }
        ] },
        { "kind": "section", "title": "Amount", "items": [
          { "attribute": "quantity", "widget": "number" },
          { "attribute": "unit" },
          { "attribute": "step", "widget": "number" }
        ] }
      ]
    },
    "flow": {
      "for": ["Flow"],
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "product" },
          { "attribute": "description", "widget": "textarea", "rows": 3 }
        ] },
        { "kind": "section", "title": "Amount", "items": [
          { "attribute": "volume", "widget": "number" },
          { "attribute": "unit" },
          { "attribute": "step", "widget": "number" }
        ] }
      ]
    },
    "group": {
      "for": ["Group"],
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "name" },
          { "attribute": "description", "widget": "textarea", "rows": 3 }
        ] }
      ]
    }
  },

  "toolbox": {
    "groups": [
      { "id": "stages", "label": "Stages", "doc": "One tool per stage, in the order goods pass through them; each carries the stage's own icon. A flow has no palette tool: it is drawn from a node's side, or by dragging with the right button from one node to another.", "tools": [
        { "id": "source", "creates": "Source", "label": "Source", "icon": "mdi:tray-arrow-up", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Where something enters the chain: a mine, a well, a farm, a data feed." },
        { "id": "processor", "creates": "Processor", "label": "Processor", "icon": "mdi:cog-outline", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Turns what it receives into material others can use." },
        { "id": "producer", "creates": "Producer", "label": "Producer", "icon": "mdi:factory", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Makes the parts or components something is built from." },
        { "id": "integrator", "creates": "Integrator", "label": "Integrator", "icon": "mdi:puzzle-outline", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Combines parts into the finished whole." },
        { "id": "hub", "creates": "Hub", "label": "Hub", "icon": "mdi:hub-outline", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Holds and moves what is finished on to where it is wanted." },
        { "id": "outlet", "creates": "Outlet", "label": "Outlet", "icon": "mdi:storefront-outline", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Where the finished whole is offered to those who use it." },
        { "id": "consumer", "creates": "Consumer", "label": "Consumer", "icon": "mdi:account-outline", "mode": "click", "after": "select",
          "initial": { "quantity": 0 }, "doc": "Where the chain ends: whoever uses what it delivers." }
      ] },
      { "id": "frames", "label": "Frames", "doc": "A group dropped on its own, named \"New group\" and numbered from 2 when the name is taken among the groups; it is drawn empty at the drop until nodes are dragged into it.", "tools": [
        { "id": "group", "creates": "Group", "label": "Group", "icon": "mdi:group", "mode": "click", "after": "select",
          "doc": "A frame for a region, a company or a tier; drag nodes into it." }
      ] }
    ],
    "contextTools": [
      { "for": ["Stage"], "placement": "around", "tools": [
        { "kind": "operation", "operation": "decreaseQuantity", "label": "Decrease the quantity", "icon": "mdi:minus", "position": { "anchor": [0, 0], "offset": [141, 68] } },
        { "kind": "operation", "operation": "increaseQuantity", "label": "Increase the quantity", "icon": "mdi:plus", "position": { "anchor": [0, 0], "offset": [167, 68] } },
        { "kind": "connect", "via": "Flow", "label": "Add flow", "icon": "mdi:arrow-right-thin", "position": "right",
          "doc": "Drag from a side of the node to another node; the node dragged from supplies the one dropped on." }
      ] },
      { "for": ["Flow"], "placement": "around", "tools": [
        { "kind": "operation", "operation": "decreaseVolume", "label": "Decrease the volume", "icon": "mdi:minus", "position": "bottom-left" },
        { "kind": "operation", "operation": "increaseVolume", "label": "Increase the volume", "icon": "mdi:plus", "position": "bottom-right" }
      ] }
    ],
    "contextMenus": [
      { "for": ["Stage"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "increaseQuantity", "label": "Increase quantity", "icon": "mdi:plus-circle-outline", "shortcut": "+" },
        { "kind": "operation", "operation": "decreaseQuantity", "label": "Decrease quantity", "icon": "mdi:minus-circle-outline", "shortcut": "-" },
        { "kind": "editLabel", "label": "Rename…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
        { "kind": "operation", "operation": "putInNewGroup", "label": "Put in a new group…", "icon": "mdi:group" },
        { "kind": "delete", "label": "Remove", "icon": "mdi:delete-outline", "shortcut": "Delete" },
        { "kind": "operation", "operation": "arrange", "label": "Arrange diagram", "icon": "mdi:sitemap-outline" }
      ] },
      { "for": ["Flow"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "increaseVolume", "label": "Increase volume", "icon": "mdi:plus-circle-outline", "shortcut": "+" },
        { "kind": "operation", "operation": "decreaseVolume", "label": "Decrease volume", "icon": "mdi:minus-circle-outline", "shortcut": "-" },
        { "kind": "editLabel", "label": "Rename product…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove flow", "icon": "mdi:vector-polyline-remove", "shortcut": "Delete" }
      ] },
      { "for": ["Group"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "editLabel", "label": "Rename…", "icon": "mdi:pencil-outline", "shortcut": "F2" },
        { "kind": "delete", "label": "Remove group", "icon": "mdi:ungroup", "shortcut": "Delete" },
        { "kind": "operation", "operation": "arrange", "label": "Arrange diagram", "icon": "mdi:sitemap-outline" }
      ] }
    ]
  },

  "constraints": {
    "doc": "Endpoints, self-flows and references are checked by the built-ins; the rules below add what the implementation reports or refuses beyond them. A document edited outside ADP that breaks them still opens and draws everything that can be drawn, and each breach is reported on its line.",
    "blockSaveOn": "never",
    "builtIn": {
      "std.endpoints": { "severity": "error" },
      "std.references": { "severity": "error" },
      "std.typeExists": { "severity": "warning" },
      "std.containment": { "severity": "error" }
    },
    "rules": [
      {
        "id": "selfFlow",
        "label": "Flow to itself",
        "scope": ["Flow"],
        "rule": "self.source.id != self.target.id",
        "severity": "error",
        "message": { "cel": "'The flow `' + self.id + '` runs from `' + self.source.id + '` to itself and is not drawn.'" },
        "doc": "Readable only from a hand-edited file; drawing one is refused.",
        "x-adp-ruleId": "supply-chain.self-flow"
      },
      {
        "id": "emptyGroup",
        "label": "Empty group",
        "scope": ["Group"],
        "rule": "self.children.size() > 0 || (has(self.x) && has(self.y))",
        "severity": "warning",
        "message": { "cel": "'The group `' + self.id + '` has no nodes and no `x` and `y`, so it is not drawn.'" },
        "doc": "A group is a frame around its members, or at its own x and y when it has none; with neither it has nothing to draw.",
        "x-adp-ruleId": "supply-chain.empty-group"
      },
      {
        "id": "noSelfFlowWhileDrawing",
        "label": "No flow to itself",
        "kind": "connect",
        "when": "relationType == 'Flow'",
        "rule": "source.id != target.id",
        "enforcement": "prevent",
        "message": "A node does not supply itself."
      },
      {
        "id": "noSecondFlowWhileDrawing",
        "label": "One flow per direction",
        "kind": "connect",
        "when": "relationType == 'Flow'",
        "rule": "!source.outgoingOf('Flow').exists(f, f.target.id == target.id)",
        "enforcement": "prevent",
        "message": "These two are already connected by a flow in this direction.",
        "doc": "Drawing refuses a second flow between the same pair in the same direction; a flow back the other way is allowed. A file holding two is drawn as it is and not reported."
      },
      {
        "id": "noNegativeAmount",
        "label": "No negative amount",
        "kind": "change",
        "scope": ["Stage", "Flow"],
        "when": "attribute in ['quantity', 'volume', 'step']",
        "rule": "newValue >= 0.0",
        "enforcement": "prevent",
        "message": { "cel": "'\\'' + string(newValue) + '\\' is not an amount this diagram can hold: a number of zero or more.'" }
      },
      {
        "id": "noZeroStep",
        "label": "No zero step",
        "kind": "change",
        "scope": ["Stage", "Flow"],
        "when": "attribute == 'step'",
        "rule": "newValue != 0.0",
        "enforcement": "prevent",
        "message": "A step of zero would make + and − do nothing."
      }
    ]
  },

  "behavior": {
    "doc": "Every change - add, remove, move, connect, rename, step, set a property, group, arrange - is one undoable step that restores the document's whole text. Dragging a node whose centre lands inside another group's frame moves it into that group in the same step (see supply-chain.md, section 'Interaction').",
    "hooks": [
      {
        "id": "nameNewStage",
        "on": "create",
        "for": ["Stage"],
        "when": "!has(self.name)",
        "actions": [
          { "set": { "name": "uniqueName('New ' + lower(stageLabel(self.type)))" } }
        ],
        "doc": "A new node is named after its stage - \"New source\", \"New processor\" - numbered from 2 when the name is taken."
      },
      {
        "id": "nameNewGroup",
        "on": "create",
        "for": ["Group"],
        "when": "!has(self.name)",
        "actions": [
          { "set": { "name": "uniqueGroupName('New group')" } }
        ],
        "doc": "A group dropped from the palette is named \"New group\", numbered from 2 when the name is taken among the groups, and placed with its frame centred on the drop."
      }
    ],
    "operations": {
      "increaseQuantity": {
        "label": "Increase quantity",
        "icon": "mdi:plus-circle-outline",
        "shortcut": "+",
        "for": ["Stage"],
        "actions": [
          { "set": { "quantity": "math.round((self.quantity + stepOf(self)) * 10000.0) / 10000.0" } }
        ],
        "doc": "Adds the node's step to its quantity; a node with no quantity starts from zero. Rounded to four decimals, so ten steps of 0.1 come back to a whole number."
      },
      "decreaseQuantity": {
        "label": "Decrease quantity",
        "icon": "mdi:minus-circle-outline",
        "shortcut": "-",
        "for": ["Stage"],
        "enabled": "self.quantity > 0.0",
        "actions": [
          { "if": "self.quantity <= 0.0", "then": [ { "abort": { "message": "'The quantity is already zero.'" } } ] },
          { "set": { "quantity": "math.greatest(0.0, math.round((self.quantity - stepOf(self)) * 10000.0) / 10000.0)" } }
        ],
        "doc": "Takes the node's step from its quantity, never below zero."
      },
      "increaseVolume": {
        "label": "Increase volume",
        "icon": "mdi:plus-circle-outline",
        "shortcut": "+",
        "for": ["Flow"],
        "actions": [
          { "set": { "volume": "math.round((self.volume + stepOf(self)) * 10000.0) / 10000.0" } }
        ],
        "doc": "Adds the flow's step to its volume; a flow with no volume starts from zero."
      },
      "decreaseVolume": {
        "label": "Decrease volume",
        "icon": "mdi:minus-circle-outline",
        "shortcut": "-",
        "for": ["Flow"],
        "enabled": "self.volume > 0.0",
        "actions": [
          { "if": "self.volume <= 0.0", "then": [ { "abort": { "message": "'The volume is already zero.'" } } ] },
          { "set": { "volume": "math.greatest(0.0, math.round((self.volume - stepOf(self)) * 10000.0) / 10000.0)" } }
        ],
        "doc": "Takes the flow's step from its volume, never below zero."
      },
      "putInNewGroup": {
        "label": "Put in a new group…",
        "icon": "mdi:group",
        "for": ["Stage"],
        "params": {
          "groupName": { "type": "string", "label": "Group name", "required": true }
        },
        "actions": [
          { "if": "p.groupName.trim() == ''", "then": [ { "abort": { "message": "'A group needs a name.'" } } ] },
          { "create": { "type": "'Group'", "attributes": { "name": "p.groupName.trim()" } }, "as": "group" },
          { "reparent": { "target": "self", "parent": "group" } }
        ],
        "doc": "A new group around this one node. A group can also be dropped from the palette, and drawn empty until nodes are dragged into it."
      },
      "arrange": {
        "label": "Arrange diagram",
        "icon": "mdi:sitemap-outline",
        "for": "diagram",
        "enabled": "diagram.nodesOfType('Stage').size() > 0",
        "actions": [
          { "layout": { "scope": "diagram.nodes", "algorithm": "chain" } }
        ],
        "doc": "Lays the whole diagram out left to right and writes every node's position, whatever the document stated before. Refused with \"There is nothing to arrange until this diagram has a node.\" on an empty diagram."
      }
    },
    "retype": {
      "Source": { "to": ["Processor", "Producer", "Integrator", "Hub", "Outlet", "Consumer"] },
      "Processor": { "to": ["Source", "Producer", "Integrator", "Hub", "Outlet", "Consumer"] },
      "Producer": { "to": ["Source", "Processor", "Integrator", "Hub", "Outlet", "Consumer"] },
      "Integrator": { "to": ["Source", "Processor", "Producer", "Hub", "Outlet", "Consumer"] },
      "Hub": { "to": ["Source", "Processor", "Producer", "Integrator", "Outlet", "Consumer"] },
      "Outlet": { "to": ["Source", "Processor", "Producer", "Integrator", "Hub", "Consumer"] },
      "Consumer": { "to": ["Source", "Processor", "Producer", "Integrator", "Hub", "Outlet"] }
    },
    "deletion": {
      "Stage": { "relations": "delete", "confirm": "Removing this node also removes the flows to or from it.",
                 "doc": "Removing a node removes every flow to or from it in the same undoable step. It asks first only when there are such flows, naming how many (see supply-chain.md)." },
      "Group": { "children": "reparent", "relations": "delete",
                 "doc": "Removing a group keeps its members where they are, ungrouped, so nothing is lost and nothing is asked." }
    }
  },

  "layout": {
    "doc": "Nodes the document does not place are arranged left to right along the flows, over the whole document, with each group kept together in a band of its own. A stored position wins over the computed one node by node, so dragging one node moves nobody else. Arrange diagram writes the computed position of every node.",
    "algorithms": {
      "chain": {
        "algorithm": "plugin:net.etalii.adp.etalii.supplyChainLayers",
        "direction": "right",
        "spacing": { "node": 28, "layer": 128 },
        "doc": "Layers by the longest path from a node nothing supplies, with every cycle broken at the flow that closes it; bands per group; barycentre ordering; bands dropped onto a per-layer skyline. Details in supply-chain.md, section 'Layout'."
      }
    },
    "default": "chain",
    "trigger": "always",
    "respect": "all",
    "incremental": true,
    "animate": false
  },

  "persistence": {
    "format": "plugin:net.etalii.adp.etalii.supply",
    "encoding": "utf-8",
    "newline": "crlf",
    "files": { "mode": "single", "model": "{name}.supply" },
    "ids": { "strategy": "nanoid", "stable": true,
             "doc": "New ids are 25-character lowercase base-36 GUIDs (ShortGuid); hand-written ids such as kolwezi-cobalt are equally valid. Groups, nodes and flows share one id space." },
    "ordering": { "elements": "creation" },
    "omitDefaults": true,
    "precision": { "canvas": 0, "numbers": 4 },
    "view": { "store": ["bounds"] },
    "definition": { "embed": "none" },
    "doc": "A supply chain diagram is stored in a .supply file: YAML with a version header 'supply-chain: 1' and 'groups', 'nodes' and 'flows' lists, registered by an .adp file whose origin is etalii/supply-chain. A document ADP did not change is written back byte-identical, and an edit rewrites only the lines that change. The exact format is in supply-chain.md."
  },

  "plugins": {
    "net.etalii.adp.etalii.supply": {
      "version": "^1.0.0",
      "provides": ["persistenceFormat", "celFunctions"],
      "required": true,
      "doc": "Reads and writes the .supply document (`supply-chain: 1`) by line splices, so comments, blank lines, indentation, line endings, unknown keys and a missing final newline survive every edit; and traces the chain through the viewer's selection, which DISL 0.1 expressions cannot read.",
      "celFunctions": [
        { "name": "traceOf", "params": ["Element"], "returns": "string", "cost": 100,
          "doc": "The element's marking while something in this diagram is selected: 'selected', 'upstream' (it supplies the selection, directly or not), 'downstream' (the selection supplies it), 'related' (a group with a member on the chain) or 'dimmed' (off the chain); '' when nothing is selected. Per viewer, never stored. Rules in supply-chain.md, section 'The trace'." }
      ]
    },
    "net.etalii.adp.etalii.supplyChainLayers": {
      "version": "^1.0.0",
      "provides": ["layout"],
      "required": false,
      "fallback": { "layout": "layered" },
      "doc": "The banded layered layout; supply-chain.md, section 'Layout'."
    }
  },

  "x-adp": {
    "origin": "etalii/supply-chain",
    "kind": "Diagram",
    "state": "Prototype",
    "companion": "supply-chain.md"
  }
}
