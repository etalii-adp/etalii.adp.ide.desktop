              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "severity": {
              "key": "severity",
              "child": "spec",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "conditionKind": {
              "key": "kind",
              "child": "spec/condition",
              "empty": "remove"
            },
            "op": {
              "key": "op",
              "child": "spec/condition",
              "empty": "remove"
            },
            "threshold": {
              "key": "threshold",
              "child": "spec/condition",
              "empty": "remove",
              "number": "shortest"
            },
            "lookbackWindow": {
              "key": "lookbackWindow",
              "child": "spec/condition",
              "read": "text",
              "empty": "remove"
            },
            "alertAfter": {
              "key": "alertAfter",
              "child": "spec/condition",
              "read": "text",
              "empty": "remove"
            },
            "inline": {
              "value": "true"
            }
          },
          "files": [
            "yaml",
            "yml"
          ]
        },
        {
          "name": "alertNotificationTarget",
          "type": "AlertNotificationTarget",
          "doc": "A document of kind AlertNotificationTarget: one element, named by metadata.name (research R3).",
          "at": "/",
          "when": "type(entry) == map && has(entry.apiVersion) && entry.apiVersion == 'openslo/v1' && has(entry.kind) && entry.kind == 'AlertNotificationTarget'",
          "attributes": {
            "name": {
              "key": "name",
              "child": "metadata",
              "empty": "refuse"
            },
            "displayName": {
              "key": "displayName",
              "child": "metadata",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "description": {
              "key": "description",
              "child": "spec",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "target": {
              "key": "target",
              "child": "spec",
              "empty": "refuse"
            }
          },
          "remove": {},
          "files": [
            "yaml",
            "yml"
          ]
        },
        {
          "name": "inlineAlertNotificationTarget",
          "type": "AlertNotificationTarget",
          "doc": "A notification target written inline in an alert policy's spec.notificationTargets, with kind AlertNotificationTarget.",
          "at": "/**/spec/notificationTargets/*",
          "when": "type(entry) == map && has(entry.kind) && entry.kind == 'AlertNotificationTarget' && parent != null && type(parent) == map && has(parent.kind) && parent.kind == 'AlertPolicy' && (!has(parent.apiVersion) || parent.apiVersion == 'openslo/v1')",
          "parent": {
            "rules": [
              "alertPolicy",
              "inlineAlertPolicy"
            ],
            "slot": "notificationTargets"
          },
          "attributes": {
            "name": {
              "key": "name",
              "child": "metadata",
              "empty": "refuse"
            },
            "displayName": {
              "key": "displayName",
              "child": "metadata",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "description": {
              "key": "description",
              "child": "spec",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "target": {
              "key": "target",
              "child": "spec",
              "empty": "refuse"
            },
            "inline": {
              "value": "true"
            }
          },
          "files": [
            "yaml",
            "yml"
          ]
        },
        {
          "name": "other",
          "type": "Unbound",
          "doc": "A file of the folder whose document the diagram does not draw.",
          "at": "/",
          "when": "!(type(entry) == map && has(entry.apiVersion) && entry.apiVersion == 'openslo/v1' && has(entry.kind) && entry.kind in ['Service', 'SLO', 'SLI', 'DataSource', 'AlertPolicy', 'AlertCondition', 'AlertNotificationTarget'])",
          "readOnly": "This document is not drawn by the SLO map, and is kept exactly as written.",
          "attributes": {
            "kindName": {
              "value": "type(entry) == map && has(entry.kind) ? string(entry.kind) : ''"
            },
            "apiVersion": {
              "value": "type(entry) == map && has(entry.apiVersion) ? string(entry.apiVersion) : ''"
            },
            "line": {
              "value": "line"
            }
          },
          "files": [
            "yaml",
            "yml"
          ]
        }
      ]
    }
  }
}
