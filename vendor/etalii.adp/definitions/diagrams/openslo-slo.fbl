          "parent": {
            "rules": [
              "slo"
            ],
            "slot": "objectives"
          },
          "attributes": {
            "displayName": {
              "key": "displayName",
              "empty": "remove"
            },
            "op": {
              "key": "op",
              "empty": "remove"
            },
            "value": {
              "key": "value",
              "empty": "remove",
              "number": "shortest"
            },
            "target": {
              "key": "target",
              "empty": "remove",
              "number": "shortest"
            },
            "targetPercent": {
              "key": "targetPercent",
              "empty": "remove",
              "number": "shortest"
            },
            "timeSliceTarget": {
              "key": "timeSliceTarget",
              "empty": "remove",
              "number": "shortest"
            },
            "timeSliceWindow": {
              "key": "timeSliceWindow",
              "read": "text",
              "empty": "remove"
            },
            "indicatorRef": {
              "key": "indicatorRef",
              "empty": "remove"
            },
            "compositeWeight": {
              "key": "compositeWeight",
              "empty": "remove",
              "number": "shortest"
            }
          },
          "remove": {
            "container": "keep"
          },
          "files": [
            "yaml",
            "yml"
          ]
        },
        {
          "name": "sli",
          "type": "SLI",
          "doc": "A document of kind SLI: one element, named by metadata.name (research R3).",
          "at": "/",
          "when": "type(entry) == map && has(entry.apiVersion) && entry.apiVersion == 'openslo/v1' && has(entry.kind) && entry.kind == 'SLI'",
          "attributes": {
            "name": {
              "key": "name",
              "child": "metadata",
              "empty": "refuse"
            },
            "displayName": {
              "key": "displayName",
              "child": "metadata",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "description": {
              "key": "description",
              "child": "spec",
              "empty": "remove",
              "create": {
                "at": "end"
              }
            },
            "metric": {
              "value": "has(entry.spec.thresholdMetric) ? 'threshold' : has(entry.spec.ratioMetric) ? 'ratio' : ''"
            },
            "sourceRefs": {
              "value": "((has(entry.spec) && has(entry.spec.thresholdMetric) && has(entry.spec.thresholdMetric.metricSource) && has(entry.spec.thresholdMetric.metricSource.metricSourceRef) ? [string(entry.spec.thresholdMetric.metricSource.metricSourceRef)] : []) + (has(entry.spec) && has(entry.spec.ratioMetric) && has(entry.spec.ratioMetric.good) && has(entry.spec.ratioMetric.good.metricSource) && has(entry.spec.ratioMetric.good.metricSource.metricSourceRef) ? [string(entry.spec.ratioMetric.good.metricSource.metricSourceRef)] : []) + (has(entry.spec) && has(entry.spec.ratioMetric) && has(entry.spec.ratioMetric.bad) && has(entry.spec.ratioMetric.bad.metricSource) && has(entry.spec.ratioMetric.bad.metricSource.metricSourceRef) ? [string(entry.spec.ratioMetric.bad.metricSource.metricSourceRef)] : []) + (has(entry.spec) && has(entry.spec.ratioMetric) && has(entry.spec.ratioMetric.total) && has(entry.spec.ratioMetric.total.metricSource) && has(entry.spec.ratioMetric.total.metricSource.metricSourceRef) ? [string(entry.spec.ratioMetric.total.metricSource.metricSourceRef)] : [])).distinct()"
            },
            "sourceTypes": {
              "value": "((has(entry.spec) && has(entry.spec.thresholdMetric) && has(entry.spec.thresholdMetric.metricSource) && has(entry.spec.thresholdMetric.metricSource.type) && !has(entry.spec.thresholdMetric.metricSource.metricSourceRef) ? [string(entry.spec.thresholdMetric.metricSource.type)] : []) + (has(entry.spec) && has(entry.spec.ratioMetric) && has(entry.spec.ratioMetric.good) && has(entry.spec.ratioMetric.good.metricSource) && has(entry.spec.ratioMetric.good.metricSource.type) && !has(entry.spec.ratioMetric.good.metricSource.metricSourceRef) ? [string(entry.spec.ratioMetric.good.metricSource.type)] : []) + (has(entry.spec) && has(entry.spec.ratioMetric) && has(entry.spec.ratioMetric.bad) && has(entry.spec.ratioMetric.bad.metricSource) && has(entry.spec.ratioMetric.bad.metricSource.type) && !has(entry.spec.ratioMetric.bad.metricSource.metricSourceRef) ? [string(entry.spec.ratioMetric.bad.metricSource.type)] : []) + (has(entry.spec) && has(entry.spec.ratioMetric) && has(entry.spec.ratioMetric.total) && has(entry.spec.ratioMetric.total.metricSource) && has(entry.spec.ratioMetric.total.metricSource.type) && !has(entry.spec.ratioMetric.total.metricSource.metricSourceRef) ? [string(entry.spec.ratioMetric.total.metricSource.type)] : [])).distinct()"
            }
          },
          "remove": {},
          "files": [
            "yaml",
            "yml"
          ]
        },
        {
          "name": "inlineSli",
