# Inserts and removals through the reader: a shared statement, a list, a line of its own and a whole statement.
@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:a a ex:T ;
    rdfs:label "A" ;
    ex:knows ex:b , ex:c ;
    ex:likes ex:c .
ex:b rdfs:label "B" ; ex:knows ex:c ;
    ex:likes ex:a .
ex:c rdfs:label "C" .  # kept
ex:d ex:knows ex:a .

ex:new a rdfs:Resource .
