@prefix : <http://example.org/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:PersonShape a sh:NodeShape ;
    sh:targetClass :Person ;
    sh:property [ sh:path :name ; sh:datatype xsd:string ; sh:minCount 1 ] ,
        [ sh:path :age ; sh:datatype xsd:integer ] ,
        [ sh:path :knows ; sh:node :PersonShape ] .

:AddressShape a sh:NodeShape ;
    sh:targetClass :Address .

:CityShape a sh:NodeShape ;
    sh:targetClass :City , :Town ;
    sh:property [ sh:path :population ; sh:datatype xsd:integer ] .

:EmptyShape a sh:NodeShape .

:TagShape a sh:NodeShape ;
    sh:targetSubjectsOf :tag ;
    sh:property [ sh:path :tag ; sh:datatype xsd:string ] ,
        [ sh:path :label ] .

:NameShape a sh:PropertyShape ;
    sh:path :name ;
    sh:maxCount 1 .

:OrderShape a sh:NodeShape ;
    sh:targetClass :Order ;
    sh:property [ sh:path :item ; sh:minCount 1 ] , [ sh:path :total ] , [ sh:path :customer ; sh:node :PersonShape ] , [ sh:path :date ] .
