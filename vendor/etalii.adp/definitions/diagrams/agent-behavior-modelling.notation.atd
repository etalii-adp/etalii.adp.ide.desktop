atd 0.1
part of etalii/agent-behavior-modelling

// The Agent Behavior Modelling's coordinates, notation, toolbox, forms and layout, in a part of their own (ATD §5.2).

/// One free pixel canvas. Every position is computed by the tree layout; a row the author dragged keeps its height in
/// the .adp registration.
coordinates {
  system canvas {
    kind: cartesian
    x: { kind: linear, unit: px }
    y: { kind: linear, unit: px }
    orientation: y-down
    grid: { visible: false }
  }
  default canvas
}

/// The family is the shape, as behavior tree editors in games draw it: a composite is a squircle, a wrapper a
/// hexagon. Among the leaves a Check is a pill, a Do a box, an Ask the user a parallelogram and a Delegate a diode.
/// Every node shows its keyword in small capitals above its label.
notation {
  theme {
    tokens: {
      color.text: "#0f172a"
      color.text.muted: "#64748b"
      color.surface: "#ffffff"
      color.border: "#e2e8f0"
      color.abm.composite: "#aaed92"
      color.abm.decorator: "#fcf281"
      color.abm.check: "#9edcfa"
      color.abm.action: "#ededed"
      color.abm.other: "#86e6d9"
    }
    modes: {
      dark: {
        color.text: "#f1f5f9"
        color.text.muted: "#94a3b8"
        color.surface: "#1e293b"
        color.border: "#334155"
        color.abm.composite: "#2e7814"
        color.abm.decorator: "#736a03"
        color.abm.check: "#086fa1"
        color.abm.action: "#696969"
        color.abm.other: "#187569"
      }
    }
    defaultMode: light
    followSystem: true
    doc: "The fills are the functional decomposition graph's: composites green, wrappers yellow, a Check blue, a Do grey, an Ask the user and a Delegate teal."
  }
  style node {
    stroke: { color: $color.border, width: 1.5 }
    font: { size: 12, color: $color.text }
    textAlign: center
    verticalAlign: middle
  }
  style composite extends node { fill: $color.abm.composite }
  style decorator extends node { fill: $color.abm.decorator }
  style check extends node { fill: $color.abm.check }
  style action extends node { fill: $color.abm.action }
  style other extends node { fill: $color.abm.other }
  style implicit { stroke: { dash: [4, 3] } }
  style keyword { font: { size: 10, weight: 600, letterSpacing: 0.2, transform: uppercase, color: $color.text } }
  style label { font: { size: 12, color: $color.text } }
  style child { stroke: { color: $color.text.muted, width: 1.5 } }
  /// Square on the left and round on the right: a rectangle closed on the right by a semicircle of radius r = min(h /
  /// 2, w), as the canvas library's built-in diode draws it. DISL has no built-in diode.
  shape diode {
    label: Diode
    path: {
      segments: [
        { op: M, x: 0, y: 0 },
        { op: L, x: "w - min(h / 2.0, w)", y: 0 },
        {
          op: A
          rx: (min(h / 2.0, w))
          ry: (min(h / 2.0, w))
          rotation: 0
          largeArc: false
          sweep: true
          x: "w - min(h / 2.0, w)"
          y: "h"
        },
        { op: L, x: 0, y: "h" },
        { op: Z }
      ]
    }
    textArea: { x: 6, y: (h * 0.15), w: (w - 0.134 * min(h / 2.0, w) - 12), h: (h * 0.7) }
  }

  /// Every node is 200 by 60, with its keyword in small capitals 20 below its top and its label 40 below it. Only the
  /// label is edited in place: the keyword is the node's kind, changed through the Kind field. Lines leave the middle
  /// of the parent's bottom and arrive at the middle of the child's top.
  node Sequence {
    shape: { type: superellipse, params: { exponent: 4 } }
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: composite
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Fallback {
    shape: { type: superellipse, params: { exponent: 4 } }
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: composite
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Parallel {
    shape: { type: superellipse, params: { exponent: 4 } }
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: composite
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Retry {
    shape hexagon
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: decorator
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node RepeatUntil {
    shape hexagon
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: decorator
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Guard {
    shape hexagon
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: decorator
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Approval {
    shape hexagon
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: decorator
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Check {
    shape pill
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: check
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Do {
    shape rect
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: action
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
    conditions: [
      {
        when: (self.implicit)
        style: implicit
        doc: "An item without a keyword is drawn dashed, so the author sees it was read as a Do."
      }
    ]
  }

  node AskUser {
    shape: { type: parallelogram, params: { skew: 0.2, direction: right } }
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: other
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  node Delegate {
    shape diode
    label (keyword(self)) as keyword {
      editable: false
      style: keyword
      position: { anchor: [0.5, 0], offset: [0, 20] }
      wrap: none
      overflow: ellipsis
    }
    label @label as label {
      editable: inline
      style: label
      position: { anchor: [0.5, 0], offset: [0, 40] }
      wrap: none
      overflow: ellipsis
      tooltip: (self.label)
    }
    style: other
    size: { default: [200, 60], resizable: false }
    placement: { x: { layout: true }, y: { layout: true }, anchor: center, movable: true, resizable: false }
    anchors: { mode: sides, sides: [top, bottom] }
    accessibility: { role: button, name: (keyword(self) + ': ' + self.label) }
    doubleClick: editLabel
  }

  /// An orthogonal line from the middle of the parent's bottom down to the middle of the child's top, with an
  /// arrowhead at the child.
  edge Child {
    line { routing: orthogonal, bendpoints: { editable: false } }
    marker source none
    marker target arrowFilled
    style: child
    deletable: false
    reconnectable: false
    connect: {
      pointer: {
        button: secondary
        start: body
        doc: "A new line is drawn by dragging with the right mouse button from the parent's body to the child's body, because side anchors draw no handle."
      }
    }
  }
}

/// One tool per kind, in one list. A tool is dropped where the node belongs: it goes under the nearest node above the
/// drop that can take another child, among that node's children by where it landed, or becomes the root of an empty
/// tree; its label is then edited in place. New lines are drawn on the canvas with a right-button drag, not from the
/// toolbox.
toolbox {
  generic: { select: true, pan: true }
  group nodes {
    /// Runs its children one after another, and fails as soon as one fails. Drop it below the node it belongs under.
    tool sequence "Do in order" {
      creates: Sequence
      mode: drop
      icon: mdi-arrow-right-bold-outline
      initial: { label: "New steps" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Tries its children one after another, and succeeds as soon as one succeeds. Drop it below the node it belongs
    /// under.
    tool fallback "Try in order" {
      creates: Fallback
      mode: drop
      icon: mdi-help-rhombus-outline
      initial: { label: "New alternatives" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Runs its children independently, at the same time where you can, and succeeds when all of them succeed. Drop
    /// it below the node it belongs under.
    tool parallel "Do together" {
      creates: Parallel
      mode: drop
      icon: mdi-call-split
      initial: { label: "New independent work" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Runs its child again when it fails, at most N times in all. Drop it below the node it belongs under.
    tool retry "Retry" {
      creates: Retry
      mode: drop
      icon: mdi-replay
      initial: { label: "" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Runs its child again and again until its condition holds. Drop it below the node it belongs under.
    tool repeat "Repeat until" {
      creates: RepeatUntil
      mode: drop
      icon: mdi-repeat
      initial: { label: "New condition" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Runs its child only while its condition holds, and abandons it when the condition stops holding. Drop it below
    /// the node it belongs under.
    tool guard "Only while" {
      creates: Guard
      mode: drop
      icon: mdi-shield-outline
      initial: { label: "New condition" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Says what its child is about to do and waits for the user's explicit approval; without it, the node fails.
    /// Drop it below the node it belongs under.
    tool approval "Ask approval before" {
      creates: Approval
      mode: drop
      icon: mdi-account-check-outline
      initial: { label: "" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Answers its question from the conversation, your memory or a tool result; it succeeds when the answer is yes,
    /// and never acts. Drop it below the node it belongs under.
    tool check "Check" {
      creates: Check
      mode: drop
      icon: mdi-help-circle-outline
      initial: { label: "New question" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Carries out one piece of work: a tool call, an answer, an edit. Drop it below the node it belongs under.
    tool action "Do" {
      creates: Do
      mode: drop
      icon: mdi-play-outline
      initial: { label: "New action" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Asks its question and waits for the answer. Drop it below the node it belongs under.
    tool ask "Ask the user" {
      creates: AskUser
      mode: drop
      icon: mdi-account-question-outline
      initial: { label: "New question for the user" }
      after: none
      drop: { place: underNearestAbove }
    }
    /// Hands its task to a sub-agent, or follows the behavior file it links to. Drop it below the node it belongs
    /// under.
    tool delegate "Delegate" {
      creates: Delegate
      mode: drop
      icon: mdi-account-arrow-right-outline
      initial: { label: "New task" }
      after: none
      drop: { place: underNearestAbove }
    }
  }
  context for BehaviorNode {
    placement: menu
    standardEntries: false
    tool "Rename…" { kind: editLabel, group: edit, icon: mdi-pencil-outline, shortcut: F2 }
    tool "Edit notes…" { kind: operation, operation: editNotes, group: edit, icon: mdi-note-text-outline }
    tool "Move earlier" { kind: moveUp, group: edit, icon: mdi-arrow-left, shortcut: "Alt+Up" }
    tool "Move later" { kind: moveDown, group: edit, icon: mdi-arrow-right, shortcut: "Alt+Down" }
    tool "Remove" { kind: delete, group: edit, icon: mdi-delete-outline, shortcut: Delete }
    tool {
      kind: operation
      operation: addChild
      group: add
      forEach: (kinds())
      as: kind
      label: ('Add child: ' + kindChoice(kind))
      icon: mdi-plus
      args: { kind: (kind) }
      visible: (takesAnotherChild(self))
    }
    tool "Arrange diagram" { kind: operation, operation: arrangeFromNode, group: arrange, icon: mdi-sitemap-outline }
  }
  /// The menu of the empty canvas: a node of any kind placed where the menu was opened, and Arrange diagram.
  context for diagram {
    placement: menu
    standardEntries: false
    tool {
      kind: operation
      operation: addHere
      group: add
      forEach: (kinds())
      as: kind
      label: ('Add ' + kindChoice(kind) + ' here')
      icon: mdi-plus
      args: { kind: (kind) }
    }
    tool "Arrange diagram" { kind: operation, operation: arrange, group: arrange, icon: mdi-sitemap-outline }
  }
}

form node "Behavior node" for BehaviorNode {
  usage: [inspector]
  section "Node" {
    /// An editable choice of the kinds this node can become without losing a child, shown by their menu names, which
    /// retypes the node through `behavior.retype` as one undoable step. The refusals are reached only by a value
    /// typed past the list.
    item "Kind" {
      kind: type
      options: (kinds().filter(t, canBecome(t, self)))
      optionLabel: (kindChoice(item))
      refusals: [
        {
          when: (familyOf(newValue) == 'leaf' && self.children.size() > 0)
          message: ('"' + kindChoice(newValue) + '" holds no children, and this node has ' + (self.children.size() == 1 ? '1 child' : string(self.children.size()) + ' children') + '.')
        },
        {
          when: (familyOf(newValue) == 'decorator' && self.children.size() > 1)
          message: ('"' + (newValue == 'Retry' ? 'Retry up to 3 times' : kindChoice(newValue)) + '" holds exactly one child, and this node has ' + string(self.children.size()) + '.')
        }
      ]
    }
    field label "Label"
    field attempts "Attempts" {
      visible: (self.type == 'Retry')
      validate: [
        {
          rule: (value >= 1)
          message: ('\'' + string(value) + '\' is not a number of attempts; a Retry allows at least 1.')
          timing: commit
        }
      ]
    }
    field notes "Notes" { widget: textarea }
    /// The node's place in the tree (1, 1.2, 1.2.1), which is also its id.
    item "Place" { kind: computed, value: (self.id), readOnlyReasons: ["A node's place follows from where it sits in the tree."] }
  }
}

form notesDialog "Notes" for BehaviorNode {
  usage: [popover]
  icon: mdi-note-text-outline
  submitLabel: Save
  field notes "Notes" { widget: textarea, initial: (self.notes) }
}

/// The tree is laid out on every change. A drag pins a row's height in the .adp registration, under the place ids of
/// the row and everything beneath it; across, the order decides.
layout {
  default tree
  algorithm tree {
    algorithm: tidyTree
    direction: down
    spacing: { node: 28, layer: 56, component: 56 }
    tidyTree: {
      order: children
      parentAlign: firstLastCentre
      origin: leftmostAtZero
      rows: { stored: y, minGap: 16 }
      drag: { carry: subtree, across: reorder, down: row }
      doc: "Reingold-Tilford outline packing in document order, each parent centred over its first and last child, the roots packed 56 apart, the leftmost node at x = 0. Across, a node's x is always the computed one; down, all children of one parent share a row, drawn at the first height stored for any of them or 56 below the parent's bottom, never closer than 16. A drag carries the subtree, takes a sibling's place once dropped past its centre (the order is written to the Markdown), and stores the row's height for every node in the row and beneath it, as one undo step."
    }
    doc: "Top-down: the root at the top, each node's children left to right in document order beneath it, each subtree packed as close as its outline allows."
  }
  trigger: always
  respect: pinned
  animate: false
}
