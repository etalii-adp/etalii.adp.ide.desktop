{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.3",
  "language": {
    "id": "net.etalii.adp.databricks.bundle",
    "version": "0.2.0",
    "origin": "databricks/bundle",
    "label": "Databricks bundle",
    "icon": "mdi-package-variant-closed",
    "fileExtension": ".yml",
    "license": "Apache-2.0",
    "homepage": "https://github.com/etalii-adp/etalii.adp.ide.standalone/tree/develop/src/diagrams/databricks",
    "doc": {
      "summary": "What an asset bundle deploys: its resources, its variables, and the targets each lands on.",
      "description": "The diagram of one Databricks Asset Bundle, read from its `databricks.yml`. The bundle is one node on top, the jobs and pipelines it declares a row of nodes beneath it, and each deployment target a dashed frame at the bottom, with a dashed arrow to every resource the target overrides. Configuration the tool does not model is drawn as a generic node and never rewritten. The YAML stays Databricks' own file: ADP never writes positions into it. The `x-databricks` block maps this specification's names to the wire ids the standalone tool uses today. See `databricks-bundle.md` beside this file for what DISL 0.3 cannot say.",
      "seeAlso": [
        { "title": "Databricks: bundle configuration", "href": "https://docs.databricks.com/aws/en/dev-tools/bundles/settings" },
        { "title": "Databricks: deployment modes", "href": "https://docs.databricks.com/aws/en/dev-tools/bundles/deployment-modes" }
      ]
    },
    "requires": { "conformance": "standard" }
  },

  "functions": {
    "rippleRank": {
      "params": [ { "name": "e", "type": "Element" }, { "name": "members", "type": "list(Element)" } ],
      "returns": "int",
      "cel": "cel.bind(x, e.view.bounds.center()[0], cel.bind(y, e.view.bounds.center()[1], members.filter(o, o.view.bounds.center()[0] < x || (o.view.bounds.center()[0] == x && (o.view.bounds.center()[1] < y || (o.view.bounds.center()[1] == y && o.positionIn(members) < e.positionIn(members))))).size()))",
      "doc": "The element's place in a ripple: the members ordered by position on the canvas, left to right, then top to bottom, then in reading order."
    },
    "deployMembers": {
      "params": [],
      "returns": "list(Element)",
      "uses": ["diagram"],
      "cel": "diagram.nodesOfType('Resource') + diagram.nodesOfType('Unknown')",
      "doc": "What a simulated deploy ripples over: every resource and every piece of unmodelled configuration."
    }
  },

  "metamodel": {
    "diagram": {
      "doc": "The bundle file. Its includes and variables are read and kept for constraints, but not drawn.",
      "attributes": {
        "includes": { "type": "string", "many": true, "readOnly": true, "doc": "The `include:` globs. While any is present, overrides of resources this file does not declare are not reported, because an included file may declare them." },
        "variables": { "type": "Variable", "many": true, "readOnly": true, "doc": "The `variables:` declarations." }
      }
    },
    "dataTypes": {
      "Variable": {
        "label": "Variable",
        "fields": {
          "name": { "type": "string", "required": true },
          "default": { "type": "string" },
          "description": { "type": "string" }
        },
        "display": { "cel": "self.name" }
      }
    },
    "enums": {
      "ResourceKind": {
        "doc": "The resource kinds the tool models. Every other kind under `resources:` becomes an unknown node.",
        "values": {
          "jobs": { "label": "Job", "icon": "mdi-transit-connection-horizontal" },
          "pipelines": { "label": "Pipeline", "icon": "mdi-pipe" }
        }
      },
      "TargetMode": {
        "extensible": true,
        "doc": "A target's `mode`; absent is allowed.",
        "values": {
          "development": { "label": "development" },
          "production": { "label": "production" }
        }
      },
      "SimulatedState": {
        "doc": "Where an element stands in a simulated deploy. Never stored.",
        "values": { "pending": {}, "running": {}, "succeeded": {} }
      }
    },
    "types": {
      "Bundle": {
        "label": "Bundle",
        "doc": "The `bundle:` section. There is exactly one, drawn whether or not the file has a `bundle:` key (see databricks-bundle.md).",
        "multiplicity": { "min": 1, "max": 1 },
        "labelAttribute": "name",
        "attributes": {
          "name": { "type": "string", "doc": "`bundle.name`; absent when the file has no `bundle:` section or the section no name." }
        }
      },
      "Resource": {
        "label": "Resource",
        "doc": "One entry under `resources.jobs` or `resources.pipelines`.",
        "labelAttribute": "key",
        "attributes": {
          "resourceKind": { "type": "ResourceKind", "required": true, "readOnly": true },
          "key": { "type": "string", "required": true, "readOnly": true, "minLength": 1, "doc": "The resource's key under its kind." },
          "simulated": { "type": "SimulatedState", "transient": "viewer", "readOnly": true }
        }
      },
      "Unknown": {
        "label": "Unmodelled configuration",
        "doc": "A root key other than bundle, include, variables, resources and targets (for example workspace, sync, permissions), or a resource kind other than jobs and pipelines (for example experiments, models, schemas). Drawn generically, never written.",
        "labelAttribute": "key",
        "attributes": {
          "path": { "type": "string", "required": true, "readOnly": true, "doc": "The key's path: `workspace`, or `resources.experiments`." },
          "key": { "type": "string", "required": true, "readOnly": true, "doc": "The key itself." },
          "simulated": { "type": "SimulatedState", "transient": "viewer", "readOnly": true }
        }
      },
      "Target": {
        "label": "Target",
        "doc": "One entry under `targets:`, drawn as a frame.",
        "labelAttribute": "name",
        "attributes": {
          "name": { "type": "string", "required": true, "key": true, "readOnly": true },
          "mode": { "type": "TargetMode", "readOnly": true, "doc": "`mode`." },
          "isDefault": { "type": "bool", "default": false, "readOnly": true, "doc": "`default: true`." }
        }
      }
    },
    "relations": {
      "Override": {
        "label": "Overrides",
        "doc": "One entry of a target's own `resources:` section: the target sets some of the resource's fields for deployments to it. Read from the file, never drawn by the user. An entry naming a resource this bundle does not declare has no target end; it is not drawn, and the rule `overrideOfUndeclared` reports it.",
        "source": "Target",
        "target": { "types": ["Resource"], "optional": true },
        "directed": true,
        "allowSelfLoops": false,
        "allowParallel": false,
        "attributes": {
          "resourceKind": { "type": "string", "required": true, "readOnly": true, "doc": "The resource kind the entry is written under, as written." },
          "resourceKey": { "type": "string", "required": true, "readOnly": true, "doc": "The resource key the entry names, as written." }
        }
      }
    }
  },

  "notation": {
    "styles": {
      "box": {
        "fill": { "token": "color.surface" },
        "stroke": { "color": { "token": "color.border" }, "width": 1 },
        "cornerRadius": 4,
        "font": { "size": 13 }
      },
      "badges": { "font": { "size": 10, "color": "#5a6376" } },
      "simPending": { "opacity": 0.5 },
      "simRunning": { "stroke": { "color": "limegreen", "width": 2.5 } },
      "simSucceeded": { "stroke": { "color": "#15803d", "width": 2 } }
    },
    "nodes": {
      "Bundle": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "name", "text": { "attribute": "name" }, "placeholder": "bundle", "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" },
            "editable": "inline", "overflow": "ellipsis" }
        ],
        "connectable": false,
        "deletable": false
      },
      "Resource": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" },
          { "id": "kind", "text": { "cel": "self.resourceKind" }, "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" }, "style": "badges" }
        ],
        "connectable": false,
        "deletable": false,
        "conditions": [
          { "when": "has(self.simulated) && self.simulated == 'pending'", "style": "simPending" },
          { "when": "has(self.simulated) && self.simulated == 'running'", "style": "simRunning" },
          { "when": "has(self.simulated) && self.simulated == 'succeeded'", "style": "simSucceeded" }
        ]
      },
      "Unknown": {
        "shape": "rect",
        "style": "box",
        "size": { "fixed": [200, 56] },
        "labels": [
          { "id": "key", "text": { "attribute": "key" }, "position": { "anchor": [0, 0.5], "offset": [8, -4], "align": "start" }, "editable": false, "overflow": "ellipsis" },
          { "id": "path", "text": { "attribute": "path" }, "position": { "anchor": [0, 1], "offset": [8, -8], "align": "start" }, "style": "badges" }
        ],
        "connectable": false,
        "deletable": false,
        "conditions": [
          { "when": "has(self.simulated) && self.simulated == 'pending'", "style": "simPending" },
          { "when": "has(self.simulated) && self.simulated == 'running'", "style": "simRunning" },
          { "when": "has(self.simulated) && self.simulated == 'succeeded'", "style": "simSucceeded" }
        ]
      },
      "Target": {
        "shape": "rect",
        "style": { "fill": "transparent", "stroke": { "color": { "token": "color.border" }, "width": 1, "dash": [6, 4] } },
        "size": { "fixed": [220, 120] },
        "labels": [
          { "id": "name", "text": { "attribute": "name" }, "position": "outside-top", "editable": false,
            "style": { "font": { "size": 12, "color": "#5a6376" } } },
          { "id": "summary",
            "text": { "cel": "cel.bind(n, self.outgoingOf('Override').size(), [has(self.mode) ? self.mode : '', self.isDefault ? 'default' : '', n == 1 ? '1 override' : (n > 1 ? string(n) + ' overrides' : '')].filter(s, s != '').join(' · '))" },
            "position": { "anchor": [0, 0], "offset": [12, 18], "align": "start" }, "style": "badges" }
        ],
        "connectable": false,
        "deletable": false,
        "layer": "background"
      }
    },
    "edges": {
      "Override": {
        "line": { "stroke": { "color": { "token": "color.border" }, "width": 1, "dash": [3, 3] }, "routing": "straight" },
        "targetMarker": "arrowFilled",
        "doc": "An override is a reference, not a flow: straight and dashed."
      }
    }
  },

  "toolbox": {
    "generic": { "select": true, "pan": true },
    "groups": [
      { "id": "resources", "label": "Resources", "tools": [
        { "id": "jobResource", "kind": "operation", "operation": "addJobResource", "label": "Job", "icon": "mdi-transit-connection-horizontal",
          "doc": "A job resource skeleton, complete with a starter task." },
        { "id": "pipelineResource", "kind": "operation", "operation": "addPipelineResource", "label": "Pipeline", "icon": "mdi-pipe",
          "doc": "A pipeline resource skeleton, complete with a starter library." }
      ] }
    ],
    "contextMenus": [
      { "for": ["Bundle"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "renameBundle", "group": "edit", "label": "Rename…", "icon": "mdi-pencil-outline", "shortcut": "F2" },
        { "kind": "operation", "operation": "addJobResource", "group": "add", "label": "Add job resource…", "icon": "mdi-transit-connection-horizontal" },
        { "kind": "operation", "operation": "addPipelineResource", "group": "add", "label": "Add pipeline resource…", "icon": "mdi-pipe" }
      ] },
      { "for": ["Target"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "simulateDeploy", "label": "Deploy here (simulated)", "icon": "mdi-rocket-launch-outline" }
      ] },
      { "for": ["diagram"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "addNotebookTaskHere", "group": "add", "label": "Add notebook task here", "icon": "mdi-notebook-outline" },
        { "kind": "operation", "operation": "addPythonTaskHere", "group": "add", "label": "Add Python task here", "icon": "mdi-language-python" },
        { "kind": "operation", "operation": "addConditionTaskHere", "group": "add", "label": "Add condition task here", "icon": "mdi-call-split" }
      ], "doc": "The tool offers the job reading's canvas entries under this reading too (see databricks-bundle.md)." },
      { "for": ["connection"], "placement": "menu", "standardEntries": false, "tools": [
        { "kind": "operation", "operation": "connectTasks", "label": "Depend on", "icon": "mdi-ray-start-arrow", "args": { "from": "source", "to": "target" } }
      ], "doc": "The tool offers the job reading's connection entry under this reading too (see databricks-bundle.md)." }
    ]
  },

  "forms": {
    "bundle": {
      "for": "Bundle",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "attribute": "name", "label": "Name", "widget": "text",
            "validate": [ { "timing": "commit", "rule": "value != ''", "message": "A bundle needs a name." } ] }
        ] },
        { "kind": "section", "title": "Workspace", "items": [
          { "kind": "computed", "label": "Workspace connection", "value": "Not connected",
            "readOnlyReasons": [ "Not connected — a placeholder for the real workspace connection." ] },
          { "kind": "computed", "label": "Last simulated run", "value": "",
            "readOnlyReasons": [ "Simulated runs play on the canvas and never touch the file." ] }
        ] }
      ]
    },
    "target": {
      "for": "Target",
      "usage": ["inspector"],
      "items": [
        { "kind": "section", "title": "Identity", "items": [
          { "id": "targetName", "attribute": "name", "label": "Target", "widget": "readonly",
            "readOnlyReasons": [ "The target's key is the file's structure." ] },
          { "id": "targetMode", "attribute": "mode", "label": "Mode", "widget": "readonly",
            "readOnlyReasons": [ "Change the mode in the file." ] }
        ] },
        { "kind": "section", "title": "Workspace", "items": [
          { "kind": "computed", "label": "Workspace connection", "value": "Not connected",
            "readOnlyReasons": [ "Not connected — a placeholder for the real workspace connection." ] },
          { "kind": "computed", "label": "Last simulated run", "value": "",
            "readOnlyReasons": [ "Simulated runs play on the canvas and never touch the file." ] }
        ] }
      ]
    },
    "renameBundle": {
      "for": "Bundle",
      "label": "Rename bundle",
      "icon": "mdi-pencil-outline",
      "submitLabel": "Rename",
      "items": [
        { "attribute": "name", "label": "Name", "widget": "text", "initial": "has(self.name) ? self.name : ''",
          "validate": [ { "timing": "commit", "rule": "value != ''", "message": "A bundle needs a name." } ] }
      ]
    },
    "addResource": {
      "label": "Add resource",
      "icon": "mdi-plus",
      "submitLabel": "Add",
      "items": [
        { "attribute": "key", "label": "Key", "widget": "text", "initial": "''",
          "validate": [ { "timing": "commit", "rule": "value != ''", "message": "A resource needs a key." } ] }
      ]
    }
  },

  "constraints": {
    "doc": "Every finding is located at a line of the bundle's YAML: a rule on an element reports the element's `location()`, which the reader records.",
    "builtIn": {
      "std.unparseable": {
        "code": "databricks.unparseable",
        "severity": "error",
        "message": { "cel": "'This is not configuration that can be read: ' + detail.reason" }
      }
    },
    "rules": [
      { "id": "noDefaultTarget", "code": "databricks.no-default-target", "scope": "diagram", "severity": "warning",
        "when": "diagram.nodesOfType('Target').size() > 0",
        "rule": "diagram.nodesOfType('Target').exists(t, t.isDefault)",
        "location": "diagram.nodesOfType('Target')[0].location().orValue(null)",
        "message": "No target says default: true, so every deploy must name one. Mark one target as the default.",
        "doc": "Reported at the first target's line, and only when the bundle has targets." },
      { "id": "multipleDefaultTargets", "code": "databricks.multiple-default-targets", "scope": "Target", "severity": "error",
        "when": "self.isDefault",
        "rule": "self.positionIn(diagram.nodesOfType('Target').filter(t, t.isDefault)) == 0",
        "message": { "cel": "'\\'' + self.name + '\\' is a second default target; only one target may be the default.'" },
        "doc": "Reported on the second and later default targets, not the first, each at its own line." },
      { "id": "overrideOfUndeclared", "code": "databricks.override-of-undeclared", "scope": "Override", "severity": "warning",
        "when": "diagram.includes.size() == 0",
        "rule": "self.target != null",
        "message": { "cel": "'Target \\'' + self.source.name + '\\' overrides ' + self.resourceKind + ' \\'' + self.resourceKey + '\\', which this bundle does not declare. Declare the resource or drop the override.'" },
        "doc": "Reported at the override entry's line. Quiet while the bundle has `include:` globs, because an included file may declare the resource." }
    ]
  },

  "behavior": {
    "operations": {
      "renameBundle": {
        "label": "Rename…",
        "icon": "mdi-pencil-outline",
        "for": ["Bundle"],
        "params": { "name": { "type": "string", "required": true, "label": "Name" } },
        "paramsForm": "renameBundle",
        "actions": [
          { "abort": { "message": "'A bundle needs a name.'" }, "when": "p.name == ''" },
          { "set": { "name": "p.name" } }
        ],
        "doc": "Renames the bundle inline on its label."
      },
      "addJobResource": {
        "label": "Add job resource…",
        "icon": "mdi-transit-connection-horizontal",
        "for": "diagram",
        "params": { "key": { "type": "string", "required": true, "label": "Key" } },
        "paramsForm": "addResource",
        "actions": [
          { "abort": { "message": "'A resource needs a key.'" }, "when": "p.key == ''" },
          { "abort": { "message": "'A jobs resource named \\'' + p.key + '\\' is already there.'" },
            "when": "diagram.nodesOfType('Resource').exists(r, r.resourceKind == 'jobs' && r.key == p.key)" },
          { "create": { "type": "'Resource'", "attributes": { "resourceKind": "'jobs'", "key": "p.key" } } }
        ],
        "doc": "Writes a job resource skeleton, complete with a starter task."
      },
      "addPipelineResource": {
        "label": "Add pipeline resource…",
        "icon": "mdi-pipe",
        "for": "diagram",
        "params": { "key": { "type": "string", "required": true, "label": "Key" } },
        "paramsForm": "addResource",
        "actions": [
          { "abort": { "message": "'A resource needs a key.'" }, "when": "p.key == ''" },
          { "abort": { "message": "'A pipelines resource named \\'' + p.key + '\\' is already there.'" },
            "when": "diagram.nodesOfType('Resource').exists(r, r.resourceKind == 'pipelines' && r.key == p.key)" },
          { "create": { "type": "'Resource'", "attributes": { "resourceKind": "'pipelines'", "key": "p.key" } } }
        ],
        "doc": "Writes a pipeline resource skeleton, complete with a starter library."
      },
      "addNotebookTaskHere": {
        "label": "Add notebook task here",
        "icon": "mdi-notebook-outline",
        "for": "diagram",
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "taskType": "notebook" } },
        "doc": "Runs the job reading's command of the same name, which adds a notebook task to a job of the file; the tool offers it under this reading too."
      },
      "addPythonTaskHere": {
        "label": "Add Python task here",
        "icon": "mdi-language-python",
        "for": "diagram",
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "taskType": "python" } },
        "doc": "Runs the job reading's command of the same name, which adds a Python task to a job of the file; the tool offers it under this reading too."
      },
      "addConditionTaskHere": {
        "label": "Add condition task here",
        "icon": "mdi-call-split",
        "for": "diagram",
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "taskType": "condition" } },
        "doc": "Runs the job reading's command of the same name, which adds a condition task to a job of the file; the tool offers it under this reading too."
      },
      "connectTasks": {
        "label": "Depend on",
        "icon": "mdi-ray-start-arrow",
        "for": "diagram",
        "params": {
          "from": { "type": "Element", "doc": "Where the gesture started." },
          "to": { "type": "Element", "doc": "Where the gesture ended." }
        },
        "plugin": { "name": "net.etalii.adp.databricks.files", "args": { "connect": "dependency" } },
        "doc": "Runs the job reading's connect command, which the tool offers under this reading too."
      },
      "simulateDeploy": {
        "label": "Deploy here (simulated)",
        "icon": "mdi-rocket-launch-outline",
        "for": ["Target"],
        "simulate": {
          "for": ["Resource", "Unknown"],
          "state": "simulated",
          "initial": "'pending'",
          "next": "cel.bind(r, rippleRank(self, deployMembers()), step == 2 * r + 1 ? 'running' : (step >= 2 * r + 2 ? 'succeeded' : 'pending'))",
          "until": "step >= 2 * deployMembers().size()",
          "stepMs": 700,
          "notice": { "running": "Simulated: deploy", "finished": "Simulated: deploy — finished" },
          "doc": "A mock deploy that ripples over the resources and the unmodelled configuration, one element at a time in position order: each goes from pending to running to succeeded, one change every 700 ms. Nothing is written, nothing enters the undo history."
        }
      }
    }
  },

  "layout": {
    "algorithms": {
      "bands": {
        "algorithm": "plugin:net.etalii.adp.databricks.layout",
        "options": { "reading": "bundle", "columnWidth": 260, "bundleY": 0, "resourceY": 180, "targetY": 400 },
        "doc": "Three bands: the bundle, then resources and unmodelled configuration in one row, then target frames."
      },
      "grid": { "algorithm": "grid", "doc": "The declarative approximation of bands, for a runtime without the plugin." }
    },
    "default": "bands",
    "trigger": "always",
    "respect": "all"
  },

  "persistence": {
    "format": "plugin:net.etalii.adp.databricks.files",
    "files": {
      "mode": "split",
      "model": "databricks.yml",
      "view": "{name}.adp",
      "doc": "The model is the bundle's own databricks.yml, which Databricks owns; the view is the ADP registration file's layout: block."
    },
    "ids": {
      "strategy": "natural",
      "prefix": { "Target": "target:" },
      "pattern": "^[^\\r\\n]{1,512}$",
      "types": {
        "Bundle": { "strategy": "derived", "expression": "'bundle'", "doc": "The one bundle node keeps one id." },
        "Resource": { "strategy": "derived", "expression": "'resource:' + self.resourceKind + '/' + self.key" },
        "Unknown": { "strategy": "derived", "expression": "'unknown:' + self.path" },
        "Override": { "strategy": "derived", "expression": "'override:' + self.source.name + '/' + self.resourceKind + '/' + self.resourceKey" }
      },
      "doc": "`bundle`, `resource:<kind>/<key>`, `unknown:<path>`, `target:<name>` and `override:<target>/<kind>/<key>`."
    },
    "view": { "store": ["bounds"], "styleOverrides": "none" }
  },

  "plugins": {
    "net.etalii.adp.databricks.files": {
      "version": "^0.1.0",
      "provides": ["persistenceFormat", "action"],
      "required": true,
      "doc": "Reads and writes the bundle inside Databricks' own databricks.yml by line splices, so an untouched file saves byte for byte, and keeps positions in the .adp registration's layout: block. As an action it runs the job reading's commands that the tool offers under this reading too."
    },
    "net.etalii.adp.databricks.layout": {
      "version": "^0.1.0",
      "provides": ["layout"],
      "required": false,
      "fallback": { "layout": "grid" },
      "args": {
        "reading": { "type": "string", "required": true },
        "columnWidth": { "type": "number" },
        "bundleY": { "type": "number" },
        "resourceY": { "type": "number" },
        "targetY": { "type": "number" }
      },
      "doc": "The family's computed layouts."
    }
  },

  "x-databricks": {
    "doc": "Today's wire ids, which the standalone backend and client share, mapped from this specification's names, as x-ghg does for the hype cycle. A tool is keyed by its id. An action is keyed by its entry's operation, else its kind. A property is keyed by its form item's row id: its id, else its attribute, else a computed item's label. A target's two rows reuse the ids of a task's key and type rows.",
    "tools": {
      "jobResource": { "id": "databricks.toolbox.job-resource", "drop": "databricks.add-resource:jobs" },
      "pipelineResource": { "id": "databricks.toolbox.pipeline-resource", "drop": "databricks.add-resource:pipelines" }
    },
    "actions": {
      "renameBundle": "databricks.rename-bundle",
      "addJobResource": "databricks.add-resource:jobs",
      "addPipelineResource": "databricks.add-resource:pipelines",
      "simulateDeploy": "databricks.simulated.deploy",
      "addNotebookTaskHere": "databricks.add-task:notebook",
      "addPythonTaskHere": "databricks.add-task:python",
      "addConditionTaskHere": "databricks.add-task:condition",
      "connectTasks": "databricks.connect"
    },
    "properties": {
      "name": "databricks.bundle-name",
      "targetName": "databricks.task-key",
      "targetMode": "databricks.task-type",
      "Workspace connection": "databricks.workspace",
      "Last simulated run": "databricks.last-simulated-run"
    }
  }
}
