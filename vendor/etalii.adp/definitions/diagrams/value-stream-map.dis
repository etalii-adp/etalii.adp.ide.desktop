              }
            },
            {
              "ref": "p5",
              "type": "Practice",
              "attributes": {
                "name": "'problem management'"
              }
            }
          ]
        }
      },
      "eightActivities": {
        "label": "Eight-activity lifecycle",
        "doc": "A starting activity list of eight lifecycle activities and the same short practice list, every name editable (research R7, FR-003).",
        "fragment": {
          "nodes": [
            {
              "ref": "a1",
              "type": "Activity",
              "attributes": {
                "name": "'discover'"
              }
            },
            {
              "ref": "a2",
              "type": "Activity",
              "attributes": {
                "name": "'design'"
              }
            },
            {
              "ref": "a3",
              "type": "Activity",
              "attributes": {
                "name": "'acquire'"
              }
            },
            {
              "ref": "a4",
              "type": "Activity",
              "attributes": {
                "name": "'build'"
              }
            },
            {
              "ref": "a5",
              "type": "Activity",
              "attributes": {
                "name": "'transition'"
              }
            },
            {
              "ref": "a6",
              "type": "Activity",
              "attributes": {
                "name": "'operate'"
              }
            },
            {
              "ref": "a7",
              "type": "Activity",
              "attributes": {
                "name": "'deliver'"
              }
            },
            {
              "ref": "a8",
              "type": "Activity",
              "attributes": {
                "name": "'support'"
              }
            },
            {
              "ref": "p1",
              "type": "Practice",
              "attributes": {
                "name": "'incident management'"
              }
            },
            {
              "ref": "p2",
              "type": "Practice",
              "attributes": {
                "name": "'change enablement'"
              }
            },
            {
              "ref": "p3",
              "type": "Practice",
              "attributes": {
                "name": "'service request management'"
              }
            },
            {
              "ref": "p4",
              "type": "Practice",
              "attributes": {
                "name": "'monitoring and event management'"
              }
            },
            {
              "ref": "p5",
              "type": "Practice",
              "attributes": {
                "name": "'problem management'"
              }
            }
          ]
        }
      }
    },
    "starters": [
      "sixActivities",
      "eightActivities"
    ]
  },
  "forms": {
    "step": {
      "for": [
        "Step"
      ],
      "items": [
        {
          "kind": "field",
          "attribute": "name"
        },
        {
          "kind": "field",
          "attribute": "activity",
          "options": {
            "cel": "diagram.nodesOfType('Activity').map(a, a.name)"
          }
        },
        {
          "kind": "field",
          "attribute": "practices",
          "options": {
            "cel": "diagram.nodesOfType('Practice').map(p, p.name)"
          }
        },
        {
          "kind": "field",
          "attribute": "performer"
        },
        {
          "kind": "field",
          "attribute": "processTime"
        },
        {
          "kind": "field",
          "attribute": "waitTime"
        },
        {
          "kind": "field",
          "attribute": "note"
        },
        {
          "kind": "findings"
        }
      ],
      "doc": "FR-002: every attribute of a step in one form, the activity and the practices offered from the stream's own lists."
    },
    "diagram": {
      "for": "diagram",
      "items": [
        {
          "kind": "field",
          "attribute": "name"
        },
        {
          "kind": "field",
          "attribute": "unit"
        },
        {
          "kind": "findings"
        }
      ],
      "doc": "The stream's name and the unit of its totals. The activity and practice lists are edited as their own entries."
    }
  },
  "constraints": {
    "doc": "A map an agent or a person wrote that breaks a rule still opens and draws; each breach is a finding, never a refusal, so nothing anyone wrote is lost (FR-007). Two gestures are refused: a flow that crosses states, and a flow that is both an alternative and rework, which the file cannot hold.",
    "blockSaveOn": "never",
    "rules": [
      {
        "id": "emptyStream",
        "code": "vsm.empty-stream",
        "label": "State without steps",
        "severity": "info",
        "rule": "diagram.nodesOfType('Trigger').all(t, stepsOf(t.state).size() > 0)",
        "message": {
          "cel": "'The ' + diagram.nodesOfType('Trigger').filter(t, stepsOf(t.state).size() == 0)[0].state + ' state has no step yet.'"
        },
        "scope": [
          "diagram"
        ]
      },
      {
        "id": "missingTrigger",
        "code": "vsm.missing-trigger",
        "label": "No trigger",
        "severity": "warning",
        "rule": "diagram.nodesOfType('Step').all(s, diagram.nodesOfType('Trigger').exists(t, t.state == s.state))",
        "message": {
          "cel": "'The ' + diagram.nodesOfType('Step').filter(s, !diagram.nodesOfType('Trigger').exists(t, t.state == s.state))[0].state + ' state has no trigger; its totals are not computed.'"
        },
        "scope": [
          "diagram"
        ]
      },
      {
        "id": "missingOutcome",
        "code": "vsm.missing-outcome",
        "label": "No outcome",
        "severity": "warning",
        "rule": "diagram.nodesOfType('Trigger').all(t, diagram.nodesOfType('Outcome').exists(o, o.state == t.state))",
        "message": {
          "cel": "'The ' + diagram.nodesOfType('Trigger').filter(t, !diagram.nodesOfType('Outcome').exists(o, o.state == t.state))[0].state + ' state has no outcome.'"
        },
        "scope": [
          "diagram"
        ]
      },
      {
        "id": "secondTrigger",
        "code": "vsm.second-trigger",
        "label": "Second trigger",
        "severity": "warning",
        "rule": "diagram.nodesOfType('Trigger').filter(t, t.state == self.state).size() == 1",
        "message": {
          "cel": "'\"' + self.name + '\" is a second trigger of the ' + self.state + ' state; a stream starts once.'"
        },
        "scope": [
          "Trigger"
        ]
      },
      {
        "id": "secondOutcome",
        "code": "vsm.second-outcome",
        "label": "Second outcome",
        "severity": "warning",
        "rule": "diagram.nodesOfType('Outcome').filter(o, o.state == self.state).size() == 1",
        "message": {
          "cel": "'\"' + self.name + '\" is a second outcome of the ' + self.state + ' state; a stream ends once.'"
        },
        "scope": [
          "Outcome"
        ]
      },
      {
        "id": "unconnectedStep",
        "code": "vsm.unconnected-step",
        "label": "Unconnected step",
        "severity": "warning",
        "rule": "diagram.nodesOfType('Trigger').exists(t, t.state == self.state && self in t.reachable('Flow'))",
        "message": {
          "cel": "'No flow reaches \"' + self.name + '\" from the trigger; it is left out of the totals.'"
        },
        "scope": [
          "Step"
        ]
      },
      {
        "id": "missingWait",
        "code": "vsm.missing-wait",
        "label": "No wait time",
        "severity": "info",
        "rule": "has(self.waitTime)",
        "message": {
          "cel": "'\"' + self.name + '\" has no wait time; it counts as zero.'"
        },
        "scope": [
          "Step"
        ],
        "attribute": "waitTime"
      },
      {
        "id": "missingProcessTime",
        "code": "vsm.missing-process-time",
        "label": "No process time",
        "severity": "info",
        "rule": "has(self.processTime)",
        "message": {
          "cel": "'\"' + self.name + '\" has no process time; it counts as zero.'"
        },
        "scope": [
          "Step"
        ],
        "attribute": "processTime"
      },
      {
        "id": "shares",
        "code": "vsm.shares",
        "label": "Shares do not add up",
        "severity": "warning",
        "rule": "self.outgoingOf('Alternative').size() == 0 || math.abs(self.outgoingOf('Alternative').map(a, a.share).sum() - 1.0) < 0.0001",
        "message": {
          "cel": "'The alternatives leaving \"' + self.name + '\" take ' + formatNumber(self.outgoingOf('Alternative').map(a, a.share).sum() * 100.0, '0.#') + ' % of its work, not 100 %.'"
        },
        "scope": [
          "Step"
        ]
      },
      {
        "id": "unmarkedCycle",
        "code": "vsm.unmarked-cycle",
        "label": "Cycle of forward flows",
        "severity": "error",
        "rule": "!self.inCycle('Flow')",
        "message": {
          "cel": "'\"' + self.name + '\" lies on a cycle of forward flows. Mark the flow that goes back as rework; until then the totals of its state are not computed.'"
        },
        "scope": [
          "Step"
        ]
      },
      {
        "id": "reworkForward",
        "code": "vsm.rework-forward",
        "label": "Rework that goes forward",
        "severity": "warning",
        "rule": "self.source == self.target || self.source in self.target.reachable('Flow')",
        "message": {
          "cel": "'The rework from \"' + self.source.name + '\" goes to \"' + self.target.name + '\", which does not come before it; rework goes back to an earlier step.'"
        },
        "scope": [
          "Rework"
        ]
      },
      {
        "id": "tooManySteps",
        "code": "vsm.too-many-steps",
        "label": "Too many steps",
        "severity": "warning",
        "rule": "stepsOf('current').size() <= 64 && stepsOf('future').size() <= 64",
        "message": {
          "cel": "'A state has more than 64 steps; its totals are not computed.'"
        },
        "scope": [
          "diagram"
        ]
      },
      {
        "id": "unknownActivity",
        "code": "vsm.unknown-activity",
        "label": "Activity not in the list",
        "severity": "info",
        "rule": "!has(self.activity) || self.activity == '' || diagram.nodesOfType('Activity').exists(a, a.name == self.activity)",
        "message": {
          "cel": "'\"' + self.activity + '\" is not one of the stream\\'s activities; it is kept as written.'"
        },
        "scope": [
          "Step"
        ],
        "attribute": "activity"
      },
      {
        "id": "unknownPractice",
        "code": "vsm.unknown-practice",
        "label": "Practice not in the list",
        "severity": "info",
        "rule": "self.practices.all(p, diagram.nodesOfType('Practice').exists(q, q.name == p))",
        "message": {
          "cel": "'\"' + self.practices.filter(p, !diagram.nodesOfType('Practice').exists(q, q.name == p))[0] + '\" is not one of the stream\\'s practices; it is kept as written.'"
        },
        "scope": [
          "Step"
        ],
        "attribute": "practices"
      },
      {
        "id": "sameState",
        "code": "vsm.cross-state",
        "label": "Flow across states",
        "kind": "connect",
        "rule": "source.state == target.state",
        "message": {
          "cel": "'A flow joins two elements of one state; \"' + source.name + '\" is in the ' + source.state + ' state and \"' + target.name + '\" in the ' + target.state + ' state.'"
        },
        "doc": "Relations never cross states (data-model.md)."
      }
    ]
  },
  "behavior": {
    "doc": "Every edit is one undoable step. Creating the future state copies the current one in one step; showing a state changes the kept filter, which is also one step.",
    "operations": {
      "createFutureState": {
        "label": "Create future state",
        "icon": "mdi-content-copy",
        "for": "diagram",
        "unavailable": [
          {
            "when": "diagram.nodes.exists(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'future')",
            "message": "The map already has a future state. Remove it first to copy the current state again."
          },
          {
            "when": "!diagram.nodesOfType('Trigger').exists(t, t.state == 'current')",
            "message": "The current state has no trigger to copy yet."
          }
        ],
        "actions": [
          {
            "forEach": "diagram.nodes.filter(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'current')",
            "as": "n",
            "do": [
              {
                "create": {
                  "type": "n.type",
                  "attributes": {
                    "name": "n.name",
                    "state": "'future'",
                    "basedOn": "n.id",
                    "activity": "n.isA('Step') && has(n.activity) ? n.activity : null",
                    "practices": "n.isA('Step') ? n.practices : []",
                    "performer": "n.isA('Step') && has(n.performer) ? n.performer : null",
                    "processTime": "n.isA('Step') && has(n.processTime) ? n.processTime : null",
                    "waitTime": "n.isA('Step') && has(n.waitTime) ? n.waitTime : null",
                    "note": "n.isA('Step') && has(n.note) ? n.note : null"
                  }
                }
              }
            ]
          },
          {
            "forEach": "diagram.relations.filter(r, (r.isA('Flow') || r.isA('Rework')) && r.source.state == 'current')",
            "as": "r",
            "do": [
              {
                "let": {
                  "from": "diagram.nodes.filter(n, n.state == 'future' && n.basedOn == r.source.id)[0]",
                  "to": "diagram.nodes.filter(n, n.state == 'future' && n.basedOn == r.target.id)[0]"
                }
              },
              {
                "connect": {
                  "type": "r.type",
                  "source": "from",
                  "target": "to",
                  "attributes": {
                    "share": "r.isA('Alternative') ? r.share : null",
                    "rate": "r.isA('Rework') ? r.rate : null"
                  }
                }
              }
            ]
          },
          {
            "view": {
              "filters": {
                "state": "'future'"
              }
            },
            "target": "diagram"
          }
        ],
        "doc": "Research R3: every trigger, step, outcome and flow of the current state is copied into future:, each copy carrying basedOn, the id of what it copies; then the canvas shows the future state."
      },
      "showCurrent": {
        "label": "Show current state",
        "for": "diagram",
        "unavailable": [
          {
            "when": "diagram.shownState == 'current'",
            "message": "The current state is shown."
          }
        ],
        "actions": [
          {
            "view": {
              "filters": {
                "state": "'current'"
              }
            },
            "target": "diagram"
          }
        ]
      },
      "showFuture": {
        "label": "Show future state",
        "for": "diagram",
        "unavailable": [
          {
            "when": "!diagram.nodesOfType('Trigger').exists(t, t.state == 'future')",
            "message": "The map has no future state yet. Create it from the current state first."
          },
          {
            "when": "diagram.shownState == 'future'",
            "message": "The future state is shown."
          }
        ],
        "actions": [
          {
            "view": {
              "filters": {
                "state": "'future'"
              }
            },
            "target": "diagram"
          }
        ]
      },
      "removeFutureState": {
        "label": "Remove future state",
        "icon": "mdi-delete-outline",
        "for": "diagram",
        "unavailable": [
          {
            "when": "!diagram.nodes.exists(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'future')",
            "message": "The map has no future state."
          }
        ],
        "confirm": {
          "cel": "'Remove the future state and its ' + string(stepsOf('future').size()) + ' steps? The current state is kept.'"
        },
        "actions": [
          {
            "view": {
              "filters": {
                "state": "'current'"
              }
            },
            "target": "diagram"
          },
          {
            "delete": "diagram.nodes.filter(n, (n.isA('Trigger') || n.isA('Step') || n.isA('Outcome')) && n.state == 'future')"
          }
        ]
      }
    }
  },
  "viewpoints": {
    "stream": {
      "label": "Value stream",
      "exclude": [
        "Activity",
        "Practice"
      ],
      "default": true,
      "doc": "The vocabularies are lists of names, edited in forms and never drawn."
    }
  },
  "persistence": {
    "format": "fbl",
    "binding": "value-stream-map.fbl#vsm",
    "ids": {
      "strategy": "sequential",
      "prefix": {
        "Trigger": "t",
        "Step": "s",
        "Outcome": "o"
      },
      "types": {
        "Flow": {
          "strategy": "derived",
          "expression": "'flow:' + self.source.id + '->' + self.target.id",
          "doc": "A flow is written as its ends alone, so its id is formed from them; two flows between the same ends are refused (allowParallel false)."
        },
        "Rework": {
          "strategy": "derived",
          "expression": "'rework:' + self.source.id + '->' + self.target.id"
        },
        "Activity": {
          "strategy": "derived",
          "expression": "'activity:' + self.name"
        },
        "Practice": {
          "strategy": "derived",
          "expression": "'practice:' + self.name"
        }
      },
      "doc": "A new trigger, step or outcome takes the next free id of its kind, across the file: t, s or o followed by a number (contracts/value-stream-document.md, Rules). Ids written by hand are kept as written. A flow and a vocabulary entry have no id key in the file: theirs are formed from their ends or their name."
    },
    "typeMap": {
      "Diagram": {
        "as": "diagram",
        "attributes": {
          "shownState": null
        },
        "hostAttributes": [
          "unknownKeys"
        ],
        "doc": "The root mapping: name and unit; view.state is the kept filter's value (view.bind)."
      },
      "Activity": {
        "as": "Activity"
      },
      "Practice": {
        "as": "Practice"
      },
      "Trigger": {
        "as": "Trigger",
        "hostAttributes": [
          "unknownKeys"
        ]
      },
      "Step": {
        "as": "Step",
        "hostAttributes": [
          "unknownKeys"
        ]
      },
      "Outcome": {
        "as": "Outcome",
        "hostAttributes": [
          "unknownKeys"
        ]
      },
      "Flow": {
        "as": "Flow"
      },
      "Alternative": {
        "as": "Alternative"
      },
      "Rework": {
        "as": "Rework"
      }
    },
    "view": {
      "store": [
        "filters"
      ],
      "viewer": [
        "selection",
        "viewport"
      ],
      "bind": {
        "filters": {
          "type": "Diagram",
          "values": {
            "state": "shownState"
          },
          "doc": "The shown state is the key view.state."
        }
      },
      "doc": "The only view data kept in the file is the shown state, under view:, which the diagram writes and an agent leaves alone. Placement is computed from the flows, so nothing else is stored."
    },
    "doc": "One YAML file, .vsm, read and written through the FBL binding value-stream-map.fbl#vsm with byte-preserving splices. Its shape for people and agents is in value-stream-map.md, and its JSON Schema is value-stream-map.schema.json."
  },
  "x-adp": {
    "kind": "Diagram",
    "companion": "value-stream-map.md"
  }
}
