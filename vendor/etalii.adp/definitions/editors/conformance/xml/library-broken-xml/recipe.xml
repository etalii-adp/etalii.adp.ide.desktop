<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE recipe SYSTEM "recipe.dtd" [
  <!ENTITY oven "a hot oven, 220 degrees">
]>
<recipe serves="4">
  <title>Soda bread</title>
  <ingredient amount="450 g">plain flour</ingredient>
  <ingredient amount="1 tsp">bicarbonate of soda</ingredient>
  <ingredient amount="400 ml">buttermilk</ingredient>
  <step>Mix the dry ingredients, then stir in the buttermilk.</step>
  <step>Bake in &oven; for 30 minutes.</step>
</recipe>
