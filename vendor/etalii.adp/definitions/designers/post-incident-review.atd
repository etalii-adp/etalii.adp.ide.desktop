atd 0.1

/// The post-incident review designer: one incident's review as a page of parts, kept in one Markdown file a person and
/// an agent both read and write, specified by etalii.adp's spec 086.
///
/// A review is one Markdown file: a summary and its impact, a timeline of entries each with its time, its milestone and
/// its author, contributing factors with a category and a state, and actions with an owner and a due date. The designer
/// shows it as one page of sections: the timeline in time order on a time strip, the time to detect, engage, mitigate
/// and resolve computed from its milestones, the factors grouped by category, and the actions with what is missing.
/// What DESL cannot say (the file format in full, the blameless intent, the looks) is in `post-incident-review.md`
/// beside this file.
///
/// This description carries `post-incident-review.des` and the binding `markdown` of `post-incident-review.fbl` (in
/// post-incident-review.markdown.atd). The page a host lays out, the looks and which gesture starts which operation are
/// the host's (ATD §17), as `post-incident-review.md` lists them.
designer etalii/post-incident-review version "0.1.0" {
  label "Post-incident review designer"
  id: "net.etalii.adp.etalii.post-incident-review"
  authors: [{ name: "Peter Vrenken", url: "https://github.com/vrenken" }]
  license: "Apache-2.0"
  homepage: "https://etalii.net/adp"
  icon: "mdi-clipboard-pulse-outline"
  doc {
    summary: "A blameless post-incident review as a page of parts, in a Markdown file you and an agent both keep."
    rationale: "A review is a form, a timeline and lists on one page, and nothing in it is drawn connected: a factor names the entries it rests on and an action the factors it addresses, as values. That is why it is a designer."
    tags: ["incidents", "post-incident review", "service management", "markdown", "agents", "blameless"]
    seeAlso: [
      { title: "What DESL cannot express for this tool", href: "post-incident-review.md" },
      { title: "The Markdown binding", href: "post-incident-review.markdown.atd" }
    ]
  }

  import "post-incident-review.markdown.atd"

  model {
    /// The review. Its DED envelope (line 1) is the binding's header, not an attribute; its title, the `#` heading, is
    /// unbound text, kept as written and not part of the model.
    document {
      contains Entry, Factor, Action, Category
      /// The last entry number the counter gave: the mark of Entry's counter (DESL section 5.3.5), on line 2.
      attribute lastEntry: string { pattern: "^E-[0-9]+$" }
      /// The last factor number the counter gave.
      attribute lastFactor: string { pattern: "^F-[0-9]+$" }
      /// The last action number the counter gave.
      attribute lastAction: string { pattern: "^A-[0-9]+$" }
      /// The IANA name of the zone the review's times are shown in, from `- Time zone:` under Summary. A time keeps the
      /// offset it was written with; this only says how it is shown.
      attribute timeZone: string { label: "Time zone", pattern: r"^\S+$" }
      /// What happened, in a few sentences: the other item under Summary.
      attribute summary: text { label: "Summary" }
      /// Who or what was affected.
      attribute affected: string { label: "Affected" }
      /// What they could not do, and how much.
      attribute effect: string { label: "Effect" }
      /// How long it lasted, as the author writes it. The intervals the designer computes come from the timeline.
      attribute duration: string { label: "Duration" }
    }

    /// The milestones of an incident, in their usual order. An entry without one is an ordinary entry. The file writes
    /// the stored form before a colon and reads it in any case.
    enum EntryKind {
      ordered: true
      /// What set the incident off, such as a change.
      trigger { label: "Trigger" }
      /// When customers or users were first affected.
      start { label: "Start" }
      /// When the incident was first noticed, by an alert or a person.
      detection { label: "Detection" }
      /// When someone started working on it.
      engagement { label: "Engagement" }
      /// When the step that ended the impact began.
      mitigationStart { value: "mitigation start", label: "Mitigation start" }
      /// When the impact ended.
      mitigated { label: "Mitigated" }
      /// When the incident was closed.
      resolved { label: "Resolved" }
    }

    /// Who wrote an entry or a factor: an agent assembling the review, or a person.
    enum Author {
      agent { label: "Agent", icon: "mdi-robot-outline" }
      person { label: "Person", icon: "mdi-account-outline" }
    }

    /// Where a factor stands: proposed (by an agent or a person), accepted or rejected by a person. A rejected factor
    /// is kept, with its reason in its detail.
    enum FactorState {
      proposed { label: "Proposed" }
      accepted { label: "Accepted" }
      rejected { label: "Rejected" }
    }

    /// One line of the timeline (FR-002).
    element Entry {
      label "Timeline entry"
      icon: "mdi-clock-outline"
      labelAttribute: text
      /// When it happened: RFC 3339 with its offset, kept as written (FR-002). An entry without one is listed after the
      /// time strip and reported by pir.no-time.
      attribute time: datetime { label: "Time", timezone: "preserve" }
      /// The milestone the entry is, or none for an ordinary entry.
      attribute kind: EntryKind { label: "Milestone" }
      /// What happened, in one line.
      attribute text: string required { label: "Text" }
      /// Who wrote it; required by the file and reported by pir.no-author when missing.
      attribute author: Author { label: "By" }
      /// Links to what shows it: a log, a dashboard, a change.
      attribute evidence: string many { label: "Evidence" }
      /// The lines indented under it; `[E-0003]` there names an entry.
      attribute detail: text { label: "Detail", mentions: { pattern: r"\[(?:E|F|A)-\d+\]\([^)]*\)|\[(?<id>(?:E|F|A)-\d+)\]", types: ["Entry", "Factor", "Action"] } }
    }

    /// A condition that let the incident happen or made it worse (FR-004). No attribute names a person's fault
    /// (FR-009).
    element Factor {
      label "Contributing factor"
      icon: "mdi-puzzle-outline"
      labelAttribute: text
      /// A name of the category list, ignoring case; one outside it is kept and reported by pir.unknown-category.
      attribute category: string { label: "Category", pattern: r"^\S+$" }
      /// Proposed, accepted or rejected.
      attribute state: FactorState default proposed { label: "State" }
      /// Who proposed it.
      attribute author: Author { label: "By" }
      /// The condition that contributed, stated as a condition and not as a person's act.
      attribute text: string required { label: "Text" }
      /// Free tags.
      attribute tags: string many { label: "Tags", pattern: r"^[^\s#]+$" }
      /// The entries it rests on, by number; one that names no entry is reported by std.mentions (the data model's
      /// pir.unknown-entry).
      attribute entries: string many { label: "Entries", mentions: { pattern: r"^(?<id>E-\d+)$", types: ["Entry"] } }
      /// Links to what shows it.
      attribute evidence: string many { label: "Evidence" }
      /// The lines indented under it: more on the condition, or the reason it was rejected.
      attribute detail: text { label: "Detail", mentions: { pattern: r"\[(?:E|F|A)-\d+\]\([^)]*\)|\[(?<id>(?:E|F|A)-\d+)\]", types: ["Entry", "Factor", "Action"] } }
    }

    /// A change agreed on, to one or more factors (FR-005).
    element Action {
      label "Action"
      icon: "mdi-checkbox-marked-circle-outline"
      labelAttribute: text
      /// Whether it is done; open otherwise.
      attribute done: bool default false { label: "Done" }
      /// What is changed.
      attribute text: string required { label: "Text" }
      /// Who carries the action, such as a team; not who caused anything.
      attribute owner: string { label: "Owner", pattern: r"^\S+$" }
      /// When it is due.
      attribute due: date { label: "Due" }
      /// The factors it addresses, by number; one that names no factor is reported by std.mentions (the data model's
      /// pir.unknown-factor).
      attribute addresses: string many { label: "Addresses", mentions: { pattern: r"^(?<id>F-\d+)$", types: ["Factor"] } }
    }

    /// A category of factor; the list is the user's (FR-008).
    element Category {
      label "Category"
      icon: "mdi-shape-outline"
      labelAttribute: name
      /// The category's name, one word.
      attribute name: string required { label: "Name", pattern: r"^\S+$" }
    }
  }

  persistence {
    format: fbl
    typeMap: {
      Marks: { as: "document", doc: "Line 2 holds the last numbers the counters gave." }
      Summary: { as: "document", doc: "The time zone and the summary are the document's: the Summary part is a record of the document (DESL section 7.8.2)." }
      Impact: { as: "document", doc: "The three impact items are the document's, shown by the Impact part." }
      Unreadable: { as: "unreadable", doc: "An item in no known form: reported by std.unreadableEntry, the data model's pir.unread, and kept as written (FR-007)." }
    }
    ids: {
      missing: assign
      types: {
        Entry: { strategy: "counter", prefix: "E-", digits: 4, mark: "lastEntry", placeholder: "NEW", doc: "E-0001 onwards; E-NEW is numbered with the next write (R2)." }
        Factor: { strategy: "counter", prefix: "F-", digits: 4, mark: "lastFactor", placeholder: "NEW", doc: "F-0001 onwards, counted apart from the entries." }
        Action: { strategy: "counter", prefix: "A-", digits: 4, mark: "lastAction", placeholder: "NEW", doc: "A-0001 onwards." }
        Category: { strategy: "derived", expression: ('category/' + self.name.lowerAscii()) }
      }
    }
  }

  // ---------------------------------------------------------------- Intervals

  /// The entries of milestone `k`, a key of EntryKind, that have a time, in document order. The first is the
  /// milestone; a second is reported by pir.second-milestone and not used.
  fn milestones(k: string) -> list<Entry> {
    return document.elementsOfType('Entry').filter(e, has(e.kind) && e.kind == k && has(e.time))
  }

  /// The interval from the first entry of one milestone to the first of another. It has no value when either is
  /// absent, and the figure shows its absentText (R4).
  fn between(from: string, to: string) -> duration {
    return milestones(to)[0].time - milestones(from)[0].time
  }

  // ---------------------------------------------------------------- Constraints

  /// A review an agent wrote that breaks a rule still opens and shows; each breach is a finding where it is, and nothing
  /// is removed.
  constraints {
    defaults: { timing: [live] }
    blockSaveOn: never

    constraint noTime for Entry {
      rule has(self.time)
      severity warning
      message "This entry has no time; it is listed after the time strip and counts in no interval."
      code: "pir.no-time"
    }

    /// The milestone start is absent; the intervals that need it are absent too (R4).
    constraint missingStart for document {
      rule milestones('start').size() > 0
      severity info
      message "The timeline has no start entry, so the time to detect and to resolve cannot be computed."
      code: "pir.missing-milestone"
    }

    /// The milestone detection is absent; the intervals that need it are absent too (R4).
    constraint missingDetection for document {
      rule milestones('detection').size() > 0
      severity info
      message "The timeline has no detection entry, so the time to detect, to engage and to mitigate cannot be computed."
      code: "pir.missing-milestone"
    }

    /// The milestone engagement is absent; the intervals that need it are absent too (R4).
    constraint missingEngagement for document {
      rule milestones('engagement').size() > 0
      severity info
      message "The timeline has no engagement entry, so the time to engage cannot be computed."
      code: "pir.missing-milestone"
    }

    /// The milestone mitigated is absent; the intervals that need it are absent too (R4).
    constraint missingMitigated for document {
      rule milestones('mitigated').size() > 0
      severity info
      message "The timeline has no mitigated entry, so the time to mitigate cannot be computed."
      code: "pir.missing-milestone"
    }

    /// The milestone resolved is absent; the intervals that need it are absent too (R4).
    constraint missingResolved for document {
      rule milestones('resolved').size() > 0
      severity info
      message "The timeline has no resolved entry, so the time to resolve cannot be computed."
      code: "pir.missing-milestone"
    }

    constraint secondMilestone for Entry {
      when has(self.kind)
      rule self.positionIn(document.elementsOfType('Entry').filter(e, has(e.kind) && e.kind == self.kind)) == 0
      severity warning
      message ('A second ' + {'trigger': 'Trigger', 'start': 'Start', 'detection': 'Detection', 'engagement': 'Engagement', 'mitigationStart': 'Mitigation start', 'mitigated': 'Mitigated', 'resolved': 'Resolved'}[self.kind].lowerAscii() + ' entry; the intervals use the first.')
      code: "pir.second-milestone"
    }

    constraint noAuthor for Entry, Factor {
      rule has(self.author)
      severity info
      message "Who wrote this is not said; add by:agent or by:person."
      code: "pir.no-author"
    }

    constraint unknownCategory for Factor {
      when has(self.category)
      rule document.elementsOfType('Category').exists(c, c.name.lowerAscii() == self.category.lowerAscii())
      severity info
      message ('The category ' + self.category + ' is not in the category list; it is kept.')
      code: "pir.unknown-category"
    }

    constraint actionIncomplete for Action {
      rule has(self.owner) && has(self.due)
      severity warning
      message "This action has no owner or no due date."
      code: "pir.action-incomplete"
    }

    constraint unaddressed for Factor {
      when self.state == 'accepted'
      rule document.elementsOfType('Action').exists(x, self.id in x.addresses)
      severity info
      message "No action addresses this accepted factor."
      code: "pir.unaddressed"
    }
  }

  // ---------------------------------------------------------------- The page

  /// One page of six parts (R7). Selecting a factor highlights the entries it names, and an action the factors it
  /// addresses (DESL section 7.8.2).
  surface sections {
    /// The document's summary and time zone, with the four intervals computed from the timeline's milestones.
    record summary "Summary" Summary {
      fields: [{ attribute: summary, label: "Summary", widget: text }, { attribute: timeZone, label: "Time zone" }]
      figures: {
        timeToDetect: { label: "Time to detect", value: (between('start', 'detection')), absentText: "No start or detection entry yet", doc: "From start to detection." }
        timeToEngage: { label: "Time to engage", value: (between('detection', 'engagement')), absentText: "No detection or engagement entry yet", doc: "From detection to engagement." }
        timeToMitigate: { label: "Time to mitigate", value: (between('detection', 'mitigated')), absentText: "No detection or mitigated entry yet", doc: "From detection to mitigated." }
        timeToResolve: { label: "Time to resolve", value: (between('start', 'resolved')), absentText: "No start or resolved entry yet", doc: "From start to resolved." }
      }
    }
    /// Who or what was affected, how, and for how long, as the author writes it.
    record impact "Impact" Impact {
      fields: [{ attribute: affected, label: "Affected" }, { attribute: effect, label: "Effect" }, { attribute: duration, label: "Duration" }]
    }
    /// The entries in time order, an entry without a time last, on a time strip that highlights the milestones.
    list timeline "Timeline" Entry {
      fields: [
        { attribute: time, label: "Time" }, { attribute: kind, label: "Milestone" }, { attribute: text, label: "Text" },
        { attribute: author, label: "By" }, { attribute: evidence, label: "Evidence" }, { attribute: detail, label: "Detail", widget: text }
      ]
      order: (has(self.time) ? int(self.time) : 9223372036854775807)
      add: addEntry
      timeStrip: {
        at: time
        highlight: (has(self.kind))
        label: ({'trigger': 'Trigger', 'start': 'Start', 'detection': 'Detection', 'engagement': 'Engagement', 'mitigationStart': 'Mitigation start', 'mitigated': 'Mitigated', 'resolved': 'Resolved'}[self.kind])
      }
      marks: {
        secondMilestone: { when: (has(self.kind) && self.positionIn(document.elementsOfType('Entry').filter(e, has(e.kind) && e.kind == self.kind)) > 0), label: "Second milestone", style: warning }
        noAuthor: { when: (!has(self.author)), label: "No author", style: info }
      }
    }
    /// The factors by category, an uncategorised one under its own heading; a rejected one stays, marked.
    list factors "Contributing factors" Factor {
      fields: [
        { attribute: state, label: "State" }, { attribute: author, label: "By" }, { attribute: text, label: "Text" },
        { attribute: entries, label: "Entries" }, { attribute: tags, label: "Tags" }, { attribute: evidence, label: "Evidence" },
        { attribute: detail, label: "Detail", widget: text }
      ]
      group: (has(self.category) ? self.category.lowerAscii() : 'uncategorised')
      add: addFactor
      marks: {
        unaddressed: { when: (self.state == 'accepted' && !document.elementsOfType('Action').exists(x, self.id in x.addresses)), label: "Unaddressed", style: warning }
        rejected: { when: (self.state == 'rejected'), label: "Rejected", style: info }
      }
    }
    /// The actions, with what is missing marked.
    list actions "Actions" Action {
      fields: [
        { attribute: done, label: "Done" }, { attribute: text, label: "Text" }, { attribute: owner, label: "Owner" },
        { attribute: due, label: "Due" }, { attribute: addresses, label: "Addresses" }
      ]
      add: addAction
      marks: {
        incomplete: { when: (!has(self.owner) || !has(self.due)), label: "No owner or due date", style: warning }
      }
    }
    /// The user's list of factor categories (FR-008).
    list categories "Categories" Category {
      fields: [{ attribute: name, label: "Name" }]
      add: addCategory
    }
  }

  // ---------------------------------------------------------------- Operations

  /// An entry at the end of Timeline, numbered with the write (R2); its time is given in its row.
  operation addEntry "New entry" for document {
    create Entry { text: 'New entry', author: 'person' }
  }

  /// A proposed factor at the end of Contributing factors.
  operation addFactor "New factor" for document {
    create Factor { text: 'New factor', state: 'proposed', author: 'person' }
  }

  /// A person accepts a factor: one replace-value of its state word (User Story 2).
  operation acceptFactor "Accept" for Factor {
    unavailable [{ when: (self.state == 'accepted'), message: "This factor is accepted." }]
    set state = 'accepted'
  }

  /// A person rejects a factor. It is kept, so the review shows what was considered; the reason goes in its detail
  /// (User Story 2, scenario 3).
  operation rejectFactor "Reject" for Factor {
    unavailable [{ when: (self.state == 'rejected'), message: "This factor is rejected." }]
    set state = 'rejected'
  }

  /// An open action at the end of Actions.
  operation addAction "New action" for document {
    create Action { text: 'New action' }
  }

  /// From a factor: an open action that addresses it.
  operation addActionFor "New action for this factor" for Factor {
    create Action { text: 'New action', addresses: [self.id] }
  }

  /// A switch between `[ ]` and `[x]`: one replace-value of one character.
  operation completeAction for Action {
    label (self.done ? 'Reopen' : 'Done')
    set done = !self.done
  }

  /// A category at the end of Categories (FR-008).
  operation addCategory "New category" for document {
    param name: string required { pattern: r"^\S+$" }
    create Category { name: p.name }
  }
}
