{
  "$schema": "https://etalii.net/adp/disl/schema/0.2/disl.schema.json#/$defs/Specification",
  "disl": "0.6",
  "doc": "Refused by DISL section 4.7, relation flags: `Strong` states `allowParallel: true`, which widens the `false` of its supertype `Link`. A relation type may only narrow a flag it inherits.",
  "language": {
    "id": "org.example.refused.relation-flag-widened",
    "version": "1.0.0"
  },
  "metamodel": {
    "types": {
      "Item": {}
    },
    "relations": {
      "Link": { "source": "Item", "target": "Item", "allowParallel": false },
      "Strong": { "extends": "Link", "allowParallel": true }
    }
  }
}
