    [
      {
        "id": "m1",
        "kind": "milestone"
      },
      {
        "id": "m2",
        "kind": "milestone"
      }
    ]
  ],
  "reads": [
    {
      "key": "milestone",
      "group": [
        {
          "id": "m1",
          "kind": "milestone"
        },
        {
          "id": "m2",
          "kind": "milestone"
        }
      ]
    }
  ]
}
