atd 0.1

/// A counter's mark is a `string` attribute of the document (DESL §5.3.5); `lastItem` is an `int`: one finding, at the
/// setting `mark` (ATD §14.7).
designer example/outline version "0.1.0" {
  label "Outline"
  model {
    document {
      attribute lastItem: int
    }
    element Item {
      attribute title: string required
      contains Item, Requirement ordered
    }
    element Requirement {
      attribute title: string required
    }
  }
  persistence {
    ids: { types: { Item: { strategy: counter, prefix: "ITEM-", digits: 4, mark: lastItem } } }
  }
  surface hierarchy {
    levels Item { title: title }
    entries Requirement { title: title }
  }
}
