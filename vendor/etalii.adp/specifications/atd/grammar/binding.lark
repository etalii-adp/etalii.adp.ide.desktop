// ATD 0.1, module binding: FBL 0.9's bindings, one to one (ATD §11; FBL §3 to §13).
// Uses from core: name, qualified, names, type_ref, value, setting, settings_block, doc_member, label_member, STRING,
// INT, DASHED_WORD. Uses from cel: expr. Uses from notation: grammar_text.

// `binding freeplane family xml { … }`; `family capability <name>` reads the body with a persistence plugin's
// contract (FBL §11); a binding without `family` is a folder binding (FBL §10). `family grammar` carries its grammar
// in ATD grammar notation, inline as `grammar { … }` or as `grammar from "<file>.lark"` (FBL §4.9, ATD §11.9).
binding: "binding" rule_name ["family" binding_family] "{" binding_member* "}"
binding_family: name -> declared_family
              | "capability" qualified -> capability_family

?binding_member: "claims" "files" STRING ("," STRING)* -> claims_files
               | "claims" settings_block -> claims
               | "body" settings_block -> body
               | "text" settings_block -> text_defaults
               | "header" settings_block -> header
               | "registration" settings_block -> registration
               | "template" value -> template
               | "grammar" "{" grammar_text "}" -> grammar_inline
               | "grammar" "from" STRING -> grammar_file
               | "block" rule_name ["line" STRING] [settings_block] -> block_rule
               | "section" rule_name STRING [settings_block] -> section_rule
               | element_rule
               | relation_rule
               | setting
               | doc_member
               | label_member

// `element Topic at "node" { … }`: entries at a selector (yaml, json, xml) or statements matching a line (lines,
// blocks, bullets) become elements of a type; `as` names the rule when one type has several (FBL §5.1).
element_rule: "element" type_ref ["as" rule_name] [rule_place] "{" rule_member* "}"
relation_rule: "relation" type_ref ["as" rule_name] [rule_place] "{" relation_rule_member* "}"
rule_place: "at" STRING -> at
          | "line" STRING -> line

// The name of a binding, a rule, a block, a section or a file rule, where a binding declares or names it: FBL's names
// (FBL §2.2) admit hyphens and dots, so a dashed word is a name here, `as unreadable-requirement` (ATD §3.6, §11.3).
rule_name: rule_word ("." rule_word)*
rule_names: rule_name ("," rule_name)*
?rule_word: name
          | DASHED_WORD

?rule_member: "id" "from" slot [settings_block] -> id_from
            | "id" settings_block -> id
            | "attribute" name ["from" slot] [attribute_binding_block] -> attribute_binding
            | "parent" rule_names ["slot" name] -> parent
            | "within" rule_names -> within
            | "when" expr -> when
            | "files" rule_names -> files
            | "insert" settings_block -> insert
            | "remove" settings_block -> remove
            | setting
            | doc_member
?relation_rule_member: rule_member
                     | "source" "from" slot [settings_block] -> source
                     | "target" "from" slot [settings_block] -> target

// A slot (FBL §5.2): `key "id"`, `attribute "TEXT"`, `text`, `group "name"`, `continuation`, `parent "a"`,
// `capture "c"`, `value (cel)`.
slot: name [slot_argument]
?slot_argument: STRING | INT | "(" expr ")" -> cel_slot

attribute_binding_block: "{" attribute_binding_member* "}"
?attribute_binding_member: "references" rule_names "by" name -> references
                         | setting
                         | doc_member
