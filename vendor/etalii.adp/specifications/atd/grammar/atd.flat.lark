// ATD 0.1, the grammar in one file (ATD section 4.6): generated by .github/scripts/atd-grammar.py --flatten
// from the modules in this folder. A module's own symbols carry its name as prefix; do not edit.

// The start symbol model services look for (LLGuidance, FR-090); the language's start symbol is `description`.
start: description

// ---- atd.lark
description: header (tool | part)
header: "atd" VERSION
tool: tool_kind ORIGIN "version" STRING "{" member* "}"
tool_kind: "diagram" -> diagram
         | "designer" -> designer
         | "editor" -> editor
part: "part" "of" ORIGIN member*
?member: core_member
       | canvas_member
       | form_surface
       | text_surface
       | binding
VERSION: /[0-9]+\.[0-9]+/

// ---- core.lark
name: word
    | "as" | "break" | "continue" | "else" | "for" | "if" | "import" | "in" | "let" | "return" | "var" | "while"
word: NAME
    | "after" | "algorithm" | "at" | "atd" | "attribute" | "axis" | "badge" | "before" | "behavior"
    | "binding" | "block" | "body" | "builtin" | "by" | "call" | "canvas" | "capability" | "cells" | "check"
    | "claims" | "columns" | "compartment" | "complete" | "confirm" | "connect" | "constraint" | "constraints"
    | "contains" | "context" | "convert" | "coordinates" | "create" | "datatype" | "default" | "defaults" | "delete"
    | "designer" | "diagram" | "doc" | "document" | "edge" | "editLabel" | "editor" | "element"
    | "enabled" | "entries" | "enum" | "extends" | "fail" | "family" | "field" | "files" | "filters" | "fix" | "fn"
    | "fold" | "form" | "from" | "group" | "header" | "hierarchy" | "highlight" | "hook" | "icon" | "id"
    | "insert" | "into" | "item" | "label" | "labels" | "layout" | "levels" | "limit" | "line" | "many" | "marker"
    | "message" | "mid" | "model" | "move" | "node" | "notation" | "notes" | "notify" | "of" | "on" | "open"
    | "openForm" | "operation" | "ordered" | "outline" | "param" | "parent" | "part" | "persistence" | "place"
    | "plugin" | "port" | "preview" | "readonly" | "reason" | "recursion" | "references" | "registration"
    | "relation" | "remove" | "reorder" | "reparent" | "required" | "requires" | "resize" | "retype" | "reveal"
    | "rows" | "rule" | "section" | "select" | "set" | "severity" | "shape" | "size" | "slot" | "snapping"
    | "source" | "state" | "style" | "surface" | "system" | "table" | "target" | "template" | "text" | "theme" | "to"
    | "token" | "tokens" | "tool" | "toolbox" | "unavailable" | "unset" | "valueType" | "variant" | "version"
    | "view" | "viewpoint" | "views" | "when" | "with" | "within"
qualified: name ("." name)*
names: qualified ("," qualified)*
type_ref: qualified ["<" type_ref ("," type_ref)* ">"]
value: core__literal
     | "(" expr ")" -> core__cel_value
     | ATTR_REF -> core__attribute_ref
     | TOKEN_REF -> core__token_ref
     | PARAM_REF -> core__param_ref
     | core__settings_map
     | core__value_list
core__literal: name -> core__word_literal
       | DASHED_WORD -> core__word_literal
       | STRING -> core__string_literal
       | INT -> core__number_literal
       | DOUBLE -> core__number_literal
       | "-" INT -> core__negative_literal
       | "-" DOUBLE -> core__negative_literal
       | LENGTH -> core__length_literal
core__value_list: "[" [value ("," value)* [","]] "]"
core__settings_map: "{" core__map_entry* "}"
core__map_entry: KEY value [","]
         | STRING ":" value [","] -> core__quoted_entry
setting: KEY value [","]
doc_member: "doc" value
label_member: "label" value
settings_block: "{" core__settings_member* "}"
?core__settings_member: setting | doc_member | label_member
?core_member: label_member
            | doc_member
            | setting
            | core__import_decl
            | core__requires_decl
            | core__model
            | core__constraints
            | core__constraint
            | core__operation
            | core__hook
            | core__reason
            | core__message_decl
            | core__behavior
            | core__persistence
            | core__plugin
            | fn_decl
core__import_decl: "import" STRING ["as" name] [settings_block]
core__requires_decl: "requires" "capability" qualified CAPABILITY_RANGE
core__model: "model" "{" core__model_member* "}"
?core__model_member: core__element
             | core__relation
             | core__enum_decl
             | core__datatype
             | core__document_decl
             | setting
             | doc_member
core__element: "element" name [extends] ["{" core__element_member* "}"]
extends: "extends" names
?core__element_member: core__attribute
               | core__contains
               | core__port
               | setting
               | doc_member
               | label_member
core__attribute: "attribute" name ":" type_ref core__attribute_flag* [settings_block]
core__attribute_flag: "required" -> core__required
              | "many" -> core__many
              | "readonly" -> core__readonly
              | "default" value -> core__default
core__contains: "contains" names ["as" name] ["ordered"] [settings_block]
core__port: "port" name [settings_block]
core__relation: "relation" name [extends] ["from" names "to" names] ["{" core__element_member* "}"]
core__enum_decl: "enum" name [STRING] "{" core__enum_member* "}"
?core__enum_member: core__enum_value | setting
core__enum_value: name [settings_block]
          | STRING [settings_block] -> core__quoted_enum_value
core__datatype: "datatype" name [":" type_ref] [settings_block]
core__document_decl: "document" "{" core__element_member* "}"
core__constraints: "constraints" "{" core__constraints_member* "}"
?core__constraints_member: core__constraint | core__builtin | setting | doc_member
core__constraint: "constraint" name ["for" names] "{" core__constraint_member* "}"
?core__constraint_member: "when" expr -> core__when
                  | "rule" expr -> core__rule
                  | "message" value -> core__message
                  | "severity" name -> core__severity
                  | fix
                  | setting
                  | doc_member
                  | label_member
core__builtin: "builtin" qualified [settings_block]
fix: "fix" name [STRING] "{" core__fix_member* [void_return] "}"
?core__fix_member: "when" expr -> core__when
           | stmt
           | setting
           | doc_member
           | label_member
core__operation: "operation" name [STRING] ["for" names] "{" core__operation_member* [void_return] "}"
?core__operation_member: "enabled" expr -> core__enabled
                 | "unavailable" value -> core__unavailable
                 | "param" name ":" type_ref core__attribute_flag* [settings_block] -> core__param
                 | "confirm" settings_block -> core__confirm
                 | stmt
                 | setting
                 | doc_member
                 | label_member
core__hook: "hook" name "on" name ["for" names] "{" core__hook_member* [void_return] "}"
?core__hook_member: "when" expr -> core__when
            | stmt
            | setting
            | doc_member
core__reason: "reason" name STRING
      | "reason" name "{" core__reason_member* "}"
?core__reason_member: "when" expr -> core__when
              | "message" value -> core__message
              | setting
              | doc_member
core__message_decl: "message" qualified value
core__behavior: "behavior" settings_block
core__persistence: "persistence" settings_block
core__plugin: "plugin" qualified [settings_block]
NAME: /[A-Za-z_][A-Za-z0-9_]*/
DASHED_WORD: /[A-Za-z_][A-Za-z0-9_]*(-[A-Za-z0-9_]+)+/
KEY: /[A-Za-z_][A-Za-z0-9_-]*(\.[A-Za-z_][A-Za-z0-9_-]*)*[ \t]*:/
STRING: /[rR]("""(("|"")?[^"])*("|"")?"""|'''(('|'')?[^'])*('|'')?'''|"[^"\n\r]*"|'[^'\n\r]*')|"""(("|"")?([^"\\]|\\[\s\S]))*("|"")?"""|'''(('|'')?([^'\\]|\\[\s\S]))*('|'')?'''|"([^"\\\n\r]|\\[^\n\r])*"|'([^'\\\n\r]|\\[^\n\r])*'/
ATTR_REF: /@[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*/
TOKEN_REF: /\$[A-Za-z_][A-Za-z0-9_-]*(\.[A-Za-z_][A-Za-z0-9_-]*)*/
LENGTH: /([0-9]+\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+)(px|mm|in|em|%)/
PARAM_REF: /#[A-Za-z_][A-Za-z0-9_]*/
CAPABILITY_RANGE: /@[\^~<>=*0-9][^ \t\r\n{}]*/
ORIGIN: /[A-Za-z0-9_][A-Za-z0-9_.-]*\/[A-Za-z0-9_][A-Za-z0-9_.-]*/
WHITESPACE: /[ \t\r\n]+/
COMMENT: /\/\/[^\n]*/
BLOCK_COMMENT: /\/\*([^*]|\*+[^*\/])*\*+\//

// ---- cel.lark
?expr: cel__or_expr
     | cel__or_expr "?" cel__or_expr ":" expr -> cel__cel_conditional
?cel__or_expr: cel__and_expr
        | cel__or_expr "||" cel__and_expr -> cel__cel_or
?cel__and_expr: cel__relation
         | cel__and_expr "&&" cel__relation -> cel__cel_and
?cel__relation: cel__addition
         | cel__relation "<" cel__addition -> cel__cel_less
         | cel__relation "<=" cel__addition -> cel__cel_less_equal
         | cel__relation ">=" cel__addition -> cel__cel_greater_equal
         | cel__relation ">" cel__addition -> cel__cel_greater
         | cel__relation "==" cel__addition -> cel__cel_equal
         | cel__relation "!=" cel__addition -> cel__cel_not_equal
         | cel__relation "in" cel__addition -> cel__cel_in
?cel__addition: cel__multiplication
         | cel__addition "+" cel__multiplication -> cel__cel_add
         | cel__addition "-" cel__multiplication -> cel__cel_subtract
?cel__multiplication: cel__unary
               | cel__multiplication "*" cel__unary -> cel__cel_multiply
               | cel__multiplication "/" cel__unary -> cel__cel_divide
               | cel__multiplication "%" cel__unary -> cel__cel_modulo
?cel__unary: cel__member
      | "!" cel__unary -> cel__cel_not
      | "-" cel__unary -> cel__cel_negate
?cel__member: cel__primary
       | cel__member "." cel__cel_ident -> cel__cel_select
       | cel__member "." "?" cel__cel_ident -> cel__cel_optional_select
       | cel__member "." cel__cel_ident "(" [cel__cel_args] ")" -> cel__cel_method
       | cel__member "[" expr "]" -> cel__cel_index
       | cel__member "[" "?" expr "]" -> cel__cel_optional_index
?cel__primary: cel__cel_ident -> cel__cel_ident_expr
        | "." cel__cel_ident -> cel__cel_root_ident
        | cel__cel_ident "(" [cel__cel_args] ")" -> cel__cel_call
        | "." cel__cel_ident "(" [cel__cel_args] ")" -> cel__cel_root_call
        | "(" expr ")"
        | "[" [cel__cel_list_elements] "]" -> cel__cel_list
        | "{" [cel__cel_map_entries] "}" -> cel__cel_map
        | cel__cel_literal
cel__cel_args: expr ("," expr)*
cel__cel_list_elements: cel__cel_list_element ("," cel__cel_list_element)* [","]
cel__cel_list_element: expr
                | "?" expr -> cel__cel_optional_element
cel__cel_map_entries: cel__cel_map_entry ("," cel__cel_map_entry)* [","]
cel__cel_map_entry: expr ":" expr
             | "?" expr ":" expr -> cel__cel_optional_entry
cel__cel_ident: word
cel__cel_literal: INT
           | UINT
           | DOUBLE
           | STRING
           | BYTES
           | "true" -> cel__cel_true
           | "false" -> cel__cel_false
           | "null" -> cel__cel_null
INT: /0x[0-9a-fA-F]+|[0-9]+/
UINT: /(0x[0-9a-fA-F]+|[0-9]+)[uU]/
DOUBLE: /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|\.[0-9]+([eE][+-]?[0-9]+)?/
BYTES: /([bB][rR]?|[rR][bB])("""(("|"")?([^"\\]|\\[\s\S]))*("|"")?"""|'''(('|'')?([^'\\]|\\[\s\S]))*('|'')?'''|"([^"\\\n\r]|\\[^\n\r])*"|'([^'\\\n\r]|\\[^\n\r])*')/

// ---- script.lark
fn_decl: "fn" name "(" [script__fn_param ("," script__fn_param)*] ")" ["->" type_ref] ["recursion" INT] script__stmt_block
script__fn_param: name ":" type_ref
script__stmt_block: "{" stmt* [void_return] "}"
void_return: "return"
?stmt: "let" name [":" type_ref] "=" expr -> script__let_stmt
     | "var" name [":" type_ref] "=" expr -> script__var_stmt
     | ASSIGN expr -> script__assign_stmt
     | script__if_stmt
     | "for" name ["," name] "in" expr "limit" INT script__stmt_block -> script__for_stmt
     | "while" expr "limit" INT script__stmt_block -> script__while_stmt
     | "return" expr -> script__return_stmt
     | "break" -> script__break_stmt
     | "continue" -> script__continue_stmt
     | "fail" expr -> script__fail_stmt
     | script__action
script__if_stmt: "if" expr script__stmt_block ["else" (script__if_stmt | script__stmt_block)]
?script__action: "set" script__path "=" expr -> script__set_action
       | "unset" script__path -> script__unset_action
       | "create" type_ref [script__assignments] ["in" expr] script__create_option* ["as" name] -> script__create_action
       | "connect" type_ref "from" expr "to" expr [script__assignments] ["as" name] -> script__connect_action
       | "delete" expr -> script__delete_action
       | "move" expr ["to" expr "," expr] ["into" expr] -> script__move_action
       | "resize" expr "to" expr "," expr -> script__resize_action
       | "retype" expr "to" type_ref -> script__retype_action
       | "reparent" expr "to" expr script__reparent_option* -> script__reparent_action
       | "reorder" expr script__reorder_option -> script__reorder_action
       | "view" expr script__assignments -> script__view_action
       | "open" expr -> script__open_action
       | "openForm" name "for" expr -> script__open_form_action
       | "editLabel" expr [settings_block] -> script__edit_label_action
       | "select" expr -> script__select_action
       | "reveal" expr -> script__reveal_action
       | "highlight" expr [settings_block] -> script__highlight_action
       | "notify" expr ["severity" name] -> script__notify_action
       | "layout" name ["on" expr] [settings_block] -> script__layout_action
       | "call" qualified "(" [script__call_arg ("," script__call_arg)*] ")" -> script__call_action
       | "call" "plugin" qualified "(" [script__call_arg ("," script__call_arg)*] ")" -> script__plugin_action
script__path: name ("." name)*
script__assignments: "{" script__assignment* "}"
script__assignment: KEY expr [","]
script__create_option: "after" expr -> script__after
             | "before" expr -> script__before
             | "slot" name -> script__slot
             | "at" expr -> script__at
             | "size" expr -> script__size
             | "place" name -> script__place
script__reparent_option: "slot" name -> script__slot
               | "after" expr -> script__after
               | "before" expr -> script__before
script__reorder_option: "by" expr -> script__by
              | "after" expr -> script__after
              | "before" expr -> script__before
script__call_arg: expr
        | KEY expr -> script__named_arg
ASSIGN: /[A-Za-z_][A-Za-z0-9_]*[ \t]*=/

// ---- canvas.lark
?canvas_member: canvas__coordinates
              | canvas__notation
              | canvas__toolbox
              | canvas__form
              | canvas__layout
              | canvas__viewpoint
canvas__coordinates: "coordinates" "{" canvas__coordinates_member* "}"
?canvas__coordinates_member: "system" name [settings_block] -> canvas__coordinate_system
                   | "axis" name [settings_block] -> canvas__axis
                   | "snapping" name [settings_block] -> canvas__snapping_profile
                   | "default" name -> canvas__default_system
                   | setting
                   | doc_member
canvas__notation: "notation" "{" canvas__notation_member* "}"
?canvas__notation_member: "theme" settings_block -> canvas__theme
                | "style" name [extends] settings_block -> canvas__style
                | "shape" name settings_block -> canvas__shape_definition
                | "marker" name settings_block -> canvas__marker_definition
                | "icon" name settings_block -> canvas__icon_definition
                | "canvas" settings_block -> canvas__canvas
                | "defaults" settings_block -> canvas__defaults
                | canvas__node_notation
                | canvas__edge_notation
                | canvas__port_notation
                | setting
                | doc_member
canvas__node_notation: "node" names "{" canvas__node_member* "}"
?canvas__node_member: canvas__shape_use
            | canvas__label_decl
            | "variant" name ["when" expr] "{" canvas__node_member* "}" -> canvas__variant
            | "state" name settings_block -> canvas__state
            | "compartment" name settings_block -> canvas__compartment
            | "badge" name settings_block -> canvas__badge
            | "port" names settings_block -> canvas__node_port
            | setting
            | doc_member
canvas__shape_use: "shape" value [settings_block]
canvas__label_decl: "label" value ["as" name] [settings_block]
canvas__edge_notation: "edge" names "{" canvas__edge_member* "}"
?canvas__edge_member: "line" settings_block -> canvas__line
            | "marker" canvas__marker_end value [settings_block] -> canvas__marker
            | canvas__label_decl
            | "variant" name ["when" expr] "{" canvas__edge_member* "}" -> canvas__variant
            | "state" name settings_block -> canvas__state
            | setting
            | doc_member
canvas__marker_end: "source" -> canvas__source
          | "target" -> canvas__target
          | "mid" -> canvas__mid
canvas__port_notation: "port" names settings_block
canvas__toolbox: "toolbox" "{" canvas__toolbox_member* "}"
?canvas__toolbox_member: canvas__tool_group
               | canvas__tool
               | canvas__context_tools
               | "template" name [STRING] settings_block -> canvas__template
               | setting
               | doc_member
canvas__tool_group: "group" name [STRING] "{" canvas__toolbox_member* "}"
canvas__tool: "tool" name [STRING] [settings_block]
canvas__context_tools: "context" ["for" names] ["when" expr] "{" canvas__context_member* "}"
?canvas__context_member: canvas__context_tool
               | setting
               | doc_member
canvas__context_tool: "tool" [name] [STRING] settings_block
canvas__form: "form" name [STRING] ["for" names] "{" canvas__form_member* "}"
?canvas__form_member: canvas__form_item
            | setting
            | doc_member
            | label_member
?canvas__form_item: "field" name [STRING] [settings_block] -> canvas__field
          | "section" [name] [STRING] "{" canvas__form_member* "}" -> canvas__section
          | "item" [name] [STRING] settings_block -> canvas__form_item
canvas__layout: "layout" "{" canvas__layout_member* "}"
?canvas__layout_member: "default" name -> canvas__default_layout
              | "algorithm" name ["capability" qualified] [settings_block] -> canvas__algorithm
              | setting
              | doc_member
canvas__viewpoint: "viewpoint" name [STRING] [settings_block]

// ---- form.lark
form_surface: "surface" "table" "{" form__table_member* "}" -> form__table_surface
            | "surface" "hierarchy" "{" form__hierarchy_member* "}" -> form__hierarchy_surface
?form__table_member: "rows" type_ref [settings_block] -> form__rows
             | "columns" type_ref [settings_block] -> form__columns
             | "cells" type_ref [settings_block] -> form__cells
             | "views" type_ref [settings_block] -> form__views
             | form__value_type
             | setting
             | doc_member
form__value_type: "valueType" name [STRING] "{" form__value_type_member* "}"
?form__value_type_member: "convert" name value -> form__convert
                  | setting
                  | doc_member
                  | label_member
?form__hierarchy_member: "levels" type_ref [settings_block] -> form__levels
                 | "entries" type_ref [settings_block] -> form__entries
                 | "notes" type_ref [settings_block] -> form__notes
                 | "filters" type_ref [settings_block] -> form__filters
                 | "labels" name [settings_block] -> form__labels
                 | setting
                 | doc_member

// ---- text.lark
text_surface: "surface" "text" "{" text__text_member* "}"
?text__text_member: "files" STRING ("," STRING)* -> text__files
            | "tokens" name [settings_block] -> text__tokens
            | "token" name [settings_block] -> text__token_class
            | "fold" names [settings_block] -> text__fold
            | "outline" names ["by" name] [settings_block] -> text__outline
            | "complete" "from" text__text_source [settings_block] -> text__complete
            | "check" "with" text__text_source [settings_block] -> text__check
            | "preview" text__text_source [settings_block] -> text__preview
            | fix
            | setting
            | doc_member
text__text_source: "capability" qualified -> text__capability_source
           | STRING -> text__named_source

// ---- binding.lark
binding: "binding" name ["family" binding__binding_family] "{" binding__binding_member* "}"
binding__binding_family: name -> binding__declared_family
              | "capability" qualified -> binding__capability_family
?binding__binding_member: "claims" "files" STRING ("," STRING)* -> binding__claims_files
               | "claims" settings_block -> binding__claims
               | "body" settings_block -> binding__body
               | "text" settings_block -> binding__text_defaults
               | "header" settings_block -> binding__header
               | "registration" settings_block -> binding__registration
               | "template" value -> binding__template
               | "block" name ["line" STRING] [settings_block] -> binding__block_rule
               | "section" name STRING [settings_block] -> binding__section_rule
               | binding__element_rule
               | binding__relation_rule
               | setting
               | doc_member
               | label_member
binding__element_rule: "element" type_ref ["as" name] [binding__rule_place] "{" binding__rule_member* "}"
binding__relation_rule: "relation" type_ref ["as" name] [binding__rule_place] "{" binding__relation_rule_member* "}"
binding__rule_place: "at" STRING -> binding__at
          | "line" STRING -> binding__line
?binding__rule_member: "id" "from" binding__slot [settings_block] -> binding__id_from
            | "id" settings_block -> binding__id
            | "attribute" name ["from" binding__slot] [binding__attribute_binding_block] -> binding__attribute_binding
            | "parent" names ["slot" name] -> binding__parent
            | "within" names -> binding__within
            | "when" expr -> binding__when
            | "files" names -> binding__files
            | "insert" settings_block -> binding__insert
            | "remove" settings_block -> binding__remove
            | setting
            | doc_member
?binding__relation_rule_member: binding__rule_member
                     | "source" "from" binding__slot [settings_block] -> binding__source
                     | "target" "from" binding__slot [settings_block] -> binding__target
binding__slot: name [binding__slot_argument]
?binding__slot_argument: STRING | INT | "(" expr ")" -> binding__cel_slot
binding__attribute_binding_block: "{" binding__attribute_binding_member* "}"
?binding__attribute_binding_member: "references" names "by" name -> binding__references
                         | setting
                         | doc_member

// ---- notation.lark

%ignore WHITESPACE
%ignore COMMENT
%ignore BLOCK_COMMENT
