{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ATD",
  "scopeName": "source.atd",
  "fileTypes": [
    "atd"
  ],
  "comment": "Generated by etalii.adp/.github/scripts/atd-grammar.py --highlighting from the ATD grammar; do not edit.",
  "patterns": [
    {
      "include": "#block-comment"
    },
    {
      "include": "#triple-double"
    },
    {
      "include": "#triple-single"
    },
    {
      "name": "comment.line.documentation.atd",
      "match": "///[^\\n]*"
    },
    {
      "name": "comment.line.double-slash.atd",
      "match": "//[^\\n]*"
    },
    {
      "name": "string.quoted.double.atd",
      "match": "[rRbB]{0,2}\"(?:[^\"\\\\\\n\\r]|\\\\[^\\n\\r])*\""
    },
    {
      "name": "string.quoted.single.atd",
      "match": "[rRbB]{0,2}'(?:[^'\\\\\\n\\r]|\\\\[^\\n\\r])*'"
    },
    {
      "name": "entity.name.namespace.origin.atd",
      "match": "\\b[A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*"
    },
    {
      "name": "constant.other.capability-range.atd",
      "match": "@[\\^~<>=*0-9][^ \\t\\r\\n{}]*"
    },
    {
      "name": "variable.other.attribute-reference.atd",
      "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    {
      "name": "variable.other.token-reference.atd",
      "match": "\\$[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*"
    },
    {
      "name": "variable.parameter.param-reference.atd",
      "match": "#[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "constant.numeric.length.atd",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:px|mm|in|em|%)"
    },
    {
      "name": "constant.numeric.atd",
      "match": "\\b(?:0x[0-9a-fA-F]+[uU]?|[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|[0-9]+[uU]?)\\b"
    },
    {
      "name": "support.type.property-name.atd",
      "match": "\\b[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*(?=[ \\t]*:(?!:))"
    },
    {
      "name": "variable.other.word.atd",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)+\\b"
    },
    {
      "name": "keyword.control.atd",
      "match": "\\b(?:continue|return|break|limit|while|else|fail|for|let|var|if|in)\\b"
    },
    {
      "name": "constant.language.atd",
      "match": "\\b(?:true|false|null)\\b"
    },
    {
      "name": "keyword.other.atd",
      "match": "\\b(?:registration|compartment|constraints|coordinates|persistence|unavailable|capability|constraint|references|algorithm|attribute|editLabel|hierarchy|highlight|operation|recursion|valueType|viewpoint|behavior|complete|contains|datatype|defaults|designer|document|notation|openForm|readonly|relation|reparent|required|requires|severity|snapping|template|binding|builtin|columns|confirm|connect|context|convert|default|diagram|element|enabled|entries|extends|filters|message|ordered|outline|preview|reorder|section|surface|toolbox|variant|version|before|canvas|claims|create|delete|editor|family|header|import|insert|labels|layout|levels|marker|notify|parent|plugin|reason|remove|resize|retype|reveal|select|source|system|target|tokens|widths|within|after|badge|block|cells|check|field|files|group|label|model|notes|param|place|shape|state|style|table|theme|token|unset|views|axis|body|call|edge|enum|fold|form|from|hook|icon|into|item|line|many|move|node|open|part|port|rows|rule|size|slot|text|tool|view|when|with|atd|doc|fix|mid|set|as|at|by|fn|id|of|on|to)\\b"
    },
    {
      "name": "keyword.operator.atd",
      "match": "->|&&|\\|\\||==|!=|<=|>=|[-+*/%!<>=?]"
    },
    {
      "name": "punctuation.atd",
      "match": "[{}()\\[\\],.:]"
    },
    {
      "name": "variable.other.name.atd",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.atd",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "triple-double": {
      "name": "string.quoted.triple.atd",
      "begin": "[rRbB]{0,2}\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "match": "\\\\[\\s\\S]"
        }
      ]
    },
    "triple-single": {
      "name": "string.quoted.triple.atd",
      "begin": "[rRbB]{0,2}'''",
      "end": "'''",
      "patterns": [
        {
          "match": "\\\\[\\s\\S]"
        }
      ]
    }
  }
}
