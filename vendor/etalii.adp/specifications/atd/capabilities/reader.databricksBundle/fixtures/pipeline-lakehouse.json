    "body": "# The lakehouse bundle: one nightly ingest job (declared in resources/), one declarative\n# pipeline refining bronze into gold, deployed to a development and a production target.\nbundle:\n  name: lakehouse\n\ninclude:\n  - resources/*.yml\n\nvariables:\n  catalog:\n    description: The Unity Catalog everything below writes into.\n    default: lakehouse_dev\n  warehouse_id:\n    description: The SQL warehouse the dashboard refresh runs on.\n    default: \"4b9b953939869799\"\n\nresources:\n  pipelines:\n    bronze_to_gold:\n      name: Bronze to gold\n      catalog: ${var.catalog}\n      schema: gold\n      serverless: true\n      channel: CURRENT\n      libraries:\n        - notebook:\n            path: transformations/bronze\n        - notebook:\n            path: transformations/silver\n        - glob:\n            include: transformations/gold/**\n      notifications:\n        - email_recipients:\n            - data-eng@vrenken.eu\n          alerts:\n            - on-update-failure\n            - on-update-fatal-failure\n\ntargets:\n  dev:\n    mode: development\n    default: true\n  prod:\n    mode: production\n    resources:\n      pipelines:\n        bronze_to_gold:\n          catalog: lakehouse_prod\n          serverless: false\n      jobs:\n        nightly_ingest:\n          schedule:\n            quartz_cron_expression: \"0 0 2 * * ?\"\n",
