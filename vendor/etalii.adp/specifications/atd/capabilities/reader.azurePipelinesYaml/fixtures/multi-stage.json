    "body": "# A build/test/deploy pipeline with fan-out and fan-in, which is the shape the\n# dependency graph exists to make readable.\ntrigger:\n  branches:\n    include:\n      - main\n      - releases/*\n\npool:\n  vmImage: ubuntu-latest\n\nvariables:\n  buildConfiguration: Release\n\nstages:\n  - stage: Build\n    displayName: Build the solution\n    jobs:\n      - job: Compile\n        displayName: Compile\n        steps:\n          - checkout: self\n            fetchDepth: 1\n          - script: dotnet build --configuration $(buildConfiguration)\n            displayName: Build\n          - publish: $(Build.ArtifactStagingDirectory)\n            artifact: drop\n\n  - stage: Test\n    displayName: Test\n    dependsOn: Build\n    jobs:\n      # These two have no dependsOn, so they run in parallel - the job default,\n      # which is the opposite of the stage default.\n      - job: Unit\n        steps:\n          - script: dotnet test --filter Category=Unit\n            displayName: Unit tests\n      - job: Integration\n        timeoutInMinutes: 30\n        continueOnError: true\n        steps:\n          - script: dotnet test --filter Category=Integration\n            displayName: Integration tests\n\n  - stage: DeployStaging\n    dependsOn: Test\n    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))\n    jobs:\n      - deployment: Staging\n        environment: staging\n        strategy:\n          runOnce:\n            deploy:\n              steps:\n                - download: current\n                  artifact: drop\n                - script: ./deploy.sh staging\n                  displayName: Deploy\n\n  - stage: DeployProduction\n    dependsOn: Test\n    trigger: manual\n    jobs:\n      - deployment: Production\n        environment: production\n        strategy:\n          runOnce:\n            deploy:\n              steps:\n                - script: ./deploy.sh production\n                  displayName: Deploy\n\n  - stage: Notify\n    displayName: Notify the team\n    # Fan-in: waits for both deployments.\n    dependsOn:\n      - DeployStaging\n      - DeployProduction\n    condition: always()\n    jobs:\n      - job: Announce\n        steps:\n          - script: ./notify.sh\n            displayName: Announce\n"
  },
