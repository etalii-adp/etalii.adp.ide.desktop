{
  "$schema": "https://etalii.net/adp/atd/schema/0.1/atd.schema.json#/$defs/CapabilityFixture",
  "doc": "Recorded by `atd record --capability layout.bandedGrid` from the RDF module's layout of the reading that parity/cases/w3c/rdf/rename-positions.json of etalii.adp.ide.desktop opens; never edited by hand.",
  "input": {
    "nodes": [
      {
        "id": "res:http://example.org/alpha",
        "width": 280.0,
        "height": 160.0,
        "attributes": {
          "types": []
        },
        "pinned": {
          "x": 120.0,
          "y": 80.0
        }
      },
      {
        "id": "res:http://example.org/beta",
        "width": 280.0,
        "height": 160.0,
        "attributes": {
          "types": []
        },
        "pinned": {
          "x": 360.0,
          "y": 80.0
        }
      }
    ],
    "edges": []
  },
  "args": {
    "columns": 4,
    "columnWidth": 280.0,
    "rowHeight": 160.0,
    "bandGap": 80,
    "band": "size(self.types) > 0 ? self.types[0] : ''"
  },
  "output": {
    "positions": {
      "res:http://example.org/alpha": {
        "x": 120.0,
        "y": 80.0
      },
      "res:http://example.org/beta": {
        "x": 360.0,
        "y": 80.0
      }
    }
  }
}
