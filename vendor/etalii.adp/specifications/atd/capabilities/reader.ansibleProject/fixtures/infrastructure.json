    "body": "ansible/structure\n",
    "files": {
      "dbservers.yml": "---\n- name: Configure the database tier\n  hosts: db\n  become: true\n  roles:\n    - common\n    - role: postgres\n      when: postgres_enabled | default(true)\n",
      "inventories/production/hosts.yml": "---\nall:\n  children:\n    web:\n      hosts:\n        web-01.prod.example.com:\n        web-02.prod.example.com:\n    db:\n      hosts:\n        db-01.prod.example.com:\n",
      "inventories/staging/hosts.yml": "---\nall:\n  children:\n    web:\n      hosts:\n        web-01.staging.example.com:\n    db:\n      hosts:\n        db-01.staging.example.com:\n",
      "roles/common/tasks/main.yml": "---\n- name: Set the timezone\n  ansible.builtin.timezone:\n    name: \"{{ common_timezone }}\"\n\n- name: Install the base packages\n  ansible.builtin.package:\n    name: \"{{ common_packages }}\"\n    state: present\n",
      "roles/nginx/meta/main.yml": "---\ndependencies:\n  - role: common\n\ngalaxy_info:\n  author: platform team\n  description: nginx with optional TLS\n",
      "roles/nginx/tasks/main.yml": "---\n- name: Install nginx\n  ansible.builtin.package:\n    name: nginx\n    state: present\n  notify: Restart nginx\n\n- name: Write the nginx configuration\n  ansible.builtin.template:\n    src: nginx.conf.j2\n    dest: /etc/nginx/nginx.conf\n    mode: \"0644\"\n  notify: Restart nginx\n\n- name: Configure TLS\n  ansible.builtin.include_tasks: tls.yml\n  when: nginx_tls_enabled | default(false)\n",
      "roles/nginx/tasks/tls.yml": "---\n- name: Create the certificate directory\n  ansible.builtin.file:\n    path: /etc/nginx/tls\n    state: directory\n    mode: \"0700\"\n\n- name: Install the certificate\n  ansible.builtin.copy:\n    src: \"{{ nginx_tls_certificate }}\"\n    dest: /etc/nginx/tls/server.crt\n    mode: \"0644\"\n  notify: Restart nginx\n",
      "roles/postgres/meta/main.yml": "---\ndependencies:\n  - role: common\n",
      "roles/postgres/tasks/main.yml": "---\n- name: Install PostgreSQL\n  ansible.builtin.package:\n    name: postgresql\n    state: present\n",
      "site.yml": "---\n# The entry playbook: nothing imports this one, so it is the graph's first rank.\n- import_playbook: webservers.yml\n\n- import_playbook: dbservers.yml\n",
      "webservers.yml": "---\n- name: Configure the web tier\n  hosts: web\n  become: true\n  roles:\n    - common\n    - nginx\n"
    },
