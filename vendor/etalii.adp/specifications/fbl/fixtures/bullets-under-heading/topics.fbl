{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.19",
  "doc": "The binding of this fixture alone (FBL 0.19, sections 4.8, 6.2 and 6.3): bullets-edits/topics.fbl, its insert placed under-heading, so that the first topic of a section that holds prose and no list is written right after the heading, above the prose, and every later topic where last-child puts it.",
  "bindings": {
    "topics": {
      "title": "Topics, Markdown",
      "claims": {
        "registrationOnly": true
      },
      "body": {
        "kind": "file",
        "family": "bullets"
      },
      "reader": "declared",
      "sections": [
        {
          "name": "topics",
          "heading": "^Topics$"
        }
      ],
      "elements": [
        {
          "name": "topic",
          "type": "Topic",
          "within": [
            "topics"
          ],
          "line": "^(?<id>[a-z][a-z0-9-]*): (?<title>.+)$",
          "id": {
            "from": {
              "group": "id"
            }
          },
          "parent": {
            "rules": [
              "topic"
            ],
            "slot": "children"
          },
          "attributes": {
            "title": {
              "group": "title"
            },
            "notes": {
              "continuation": true,
              "empty": "remove"
            }
          },
          "insert": {
            "place": "under-heading",
            "container": "topics",
            "emit": "{id}: {title}",
            "create": {
              "at": "end-of-document",
              "text": "## Topics"
            }
          },
          "remove": {}
        }
      ]
    }
  }
}
