{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.15",
  "doc": "The binding of the fixture grammar-reach (FBL 0.15, section 4.9): a fact is one object of a statement, whose subject and verb are written once above it. Its slots reach them with `..`, the next object with `+`, the forms of a value with `or`, and which form was met with `name`, and the body reads in the order its entries close.",
  "bindings": {
    "reach": {
      "title": "Facts of a statement",
      "claims": {
        "extensions": [
          ".reach"
        ],
        "origins": [
          "example/reach"
        ]
      },
      "body": {
        "kind": "file",
        "family": "grammar",
        "grammar": "start: statement*\nstatement: subject list \".\"\nsubject: NAME\nlist: pair (\";\" pair)*\npair: NAME object (\",\" object)*\nobject: NAME | NUMBER | block\nblock: \"[\" list \"]\"\nNAME: /[a-z]+/\nNUMBER: /[0-9]+/\nWS: /[ \\n]+/\n%ignore WS\n",
        "start": "start",
        "order": "closed"
      },
      "reader": "declared",
      "text": {
        "newline": "lf",
        "indent": 2,
        "finalNewline": true
      },
      "elements": [
        {
          "name": "nested",
          "type": "Fact",
          "at": "/**/block/list/pair/object",
          "id": {
            "from": {
              "node": "."
            }
          },
          "attributes": {
            "subject": {
              "value": "'block'"
            },
            "verb": {
              "node": "../NAME"
            },
            "kind": {
              "node": "*",
              "name": true
            },
            "value": {
              "node": "NAME",
              "or": [
                {
                  "node": "NUMBER"
                },
                {
                  "value": "'block'"
                }
              ]
            },
            "follows": {
              "node": "+",
              "or": [
                {
                  "value": "'none'"
                }
              ]
            }
          }
        },
        {
          "name": "fact",
          "type": "Fact",
          "at": "/statement/list/pair/object",
          "id": {
            "from": {
              "node": "."
            }
          },
          "attributes": {
            "subject": {
              "node": "../../../subject/NAME"
            },
            "verb": {
              "node": "../NAME"
            },
            "kind": {
              "node": "*",
              "name": true
            },
            "value": {
              "node": "NAME",
              "or": [
                {
                  "node": "NUMBER"
                },
                {
                  "value": "'block'"
                }
              ]
            },
            "follows": {
              "node": "+",
              "or": [
                {
                  "value": "'none'"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
