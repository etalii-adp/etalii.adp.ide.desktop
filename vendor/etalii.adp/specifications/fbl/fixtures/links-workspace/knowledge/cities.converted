    cells:
      - property: p1
        text: Amsterdam
      - property: p2
        rows:
          - row: $k3f9x2ma@provinces.yaml#nh.Name=Noord-Holland
      - property: p3
        rows:
          - row: $c1t9e5sx@cities.yaml#utr.Name=Utrecht
          - row: $c1t9e5sx@cities.yaml#haa.Name=Haarlem
      - property: p4
        rows:
          - row: x1
  - id: utr
    cells:
      - property: p1
        text: Utrecht
      - property: p2
        rows:
          - row: $k3f9x2ma@provinces.yaml#ut.Name=Utrecht
  - id: haa
    cells:
      - property: p1
        text: Haarlem
      - property: p2
        rows:
          - row: $k3f9x2ma@provinces.yaml#nh.Name=Noord-Holland
      - property: p3
        rows:
          - row: $c1t9e5sx@cities.yaml#ams.Name=Amsterdam
          - row: $c1t9e5sx@cities.yaml#gone
