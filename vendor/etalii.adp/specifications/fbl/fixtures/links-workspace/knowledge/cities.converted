    title: true
  - id: p2
    name: Province
    type: relation
    target: $k3f9x2ma@provinces.yaml
    limit: one
    backlinkName: Cities
  - id: p3
    name: Twinned with
    type: relation
    target: $c1t9e5sx@cities.yaml
  - id: p4
    name: Region
    type: relation
    target: ../teams/nowhere.yaml
views:
  - id: v1
    name: Table
rows:
