{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.11",
  "doc": "Refused by FBL 0.10, section 14.1, step 6: the attribute words gathers a second slot (gather), and its binding is writable, so a set would not say which of the places to write (section 4.9; section 3.3's one-place rule). The same binding marked readOnly loads.",
  "bindings": {
    "outline": {
      "title": "Outline, a gathered attribute that is writable",
      "claims": {
        "extensions": [
          ".outline"
        ],
        "origins": [
          "example/outline"
        ]
      },
      "body": {
        "kind": "file",
        "family": "grammar",
        "grammar": "start: unit*\n?unit: item\n     | _NL\nitem: NAME [label [note]] [block]\nlabel: STRING\nnote: STRING\nblock: \"{\" unit* \"}\"\nNAME: /[a-z]+/\nSTRING: /\"[^\"\\r\\n]*\"/\n_NL: /(\\r?\\n[ \\t]*)+/\nWHITESPACE: /[ \\t]+/\nCOMMENT: /#[^\\r\\n]*/\n%ignore WHITESPACE\n%ignore COMMENT\n",
        "recover": {
          "unit": "unit",
          "sync": [
            "_NL"
          ]
        }
      },
      "reader": "declared",
      "elements": [
        {
          "name": "item",
          "type": "Item",
          "at": "/item",
          "id": {
            "from": {
              "node": "NAME"
            }
          },
          "attributes": {
            "words": {
              "node": "label",
              "gather": [
                {
                  "node": "note"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
