{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.15",
  "doc": "FBL 0.15, section 14.1: a slot with expand reads through the body's prefixes, and this body has none.",
  "bindings": {
    "b": {
      "title": "Refused",
      "claims": {
        "extensions": [
          ".b"
        ],
        "origins": [
          "example/b"
        ]
      },
      "body": {
        "kind": "file",
        "family": "grammar",
        "grammar": "start: item*\nitem: NAME \".\"\nNAME: /[a-z:]+/\nWS: /[ \\n]+/\n%ignore WS\n"
      },
      "reader": "declared",
      "elements": [
        {
          "name": "item",
          "type": "Item",
          "at": "/item",
          "attributes": {
            "value": {
              "node": "NAME",
              "expand": true
            }
          }
        }
      ]
    }
  }
}
