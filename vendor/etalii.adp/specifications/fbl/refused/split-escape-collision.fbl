{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.13",
  "doc": "Refused by FBL 0.13, section 14.1, step 6: the attribute members cuts its argument into items at the text '\\\\,' (split), which holds the backslash its escape writes before a quote, so cutting before the escapes are resolved would give other items than cutting after (section 4.9). The same slot with split ',' loads.",
  "bindings": {
    "loops": {
      "title": "Loops, a split text holding an escape character",
      "claims": {
        "extensions": [
          ".loops"
        ],
        "origins": [
          "systems/causal-loop-diagram"
        ]
      },
      "body": {
        "kind": "file",
        "family": "grammar",
        "grammar": "start: unit*\n?unit: loop\n     | _NL\nloop: NAME STRING\nNAME: /[a-z]+/\nSTRING: /\"([^\"\\\\\\r\\n]|\\\\[^\\r\\n])*\"/\n_NL: /(\\r?\\n[ \\t]*)+/\nWHITESPACE: /[ \\t]+/\n%ignore WHITESPACE\n",
        "recover": {
          "unit": "unit",
          "sync": [
            "_NL"
          ]
        }
      },
      "reader": "declared",
      "elements": [
        {
          "name": "loop",
          "type": "Loop",
          "at": "/loop",
          "id": {
            "from": {
              "node": "NAME"
            }
          },
          "attributes": {
            "members": {
              "node": "STRING",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "split": "\\,",
              "readOnly": true
            }
          }
        }
      ]
    }
  }
}
