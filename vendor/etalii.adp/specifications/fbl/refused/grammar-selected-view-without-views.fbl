{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.11",
  "doc": "Refused by FBL 0.10, section 14.1, step 6: the rule item reads for the selected view only (selectedView), and the binding has no block rule with view, so no reading ever shows a view and the rule could never read anything (sections 4.9, 9.3).",
  "bindings": {
    "outline": {
      "title": "Outline, a rule of a view the binding does not define",
      "claims": {
        "extensions": [
          ".outline"
        ],
        "origins": [
          "example/outline"
        ]
      },
      "body": {
        "kind": "file",
        "family": "grammar",
        "grammar": "start: unit*\n?unit: item\n     | _NL\nitem: NAME [label [note]] [block]\nlabel: STRING\nnote: STRING\nblock: \"{\" unit* \"}\"\nNAME: /[a-z]+/\nSTRING: /\"[^\"\\r\\n]*\"/\n_NL: /(\\r?\\n[ \\t]*)+/\nWHITESPACE: /[ \\t]+/\nCOMMENT: /#[^\\r\\n]*/\n%ignore WHITESPACE\n%ignore COMMENT\n",
        "recover": {
          "unit": "unit",
          "sync": [
            "_NL"
          ]
        }
      },
      "reader": "declared",
      "elements": [
        {
          "name": "item",
          "type": "Item",
          "at": "/item",
          "id": {
            "from": {
              "node": "NAME"
            }
          },
          "attributes": {
            "label": {
              "node": "label",
              "match": "\"(?<value>[^\"]*)\""
            }
          },
          "selectedView": true
        }
      ]
    }
  }
}
