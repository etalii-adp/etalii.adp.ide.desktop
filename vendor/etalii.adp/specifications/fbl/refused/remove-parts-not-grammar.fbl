{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.16",
  "doc": "FBL 0.16, section 14.1: a remove's parts stand only in a binding of the grammar family, and this one is yaml.",
  "bindings": {
    "b": {
      "title": "Refused",
      "claims": {
        "extensions": [
          ".b"
        ],
        "origins": [
          "example/b"
        ]
      },
      "body": {
        "kind": "file",
        "family": "yaml"
      },
      "reader": "declared",
      "elements": [
        {
          "name": "item",
          "type": "Item",
          "at": "/items/*",
          "attributes": {
            "name": {
              "key": "name"
            }
          },
          "remove": {
            "parts": [
              {
                "item": ".",
                "separator": ","
              }
            ]
          }
        }
      ]
    }
  }
}
