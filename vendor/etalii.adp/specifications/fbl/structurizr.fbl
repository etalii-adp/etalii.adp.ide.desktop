        {
          "name": "relationship",
          "type": "Relationship",
          "doc": "A relationship is read as an entry with two reference attributes, which the tool types map onto a relation, so that an end that names nothing is kept with that end unset. A relationship written without a source inside an element's block has that element as its source.",
          "at": "/workspace/model/**/relationship",
          "attributes": {
            "from": {
              "node": "source",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "reference": {
                "to": [
                  "person",
                  "softwareSystem",
                  "container",
                  "component",
                  "deploymentNode",
                  "infrastructureNode",
                  "containerInstance",
                  "softwareSystemInstance"
                ],
                "by": "id"
              }
            },
            "to": {
              "node": "destination",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "reference": {
                "to": [
                  "person",
                  "softwareSystem",
                  "container",
                  "component",
                  "deploymentNode",
                  "infrastructureNode",
