                "emit": " \"{value}\"",
                "after": [
                  "to"
                ],
                "pad": true
              }
            },
            "technology": {
              "node": "technology",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "empty": "keep",
              "create": {
                "emit": " \"{value}\"",
                "after": [
                  "description",
                  "to"
                ],
                "pad": true
              }
            },
            "tags": {
              "node": "tags",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "split": ",",
              "gather": [
                {
                  "node": "tags_statement/tag",
                  "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
                  "escape": {
                    "with": "\\",
                    "quote": "\""
                  },
                  "split": ","
                }
              ],
              "readOnly": true
            }
          },
          "insert": {
            "place": "end",
            "container": "/workspace/model",
            "emit": "{from} -> {to} \"{description}\""
          },
          "remove": {}
        },
        {
          "name": "viewInclude",
          "type": "ViewInclude",
          "doc": "The selected view's include statements, which the tool types map onto the diagram's includes.",
          "at": "/workspace/views/*/include_statement",
          "selectedView": true,
          "attributes": {
            "members": {
              "node": "member",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        },
        {
          "name": "viewExclude",
          "type": "ViewInclude",
          "at": "/workspace/views/*/exclude_statement",
          "selectedView": true,
          "attributes": {
            "excludes": {
              "node": "member",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        },
        {
          "name": "viewTitle",
          "type": "ViewInclude",
          "at": "/workspace/views/*/title_statement",
          "selectedView": true,
          "attributes": {
            "title": {
              "node": "title",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        },
        {
          "name": "viewAutoLayout",
          "type": "ViewInclude",
          "doc": "autoLayout with no direction lays out top to bottom.",
          "at": "/workspace/views/*/auto_layout_statement",
          "selectedView": true,
          "attributes": {
            "autoLayout": {
              "node": "direction",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "default": "tb",
              "readOnly": true
            },
            "rankSeparation": {
              "node": "rank_separation",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            },
            "nodeSeparation": {
              "node": "node_separation",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        },
        {
          "name": "viewScope",
          "type": "ViewInclude",
          "at": "/workspace/views/*/scope",
          "selectedView": true,
          "attributes": {
            "scope": {
              "node": ".",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        },
        {
          "name": "viewEnvironment",
          "type": "ViewInclude",
          "at": "/workspace/views/*/environment",
          "selectedView": true,
          "attributes": {
            "environment": {
              "node": ".",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        },
        {
          "name": "interaction",
          "type": "Interaction",
          "doc": "A dynamic view's interactions, read for the selected view only.",
          "at": "/workspace/views/*/interaction",
          "selectedView": true,
          "attributes": {
            "from": {
              "node": "source",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "reference": {
                "to": [
                  "person",
                  "softwareSystem",
                  "container",
                  "component",
                  "deploymentNode",
                  "infrastructureNode",
                  "containerInstance",
                  "softwareSystemInstance"
                ],
                "by": "id"
              }
            },
            "to": {
              "node": "destination",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "reference": {
                "to": [
                  "person",
                  "softwareSystem",
                  "container",
                  "component",
                  "deploymentNode",
                  "infrastructureNode",
                  "containerInstance",
                  "softwareSystemInstance"
                ],
                "by": "id"
              }
            },
            "description": {
              "node": "description",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "readOnly": true
            }
          }
        }
      ],
      "template": {
        "text": "workspace \"{base}\" {\n    model {\n        {key} = softwareSystem \"{base}\" \"Describe {base}.\"\n    }\n    views {\n        container {key} \"containers\" {\n            include *\n            autoLayout lr\n        }\n    }\n}\n",
        "byOrigin": {
          "c4/context": "workspace \"{base}\" {\n    model {\n        {key} = softwareSystem \"{base}\" \"Describe {base}.\"\n    }\n    views {\n        systemContext {key} \"context\" {\n            include *\n            autoLayout lr\n        }\n    }\n}\n",
          "c4/system-landscape": "workspace \"{base}\" {\n    model {\n        {key} = softwareSystem \"{base}\" \"Describe {base}.\"\n    }\n    views {\n        systemLandscape \"landscape\" {\n            include *\n            autoLayout lr\n        }\n    }\n}\n"
        }
      }
    }
  }
}
