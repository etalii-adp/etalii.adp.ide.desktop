              },
              "empty": "keep",
              "create": {
                "emit": " \"{value}\"",
                "after": [
                  "description",
                  "name"
                ],
                "pad": true
              }
            },
            "tags": {
              "node": "tags",
              "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
              "escape": {
                "with": "\\",
                "quote": "\""
              },
              "split": ",",
              "gather": [
                {
                  "node": "tags_statement/tag",
                  "match": "\"?(?<value>(?:[^\"\\\\]|\\\\.)*)\"?",
                  "escape": {
                    "with": "\\",
                    "quote": "\""
                  },
                  "split": ","
                }
              ],
              "readOnly": true
            }
          },
          "insert": {
            "place": "last-child",
            "emit": "{id} = container \"{name}\" \"{description}\" \"{technology}\""
          },
          "remove": {
            "cascade": [
              "component",
              "relationship"
            ]
          }
        },
        {
          "name": "component",
          "type": "Component",
          "at": "/workspace/model/**/component",
          "opens": {
            "open": " {",
            "close": "}"
          },
          "parent": {
