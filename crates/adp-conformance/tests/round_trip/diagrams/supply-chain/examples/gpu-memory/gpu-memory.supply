    group: japan
    quantity: 120
    unit: kt
    step: 5
  - id: logic-fab
    type: producer
    name: Leading-edge logic fab
    group: taiwan
    quantity: 160
    unit: k wafers/month
    step: 5
    description: 4 nm and 3 nm wafers for GPUs, phone SoCs and laptop processors.
  - id: cowos-packaging
    type: integrator
    name: CoWoS advanced packaging
    group: taiwan
    quantity: 35
    unit: k wafers/month
    step: 1
  - id: server-assembly
