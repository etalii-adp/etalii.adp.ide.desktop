supply-chain: 1
# GPUs and memory: from rare earths, quartz and neon to data centres, phones and gaming PCs.

groups:
  - id: china-mining
    name: "China: mining and refining"
    description: Rare earths, gallium and germanium, and graphite.
  - id: americas
    name: Americas
    description: High-purity quartz, copper, and the cloud buyers.
  - id: europe
    name: Europe
    description: Lithography tools and neon purification.
  - id: japan
    name: Japan
    description: Wafers, photoresists and process chemicals.
  - id: taiwan
    name: Taiwan
    description: Leading-edge logic, advanced packaging and server assembly.
  - id: korea
    name: South Korea
    description: DRAM, high-bandwidth memory and NAND flash.
  - id: assembly
    name: China and Southeast Asia
    description: "Device assembly: phones, laptops, consoles."
  - id: markets
    name: Markets
    description: Distribution, retail and the people and companies who buy.

nodes:
  - id: bayan-obo
    type: source
    name: Bayan Obo rare earth ore
    group: china-mining
    quantity: 210
    unit: kt REO
    step: 10
    description: Rare earth oxide equivalent.
  - id: ree-separation
    type: processor
    name: Rare earth separation
    group: china-mining
    quantity: 180
    unit: kt REO
    step: 10
  - id: magnet-plant
    type: producer
    name: NdFeB magnet plant
    group: china-mining
    quantity: 300
    unit: kt
    step: 10
  - id: gallium-refinery
    type: processor
    name: Gallium and germanium refinery
    group: china-mining
    quantity: 750
    unit: t Ga
    step: 25
  - id: graphite-mine
    type: source
    name: Graphite mines
    group: china-mining
    quantity: 1200
    unit: kt
    step: 50
