    from: ree-separation
    to: magnet-plant
    product: Neodymium and praseodymium oxide
    volume: 90
    unit: kt REO
    step: 5
  - id: magnet-plant-to-phone-assembly
    from: magnet-plant
    to: phone-assembly
    product: Speaker and haptic magnets
    volume: 15
    unit: kt
    step: 1
  - id: magnet-plant-to-laptop-assembly
