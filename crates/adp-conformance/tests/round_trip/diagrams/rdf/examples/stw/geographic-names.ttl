        rdf:value "Im Sinne von Schwellenländer"@de ;
        rdfs:seeAlso <descriptor/10508-0>
    ], [
        rdf:value "Referring to countries that are no longer classified as developing countries due to their economic performance, but are not yet classified as industrialized countries either"@en ;
        rdfs:seeAlso <descriptor/10508-0>
    ] .

