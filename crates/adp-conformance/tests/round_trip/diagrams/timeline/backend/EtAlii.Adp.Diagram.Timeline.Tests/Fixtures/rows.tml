timeline: 1
# Rows written in forms YAML reads as numbers and .NET's integer parse does not, and the reverse.
elements:
  - id: rowfloat
    label: One point oh
    begin: 2026-08-01
    end: 2026-08-05
    row: 1.0
  - id: rowhex
    label: Hexadecimal
    begin: 2026-08-06
    row: 0x10
  - id: rowoctal
    label: Octal
    begin: 2026-08-07
    row: 0o17
  - id: rowquoted
    label: Quoted
    begin: 2026-08-08
    row: "3"
  - id: rowsigned
    label: Signed
    begin: 2026-08-09
    row: +4
  - id: rowexponent
    label: Exponent
    begin: 2026-08-10
    row: 1e1
