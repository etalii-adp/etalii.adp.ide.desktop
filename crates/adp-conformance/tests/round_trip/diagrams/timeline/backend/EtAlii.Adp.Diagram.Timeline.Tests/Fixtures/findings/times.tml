timeline: 1
# Times: unreadable, ends before it begins, mixed forms, and forms .NET reads that ISO does not.
elements:
  - id: badbegin
    label: Bad begin
    begin: someday
    end: 2026-01-10
    row: 0
  - id: badend
    label: Bad end
    begin: 2026-01-01
    end: later
    row: 1
  - id: badboth
    begin: soon
    end: later
    row: 2
  - id: backwards
    label: Backwards
    begin: 2026-03-10
    end: 2026-03-01
    row: 3
  - id: mixed
    label: Mixed
    begin: 2026-04-01
    end: 2026-04-02T12:00:00
    row: 4
  - id: backmixed
    label: Backwards and mixed
    begin: 2026-05-10T08:00:00
    end: 2026-05-01
    row: 5
  - id: badmoment
    label: Bad moment
    begin: 2026-02-30
    row: 6
  - id: emptyend
    label: Empty end
    begin: 2026-06-01
    end:
    row: 7
  - id: slashes
    label: Slashed date
    begin: 2026/07/01
    end: 2026/07/04
    row: 8
  - id: words
    label: Written out
    begin: July 5, 2026
    end: Tuesday 7 July 2026
    row: 9
  - id: offsets
    label: With offsets
    begin: 2026-08-01T10:00:00+02:00
    end: 2026-08-01T09:00:00Z
    row: 10
  - id: sameinstant
    label: Same instant, two forms
    begin: 2026-09-01
    end: 2026-09-01T00:00:00
    row: 11
  - id: quoted
    label: "Quoted"
    begin: "2026-10-01"
    end: '2026-10-03'
    row: twelve
  - id: unlabelled
    begin: 2026-11-31
    end: 2026-11-01
    row: 13
