  "input": {
    "body": "@prefix : <http://example.org/pizza#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix ext: <http://example.org/external#> .\n\n<http://example.org/pizza> a owl:Ontology ;\n    owl:imports <http://example.org/base> ;\n    rdfs:label \"Pizza ontology\" ;\n    owl:versionInfo \"1.0\" .\n\n:Pizza a owl:Class ;\n    rdfs:label \"Pizza\" .\n\n:Topping a owl:Class .\n\n:VegetarianTopping a owl:Class ;\n    rdfs:subClassOf :Topping ;\n    owl:disjointWith :MeatTopping .\n\n:MeatTopping a owl:Class ;\n    rdfs:subClassOf :Topping ;\n    owl:deprecated true .\n\n:Vegetarian a owl:Class ;\n    rdfs:subClassOf :Pizza ;\n    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTopping ; owl:allValuesFrom :VegetarianTopping ] ;\n    owl:equivalentClass :VeggiePizza .\n\n:VeggiePizza a owl:Class .\n\n:Special a owl:Class ;\n    owl:equivalentClass [ a owl:Class ; owl:unionOf ( :Vegetarian [ a owl:Restriction ; owl:onProperty :hasTopping ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :MeatTopping ext:Smoked ) ] ] ) ] .\n\n:hasTopping a owl:ObjectProperty , owl:InverseFunctionalProperty ;\n    rdfs:domain :Pizza ;\n    rdfs:range :Topping ;\n    owl:inverseOf :toppingOf .\n\n:toppingOf a owl:ObjectProperty .\n\n:hasCalories a owl:DatatypeProperty , owl:FunctionalProperty ;\n    rdfs:domain :Pizza ;\n    rdfs:range xsd:integer .\n\n:hasNote a owl:DatatypeProperty .\n\n:Margherita a owl:NamedIndividual , :Pizza ;\n    rdfs:label \"Margherita\" ;\n    :hasCalories 850 ;\n    :hasTopping :Mozzarella .\n\n:Mozzarella a :VegetarianTopping .\n\n:Pizza a owl:NamedIndividual .\n\n[ a owl:AllDisjointClasses ; owl:members ( :Pizza :Topping ) ] .\n\n:HomemadeBase rdfs:subClassOf ext:Base .\n",
    "files": {
      "owl-ontology.adp": "w3c/rdf\nbody: owl-ontology.ttl\n"
    }
