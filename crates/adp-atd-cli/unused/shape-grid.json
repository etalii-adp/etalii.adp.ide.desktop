    "body": "@prefix : <http://example.org/shapes#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\n:PersonShape a sh:NodeShape ;\n    sh:targetClass :Person ;\n    sh:property [ sh:path :name ; sh:datatype xsd:string ; sh:minCount 1 ] ,\n        [ sh:path :age ; sh:datatype xsd:integer ] ,\n        [ sh:path :knows ; sh:node :PersonShape ] .\n\n:AddressShape a sh:NodeShape ;\n    sh:targetClass :Address .\n\n:CityShape a sh:NodeShape ;\n    sh:targetClass :City , :Town ;\n    sh:property [ sh:path :population ; sh:datatype xsd:integer ] .\n\n:EmptyShape a sh:NodeShape .\n\n:TagShape a sh:NodeShape ;\n    sh:targetSubjectsOf :tag ;\n    sh:property [ sh:path :tag ; sh:datatype xsd:string ] ,\n        [ sh:path :label ] .\n\n:NameShape a sh:PropertyShape ;\n    sh:path :name ;\n    sh:maxCount 1 .\n\n:OrderShape a sh:NodeShape ;\n    sh:targetClass :Order ;\n    sh:property [ sh:path :item ; sh:minCount 1 ] , [ sh:path :total ] , [ sh:path :customer ; sh:node :PersonShape ] , [ sh:path :date ] .\n",
