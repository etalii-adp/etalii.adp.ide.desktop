supply-chain: 1
# An electric and combustion car maker's supply chain, from mine to driveway.

groups:
  - id: south-america
    name: South America
    description: The lithium triangle and the Andean copper belt.
  - id: central-africa
    x: -20
    y: 0
    name: Central Africa
    description: The Copperbelt, source of most of the world's cobalt.
  - id: southeast-asia
    name: Southeast Asia
    description: Natural rubber and nickel.
  - id: china
    name: China
    description: Refining, cathode and cell production for most of the world's batteries.
  - id: east-asia
    name: Japan, Korea and Taiwan
    description: Automotive semiconductors and battery cells.
  - id: europe
    name: Europe
    description: The carmaker's own plants, its tier-1 suppliers and the dealer network.
  - id: 29eav2jgqtd3511rt0yq68qwg
    name: Overseas
  - id: 4gcbv04e700b4mzxwatjulaxq
    name: New group
    x: -900
    y: 300

