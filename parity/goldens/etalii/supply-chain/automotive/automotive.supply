flows:
  - id: atacama-lithium-to-lithium-refinery
    from: atacama-lithium
    to: lithium-refinery
    product: Lithium carbonate
    volume: 40
    unit: kt LCE
    step: 5
  - id: pilbara-spodumene-to-lithium-refinery
    from: pilbara-spodumene
    to: lithium-refinery
    product: Spodumene concentrate
    volume: 80
    unit: kt LCE
    step: 5
  - id: kolwezi-cobalt-to-cathode-plant
    from: kolwezi-cobalt
    to: cathode-plant
    product: Cobalt hydroxide
    volume: 120
    unit: kt Co
    step: 5
  - id: sulawesi-nickel-to-cathode-plant
    from: sulawesi-nickel
    to: cathode-plant
    product: Nickel matte
    volume: 600
    unit: kt Ni
    step: 25
  - id: lithium-refinery-to-cathode-plant
    from: lithium-refinery
    to: cathode-plant
    product: Lithium hydroxide
    volume: 100
    unit: kt LCE
    step: 5
  - id: cathode-plant-to-cell-gigafactory
    from: cathode-plant
    to: cell-gigafactory
    product: NMC cathode
    volume: 600
    unit: kt
    step: 25
  - id: cathode-plant-to-pouch-cells
    description: Shipped by rail.
    from: cathode-plant
    to: pouch-cells
    product: "NMC cathode: coated"
    volume: 245
    unit: kt
    step: 25
  - id: andes-copper-to-cell-gigafactory
    from: andes-copper
    to: cell-gigafactory
    product: Copper foil
    volume: 300
    unit: kt Cu
    step: 10
  - id: andes-copper-to-ecu-supplier
    from: andes-copper
    to: ecu-supplier
    product: Copper wire
    volume: 200
    unit: kt Cu
    step: 10
  - id: cell-gigafactory-to-pack-assembly
    from: cell-gigafactory
    to: pack-assembly
    product: Prismatic cells
    volume: 120
    unit: GWh
    step: 5
  - id: pouch-cells-to-pack-assembly
    from: pouch-cells
    to: pack-assembly
    product: Pouch cells
    volume: 60
    unit: GWh
    step: 5
  - id: pilbara-iron-to-steel-mill
    from: pilbara-iron
    to: steel-mill
    product: Iron ore
    volume: 45
    unit: Mt
    step: 1
  - id: steel-mill-to-body-shop
    from: steel-mill
    to: body-shop
    product: Coil steel
    volume: 2.4
    unit: Mt
    step: 0.1
  - id: thai-rubber-to-tyre-plant
    from: thai-rubber
    to: tyre-plant
    product: Natural rubber
    volume: 900
    unit: kt
    step: 25
  - id: chip-foundry-to-ecu-supplier
    from: chip-foundry
    to: ecu-supplier
    product: Microcontrollers
    volume: 1.6
    unit: bn chips
    step: 0.1
  - id: ecu-supplier-to-vehicle-plant
    from: ecu-supplier
    to: vehicle-plant
    product: Control units
    volume: 30
    unit: M ECUs
    step: 1
  - id: seat-supplier-to-vehicle-plant
    from: seat-supplier
    to: vehicle-plant
    product: Seat sets
    volume: 2.8
    unit: M sets
    step: 0.1
  - id: tyre-plant-to-vehicle-plant
    from: tyre-plant
    to: vehicle-plant
    product: Tyres
    volume: 14
    unit: M tyres
    step: 1
  - id: pack-assembly-to-vehicle-plant
    from: pack-assembly
    to: vehicle-plant
    product: Battery packs
    volume: 1.2
    unit: M packs
    step: 0.1
  - id: body-shop-to-vehicle-plant
    from: body-shop
    to: vehicle-plant
    product: Body in white
    volume: 2.8
    unit: M bodies
    step: 0.1
  - id: vehicle-plant-to-port-logistics
