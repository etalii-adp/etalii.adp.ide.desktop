<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The parity recorder (etalii.adp spec 030, contracts/parity.md, task T049): replays an edit
    script through the standalone host's gRPC API and writes what the standalone host wrote as
    the goldens. The only .NET code in this repository. It is not part of the Cargo workspace,
    the Build workflow or a release, and runs only when goldens are recorded again.

    It compiles against the standalone host's own sources at the reference commit, checked out as
    a git worktree beside this repository (README.md says how), and runs that host in process
    through the host the standalone host's own flow tests use. Debug only: the developer session
    it signs in with is compiled into a Debug build of the standalone host and nothing else.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EtAlii.Adp.Parity.Recorder</RootNamespace>
    <Version>1.0.0</Version>
    <!-- The standalone host's worktree at the reference commit. Override with -p:StandaloneRoot=... -->
    <StandaloneRoot Condition="'$(StandaloneRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\standalone-8b6ccfc'))</StandaloneRoot>
    <StandaloneRoot>$([MSBuild]::EnsureTrailingSlash('$(StandaloneRoot)'))</StandaloneRoot>
    <!--
      The in-process host of the flow tests, where the reference commit keeps it: in its own project at 8b6ccfc, and
      since the standalone host split its test support per area (73cc791a2) in EtAlii.Adp.Backend.Tests.Support, which
      the Hierarchical Requirement Designer's reference commit a7fdf03 has (etalii.adp spec 036, research R3).
    -->
    <StandaloneHost>$(StandaloneRoot)src\backend\EtAlii.Adp.TestSupport.Host\EtAlii.Adp.TestSupport.Host.csproj</StandaloneHost>
    <StandaloneHostNamespace>EtAlii.Adp.TestSupport.Host</StandaloneHostNamespace>
    <StandaloneHost Condition="!Exists('$(StandaloneHost)')">$(StandaloneRoot)src\backend\EtAlii.Adp.Backend.Tests.Support\EtAlii.Adp.Backend.Tests.Support.csproj</StandaloneHost>
    <StandaloneHostNamespace Condition="!Exists('$(StandaloneRoot)src\backend\EtAlii.Adp.TestSupport.Host\EtAlii.Adp.TestSupport.Host.csproj')">EtAlii.Adp.Backend.Tests.Support</StandaloneHostNamespace>
    <!-- The hierarchy surface's wire, which a7fdf03 has and 8b6ccfc does not: Replay.Hierarchy.cs compiles only beside it. -->
    <DefineConstants Condition="Exists('$(StandaloneRoot)src\designers\hierarchical-requirement')">$(DefineConstants);STANDALONE_HIERARCHY_SURFACE</DefineConstants>
  </PropertyGroup>

  <Target Name="RequireStandaloneWorktree" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error
      Condition="!Exists('$(StandaloneHost)')"
      Text="The standalone host is not checked out at $(StandaloneRoot). Create the worktree with `git -C ../etalii.adp.ide.standalone worktree add --detach ../standalone-8b6ccfc 8b6ccfc`, or pass -p:StandaloneRoot=&lt;folder&gt;." />
  </Target>

  <ItemGroup>
    <!-- The in-process host of the standalone host's flow tests: its Program, in the developer environment. -->
    <ProjectReference Include="$(StandaloneHost)" />
    <!-- Direct, so its build targets point the host's content root at EtAlii.Adp.Backend.Service and copy its manifest. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- HostFixture and FlowConstants, from whichever project holds them at the reference commit. -->
    <Using Include="$(StandaloneHostNamespace)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="StandaloneRoot" Value="$(StandaloneRoot)" />
  </ItemGroup>

</Project>
