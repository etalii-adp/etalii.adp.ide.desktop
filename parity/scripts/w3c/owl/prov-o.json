    { "property": { "row": "rdf.comment", "value": "A plan written down to be followed.", "target": "res:http://www.w3.org/ns/prov#Recipe" } },
    { "action": "rdf.remove-resource", "args": { "target": "res:http://www.w3.org/ns/prov#servings" } },
    { "action": "rdf.remove-resource", "args": { "target": "res:http://www.w3.org/ns/prov#Recipe", "confirm": true } },
    { "undo": 1 },
    { "redo": 1 },
    { "move": { "refs": ["res:http://www.w3.org/ns/prov#Activity"], "to": { "x": -300, "y": 250 } } },
    { "move": { "refs": ["res:http://www.w3.org/ns/prov#Entity"], "dx": 12.5, "dy": 40 } },
    { "move": { "refs": ["expr:http://www.w3.org/ns/prov#ActivityInfluence|http://www.w3.org/2000/01/rdf-schema#subClassOf|1"], "to": { "x": 0, "y": 0 } }, "expect": "refused" },
    { "undo": 1 },
    { "save": true }
