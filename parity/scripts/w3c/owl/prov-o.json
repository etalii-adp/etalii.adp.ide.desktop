    { "property": { "row": "Label", "value": "Plan (prescriptive)" } },
    { "action": "owl.subclass", "args": { "target": "rel:res:http://www.w3.org/ns/prov#Plan->res:http://www.w3.org/ns/prov#Bundle" } },
    { "action": "owl.subclass", "args": { "target": "rel:res:http://www.w3.org/ns/prov#Person->res:http://www.w3.org/ns/prov#Agent" }, "expect": "refused" },
    { "action": "owl.add-class", "args": { "target": "new:200,1800", "value": ":Recipe" } },
    { "action": "owl.add-object-property", "args": { "target": "new:400,1800", "value": ":followedRecipe" } },
    { "action": "owl.add-datatype-property", "args": { "target": "new:600,1800", "value": ":servings" } },
    { "action": "owl.add-individual", "args": { "target": "new:800,1800", "value": ":grandmasPie" } },
    { "action": "owl.subclass", "args": { "target": "rel:res:http://www.w3.org/ns/prov#Recipe->res:http://www.w3.org/ns/prov#Plan" } },
    { "action": "rdf.connect", "args": { "target": "rel:res:http://www.w3.org/ns/prov#Recipe->res:http://www.w3.org/ns/prov#Role", "value": "rdfs:seeAlso" } },
    { "action": "rdf.rename-resource", "args": { "target": "res:http://www.w3.org/ns/prov#Role", "value": ":Part" } },
