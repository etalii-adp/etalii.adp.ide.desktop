{
  "tool": "databricks/job",
  "fixture": "databricks/lakehouse/resources/nightly-ingest.yml",
  "registration": "databricks/lakehouse/resources/nightly-ingest.adp",
  "steps": [
    { "select": ["task:quality_gate"] },
    { "action": "databricks.rename-task", "args": { "value": "gate" } },
    { "action": "databricks.set-run-if", "args": { "target": "task:publish", "value": "ALL_DONE" } },
    { "property": { "row": "Run if", "value": "", "target": "task:alert_on_empty" } },
    { "action": "databricks.assign-cluster", "args": { "target": "task:publish", "value": "ingest_cluster" } },
    { "property": { "row": "Cluster", "value": "", "target": "task:land_raw" } },
    { "property": { "row": "Cluster", "value": "warp_core", "target": "task:publish" }, "expect": "refused" },
    { "property": { "row": "Key", "value": "landing", "target": "task:land_raw" }, "expect": "refused" },
    { "action": "databricks.connect", "args": { "target": "rel:task:land_raw->task:refresh_dashboard" } },
    { "action": "databricks.connect", "args": { "target": "rel:task:land_raw->task:refresh_dashboard" }, "expect": "refused" },
    { "action": "databricks.add-task:notebook", "args": { "target": "new:600,400" } },
    { "action": "databricks.connect", "args": { "target": "rel:task:refresh_dashboard->task:notebook_1" } },
    { "action": "databricks.add-task:condition", "args": { "target": "new:860,400" } },
    { "action": "databricks.add-task:python", "args": { "target": "new:860,520" } },
    { "action": "databricks.add-task:notebook", "args": { "target": "new:600,520" } },
    { "action": "databricks.disconnect:publish", "args": { "target": "task:refresh_dashboard" } },
    { "action": "databricks.remove-edge", "args": { "target": "edge:refresh_dashboard->notebook_1" } },
    { "undo": 1 },
    { "redo": 1 },
    { "action": "databricks.rename-task", "args": { "target": "task:publish", "value": "land_raw" }, "expect": "refused" },
    { "action": "databricks.remove-task", "args": { "target": "task:gate" } },
    { "action": "databricks.remove-task", "args": { "target": "task:gate", "confirm": true } },
    { "undo": 1 },
    { "action": "databricks.remove-task", "args": { "target": "task:python_1" } },
    { "action": "databricks.simulated.run-job", "args": { "target": "task:publish" } },
    { "move": { "refs": ["task:land_raw"], "to": { "x": 40, "y": 20 } } },
    { "move": { "refs": ["cluster:ingest_cluster"], "to": { "x": 12.5, "y": -30 } } },
    { "undo": 1 },
    { "move": { "refs": ["task:publish"], "to": { "x": 520, "y": 260.25 } } },
    { "move": { "refs": ["task:notebook_1"], "dx": 30, "dy": -15 } },
    { "undo": 1 },
    { "action": "databricks.rename-task", "args": { "target": "task:notebook_2", "value": "  report  " } },
    { "action": "databricks.set-run-if", "args": { "target": "task:report", "value": "AT_LEAST_ONE_SUCCESS" } },
    { "property": { "row": "Run if", "value": "ALL_DONE", "target": "task:report" } }
  ]
}
