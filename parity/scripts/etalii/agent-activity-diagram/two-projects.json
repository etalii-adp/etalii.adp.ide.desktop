{
  "tool": "etalii/agent-activity-diagram",
  "fixture": "etalii/agent-activity-diagram/two-projects/two-projects.aad",
  "registration": "etalii/agent-activity-diagram/two-projects/two-projects.adp",
  "steps": [
    { "select": ["s-conversion"] },
    { "action": "editLabel", "args": { "value": "Causal loop diagram, on DISL and FBL" } },
    { "property": { "row": "Status", "value": "Progressing" } },
    { "property": { "row": "Status", "value": "Paused" }, "expect": "refused" },
    { "property": { "row": "Link", "value": "https://github.com/etalii-adp/etalii.adp/tree/develop/specs/cld" } },
    { "action": "add-agent", "args": { "target": "new:400,-120" } },
    { "action": "connect", "args": { "target": "rel:s-conversion->$1" } },
    { "action": "editLabel", "args": { "target": "$1", "value": "Conversion thread" } },
    { "action": "add-location", "args": { "target": "new:620.4,-200.6" } },
    { "action": "connect", "args": { "target": "rel:$2->$1" } },
    { "property": { "row": "Branch", "value": "features/cld-disl-fbl", "target": "$2" } },
    { "action": "connect", "args": { "target": "rel:$2->e-cloud" } },
    { "action": "connect", "args": { "target": "rel:a-module->s-fbl" }, "expect": "refused" },
    { "action": "connect", "args": { "target": "rel:p-ide->e-fractal" }, "expect": "refused" },
    { "move": { "refs": ["a-definitions"], "to": { "x": -300, "y": 250 } } },
    { "move": { "refs": ["a-definitions"], "to": { "x": -320.2, "y": 260.6 } } },
    { "action": "collapse-group", "args": { "target": "s-module#progressing" } },
    { "action": "expand-group", "args": { "target": "s-module#pending" } },
    { "action": "show-archived", "args": { "target": "diagram view" } },
    { "select": ["l-module"] },
    { "action": "delete", "args": {} },
    { "undo": 1 },
    { "redo": 1 },
    { "property": { "row": "Name", "value": "Definitions agent", "target": "a-definitions" } },
    { "action": "unpin", "args": { "target": "a-definitions" } },
    { "undo": 1 },
    { "property": { "row": "Environment kind", "value": "Container", "target": "e-fractal" } },
    { "property": { "row": "Folder", "value": "", "target": "l-module-languages" } },
    { "action": "hide-archived", "args": { "target": "diagram view" } },
    { "action": "delete", "args": { "target": "s-definitions" } },
    { "undo": 1 },
    { "action": "unpinAll", "args": { "target": "new:0,0" } },
    { "action": "expand-group", "args": { "target": "s-module#progressing" } },
    { "save": true }
  ]
}
