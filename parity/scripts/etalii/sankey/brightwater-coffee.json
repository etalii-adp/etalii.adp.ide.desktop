{
  "tool": "etalii/sankey",
  "fixture": "etalii/sankey/brightwater-coffee/brightwater-coffee.skv",
  "registration": "etalii/sankey/brightwater-coffee/brightwater-coffee.adp",
  "steps": [
    { "select": ["cafes"] },
    { "property": { "row": "Note", "value": "+10% Y/Y" } },
    { "property": { "row": "Colour", "value": "teal" } },
    { "property": { "row": "sankey.custom-color", "value": "#AA5500", "target": "packaged" } },
    { "property": { "row": "Format", "value": "€{value}M total", "target": "revenue" } },
    { "property": { "row": "Column", "value": "1", "target": "licensing" } },
    { "property": { "row": "Description", "value": "Corporate income tax: 25%", "target": "tax" } },
    { "property": { "row": "Value", "value": "lots", "target": "cafes->revenue" }, "expect": "refused" },
    { "action": "sankey.increase", "args": { "target": "cafes->revenue" } },
    { "action": "sankey.decrease", "args": { "target": "packaged->revenue" } },
    { "property": { "row": "Step", "value": "5", "target": "wholesale->revenue" } },
    { "action": "sankey.increase", "args": { "target": "wholesale->revenue" } },
    { "property": { "row": "Value", "value": "200", "target": "licensing->revenue" } },
    { "property": { "row": "Colour", "value": "green", "target": "revenue->gross-profit" } },
    { "action": "sankey.thicker", "args": { "target": "new:0,0" } },
    { "action": "sankey.thicker", "args": { "target": "new:0,0" } },
    { "action": "sankey.thinner", "args": { "target": "new:0,0" } },
    { "action": "sankey.add", "args": { "target": "new:1300,100" } },
    { "action": "sankey.rename", "args": { "target": "$1", "value": "Dividends" } },
    { "action": "sankey.connect", "args": { "target": "rel:net-profit->$1" } },
    { "action": "sankey.connect", "args": { "target": "rel:cafes->revenue" }, "expect": "refused" },
    { "action": "sankey.decrease", "args": { "target": "net-profit->$1" } },
    { "move": { "refs": ["tax"], "to": { "x": 1292, "y": -100 } } },
    { "move": { "refs": ["marketing"], "dx": 0, "dy": -400 } },
    { "action": "sankey.remove", "args": { "target": "general", "confirm": true } },
    { "undo": 1 },
    { "redo": 1 },
    { "action": "sankey.remove", "args": { "target": "operating-expenses->research" } },
    { "action": "sankey.arrange", "args": { "target": "new:0,0" } },
    { "undo": 1 },
    { "redo": 1 },
    { "property": { "row": "Name", "value": "Marketing & sales", "target": "marketing" } },
    { "action": "sankey.rename", "args": { "target": "research", "value": "R&D" } },
    { "action": "sankey.rename", "args": { "target": "cost-of-revenue", "value": "  " }, "expect": "refused" },
    { "property": { "row": "Column", "value": "auto", "target": "licensing" } },
    { "property": { "row": "Colour", "value": "(default)" } },
    { "save": true }
  ]
}
