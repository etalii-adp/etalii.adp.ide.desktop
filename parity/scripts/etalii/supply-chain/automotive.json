{
  "tool": "etalii/supply-chain",
  "fixture": "etalii/supply-chain/automotive/automotive.supply",
  "registration": "etalii/supply-chain/automotive/automotive.adp",
  "steps": [
    { "select": ["pack-assembly"] },
    { "action": "supply-chain.increase", "args": {} },
    { "action": "supply-chain.decrease", "args": { "target": "kolwezi-cobalt" } },
    { "action": "supply-chain.rename", "args": { "value": "Battery pack line" } },
    { "property": { "row": "supply-chain.unit", "value": "M packs", "target": "pack-assembly" } },
    { "property": { "row": "Step", "value": "0.25", "target": "pack-assembly" } },
    { "action": "supply-chain.increase", "args": { "target": "pack-assembly" } },
    { "property": { "row": "supply-chain.stage", "value": "outlet", "target": "port-logistics" } },
    { "property": { "row": "supply-chain.group", "value": "(none)", "target": "seat-supplier" } },
    { "property": { "row": "supply-chain.quantity", "value": "lots", "target": "seat-supplier" }, "expect": "refused" },
    { "select": ["cathode-plant-to-pouch-cells"] },
    { "action": "supply-chain.increase", "args": {} },
    { "action": "supply-chain.rename", "args": { "value": "NMC cathode: coated" } },
    { "property": { "row": "Description", "value": "Shipped by rail." } },
    { "undo": 1 },
    { "redo": 1 },
    { "action": "supply-chain.add.hub", "args": { "target": "new:2600,1400" } },
    { "action": "supply-chain.connect", "args": { "target": "rel:vehicle-plant->$1" } },
    { "action": "supply-chain.connect", "args": { "target": "rel:vehicle-plant->$1" }, "expect": "refused" },
    { "move": { "refs": ["$1"], "to": { "x": 2700, "y": 1500 } } },
    { "action": "supply-chain.group", "args": { "target": "$1", "value": "Overseas" } },
    { "action": "supply-chain.add-group", "args": { "target": "new:-600,200" } },
    { "move": { "refs": ["$4"], "to": { "x": -900, "y": 300 } } },
    { "move": { "refs": ["thai-rubber"], "to": { "x": -880, "y": 340 } } },
    { "action": "supply-chain.remove", "args": { "target": "body-shop", "confirm": true } },
    { "undo": 1 },
    { "action": "supply-chain.remove", "args": { "target": "australia" } },
    { "action": "supply-chain.arrange", "args": { "target": "new:0,0" } },
    { "move": { "refs": ["kolwezi-cobalt"], "to": { "x": 40, "y": 900 } } },
    { "action": "supply-chain.remove", "args": { "target": "fleet-leasing-to-company-fleets" } },
    { "action": "supply-chain.decrease", "args": { "target": "$1" }, "expect": "refused" },
    { "save": true }
  ]
}
